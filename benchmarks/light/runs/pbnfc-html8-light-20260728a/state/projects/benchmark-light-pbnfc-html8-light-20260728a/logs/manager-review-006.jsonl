;\n    26\t\n    27\ttypedef struct {\n    28\t    const Grammar *grammar;\n    29\t    ItemVector *charts;\n    30\t    size_t position;\n    31\t    CandidateVector *candidates;\n    32\t    size_t *task_counts;\n    33\t    atomic_int failed;\n    34\t} ClosureWork;\n    35\t\n    36\ttypedef struct {\n    37\t    const Grammar *grammar;\n    38\t    const Markup *markup;\n    39\t    const ItemVector *current;\n    40\t    size_t position;\n    41\t    CandidateVector *candidates;\n    42\t    size_t *task_counts;\n    43\t    atomic_int failed;\n    44\t} ScanWork;\n    45\t\n    46\tstatic int item_equal(const ChartItem *a, const ChartItem *b)\n    47\t{\n    48\t    return a->rule == b->rule && a->alternative == b->alternative &&\n    49\t           a->dot == b->dot && a->origin == b->origin;\n    50\t}\n    51\t\n    52\tstatic int vector_grow(ChartItem **data, size_t *capacity, size_t needed)\n    53\t{\n    54\t    size_t next = *capacity == 0 ? 16 : *capacity * 2;\n    55\t    ChartItem *grown;\n    56\t    if (*capacity >= needed)\n    57\t        return 0;\n    58\t    while (next < needed) {\n    59\t        if (next > ((size_t)-1) / 2)\n    60\t            return -1;\n    61\t        next *= 2;\n    62\t    }\n    63\t    grown = (ChartItem *)realloc(*data, next * sizeof(*grown));\n    64\t    if (grown == NULL)\n    65\t        return -1;\n    66\t    *data = grown;\n    67\t    *capacity = next;\n    68\t    return 0;\n    69\t}\n    70\t\n    71\tstatic int add_item(ItemVector *vector, ChartItem item)\n    72\t{\n    73\t    size_t i;\n    74\t    for (i = 0; i < vector->count; i++)\n    75\t        if (item_equal(&vector->data[i], &item))\n    76\t            return 0;\n    77\t    if (vector_grow(&vector->data, &vector->capacity, vector->count + 1) != 0)\n    78\t        return -1;\n    79\t    vector->data[vector->count++] = item;\n    80\t    return 1;\n    81\t}\n    82\t\n    83\tstatic int add_candidate(CandidateVector *vector, ChartItem item, atomic_int *failed)\n    84\t{\n    85\t    if (vector_grow(&vector->data, &vector->capacity, vector->count + 1) != 0) {\n    86\t        atomic_store(failed, 1);\n    87\t        return -1;\n    88\t    }\n    89\t    vector->data[vector->count++] = item;\n    90\t    return 0;\n    91\t}\n    92\t\n    93\tstatic size_t rule_index(const Grammar *grammar, const char *name)\n    94\t{\n    95\t    size_t i;\n    96\t    for (i = 0; i < grammar->rule_count; i++)\n    97\t        if (strcmp(grammar->rules[i].name, name) == 0)\n    98\t            return i;\n    99\t    return (size_t)-1;\n   100\t}\n   101\t\n   102\tstatic const GrammarSymbol *next_symbol(const Grammar *grammar, const ChartItem *item)\n   103\t{\n   104\t    const Alternative *alternative = &grammar->rules[item->rule].alternatives[item->alternative];\n   105\t    if (item->dot >= alternative->count)\n   106\t        return NULL;\n   107\t    return &alternative->symbols[item->dot];\n   108\t}\n   109\t\n   110\tstatic void closure_task(void *context, size_t worker, size_t begin, size_t end)\n   111\t{\n   112\t    ClosureWork *work = (ClosureWork *)context;\n   113\t    ItemVector *current = &work->charts[work->position];\n   114\t    CandidateVector *out = &work->candidates[worker];\n   115\t    size_t i;\n   116\t    if (begin < end)\n   117\t        work->task_counts[worker]++;\n   118\t    for (i = begin; i < end && !atomic_load(&work->failed); i++) {\n   119\t        ChartItem item = current->data[i];\n   120\t        const GrammarSymbol *symbol = next_symbol(work->grammar, &item);\n   121\t        if (symbol != NULL && symbol->kind == SYM_NONTERM) {\n   122\t            size_t target = rule_index(work->grammar, symbol->text);\n   123\t            size_t j;\n   124\t            for (j = 0; j < work->grammar->rules[target].count; j++) {\n   125\t                ChartItem candidate = {target, j, 0, work->position};\n   126\t                if (add_candidate(out, candidate, &work->failed) != 0)\n   127\t                    return;\n   128\t            }\n   129\t            /* Prediction can follow an epsilon constituent already in this chart. */\n   130\t            for (j = 0; j < current->count; j++) {\n   131\t                ChartItem completed = current->data[j];\n   132\t                if (completed.rule == target && completed.origin == work->position &&\n   133\t                    next_symbol(work->grammar, &completed) == NULL) {\n   134\t                    ChartItem candidate = {item.rule, item.alternative, item.dot + 1, item.origin};\n   135\t                    if (add_candidate(out, candidate, &work->failed) != 0)\n   136\t                        return;\n   137\t                }\n   138\t            }\n   139\t        } else if (symbol == NULL) {\n   140\t            size_t j;\n   141\t            if (item.origin > work->position)\n   142\t                continue;\n   143\t            for (j = 0; j < work->charts[item.origin].count; j++) {\n   144\t                ChartItem parent = work->charts[item.origin].data[j];\n   145\t                const GrammarSymbol *wanted = next_symbol(work->grammar, &parent);\n   146\t                if (wanted != NULL && wanted->kind == SYM_NONTERM &&\n   147\t                    rule_index(work->grammar, wanted->text) == item.rule) {\n   148\t                    ChartItem candidate = {parent.rule, parent.alternative, parent.dot + 1, parent.origin};\n   149\t                    if (add_candidate(out, candidate, &work->failed) != 0)\n   150\t                        return;\n   151\t                }\n   152\t            }\n   153\t        }\n   154\t    }\n   155\t}\n   156\t\n   157\tstatic int token_matches(const GrammarSymbol *symbol, const MarkupToken *token)\n   158\t{\n   159\t    if (symbol->kind == SYM_LITERAL)\n   160\t        return strcmp(symbol->text, token->lexeme) == 0;\n   161\t    if (symbol->kind == SYM_TOKEN) {\n   162\t        if (symbol->token_kind == TOK_IDENT) return token->kind == MARKUP_IDENT;\n   163\t        if (symbol->token_kind == TOK_STRING) return token->kind == MARKUP_STRING;\n   164\t        return token->kind == MARKUP_TEXT;\n   165\t    }\n   166\t    return 0;\n   167\t}\n   168\t\n   169\tstatic void scan_task(void *context, size_t worker, size_t begin, size_t end)\n   170\t{\n   171\t    ScanWork *work = (ScanWork *)context;\n   172\t    CandidateVector *out = &work->candidates[worker];\n   173\t    size_t i;\n   174\t    if (end > work->current->count)\n   175\t        end = work->current->count;\n   176\t    if (begin < end)\n   177\t        work->task_counts[worker]++;\n   178\t    for (i = begin; i < end && !atomic_load(&work->failed); i++) {\n   179\t        const ChartItem *item = &work->current->data[i];\n   180\t        const GrammarSymbol *symbol = next_symbol(work->grammar, item);\n   181\t        if (symbol != NULL && symbol->kind != SYM_NONTERM &&\n   182\t            token_matches(symbol, &work->markup->tokens[work->position])) {\n   183\t            ChartItem candidate = {item->rule, item->alternative, item->dot + 1, item->origin};\n   184\t            if (add_candidate(out, candidate, &work->failed) != 0)\n   185\t                return;\n   186\t        }\n   187\t    }\n   188\t}\n   189\t\n   190\tstatic int candidate_compare(const void *left, const void *right)\n   191\t{\n   192\t    const ChartItem *a = (const ChartItem *)left;\n   193\t    const ChartItem *b = (const ChartItem *)right;\n   194\t    if (a->rule != b->rule) return a->rule < b->rule ? -1 : 1;\n   195\t    if (a->alternative != b->alternative) return a->alternative < b->alternative ? -1 : 1;\n   196\t    if (a->dot != b->dot) return a->dot < b->dot ? -1 : 1;\n   197\t    if (a->origin != b->origin) return a->origin < b->origin ? -1 : 1;\n   198\t    return 0;\n   199\t}\n   200\t\n   201\tstatic int merge_candidates(ItemVector *target, CandidateVector *vectors)\n   202\t{\n   203\t    size_t total = 0;\n   204\t    size_t i;\n   205\t    ChartItem *all;\n   206\t    size_t at = 0;\n   207\t    for (i = 0; i < 8; i++)\n   208\t        total += vectors[i].count;\n   209\t    if (total == 0)\n   210\t        return 0;\n   211\t    all = (ChartItem *)malloc(total * sizeof(*all));\n   212\t    if (all == NULL)\n   213\t        return -1;\n   214\t    for (i = 0; i < 8; i++) {\n   215\t        memcpy(all + at, vectors[i].data, vectors[i].count * sizeof(*all));\n   216\t        at += vectors[i].count;\n   217\t    }\n   218\t    qsort(all, total, sizeof(*all), candidate_compare);\n   219\t    for (i = 0; i < total; i++) {\n   220\t        if (add_item(target, all[i]) < 0) {\n   221\t            free(all);\n   222\t            return -1;\n   223\t        }\n   224\t    }\n   225\t    free(all);\n   226\t    return 0;\n   227\t}\n   228\t\n   229\tstatic void clear_candidates(CandidateVector *vectors)\n   230\t{\n   231\t    size_t i;\n   232\t    for (i = 0; i < 8; i++)\n   233\t        vectors[i].count = 0;\n   234\t}\n   235\t\n   236\tstatic void free_candidates(CandidateVector *vectors)\n   237\t{\n   238\t    size_t i;\n   239\t    for (i = 0; i < 8; i++)\n   240\t        free(vectors[i].data);\n   241\t}\n   242\t\n   243\tstatic void free_charts(ItemVector *charts, size_t count)\n   244\t{\n   245\t    size_t i;\n   246\t    for (i = 0; i < count; i++)\n   247\t        free(charts[i].data);\n   248\t    free(charts);\n   249\t}\n   250\t\n   251\tstatic void expected_append(char *expected, size_t capacity, const char *text)\n   252\t{\n   253\t    size_t used = strlen(expected);\n   254\t    while (*text != '\\0' && used + 1 < capacity)\n   255\t        expected[used++] = *text++;\n   256\t    expected[used] = '\\0';\n   257\t}\n   258\t\n   259\tstatic void expected_append_literal(char *expected, size_t capacity, const char *text)\n   260\t{\n   261\t    char escaped[8];\n   262\t    unsigned char c;\n   263\t    expected_append(expected, capacity, \"'\");\n   264\t    while (*text != '\\0') {\n   265\t        c = (unsigned char)*text++;\n   266\t        if (c == '\\n') expected_append(expected, capacity, \"\\\\n\");\n   267\t        else if (c == '\\r') expected_append(expected, capacity, \"\\\\r\");\n   268\t        else if (c == '\\t') expected_append(expected, capacity, \"\\\\t\");\n   269\t        else if (c == '\\\\') expected_append(expected, capacity, \"\\\\\\\\\");\n   270\t        else if (c == '\\'') expected_append(expected, capacity, \"\\\\'\");\n   271\t        else if (c < 0x20 || c >= 0x7f) {\n   272\t            (void)snprintf(escaped, sizeof(escaped), \"\\\\x%02X\", (unsigned)c);\n   273\t            expected_append(expected, capacity, escaped);\n   274\t        } else {\n   275\t            size_t used = strlen(expected);\n   276\t            if (used + 1 < capacity) {\n   277\t                expected[used] = (char)c;\n   278\t                expected[used + 1] = '\\0';\n   279\t            }\n   280\t        }\n   281\t    }\n   282\t    expected_append(expected, capacity, \"'\");\n   283\t}\n   284\t\n   285\tstatic void expected_add(char *expected, size_t capacity, const GrammarSymbol *symbol)\n   286\t{\n   287\t    if (expected[0] != '\\0')\n   288\t        expected_append(expected, capacity, \", \");\n   289\t    if (symbol->kind == SYM_LITERAL)\n   290\t        expected_append_literal(expected, capacity, symbol->text);\n   291\t    else if (symbol->token_kind == TOK_IDENT)\n   292\t        expected_append(expected, capacity, \"$IDENT\");\n   293\t    else if (symbol->token_kind == TOK_STRING)\n   294\t        expected_append(expected, capacity, \"$STRING\");\n   295\t    else\n   296\t        expected_append(expected, capacity, \"$TEXT\");\n   297\t}\n   298\t\n   299\tint recognize(const Grammar *grammar, const Markup *markup, Recognition *result)\n   300\t{\n   301\t    WorkerPool pool;\n   302\t    ItemVector *charts;\n   303\t    CandidateVector candidates[8];\n   304\t    size_t chart_count = markup->count + 1;\n   305\t    size_t position;\n   306\t    int pool_ok = 0;\n   307\t    memset(result, 0, sizeof(*result));\n   308\t    memset(&pool, 0, sizeof(pool));\n   309\t    memset(candidates, 0, sizeof(candidates));\n   310\t    charts = (ItemVector *)calloc(chart_count, sizeof(*charts));\n   311\t    if (charts == NULL)\n   312\t        return -1;\n   313\t    if (pool_start(&pool) != 0) {\n   314\t        free_charts(charts, chart_count);\n   315\t        return -1;\n   316\t    }\n   317\t    pool_ok = 1;\n   318\t    for (position = 0; position < grammar->rules[grammar->start_rule].count; position++) {\n   319\t        ChartItem seed = {grammar->start_rule, position, 0, 0};\n   320\t        if (add_item(&charts[0], seed) < 0)\n   321\t            goto failed;\n   322\t    }\n   323\t    for (position = 0; position <= markup->count; position++) {\n   324\t        size_t processed = 0;\n   325\t        while (processed < charts[position].count) {\n   326\t            ClosureWork work;\n   327\t            size_t snapshot = charts[position].count;\n   328\t            clear_candidates(candidates);\n   329\t            work.grammar = grammar;\n   330\t            work.charts = charts;\n   331\t            work.position = position;\n   332\t            work.candidates = candidates;\n   333\t            work.task_counts = result->tasks;\n   334\t            atomic_init(&work.failed, 0);\n   335\t            if (pool_run_range(&pool, processed, snapshot, closure_task, &work) != 0 ||\n   336\t                atomic_load(&work.failed))\n   337\t                goto failed;\n   338\t            result->rounds++;\n   339\t            if (merge_candidates(&charts[position], candidates) != 0)\n   340\t                goto failed;\n   341\t            processed = snapshot;\n   342\t        }\n   343\t        if (position < markup->count) {\n   344\t            ScanWork work;\n   345\t            clear_candidates(candidates);\n   346\t            work.grammar = grammar;\n   347\t            work.markup = markup;\n   348\t            work.current = &charts[position];\n   349\t            work.position = position;\n   350\t            work.candidates = candidates;\n   351\t            work.task_counts = result->tasks;\n   352\t            atomic_init(&work.failed, 0);\n   353\t            if (pool_run_range(&pool, 0, charts[position].count, scan_task, &work) != 0 ||\n   354\t                atomic_load(&work.failed))\n   355\t                goto failed;\n   356\t            result->rounds++;\n   357\t            if (merge_candidates(&charts[position + 1], candidates) != 0)\n   358\t                goto failed;\n   359\t        }\n   360\t    }\n   361\t    result->accepted = 0;\n   362\t    {\n   363\t        size_t i;\n   364\t        for (i = 0; i < charts[markup->count].count; i++) {\n   365\t            ChartItem item = charts[markup->count].data[i];\n   366\t            if (item.rule == grammar->start_rule && item.origin == 0 &&\n   367\t                next_symbol(grammar, &item) == NULL) {\n   368\t                result->accepted = 1;\n   369\t                break;\n   370\t            }\n   371\t        }\n   372\t    }\n   373\t    if (!result->accepted) {\n   374\t        size_t furthest = 0;\n   375\t        for (position = 0; position <= markup->count; position++) {\n   376\t            size_t i;\n   377\t            int active = 0;\n   378\t            for (i = 0; i < charts[position].count; i++)\n   379\t                if (next_symbol(grammar, &charts[position].data[i]) != NULL)\n   380\t                    active = 1;\n   381\t            if (active)\n   382\t                furthest = position;\n   383\t        }\n   384\t        result->error_position = furthest;\n   385\t        result->expected[0] = '\\0';\n   386\t        for (position = 0; position < charts[furthest].count; position++) {\n   387\t            const GrammarSymbol *symbol = next_symbol(grammar, &charts[furthest].data[position]);\n   388\t            if (symbol != NULL && symbol->kind != SYM_NONTERM)\n   389\t                expected_add(result->expected, sizeof(result->expected), symbol);\n   390\t        }\n   391\t        if (result->expected[0] == '\\0')\n   392\t            (void)snprintf(result->expected, sizeof(result->expected), \"markup token\");\n   393\t    }\n   394\t    free_candidates(candidates);\n   395\t    if (pool_ok)\n   396\t        pool_stop(&pool);\n   397\t    free_charts(charts, chart_count);\n   398\t    return 0;\n   399\t\n   400\tfailed:\n   401\t    free_candidates(candidates);\n   402\t    if (pool_ok)\n   403\t        pool_stop(&pool);\n   404\t    free_charts(charts, chart_count);\n   405\t    return -1;\n   406\t}\n   200\t\n   201\tstatic void parse_error(GrammarParser *parser, const char *message)\n   202\t{\n   203\t    if (!parser->diagnostic->present)\n   204\t        diagnostic_set(parser->diagnostic, parser->current.loc, message);\n   205\t}\n   206\t\n   207\tstatic int grow_array(void **data, size_t *capacity, size_t item_size, size_t needed)\n   208\t{\n   209\t    size_t next = *capacity == 0 ? 4 : *capacity;\n   210\t    void *grown;\n   211\t    while (next < needed) {\n   212\t        if (next > ((size_t)-1) / 2)\n   213\t            return -1;\n   214\t        next *= 2;\n   215\t    }\n   216\t    grown = realloc(*data, next * item_size);\n   217\t    if (grown == NULL)\n   218\t        return -1;\n   219\t    *data = grown;\n   220\t    *capacity = next;\n   221\t    return 0;\n   222\t}\n   223\t\n   224\tstatic int append_rule(Grammar *grammar, Rule **out)\n   225\t{\n   226\t    if (grow_array((void **)&grammar->rules, &grammar->rule_capacity, sizeof(*grammar->rules),\n   227\t                   grammar->rule_count + 1) != 0)\n   228\t        return -1;\n   229\t    *out = &grammar->rules[grammar->rule_count++];\n   230\t    memset(*out, 0, sizeof(**out));\n   231\t    return 0;\n   232\t}\n   233\t\n   234\tstatic int append_alternative(Rule *rule, Alternative **out)\n   235\t{\n   236\t    if (grow_array((void **)&rule->alternatives, &rule->capacity, sizeof(*rule->alternatives),\n   237\t                   rule->count + 1) != 0)\n   238\t        return -1;\n   239\t    *out = &rule->alternatives[rule->count++];\n   240\t    memset(*out, 0, sizeof(**out));\n   241\t    return 0;\n   242\t}\n   243\t\n   244\tstatic int append_symbol(Alternative *alternative, GrammarSymbol symbol)\n   245\t{\n   246\t    if (grow_array((void **)&alternative->symbols, &alternative->capacity, sizeof(*alternative->symbols),\n   247\t                   alternative->count + 1) != 0)\n   248\t        return -1;\n   249\t    alternative->symbols[alternative->count++] = symbol;\n   250\t    return 0;\n   251\t}\n   252\t\n   253\tstatic size_t find_rule(const Grammar *grammar, const char *name)\n   254\t{\n   255\t    size_t i;\n   256\t    for (i = 0; i < grammar->rule_count; i++)\n   257\t        if (strcmp(grammar->rules[i].name, name) == 0)\n   258\t            return i;\n   259\t    return (size_t)-1;\n   260\t}\n   261\t\n   262\tstatic int token_kind_from_name(const char *name, GrammarTokenKind *kind)\n   263\t{\n   264\t    if (strcmp(name, \"IDENT\") == 0) *kind = TOK_IDENT;\n   265\t    else if (strcmp(name, \"STRING\") == 0) *kind = TOK_STRING;\n   266\t    else if (strcmp(name, \"TEXT\") == 0) *kind = TOK_TEXT;\n   267\t    else return -1;\n   268\t    return 0;\n   269\t}\n   270\t\n   271\tstatic int parse_directives(GrammarParser *parser)\n   272\t{\n   273\t    if (parser->current.kind != G_PERCENT || strcmp(parser->current.text, \"start\") != 0) {\n   274\t        parse_error(parser, \"first directive must be %start NAME\");\n   275\t        return -1;\n   276\t    }\n   277\t    if (parser_advance(parser) != 0 || parser->current.kind != G_IDENT) {\n   278\t        parse_error(parser, \"expected start rule name\");\n   279\t        return -1;\n   280\t    }\n   281\t    parser->grammar->start_name = copy_text(parser->current.text, strlen(parser->current.text)