# Optional API-key cost estimate, in USD per million tokens.
#
# Leave every value empty for a ChatGPT-authenticated run. Those runs consume
# subscription credits/usage limits rather than per-token API dollars, so an
# exact per-run USD charge does not exist.  When the benchmark uses an API key,
# copy the current official rates for the exact models into the generated
# run's pricing.env file before invoking benchmark/evaluate.sh.
#
# Input token totals reported by Codex include cached input.  Supply the cached
# rate separately when the provider bills it at a different rate.
BENCHMARK_TERRA_INPUT_USD_PER_M=2.50
BENCHMARK_TERRA_CACHED_INPUT_USD_PER_M=0.25
BENCHMARK_TERRA_OUTPUT_USD_PER_M=15
BENCHMARK_LUNA_INPUT_USD_PER_M=1
BENCHMARK_LUNA_CACHED_INPUT_USD_PER_M=0.10
BENCHMARK_LUNA_OUTPUT_USD_PER_M=6
