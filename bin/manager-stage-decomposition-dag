#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 3 ]] || { printf 'Usage: %s ENV_FILE DAG_TSV COVERAGE_TSV\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
specification_review_is_accepted || die 'DAG staging requires an accepted current specification review'
architecture_fit_is_accepted || die 'DAG staging requires an accepted current architecture-fit review or force waiver'
project_plan_exists && { printf '%s\n' "$(project_plan_definition_file)"; exit 0; }
dag_source="$2"
coverage_source="$3"
[[ -f "$dag_source" && -f "$coverage_source" ]] || die 'DAG staging requires DAG and coverage TSV files'

acquire_project_lock
candidate_id="$({ sha256sum "$dag_source" "$coverage_source"; } | sha256sum | awk '{print $1}')"
candidate_dir="$(project_dir)/control/decomposition-dag-candidates/$candidate_id"
mkdir -p "$candidate_dir"
chmod 700 "$(project_dir)/control/decomposition-dag-candidates" "$candidate_dir"
install -m 600 "$dag_source" "$candidate_dir/dag.tsv.tmp.$$"
install -m 600 "$coverage_source" "$candidate_dir/coverage.tsv.tmp.$$"
mv "$candidate_dir/dag.tsv.tmp.$$" "$candidate_dir/dag.tsv"
mv "$candidate_dir/coverage.tsv.tmp.$$" "$candidate_dir/coverage.tsv"
state="$(decomposition_dag_candidate_state_file)"
tmp="$state.tmp.$$"
{
	printf 'status=STAGED\n'
	printf 'specification_sha256=%s\n' "$(specification_sha256)"
	printf 'repository_baseline=%s\n' "$(specification_review_repository_baseline)"
	printf 'domain_profiles_sha256=%s\n' "$(domain_profiles_sha256)"
	printf 'complexity_contract_sha256=%s\n' "$(complexity_contract_sha256)"
	printf 'directory=%s\n' "$candidate_dir"
	printf 'dag=%s\n' "$candidate_dir/dag.tsv"
	printf 'coverage=%s\n' "$candidate_dir/coverage.tsv"
	printf 'complexity=%s\n' "$candidate_dir/complexity.tsv"
	printf 'staged_at=%s\n' "$(timestamp_utc)"
} > "$tmp"
chmod 600 "$tmp"
mv "$tmp" "$state"

rejection_log="$candidate_dir/rejection.log"
rm -f "$rejection_log" "$candidate_dir/complexity.tsv"
set +e
(
	expected_dag_header="$(decomposition_typed_header)"
	complexity_dag_header="$(decomposition_complexity_header)"
	expected_coverage_header=$'obligation_id\tnode_ids\tevidence_plan'
	IFS= read -r dag_header < "$candidate_dir/dag.tsv" || die 'decomposition DAG is empty'
	IFS= read -r coverage_header < "$candidate_dir/coverage.tsv" || die 'specification coverage is empty'
	if (( HARNESS_DECOMPOSITION_CRITIC_ENABLED == 1 )); then
		[[ "$dag_header" == "$complexity_dag_header" ]] || die "fresh Sol decomposition requires the measured DAG header: $complexity_dag_header"
	else
		[[ "$dag_header" == "$expected_dag_header" || "$dag_header" == "$complexity_dag_header" ]] ||
			die "decomposition DAG header must be: $complexity_dag_header"
	fi
	[[ "$coverage_header" == "$expected_coverage_header" ]] || die "specification coverage header must be: $expected_coverage_header"
	(( $(awk 'END {print NR+0}' "$candidate_dir/dag.tsv") > 1 )) || die 'decomposition DAG has no nodes'
	if [[ "$dag_header" == "$complexity_dag_header" ]]; then
		validate_decomposition_measured_schema_file "$candidate_dir/dag.tsv" ||
			die 'measured decomposition DAG contains invalid or non-executable rows'
	fi
	specification_relative="$(realpath --relative-to="$REPOSITORY" "$SPECIFICATION" 2>/dev/null || true)"
	if [[ -n "$specification_relative" && "$specification_relative" != ../* ]]; then
		awk -F '\t' -v spec="$specification_relative" '
			function trim(v) {gsub(/^[[:space:]]+|[[:space:]]+$/, "", v); sub(/\/$/, "", v); return v}
			NR>1 {
				n=split($7,a,",")
				for(i=1;i<=n;i++) {
					path=trim(a[i])
					if(path==spec || index(spec,path "/")==1) {
						printf "executable DAG node %s authorizes mutation of the governing specification through allowed path %s\n",$1,path > "/dev/stderr"
						errors++
					}
				}
			}
			END{exit(errors?1:0)}
		' "$candidate_dir/dag.tsv" || die 'decomposition DAG must treat the accepted governing specification as immutable authority'
	fi
	validate_specification_coverage_file "$candidate_dir/coverage.tsv" "$candidate_dir/dag.tsv"
	if [[ "$dag_header" == "$complexity_dag_header" ]]; then
		write_decomposition_complexity_report "$candidate_dir/dag.tsv" "$candidate_dir/coverage.tsv" "$candidate_dir/complexity.tsv"
	fi
) > >(tee "$rejection_log") 2>&1
validation_status=$?
set -e
if (( validation_status != 0 )); then
	sed -i 's/^status=.*/status=REJECTED/' "$state"
	printf 'rejection_log=%s\n' "$rejection_log" >> "$state"
	log_event "DECOMPOSITION_DAG_REJECTED directory=$candidate_dir status=$validation_status"
	printf 'REJECTION_LOG=%s\n' "$rejection_log" >&2
	die 'decomposition DAG candidate failed deterministic staging validation'
fi
rm -f "$rejection_log"
log_event "DECOMPOSITION_DAG_STAGED directory=$candidate_dir nodes=$(( $(wc -l < "$candidate_dir/dag.tsv") - 1 ))"
printf '%s\n' "$candidate_dir"
