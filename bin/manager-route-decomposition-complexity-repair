#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
project_plan_exists && { printf 'Decomposition DAG already exists.\n'; exit 0; }
decomposition_candidate_matches_current_inputs || die 'no current full decomposition candidate exists'
[[ "$(decomposition_candidate_state_value status)" == REJECTED ]] ||
	die 'complexity routing requires a rejected full candidate'

candidate_dir="$(decomposition_candidate_state_value directory)"
rejection_log="$(decomposition_candidate_state_value rejection_log "$candidate_dir/rejection.log")"
grep -Eq 'LUNA_COMPLEXITY_OVER_BUDGET .*status=OVER_BUDGET' "$rejection_log" ||
	die 'candidate rejection has no recursively decomposable over-budget node'

# Re-stage the exact bound DAG/coverage through the pre-binding validator. It
# deterministically writes the complexity report and a rejected DAG checkpoint
# consumed by manager-decomposition-dag-repair.
set +e
"$HARNESS_BIN/manager-stage-decomposition-dag" "$HARNESS_ENV_FILE" \
	"$candidate_dir/dag.tsv" "$candidate_dir/coverage.tsv"
stage_status=$?
set -e
decomposition_dag_candidate_matches_current_inputs ||
	die 'complexity routing did not create a current DAG candidate'
[[ "$(decomposition_dag_candidate_state_value status)" == REJECTED ]] ||
	die "complexity routing expected a rejected DAG checkpoint; staging status was $stage_status"

state="$(decomposition_candidate_state_file)"
state_tmp="$state.tmp.$$"
awk -F= 'BEGIN {OFS="="} $1=="status" {$2="REPAIR_ROUTED"} {print}' "$state" > "$state_tmp"
printf 'repair_route=recursive_decomposition\n' >> "$state_tmp"
printf 'repair_routed_at=%s\n' "$(timestamp_utc)" >> "$state_tmp"
chmod 600 "$state_tmp"
mv "$state_tmp" "$state"
log_event "DECOMPOSITION_COMPLEXITY_REPAIR_ROUTED full_candidate=$candidate_dir dag_candidate=$(decomposition_dag_candidate_state_value directory)"
printf 'Over-budget full candidate routed to bounded recursive DAG decomposition.\n'
