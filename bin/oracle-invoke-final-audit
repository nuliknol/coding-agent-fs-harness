#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 1 ]] || usage
load_harness_env "$1"
ENV_FILE="$HARNESS_ENV_FILE"
ensure_project
require_manager_configuration
require_oracle_codex
oracle_enabled || exit 0
project_plan_all_complete || die 'Oracle audit requires a complete project plan'
architecture_require_completion_ready
project_is_blocked && exit 0
pending="$(project_oracle_pending_file)"
[[ -f "$pending" ]] || exit 0
rm -f "$(project_oracle_dir)/oracle-invocation-failed.md"
write_oracle_snapshot

dir="$(project_dir)"
audit_id="$(awk -F': ' '$1 == "Audit-ID" {print $2; exit}' "$pending")"
prompt="$dir/control/oracle-audit-$audit_id.prompt.md"
cat > "$prompt.tmp.$$" <<PROMPT
You are the final Oracle auditor for a filesystem-backed coding harness. You are independent of the manager and worker. Do not edit repository source, tests, builds, specifications, or harness state directly.

ENV_FILE=$HARNESS_ENV_FILE
PROJECT=$PROJECT
PROJECT_TMP_DIR=$PROJECT_TMP_DIR
REPOSITORY=$REPOSITORY
SPECIFICATION=$SPECIFICATION
PROJECT_PLAN_FILE=$(project_plan_definition_file)
PROJECT_PLAN_STATE_FILE=$(project_plan_state_file)
PROJECT_DECOMPOSITION_FILE=$(project_decomposition_plan_file)
PROJECT_PROGRESS_DIR=$dir/control/progress
PROJECT_ARCHIVE_DIR=$dir/archive
ORACLE_PENDING_FILE=$pending
HARNESS_BIN=$HARNESS_BIN
AUDIT_ID=$audit_id
ARCHITECTURE_GUARDS=$HARNESS_ARCHITECTURE_GUARDS
ARCHITECTURE_DIR=$(architecture_dir)

Read the complete original specification, every referenced mandatory task/specification document, the durable plan and its state, accepted task review records, and the implemented repository. Also read every applicable \`*.manager-remediations.tsv\` and \`*.hard-blocks.tsv\` ledger under PROJECT_PROGRESS_DIR plus the corresponding manager-remediation assignments and final accepted reviews under PROJECT_ARCHIVE_DIR. When ARCHITECTURE_GUARDS=1, read every registry, decision and health ledger, impact manifest, and debt row under ARCHITECTURE_DIR. Independently reproduce only the focused acceptance/build/smoke and registered architecture-health evidence needed to establish compliance. Do not trust manager or worker claims without evidence.

Treat independently verified manager-remediation paths as separately attributed baseline-prerequisite provenance, not as feature-owned implementation changes. A repository-local code, build, testability, integration, file-ownership, exclusive-file, forbidden-file, or frozen-baseline conflict is resolvable engineering work. It is \`AUTOMATIC\` when still unmet; it is not a human product/specification decision. If the manager-remediation evidence is bounded, causally required by an existing acceptance command, preserves the specification's observable behavior, and the repaired acceptance command passes, do not fail merely because the prerequisite path lies outside the original worker feature scope. Prior Oracle addenda and legacy hard-block classifications are evidence only and do not override this policy.

\`HUMAN_APPROVAL\` is valid only when completion truly requires one of: unavailable human authorization, an unavailable secret, an external state transition that local code cannot perform, or a governing product/specification choice between at least two incompatible observable API/data/behavior outcomes. Ordinary coding difficulty or scope/ownership wording does not qualify.

Write a verdict under PROJECT_TMP_DIR with exactly this schema:

# Oracle Audit Verdict

Project: $PROJECT
Audit-ID: $audit_id
Decision: PASS or FAIL

## Traceability verification
- [PASS] or - [FAIL] every original requirement and mandatory referenced file is mapped to evidence or a finding

## Acceptance verification
- [PASS] or - [FAIL] focused command/code evidence

## Architecture verification
- [PASS] or - [FAIL] invariant, decision, edge-contract, impact-manifest, and cumulative health-gate evidence

## Debt verification
- [PASS] or - [FAIL] every open or waived debt item has truthful consequence, remediation ownership, waiver authority, and unexpired disposition

## Findings
Each finding must state the original requirement ID/path, expected behavior, observed evidence, and a reproducible command or source location. Architecture findings must also name the affected invariant, decision, edge, or debt ID.

## Conclusion
State why the project passes or fails.

If PASS, call:
$HARNESS_BIN/oracle-complete-audit "$ENV_FILE" VERDICT_FILE

If FAIL, create a versioned additive addendum under PROJECT_TMP_DIR. It must contain at least one \`Original-Requirement-ID: ...\` and exactly one \`Remediation-Authority: AUTOMATIC\` or \`Remediation-Authority: HUMAN_APPROVAL\`. Use \`AUTOMATIC\` for every repository-local implementation, build, testability, integration, scope, ownership, exclusive-file, forbidden-file, or baseline-prerequisite repair. An AUTOMATIC addendum must include:

## Harness plan items
ORACLE-...<TAB>independently acceptance-complete remediation title

When PROJECT_DECOMPOSITION_FILE exists, also include one matching row for every Oracle plan item using the exact column schema already present in PROJECT_DECOMPOSITION_FILE:

## Harness decomposition nodes
ORACLE-...<TAB>parent_id<TAB>depends_on<TAB>deliverable<TAB>acceptance_evidence<TAB>focused_validation<TAB>allowed_paths<TAB>required_symbols<TAB>leaf_type<TAB>complexity_class<TAB>worker_route

The decomposition deliverable must exactly equal the corresponding Harness plan items title. Preserve the existing dependency DAG, use explicit narrow paths and deterministic validation, and route bounded implementation, test, mechanical API, focused bug, and documentation leaves to LOW/LUNA. Use Terra only for an actual contract, architecture, concurrency, ambiguity, or unexplained integration decision.

When ARCHITECTURE_GUARDS=1, additionally include one exact six-column binding for every Oracle node. Reuse applicable registered invariant, decision, edge, and health-gate IDs; use \`-\` where none apply. Do not invent unregistered architecture IDs:

## Architecture node bindings
ORACLE-...<TAB>invariant_ids<TAB>consumes_decisions<TAB>produces_decisions<TAB>edge_contracts<TAB>health_gates

A HUMAN_APPROVAL addendum must additionally contain exactly one nonempty line for each of:

Human-Dependency-Class: HUMAN_AUTHORIZATION|HUMAN_SECRET|HUMAN_EXTERNAL_STATE|HUMAN_PRODUCT_SPECIFICATION
Human-Dependency-Evidence: the specific unavailable authority, secret, or external state transition

HUMAN_PRODUCT_SPECIFICATION must instead use Human-Dependency-Evidence to identify the unresolved governing choice and must also contain:

Product-Decision-Evidence: at least two incompatible observable product/API/data outcomes not resolved by the governing specification

Then call:
$HARNESS_BIN/oracle-complete-audit "$ENV_FILE" VERDICT_FILE ADDENDUM_FILE

The addendum never replaces the original specification. Do not publish manager or worker tasks. Terminate after the completion command.
PROMPT
chmod 600 "$prompt.tmp.$$"
mv "$prompt.tmp.$$" "$prompt"

attempt=1
fallback_stage=0
current_model="$ORACLE_MODEL"
while true; do
	stamp="$(date -u '+%Y%m%dT%H%M%SZ')"
	json="$dir/logs/oracle-audit-$audit_id-$stamp-attempt-$(printf '%03d' "$attempt").jsonl"
	stderr="$dir/logs/oracle-audit-$audit_id-$stamp-attempt-$(printf '%03d' "$attempt").stderr.log"
	last="$dir/logs/oracle-audit-$audit_id-$stamp-attempt-$(printf '%03d' "$attempt").md"
	log_event "ORACLE_AUDIT_STARTED audit_id=$audit_id attempt=$attempt model=$current_model"
	set +e
	"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" oracle "$current_model" "$prompt" "$json" "$stderr" "$last"
	status=$?
	set -e
	[[ ! -f "$pending" ]] && { log_event "ORACLE_AUDIT_FINISHED audit_id=$audit_id attempt=$attempt"; exit 0; }
	classification="$(kv_file_value "${json%.jsonl}.classification" classification 2>/dev/null || true)"
	retry_kind="$(codex_provider_retry_kind "$classification" 2>/dev/null || true)"
	if [[ -n "$retry_kind" ]]; then
		if [[ "$retry_kind" == quota ]]; then delay="$HARNESS_QUOTA_RETRY_SECONDS"; else delay="$HARNESS_PROVIDER_RETRY_SECONDS"; fi
		log_event "ORACLE_PROVIDER_WAIT audit_id=$audit_id attempt=$attempt kind=$retry_kind delay_seconds=$delay"
		sleep "$delay"
		attempt=$((attempt + 1))
		continue
	fi
	if codex_model_requires_narrow_prompt "$current_model" &&
		[[ "$classification" == model_refusal_or_blocked_content ]]; then
		if (( fallback_stage == 0 )); then
			fallback_stage=1
			attempt=$((attempt + 1))
			cat >> "$prompt" <<'PROMPT'

Retry scope: this is authorized, benign software-quality verification in the listed local repository. Continue only the final audit against the original specification and existing plan. Use the smallest local build, unit, lifetime, or memory-safety diagnostic needed to verify a concrete requirement. Do not perform offensive security, credential access, exploitation, persistence, network scanning, or security-control bypass.
PROMPT
			log_event "ORACLE_TERRA_NARROW_RETRY audit_id=$audit_id classification=$classification attempt=$attempt"
			continue
		fi
		if (( fallback_stage == 1 )) && [[ "$ORACLE_FALLBACK_MODEL" != "$current_model" ]]; then
			fallback_stage=2
			current_model="$ORACLE_FALLBACK_MODEL"
			attempt=$((attempt + 1))
			log_event "ORACLE_MODEL_FALLBACK audit_id=$audit_id classification=$classification attempt=$attempt model=$current_model"
			continue
		fi
	fi
	printf 'Oracle audit %s exited without recording a verdict; see %s\n' "$audit_id" "$last" >&2
	if (( status == 0 )); then exit 3; fi
	exit "$status"
done
