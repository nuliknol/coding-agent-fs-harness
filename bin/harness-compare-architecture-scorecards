#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[[ $# -eq 2 ]] || { printf 'Usage: %s BEFORE_TSV AFTER_TSV\n' "${0##*/}" >&2; exit 2; }
for file in "$@"; do [[ -f "$file" ]] || { printf 'missing scorecard: %s\n' "$file" >&2; exit 2; }; done
exec python3 "$SCRIPT_DIR/../tools/compare_architecture_scorecards.py" "$1" "$2"
