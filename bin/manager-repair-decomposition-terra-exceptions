#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
project_plan_exists && { printf 'Decomposition DAG already exists.\n'; exit 0; }
decomposition_candidate_matches_current_inputs || die 'no current full decomposition candidate exists'
[[ "$(decomposition_candidate_state_value status)" == REJECTED ]] ||
	die 'Terra-exception repair requires a rejected candidate'

candidate_dir="$(decomposition_candidate_state_value directory)"
architecture_source="$(decomposition_candidate_state_value architecture_directory -)"
rejection_log="$(decomposition_candidate_state_value rejection_log "$candidate_dir/rejection.log")"
if (( HARNESS_ARCHITECTURE_GUARDS == 1 )); then
	[[ "$architecture_source" != - && -d "$architecture_source" ]] ||
		die 'Terra-exception repair requires an architecture registry'
fi
grep -q 'status=INVALID_TERRA_EXCEPTION' "$rejection_log" ||
	die 'candidate rejection has no invalid Terra-exception diagnostic'

repair_dir="$PROJECT_TMP_DIR/decomposition-terra-exception-repair-${candidate_dir##*/}"
rm -rf -- "$repair_dir"
mkdir -p "$repair_dir"
install -m 600 "$candidate_dir/coverage.tsv" "$repair_dir/coverage.tsv"
repair_architecture='-'
if [[ "$architecture_source" != - ]]; then
	mkdir -p "$repair_dir/architecture"
	for name in invariants decisions edges node-bindings health-gates debt; do
		install -m 600 "$architecture_source/$name.tsv" "$repair_dir/architecture/$name.tsv"
	done
	repair_architecture="$repair_dir/architecture"
fi

# terra_exception is an enum, not a prose justification. Normalize only
# integration leaves whose rejected value explicitly claims irreducibility;
# any other invalid value still requires semantic decomposition.
awk -F '\t' -v OFS='\t' -v diagnostics="$rejection_log" '
	BEGIN {
		while ((getline line < diagnostics) > 0) {
			if (line ~ /status=INVALID_TERRA_EXCEPTION/ &&
				match(line, /node=[^ ]+/)) {
				node=substr(line, RSTART + 5, RLENGTH - 5)
				wanted[node]=1
			}
		}
	}
	NR == 1 { print; next }
	$1 in wanted {
		value=tolower($20)
		if ($11 != "TERRA" || $9 != "INTEGRATION" || value !~ /^irreducible/) {
			printf "unsupported Terra exception normalization for node %s\n", $1 > "/dev/stderr"
			errors++
			next
		}
		$10="HIGH"
		$20="IRREDUCIBLE_CROSS_BOUNDARY"
		normalized[$1]=1
	}
	{ print }
	END {
		for (node in wanted) if (!(node in normalized)) {
			printf "missing Terra exception row for node %s\n", node > "/dev/stderr"
			errors++
		}
		exit errors ? 1 : 0
	}
' "$candidate_dir/dag.tsv" > "$repair_dir/dag.tsv"
chmod 600 "$repair_dir/dag.tsv"

set +e
"$HARNESS_BIN/manager-submit-decomposition" "$HARNESS_ENV_FILE" \
	"$repair_dir/dag.tsv" "$repair_dir/coverage.tsv" "$repair_architecture"
status=$?
set -e
if project_plan_exists; then
	log_event "DECOMPOSITION_TERRA_EXCEPTIONS_NORMALIZED source=$candidate_dir"
	printf 'Terra integration exceptions normalized and installed.\n'
	exit 0
fi
new_candidate_dir="$(decomposition_candidate_state_value directory -)"
if [[ "$new_candidate_dir" != - && "$new_candidate_dir" != "$candidate_dir" ]] &&
	decomposition_candidate_matches_current_inputs; then
	log_event "DECOMPOSITION_TERRA_EXCEPTION_PROGRESS previous=${candidate_dir##*/} current=${new_candidate_dir##*/} status=$(decomposition_candidate_state_value status -)"
	printf 'Terra integration exceptions normalized; continuing with the next bounded diagnostic.\n'
	exit 0
fi
(( status == 0 )) && die 'Terra-exception normalization returned success without installing or advancing the candidate'
die "Terra-exception normalization failed with status $status"
