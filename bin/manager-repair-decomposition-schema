#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
project_plan_exists && { printf 'Decomposition DAG already exists.\n'; exit 0; }
decomposition_candidate_matches_current_inputs || die 'no current full decomposition candidate exists'
[[ "$(decomposition_candidate_state_value status)" == REJECTED ]] || die 'schema repair requires a rejected candidate'

candidate_dir="$(decomposition_candidate_state_value directory)"
architecture_source="$(decomposition_candidate_state_value architecture_directory -)"
rejection_log="$(decomposition_candidate_state_value rejection_log "$candidate_dir/rejection.log")"
[[ "$architecture_source" != - && -d "$architecture_source" ]] || die 'schema repair requires an architecture registry'
grep -Eq 'invalid invariant severity|invariant .* has empty required fields|invalid invariant validation_kind' "$rejection_log" ||
	die 'candidate rejection is not a supported schema alias defect'

repair_dir="$PROJECT_TMP_DIR/decomposition-schema-repair-${candidate_dir##*/}"
rm -rf -- "$repair_dir"
mkdir -p "$repair_dir/architecture"
install -m 600 "$candidate_dir/dag.tsv" "$repair_dir/dag.tsv"
install -m 600 "$candidate_dir/coverage.tsv" "$repair_dir/coverage.tsv"
for name in decisions edges node-bindings health-gates debt; do
	install -m 600 "$architecture_source/$name.tsv" "$repair_dir/architecture/$name.tsv"
done

# Sol commonly expresses mandatory severity as MUST or HARD. The registry has
# a smaller normalized vocabulary; this conversion changes no requirement
# meaning and avoids spending another model turn on TSV syntax.
awk -F '\t' -v OFS='\t' '
	NR == 1 { print; next }
	$4 == "MUST" || $4 == "HARD" || $4 == "REQUIRED" || $4 == "HIGH" { $4="CRITICAL" }
	$4 == "MEDIUM" { $4="WARNING" }
	$4 == "LOW" || $4 == "ADVISORY" { $4="INFO" }
	{ print }
' "$architecture_source/invariants.tsv" > "$repair_dir/architecture/invariants.tsv"
chmod 600 "$repair_dir/architecture/invariants.tsv"

awk -F '\t' -v OFS='\t' '
	NR == 1 { print; next }
	$8 == "FOCUSED" || $8 == "FOCUSED_SELECTOR" || $8 == "FOCUSED_INSPECTION" { $8="REVIEW" }
	{ print }
' "$repair_dir/architecture/invariants.tsv" > "$repair_dir/architecture/invariants.tsv.normalized"
mv "$repair_dir/architecture/invariants.tsv.normalized" "$repair_dir/architecture/invariants.tsv"
chmod 600 "$repair_dir/architecture/invariants.tsv"

set +e
"$HARNESS_BIN/manager-submit-decomposition" "$HARNESS_ENV_FILE" \
	"$repair_dir/dag.tsv" "$repair_dir/coverage.tsv" "$repair_dir/architecture"
status=$?
set -e
if project_plan_exists; then
	log_event "DECOMPOSITION_SCHEMA_REPAIRED kind=invariant-severity source=$candidate_dir"
	printf 'Decomposition schema normalized and installed.\n'
	exit 0
fi
new_candidate_dir="$(decomposition_candidate_state_value directory -)"
if [[ "$new_candidate_dir" != - && "$new_candidate_dir" != "$candidate_dir" ]] &&
	decomposition_candidate_matches_current_inputs; then
	log_event "DECOMPOSITION_SCHEMA_PROGRESS kind=invariant-severity previous=${candidate_dir##*/} current=${new_candidate_dir##*/} status=$(decomposition_candidate_state_value status -)"
	printf 'Decomposition schema normalized; continuing with the next bounded diagnostic.\n'
	exit 0
fi
(( status == 0 )) && die 'schema normalization returned success without installing or advancing the candidate'
die "schema normalization failed with status $status"
