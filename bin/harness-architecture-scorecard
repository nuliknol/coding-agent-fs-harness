#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"
source "$SCRIPT_DIR/../lib/harness-repository-index.sh"
[[ $# -ge 1 && $# -le 2 ]] || { printf 'Usage: %s ENV_FILE [--source-only]\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"; ensure_project
if [[ "${2:-}" == --source-only ]]; then
	index_output="$("$HARNESS_BIN/harness-architecture-source-index" "$HARNESS_ENV_FILE")"
	generation="$(sed -n 's/^SOURCE_ARCHITECTURE_READY generation=\([^ ]*\) path=.*/\1/p' <<< "$index_output")"
	generation_dir="$(sed -n 's/^SOURCE_ARCHITECTURE_READY generation=[^ ]* path=//p' <<< "$index_output")"
	output_dir="$(project_dir)/control/architecture-scorecards/$generation"; mkdir -p "$output_dir"
	benchmark_args=()
	[[ ! -s "$generation_dir/benchmarks.tsv" ]] || benchmark_args=(--benchmarks "$generation_dir/benchmarks.tsv")
	python3 "$HARNESS_HOME/tools/architecture_scorecard.py" --maps-dir "$generation_dir" \
		--generation "$generation" --output "$output_dir/scorecard.tsv" \
		--proposal "$output_dir/rebuild-proposal.md" "${benchmark_args[@]}"
	architecture_rebuild_record_candidate "$generation" \
		"$output_dir/scorecard.tsv" "$output_dir/rebuild-proposal.md"
	cat "$output_dir/scorecard.tsv"
	printf 'proposal\t%s\n' "$output_dir/rebuild-proposal.md"
	exit 0
fi
repository_index_project_pointer_is_current || die "scorecard requires a current index: $REPOSITORY_INDEX_POINTER_REASON"
pointer="$(repository_index_project_pointer_file)"; generation="$(kv_file_value "$pointer" generation)"; generation_dir="$(kv_file_value "$pointer" generation_dir)"
output_dir="$(project_dir)/control/architecture-scorecards/$generation"; mkdir -p "$output_dir"
benchmarks="$(architecture_evidence_root)/$generation/benchmarks.tsv"
benchmark_args=()
[[ ! -s "$benchmarks" ]] || benchmark_args=(--benchmarks "$benchmarks")
python3 "$HARNESS_HOME/tools/architecture_scorecard.py" --database "$generation_dir/architecture.sqlite" \
	--generation "$generation" --output "$output_dir/scorecard.tsv" --proposal "$output_dir/rebuild-proposal.md" \
	"${benchmark_args[@]}"
architecture_rebuild_record_candidate "$generation" \
	"$output_dir/scorecard.tsv" "$output_dir/rebuild-proposal.md"
cat "$output_dir/scorecard.tsv"
printf 'proposal\t%s\n' "$output_dir/rebuild-proposal.md"
