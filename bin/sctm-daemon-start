#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"
source "$SCRIPT_DIR/../lib/harness-sctm.sh"
[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"; ensure_project; sctm_ensure_state
pid_file="$(sctm_pid_file)"
if sctm_pid_is_live; then
	printf 'SCTM daemon is already running with PID %s.\n' "$(cat "$pid_file")"
	exit 0
fi
rm -f "$pid_file"
log_file="$(project_dir)/logs/sctm-daemon.log"
setsid "$HARNESS_BIN/sctm-daemon" "$HARNESS_ENV_FILE" </dev/null >>"$log_file" 2>&1 &
pid=$!
for _ in $(seq 1 100); do
	if [[ -f "$pid_file" ]]; then
		printf 'SCTM daemon started with PID %s.\n' "$(cat "$pid_file")"
		exit 0
	fi
	kill -0 "$pid" 2>/dev/null || break
	sleep 0.1
done
die "SCTM daemon failed to start; inspect $log_file"
