#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || die "Usage: ${0##*/} ENV_FILE"
load_harness_env "$1"
ensure_project
if supervisor_running; then
	printf 'Supervisor is already running with PID %s.\n' "$(supervisor_pid)"
	exit 0
fi

log="$(project_dir)/logs/supervisor.log"
nohup setsid "$HARNESS_BIN/harness-supervisor" "$HARNESS_ENV_FILE" \
	</dev/null >> "$log" 2>&1 &
launcher_pid=$!
for _ in 1 2 3 4 5; do
	sleep 1
	if supervisor_running; then
		printf 'Started light harness supervisor with PID %s.\n' "$(supervisor_pid)"
		printf 'Supervisor log: %s\n' "$log"
		exit 0
	fi
	if [[ "$(state_value status)" != ACTIVE ]]; then
		printf 'Supervisor reached terminal status %s.\n' "$(state_value status)"
		printf 'Supervisor log: %s\n' "$log"
		exit 0
	fi
	kill -0 "$launcher_pid" 2>/dev/null || break
done
printf 'Supervisor did not remain running; inspect %s\n' "$log" >&2
exit 1
