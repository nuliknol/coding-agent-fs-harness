#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-mode.sh"
harness_dispatch_mode "$SCRIPT_DIR/.." "${0##*/}" "$@"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 1 ]] || usage
load_harness_env "$1"
ensure_project
require_goal_mode_clean_boundary

# The manager supervisor consumes an installed project plan. Route a direct
# supervisor-start request for a pre-plan project through the detached startup
# transaction so specification review, recursive decomposition, architecture
# binding, and bootstrap occur before either supervisor is launched.
if ! project_plan_exists; then
	exec "$HARNESS_BIN/harness-start" --background "$HARNESS_ENV_FILE"
fi

trace_init manager_supervisor_start
trace_script_start "$@"
trap 'trace_script_exit $?' EXIT
dir="$(project_dir)"
pid_file="$dir/control/supervisor.pid"

if [[ -f "$pid_file" ]]; then
	pid="$(cat "$pid_file")"
	if kill -0 "$pid" 2>/dev/null; then
		trace_event SUPERVISOR_START_SKIPPED "pid=$pid" "reason=already_running"
		printf 'Supervisor is already running with PID %s.\n' "$pid"
		exit 0
	fi
	rm -f "$pid_file"
fi

log_file="$dir/logs/supervisor.log"
# Launch in a fresh session so the watcher survives the launcher shell exiting
# under stricter PTY/process-tree cleanup environments.
setsid "$HARNESS_BIN/harness-supervisor" "$HARNESS_ENV_FILE" </dev/null >> "$log_file" 2>&1 &
pid=$!
trace_event SUPERVISOR_LAUNCH "pid=$pid" "log_file=$log_file" "command=$HARNESS_BIN/harness-supervisor"
# Startup validates architecture and rebuilds throughput/conflict sidecars before
# publishing the PID. Large installed DAGs can legitimately need more than the
# old five-second probe window; keep the launch bounded but wait for readiness
# instead of misclassifying a healthy supervisor and suppressing worker startup.
for _ in $(seq 1 300); do
	if [[ -f "$pid_file" ]]; then
		trace_event SUPERVISOR_STARTED_CONFIRMED "pid=$(cat "$pid_file")"
		printf 'Supervisor started with PID %s.\n' "$(cat "$pid_file")"
		printf 'Environment file: %s\n' "$HARNESS_ENV_FILE"
		printf 'Log: %s\n' "$log_file"
		exit 0
	fi
	kill -0 "$pid" 2>/dev/null || break
	sleep 0.1
done
printf 'Supervisor failed to start; inspect %s\n' "$log_file" >&2
exit 1
