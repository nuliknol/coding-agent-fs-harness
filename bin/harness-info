#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-mode.sh"
harness_dispatch_mode "$SCRIPT_DIR/.." "${0##*/}" "$@"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project

dir="$(project_dir)"
version='unknown'
[[ ! -f "$HARNESS_HOME/VERSION" ]] || version="$(<"$HARNESS_HOME/VERSION")"

printf 'Project information\n'
printf '  Project: %s\n' "$PROJECT"
printf '  Harness version / mode: %s / %s\n' "$version" "$HARNESS_MODE"
printf '  Environment: %s\n' "$HARNESS_ENV_FILE"
printf '  Repository: %s\n' "$REPOSITORY"
printf '  Specification: %s\n' "$SPECIFICATION"
printf '  State: %s\n' "$dir"

printf '\nSpecification model\n'
if (( HARNESS_SPECIFICATION_REVIEW_ENABLED == 1 )); then
	if specification_review_is_accepted; then
		current_review_status='ACCEPTED'
		printf '  Review: %s\n' "$current_review_status"
		printf '  Report: %s\n' "$(specification_review_report_relative_path)"
	elif specification_review_matches_current_inputs; then
		current_review_status="$(specification_review_state_value status UNKNOWN)"
		printf '  Review: %s\n' "$current_review_status"
		printf '  Report: %s\n' "$(specification_review_report_relative_path)"
		if [[ "$current_review_status" == SPEC_CLARIFICATION_REQUIRED ]]; then
			printf '  Copy/paste request: harness-show-clarification-request %s\n' "$HARNESS_ENV_FILE"
		fi
	else
		printf '  Review: PENDING (current inputs do not match an accepted review)\n'
	fi
else
	printf '  Review: disabled\n'
fi
if specification_ir_available; then
	printf '  Obligations / relations: %s / %s\n' \
		"$(specification_obligation_count)" "$(specification_review_state_value relation_count 0)"
	printf '  Coverage mapped / verified: %s / %s\n' \
		"$(specification_coverage_mapped_count)" "$(specification_coverage_verified_count)"
	printf '  Domain profiles: %s\n' "${HARNESS_DOMAIN_PROFILES:-none}"
elif specification_ir_registered; then
	printf '  Specification IR: INVALID\n'
else
	printf '  Specification IR: not registered\n'
fi

printf '\nDecomposition\n'
if architecture_redesign_matches_current_inputs &&
	[[ "$(architecture_redesign_state_value status)" == ARCHITECTURE_REDESIGN_REQUIRED ]]; then
	if architecture_redesign_force_matches_current_inputs; then
		printf '  Architecture fit: FORCE_DECOMPOSITION_AUTHORIZED\n'
	else
		printf '  Architecture fit: ARCHITECTURE_REDESIGN_REQUIRED\n'
	fi
	printf '  Redesign report: %s\n' "$(architecture_redesign_report_relative_path)"
	printf '  Copy/paste request: harness-show-redesign-request %s\n' "$HARNESS_ENV_FILE"
elif project_plan_exists; then
	printf '  Architecture fit: ACCEPTED\n'
else
	printf '  Architecture fit: PENDING\n'
fi
if project_plan_uses_dag; then
	dag="$(project_decomposition_plan_file)"
	read -r nodes luna terra coding luna_coding typed < <(awk -F '\t' '
		NR == 1 {typed=($9 == "leaf_type"); next}
		NR > 1 {
			nodes++
			route=typed ? $11 : $10
			if (route == "LUNA") luna++; else if (route == "TERRA") terra++
			if (typed && $9 ~ /^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION)$/) {
				coding++; if (route == "LUNA") luna_coding++
			}
		}
		END {print nodes+0, luna+0, terra+0, coding+0, luna_coding+0, typed+0}
	' "$dag")
	printf '  DAG nodes: %s (%s complete)\n' "$nodes" "$(project_plan_complete_count)"
	printf '  Routes: Luna=%s Terra=%s\n' "$luna" "$terra"
	if (( typed )); then
		printf '  Luna coding nodes: %s/%s\n' "$luna_coding" "$coding"
	else
		printf '  Luna coding nodes: unavailable for legacy untyped DAG\n'
	fi
	printf '  Preferred route: %s\n' "$HARNESS_PREFERRED_WORKER_ROUTE"
	printf '  Luna context bounds: obligations<=%s capsule<=%s bytes\n' \
		"$HARNESS_MAX_LUNA_OBLIGATIONS_PER_LEAF" "$HARNESS_MAX_LUNA_CONTEXT_CAPSULE_BYTES"
	printf '  Measured Luna bounds: score<=%s actions<=%s p95-tokens<=%s files<=%s risk-domains<=%s\n' \
		"$HARNESS_MAX_LUNA_COMPLEXITY_SCORE" "$HARNESS_MAX_LUNA_PREDICTED_ACTIONS" \
		"$HARNESS_MAX_LUNA_PREDICTED_P95_TOKENS" "$HARNESS_MAX_LUNA_IMPLEMENTATION_FILES" \
		"$HARNESS_MAX_LUNA_RISK_DOMAINS"
	printf '  Complexity report: harness-complexity %s\n' "$HARNESS_ENV_FILE"
	printf '  Tree: harness-decomposition-tree %s\n' "$HARNESS_ENV_FILE"
elif project_plan_exists; then
	printf '  Plan: legacy (%s items)\n' "$(project_plan_total_count)"
else
	printf '  Plan: not registered\n'
fi

printf '\nAgent routing\n'
printf '  Model policy: %s\n' "$HARNESS_MODEL_POLICY"
printf '  Escalation policy: %s\n' "$HARNESS_ESCALATION_POLICY"
printf '  Manager: %s (%s)\n' "$MANAGER_MODEL" "$MANAGER_REASONING_EFFORT"
printf '  Parallel Worker-to-Manager review cohort: %s\n' "$HARNESS_MANAGER_BATCH_SIZE"
printf '  Fresh-agent launch batch: %s per %ss project window\n' \
	"$HARNESS_AGENT_LAUNCH_BATCH_SIZE" "$HARNESS_AGENT_MIN_INTERVAL_SECONDS"
printf '  Decomposition: %s (%s)\n' "$DECOMPOSITION_MODEL" "$DECOMPOSITION_REASONING_EFFORT"
printf '  Luna worker: %s (%s)\n' "$LUNA_WORKER_MODEL" "$LUNA_WORKER_REASONING_EFFORT"
if [[ "$HARNESS_MODEL_POLICY" == luna_only ]]; then
	printf '  Terra worker: disabled\n'
else
	printf '  Terra worker: %s (%s)\n' "$TERRA_WORKER_MODEL" "$TERRA_WORKER_REASONING_EFFORT"
fi
if oracle_enabled; then
	printf '  Oracle: %s (%s)\n' "$ORACLE_MODEL" "$ORACLE_REASONING_EFFORT"
else
	printf '  Oracle: disabled\n'
fi

printf '\nArchitecture\n'
if (( HARNESS_ARCHITECTURE_GUARDS == 1 )); then
	if architecture_registered; then
		printf '  Profile: %s\n' "$(architecture_profile)"
		printf '  Open critical / expired debt: %s / %s\n' \
			"$(architecture_open_critical_debt_count)" "$(architecture_expired_debt_count)"
		printf '  Missing health gates: %s\n' "$(architecture_missing_health_gate_count)"
	else
		printf '  Registry: pending\n'
	fi
else
	printf '  Guards: disabled\n'
fi

printf '\nRepository intelligence\n'
printf '  Index / Context Closure mode: %s / %s\n' "$HARNESS_REPOSITORY_INDEX_MODE" "$HARNESS_CONTEXT_CLOSURE_MODE"
printf '  Worktree overlay mode: %s\n' "$HARNESS_REPOSITORY_OVERLAY_MODE"
if [[ "$HARNESS_REPOSITORY_INDEX_MODE" != off ]]; then
	index_summary="$($HARNESS_BIN/harness-index-status "$HARNESS_ENV_FILE" 2>/dev/null || true)"
	printf '  Index status: %s (%s)\n' \
		"$(awk -F '\t' '$1=="status" {print $2}' <<< "$index_summary")" \
		"$(awk -F '\t' '$1=="reason" {print $2}' <<< "$index_summary")"
	printf '  Index details: harness-index-status %s --details\n' "$HARNESS_ENV_FILE"
	printf '  Architecture maps: harness-architecture-index %s\n' "$HARNESS_ENV_FILE"
	printf '  Closure promotion: harness-context-closure-promotion %s\n' "$HARNESS_ENV_FILE"
else
	printf '  Repository intelligence: disabled\n'
fi
