#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
require_manager_codex
(( HARNESS_DECOMPOSITION_V2 == 1 )) || die 'architecture-fit critic requires HARNESS_DECOMPOSITION_V2=1'
project_plan_exists && exit 0
architecture_fit_is_accepted && { printf 'Architecture fit already accepted.\n'; exit 0; }
architecture_redesign_requires_action && { printf 'Architecture redesign required: %s\n' "$(architecture_redesign_report_relative_path)"; exit 6; }
specification_review_is_accepted || die 'architecture-fit review requires an accepted current specification review'

dir="$(project_dir)"
prompt="$dir/control/manager-architecture-fit-critic.prompt.md"
last_message="$dir/logs/manager-architecture-fit-critic-last-message.md"
specification_review_report="$REPOSITORY/$(specification_review_state_value report)"
repository_facts_file="$REPOSITORY/$(specification_review_state_value facts)"
specification_obligations_file_path="$(specification_obligations_file)"
specification_relations_file_path="$(specification_relations_file)"
repository_architecture_slice="$dir/control/repository-architecture-slice.md"
[[ -s "$repository_architecture_slice" ]] || repository_architecture_slice=""
architecture_fit_capsule="$dir/control/manager-architecture-fit.context.md"
architecture_slice_args=()
[[ -z "$repository_architecture_slice" ]] || architecture_slice_args=(--architecture-slice "$repository_architecture_slice")
python3 "$HARNESS_HOME/tools/build_architecture_fit_capsule.py" \
	--project "$PROJECT" \
	--specification-sha256 "$(specification_sha256)" \
	--repository-baseline "$(specification_review_repository_baseline)" \
	--domain-profiles-sha256 "$(domain_profiles_sha256)" \
	--repository "$REPOSITORY" \
	--review-report "$specification_review_report" \
	--facts "$repository_facts_file" \
	--obligations "$specification_obligations_file_path" \
	--relations "$specification_relations_file_path" \
	"${architecture_slice_args[@]}" \
	--max-bytes "$HARNESS_ARCHITECTURE_FIT_CAPSULE_MAX_BYTES" \
	--output "$architecture_fit_capsule.tmp.$$"
chmod 600 "$architecture_fit_capsule.tmp.$$"
mv "$architecture_fit_capsule.tmp.$$" "$architecture_fit_capsule"
architecture_fit_capsule_sha="$(sha256sum "$architecture_fit_capsule" | awk '{print $1}')"
critic_implementation_sha="$({
	sha256sum "$0" "$HARNESS_HOME/tools/build_architecture_fit_capsule.py" "$HARNESS_BIN/codex-exec-jsonl"
	printf 'read_lines=%s\nread_bytes=%s\ncommand_bytes=%s\n' \
		"$HARNESS_VALIDATION_OUTPUT_MAX_LINES" "$HARNESS_VALIDATION_OUTPUT_MAX_BYTES" \
		"$HARNESS_MAX_AGENT_COMMAND_OUTPUT_BYTES"
} | sha256sum | awk '{print $1}')"
recovery_marker="$dir/control/startup-recoverable.env"
if [[ -f "$recovery_marker" ]] &&
	[[ "$(kv_file_value "$recovery_marker" state)" == RECOVERABLE ]] &&
	[[ "$(kv_file_value "$recovery_marker" stage)" == architecture_fit ]] &&
	[[ "$(kv_file_value "$recovery_marker" specification_sha256)" == "$(specification_sha256)" ]] &&
	[[ "$(kv_file_value "$recovery_marker" repository_baseline)" == "$(specification_review_repository_baseline)" ]] &&
	[[ "$(kv_file_value "$recovery_marker" domain_profiles_sha256)" == "$(domain_profiles_sha256)" ]] &&
	[[ "$(kv_file_value "$recovery_marker" input_sha256)" == "$architecture_fit_capsule_sha" ]] &&
	[[ "$(kv_file_value "$recovery_marker" harness_implementation_sha256)" == "$critic_implementation_sha" ]]; then
	printf 'Architecture-fit startup remains recoverable; refusing to replay the unchanged failed input. Fix or update the harness, then restart: %s\n' "$recovery_marker" >&2
	exit 7
elif [[ -f "$recovery_marker" ]]; then
	resolved_marker="$dir/logs/startup-recovery-resumed-$(timestamp_compact_utc)-$$.env"
	mv "$recovery_marker" "$resolved_marker"
	log_event "STARTUP_RECOVERY_RESUMED stage=architecture_fit prior=$resolved_marker resume_from=accepted_specification_review input=$architecture_fit_capsule"
fi
{
cat <<PROMPT
You are the independent Sol architecture-fit critic for a filesystem-backed coding harness. Do not edit repository source and do not build a decomposition DAG in this turn.

ENV_FILE=$HARNESS_ENV_FILE
HARNESS_BIN=$HARNESS_BIN
PROJECT=$PROJECT
REPOSITORY=$REPOSITORY
SPECIFICATION_SHA256=$(specification_sha256)
REPOSITORY_BASELINE=$(specification_review_repository_baseline)
DOMAIN_PROFILES_SHA256=$(domain_profiles_sha256)
ARCHITECTURE_FIT_CAPSULE_FILE=$architecture_fit_capsule
ARCHITECTURE_FIT_CAPSULE_SHA256=$architecture_fit_capsule_sha
PROJECT_TMP_DIR=$PROJECT_TMP_DIR
AGENT_PHASE=architecture_fit
REVIEW_READ_MAX_LINES=$HARNESS_VALIDATION_OUTPUT_MAX_LINES
REVIEW_READ_MAX_BYTES=$HARNESS_VALIDATION_OUTPUT_MAX_BYTES

This turn has exactly four outcomes. Reason first and primarily from the deterministic capsule embedded below. It is the complete architecture-fit evidence surface compiled from accepted normalized IR, accepted repository facts, exact selected source evidence, and the current indexed architecture slice. Do not open or reread ARCHITECTURE_FIT_CAPSULE_FILE through shell commands. Do not open the human specification, specification review report, facts/obligations/relations/inventory files, domain profiles, complete architecture slice, development policy, harness implementation, build output, prior logs, or unrelated history. Inferred findings can trigger targeted verification but cannot override registered or specified authority.

Only when the capsule leaves one decisive architecture fact unresolved may you inspect repository source. Inspect exactly one source file and one exact source window in that shell action, and only at a repository path already named by the capsule. Every shell read has one content source only and must end with both `head -n $HARNESS_VALIDATION_OUTPUT_MAX_LINES` and `head -c $HARNESS_VALIDATION_OUTPUT_MAX_BYTES`; those are literal numeric arguments for this turn. Never use cat for source or document inspection. Never use unbounded sed, awk, rg, grep, find, git diff, compiler output, or test output. Never concatenate, loop over, or combine multiple source/document reads in one action, even when each inner read is individually capped. Every complete shell action has one aggregate hard transcript budget of REVIEW_READ_MAX_LINES lines and REVIEW_READ_MAX_BYTES bytes across stdout and stderr. Retain necessary verbose output under PROJECT_TMP_DIR and return only one bounded excerpt. If one bounded source excerpt cannot settle the decisive question, report only the evidence gap supported by the accepted authority; do not explore the repository interactively.

1. Demonstrated governing-source contradiction, observable ambiguity, missing acceptance authority, unavailable external authority, or unreachable mandatory acceptance witness: write a minimal specification challenge and call manager-challenge-specification-review. Do not manufacture a product question from discoverable repository facts.

2. Clear governing sources but a demonstrable omission, distortion, or false relation in the normalized IR: write a renormalization reason beginning with # Specification Renormalization Request and call manager-request-specification-renormalization. Use this only when preserving all governing statements can produce valid acyclic IR.

3. The accepted specification necessarily violates a foundational ownership, transaction, migration, dependency-direction, contract-authority, observability, critical-invariant, or resource-lifetime boundary on this baseline, and the feature authority does not permit the structural repair: write ARCHITECTURE_REPORT beginning with # Architecture Redesign Required and exact Project, Specification-SHA256, Repository-Baseline, and Decision: ARCHITECTURE_REDESIGN_REQUIRED lines. Write ARCHITECTURE_ISSUES with this exact TSV header:

issue_id<TAB>class<TAB>requirement_ids<TAB>source_locations<TAB>architecture_evidence<TAB>violated_boundary<TAB>why_no_bounded_dag<TAB>required_capability<TAB>acceptance_evidence<TAB>severity

Use stable ARCH-... IDs, CRITICAL severity, normalized requirement IDs, and one of OWNERSHIP_MODEL_INCOMPATIBLE, TRANSACTION_MODEL_INSUFFICIENT, MIGRATION_PATH_ABSENT, DEPENDENCY_DIRECTION_CONFLICT, FOUNDATIONAL_CONTRACT_OUT_OF_SCOPE, OBSERVABILITY_SEAM_ABSENT, CRITICAL_INVARIANT_CONFLICT, or RESOURCE_MODEL_INSUFFICIENT. Write REDESIGN_SPECIFICATION beginning with # Architecture Redesign Specification and trace every issue. Then call manager-record-architecture-redesign with those three files and terminate. This requires repository-relative path:line evidence proving that no authority-closed feature DAG can satisfy the obligations. Do not bounce ordinary missing implementation, local refactoring, stale hints, documentation, code ugliness, or architecture changes explicitly authorized by the feature.

4. Architecture fit is acceptable: write REPORT beginning exactly with # Architecture Fit Review and containing these exact metadata lines:

Project: $PROJECT
Specification-SHA256: $(specification_sha256)
Repository-Baseline: $(specification_review_repository_baseline)
Domain-Profiles-SHA256: $(domain_profiles_sha256)
Decision: ACCEPT

Include an Evidence: section naming the inspected ownership, transaction, dependency, migration, observability, invariant, and resource-lifetime boundaries, plus any authorized Terra architecture decisions the future DAG must contain. Then call:

$HARNESS_BIN/manager-record-architecture-fit "$HARNESS_ENV_FILE" REPORT

Terminate immediately after the command succeeds. Do not create DAG, coverage, or architecture-registry files in this turn. Do not inspect harness source to second-guess the command contract.
PROMPT
printf '\n## Embedded deterministic architecture-fit capsule\n\n'
cat "$architecture_fit_capsule"
} > "$prompt.tmp.$$"
chmod 600 "$prompt.tmp.$$"
mv "$prompt.tmp.$$" "$prompt"
accepted_review_snapshot="$PROJECT_TMP_DIR/$PROJECT-architecture-fit-accepted-review.env"
install -m 600 "$(specification_review_state_file)" "$accepted_review_snapshot"

attempt=1
while true; do
	stamp="$(timestamp_compact_utc)"
	json="$dir/logs/manager-architecture-fit-critic-$stamp-attempt-$(printf '%03d' "$attempt").jsonl"
	stderr="$dir/logs/manager-architecture-fit-critic-$stamp-attempt-$(printf '%03d' "$attempt").stderr.log"
	message="$dir/logs/manager-architecture-fit-critic-$stamp-attempt-$(printf '%03d' "$attempt").md"
	set +e
	"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" decomposition "$DECOMPOSITION_MODEL" "$prompt" "$json" "$stderr" "$message"
	status=$?
	set -e
	classification="$(kv_file_value "${json%.jsonl}.classification" classification 2>/dev/null || true)"
	if [[ "$classification" == agent_command_output_budget_exceeded ]]; then
		classification_file="${json%.jsonl}.classification"
		# The resource guard makes every state transition from this turn
		# untrusted. Restore the accepted review checkpoint before recording the
		# recoverable pause; any generated reports remain as unauthoritative audit
		# evidence in the repository.
		install -m 600 "$accepted_review_snapshot" "$(specification_review_state_file).tmp.$$"
		mv "$(specification_review_state_file).tmp.$$" "$(specification_review_state_file)"
		if architecture_fit_is_accepted; then
			mv "$(architecture_fit_state_file)" "$dir/logs/untrusted-architecture-fit-state-$(timestamp_compact_utc)-$$.env"
		fi
		if architecture_redesign_requires_action; then
			mv "$(architecture_redesign_state_file)" "$dir/logs/untrusted-architecture-redesign-state-$(timestamp_compact_utc)-$$.env"
		fi
		{
			printf 'state=RECOVERABLE\n'
			printf 'stage=architecture_fit\n'
			printf 'resume_from=accepted_specification_review\n'
			printf 'classification=%s\n' "$classification"
			printf 'offending_input=%s\n' "$architecture_fit_capsule"
			printf 'input_sha256=%s\n' "$architecture_fit_capsule_sha"
			printf 'prompt=%s\n' "$prompt"
			printf 'prompt_sha256=%s\n' "$(sha256sum "$prompt" | awk '{print $1}')"
			printf 'classification_file=%s\n' "$classification_file"
			printf 'jsonl=%s\n' "$json"
			printf 'specification_review_report=%s\n' "$(specification_review_report_relative_path)"
			printf 'specification_sha256=%s\n' "$(specification_sha256)"
			printf 'repository_baseline=%s\n' "$(specification_review_repository_baseline)"
			printf 'domain_profiles_sha256=%s\n' "$(domain_profiles_sha256)"
			printf 'harness_implementation_sha256=%s\n' "$critic_implementation_sha"
			printf 'recorded_at=%s\n' "$(timestamp_utc)"
		} > "$recovery_marker.tmp.$$"
		chmod 600 "$recovery_marker.tmp.$$"
		mv "$recovery_marker.tmp.$$" "$recovery_marker"
		log_event "STARTUP_RECOVERABLE stage=architecture_fit classification=$classification input=$architecture_fit_capsule input_sha256=$architecture_fit_capsule_sha classification_file=$classification_file resume_from=accepted_specification_review"
		printf 'Architecture-fit startup paused recoverably after a command-output limit hit; accepted specification review is preserved: %s\n' "$recovery_marker" >&2
		exit 7
	fi
	if architecture_fit_is_accepted; then
		cp -f "$message" "$last_message" 2>/dev/null || true
		printf 'Architecture fit accepted: %s\n' "$(architecture_fit_state_value report force-waiver)"
		exit 0
	fi
	if specification_review_requires_clarification; then exit 3; fi
	if architecture_redesign_requires_action; then exit 6; fi
	if specification_renormalization_stall_matches_current_inputs; then exit 5; fi
	if ! specification_review_is_accepted; then exit 4; fi
	retry_kind="$(codex_provider_retry_kind "$classification" 2>/dev/null || true)"
	if [[ -n "$retry_kind" ]]; then
		delay="$(codex_provider_retry_delay "$classification")"
		printf 'Architecture-fit provider retry in %s seconds (%s).\n' "$delay" "$retry_kind" >&2
		sleep "$delay"
		attempt=$((attempt + 1))
		continue
	fi
	(( status == 0 )) && die 'architecture-fit critic exited without recording a decision'
	die "architecture-fit critic failed with status $status; see $json"
done
