#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || die "Usage: ${0##*/} ENV_FILE"
load_harness_env "$1"
ensure_project
dir="$(project_dir)"

printf 'Environment file: %s\n' "$HARNESS_ENV_FILE"
printf 'Project: %s\n' "$PROJECT"
printf 'Repository: %s\n' "$REPOSITORY"
launch_commit="$(project_config_value repository_launch_commit 2>/dev/null || true)"
current_commit="$(repository_head_commit 2>/dev/null || true)"
[[ -z "$launch_commit" ]] || printf 'Repository launch commit: %s\n' "$launch_commit"
[[ -z "$current_commit" ]] || printf 'Canonical repository baseline: %s\n' "$current_commit"
printf 'Harness mode: persistent Luna worker, sparse Terra reviews, final Sol Oracle\n'
if supervisor_running; then
	printf 'Supervisor: running (PID %s)\n' "$(supervisor_pid)"
else
	printf 'Supervisor: stopped\n'
fi
if [[ -f "$(supervisor_unit_file)" ]]; then
	printf 'Process containment: systemd user cgroup (%s)\n' \
		"$(awk 'NR == 1 { print; exit }' "$(supervisor_unit_file)")"
elif [[ -f "$(process_token_file)" ]]; then
	printf 'Process containment: tagged process group fallback\n'
else
	printf 'Process containment: legacy/unstarted\n'
fi
printf 'Environment reload: before every manager review and Oracle audit (soft parameters only)\n'
printf 'Status: %s\n' "$(state_value status)"
printf 'Phase: %s\n' "$(state_value phase)"
printf 'Worker/review cycle: %s\n' "$(state_value cycle)"
printf 'Manager: %s (%s)\n' "$MANAGER_MODEL" "$MANAGER_REASONING_EFFORT"
printf 'Worker: %s (%s)\n' "$WORKER_MODEL" "$WORKER_REASONING_EFFORT"
if oracle_enabled; then
	printf 'Oracle: %s (%s)\n' "$ORACLE_MODEL" "$ORACLE_REASONING_EFFORT"
	printf 'Oracle audits: %s of %s\n' "$(oracle_audit_run_count)" "$MAX_ORACLE_RUNS"
else
	printf 'Oracle: disabled (MAX_ORACLE_RUNS=0)\n'
fi
printf 'Manager first-review checklist: %s\n' \
	"$HARNESS_MANAGER_REVIEW_CHECKLIST"
printf 'Codex goal tools: disabled by harness\n'
if (( HARNESS_MAX_MANAGER_REVIEWS == 0 )); then
	printf 'Manager review limit: unlimited\n'
else
	printf 'Manager review limit: %s\n' "$HARNESS_MAX_MANAGER_REVIEWS"
fi
printf 'Protocol repair attempts: %s\n' \
	"$HARNESS_MAX_PROTOCOL_REPAIR_ATTEMPTS"
if (( HARNESS_MAX_REPEATED_FINDING_REVIEWS == 0 )); then
	printf 'Repeated-finding convergence audit: disabled\n'
else
	printf 'Repeated-finding convergence audit: after %s consecutive reviews\n' \
		"$HARNESS_MAX_REPEATED_FINDING_REVIEWS"
fi
if (( HARNESS_MAX_NO_SOURCE_PROGRESS_REVIEWS == 0 )); then
	printf 'No-source-progress pause: disabled\n'
else
	printf 'No-source-progress pause: after %s unchanged worker deliveries (current %s)\n' \
		"$HARNESS_MAX_NO_SOURCE_PROGRESS_REVIEWS" "$(no_source_progress_count)"
fi
if (( HARNESS_MAX_REPEATED_CONVERGENCE_AUDITS == 0 )); then
	printf 'Repeated-convergence pause: disabled\n'
else
	printf 'Repeated-convergence pause: after %s audits retain a finding\n' \
		"$HARNESS_MAX_REPEATED_CONVERGENCE_AUDITS"
fi
printf 'Codex diagnostic profile: %s\n' \
	"$([[ "$HARNESS_CODEX_DIAGNOSTIC_PROFILE" == 1 ]] && printf enabled || printf disabled)"
printf 'Codex Rust diagnostics: %s\n' \
	"${HARNESS_CODEX_RUST_LOG:-disabled}"
printf 'Codex strace: %s\n' \
	"$([[ "$HARNESS_CODEX_STRACE" == 1 ]] && printf enabled || printf disabled)"
if (( HARNESS_CODEX_STALL_DIAGNOSTIC_SECONDS == 0 )); then
	printf 'Codex stall snapshots: disabled\n'
else
	printf 'Codex stall snapshots: after %s seconds without output' \
		"$HARNESS_CODEX_STALL_DIAGNOSTIC_SECONDS"
	if (( HARNESS_CODEX_STALL_DIAGNOSTIC_REPEAT_SECONDS > 0 )); then
		printf ', repeated every %s seconds\n' \
			"$HARNESS_CODEX_STALL_DIAGNOSTIC_REPEAT_SECONDS"
	else
		printf ', one snapshot per quiet interval\n'
	fi
fi
latest_warning="$(find "$dir/logs" -maxdepth 1 -type f -name '*.warning.env' \
	-printf '%T@\t%p\n' 2>/dev/null | sort -nr | \
	awk -F '\t' 'NR == 1 { print substr($0, index($0, $2)); exit }')"
if [[ -n "$latest_warning" ]]; then
	warning_classification="$(awk -F= '$1 == "classification" { print substr($0, length($1) + 2); exit }' "$latest_warning")"
	warning_severity="$(awk -F= '$1 == "severity" { print substr($0, length($1) + 2); exit }' "$latest_warning")"
	warning_detail="$(awk -F= '$1 == "detail" { print substr($0, length($1) + 2); exit }' "$latest_warning")"
	warning_snapshot="$(awk -F= '$1 == "snapshot" { print substr($0, length($1) + 2); exit }' "$latest_warning")"
	printf 'Codex warning: %s (%s)\n' "$warning_classification" "$warning_severity"
	printf 'Warning detail: %s\n' "$warning_detail"
	printf 'Warning evidence: %s\n' "$warning_snapshot"
fi
if [[ -f "$dir/control/worker.thread" ]]; then
	printf 'Persistent worker thread: %s\n' "$(awk 'NR == 1 { print; exit }' "$dir/control/worker.thread")"
else
	printf 'Persistent worker thread: not started\n'
fi
worker_context_reset_count="$(find "$dir/reviews" -maxdepth 1 -type d \
	-name 'worker-context-reset-[0-9][0-9][0-9]*' | wc -l | tr -d ' ')"
printf 'Worker context resets: %s\n' "$worker_context_reset_count"
if [[ -f "$dir/control/worker-context-reset.env" ]]; then
	reset_id="$(awk -F= '$1 == "reset_id" { print $2; exit }' \
		"$dir/control/worker-context-reset.env")"
	reset_resume="$(awk -F= '$1 == "resume_phase" { print $2; exit }' \
		"$dir/control/worker-context-reset.env")"
	printf 'Worker context reset pending: %s (resume at %s)\n' \
		"$reset_id" "$reset_resume"
fi
printf 'Completion addenda: %s\n' \
	"$(find "$dir/addenda" -maxdepth 1 -name 'addendum-*.md' -type f | wc -l | tr -d ' ')"

manager_input="$(usage_sum_by_thread "$dir/logs" 'manager-*.jsonl' input_tokens)"
manager_cached="$(usage_sum_by_thread "$dir/logs" 'manager-*.jsonl' cached_input_tokens)"
manager_output="$(usage_sum_by_thread "$dir/logs" 'manager-*.jsonl' output_tokens)"
worker_input="$(usage_sum_by_thread "$dir/logs" 'worker-*.jsonl' input_tokens)"
worker_cached="$(usage_sum_by_thread "$dir/logs" 'worker-*.jsonl' cached_input_tokens)"
worker_output="$(usage_sum_by_thread "$dir/logs" 'worker-*.jsonl' output_tokens)"
oracle_input="$(usage_sum_by_thread "$dir/logs" 'oracle-*.jsonl' input_tokens)"
oracle_cached="$(usage_sum_by_thread "$dir/logs" 'oracle-*.jsonl' cached_input_tokens)"
oracle_output="$(usage_sum_by_thread "$dir/logs" 'oracle-*.jsonl' output_tokens)"
printf 'Manager tokens: input=%s cached=%s output=%s\n' \
	"$manager_input" "$manager_cached" "$manager_output"
printf 'Worker tokens: input=%s cached=%s output=%s\n' \
	"$worker_input" "$worker_cached" "$worker_output"
printf 'Oracle tokens: input=%s cached=%s output=%s\n' \
	"$oracle_input" "$oracle_cached" "$oracle_output"

if [[ -f "$dir/control/last-error.txt" ]]; then
	printf 'Last error: %s\n' "$(head -n 1 "$dir/control/last-error.txt")"
fi
if [[ -f "$dir/control/operator-required.md" ]]; then
	printf 'Operator report: %s\n' "$dir/control/operator-required.md"
fi
printf 'Latest events:\n'
tail -n 8 "$(events_file)" 2>/dev/null || true
