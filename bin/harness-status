#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-mode.sh"
harness_dispatch_mode "$SCRIPT_DIR/.." "${0##*/}" "$@"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s [--full|--machine] ENV_FILE\n' "${0##*/}" >&2
	exit 2
}

status_detail=0
case "${1:-}" in
	--full|--machine) status_detail=1; shift ;;
	--help|-h) usage ;;
esac
[[ $# -eq 1 ]] || usage

# Keep the default operational view deliberately small. The detailed renderer
# remains the compatibility interface for machine consumers and investigations.
# Running it in a child also keeps one authoritative status-state calculation.
if (( status_detail == 0 )); then
	"$SCRIPT_DIR/harness-status" --machine "$1" | awk '
		/^Project: / ||
		/^Harness mode: / ||
		/^Manager supervisor: / ||
		/^Worker supervisor: / ||
		/^Specification review: / ||
		/^Specification IR: / ||
		/^Specification coverage: / ||
		/^Architecture fit: / ||
		/^Startup transaction: / ||
		/^Architecture health: / ||
		/^Oracle audit: / ||
		/^Active root evidence: / ||
		/^Active root progress: / ||
		/^Root liveness/ ||
		/^Convergence efficiency: / ||
		/^Irregularities: / ||
		/^First unmet leaf criterion: / ||
		/^Active worker goal: / ||
		/^Goal task \/ target: / ||
		/^Latest worker\/provider classification: / ||
		/^Project progress: / ||
		/^Project status: / {print}
	'
	exit
fi

load_harness_env "$1"
ensure_project

dir="$(project_dir)"
oracle_invocation_failure="$(project_oracle_dir)/oracle-invocation-failed.md"
oracle_limit_marker="$(project_oracle_limit_file)"
manager_plan_structural_error="$dir/control/manager-plan-structural-error.md"
manager_plan_stalled="$dir/control/manager-plan-stalled.md"
manager_plan_failed="$dir/control/manager-plan-failed.md"
manager_review_stalled=""
while IFS= read -r review_stall_candidate; do
	[[ -n "$review_stall_candidate" ]] || continue
	review_stall_task="$(task_id_from_filename "${review_stall_candidate%.manager-review-stalled.md}.result.md")"
	review_stall_base="$(task_base "$review_stall_task")"
	[[ -f "$dir/results/$review_stall_base.result.md" ]] || continue
	review_stall_root="$(task_root_id "$review_stall_task")"
	review_stall_item="$(project_plan_item_for_root "$review_stall_root")"
	if [[ -n "$review_stall_item" && "$(project_plan_item_status "$review_stall_item")" == COMPLETE ]] &&
		root_has_accepted_task "$review_stall_root"; then
		continue
	fi
	manager_review_stalled="$review_stall_candidate"
	break
done < <(find "$dir/control" -maxdepth 1 -type f -name "$PROJECT-task-*.manager-review-stalled.md" -print 2>/dev/null | sort)
specification_review_status='DISABLED'
specification_review_report=''
specification_normalization_stall_report=''
if (( HARNESS_SPECIFICATION_REVIEW_ENABLED == 1 )); then
	if specification_renormalization_stall_matches_current_inputs; then
		specification_review_status='NORMALIZATION_STALLED'
		specification_normalization_stall_report="$(kv_file_value "$(specification_renormalization_stall_file)" report)"
	elif specification_review_is_accepted; then
		specification_review_status='ACCEPTED'
		specification_review_report="$(specification_review_report_relative_path)"
	elif specification_review_matches_current_inputs; then
		specification_review_status="$(specification_review_state_value status UNKNOWN)"
		specification_review_report="$(specification_review_report_relative_path)"
	else
		specification_review_status='PENDING'
	fi
fi
architecture_fit_status='DISABLED'
architecture_fit_report=''
if (( HARNESS_DECOMPOSITION_V2 == 1 && HARNESS_DECOMPOSITION_CRITIC_ENABLED == 1 )); then
	if project_plan_exists; then
		architecture_fit_status='ACCEPTED'
	elif architecture_fit_is_accepted; then
		architecture_fit_status='ACCEPTED'
		architecture_fit_report="$(architecture_fit_state_value report force-waiver)"
	elif architecture_redesign_matches_current_inputs &&
		[[ "$(architecture_redesign_state_value status)" == ARCHITECTURE_REDESIGN_REQUIRED ]]; then
		architecture_fit_report="$(architecture_redesign_report_relative_path)"
		if architecture_redesign_force_matches_current_inputs; then
			architecture_fit_status='FORCE_DECOMPOSITION_AUTHORIZED'
		else
			architecture_fit_status='ARCHITECTURE_REDESIGN_REQUIRED'
		fi
	else
		architecture_fit_status='PENDING'
	fi
fi
startup_status_file="$dir/control/harness-start-background.status"
startup_state='IDLE'
startup_exit=''
startup_log=''
startup_recovery_file="$dir/control/startup-recoverable.env"
startup_recovery_stage=''
startup_recovery_classification=''
startup_recovery_input=''
manager_replan_failed=''
if [[ -f "$startup_status_file" ]]; then
	startup_state="$(awk -F= '$1=="state" {print $2; exit}' "$startup_status_file")"
	[[ -n "$startup_state" ]] || startup_state=IDLE
	startup_exit="$(awk -F= '$1=="exit_status" {print $2; exit}' "$startup_status_file")"
	startup_log="$(awk -F= '$1=="log" {sub(/^[^=]*=/, ""); print; exit}' "$startup_status_file")"
fi
if [[ -f "$startup_recovery_file" ]] && [[ "$(kv_file_value "$startup_recovery_file" state)" == RECOVERABLE ]]; then
	startup_state=RECOVERABLE
	startup_recovery_stage="$(kv_file_value "$startup_recovery_file" stage unknown)"
	startup_recovery_classification="$(kv_file_value "$startup_recovery_file" classification unknown)"
	startup_recovery_input="$(kv_file_value "$startup_recovery_file" offending_input unknown)"
fi
manager_replan_failed="$(find "$dir/control" -maxdepth 1 -type f \
	-name "$PROJECT-task-*.manager-replan-failed.md" -print 2>/dev/null | sort | head -n 1)"
if project_plan_exists; then
	printf -v project_progress_line 'Project progress: %s%% (%s/%s plan items complete)' \
		"$(project_plan_progress_percent_decimal)" "$(project_plan_complete_count)" "$(project_plan_total_count)"
else
	project_progress_line='Project progress: unavailable (project plan is missing)'
fi
project_status_line='Project status: UNKNOWN. Status collection did not complete.'
project_footer_printed=0
print_project_footer()
{
	(( project_footer_printed == 0 )) || return 0
	printf '\n%s\n%s\n' "$project_progress_line" "$project_status_line"
	project_footer_printed=1
}
# Status diagnostics are best-effort. Keep the project-level progress and
# status summary visible even if an in-flight state file is between atomic
# metadata updates.
trap print_project_footer EXIT

status_kv_value()
{
	local file="$1" key="$2" fallback="${3:-}" value=""
	if [[ -f "$file" ]]; then
		value="$(awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$file")"
	fi
	[[ -n "$value" ]] || value="$fallback"
	printf '%s' "$value"
}

token_metric_value()
{
	local report="$1" metric="$2"
	awk -F '\t' -v metric="$metric" '$1 == metric {print $2; exit}' <<< "$report"
}

processed_token_ratio()
{
	local left="$1" right="$2"
	if (( left == 0 && right == 0 )); then
		printf 'N/A'
	elif (( right == 0 )); then
		printf 'infinite'
	else
		awk -v left="$left" -v right="$right" 'BEGIN {printf "%.2f:1", left / right}'
	fi
}

higher_token_consumer()
{
	local left_name="$1" left="$2" right_name="$3" right="$4"
	if (( left > right )); then printf '%s' "$left_name"
	elif (( right > left )); then printf '%s' "$right_name"
	else printf 'equal'
	fi
}

printf 'Environment file: %s\n' "$HARNESS_ENV_FILE"
printf 'Project: %s\n' "$PROJECT"
printf 'Harness mode: %s\n' "$HARNESS_MODE"
printf 'Repository: %s\n' "$REPOSITORY"
printf 'Harness root: %s\n' "$HARNESS_ROOT"
manager_supervisor='stopped'
worker_supervisor='stopped'
if [[ -f "$dir/control/supervisor.pid" ]]; then
	pid="$(cat "$dir/control/supervisor.pid")"
	if kill -0 "$pid" 2>/dev/null; then manager_supervisor="running (PID $pid)"; fi
fi
if [[ -f "$dir/control/worker-supervisor.pid" ]]; then
	pid="$(cat "$dir/control/worker-supervisor.pid")"
	if kill -0 "$pid" 2>/dev/null; then worker_supervisor="running (PID $pid)"; fi
fi
printf 'Manager supervisor: %s\n' "$manager_supervisor"
printf 'Worker supervisor: %s\n' "$worker_supervisor"
printf 'Worker leaf-goal mode: %s\n' "$([[ "$HARNESS_WORKER_GOAL_MODE" == 1 ]] && printf enabled || printf disabled)"
if (( HARNESS_SPECIFICATION_REVIEW_ENABLED == 1 )); then
	if [[ -n "$specification_review_report" ]]; then
		printf 'Specification review: %s (%s)\n' "$specification_review_status" "$specification_review_report"
	else
		printf 'Specification review: %s\n' "$specification_review_status"
	fi
else
	printf 'Specification review: disabled\n'
fi
if specification_ir_available; then
	printf 'Specification IR: obligations=%s relations=%s domain-profiles=%s\n' \
		"$(specification_obligation_count)" "$(specification_review_state_value relation_count 0)" "${HARNESS_DOMAIN_PROFILES:-none}"
	printf 'Specification coverage: mapped=%s/%s verified=%s/%s\n' \
		"$(specification_coverage_mapped_count)" "$(specification_obligation_count)" \
		"$(specification_coverage_verified_count)" "$(specification_obligation_count)"
elif specification_ir_registered; then
	printf 'Specification IR: INVALID (authority, history, or installed artifacts no longer match)\n'
fi
if [[ -n "$architecture_fit_report" ]]; then
	printf 'Architecture fit: %s (%s)\n' "$architecture_fit_status" "$architecture_fit_report"
else
	printf 'Architecture fit: %s\n' "$architecture_fit_status"
fi
if [[ "$startup_state" == RECOVERABLE ]] && project_plan_exists; then
	printf 'Startup transaction: RECOVERED (historical recoverable stage=%s classification=%s log=%s)\n' \
		"${startup_recovery_stage:-unknown}" "${startup_recovery_classification:-unknown}" "${startup_log:-unknown}"
elif [[ "$startup_state" == FAILED ]] && project_plan_exists; then
	printf 'Startup transaction: RECOVERED (historical failure exit=%s log=%s)\n' "${startup_exit:-unknown}" "${startup_log:-unknown}"
elif [[ "$startup_state" == RECOVERABLE ]]; then
	printf 'Startup transaction: RECOVERABLE stage=%s classification=%s input=%s log=%s\n' \
		"${startup_recovery_stage:-unknown}" "${startup_recovery_classification:-unknown}" \
		"${startup_recovery_input:-unknown}" "${startup_log:-unknown}"
elif [[ "$startup_state" == FAILED ]]; then
	printf 'Startup transaction: FAILED exit=%s log=%s\n' "${startup_exit:-unknown}" "${startup_log:-unknown}"
elif [[ "$startup_state" == RUNNING ]]; then
	printf 'Startup transaction: RUNNING log=%s\n' "${startup_log:-unknown}"
else
	printf 'Startup transaction: %s\n' "$startup_state"
fi
if (( HARNESS_ARCHITECTURE_GUARDS == 1 )); then
	if architecture_registered; then
		printf 'Architecture guards: enabled (%s)\n' "$(architecture_dir)"
		printf 'Architecture profile: %s\n' "$(architecture_profile)"
		printf 'Architecture health: critical-debt=%s expired-debt=%s missing-gates=%s\n' \
			"$(architecture_open_critical_debt_count)" "$(architecture_expired_debt_count)" "$(architecture_missing_health_gate_count)"
	elif ! project_plan_exists; then
		printf 'Architecture guards: pending specification acceptance and DAG registration\n'
	else
		architecture_require_registered
	fi
else
	printf 'Architecture guards: disabled\n'
fi
if oracle_enabled; then
	if [[ -f "$(project_block_file)" ]]; then
		printf 'Oracle audit: BLOCKED (%s)\n' "$(project_block_file)"
	elif [[ -f "$oracle_limit_marker" ]]; then
		printf 'Oracle audit: RUN_LIMIT_REACHED (%s)\n' "$oracle_limit_marker"
	elif [[ -f "$oracle_invocation_failure" ]]; then
		printf 'Oracle audit: INVOCATION_FAILED (%s)\n' "$oracle_invocation_failure"
	elif [[ -f "$(project_oracle_pending_file)" ]]; then
		printf 'Oracle audit: PENDING\n'
	elif [[ -n "$MAX_ORACLE_RUNS" ]]; then
		printf 'Oracle audit: enabled (maximum runs: %s)\n' "$MAX_ORACLE_RUNS"
	else
		printf 'Oracle audit: enabled\n'
	fi
elif [[ "$MAX_ORACLE_RUNS" == 0 ]]; then
	printf 'Oracle audit: disabled (MAX_ORACLE_RUNS=0)\n'
fi

token_report="$("$HARNESS_BIN/harness-agent-token-usage" "$HARNESS_ENV_FILE")"
manager_token_input="$(token_metric_value "$token_report" manager_input_tokens)"
manager_token_cached="$(token_metric_value "$token_report" manager_cached_tokens)"
manager_token_output="$(token_metric_value "$token_report" manager_output_tokens)"
decomposition_token_input="$(token_metric_value "$token_report" decomposition_input_tokens)"
decomposition_token_cached="$(token_metric_value "$token_report" decomposition_cached_tokens)"
decomposition_token_output="$(token_metric_value "$token_report" decomposition_output_tokens)"
luna_worker_token_input="$(token_metric_value "$token_report" worker_luna_input_tokens)"
luna_worker_token_cached="$(token_metric_value "$token_report" worker_luna_cached_tokens)"
luna_worker_token_output="$(token_metric_value "$token_report" worker_luna_output_tokens)"
terra_worker_token_input="$(token_metric_value "$token_report" worker_terra_input_tokens)"
terra_worker_token_cached="$(token_metric_value "$token_report" worker_terra_cached_tokens)"
terra_worker_token_output="$(token_metric_value "$token_report" worker_terra_output_tokens)"
unknown_worker_token_input="$(token_metric_value "$token_report" worker_unknown_input_tokens)"
unknown_worker_token_cached="$(token_metric_value "$token_report" worker_unknown_cached_tokens)"
unknown_worker_token_output="$(token_metric_value "$token_report" worker_unknown_output_tokens)"
oracle_token_input="$(token_metric_value "$token_report" oracle_input_tokens)"
oracle_token_cached="$(token_metric_value "$token_report" oracle_cached_tokens)"
oracle_token_output="$(token_metric_value "$token_report" oracle_output_tokens)"
for token_variable in manager_token_input manager_token_cached manager_token_output \
	decomposition_token_input decomposition_token_cached decomposition_token_output \
	luna_worker_token_input luna_worker_token_cached luna_worker_token_output \
	terra_worker_token_input terra_worker_token_cached terra_worker_token_output \
	unknown_worker_token_input unknown_worker_token_cached unknown_worker_token_output \
	oracle_token_input oracle_token_cached oracle_token_output; do
	[[ "${!token_variable}" =~ ^[0-9]+$ ]] || printf -v "$token_variable" '%s' 0
done
manager_processed_tokens=$((manager_token_input + manager_token_output))
decomposition_processed_tokens=$((decomposition_token_input + decomposition_token_output))
worker_processed_tokens=$((luna_worker_token_input + luna_worker_token_output +
	terra_worker_token_input + terra_worker_token_output +
	unknown_worker_token_input + unknown_worker_token_output))
luna_processed_tokens=$(( $(token_metric_value "$token_report" luna_input_tokens) + $(token_metric_value "$token_report" luna_output_tokens) ))
terra_processed_tokens=$(( $(token_metric_value "$token_report" terra_input_tokens) + $(token_metric_value "$token_report" terra_output_tokens) ))
printf '\nAgent token usage (cached input is included in input):\n'
printf '  Manager [%s]: input=%s cached=%s output=%s processed=%s\n' \
	"$MANAGER_MODEL" "$manager_token_input" "$manager_token_cached" "$manager_token_output" "$manager_processed_tokens"
printf '  Decomposition [%s]: input=%s cached=%s output=%s processed=%s\n' \
	"$DECOMPOSITION_MODEL" "$decomposition_token_input" "$decomposition_token_cached" \
	"$decomposition_token_output" "$decomposition_processed_tokens"
printf '  Luna worker [%s]: input=%s cached=%s output=%s processed=%s\n' \
	"$LUNA_WORKER_MODEL" "$luna_worker_token_input" "$luna_worker_token_cached" "$luna_worker_token_output" \
	"$((luna_worker_token_input + luna_worker_token_output))"
printf '  Terra worker [%s]: input=%s cached=%s output=%s processed=%s\n' \
	"$TERRA_WORKER_MODEL" "$terra_worker_token_input" "$terra_worker_token_cached" "$terra_worker_token_output" \
	"$((terra_worker_token_input + terra_worker_token_output))"
if (( unknown_worker_token_input + unknown_worker_token_output > 0 )); then
	printf '  Unclassified legacy worker: input=%s cached=%s output=%s processed=%s\n' \
		"$unknown_worker_token_input" "$unknown_worker_token_cached" "$unknown_worker_token_output" \
		"$((unknown_worker_token_input + unknown_worker_token_output))"
fi
if (( oracle_token_input + oracle_token_output > 0 )); then
	printf '  Oracle [%s]: input=%s cached=%s output=%s processed=%s\n' \
		"$ORACLE_MODEL" "$oracle_token_input" "$oracle_token_cached" "$oracle_token_output" \
		"$((oracle_token_input + oracle_token_output))"
fi
printf '  Role ratio manager/worker: %s (higher: %s)\n' \
	"$(processed_token_ratio "$manager_processed_tokens" "$worker_processed_tokens")" \
	"$(higher_token_consumer manager "$manager_processed_tokens" worker "$worker_processed_tokens")"
printf '  Model ratio Luna/Terra: %s (higher: %s)\n' \
	"$(processed_token_ratio "$luna_processed_tokens" "$terra_processed_tokens")" \
	"$(higher_token_consumer Luna "$luna_processed_tokens" Terra "$terra_processed_tokens")"
if project_plan_exists; then
	printf '\n%-24s %-18s %-16s %s\n' 'PLAN ITEM' 'STATE' 'TASK ROOT' 'TITLE'
	printf '%-24s %-18s %-16s %s\n' '------------------------' '------------------' '----------------' '-----'
	awk -F '\t' '
		NR == FNR {if ($0 !~ /^#/ && NF >= 2) title[$1] = $2; next}
		$0 !~ /^#/ && NF >= 4 {printf "%-24s %-18s %-16s %s\n", $1, $2, $3, title[$1]}
	' "$(project_plan_definition_file)" "$(project_plan_state_file)"
fi
printf '\n'
printf '%-32s %-12s %-13s %-10s %-28s %-10s\n' 'TASK' 'STATE' 'EXECUTOR' 'PROGRESS' 'OWNER' 'AGE'
printf '%-32s %-12s %-13s %-10s %-28s %-10s\n' '--------------------------------' '------------' '-------------' '----------' '----------------------------' '----------'

shopt -s nullglob
found=0
accepted_count=0
checkpointed_count=0
active_count=0
aborted_count=0
blocked_count=0
replan_count=0
human_count=0
waiting_dependency_count=0
replanning_count=0
architecture_reassessment_count=0
token_usage_anomaly_count=0
task_resource_anomaly_count=0
manager_remediation_active_count=0
task_rows=()

task_executor()
{
	local task_id="$1" live_file="${2:-}" assignment
	assignment="$dir/archive/$(task_base "$task_id").assignment.md"
	if [[ -f "$assignment" ]] && assignment_is_manager_remediation "$assignment"; then
		printf 'MANAGER_FIX'
	elif [[ -n "$live_file" ]] && assignment_is_manager_remediation "$live_file"; then
		printf 'MANAGER_FIX'
	else
		printf 'WORKER'
	fi
}

for file in "$dir/tasks/$PROJECT-task-"*.ready.md; do
	found=1
	active_count=$((active_count + 1))
	task_id="$(task_id_from_filename "$file")"
	executor="$(task_executor "$task_id" "$file")"
	[[ "$executor" != MANAGER_FIX ]] || manager_remediation_active_count=$((manager_remediation_active_count + 1))
	progress="$(task_progress_percent "$task_id")%"
	printf -v task_row '%-32s %-12s %-13s %-10s %-28s %-10s' "$task_id" 'READY' "$executor" "$progress" '-' '-'
	task_rows+=("$task_row")
done

for file in "$dir/running/$PROJECT-task-"*.running.md; do
	found=1
	active_count=$((active_count + 1))
	task_id="$(task_id_from_filename "$file")"
	base="$(task_base "$task_id")"
	executor="$(task_executor "$task_id" "$file")"
	[[ "$executor" != MANAGER_FIX ]] || manager_remediation_active_count=$((manager_remediation_active_count + 1))
	progress="$(task_progress_percent "$task_id")%"
	lease="$dir/control/$base.lease"
	owner='unknown'
	age='unknown'
	if [[ -f "$lease" ]]; then
		owner="$(lease_value "$lease" owner)"
		heartbeat_epoch="$(lease_value "$lease" heartbeat_epoch)"
		if [[ -n "$heartbeat_epoch" ]]; then
			age="$(( $(epoch_now) - heartbeat_epoch ))s"
		fi
	fi
	printf -v task_row '%-32s %-12s %-13s %-10s %-28s %-10s' "$task_id" 'RUNNING' "$executor" "$progress" "$owner" "$age"
	task_rows+=("$task_row")
done

for file in "$dir/results/$PROJECT-task-"*.result.md; do
	found=1
	active_count=$((active_count + 1))
	task_id="$(task_id_from_filename "$file")"
	executor="$(task_executor "$task_id")"
	[[ "$executor" != MANAGER_FIX ]] || manager_remediation_active_count=$((manager_remediation_active_count + 1))
	progress="$(task_progress_percent "$task_id")%"
	printf -v task_row '%-32s %-12s %-13s %-10s %-28s %-10s' "$task_id" 'REVIEW' "$executor" "$progress" '-' '-'
	task_rows+=("$task_row")
done

for file in "$dir/archive/$PROJECT-task-"*.accepted.md; do
	found=1
	accepted_count=$((accepted_count + 1))
	name="${file##*/}"
	task_id="${name#${PROJECT}-task-}"
	task_id="${task_id%.accepted.md}"
	executor="$(task_executor "$task_id")"
	progress="$(task_progress_percent "$task_id")%"
	printf -v task_row '%-32s %-12s %-13s %-10s %-28s %-10s' "$task_id" 'ACCEPTED' "$executor" "$progress" '-' '-'
	task_rows+=("$task_row")
done

for file in "$dir/archive/$PROJECT-task-"*.checkpointed.md; do
	found=1
	checkpointed_count=$((checkpointed_count + 1))
	name="${file##*/}"
	task_id="${name#${PROJECT}-task-}"
	task_id="${task_id%.checkpointed.md}"
	executor="$(task_executor "$task_id")"
	progress="$(task_progress_percent "$task_id")%"
	printf -v task_row '%-32s %-12s %-13s %-10s %-28s %-10s' "$task_id" 'CHECKPOINTED' "$executor" "$progress" '-' '-'
	task_rows+=("$task_row")
done

for file in "$dir/control/$PROJECT-task-"*.abort.md; do
	name="${file##*/}"
	task_id="${name#${PROJECT}-task-}"
	task_id="${task_id%.abort.md}"
	abort_root="$(task_root_id "$task_id")"
	abort_item="$(project_plan_item_for_root "$abort_root" 2>/dev/null || true)"
	# A task-level abort is a terminal crash-recovery record, but it no longer
	# represents an operator block after the containing plan item completes via
	# a later revision. Keep the forensic marker for recovery without poisoning
	# the current project status forever.
	if [[ -n "$abort_item" && "$(project_plan_item_status "$abort_item")" == COMPLETE ]]; then
		continue
	fi
	found=1
	aborted_count=$((aborted_count + 1))
	progress="$(task_progress_percent "$task_id")%"
	printf -v task_row '%-32s %-12s %-13s %-10s %-28s %-10s' "$task_id" 'ABORTED' '-' "$progress" '-' '-'
	task_rows+=("$task_row")
done

for file in "$dir/control/progress/$PROJECT-task-"*.blocked.md; do
	found=1
	blocked_count=$((blocked_count + 1))
	name="${file##*/}"
	task_id="${name#${PROJECT}-task-}"
	task_id="${task_id%.blocked.md}"
	progress="$(task_progress_percent "$task_id")%"
	printf -v task_row '%-32s %-12s %-13s %-10s %-28s %-10s' "$task_id" 'BLOCKED' '-' "$progress" '-' '-'
	task_rows+=("$task_row")
done

for file in "$dir/control/progress/$PROJECT-task-"*.needs-replan.md; do
	found=1
	name="${file##*/}"
	task_id="${name#${PROJECT}-task-}"
	task_id="${task_id%.needs-replan.md}"
	if [[ -f "$(task_root_replanning_file "$task_id")" ]]; then
		continue
	fi
	replan_count=$((replan_count + 1))
	progress="$(task_progress_percent "$task_id")%"
	printf -v task_row '%-32s %-12s %-13s %-10s %-28s %-10s' "$task_id" 'NEEDS_REPLAN' 'MANAGER' "$progress" '-' '-'
	task_rows+=("$task_row")
done

for file in "$dir/control/progress/$PROJECT-task-"*.replanning.md; do
	found=1
	replanning_count=$((replanning_count + 1))
	name="${file##*/}"
	task_id="${name#${PROJECT}-task-}"
	task_id="${task_id%.replanning.md}"
	progress="$(task_progress_percent "$task_id")%"
	printf -v task_row '%-32s %-12s %-13s %-10s %-28s %-10s' "$task_id" 'REPLANNING' 'MANAGER' "$progress" '-' '-'
	task_rows+=("$task_row")
done

for file in "$dir/control/progress/$PROJECT-task-"*.needs-human.md; do
	found=1
	human_count=$((human_count + 1))
	name="${file##*/}"
	task_id="${name#${PROJECT}-task-}"
	task_id="${task_id%.needs-human.md}"
	progress="$(task_progress_percent "$task_id")%"
	printf -v task_row '%-32s %-12s %-13s %-10s %-28s %-10s' "$task_id" 'NEEDS_HUMAN' 'HUMAN' "$progress" '-' '-'
	task_rows+=("$task_row")
done

for file in "$dir/control/progress/$PROJECT-task-"*.architecture-reassessment-required.md; do
	found=1
	architecture_reassessment_count=$((architecture_reassessment_count + 1))
	name="${file##*/}"
	task_id="${name#${PROJECT}-task-}"
	task_id="${task_id%.architecture-reassessment-required.md}"
	progress="$(task_progress_percent "$task_id")%"
	category="$(metadata_value "$file" Category)"
	printf -v task_row '%-32s %-12s %-13s %-10s %-28s %-10s' "$task_id" 'ARCH_REVIEW' 'HUMAN' "$progress" "${category:--}" '-'
	task_rows+=("$task_row")
done

for file in "$dir/control/progress/$PROJECT-task-"*.token-usage-anomaly.md; do
	found=1
	token_usage_anomaly_count=$((token_usage_anomaly_count + 1))
	name="${file##*/}"
	task_id="${name#${PROJECT}-task-}"
	task_id="${task_id%.token-usage-anomaly.md}"
	progress="$(task_progress_percent "$task_id")%"
	trigger="$(metadata_value "$file" Triggered-By)"
	printf -v task_row '%-32s %-12s %-13s %-10s %-28s %-10s' "$task_id" 'TOKEN_ANOMALY' 'OPERATOR' "$progress" "${trigger:--}" '-'
	task_rows+=("$task_row")
done

for file in "$dir/control/progress/$PROJECT-task-"*.task-resource-anomaly.md; do
	found=1
	task_resource_anomaly_count=$((task_resource_anomaly_count + 1))
	name="${file##*/}"
	task_id="${name#${PROJECT}-task-}"
	task_id="${task_id%.task-resource-anomaly.md}"
	root="$(task_root_id "$task_id")"
	progress="$(task_progress_percent "$root")%"
	category="$(metadata_value "$file" Category)"
	printf -v task_row '%-32s %-12s %-13s %-10s %-28s %-10s' "$task_id" 'TASK_ANOMALY' 'DECOMPOSE' "$progress" "${category:--}" '-'
	task_rows+=("$task_row")
done

for file in "$dir/control/progress/$PROJECT-task-"*.waiting-dependency.md; do
	found=1
	waiting_dependency_count=$((waiting_dependency_count + 1))
	name="${file##*/}"
	task_id="${name#${PROJECT}-task-}"
	task_id="${task_id%.waiting-dependency.md}"
	progress="$(task_progress_percent "$task_id")%"
	request_id="$(metadata_value "$file" Request-ID)"
	printf -v task_row '%-32s %-12s %-13s %-10s %-28s %-10s' "$task_id" 'WAITING_DEP' 'EXTERNAL' "$progress" "${request_id:--}" '-'
	task_rows+=("$task_row")
done

if (( found == 0 )); then
	printf '%s\n' '(no tasks)'
else
	for ((row_index = ${#task_rows[@]} - 1; row_index >= 0; row_index--)); do
		printf '%s\n' "${task_rows[row_index]}"
	done
fi

if [[ -n "$specification_normalization_stall_report" ]]; then
	project_status_line="Project status: SPECIFICATION_NORMALIZATION_STALLED. Automatic review correction did not converge; inspect $specification_normalization_stall_report."
elif specification_ir_registered && { ! specification_ir_available || { project_plan_exists && [[ ! -f "$(specification_coverage_file)" ]]; }; }; then
	project_status_line='Project status: SPECIFICATION_IR_INVALID. Execution is stopped because accepted semantic authority, repository history, or obligation coverage no longer matches.'
elif [[ "$specification_review_status" == SPEC_CLARIFICATION_REQUIRED ]]; then
	project_status_line="Project status: SPEC_CLARIFICATION_REQUIRED. Review $specification_review_report before DAG registration."
elif [[ "$architecture_fit_status" == ARCHITECTURE_REDESIGN_REQUIRED ]]; then
	project_status_line="Project status: ARCHITECTURE_REDESIGN_REQUIRED. Foundational architecture cannot safely support the accepted specification; review $architecture_fit_report before DAG registration."
elif [[ "$startup_state" == RECOVERABLE && ! -f "$(project_plan_definition_file)" ]]; then
	project_status_line="Project status: STARTUP_RECOVERABLE. The ${startup_recovery_stage:-startup} stage hit ${startup_recovery_classification:-a recoverable guard}; accepted specification review is preserved. Fix or update the harness, then restart from ${startup_recovery_input:-the recorded input}."
elif [[ "$startup_state" == FAILED && ! -f "$(project_plan_definition_file)" ]]; then
	project_status_line="Project status: STARTUP_FAILED. Initial review or decomposition exited with status ${startup_exit:-unknown}; inspect ${startup_log:-the background startup log}."
elif project_has_integrity_anomaly; then
	project_status_line='Project status: PROJECT_INTEGRITY_ANOMALY. Accounting, Context Closure, model authority, or index policy was violated; every agent launch is suppressed pending explicit corrective resolution.'
elif (( token_usage_anomaly_count > 0 )); then
	project_status_line='Project status: TOKEN_USAGE_ANOMALY. Irregular per-episode or cumulative leaf token consumption was detected; all further project agent launches are suppressed pending an explicit corrective resolution.'
elif project_completion_recorded && project_plan_all_complete; then
	if [[ -f "$oracle_limit_marker" ]]; then
		project_status_line='Project status: COMPLETE_WITH_ORACLE_LIMIT. Every project-plan item is accepted; no final Oracle PASS was recorded after the configured audit cap.'
	else
		project_status_line='Project status: COMPLETE. Every project-plan item is accepted.'
	fi
elif (( architecture_reassessment_count > 0 )); then
	project_status_line='Project status: ARCHITECTURE_REASSESSMENT_REQUIRED. The monotonic root liveness, immutable authority, or accepted-dependency boundary was reached; verified work is preserved and further agent launches are suppressed.'
elif (( waiting_dependency_count > 0 )); then
	project_status_line='Project status: WAITING_DEPENDENCY. Exact cross-harness prerequisites are recorded; no agent runs or review-cycle gain accrues until they validate.'
elif (( human_count > 0 )); then
	project_status_line='Project status: NEEDS_HUMAN. A documented authorization, secret, external-state, or product/specification decision requires a person; verified work is preserved.'
elif (( manager_remediation_active_count > 0 )); then
	project_status_line='Project status: MANAGER_REMEDIATION. A manager-model task is repairing a directly implicated local prerequisite while preserving the original acceptance gate.'
elif (( blocked_count > 0 )); then
	project_status_line='Project status: BLOCKED. A legacy hard-block marker is awaiting manager classification; restart the manager supervisor to recover it.'
elif (( replanning_count > 0 )); then
	project_status_line='Project status: REPLANNING. The persistent manager is decomposing the root and publishing one first-unmet-criterion continuation.'
elif [[ -n "$manager_replan_failed" ]]; then
	project_status_line="Project status: RECOVERY_STALLED. Automatic manager recovery failed and unchanged-state retries are suppressed; inspect $manager_replan_failed."
elif (( replan_count > 0 )); then
	if (( HARNESS_AUTO_REPLAN_ENABLED == 1 )); then
		project_status_line='Project status: NEEDS_REPLAN. Verified checkpoints are preserved; automatic persistent-manager recovery is pending.'
	else
		project_status_line='Project status: NEEDS_REPLAN. Automatic recovery is disabled; reassess and explicitly resume the root.'
	fi
elif project_is_blocked; then
	project_status_line='Project status: BLOCKED. The Oracle requires human approval before planning can continue.'
elif [[ -f "$oracle_invocation_failure" ]]; then
	project_status_line='Project status: ORACLE_AUDIT_FAILED. The final independent audit invocation failed locally; verified work is preserved and the audit requires an automatic retry or supervisor restart.'
elif [[ -f "$manager_plan_structural_error" || -f "$manager_plan_stalled" || -f "$manager_plan_failed" ]]; then
	project_status_line='Project status: PLANNING_STALLED. No task was published; unchanged-state retries are suppressed until the plan, decomposition DAG, or architecture bindings are repaired.'
elif [[ -n "$manager_review_stalled" ]]; then
	project_status_line='Project status: REVIEW_STALLED. A completed result received no terminal manager action and made no durable state change; retries are suppressed until the review boundary changes.'
elif [[ -f "$dir/control/manager-plan.running" ]]; then
	project_status_line='Project status: PLANNING. The manager is preparing the next bounded task.'
elif (( active_count > 0 )); then
	project_status_line='Project status: ACTIVE. Work is ready, running, or awaiting manager review.'
elif (( aborted_count > 0 )); then
	project_status_line='Project status: ABORTED. One or more task roots require operator action.'
elif project_plan_exists && project_plan_all_complete && oracle_enabled &&
	[[ -f "$(project_oracle_pending_file)" ]]; then
	project_status_line='Project status: ORACLE_AUDIT. Every plan item is complete and the final independent audit is pending.'
elif project_plan_exists && project_plan_all_complete && (( HARNESS_ARCHITECTURE_GUARDS == 1 )) &&
	(( $(architecture_open_critical_debt_count) > 0 || $(architecture_expired_debt_count) > 0 || $(architecture_missing_health_gate_count) > 0 )); then
	project_status_line='Project status: ARCHITECTURE_BLOCKED. Plan work is complete, but critical/expired debt or a required architecture health gate prevents completion.'
elif project_plan_exists && (( active_count == 0 && aborted_count == 0 )) && ! project_plan_all_complete; then
	project_status_line='Project status: INCOMPLETE. No task is active; manager planning is required for the next plan item.'
elif project_completion_recorded; then
	project_status_line='Project status: INCOMPLETE. Ignoring an invalid legacy completion marker because the project plan is absent or unfinished.'
elif ! project_plan_exists; then
	project_status_line='Project status: INCOMPLETE. The project plan is missing.'
else
	project_status_line='Project status: INCOMPLETE. The project is not complete and no active task was found.'
fi

if (( checkpointed_count > 0 )); then
	printf '\nVerified checkpoints: %s\n' "$checkpointed_count"
fi

manager_remediation_occurrences=0
manager_remediation_unique_blockers=0
remediation_ledgers=("$dir/control/progress/$PROJECT-task-"*.manager-remediations.tsv)
if (( ${#remediation_ledgers[@]} > 0 )); then
	for remediation_ledger in "${remediation_ledgers[@]}"; do
		[[ -f "$remediation_ledger" ]] || continue
		remediation_rows="$(( $(wc -l < "$remediation_ledger") - 1 ))"
		(( remediation_rows >= 0 )) || remediation_rows=0
		manager_remediation_occurrences=$((manager_remediation_occurrences + remediation_rows))
	done
	manager_remediation_unique_blockers="$(
		awk -F '\t' 'FNR > 1 && $5 != "" && $5 != "-" {seen[$5]=1} END {for (item in seen) count++; print count + 0}' \
			"${remediation_ledgers[@]}"
	)"
fi
printf '\nManager remediation blockers: %s occurrence(s), %s unique fingerprint(s); %s active task(s).\n' \
	"$manager_remediation_occurrences" "$manager_remediation_unique_blockers" "$manager_remediation_active_count"

hard_block_claims=0
hard_blocks_routed_manager=0
hard_blocks_needing_human=0
hard_block_ledgers=("$dir/control/progress/$PROJECT-task-"*.hard-blocks.tsv)
if (( ${#hard_block_ledgers[@]} > 0 )); then
	for hard_block_ledger in "${hard_block_ledgers[@]}"; do
		[[ -f "$hard_block_ledger" ]] || continue
		hard_block_rows="$(( $(wc -l < "$hard_block_ledger") - 1 ))"
		(( hard_block_rows >= 0 )) || hard_block_rows=0
		hard_block_claims=$((hard_block_claims + hard_block_rows))
	done
	read -r hard_blocks_routed_manager hard_blocks_needing_human < <(
		awk -F '\t' '
			FNR > 1 && $5 == "MANAGER_REMEDIATION" {manager++}
			FNR > 1 && $5 == "NEEDS_HUMAN" {human++}
			END {print manager + 0, human + 0}
		' "${hard_block_ledgers[@]}"
	)
fi
printf 'Hard-block claims: %s occurrence(s); %s routed to manager remediation; %s confirmed human-dependent.\n' \
	"$hard_block_claims" "$hard_blocks_routed_manager" "$hard_blocks_needing_human"

project_efficiency_file="$(project_efficiency_metrics_file)"
if [[ -f "$project_efficiency_file" ]]; then
	printf 'Convergence efficiency: project=%s processed tokens per verified facet (%s tokens / %s facets).\n' \
		"$(kv_file_value "$project_efficiency_file" tokens_per_verified_facet 2>/dev/null || printf UNAVAILABLE)" \
		"$(kv_file_value "$project_efficiency_file" total_processed_tokens 2>/dev/null || printf 0)" \
		"$(kv_file_value "$project_efficiency_file" verified_facets 2>/dev/null || printf 0)"
fi

active_status_roots="$(awk -F '\t' '!/^#/ && $2 == "ACTIVE" && $3 != "-" {print $3}' "$(project_plan_state_file)" 2>/dev/null | paste -sd, -)"
active_status_root="${active_status_roots%%,*}"
if [[ -n "$active_status_root" ]]; then
	printf '\nActive cohort roots: %s (capacity %s).\n' "$active_status_roots" "$(acp_scheduler_capacity)"
	active_leaf="$(task_first_unmet_criterion "$active_status_root" 2>/dev/null || true)"
	verified_items="$(task_verified_item_count "$active_status_root")"
	replans_without_gain="$(root_auto_replans_without_verified_gain "$active_status_root")"
	printf '\nActive root evidence: %s verified item(s); %s automatic replan(s) since the latest durable gain.\n' \
		"$verified_items" "$replans_without_gain"
	printf 'Active root progress: %s%% (%s verified item(s)).\n' \
		"$(task_progress_percent "$active_status_root")" "$verified_items"
	printf 'Root liveness (active bounded epoch; raw history preserved): reviews=%s/%s replans=%s/%s children=%s/%s depth=%s/%s age=%ss/%ss tokens=%s/%s\n' \
		"$(root_liveness_epoch_delta "$active_status_root" reviewed_attempts "$(root_reviewed_attempt_count "$active_status_root")")" "$HARNESS_MAX_TOTAL_ROOT_REVIEWS" \
		"$(root_liveness_epoch_delta "$active_status_root" total_replans "$(root_total_replan_count "$active_status_root")")" "$HARNESS_MAX_TOTAL_ROOT_REPLANS" \
		"$(root_child_criterion_count "$active_status_root")" "$HARNESS_MAX_ROOT_CHILD_CRITERIA" \
		"$(root_criterion_max_depth "$active_status_root")" "$HARNESS_MAX_CRITERION_DEPTH" \
		"$(root_liveness_epoch_delta "$active_status_root" lifetime_seconds "$(root_lifetime_seconds "$active_status_root")")" "$HARNESS_MAX_ROOT_LIFETIME_SECONDS" \
		"$(root_liveness_epoch_delta "$active_status_root" processed_tokens "$(root_processed_token_count "$active_status_root")")" "$HARNESS_MAX_ROOT_PROCESSED_TOKENS"
	efficiency_file="$(task_root_efficiency_metrics_file "$active_status_root")"
	if [[ -f "$efficiency_file" ]]; then
		printf 'Convergence efficiency: active-root=%s processed tokens per verified facet; since last verified boundary tokens=%s episodes=%s.\n' \
			"$(kv_file_value "$efficiency_file" tokens_per_verified_facet 2>/dev/null || printf UNAVAILABLE)" \
			"$(kv_file_value "$efficiency_file" tokens_since_verified_facet 2>/dev/null || printf 0)" \
			"$(kv_file_value "$efficiency_file" episodes_since_verified_facet 2>/dev/null || printf 0)"
	else
		printf 'Convergence efficiency: active-root baseline pending next paid episode.\n'
	fi
	[[ -z "$active_leaf" ]] || printf 'First unmet leaf criterion: %s\n' "$active_leaf"
fi

irregularity_ledger="$(project_irregularity_ledger_file)"
efficiency_warnings=0; recorded_task_anomalies=0; recorded_integrity_anomalies=0
if [[ -f "$irregularity_ledger" ]]; then
	read -r efficiency_warnings recorded_task_anomalies recorded_integrity_anomalies < <(awk -F '\t' '
		NR>1 && $2=="EFFICIENCY_WARNING" {warning++}
		NR>1 && $2=="TASK_RESOURCE_ANOMALY" {task++}
		NR>1 && $2=="PROJECT_INTEGRITY_ANOMALY" {project++}
		END {print warning+0, task+0, project+0}
	' "$irregularity_ledger")
fi
printf 'Irregularities: efficiency-warnings=%s task-resource-anomalies=%s project-integrity-anomalies=%s.\n' \
	"$efficiency_warnings" "$recorded_task_anomalies" "$recorded_integrity_anomalies"

for goal_file in "$(goal_control_dir)"/"$PROJECT-task-"*.goal; do
	[[ -f "$goal_file" ]] || continue
	goal_state="$(status_kv_value "$goal_file" state)"
	[[ "$goal_state" =~ ^(READY|RUNNING|ITERATING|STRATEGY_REVIEW|REVIEW)$ ]] || continue
	goal_task="$(status_kv_value "$goal_file" task_id unknown)"
	goal_iterations="$(status_kv_value "$goal_file" iteration_count 0)"
	goal_target="$(status_kv_value "$goal_file" target_criterion unknown)"
	goal_id="$(status_kv_value "$goal_file" goal_id unknown)"
	goal_boundary="$(status_kv_value "$goal_file" last_boundary unknown)"
	goal_movement_at="$(status_kv_value "$goal_file" last_movement_at unknown)"
	goal_generation="$(status_kv_value "$goal_file" context_generation 0)"
	goal_turns="$(status_kv_value "$goal_file" process_turns 0)"
	goal_input="$(status_kv_value "$goal_file" cumulative_input_tokens 0)"
	goal_output="$(status_kv_value "$goal_file" cumulative_output_tokens 0)"
	goal_reviews="$(status_kv_value "$goal_file" manager_reviews 0)"
	goal_thread="$(status_kv_value "$goal_file" thread_id)"
	goal_workspace="$(status_kv_value "$goal_file" last_workspace unknown)"
	current_workspace="$(repository_workspace_fingerprint 2>/dev/null || printf unavailable)"
	goal_workspace_drift=no
	[[ "$goal_workspace" == "$current_workspace" ]] || goal_workspace_drift=yes
	goal_root="$(status_kv_value "$goal_file" task_root)"
	goal_leaf_total=0
	goal_leaf_passed=0
	if [[ -n "$goal_root" ]]; then
		while IFS= read -r goal_leaf; do
			[[ -n "$goal_leaf" ]] || continue
			goal_leaf_total=$((goal_leaf_total + 1))
			if task_criterion_is_passed "$goal_root" "$goal_leaf"; then
				goal_leaf_passed=$((goal_leaf_passed + 1))
			fi
		done < <(task_root_leaf_criteria "$goal_root")
	fi
	goal_latest_classification='not-yet-recorded'
	goal_latest_log=""
	for candidate_log in "$dir/logs/worker-task-$goal_task-"*.jsonl; do
		[[ -f "$candidate_log" ]] || continue
		if [[ -z "$goal_latest_log" || "$candidate_log" -nt "$goal_latest_log" ]]; then
			goal_latest_log="$candidate_log"
		fi
	done
	if [[ -n "$goal_latest_log" ]]; then
		goal_latest_classification="$(status_kv_value \
			"${goal_latest_log%.jsonl}.classification" classification not-yet-recorded)"
	fi
	[[ -n "$goal_thread" ]] || goal_thread='fresh/not-yet-recorded'
	printf '\nActive worker goal: %s (%s)\n' "$goal_id" "$goal_state"
	printf 'Goal task / target: %s / %s\n' "$goal_task" "$goal_target"
	printf 'Internal iterations: %s; context generation: %s; thread: %s\n' \
		"$goal_iterations" "$goal_generation" "$goal_thread"
	printf 'Worker process turns: %s\n' "$goal_turns"
	printf 'Verified leaf criteria: %s/%s; manager reviews: %s\n' \
		"$goal_leaf_passed" "$goal_leaf_total" "$goal_reviews"
	printf 'Cumulative processed tokens (not current context size): input=%s output=%s\n' \
		"$goal_input" "$goal_output"
	printf 'Latest worker/provider classification: %s\n' "$goal_latest_classification"
	printf 'Last durable boundary: %s\n' "$goal_boundary"
	printf 'Last material movement: %s\n' "$goal_movement_at"
	printf 'Workspace changed since last receipt: %s\n' "$goal_workspace_drift"
	break
done

print_project_footer
