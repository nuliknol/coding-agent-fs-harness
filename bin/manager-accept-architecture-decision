#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 4 ]] || { printf 'Usage: %s ENV_FILE DECISION_ID TASK_ID EVIDENCE_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
(( HARNESS_ARCHITECTURE_GUARDS == 1 )) || die 'architecture decisions require HARNESS_ARCHITECTURE_GUARDS=1'
acquire_project_lock
architecture_accept_decision "$2" "$3" "$4"
printf 'DECISION_ACCEPTED=%s\n' "$2"
