#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE TASK_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 2 ]] || usage
load_harness_env "$1"
candidate="$2"
ensure_project
require_registered_specification_ir
[[ -f "$candidate" ]] || die "task file does not exist: $candidate"

plan_state="$(project_plan_state_file)"
active_item="$(awk -F '\t' '!/^#/ && $2 == "ACTIVE" {print $1; exit}' "$plan_state")"
active_root="$(awk -F '\t' '!/^#/ && $2 == "ACTIVE" {print $3; exit}' "$plan_state")"
if [[ -n "$active_item" && -n "$active_root" && "$active_root" != - ]]; then
	plan_item_id="$active_item"
	task_id="$(next_task_revision_id "$active_root")"
	root_assignment="$(task_root_assignment_file "$active_root")"
	[[ -f "$root_assignment" ]] || die "active root assignment is missing: $active_root"
else
	plan_item_id="$(project_plan_first_ready_item 2>/dev/null || true)"
	[[ -n "$plan_item_id" ]] || die 'no dependency-ready pending plan node exists'
	task_id="$plan_item_id"
	active_root=""
	root_assignment=""
fi

publish_file="$PROJECT_TMP_DIR/$PROJECT-task-$task_id.planned.md"
install -m 600 "$candidate" "$publish_file"

normalize_metadata()
{
	local file="$1" field="$2" value="$3" tmp
	[[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || die "multiline metadata is invalid: $field"
	tmp="$file.tmp.$$"
	# awk -v decodes backslash escapes in assignments. Validation commands
	# commonly contain literal \n, so passing their value with -v silently
	# changed the durable DAG bytes into an embedded newline. Environment values
	# are read verbatim and retain the exact machine-owned metadata.
	HARNESS_NORMALIZED_METADATA_VALUE="$value" awk -v field="$field" '
		BEGIN {prefix = field ": "; value = ENVIRON["HARNESS_NORMALIZED_METADATA_VALUE"]}
		index($0, prefix) == 1 {
			if (!seen++) print prefix value
			next
		}
		{print}
		END {if (!seen) print prefix value}
	' "$file" > "$tmp"
	chmod 600 "$tmp"
	mv "$tmp" "$file"
}

planned_scope_is_within_root_authority()
{
	local proposed="$1" authority="$2" entry authority_entry allowed
	local -a proposed_entries=() authority_entries=()
	proposed="${proposed//;/,}"
	authority="${authority//;/,}"
	IFS=',' read -r -a proposed_entries <<< "$proposed"
	IFS=',' read -r -a authority_entries <<< "$authority"
	for entry in "${proposed_entries[@]}"; do
		entry="$(trim_surrounding_whitespace "$entry")"
		[[ -n "$entry" ]] || continue
		allowed=0
		for authority_entry in "${authority_entries[@]}"; do
			authority_entry="$(trim_surrounding_whitespace "$authority_entry")"
			[[ -n "$authority_entry" ]] || continue
			if [[ "$entry" == "$authority_entry" || "$entry" == "$authority_entry"/* ]]; then
				allowed=1
				break
			fi
		done
		(( allowed == 1 )) || return 1
	done
}

# Durable state owns publication identity. The planner authors the task, but
# it must not infer revision numbering or the active plan-node identifier.
normalize_metadata "$publish_file" Task-ID "$task_id"
normalize_metadata "$publish_file" Project-Plan-Item-ID "$plan_item_id"

# The decomposition DAG is durable machine-owned state. A planning model may
# explain the task in prose, but it must not be able to stall publication by
# paraphrasing or mistyping fields already fixed by the accepted DAG.
if [[ -z "$root_assignment" ]]; then
	normalize_metadata "$publish_file" Depends-On "$(project_plan_node_value "$plan_item_id" depends_on)"
	normalize_metadata "$publish_file" Deliverable "$(project_plan_node_value "$plan_item_id" deliverable)"
	normalize_metadata "$publish_file" Goal-Success-Evidence "$(project_plan_node_value "$plan_item_id" acceptance_evidence)"
	normalize_metadata "$publish_file" Focused-Validation "$(project_plan_node_value "$plan_item_id" focused_validation)"
	normalize_metadata "$publish_file" Allowed-Scope "$(project_plan_node_value "$plan_item_id" allowed_paths)"
	normalize_metadata "$publish_file" Required-Symbols "$(project_plan_node_value "$plan_item_id" required_symbols)"
	node_leaf_type="$(project_plan_node_value "$plan_item_id" leaf_type)"
	[[ -z "$node_leaf_type" ]] || normalize_metadata "$publish_file" Leaf-Type "$node_leaf_type"
	normalize_metadata "$publish_file" Complexity-Class "$(project_plan_node_value "$plan_item_id" complexity_class)"
	normalize_metadata "$publish_file" Worker-Route "$(project_plan_node_value "$plan_item_id" worker_route)"
	if project_plan_has_column behavioral_concerns; then
		normalize_metadata "$publish_file" Behavioral-Concerns "$(project_plan_node_value "$plan_item_id" behavioral_concerns)"
		normalize_metadata "$publish_file" Failure-Paths "$(project_plan_node_value "$plan_item_id" failure_paths)"
		normalize_metadata "$publish_file" Ownership-Transitions "$(project_plan_node_value "$plan_item_id" ownership_transitions)"
		normalize_metadata "$publish_file" Concurrency-Boundaries "$(project_plan_node_value "$plan_item_id" concurrency_boundaries)"
		normalize_metadata "$publish_file" Validation-Surfaces "$(project_plan_node_value "$plan_item_id" validation_surfaces)"
		normalize_metadata "$publish_file" Expected-Max-Implementation-Files "$(project_plan_node_value "$plan_item_id" implementation_files)"
		normalize_metadata "$publish_file" Expected-Max-Agent-Actions "$(project_plan_node_value "$plan_item_id" predicted_worker_actions)"
		normalize_metadata "$publish_file" Predicted-P95-Tokens "$(project_plan_node_value "$plan_item_id" predicted_p95_tokens)"
		normalize_metadata "$publish_file" Terra-Exception "$(project_plan_node_value "$plan_item_id" terra_exception)"
		complexity_score="$(awk -F '\t' -v node="$plan_item_id" 'NR>1 && $1==node {print $4; exit}' "$(decomposition_complexity_report_file)")"
		effective_p95="$(awk -F '\t' -v node="$plan_item_id" 'NR>1 && $1==node {print $17; exit}' "$(decomposition_complexity_report_file)")"
		normalize_metadata "$publish_file" Complexity-Score "$complexity_score"
		normalize_metadata "$publish_file" Effective-P95-Tokens "$effective_p95"
	fi
	node_validation="$(project_plan_node_value "$plan_item_id" focused_validation)"
	case "$node_validation" in
		CLEAN_GLOBAL:*) node_validation_class=CLEAN_GLOBAL ;;
		INCREMENTAL:*) node_validation_class=INCREMENTAL ;;
		*) node_validation_class=FOCUSED ;;
	esac
	normalize_metadata "$publish_file" Validation-Class "$node_validation_class"
	if [[ "$(project_plan_node_value "$plan_item_id" worker_route)" == LUNA ]]; then
		# Luna implements an already-resolved bounded leaf; architecture
		# decisions are consumed through machine-owned bindings, never delegated
		# as fresh decision authority in the worker contract.
		normalize_metadata "$publish_file" Architecture-Decisions NONE
	fi
	if architecture_registered &&
		architecture_registry_has_id "$(architecture_node_bindings_file)" "$plan_item_id"; then
		normalize_metadata "$publish_file" Affected-Invariants \
			"$(architecture_node_value "$plan_item_id" invariant_ids)"
		normalize_metadata "$publish_file" Consumed-Decisions \
			"$(architecture_node_value "$plan_item_id" consumes_decisions)"
		normalize_metadata "$publish_file" Produced-Decisions \
			"$(architecture_node_value "$plan_item_id" produces_decisions)"
		normalize_metadata "$publish_file" Edge-Contracts \
			"$(architecture_node_value "$plan_item_id" edge_contracts)"
		normalize_metadata "$publish_file" Health-Gates \
			"$(architecture_node_value "$plan_item_id" health_gates)"
	fi
fi

# Criterion IDs are identifiers, while models often append an explanatory
# em-dash sentence. Preserve multiple criteria, strip only prose suffixes, and
# synthesize the common single-criterion root from Target-Criterion when the
# model omitted the redundant Root-Criterion line.
criterion_tmp="$publish_file.criteria.tmp.$$"
awk '
	index($0, "Root-Criterion: ") == 1 {
		value=substr($0, length("Root-Criterion: ") + 1)
		sub(/[[:space:]].*$/, "", value)
		if (value != "") {print "Root-Criterion: " value; found=1}
		next
	}
	{print}
	END {
		if (!found) {
			# The shell appends the validated target below; this branch only
			# records that no criterion was present.
			print "__HARNESS_ROOT_CRITERION_MISSING__"
		}
	}
' "$publish_file" > "$criterion_tmp"
if grep -Fqx '__HARNESS_ROOT_CRITERION_MISSING__' "$criterion_tmp"; then
	target_criterion="$(metadata_value "$publish_file" Target-Criterion)"
	[[ -n "$target_criterion" ]] || die 'planned task must declare Target-Criterion'
	sed -i "s|^__HARNESS_ROOT_CRITERION_MISSING__$|Root-Criterion: $target_criterion|" "$criterion_tmp"
fi
chmod 600 "$criterion_tmp"
mv "$criterion_tmp" "$publish_file"
mandatory_refs="$(metadata_value "$publish_file" Mandatory-Git-Refs)"
if [[ "${mandatory_refs^^}" == NONE || "$mandatory_refs" == - ]]; then
	normalize_metadata "$publish_file" Mandatory-Git-Refs -
fi

if [[ -n "$root_assignment" ]]; then
	# A continuation may narrow its objective and evidence, but it cannot mutate
	# the accepted root's DAG routing or architecture authority. Fill omissions
	# and replace accidental sentinel/spelling changes deterministically.
	for field in \
		Leaf-Type Complexity-Class Worker-Route Depends-On Deliverable \
		Required-Symbols Context-Paths Architecture-Decisions Validation-Class \
		Expected-Max-Implementation-Files Expected-Max-Worker-Turns \
		Expected-Max-Agent-Actions Predicted-P95-Tokens Effective-P95-Tokens Complexity-Score \
		Behavioral-Concerns Failure-Paths Ownership-Transitions Concurrency-Boundaries Validation-Surfaces Terra-Exception \
		Affected-Invariants Consumed-Decisions Produced-Decisions \
		Edge-Contracts Health-Gates; do
		value="$(metadata_value "$root_assignment" "$field")"
		[[ -n "$value" ]] || continue
		normalize_metadata "$publish_file" "$field" "$value"
	done
	# Legacy roots could be reclassified from Terra to Luna before the
	# three-turn Luna contract was machine-enforced.  Preserve the root's
	# immutable write/architecture authority, but narrow that stale execution
	# allowance to the current Luna maximum so the publisher does not restore a
	# value that its own validator must reject.
	inherited_route="$(metadata_value "$publish_file" Worker-Route)"
	inherited_turns="$(metadata_value "$publish_file" Expected-Max-Worker-Turns)"
	if [[ "$inherited_route" == LUNA && "$inherited_turns" =~ ^[1-9][0-9]*$ ]] &&
		(( inherited_turns > 3 )); then
		normalize_metadata "$publish_file" Expected-Max-Worker-Turns 3
		log_event "LEGACY_LUNA_TURN_BUDGET_NORMALIZED root=$active_root previous=$inherited_turns current=3"
	fi
	root_scope="$(metadata_value "$root_assignment" Allowed-Scope)"
	planned_scope="$(metadata_value "$publish_file" Allowed-Scope)"
	if [[ -n "$root_scope" && -n "$planned_scope" ]] &&
		! planned_scope_is_within_root_authority "$planned_scope" "$root_scope"; then
		die "planned Allowed-Scope exceeds immutable root authority; use an exact path subset of: $root_scope"
	fi
fi

"$HARNESS_BIN/manager-publish-task" "$HARNESS_ENV_FILE" \
	"$task_id" "$publish_file" "$plan_item_id"
