#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2
	printf 'Remove a project-wide Oracle approval block and requeue a completed plan for a fresh audit.\n' >&2
	exit 2
}

[[ $# -eq 1 ]] || usage
load_harness_env "$1"
ensure_project
acquire_project_lock

block="$(project_block_file)"
[[ -f "$block" ]] || die 'project is not blocked'
blocked_audit_id="$(awk -F': ' '$1 == "Audit-ID" {print $2; exit}' "$block")"
[[ "$blocked_audit_id" =~ ^[1-9][0-9]*$ ]] || blocked_audit_id=unknown

requeued=0
if oracle_enabled && project_plan_all_complete && ! project_completion_recorded; then
	mark_project_awaiting_oracle "oracle-unblock-$blocked_audit_id"
	requeued=1
fi
rm -f "$block"
log_event "PROJECT_UNBLOCKED source=operator-oracle-retry prior_audit_id=$blocked_audit_id oracle_requeued=$requeued"
if (( requeued == 1 )); then
	printf 'Project %s is unblocked and a fresh Oracle audit is pending. Restart the harness to continue.\n' "$PROJECT"
else
	printf 'Project %s is unblocked. Restart the harness to continue.\n' "$PROJECT"
fi
