#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE [--reset-stale]\n' "${0##*/}" >&2
	exit 2
}

[[ $# -ge 1 && $# -le 2 ]] || usage
load_harness_env "$1"
mode="${2:-}"
[[ -z "$mode" || "$mode" == '--reset-stale' ]] || usage
ensure_project

dir="$(project_dir)"
shopt -s nullglob
problems=0

for file in "$dir/running/$PROJECT-task-"*.running.md; do
	task_id="$(task_id_from_filename "$file")"
	base="$(task_base "$task_id")"
	lease="$dir/control/$base.lease"
	if [[ -f "$(goal_state_file "$task_id")" ]]; then
		goal_workspace="$(kv_file_value "$(goal_state_file "$task_id")" last_workspace)"
		current_workspace="$(repository_workspace_fingerprint)"
		goal_drift=no
		[[ "$goal_workspace" == "$current_workspace" ]] || goal_drift=yes
		printf 'ACTIVE_GOAL task=%s goal=%s iteration=%s state=%s workspace-drift=%s\n' \
			"$task_id" \
			"$(kv_file_value "$(goal_state_file "$task_id")" goal_id)" \
			"$(kv_file_value "$(goal_state_file "$task_id")" iteration_count)" \
			"$(kv_file_value "$(goal_state_file "$task_id")" state)" \
			"$goal_drift"
	fi

	if [[ ! -f "$lease" ]]; then
		printf 'ORPHAN_RUNNING task=%s reason=missing-lease\n' "$task_id"
		problems=$((problems + 1))
		if [[ "$mode" == '--reset-stale' ]]; then
			"$HARNESS_BIN/harness-reset-task" "$HARNESS_ENV_FILE" "$task_id" --force
		fi
		continue
	fi

	heartbeat_epoch="$(lease_value "$lease" heartbeat_epoch)"
	heartbeat_epoch="${heartbeat_epoch:-0}"
	age=$(( $(epoch_now) - heartbeat_epoch ))
	if (( age > HARNESS_STALE_SECONDS )); then
		owner="$(lease_value "$lease" owner)"
		printf 'STALE_RUNNING task=%s owner=%s age=%ss\n' "$task_id" "$owner" "$age"
		problems=$((problems + 1))
		if [[ "$mode" == '--reset-stale' ]]; then
			"$HARNESS_BIN/harness-reset-task" "$HARNESS_ENV_FILE" "$task_id" --force
		fi
	fi
done

for file in "$(goal_control_dir)"/"$PROJECT-task-"*.goal; do
	[[ -f "$file" ]] || continue
	goal_state="$(kv_file_value "$file" state 2>/dev/null || true)"
	[[ "$goal_state" =~ ^(READY|RUNNING|ITERATING|STRATEGY_REVIEW|REVIEW)$ ]] || continue
	task_id="$(kv_file_value "$file" task_id)"
	base="$(task_base "$task_id")"
	if [[ ! -f "$dir/tasks/$base.ready.md" &&
		! -f "$dir/running/$base.running.md" &&
		! -f "$dir/results/$base.result.md" ]]; then
		printf 'ORPHAN_GOAL task=%s goal=%s state=%s reason=missing-task-artifact\n' \
			"$task_id" "$(kv_file_value "$file" goal_id)" "$goal_state"
		problems=$((problems + 1))
	fi
done

for file in "$dir/tasks/"*.tmp.* "$dir/results/"*.tmp.* "$dir/control/"*.tmp.*; do
	[[ -e "$file" ]] || continue
	mtime="$(stat -c '%Y' "$file")"
	age=$(( $(epoch_now) - mtime ))
	if (( age > HARNESS_STALE_SECONDS )); then
		printf 'STALE_TEMP file=%s age=%ss\n' "$file" "$age"
		problems=$((problems + 1))
	fi
done

if (( problems == 0 )); then
	printf 'No recoverable problems found.\n'
fi
