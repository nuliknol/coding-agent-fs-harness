#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE [--reset-stale|--reset-orphaned]\n' "${0##*/}" >&2
	exit 2
}

[[ $# -ge 1 && $# -le 2 ]] || usage
load_harness_env "$1"
mode="${2:-}"
[[ -z "$mode" || "$mode" == '--reset-stale' || "$mode" == '--reset-orphaned' ]] || usage
ensure_project

dir="$(project_dir)"
shopt -s nullglob
problems=0
recovered=0

if [[ "$mode" == --reset-orphaned ]] && env_has_running_processes; then
	die 'cannot reset orphaned crash state while harness processes still reference this environment'
fi
if [[ "$mode" == --reset-orphaned ]]; then
	for stale_control in \
		"$dir/control/supervisor.pid" "$dir/control/supervisor.env-file" \
		"$dir/control/worker-supervisor.pid" "$dir/control/worker-supervisor.env-file"; do
		[[ -e "$stale_control" ]] || continue
		rm -f "$stale_control"
		printf 'REMOVED_STALE_PROCESS_METADATA file=%s\n' "$stale_control"
	done
	command_lock="$(env_command_lock_path)"
	if [[ -e "$command_lock" && "${HARNESS_ENV_COMMAND_LOCK_FILE:-}" != "$command_lock" ]]; then
		rm -f "$command_lock"
		printf 'REMOVED_STALE_PROCESS_METADATA file=%s\n' "$command_lock"
	fi
fi

for file in "$dir/running/$PROJECT-task-"*.running.md; do
	task_id="$(task_id_from_filename "$file")"
	base="$(task_base "$task_id")"
	lease="$dir/control/$base.lease"
	if [[ -f "$(goal_state_file "$task_id")" ]]; then
		goal_workspace="$(kv_file_value "$(goal_state_file "$task_id")" last_workspace)"
		current_workspace="$(repository_workspace_fingerprint)"
		goal_drift=no
		[[ "$goal_workspace" == "$current_workspace" ]] || goal_drift=yes
		printf 'ACTIVE_GOAL task=%s goal=%s iteration=%s state=%s workspace-drift=%s\n' \
			"$task_id" \
			"$(kv_file_value "$(goal_state_file "$task_id")" goal_id)" \
			"$(kv_file_value "$(goal_state_file "$task_id")" iteration_count)" \
			"$(kv_file_value "$(goal_state_file "$task_id")" state)" \
			"$goal_drift"
	fi

	if [[ "$mode" == --reset-orphaned ]]; then
		result="$dir/results/$base.result.md"
		if [[ -f "$result" ]]; then
			recovery_dir="$dir/archive/crash-recovery"
			mkdir -p "$recovery_dir"
			chmod 700 "$recovery_dir"
			preserved="$recovery_dir/$base.uncommitted-result.$(timestamp_compact_utc).md"
			mv "$result" "$preserved"
			printf 'PRESERVED_UNCOMMITTED_RESULT task=%s file=%s\n' "$task_id" "$preserved"
		fi
		printf 'ORPHAN_RUNNING task=%s reason=no-live-harness-process\n' "$task_id"
		problems=$((problems + 1))
		"$HARNESS_BIN/harness-reset-task" "$HARNESS_ENV_FILE" "$task_id" --force >/dev/null
		recovered=$((recovered + 1))
		continue
	elif [[ ! -f "$lease" ]]; then
		printf 'ORPHAN_RUNNING task=%s reason=missing-lease\n' "$task_id"
		problems=$((problems + 1))
		if [[ "$mode" == '--reset-stale' ]]; then
			"$HARNESS_BIN/harness-reset-task" "$HARNESS_ENV_FILE" "$task_id" --force
		fi
		continue
	fi

	heartbeat_epoch="$(lease_value "$lease" heartbeat_epoch)"
	heartbeat_epoch="${heartbeat_epoch:-0}"
	age=$(( $(epoch_now) - heartbeat_epoch ))
	if (( age > HARNESS_STALE_SECONDS )); then
		owner="$(lease_value "$lease" owner)"
		printf 'STALE_RUNNING task=%s owner=%s age=%ss\n' "$task_id" "$owner" "$age"
		problems=$((problems + 1))
		if [[ "$mode" == '--reset-stale' ]]; then
			"$HARNESS_BIN/harness-reset-task" "$HARNESS_ENV_FILE" "$task_id" --force
		fi
	fi
done

if [[ "$mode" == --reset-orphaned ]]; then
	for assignment in "$dir/archive/$PROJECT-task-"*.assignment.md; do
		[[ -f "$assignment" ]] || continue
		task_id="${assignment##*/}"
		task_id="${task_id#${PROJECT}-task-}"
		task_id="${task_id%.assignment.md}"
		base="$(task_base "$task_id")"
		if [[ -f "$dir/tasks/$base.ready.md" ||
			-f "$dir/running/$base.running.md" ||
			-f "$dir/results/$base.result.md" ||
			-f "$dir/control/$base.abort.md" ||
			-f "$dir/archive/$base.accepted.md" ||
			-f "$dir/archive/$base.checkpointed.md" ||
			-f "$dir/archive/$base.rejected.md" ||
			-f "$dir/archive/$base.blocked.md" ||
			-f "$dir/archive/$base.superseded.md" ||
			-f "$dir/archive/$base.aborted.assignment.md" ]]; then
			continue
		fi
		root="$(task_root_id "$task_id")"
		item="$(project_plan_item_for_root "$root")"
		[[ -n "$item" && "$(project_plan_item_status "$item")" == ACTIVE ]] || continue
		printf 'ORPHAN_ARCHIVED_ASSIGNMENT task=%s reason=incomplete-completion-transaction\n' "$task_id"
		problems=$((problems + 1))
		"$HARNESS_BIN/harness-reset-task" "$HARNESS_ENV_FILE" "$task_id" --force >/dev/null
		recovered=$((recovered + 1))
	done
fi

for file in "$(goal_control_dir)"/"$PROJECT-task-"*.goal; do
	[[ -f "$file" ]] || continue
	goal_state="$(kv_file_value "$file" state 2>/dev/null || true)"
	[[ "$goal_state" =~ ^(READY|RUNNING|ITERATING|STRATEGY_REVIEW|REVIEW)$ ]] || continue
	task_id="$(kv_file_value "$file" task_id)"
	base="$(task_base "$task_id")"
	# An explicit operator abort is terminal even when a crash had already
	# moved the assignment into the archive before harness-abort-task ran.
	# Do not diagnose (or later resurrect) that goal as an orphan.
	[[ -f "$dir/control/$base.abort.md" ]] && continue
	if [[ ! -f "$dir/tasks/$base.ready.md" &&
		! -f "$dir/running/$base.running.md" &&
		! -f "$dir/results/$base.result.md" ]]; then
		printf 'ORPHAN_GOAL task=%s goal=%s state=%s reason=missing-task-artifact\n' \
			"$task_id" "$(kv_file_value "$file" goal_id)" "$goal_state"
		problems=$((problems + 1))
	fi
done

for file in "$dir/tasks/"*.tmp.* "$dir/results/"*.tmp.* "$dir/control/"*.tmp.*; do
	[[ -e "$file" ]] || continue
	mtime="$(stat -c '%Y' "$file")"
	age=$(( $(epoch_now) - mtime ))
	if (( age > HARNESS_STALE_SECONDS )); then
		printf 'STALE_TEMP file=%s age=%ss\n' "$file" "$age"
		problems=$((problems + 1))
	fi
done

if [[ "$mode" == --reset-orphaned ]]; then
	printf 'Crash reconciliation complete: recovered=%s detected=%s\n' "$recovered" "$problems"
elif (( problems == 0 )); then
	printf 'No recoverable problems found.\n'
fi
