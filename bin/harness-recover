#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE [--reset-stale|--reset-orphaned]\n' "${0##*/}" >&2
	exit 2
}

[[ $# -ge 1 && $# -le 2 ]] || usage
load_harness_env "$1"
mode="${2:-}"
[[ -z "$mode" || "$mode" == '--reset-stale' || "$mode" == '--reset-orphaned' ]] || usage
ensure_project

dir="$(project_dir)"
shopt -s nullglob
problems=0
recovered=0

task_revision_index()
{
	local task="$1"
	if [[ "$task" =~ -revision-([0-9]+)$ ]]; then
		printf '%s\n' "$((10#${BASH_REMATCH[1]}))"
	else
		printf '0\n'
	fi
}

if [[ "$mode" == --reset-orphaned ]] && env_has_running_processes; then
	die 'cannot reset orphaned crash state while harness processes still reference this environment'
fi
if [[ "$mode" == --reset-orphaned ]]; then
	for stale_control in \
		"$dir/control/supervisor.pid" "$dir/control/supervisor.env-file" \
		"$dir/control/worker-supervisor.pid" "$dir/control/worker-supervisor.env-file"; do
		[[ -e "$stale_control" ]] || continue
		rm -f "$stale_control"
		printf 'REMOVED_STALE_PROCESS_METADATA file=%s\n' "$stale_control"
	done
	command_lock="$(env_command_lock_path)"
	if [[ -e "$command_lock" && "${HARNESS_ENV_COMMAND_LOCK_FILE:-}" != "$command_lock" ]]; then
		rm -f "$command_lock"
		printf 'REMOVED_STALE_PROCESS_METADATA file=%s\n' "$command_lock"
	fi
fi

for file in "$dir/running/$PROJECT-task-"*.running.md; do
	task_id="$(task_id_from_filename "$file")"
	base="$(task_base "$task_id")"
	lease="$dir/control/$base.lease"
	if [[ -f "$(goal_state_file "$task_id")" ]]; then
		goal_workspace="$(kv_file_value "$(goal_state_file "$task_id")" last_workspace)"
		current_workspace="$(repository_workspace_fingerprint)"
		goal_drift=no
		[[ "$goal_workspace" == "$current_workspace" ]] || goal_drift=yes
		printf 'ACTIVE_GOAL task=%s goal=%s iteration=%s state=%s workspace-drift=%s\n' \
			"$task_id" \
			"$(kv_file_value "$(goal_state_file "$task_id")" goal_id)" \
			"$(kv_file_value "$(goal_state_file "$task_id")" iteration_count)" \
			"$(kv_file_value "$(goal_state_file "$task_id")" state)" \
			"$goal_drift"
	fi

	if [[ "$mode" == --reset-orphaned ]]; then
		result="$dir/results/$base.result.md"
		if [[ -f "$result" ]]; then
			recovery_dir="$dir/archive/crash-recovery"
			mkdir -p "$recovery_dir"
			chmod 700 "$recovery_dir"
			preserved="$recovery_dir/$base.uncommitted-result.$(timestamp_compact_utc).md"
			mv "$result" "$preserved"
			printf 'PRESERVED_UNCOMMITTED_RESULT task=%s file=%s\n' "$task_id" "$preserved"
		fi
		printf 'ORPHAN_RUNNING task=%s reason=no-live-harness-process\n' "$task_id"
		problems=$((problems + 1))
		"$HARNESS_BIN/harness-reset-task" "$HARNESS_ENV_FILE" "$task_id" --force >/dev/null
		recovered=$((recovered + 1))
		continue
	elif [[ ! -f "$lease" ]]; then
		printf 'ORPHAN_RUNNING task=%s reason=missing-lease\n' "$task_id"
		problems=$((problems + 1))
		if [[ "$mode" == '--reset-stale' ]]; then
			"$HARNESS_BIN/harness-reset-task" "$HARNESS_ENV_FILE" "$task_id" --force
		fi
		continue
	fi

	heartbeat_epoch="$(lease_value "$lease" heartbeat_epoch)"
	heartbeat_epoch="${heartbeat_epoch:-0}"
	age=$(( $(epoch_now) - heartbeat_epoch ))
	if (( age > HARNESS_STALE_SECONDS )); then
		owner="$(lease_value "$lease" owner)"
		printf 'STALE_RUNNING task=%s owner=%s age=%ss\n' "$task_id" "$owner" "$age"
		problems=$((problems + 1))
		if [[ "$mode" == '--reset-stale' ]]; then
			"$HARNESS_BIN/harness-reset-task" "$HARNESS_ENV_FILE" "$task_id" --force
		fi
	fi
done

if [[ "$mode" == --reset-orphaned ]]; then
	# A crash between internal retirement, publication, and supervisor
	# reconciliation can leave both one ready assignment and one root replan
	# marker. Revision order identifies the committed side of the transaction:
	# a newer ready child supersedes an older marker, while a typed marker at or
	# beyond the ready revision proves that the ready assignment was resurrected.
	for ready in "$dir/tasks/$PROJECT-task-"*.ready.md; do
		[[ -f "$ready" ]] || continue
		ready_task="$(task_id_from_filename "$ready")"
		ready_base="$(task_base "$ready_task")"
		root="$(task_root_id "$ready_task")"
		replan_file="$(task_root_replan_file "$root")"
		[[ -f "$replan_file" ]] || continue
		trigger_task="$(metadata_value "$replan_file" Triggered-By)"
		[[ "$(task_root_id "$trigger_task")" == "$root" ]] || continue
		ready_revision="$(task_revision_index "$ready_task")"
		trigger_revision="$(task_revision_index "$trigger_task")"
		recovery_dir="$dir/archive/crash-recovery"
		mkdir -p "$recovery_dir"
		chmod 700 "$recovery_dir"
		if (( ready_revision > trigger_revision )); then
			preserved="$recovery_dir/${replan_file##*/}.$(timestamp_compact_utc).stale"
			mv "$replan_file" "$preserved"
			printf 'STALE_REPLAN_MARKER_ARCHIVED root=%s ready=%s trigger=%s file=%s\n' \
				"$root" "$ready_task" "$trigger_task" "$preserved"
			recovered=$((recovered + 1))
			continue
		fi
		replan_outcome="$(metadata_value "$replan_file" Trigger-Outcome)"
		if [[ "$replan_outcome" =~ ^(LUNA_ONLY_POLICY_MIGRATION|CONTEXT_CLOSURE_REPAIR)$ ]] ||
			[[ -f "$dir/control/$ready_base.context-closure-repair.env" ||
				-f "$dir/control/$ready_base.recovery-retired" ]]; then
			preserved="$recovery_dir/$ready_base.resurrected-ready.$(timestamp_compact_utc).md"
			mv "$ready" "$preserved"
			: > "$dir/control/$ready_base.recovery-retired"
			chmod 600 "$dir/control/$ready_base.recovery-retired"
			goal_record_manager_decision "$ready_task" MIGRATED
			printf 'RESURRECTED_TYPED_READY_ARCHIVED task=%s trigger=%s file=%s\n' \
				"$ready_task" "$trigger_task" "$preserved"
			recovered=$((recovered + 1))
		fi
	done

	for assignment in "$dir/archive/$PROJECT-task-"*.assignment.md; do
		[[ -f "$assignment" ]] || continue
		task_id="${assignment##*/}"
		task_id="${task_id#${PROJECT}-task-}"
		task_id="${task_id%.assignment.md}"
		base="$(task_base "$task_id")"
		if [[ -f "$dir/tasks/$base.ready.md" ||
			-f "$dir/running/$base.running.md" ||
			-f "$dir/results/$base.result.md" ||
			-f "$dir/control/$base.abort.md" ||
			-f "$dir/archive/$base.accepted.md" ||
			-f "$dir/archive/$base.checkpointed.md" ||
			-f "$dir/archive/$base.rejected.md" ||
			-f "$dir/archive/$base.blocked.md" ||
			-f "$dir/archive/$base.superseded.md" ||
			-f "$dir/archive/$base.aborted.assignment.md" ||
			-f "$dir/control/$base.policy-migrated" ||
			-f "$dir/control/$base.recovery-retired" ]]; then
			continue
		fi
		root="$(task_root_id "$task_id")"
		# Internal repair/migration transitions intentionally archive an
		# assignment without producing a worker result. Older deployments did
		# not write the terminal marker, so derive and persist it from their
		# typed durable evidence before generic crash recovery can resurrect the
		# retired assignment.
		typed_internal_transition=0
		if [[ -f "$dir/control/$base.context-closure-repair.env" ]]; then
			typed_internal_transition=1
		else
			replan_file="$(task_root_replan_file "$root")"
			if [[ -f "$replan_file" ]] &&
				[[ "$(metadata_value "$replan_file" Triggered-By)" == "$task_id" ]]; then
				replan_outcome="$(metadata_value "$replan_file" Trigger-Outcome)"
				case "$replan_outcome" in
					LUNA_ONLY_POLICY_MIGRATION|CONTEXT_CLOSURE_REPAIR)
						typed_internal_transition=1
						;;
				esac
			fi
		fi
		if (( typed_internal_transition == 1 )); then
			: > "$dir/control/$base.recovery-retired"
			chmod 600 "$dir/control/$base.recovery-retired"
			goal_record_manager_decision "$task_id" MIGRATED
			printf 'TYPED_INTERNAL_ASSIGNMENT_RETIRED task=%s\n' "$task_id"
			recovered=$((recovered + 1))
			continue
		fi
		item="$(project_plan_item_for_root "$root")"
		[[ -n "$item" && "$(project_plan_item_status "$item")" == ACTIVE ]] || continue
		printf 'ORPHAN_ARCHIVED_ASSIGNMENT task=%s reason=incomplete-completion-transaction\n' "$task_id"
		problems=$((problems + 1))
		"$HARNESS_BIN/harness-reset-task" "$HARNESS_ENV_FILE" "$task_id" --force >/dev/null
		recovered=$((recovered + 1))
	done
fi

for file in "$(goal_control_dir)"/"$PROJECT-task-"*.goal; do
	[[ -f "$file" ]] || continue
	goal_state="$(kv_file_value "$file" state 2>/dev/null || true)"
	[[ "$goal_state" =~ ^(READY|RUNNING|ITERATING|STRATEGY_REVIEW|REVIEW)$ ]] || continue
	task_id="$(kv_file_value "$file" task_id)"
	base="$(task_base "$task_id")"
	# An explicit operator abort is terminal even when a crash had already
	# moved the assignment into the archive before harness-abort-task ran.
	# Do not diagnose (or later resurrect) that goal as an orphan.
	[[ -f "$dir/control/$base.abort.md" ]] && continue
	# Backfill terminal goal state for migrations/repairs completed before goal
	# retirement was part of the internal transition transaction.
	if [[ -f "$dir/control/$base.policy-migrated" ||
		-f "$dir/control/$base.recovery-retired" ||
		-f "$dir/control/$base.context-closure-repair.env" ]]; then
		goal_record_manager_decision "$task_id" MIGRATED
		printf 'TYPED_INTERNAL_GOAL_RETIRED task=%s goal=%s\n' \
			"$task_id" "$(kv_file_value "$file" goal_id)"
		recovered=$((recovered + 1))
		continue
	fi
	if [[ ! -f "$dir/tasks/$base.ready.md" &&
		! -f "$dir/running/$base.running.md" &&
		! -f "$dir/results/$base.result.md" ]]; then
		printf 'ORPHAN_GOAL task=%s goal=%s state=%s reason=missing-task-artifact\n' \
			"$task_id" "$(kv_file_value "$file" goal_id)" "$goal_state"
		problems=$((problems + 1))
	fi
done

for file in "$dir/tasks/"*.tmp.* "$dir/results/"*.tmp.* "$dir/control/"*.tmp.*; do
	[[ -e "$file" ]] || continue
	mtime="$(stat -c '%Y' "$file")"
	age=$(( $(epoch_now) - mtime ))
	if (( age > HARNESS_STALE_SECONDS )); then
		if [[ "$mode" == --reset-orphaned ]]; then
			stale_dir="$dir/archive/crash-recovery/stale-temp"
			mkdir -p "$stale_dir"
			chmod 700 "$stale_dir"
			parent="${file%/*}"
			parent="${parent##*/}"
			preserved="$stale_dir/$parent.${file##*/}"
			if [[ -e "$preserved" ]]; then
				preserved="$preserved.$(timestamp_compact_utc)"
			fi
			mv "$file" "$preserved"
			printf 'STALE_TEMP_ARCHIVED file=%s age=%ss archive=%s\n' "$file" "$age" "$preserved"
			recovered=$((recovered + 1))
		else
			printf 'STALE_TEMP file=%s age=%ss\n' "$file" "$age"
			problems=$((problems + 1))
		fi
	fi
done

if [[ "$mode" == --reset-orphaned ]]; then
	printf 'Crash reconciliation complete: recovered=%s detected=%s\n' "$recovered" "$problems"
elif (( problems == 0 )); then
	printf 'No recoverable problems found.\n'
fi
