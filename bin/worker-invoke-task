#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE TASK_ID\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 2 ]] || usage
load_harness_env "$1"
task_id="$2"
ensure_project
require_registered_specification_ir
require_repository
trace_init worker_invoke_task
trace_script_start "$@"
trap 'trace_script_exit $?' EXIT
validate_task_id "$task_id"

dir="$(project_dir)"
base="$(task_base "$task_id")"
ready="$dir/tasks/$base.ready.md"
[[ -f "$ready" ]] || die "task is not ready: $task_id"
manager_remediation=0
execution_role=worker
execution_model="$WORKER_MODEL"
execution_fallback_model="$WORKER_FALLBACK_MODEL"
execution_mode=WORKER
worker_route=LEGACY
leaf_expected_turns=0
if assignment_is_manager_remediation "$ready"; then
	manager_remediation=1
	execution_role=manager_remediation
	execution_model="$MANAGER_MODEL"
	execution_fallback_model="$MANAGER_FALLBACK_MODEL"
	execution_mode=MANAGER_REMEDIATION
	worker_route=MANAGER_REMEDIATION
	if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
		leaf_expected_turns="$(require_single_metadata_value "$ready" Expected-Max-Worker-Turns 'v2 manager remediation assignment')"
		[[ "$leaf_expected_turns" =~ ^[1-9][0-9]*$ ]] || die 'invalid v2 Expected-Max-Worker-Turns'
	fi
	require_manager_codex
	write_manager_snapshot
else
	if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
		worker_route="$(require_single_metadata_value "$ready" Worker-Route 'v2 worker assignment')"
		leaf_expected_turns="$(require_single_metadata_value "$ready" Expected-Max-Worker-Turns 'v2 worker assignment')"
		[[ "$leaf_expected_turns" =~ ^[1-9][0-9]*$ ]] || die 'invalid v2 Expected-Max-Worker-Turns'
		case "$worker_route" in
			LUNA)
				execution_role=worker_luna
				execution_model="$LUNA_WORKER_MODEL"
				execution_fallback_model="$TERRA_WORKER_MODEL"
				execution_mode=LUNA_LEAF
				;;
			TERRA)
				execution_role=worker_terra
				execution_model="$TERRA_WORKER_MODEL"
				execution_fallback_model="$MANAGER_FALLBACK_MODEL"
				execution_mode=TERRA_LEAF
				;;
			*) die "invalid v2 Worker-Route: $worker_route" ;;
		esac
	fi
	require_worker_codex
	write_worker_snapshot
fi
if assignment_uses_goal_mode "$ready"; then
	(( HARNESS_WORKER_GOAL_MODE == 1 )) ||
		die 'refusing to claim an active LEAF_GOAL after HARNESS_WORKER_GOAL_MODE was disabled'
elif (( HARNESS_WORKER_GOAL_MODE == 1 )); then
	die 'refusing to claim a legacy assignment after HARNESS_WORKER_GOAL_MODE was enabled; change mode only at a clean task boundary'
fi

session="$("$HARNESS_BIN/harness-new-session" "$HARNESS_ENV_FILE" worker)"
trace_event WORKER_SESSION_CREATED "task_id=$task_id" "session=$session"
claim_output="$("$HARNESS_BIN/worker-claim-task" "$HARNESS_ENV_FILE" "$task_id" "$session")"
task_file="$(printf '%s\n' "$claim_output" | awk -F= '$1 == "TASK_FILE" {sub(/^[^=]*=/, ""); print; exit}')"
[[ -f "$task_file" ]] || die "claimed task file is missing: $task_file"
if (( manager_remediation == 1 )); then
	assignment_is_manager_remediation "$task_file" ||
		die 'manager remediation metadata changed during task claim'
fi
initialize_task_progress "$task_id" "$task_file"
task_root="$(task_root_id "$task_id")"
plan_item_id="$(project_plan_item_for_root "$task_root")"
specification_obligations_path='-'
specification_relations_path='-'
specification_coverage_path='-'
allocated_specification_obligations='-'
if specification_ir_available; then
	specification_obligations_path="$(specification_obligations_file)"
	specification_relations_path="$(specification_relations_file)"
	specification_coverage_path="$(specification_coverage_file)"
	allocated_specification_obligations="$(specification_obligations_for_node "$plan_item_id" | paste -sd, -)"
	[[ -n "$allocated_specification_obligations" ]] || die "active DAG node has no normalized specification obligations: $plan_item_id"
fi
progress_file="$(task_progress_file "$task_root")"
root_assignment_file="$(task_root_assignment_file "$task_root")"
starting_progress="$(task_progress_percent "$task_root")"
development_policy_file=""
if (( manager_remediation == 1 )) && [[ -f "$REPOSITORY/design/development-policy.txt" ]]; then
	development_policy_file="$REPOSITORY/design/development-policy.txt"
fi
context_capsule_file="$(task_context_capsule_file "$task_id")"
validation_class="$(metadata_value "$task_file" Validation-Class)"
[[ -n "$validation_class" ]] || validation_class=FOCUSED
if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
	[[ -f "$context_capsule_file" ]] || die "v2 context capsule is missing: $context_capsule_file"
else
	context_capsule_file=""
fi
trace_event WORKER_TASK_CLAIMED "task_id=$task_id" "session=$session" "task_file=$task_file"

worker_thread_file="$(worker_thread_state_file "$task_root")"
goal_mode=0
goal_state=""
goal_id=""
goal_target=""
goal_summary=""
goal_ledger=""
pending_semantic_review=0
if assignment_uses_goal_mode "$task_file"; then
	goal_mode=1
	(( HARNESS_WORKER_GOAL_MODE == 1 )) ||
		die 'an active LEAF_GOAL cannot run after HARNESS_WORKER_GOAL_MODE is disabled'
	goal_state="$(goal_state_file "$task_id")"
	goal_summary="$(goal_summary_file "$task_id")"
	goal_ledger="$(goal_iteration_ledger_file "$task_id")"
	[[ -f "$goal_state" && -f "$goal_ledger" ]] ||
		die "goal state is missing for task: $task_id"
	goal_id="$(kv_file_value "$goal_state" goal_id)"
	goal_target="$(kv_file_value "$goal_state" target_criterion)"
	goal_iteration_at_claim="$(kv_file_value "$goal_state" iteration_count 2>/dev/null || printf 0)"
	goal_marker_at_claim="$(goal_continue_marker_file "$task_id")"
	if (( HARNESS_SEMANTIC_CONTINUATION_REVIEW_ENABLED == 1 )) &&
		[[ "$goal_iteration_at_claim" =~ ^[1-9][0-9]*$ ]] &&
		[[ -f "$goal_marker_at_claim" ]] &&
		[[ "$(kv_file_value "$goal_marker_at_claim" iteration 2>/dev/null || true)" == "$goal_iteration_at_claim" ]] &&
		[[ ! -f "$(goal_continuation_decision_file "$task_id" "$goal_iteration_at_claim")" ]]; then
		# Upgrade/recovery compatibility: an older worker may have durably
		# published CONTINUE and then crashed or hit a resource fuse before this
		# semantic-review protocol existed. Review it before launching any worker.
		pending_semantic_review=1
		goal_state_set "$goal_state" state AWAITING_MANAGER_REVIEW
		goal_state_set "$goal_state" thread_id ""
		goal_state_set "$goal_state" thread_context awaiting-semantic-review
		goal_thread_store "$task_id" "" awaiting-semantic-review
	else
		goal_state_set "$goal_state" state RUNNING
	fi
	goal_state_set "$goal_state" active_session "$session"
	goal_state_set "$goal_state" updated_at "$(timestamp_utc)"
fi
worker_context_mode="fresh"
worker_context_reason="no_retained_thread"
worker_resume_thread_id=""
worker_thread_rejections=0
worker_last_outcome=""
if (( goal_mode == 1 )); then
	worker_resume_thread_id="$(kv_file_value "$goal_state" thread_id 2>/dev/null || true)"
	if [[ "$worker_resume_thread_id" =~ ^[A-Za-z0-9-]+$ ]]; then
		worker_context_mode="resumed"
		worker_context_reason="same_leaf_goal"
	else
		worker_resume_thread_id=""
		worker_context_reason="$(kv_file_value "$goal_state" thread_context 2>/dev/null || printf goal_fresh)"
	fi
elif (( HARNESS_REUSE_WORKER_THREADS == 0 )); then
	worker_context_reason="reuse_disabled"
elif [[ "$task_id" == "$task_root" ]]; then
	worker_context_reason="new_root_task"
elif grep -Eq '^Worker-Context:[[:space:]]*FRESH[[:space:]]*$' "$task_file"; then
	worker_context_reason="assignment_requested_fresh"
elif [[ -f "$worker_thread_file" ]]; then
	worker_resume_thread_id="$(kv_file_value "$worker_thread_file" thread_id 2>/dev/null || true)"
	worker_thread_rejections="$(kv_file_value "$worker_thread_file" rejection_count 2>/dev/null || printf 0)"
	worker_last_outcome="$(kv_file_value "$worker_thread_file" last_outcome 2>/dev/null || true)"
	[[ "$worker_thread_rejections" =~ ^[0-9]+$ ]] || worker_thread_rejections=0
	if [[ ! "$worker_resume_thread_id" =~ ^[A-Za-z0-9-]+$ ]]; then
		worker_resume_thread_id=""
		worker_context_reason="invalid_retained_thread"
	elif (( HARNESS_WORKER_THREAD_MAX_REJECTIONS > 0 && worker_thread_rejections >= HARNESS_WORKER_THREAD_MAX_REJECTIONS )); then
		worker_resume_thread_id=""
		worker_context_reason="rejection_rotation_limit"
	else
		worker_context_mode="resumed"
		if [[ "$worker_last_outcome" == CHECKPOINT ]]; then
			worker_context_reason="same_root_checkpoint"
		else
			worker_context_reason="same_root_rejection"
		fi
	fi
fi

closure_mode=0
if (( HARNESS_CLOSURE_MODE_ENABLED == 1 )) &&
	[[ "$task_id" != "$task_root" ]] &&
	(( starting_progress >= HARNESS_CLOSURE_MODE_MIN_PROGRESS && starting_progress < 100 )); then
	closure_mode=1
fi
log_event "WORKER_CONTEXT_SELECTED task=$task_id root=$task_root mode=$worker_context_mode reason=$worker_context_reason thread_id=${worker_resume_thread_id:-none} retained_rejections=$worker_thread_rejections closure_mode=$closure_mode goal_mode=$goal_mode goal_id=${goal_id:--} execution_mode=$execution_mode"
trace_event WORKER_CONTEXT_SELECTED "task_id=$task_id" "task_root=$task_root" "mode=$worker_context_mode" "reason=$worker_context_reason" "thread_id=${worker_resume_thread_id:-}" "retained_rejections=$worker_thread_rejections" "closure_mode=$closure_mode" "goal_mode=$goal_mode" "goal_id=${goal_id:-}" "execution_mode=$execution_mode"

prompt_file="$dir/control/$base.worker.prompt.md"
cp "$HARNESS_HOME/prompts/worker-agent-event-driven.md" "$prompt_file.tmp.$$"
cat >> "$prompt_file.tmp.$$" <<PROMPT

The worker protocol above is already loaded. Do not open or reread its source file.

HARNESS_BIN=$HARNESS_BIN
ENV_FILE=$HARNESS_ENV_FILE
PROJECT=$PROJECT
PROJECT_TMP_DIR=$PROJECT_TMP_DIR
REPOSITORY=$REPOSITORY
TASK_ID=$task_id
TASK_FILE=$task_file
TASK_ROOT=$task_root
ROOT_ASSIGNMENT_FILE=$root_assignment_file
PROGRESS_FILE=$progress_file
STARTING_PROGRESS_PERCENT=$starting_progress
DEVELOPMENT_POLICY_FILE=$development_policy_file
CONTEXT_CAPSULE_FILE=$context_capsule_file
SPECIFICATION_OBLIGATIONS_FILE=$specification_obligations_path
SPECIFICATION_RELATIONS_FILE=$specification_relations_path
SPECIFICATION_COVERAGE_FILE=$specification_coverage_path
ALLOCATED_SPECIFICATION_OBLIGATIONS=$allocated_specification_obligations
SESSION=$session
WORKER_CONTEXT_MODE=$worker_context_mode
WORKER_CONTEXT_REASON=$worker_context_reason
WORKER_RETAINED_REJECTIONS=$worker_thread_rejections
CLOSURE_MODE=$closure_mode
CLOSURE_MAX_FIXES=$HARNESS_CLOSURE_MODE_MAX_FIXES
CLOSURE_MAX_SMOKE_RUNS=$HARNESS_CLOSURE_MODE_MAX_SMOKE_RUNS
WORKER_GOAL_MODE=$goal_mode
ARCHITECTURE_GUARDS=$HARNESS_ARCHITECTURE_GUARDS
ARCHITECTURE_DIR=$(architecture_dir)
EXECUTION_MODE=$execution_mode
GOAL_ID=$goal_id
GOAL_TARGET_CRITERION=$goal_target
GOAL_STATE_FILE=$goal_state
GOAL_SUMMARY_FILE=$goal_summary
GOAL_ITERATION_LEDGER_FILE=$goal_ledger
GOAL_PROCESS_MAX_FIXES=$HARNESS_GOAL_PROCESS_MAX_FIXES
GOAL_PROCESS_MAX_SMOKE_RUNS=$HARNESS_GOAL_PROCESS_MAX_SMOKE_RUNS
VALIDATION_CLASS=$validation_class
VALIDATION_OUTPUT_POLICY=CAPTURE_SUMMARY

The task is already claimed by this launcher. For a v2 task, the complete bounded assignment and context capsule are embedded below. They are the worker's entire harness context: do not open DEVELOPMENT_POLICY_FILE, ROOT_ASSIGNMENT_FILE, PROGRESS_FILE, GOAL_SUMMARY_FILE, specification IR/coverage files, or other harness control files. Do not reread the embedded assignment or capsule through shell commands. Inspect only Context-Paths, Allowed-Scope, Required-Symbols, and repository files directly implicated by compiler/linker diagnostics. Legacy tasks without an embedded capsule may read their named task and progress files once.

Preserve verified work and continue from STARTING_PROGRESS_PERCENT rather than reimplementing the root task from zero. Implement exactly the remaining bounded assignment. Run build and test validation through this command so complete output is retained on disk and only a bounded summary enters this transcript:

$HARNESS_BIN/harness-run-logged "$HARNESS_ENV_FILE" "$task_id" LABEL -- COMMAND...

Never invoke a potentially verbose build/test command directly. Validation-Class CLEAN_GLOBAL authorizes observation only in a Terra integration leaf; it never broadens implementation scope. Commit every task-owned source/source-related change with harness-commit-source before a terminal result. Use harness-publish-branch when Publish-Branch is declared. Never run direct Git index/history mutations. Generated output, object files, binaries, ignored files, and paths outside Allowed-Scope must remain uncommitted. Write scratch files and the result report under PROJECT_TMP_DIR, publish the result with worker-complete-task, and terminate. If an exact mandatory cross-harness Git ref is absent, use worker-wait-dependency with a precise requirements TSV and supplier note instead of repeating absence audits or claiming gain. Do not wait for another task.
PROMPT
if (( manager_remediation == 1 )); then
	remediation_scope="$(require_single_metadata_value "$task_file" Remediation-Scope 'manager remediation assignment')"
	remediation_class="$(require_single_metadata_value "$task_file" Blocker-Class 'manager remediation assignment')"
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Manager baseline-remediation execution is active because ordinary bounded worker strategies reached a local coding/build/integration/ownership blocker. You are running with the manager model specifically to repair that prerequisite, not merely to describe it.

Blocker class: $remediation_class
Authorized remediation scope: $remediation_scope

You may edit the directly implicated local files in Remediation-Scope even if an ordinary worker ownership rule, exclusive-file list, forbidden-file list, baseline label, or prior Allowed-Scope excluded them. The harness records these paths as manager baseline remediation, separate from the feature worker's owned implementation delta. Diagnose from current compiler, linker, test, and repository evidence; make the smallest complete repair; then validate the original Target-Criterion without weakening its observable behavior. Do not alter the specification, acceptance behavior, unrelated APIs/behavior, external systems, credentials, or authorization boundaries. A normal source, build, test, integration, or file-ownership defect is resolvable here and is not a reason to request human intervention.
PROMPT
fi
if (( goal_mode == 1 )); then
	goal_iteration="$(kv_file_value "$goal_state" iteration_count)"
	goal_boundary="$(kv_file_value "$goal_state" last_boundary)"
	goal_workspace="$(kv_file_value "$goal_state" last_workspace)"
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Leaf-goal execution is active. This is one logical goal for the independently verifiable criterion GOAL_TARGET_CRITERION, even if it requires several Codex turns. For a legacy task only, read GOAL_SUMMARY_FILE and GOAL_ITERATION_LEDGER_FILE once when they contain prior iterations. A v2 task already embeds the current bounded state and must not reread those harness files. Continue diagnosing, implementing, and running focused validation until exactly one of these terminal outcomes is true:

- COMPLETE: the goal success evidence and focused validation in TASK_FILE pass.
- NEEDS_DECOMPOSITION: the criterion is still too broad or repeated strategy attempts cannot make material movement.
- HARD_BLOCKED: an explicit Hard-Block-Conditions boundary in TASK_FILE is actually met.

Current durable iteration: $goal_iteration
Current boundary: $goal_boundary
Current workspace fingerprint: $goal_workspace

When another bounded turn is useful, write a receipt under PROJECT_TMP_DIR with exactly one Task-ID, Goal-ID, Iteration, Outcome: CONTINUE, Boundary-Before, Boundary-After, Workspace-Fingerprint-Before, and Workspace-Fingerprint-After line, plus nonempty sections named "## Progress made", "## Validation performed", "## Next bounded action", and "## Scope check". Iteration must be $((goal_iteration + 1)); the before values must equal the current durable values above. Obtain the exact after value with:

$HARNESS_BIN/harness-workspace-fingerprint "$HARNESS_ENV_FILE"

Publish the receipt with:

$HARNESS_BIN/worker-continue-task "$HARNESS_ENV_FILE" "$task_id" "$session" RECEIPT_FILE

After that command succeeds, end this Codex turn. The harness will review the semantic boundary and either start a fresh implementation episode for the same logical goal or return the leaf to decomposition. A CONTINUE receipt must record a changed boundary, changed workspace, or genuinely new evidence/strategy. If evidence shows that the assigned failure premise is false, that an upstream prerequisite owns the actual failure, or that the next work exceeds this leaf's authority, state that plainly in "Next bounded action" and stop; do not broaden the leaf on your own. Process-local work should stay within $HARNESS_GOAL_PROCESS_MAX_FIXES small corrections and $HARNESS_GOAL_PROCESS_MAX_SMOKE_RUNS focused smoke executions before publishing CONTINUE.

For a terminal result, include "Goal-ID: $goal_id" and exactly one "Goal-Outcome: COMPLETE|NEEDS_DECOMPOSITION|HARD_BLOCKED", retain the normal worker result headings, publish it with worker-complete-task, and terminate. Do not use NEEDS_DECOMPOSITION merely because another ordinary diagnostic/fix turn is required. Do not use HARD_BLOCKED for test failure, complexity, token pressure, or lack of immediate progress.
PROMPT
fi
if (( closure_mode == 1 )); then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Bounded closure mode is active because this continuation starts at ${starting_progress}%. Within this one turn, close the same focused root acceptance gate using at most $HARNESS_CLOSURE_MODE_MAX_FIXES small evidence-backed corrections and at most $HARNESS_CLOSURE_MODE_MAX_SMOKE_RUNS total executions of the assigned focused smoke. A manager-authored phrase such as "exactly once" or "do not rerun" does not reduce this closure budget; the human-owned specification and immutable root scope remain authoritative.

Start with the current first failure. Diagnose before editing, apply only the smallest correction directly implicated by that failure, rebuild the affected target, and use the next focused-smoke execution. Repeat only while the failure remains inside TASK_ROOT and the correction does not require a new public API, new scope, relaxed acceptance criterion, fabricated fallback, increased capacity without evidence, or an explicitly prohibited file/behavior. A directly implicated additional root-scope implementation file may be changed when the runtime diagnostic or stack proves it necessary; record why it is inside the closure boundary. Stop immediately on a passing smoke, exhausted budget, an out-of-root failure, or a required design/authority choice. Never substitute broad tests for the single focused gate. Report the exact number of fixes and smoke executions.
PROMPT
fi
if codex_model_requires_narrow_prompt "$execution_model"; then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Context: authorized local development in my own repository. Task type: benign software engineering. Do not perform offensive security, credential extraction, vulnerability exploitation, malware behavior, unauthorized access, network scanning, or bypassing security controls. Use only the listed local project files needed for the requested implementation: TASK_FILE and the files explicitly referenced by that bounded assignment.
PROMPT
fi
if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
	{
		printf '\n## Embedded bounded assignment\n\n'
		cat "$task_file"
		printf '\n## Embedded bounded context capsule\n\n'
		cat "$context_capsule_file"
		printf '\n## End embedded worker context\n'
	} >> "$prompt_file.tmp.$$"
fi
chmod 600 "$prompt_file.tmp.$$"
mv "$prompt_file.tmp.$$" "$prompt_file"

result="$dir/results/$base.result.md"
running="$dir/running/$base.running.md"
lease="$dir/control/$base.lease"
assignment_archive="$dir/archive/$base.assignment.md"
staged_result="$dir/control/$base.direct-result.$$"
protocol_reason=""
json_log=""
stderr_log=""
classification=""
last_message=""
status=0
attempt=1
provider_retries=0
quota_waits=0
fallback_stage=0
current_model="$execution_model"
heartbeat_pid=""

completion_committed()
{
	[[ -f "$result" && ! -e "$running" && ! -e "$lease" && -f "$assignment_archive" ]]
}

waiting_dependency_committed()
{
	[[ -f "$(task_root_waiting_dependency_file "$task_root")" &&
		! -e "$running" && ! -e "$lease" && -f "$assignment_archive" ]]
}

emit_synthetic_impact_manifest()
{
	(( HARNESS_ARCHITECTURE_GUARDS == 1 )) || return 0
	printf 'Changed-Public-Symbols: -\n'
	printf 'Changed-Representations: -\n'
	printf 'Changed-Ownership: -\n'
	printf 'Changed-Serialization: -\n'
	printf 'Changed-Dependencies: -\n'
	printf 'Affected-Invariants: %s\n' "$(require_single_metadata_value "$task_file" Affected-Invariants 'active assignment')"
	printf 'Affected-Edges: %s\n' "$(require_single_metadata_value "$task_file" Edge-Contracts 'active assignment')"
}

publish_goal_decomposition_handoff()
{
	local reason="$1" concern="$2" handoff
	handoff="$PROJECT_TMP_DIR/$base.goal-decomposition-handoff.$$"
	{
		printf '# Worker Task Result\n\n'
		printf 'Task-ID: %s\n' "$task_id"
		printf 'Status: COMPLETED\n'
		printf 'Goal-ID: %s\n' "$goal_id"
		printf 'Goal-Outcome: NEEDS_DECOMPOSITION\n'
		emit_synthetic_impact_manifest
		printf '\n'
		printf '## Summary\n\n%s\n\n' "$reason"
		printf '## Modified files\n\nAll workspace changes and source commits produced before the episode closed are preserved for independent manager inspection.\n\n'
		printf '## Implemented behavior\n\nNo implementation claim is synthesized by the harness.\n\n'
		printf '## Validation performed\n\nSee the preserved JSONL, command evidence, assignment, and goal ledger.\n\n'
		printf '## Deviations from assignment\n\nThe current semantic episode ended before terminal acceptance.\n\n'
		printf '## Remaining concerns\n\n%s\n\n' "$concern"
		printf '## Worker assessment\n\nNEEDS_DECOMPOSITION; use fresh context and preserve any independently verified increment.\n'
	} > "$handoff"
	chmod 600 "$handoff"
	"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$handoff" >/dev/null
	rm -f "$handoff"
	completion_committed
}

normalize_direct_result()
{
	local normalize_status
	if [[ -f "$result" && -f "$running" && -f "$lease" && ! -e "$assignment_archive" ]]; then
		mv "$result" "$staged_result"
		set +e
		"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$staged_result" >/dev/null
		normalize_status=$?
		set -e
		if (( normalize_status == 0 )); then
			rm -f "$staged_result"
			log_event "WORKER_DIRECT_RESULT_NORMALIZED task=$task_id session=$session"
		else
			if (( goal_mode == 1 )) && [[ -f "$staged_result" ]]; then
				invalid_direct="$dir/control/$base.invalid-direct-result-attempt-$attempt.md"
				mv "$staged_result" "$invalid_direct"
				log_event "WORKER_GOAL_INVALID_DIRECT_RESULT task=$task_id session=$session file=$invalid_direct"
			elif [[ ! -e "$result" && -f "$staged_result" ]]; then
				mv "$staged_result" "$result"
			fi
			protocol_reason="direct_result_normalization_failed:$normalize_status"
		fi
	fi
}

normalize_last_message_result()
{
	local normalize_status
	if (( status == 0 )) &&
		[[ -s "$last_message" && ! -f "$result" && -f "$running" && -f "$lease" && ! -e "$assignment_archive" ]]; then
		if (( goal_mode == 1 )) &&
			! grep -Eq '^Goal-Outcome:[[:space:]]*(COMPLETE|NEEDS_DECOMPOSITION|HARD_BLOCKED)[[:space:]]*$' "$last_message"; then
			return 0
		fi
		set +e
		"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$last_message" >/dev/null
		normalize_status=$?
		set -e
		if (( normalize_status == 0 )); then
			log_event "WORKER_LAST_MESSAGE_RESULT_NORMALIZED task=$task_id session=$session"
		else
			protocol_reason="last_message_result_normalization_failed:$normalize_status"
		fi
	fi
}

heartbeat_loop()
{
	while true; do
		sleep "$WORKER_HEARTBEAT_SECONDS"
		"$HARNESS_BIN/worker-heartbeat" "$HARNESS_ENV_FILE" "$task_id" "$session" >/dev/null 2>&1 || break
	done
}

cleanup_heartbeat()
{
	if [[ -n "$heartbeat_pid" ]]; then
		kill "$heartbeat_pid" 2>/dev/null || true
		wait "$heartbeat_pid" 2>/dev/null || true
		heartbeat_pid=""
	fi
}
trap cleanup_heartbeat EXIT
trap 'cleanup_heartbeat; exit 130' INT
trap 'cleanup_heartbeat; exit 143' TERM

heartbeat_loop &
heartbeat_pid=$!
trace_event WORKER_HEARTBEAT_STARTED "task_id=$task_id" "session=$session" "heartbeat_pid=$heartbeat_pid" "interval=$WORKER_HEARTBEAT_SECONDS"

while true; do
	if (( pending_semantic_review == 1 )); then
		"$HARNESS_BIN/manager-review-goal-continuation" "$HARNESS_ENV_FILE" "$task_id" >/dev/null
		semantic_decision="$(kv_file_value "$goal_state" semantic_decision 2>/dev/null || true)"
		semantic_relation="$(kv_file_value "$goal_state" semantic_relation 2>/dev/null || true)"
		semantic_decision_file="$(kv_file_value "$goal_state" semantic_decision_file 2>/dev/null || true)"
		if [[ "$semantic_decision" == REPLAN ]]; then
			if publish_goal_decomposition_handoff \
				"Recovery found an unreviewed durable continuation from an earlier worker episode; semantic review returned it to decomposition." \
				"Criterion relation: $semantic_relation. Decision: $semantic_decision_file"; then
				cleanup_heartbeat
				log_event "WORKER_GOAL_RECOVERED_SEMANTIC_REPLAN task=$task_id goal=$goal_id iteration=$(kv_file_value "$goal_state" iteration_count) relation=$semantic_relation decision=$semantic_decision_file"
				printf 'Recovered worker goal %s returned to decomposition after semantic review.\n' "$goal_id"
				exit 0
			fi
			die 'failed to publish recovered semantic-replan handoff'
		fi
		[[ "$semantic_decision" == CONTINUE && "$semantic_relation" == SAME_CRITERION ]] ||
			die 'recovered semantic continuation review did not publish a valid decision'
		worker_resume_thread_id=""
		worker_context_mode=fresh
		worker_context_reason=semantic_episode_recovery
		pending_semantic_review=0
		log_event "WORKER_GOAL_RECOVERED_CONTINUATION_APPROVED task=$task_id goal=$goal_id iteration=$(kv_file_value "$goal_state" iteration_count)"
	fi
	goal_iteration_before=0
	if (( goal_mode == 1 )); then
		goal_iteration_before="$(kv_file_value "$goal_state" iteration_count)"
	fi
	stamp="$(date -u '+%Y%m%dT%H%M%SZ')"
	attempt_label="$(printf '%03d' "$attempt")"
	json_log="$dir/logs/worker-task-$task_id-$stamp-attempt-$attempt_label.jsonl"
	stderr_log="$dir/logs/worker-task-$task_id-$stamp-attempt-$attempt_label.stderr.log"
	last_message="$dir/logs/worker-task-$task_id-$stamp-attempt-$attempt_label.md"

	log_event "WORKER_INVOCATION_STARTED task=$task_id session=$session model=$current_model execution_mode=$execution_mode attempt=$attempt"
	trace_event WORKER_INVOCATION_ATTEMPT "task_id=$task_id" "session=$session" "attempt=$attempt" "execution_mode=$execution_mode" "thread_id=${worker_resume_thread_id:-}" "json_log=$json_log" "last_message=$last_message"
	set +e
	trace_event CODEX_EXEC_START "role=$execution_role" "task_id=$task_id" "session=$session" "attempt=$attempt" "mode=$([[ -n "$worker_resume_thread_id" ]] && printf resume || printf fresh)" "thread_id=${worker_resume_thread_id:-}" "json_log=$json_log" "stderr_log=$stderr_log" "last_message=$last_message" "model=$current_model"
	resume_args=()
	[[ -z "$worker_resume_thread_id" ]] || resume_args=(resume "$worker_resume_thread_id")
	HARNESS_CODEX_STOP_FILE="$(task_root_waiting_dependency_file "$task_root")" \
		"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" "$execution_role" "$current_model" "$prompt_file" "$json_log" "$stderr_log" "$last_message" "${resume_args[@]}"
	status=$?
	set -e
	observed_thread_id="$(codex_thread_id_from_jsonl "$json_log" 2>/dev/null || true)"
	if [[ "$observed_thread_id" =~ ^[A-Za-z0-9-]+$ ]]; then
		worker_resume_thread_id="$observed_thread_id"
		if (( goal_mode == 1 )) &&
			[[ "$(kv_file_value "$goal_state" thread_context 2>/dev/null || true)" != rotation-requested ]] &&
			[[ "$(kv_file_value "$goal_state" state 2>/dev/null || true)" != AWAITING_MANAGER_REVIEW ]]; then
			goal_state_set "$goal_state" thread_id "$observed_thread_id"
			goal_state_set "$goal_state" thread_context resumed
			goal_thread_store "$task_id" "$observed_thread_id" resumed
		fi
	fi
	classification="$(kv_file_value "${json_log%.jsonl}.classification" classification 2>/dev/null || true)"
	record_root_agent_tokens "$task_id" "$execution_role" "${json_log%.jsonl}.classification"
	resource_guard="$(kv_file_value "${json_log%.jsonl}.classification" resource_guard 2>/dev/null || printf -)"
	worker_task_tokens="$(worker_task_processed_token_count "$task_id")"
	[[ "$worker_task_tokens" =~ ^[0-9]+$ ]] || worker_task_tokens=0
	if (( worker_task_tokens >= HARNESS_MAX_WORKER_TASK_PROCESSED_TOKENS )) && [[ "$resource_guard" == - ]]; then
		mark_root_token_usage_anomaly "$task_id" \
			"worker task processed-token budget reached ($worker_task_tokens/$HARNESS_MAX_WORKER_TASK_PROCESSED_TOKENS)" \
			"role=$execution_role model=$current_model classification=${json_log%.jsonl}.classification jsonl=$json_log" >/dev/null
		if (( goal_mode == 1 )); then
			if publish_goal_decomposition_handoff \
				"The cumulative worker usage for this immutable leaf reached $worker_task_tokens processed tokens; the harness stopped before authorizing another episode." \
				"Inspect the token anomaly record and split, correct, or explicitly justify the continuation boundary before resolving the pause."; then
				cleanup_heartbeat
				log_event "WORKER_TASK_TOKEN_BUDGET_PAUSED task=$task_id root=$task_root processed_tokens=$worker_task_tokens limit=$HARNESS_MAX_WORKER_TASK_PROCESSED_TOKENS"
				printf 'Worker goal %s reached its cumulative token anomaly limit and paused.\n' "$goal_id"
				exit 0
			fi
			die 'failed to publish cumulative token-anomaly handoff'
		fi
		cleanup_heartbeat
		log_event "WORKER_TASK_TOKEN_BUDGET_PAUSED task=$task_id root=$task_root processed_tokens=$worker_task_tokens limit=$HARNESS_MAX_WORKER_TASK_PROCESSED_TOKENS legacy=1"
		exit 75
	fi
	if (( goal_mode == 1 )) && [[ "$resource_guard" != - ]]; then
		if publish_goal_decomposition_handoff \
			"The implementation episode reached the emergency $resource_guard resource fuse; this limits one context, not the amount of work allowed for the goal." \
			"The manager must inspect the preserved evidence, split or restate the next semantic episode, and may continue the same criterion when it remains valid."; then
			cleanup_heartbeat
			log_event "WORKER_GOAL_RESOURCE_EPISODE_CLOSED task=$task_id root=$task_root guard=$resource_guard classification=${classification:-unknown}"
			printf 'Worker goal %s closed its overgrown semantic episode and requested decomposition.\n' "$goal_id"
			exit 0
		fi
		die 'failed to publish resource-fuse decomposition handoff'
	fi
	if task_root_needs_human "$task_root" && [[ "$(kv_file_value "${json_log%.jsonl}.classification" resource_guard 2>/dev/null || printf -)" != - ]]; then
		cleanup_heartbeat
		log_event "WORKER_RESOURCE_GUARD_PAUSED task=$task_id root=$task_root classification=${classification:-unknown}"
		printf 'Worker task %s exceeded an invocation resource guard; workspace changes are preserved and the root requires human review.\n' "$task_id" >&2
		(( status != 0 )) || status=75
		exit "$status"
	fi
	if (( goal_mode == 1 )); then
		goal_turns="$(kv_file_value "$goal_state" process_turns 2>/dev/null || printf 0)"
		goal_input="$(kv_file_value "$goal_state" cumulative_input_tokens 2>/dev/null || printf 0)"
		goal_output="$(kv_file_value "$goal_state" cumulative_output_tokens 2>/dev/null || printf 0)"
		[[ "$goal_turns" =~ ^[0-9]+$ ]] || goal_turns=0
		[[ "$goal_input" =~ ^[0-9]+$ ]] || goal_input=0
		[[ "$goal_output" =~ ^[0-9]+$ ]] || goal_output=0
		turn_input="$(codex_usage_value_from_jsonl "$json_log" input_tokens)"
		turn_output="$(codex_usage_value_from_jsonl "$json_log" output_tokens)"
		[[ "$turn_input" =~ ^[0-9]+$ ]] || turn_input=0
		[[ "$turn_output" =~ ^[0-9]+$ ]] || turn_output=0
		goal_state_set "$goal_state" process_turns "$((goal_turns + 1))"
		goal_state_set "$goal_state" cumulative_input_tokens "$((goal_input + turn_input))"
		goal_state_set "$goal_state" cumulative_output_tokens "$((goal_output + turn_output))"
	fi
	trace_event CODEX_EXEC_END "role=$execution_role" "task_id=$task_id" "session=$session" "attempt=$attempt" "status=$status" "classification=${classification:-unknown}" "json_log=$json_log" "stderr_log=$stderr_log" "last_message=$last_message"
	if waiting_dependency_committed; then
		cleanup_heartbeat
		log_event "WORKER_INVOCATION_WAITING_DEPENDENCY task=$task_id session=$session attempt=$attempt"
		trace_event WORKER_WAITING_DEPENDENCY "task_id=$task_id" "session=$session" "attempt=$attempt"
		printf 'Worker task %s entered WAITING_DEPENDENCY and released its agent process.\n' "$task_id"
		exit 0
	fi

	normalize_direct_result
	normalize_last_message_result
	if completion_committed; then
		if (( goal_mode == 1 )) && [[ "$observed_thread_id" =~ ^[A-Za-z0-9-]+$ ]]; then
			goal_state_set "$goal_state" thread_id "$observed_thread_id"
			goal_thread_store "$task_id" "$observed_thread_id" terminal
		fi
		cleanup_heartbeat
		log_event "WORKER_INVOCATION_FINISHED task=$task_id session=$session status=$status result=published attempt=$attempt"
		trace_event WORKER_RESULT_PUBLISHED "task_id=$task_id" "session=$session" "attempt=$attempt" "status=$status" "result=$result"
		printf 'Worker completed task %s and published its result.\n' "$task_id"
		exit 0
	fi

	if (( goal_mode == 1 )); then
		goal_iteration_after="$(kv_file_value "$goal_state" iteration_count)"
		if (( goal_iteration_after > goal_iteration_before )); then
			goal_movement="$(kv_file_value "$(goal_continue_marker_file "$task_id")" movement 2>/dev/null || printf unknown)"
			if (( HARNESS_SEMANTIC_CONTINUATION_REVIEW_ENABLED == 1 )); then
				"$HARNESS_BIN/manager-review-goal-continuation" "$HARNESS_ENV_FILE" "$task_id" >/dev/null
				semantic_decision="$(kv_file_value "$goal_state" semantic_decision 2>/dev/null || true)"
				semantic_relation="$(kv_file_value "$goal_state" semantic_relation 2>/dev/null || true)"
				semantic_decision_file="$(kv_file_value "$goal_state" semantic_decision_file 2>/dev/null || true)"
				if [[ "$semantic_decision" == REPLAN ]]; then
					handoff="$PROJECT_TMP_DIR/$base.semantic-replan-handoff.$$"
					{
						printf '# Worker Task Result\n\n'
						printf 'Task-ID: %s\n' "$task_id"
						printf 'Status: COMPLETED\n'
						printf 'Goal-ID: %s\n' "$goal_id"
						printf 'Goal-Outcome: NEEDS_DECOMPOSITION\n'
						emit_synthetic_impact_manifest
						printf '\n'
						printf '## Summary\n\nThe semantic continuation review closed this leaf after iteration %s.\n\n' "$goal_iteration_after"
						printf '## Modified files\n\nWorkspace changes and source commits from completed episodes are preserved for manager inspection.\n\n'
						printf '## Implemented behavior\n\nNo claim beyond the worker continuation receipt is synthesized by the harness.\n\n'
						printf '## Validation performed\n\nSee the durable continuation receipt and semantic decision.\n\n'
						printf '## Deviations from assignment\n\nCriterion relation: %s.\n\n' "$semantic_relation"
						printf '## Remaining concerns\n\nThe manager must revise decomposition before authorizing more implementation work. Decision: %s\n\n' "$semantic_decision_file"
						printf '## Worker assessment\n\nNEEDS_DECOMPOSITION because the proposed next action no longer qualifies as another episode of the same bounded criterion.\n'
					} > "$handoff"
					chmod 600 "$handoff"
					"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$handoff" >/dev/null
					rm -f "$handoff"
					if completion_committed; then
						cleanup_heartbeat
						log_event "WORKER_GOAL_SEMANTIC_REPLAN task=$task_id goal=$goal_id iteration=$goal_iteration_after relation=$semantic_relation decision=$semantic_decision_file"
						printf 'Worker goal %s returned to decomposition after semantic boundary review.\n' "$goal_id"
						exit 0
					fi
					die 'failed to publish semantic-replan handoff'
				fi
				[[ "$semantic_decision" == CONTINUE && "$semantic_relation" == SAME_CRITERION ]] ||
					die 'semantic continuation review did not publish a valid decision'
				worker_resume_thread_id=""
				goal_state_set "$goal_state" thread_context fresh-semantic-episode
				goal_thread_store "$task_id" "" fresh-semantic-episode
				worker_context_mode="fresh"
				worker_context_reason="semantic_episode_boundary"
			fi
			strategy_review="$(kv_file_value "$goal_state" strategy_review_required)"
			context_state="$(kv_file_value "$goal_state" thread_context)"
			if (( HARNESS_DECOMPOSITION_V2 == 1 && goal_iteration_after >= leaf_expected_turns )); then
				handoff="$PROJECT_TMP_DIR/$base.declared-turn-limit-handoff.$$"
				{
					printf '# Worker Task Result\n\n'
					printf 'Task-ID: %s\n' "$task_id"
					printf 'Status: COMPLETED\n'
					printf 'Goal-ID: %s\n' "$goal_id"
					printf 'Goal-Outcome: NEEDS_DECOMPOSITION\n'
					emit_synthetic_impact_manifest
					printf '\n'
					printf '## Summary\n\nThe routed leaf reached its declared maximum of %s durable worker turns without a terminal completion.\n\n' "$leaf_expected_turns"
					printf '## Modified files\n\nWorkspace changes are preserved for independent manager inspection.\n\n'
					printf '## Implemented behavior\n\nNo additional implementation claim is synthesized by the harness.\n\n'
					printf '## Validation performed\n\nSee the assignment, context capsule, JSONL traces, and goal iteration ledger.\n\n'
					printf '## Deviations from assignment\n\nThe leaf exceeded its manager-declared strategy budget.\n\n'
					printf '## Remaining concerns\n\nThe manager must split the leaf further or choose a stronger route with fresh context.\n\n'
					printf '## Worker assessment\n\nNEEDS_DECOMPOSITION due to the enforced routed-leaf turn budget.\n'
				} > "$handoff"
				chmod 600 "$handoff"
				"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$handoff" >/dev/null
				rm -f "$handoff"
				if completion_committed; then
					cleanup_heartbeat
					log_event "WORKER_GOAL_DECLARED_TURN_LIMIT task=$task_id goal=$goal_id route=$worker_route turns=$goal_iteration_after limit=$leaf_expected_turns"
					printf 'Worker goal %s requested decomposition at its declared %s-turn limit.\n' "$goal_id" "$leaf_expected_turns"
					exit 0
				fi
				die 'failed to publish routed-leaf turn-limit handoff'
			fi
			if [[ "$context_state" == rotation-requested ]]; then
				worker_resume_thread_id=""
				goal_state_set "$goal_state" thread_context rotated
				goal_thread_store "$task_id" "" rotated
				worker_context_mode="fresh"
				worker_context_reason="goal_iteration_rotation"
			fi
			printf '\nGoal iteration %s is durably committed with movement=%s. This later episode block supersedes earlier iteration and boundary values in this prompt. Re-read GOAL_SUMMARY_FILE and GOAL_STATE_FILE, use the current durable values there, and continue the same leaf goal from its new boundary in a fresh semantic episode. The next receipt Iteration must be %s. ' \
				"$goal_iteration_after" "$goal_movement" "$((goal_iteration_after + 1))" >> "$prompt_file"
			if [[ "$strategy_review" == 1 ]]; then
				printf 'Repeated materially identical iterations closed CONTINUE. Publish a truthful terminal Goal-Outcome: NEEDS_DECOMPOSITION so the persistent manager can change strategy or append child criteria.\n' >> "$prompt_file"
			else
				printf 'Publish the next CONTINUE receipt or a truthful terminal goal result.\n' >> "$prompt_file"
			fi
			attempt=$((attempt + 1))
			log_event "WORKER_GOAL_RESUMING task=$task_id goal=$goal_id iteration=$goal_iteration_after movement=$goal_movement context=$worker_context_mode"
			trace_event WORKER_GOAL_RESUMING "task_id=$task_id" "goal_id=$goal_id" "iteration=$goal_iteration_after" "movement=$goal_movement" "context=$worker_context_mode"
			continue
		fi
	fi

	retry_kind="$(codex_provider_retry_kind "$classification" 2>/dev/null || true)"
	if [[ -n "$retry_kind" ]]; then
		retry_delay="$(codex_provider_retry_delay "$classification")"
		provider_retries=$((provider_retries + 1))
		[[ "$retry_kind" != quota ]] || quota_waits=$((quota_waits + 1))
		log_event "WORKER_PROVIDER_WAIT task=$task_id session=$session kind=$retry_kind attempt=$attempt retry=$provider_retries delay_seconds=$retry_delay classification=$classification"
		if [[ "$retry_kind" == quota ]]; then
			printf 'Worker task %s has no provider quota; state and heartbeat are preserved. Checking again in %s seconds (quota wait %s).\n' "$task_id" "$retry_delay" "$quota_waits" >&2
		else
			printf 'Worker task %s hit a transient provider/network failure; retrying in %s seconds.\n' "$task_id" "$retry_delay" >&2
		fi
		sleep "$retry_delay"
		attempt=$((attempt + 1))
		log_event "WORKER_PROVIDER_RETRY_STARTED task=$task_id session=$session kind=$retry_kind attempt=$attempt retry=$provider_retries"
		trace_event WORKER_PROVIDER_RETRY "task_id=$task_id" "session=$session" "kind=$retry_kind" "attempt=$attempt" "retry=$provider_retries"
		continue
	fi

	# Terra/GPT-5.6 gets exactly one narrowed retry, then one stable-model
	# fallback for model-layer failures only. Provider, authentication, sandbox,
	# configuration, and protocol failures never enter this branch.
	if codex_model_requires_narrow_prompt "$current_model" && [[ "$classification" == model_refusal_or_blocked_content ]]; then
		if (( fallback_stage == 0 )); then
			fallback_stage=1
			printf '\nRetry scope: perform only the single bounded assignment in TASK_FILE. Do not inspect unrelated directories or broaden the task.\n' >> "$prompt_file"
			attempt=$((attempt + 1))
			log_event "WORKER_TERRA_NARROW_RETRY task=$task_id session=$session classification=$classification"
			continue
		fi
		if (( fallback_stage == 1 )) && [[ "$execution_fallback_model" != "$current_model" ]]; then
			fallback_stage=2
			current_model="$execution_fallback_model"
			if (( HARNESS_DECOMPOSITION_V2 == 1 )) && [[ "$current_model" == "$TERRA_WORKER_MODEL" ]]; then
				execution_role=worker_terra
				execution_mode=TERRA_FALLBACK
			fi
			attempt=$((attempt + 1))
			log_event "WORKER_MODEL_FALLBACK task=$task_id session=$session classification=$classification model=$current_model"
			continue
		fi
	fi

	if (( goal_mode == 1 )); then
		case "$classification" in
			authentication_error|sandbox_denied|configuration_error)
				break
				;;
		esac
		protocol_failures="$(kv_file_value "$goal_state" protocol_failures)"
		[[ "$protocol_failures" =~ ^[0-9]+$ ]] || protocol_failures=0
		protocol_failures=$((protocol_failures + 1))
		goal_state_set "$goal_state" protocol_failures "$protocol_failures"
		if (( protocol_failures < HARNESS_GOAL_MAX_IDENTICAL_ITERATIONS )); then
			printf '\nThe prior goal turn ended without committing either a CONTINUE receipt or terminal result (classification=%s, exit=%s). Preserve the workspace and retry the protocol now. Re-read GOAL_STATE_FILE; do not repeat completed actions.\n' \
				"${classification:-unknown}" "$status" >> "$prompt_file"
			attempt=$((attempt + 1))
			log_event "WORKER_GOAL_PROTOCOL_RETRY task=$task_id goal=$goal_id failures=$protocol_failures classification=${classification:-unknown}"
			continue
		fi

		handoff="$PROJECT_TMP_DIR/$base.goal-protocol-handoff.$$"
		{
			printf '# Worker Task Result\n\n'
			printf 'Task-ID: %s\n' "$task_id"
			printf 'Status: COMPLETED\n'
			printf 'Goal-ID: %s\n' "$goal_id"
			printf 'Goal-Outcome: NEEDS_DECOMPOSITION\n'
			emit_synthetic_impact_manifest
			printf '\n'
			printf '## Summary\n\nThe leaf-goal execution protocol made no durable transition for %s consecutive recoverable turns.\n\n' "$protocol_failures"
			printf '## Modified files\n\nWorkspace changes, if any, are preserved for manager inspection.\n\n'
			printf '## Implemented behavior\n\nNo implementation claim is synthesized by the harness.\n\n'
			printf '## Validation performed\n\nSee the worker JSONL and goal iteration ledger; no unrecorded validation is claimed.\n\n'
			printf '## Deviations from assignment\n\nThe worker failed to publish a valid continuation or terminal receipt.\n\n'
			printf '## Remaining concerns\n\nThe persistent manager should narrow/decompose the criterion or publish a materially different strategy.\n\n'
			printf '## Worker assessment\n\nNEEDS_DECOMPOSITION due to repeated goal protocol failure; this is not a claim that code progress was absent.\n'
		} > "$handoff"
		chmod 600 "$handoff"
		"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$handoff" >/dev/null
		rm -f "$handoff"
		if completion_committed; then
			cleanup_heartbeat
			log_event "WORKER_GOAL_STRATEGY_HANDOFF task=$task_id goal=$goal_id failures=$protocol_failures"
			printf 'Worker goal %s requested manager decomposition after repeated protocol failures.\n' "$goal_id"
			exit 0
		fi
	fi

	break
done

cleanup_heartbeat

if [[ -z "$protocol_reason" ]]; then
	if [[ ! -f "$result" ]]; then
		protocol_reason="result_not_published"
	else
		protocol_reason="completion_state_inconsistent"
	fi
fi

alert="$dir/control/$base.worker-failed.md"
cat > "$alert.tmp.$$" <<ALERT
# Worker Invocation Failed

Project: $PROJECT

Task-ID: $task_id

Session: $session

Environment-File: $HARNESS_ENV_FILE

Failed-At: $(timestamp_utc)

Codex-Exit-Status: $status

Protocol-Reason: $protocol_reason

JSONL-Log: $json_log

Stderr-Log: $stderr_log

Classification: ${classification:-unknown}

Partial-Edits: $(kv_file_value "${json_log%.jsonl}.classification" partial_edits 2>/dev/null || printf unknown)

Attempts: $attempt

Provider-Retries: $provider_retries

Quota-Waits: $quota_waits

The completion transaction is not committed. Provider quota and transient provider/network failures retry indefinitely while preserving task ownership. This failure was classified as terminal, local, configuration/protocol, or an actual agent failure. Inspect the log and filesystem state, then reset, repair, or abort the task explicitly.
ALERT
chmod 600 "$alert.tmp.$$"
mv "$alert.tmp.$$" "$alert"
if (( status == 0 )); then
	log_event "WORKER_PROTOCOL_FAILED task=$task_id session=$session status=$status reason=$protocol_reason attempts=$attempt"
	trace_event WORKER_PROTOCOL_FAILED "task_id=$task_id" "session=$session" "status=$status" "reason=$protocol_reason" "attempts=$attempt" "json_log=$json_log"
else
	log_event "WORKER_PROCESS_FAILED task=$task_id session=$session status=$status reason=$protocol_reason attempts=$attempt"
	trace_event WORKER_PROCESS_FAILED "task_id=$task_id" "session=$session" "status=$status" "reason=$protocol_reason" "attempts=$attempt" "json_log=$json_log"
fi
printf 'Worker invocation failed for task %s; see %s\n' "$task_id" "$alert" >&2
if (( status == 0 )); then
	exit 70
fi
exit "$status"
