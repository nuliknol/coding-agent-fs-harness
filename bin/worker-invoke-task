patch_only_attempt_limit="$HARNESS_PATCH_ONLY_MAX_VALIDATION_ROUNDS"
if (( leaf_expected_turns > 0 && leaf_expected_turns < patch_only_attempt_limit )); then
	patch_only_attempt_limit="$leaf_expected_turns"
fi
patch_last_diagnostic_fingerprint=""
patch_repair_ledger="$dir/control/progress/$base.patch-only-repairs.tsv"
if (( patch_only_execution == 1 )); then
	patch_only_baseline="$($HARNESS_BIN/harness-workspace-fingerprint "$HARNESS_ENV_FILE")"
fi
heartbeat_pid=""

completion_committed()
{
	[[ -f "$result" && ! -e "$running" && ! -e "$lease" && -f "$assignment_archive" ]]
}

waiting_dependency_committed()
{
	[[ -f "$(task_root_waiting_dependency_file "$task_root")" &&
		! -e "$running" && ! -e "$lease" && -f "$assignment_archive" ]]
}

emit_synthetic_impact_manifest()
{
	(( HARNESS_ARCHITECTURE_GUARDS == 1 )) || return 0
	printf 'Changed-Public-Symbols: -\n'
	printf 'Changed-Representations: -\n'
	printf 'Changed-Ownership: -\n'
	printf 'Changed-Serialization: -\n'
	printf 'Changed-Dependencies: -\n'
	printf 'Affected-Invariants: %s\n' "$(require_single_metadata_value "$task_file" Affected-Invariants 'active assignment')"
	printf 'Affected-Edges: %s\n' "$(require_single_metadata_value "$task_file" Edge-Contracts 'active assignment')"
}

# Required closure is a deterministic launch gate for Luna.  Publish a normal
# decomposition handoff so the manager can repair the index/capsule or split
# the node; never spend a worker invocation and never turn an index deficiency
# into NEEDS_HUMAN.
if (( luna_bounded_execution == 1 )) &&
	[[ "$HARNESS_CONTEXT_CLOSURE_MODE" =~ ^(required|patch_only)$ &&
	"$context_closure_status" != READY ]]; then
	if [[ "$HARNESS_ESCALATION_POLICY" == decompose ]]; then
		"$HARNESS_BIN/worker-return-context-repair" "$HARNESS_ENV_FILE" "$task_id" "$session" \
			"$context_closure_condition" "$context_closure_repair_action" \
			"$context_closure_repair_provider" "$context_closure_reason" >/dev/null
		log_event "CONTEXT_CLOSURE_LAUNCH_REJECTED task=$task_id route=$worker_route status=$context_closure_status condition=$context_closure_condition repair_action=$context_closure_repair_action repair_provider=$context_closure_repair_provider reason=$context_closure_reason internal_repair=1"
		printf 'Luna task %s entered internal Context Closure repair before worker launch.\n' "$task_id"
		exit 0
	fi
	closure_handoff="$PROJECT_TMP_DIR/$base.context-closure-handoff.$$"
	{
		printf '# Worker Task Result\n\nTask-ID: %s\nStatus: COMPLETED\n' "$task_id"
		if (( goal_mode == 1 )); then
			if [[ "$context_closure_semantic_split" == 1 ]]; then
				closure_decomposition_reason=TASK_TOO_BROAD
			else
				closure_decomposition_reason=CONTEXT_INCOMPLETE
			fi
			printf 'Goal-ID: %s\nGoal-Outcome: NEEDS_DECOMPOSITION\nDecomposition-Reason: %s\n' "$goal_id" "$closure_decomposition_reason"
		fi
		printf 'Closure-Condition: %s\nClosure-Repair-Action: %s\nClosure-Repair-Provider: %s\n' \
			"$context_closure_condition" "$context_closure_repair_action" "$context_closure_repair_provider"
		emit_synthetic_impact_manifest
		printf '\n## Summary\n\nThe Luna worker was not launched because its required Context Closure is %s (%s).\n' "$context_closure_status" "$context_closure_reason"
		printf '\n## Modified files\n\nNone.\n\n## Implemented behavior\n\nNone; deterministic admission stopped before inference.\n'
		printf '\n## Validation performed\n\nContext Closure manifest and unresolved ledger only.\n'
		printf '\n## Deviations from assignment\n\nNo worker execution occurred.\n'
		printf '\n## Remaining concerns\n\nPerform typed closure repair action %s through %s; do not retry the unchanged worker context.\n' \
			"$context_closure_repair_action" "$context_closure_repair_provider"
		printf '\n## Worker assessment\n\nNEEDS_DECOMPOSITION due to deterministic Context Closure admission failure, not a product decision.\n'
	} > "$closure_handoff"
	chmod 600 "$closure_handoff"
	"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$closure_handoff" >/dev/null
	rm -f "$closure_handoff"
	log_event "CONTEXT_CLOSURE_LAUNCH_REJECTED task=$task_id route=$worker_route status=$context_closure_status condition=$context_closure_condition repair_action=$context_closure_repair_action repair_provider=$context_closure_repair_provider reason=$context_closure_reason"
	printf 'Luna task %s returned to decomposition before worker launch.\n' "$task_id"
	exit 0
fi

# Admission above handles ordinary incomplete closures. Reaching this boundary
# without the compiled capsule is a harness-integrity failure, not another
# worker condition to retry.
if (( luna_bounded_execution == 1 )) && [[ "$HARNESS_CONTEXT_CLOSURE_MODE" =~ ^(required|patch_only)$ ]] &&
	{ [[ "$context_closure_status" != READY ]] || [[ -z "$compiled_context_closure_file" ]] ||
		[[ ! -s "$compiled_context_closure_file" ]]; }; then
	mark_project_integrity_anomaly CLOSURE_BYPASS "$task_id" \
		'bounded Luna execution reached the provider boundary without a validated compiled Context Closure capsule' \
		"mode=$HARNESS_CONTEXT_CLOSURE_MODE status=$context_closure_status file=${compiled_context_closure_file:--} manifest=${closure_manifest:--}" >/dev/null
	die 'PROJECT_INTEGRITY_ANOMALY: refusing Luna launch without validated compiled context'
fi

publish_goal_decomposition_handoff()
{
	local reason="$1" concern="$2" handoff classification_file partial_edits workspace_before workspace_after
	classification_file="${json_log%.jsonl}.classification"
	partial_edits="$(kv_file_value "$classification_file" partial_edits 2>/dev/null || printf 0)"
	workspace_before="$(kv_file_value "$classification_file" workspace_fingerprint_before 2>/dev/null || printf -)"
	workspace_after="$(kv_file_value "$classification_file" workspace_fingerprint_after 2>/dev/null || printf -)"
	handoff="$PROJECT_TMP_DIR/$base.goal-decomposition-handoff.$$"
	{
		printf '# Worker Task Result\n\n'
		printf 'Task-ID: %s\n' "$task_id"
		printf 'Status: COMPLETED\n'
		printf 'Goal-ID: %s\n' "$goal_id"
		printf 'Goal-Outcome: NEEDS_DECOMPOSITION\n'
		if [[ "${resource_guard:--}" == - ]]; then
			printf 'Decomposition-Reason: TASK_TOO_BROAD\n'
		else
			printf 'Decomposition-Reason: RESOURCE_LIMIT\n'
		fi
		# Preserve the machine reason for a synthetic handoff. Without this
		# manager review cannot distinguish an exhausted execution context
		# from a repository-local prerequisite.
		printf 'Resource-Guard: %s\n' "${resource_guard:--}"
		printf 'Workspace-Changed: %s\n' "$partial_edits"
		printf 'Workspace-Fingerprint-Before: %s\n' "$workspace_before"
		printf 'Workspace-Fingerprint-After: %s\n' "$workspace_after"
		emit_synthetic_impact_manifest
		printf '\n'
		printf '## Summary\n\n%s\n\n' "$reason"
		printf '## Modified files\n\nAll workspace changes and source commits produced before the episode closed are preserved for independent manager inspection.\n\n'
		printf '## Implemented behavior\n\nNo implementation claim is synthesized by the harness.\n\n'
		printf '## Validation performed\n\nSee the preserved JSONL, command evidence, assignment, and goal ledger.\n\n'
		printf '## Deviations from assignment\n\nThe current semantic episode ended before terminal acceptance.\n\n'
		printf '## Remaining concerns\n\n%s\n\n' "$concern"
		printf '## Worker assessment\n\nNEEDS_DECOMPOSITION; use fresh context and preserve any independently verified increment.\n'
	} > "$handoff"
	chmod 600 "$handoff"
	"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$handoff" >/dev/null
	rm -f "$handoff"
	completion_committed
}

normalize_direct_result()
{
	local normalize_status
	if [[ -f "$result" && -f "$running" && -f "$lease" && ! -e "$assignment_archive" ]]; then
		mv "$result" "$staged_result"
		set +e
		"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$staged_result" >/dev/null
		normalize_status=$?
		set -e
		if (( normalize_status == 0 )); then
			rm -f "$staged_result"
			log_event "WORKER_DIRECT_RESULT_NORMALIZED task=$task_id session=$session"
		else
			if (( goal_mode == 1 )) && [[ -f "$staged_result" ]]; then
				invalid_direct="$dir/control/$base.invalid-direct-result-attempt-$attempt.md"
				mv "$staged_result" "$invalid_direct"
				log_event "WORKER_GOAL_INVALID_DIRECT_RESULT task=$task_id session=$session file=$invalid_direct"
			elif [[ ! -e "$result" && -f "$staged_result" ]]; then
				mv "$staged_result" "$result"
			fi
			protocol_reason="direct_result_normalization_failed:$normalize_status"
		fi
	fi
}

normalize_last_message_result()
{
	local normalize_status
	if (( status == 0 )) &&
		[[ -s "$last_message" && ! -f "$result" && -f "$running" && -f "$lease" && ! -e "$assignment_archive" ]]; then
		if (( goal_mode == 1 )) &&
			! grep -Eq '^Goal-Outcome:[[:space:]]*(COMPLETE|NEEDS_DECOMPOSITION|HARD_BLOCKED)[[:space:]]*$' "$last_message"; then
			return 0
		fi
		set +e
		"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$last_message" >/dev/null
		normalize_status=$?
		set -e
		if (( normalize_status == 0 )); then
			log_event "WORKER_LAST_MESSAGE_RESULT_NORMALIZED task=$task_id session=$session"
		else
			protocol_reason="last_message_result_normalization_failed:$normalize_status"
		fi
	fi
}

prepare_typed_context_expansion()
{
	local response="$1" kind identifier reason pointer generation_dir extension_dir extension_file
	local resolver_output resolver_status request_number acp_thread acp_request acp_status
	local workspace_before workspace_after total_added_bytes
	context_expansion_pending=0
	[[ -s "$response" ]] || return 1
	[[ "$(grep -Ec '^Context-Request-Kind:[[:space:]]*' "$response" || true)" == 1 ]] || return 1
	[[ "$(grep -Ec '^Context-Request-Identifier:[[:space:]]*' "$response" || true)" == 1 ]] || return 1
	[[ "$(grep -Ec '^```(diff|patch)[[:space:]]*$' "$response" || true)" == 0 ]] || return 1
	kind="$(sed -n 's/^Context-Request-Kind:[[:space:]]*//p' "$response")"
	identifier="$(sed -n 's/^Context-Request-Identifier:[[:space:]]*//p' "$response")"
	reason="$(sed -n 's/^Context-Request-Reason:[[:space:]]*//p' "$response" | head -n 1)"
	reason="$(tr '\t\r\n' '   ' <<< "${reason:-decisive implementation fact is absent from the compiled capsule}" | head -c 256)"
	case "$kind" in
		TYPE_DEFINITION|SYMBOL_DEFINITION|CALLER_CONTRACT|CALLEE_CONTRACT|FAILING_ASSERTION|TEST_TARGET|TEST_OWNER|BUILD_TARGET|BUILD_OWNER|OWNER|PRODUCER|CONSUMER|REPRESENTATION_WRITER) ;;
		*) return 1 ;;
	esac
	if (( context_expansion_count >= HARNESS_MAX_CONTEXT_EXPANSIONS_PER_LEAF )); then
		patch_apply_output="typed Context Closure expansion limit reached ($context_expansion_count/$HARNESS_MAX_CONTEXT_EXPANSIONS_PER_LEAF)"
		return 2
	fi
	pointer="$(repository_index_project_pointer_file)"
	repository_index_project_pointer_is_current || {
		patch_apply_output="typed Context Closure request rejected: repository index is not current ($REPOSITORY_INDEX_POINTER_REASON)"
		return 2
	}
	generation_dir="$(kv_file_value "$pointer" generation_dir)"
	request_number="$((context_expansion_count + 1))"
	if (( request_number > HARNESS_ACP_MAX_REQUESTS_PER_LEAF )); then
		patch_apply_output="ACP request count fuse reached ($request_number/$HARNESS_ACP_MAX_REQUESTS_PER_LEAF)"
		mark_task_resource_anomaly "$task_id" ACP_REQUEST_AMPLIFICATION "$patch_apply_output" \
			"kind=$kind identifier=$identifier" >/dev/null
		return 2
	fi
	extension_dir="$closure_path/extensions"
	extension_file="$extension_dir/request-$(printf '%03d' "$request_number").md"
	acp_thread="${observed_thread_id:-${worker_resume_thread_id:-$session}}"
	workspace_before="$(acp_workspace_fingerprint "$task_file")"
	set +e
	acp_request="$(acp_publish_request "$task_id" "$acp_thread" "$request_number" CONTEXT \
		"$kind" "$identifier" "$reason" "$task_file" - 2>&1)"
	acp_status=$?
	set -e
	if (( acp_status != 0 )) || [[ ! -f "$acp_request" ]]; then
		patch_apply_output="ACP context request rejected before resolution: $(tr '\n' ' ' <<< "$acp_request" | head -c 512)"
		return 2
	fi
	acp_event_append "$(metadata_value "$acp_request" Request-ID)" "$task_id" "$acp_thread" \
		"$request_number" BROKER_STARTED CONTEXT "$kind" - \
		"initial_context_bytes=$(du -sb "$closure_path" 2>/dev/null | awk '{print $1 + 0}') identifier=$identifier"
	set +e
	resolver_output="$(python3 "$HARNESS_HOME/tools/resolve_context_request.py" \
		--assignment "$task_file" --closure "$closure_path/closure.tsv" \
		--database "$generation_dir/architecture.sqlite" --repository "$REPOSITORY" \
		--request-kind "$kind" --identifier "$identifier" --output "$extension_file" \
		--max-bytes "$HARNESS_CONTEXT_EXPANSION_MAX_BYTES" 2>&1)"
	resolver_status=$?
	set -e
	if (( resolver_status != 0 )) || [[ ! -s "$extension_file" ]]; then
		patch_apply_output="typed Context Closure request rejected: $(tr '\n' ' ' <<< "$resolver_output" | head -c 512)"
		acp_resolve_request "$acp_request" DENIED deterministic-context-broker - "$patch_apply_output" >/dev/null
		acp_write_metrics
		log_event "CONTEXT_EXPANSION_REJECTED task=$task_id kind=$kind identifier=$(printf '%q' "$identifier") reason=$(printf '%q' "$reason") resolver_status=$resolver_status resolver=$(printf '%q' "$resolver_output")"
		return 2
	fi
	workspace_after="$(acp_workspace_fingerprint "$task_file")"
	if [[ "$workspace_after" != "$workspace_before" ]]; then
		patch_apply_output='ACP context request became stale while deterministic evidence was compiled'
		acp_resolve_request "$acp_request" DENIED deterministic-context-broker - "$patch_apply_output" >/dev/null
		mark_project_integrity_anomaly ACP_STALE_AUTHORITY "$task_id" "$patch_apply_output" \
			"before=$workspace_before after=$workspace_after request=$acp_request" >/dev/null
		return 2
	fi
	total_added_bytes="$(find "$extension_dir" -maxdepth 1 -type f -name 'request-*.md' -printf '%s\n' 2>/dev/null | awk '{sum += $1} END {print sum + 0}')"
	if (( total_added_bytes > HARNESS_ACP_MAX_TOTAL_ADDED_BYTES )); then
		patch_apply_output="ACP context amplification fuse reached ($total_added_bytes/$HARNESS_ACP_MAX_TOTAL_ADDED_BYTES bytes)"
		acp_resolve_request "$acp_request" DENIED deterministic-context-broker "$extension_file" "$patch_apply_output" >/dev/null
		mark_task_resource_anomaly "$task_id" CONTEXT_AMPLIFICATION "$patch_apply_output" \
			"request=$acp_request extension=$extension_file" >/dev/null
		return 2
	fi
	acp_resolve_request "$acp_request" GRANTED deterministic-context-broker "$extension_file" \
		"bounded indexed evidence; added_bytes=$(stat -c %s "$extension_file") total_added_bytes=$total_added_bytes" >/dev/null
	acp_write_metrics
	context_expansion_count="$request_number"
	context_followup_prompt="$PROJECT_TMP_DIR/$base.context-followup-$request_number.md"
	{
		if (( patch_only_execution == 1 )); then
			printf 'The trusted harness accepted typed Context Closure request %s of %s. Use only the extension below plus the prior thread context. Do not use tools or request the same fact again. Produce the required single fenced Git diff and normal terminal result metadata. If another decisive fact is absent, you may use the same typed request protocol within the remaining expansion budget.\n\n' \
				"$request_number" "$HARNESS_MAX_CONTEXT_EXPANSIONS_PER_LEAF"
		else
			printf 'The deterministic broker accepted typed Context Closure request %s of %s. Use the exact extension below plus the prior thread context. Do not repeat the request or compensate with repository-wide exploration. Continue the same bounded task and publish its normal result, or request one other exact decisive fact within the remaining budget.\n\n' \
				"$request_number" "$HARNESS_MAX_CONTEXT_EXPANSIONS_PER_LEAF"
		fi
		cat "$extension_file"
	} > "$context_followup_prompt.tmp.$$"
	chmod 600 "$context_followup_prompt.tmp.$$"
	mv "$context_followup_prompt.tmp.$$" "$context_followup_prompt"
	context_expansion_pending=1
	followup_reason=context_extension
	log_event "CONTEXT_EXPANSION_READY task=$task_id kind=$kind identifier=$(printf '%q' "$identifier") reason=$(printf '%q' "$reason") count=$context_expansion_count extension=$extension_file resolver=$(printf '%q' "$resolver_output") acp=1"
	return 0
}

publish_context_request_rejection_handoff()
{
	local detail="$1" handoff
	handoff="$PROJECT_TMP_DIR/$base.context-request-rejected.$$"
	{
		printf '# Worker Task Result\n\nTask-ID: %s\nStatus: COMPLETED\n' "$task_id"
		if (( goal_mode == 1 )); then
			printf 'Goal-ID: %s\nGoal-Outcome: NEEDS_DECOMPOSITION\nDecomposition-Reason: CONTEXT_INCOMPLETE\n' "$goal_id"
		fi
		emit_synthetic_impact_manifest
		printf '\n## Summary\n\nThe deterministic Context Broker could not authorize or bound the requested fact.\n'
		printf '\n## Modified files\n\nNo implementation claim is made by this protocol transition.\n'
		printf '\n## Implemented behavior\n\nNone beyond any independently committed task-owned increment.\n'
		printf '\n## Validation performed\n\nACP envelope, index currency, graph adjacency, and evidence limits were checked.\n'
		printf '\n## Deviations from assignment\n\nThe worker stopped instead of exploring outside the compiled context.\n'
		printf '\n## Remaining concerns\n\n%s\n' "$detail"
		printf '\n## Worker assessment\n\nNEEDS_DECOMPOSITION (CONTEXT_INCOMPLETE); repair the capsule or split the leaf.\n'
	} > "$handoff"
	chmod 600 "$handoff"
	"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$handoff" >/dev/null
	rm -f "$handoff"
}

normalize_patch_only_result_metadata()
{
	local response="$1" normalized
	[[ -f "$response" ]] || return 0
	normalized="$response.metadata-normalized.$$"
	# Markdown authors commonly add two trailing spaces for a visual line break.
	# Machine metadata is exact and must not inherit that presentation syntax.
	# Match only control keys at column zero so patch payload lines are untouched.
	sed -E '/^(Task-ID|Status|Goal-ID|Goal-Outcome|Decomposition-Reason|Changed-Public-Symbols|Changed-Representations|Changed-Ownership|Changed-Serialization|Changed-Dependencies|Affected-Invariants|Affected-Edges):/ s/[[:space:]]+$//' \
		"$response" > "$normalized"
	chmod --reference="$response" "$normalized"
	mv "$normalized" "$response"
}

prepare_structural_acp_handoff()
{
	local response="$1" type kind identifier reason acp_thread request_path request_status
	local sequence outcome handoff existing_count structural_deferred_count acp_request_id
	(( HARNESS_ACP_ENABLED == 1 )) || return 1
	[[ -s "$response" && -f "$running" && -f "$lease" ]] || return 1
	[[ "$(grep -Ec '^ACP-Request-Type:[[:space:]]*' "$response" || true)" == 1 ]] || return 1
	[[ "$(grep -Ec '^ACP-Request-Kind:[[:space:]]*' "$response" || true)" == 1 ]] || return 1
	[[ "$(grep -Ec '^ACP-Request-Identifier:[[:space:]]*' "$response" || true)" == 1 ]] || return 1
	[[ "$(grep -Ec '^ACP-Request-Reason:[[:space:]]*' "$response" || true)" == 1 ]] || return 1
	[[ "$(grep -Ec '^```(diff|patch)[[:space:]]*$' "$response" || true)" == 0 ]] || return 1
	type="$(sed -n 's/^ACP-Request-Type:[[:space:]]*//p' "$response")"
	kind="$(sed -n 's/^ACP-Request-Kind:[[:space:]]*//p' "$response")"
	identifier="$(sed -n 's/^ACP-Request-Identifier:[[:space:]]*//p' "$response")"
	reason="$(sed -n 's/^ACP-Request-Reason:[[:space:]]*//p' "$response")"
	case "$type" in SCOPE|PREREQUISITE|SPLIT|CHALLENGE|CANCEL) ;; *) return 1 ;; esac
	kind="$(tr '\t\r\n' '   ' <<< "$kind" | head -c 256)"
	identifier="$(tr '\t\r\n' '   ' <<< "$identifier" | head -c 256)"
	reason="$(tr '\t\r\n' '   ' <<< "$reason" | head -c 256)"
	ensure_acp_state
	existing_count="$(awk -F '\t' -v task="$task_id" '!/^#/ && $4 == task && $7 == "REQUESTED" {count++} END {print count + 0}' "$(acp_events_file)" 2>/dev/null || printf 0)"
	if (( existing_count >= HARNESS_ACP_MAX_REQUESTS_PER_LEAF )); then
		mark_task_resource_anomaly "$task_id" ACP_REQUEST_AMPLIFICATION \
			"ACP request count fuse reached ($existing_count/$HARNESS_ACP_MAX_REQUESTS_PER_LEAF)" \
			"type=$type kind=$kind identifier=$identifier" >/dev/null
		return 2
	fi
	structural_deferred_count="$(awk -F '\t' -v task="$task_id" '!/^#/ && $4 == task && $7 == "DEFERRED" && $8 != "CONTEXT" {count++} END {print count + 0}' "$(acp_events_file)")"
	if (( structural_deferred_count >= HARNESS_ACP_MAX_NO_PROGRESS_REQUESTS )); then
		mark_task_resource_anomaly "$task_id" ACP_NO_PROGRESS_LOOP \
			"structural ACP requests without an accepted facet reached the investigation fuse ($structural_deferred_count/$HARNESS_ACP_MAX_NO_PROGRESS_REQUESTS)" \
			"type=$type kind=$kind identifier=$identifier" >/dev/null
		return 2
	fi
	sequence="$((existing_count + 1))"
	acp_thread="${observed_thread_id:-${worker_resume_thread_id:-$session}}"
	set +e
	request_path="$(acp_publish_request "$task_id" "$acp_thread" "$sequence" "$type" "$kind" \
		"$identifier" "$reason" "$task_file" - 2>&1)"
	request_status=$?
	set -e
	if (( request_status != 0 )) || [[ ! -f "$request_path" ]]; then
		log_event "ACP_STRUCTURAL_REQUEST_REJECTED task=$task_id type=$type kind=$(printf '%q' "$kind") status=$request_status detail=$(printf '%q' "$request_path")"
		return 2
	fi
	case "$type" in
		SCOPE) outcome=SCOPE_INCOMPLETE ;;
		PREREQUISITE) outcome=VALIDATION_PREREQUISITE ;;
		SPLIT) outcome=TASK_TOO_BROAD ;;
		CHALLENGE|CANCEL) outcome=HARD_BLOCKED ;;
	esac
	acp_request_id="$(metadata_value "$request_path" Request-ID)"
	acp_resolve_request "$request_path" DEFERRED persistent-manager - \
		"worker claim requires authority/decomposition adjudication; outcome=$outcome" >/dev/null
	acp_register_suspension "$acp_request_id" "$task_id" "$acp_thread" "$type" "$kind" "$identifier"
	acp_write_metrics
	if (( goal_mode == 1 )) && [[ "$acp_thread" =~ ^[A-Za-z0-9-]+$ ]]; then
		goal_state_set "$goal_state" thread_id "$acp_thread"
		goal_thread_store "$task_id" "$acp_thread" acp-suspended
	fi
	handoff="$PROJECT_TMP_DIR/$base.acp-handoff.$$"
	{
		printf '# Worker Task Result\n\nTask-ID: %s\nStatus: COMPLETED\n' "$task_id"
		if (( goal_mode == 1 )); then
			if [[ "$outcome" == HARD_BLOCKED ]]; then
				printf 'Goal-ID: %s\nGoal-Outcome: HARD_BLOCKED\n' "$goal_id"
			else
				printf 'Goal-ID: %s\nGoal-Outcome: NEEDS_DECOMPOSITION\nDecomposition-Reason: %s\n' "$goal_id" "$outcome"
			fi
		fi
		printf 'ACP-Request-Type: %s\nACP-Request-Kind: %s\nACP-Request-Identifier: %s\nACP-Request-Reason: %s\n' \
			"$type" "$kind" "$identifier" "$reason"
		printf 'ACP-Request-ID: %s\n' "$acp_request_id"
		emit_synthetic_impact_manifest
		printf '\n## Summary\n\nLuna discovered a typed %s boundary and exited without broadening its authority.\n' "$type"
		printf '\n## Modified files\n\nNo additional claim is made by this protocol transition.\n'
		printf '\n## Implemented behavior\n\nAny already committed task-owned increment is preserved; the requested boundary remains ungranted.\n'
		printf '\n## Validation performed\n\nThe harness validated the ACP envelope, assignment/workspace fingerprint, duplicate fuse, and authority route.\n'
		printf '\n## Deviations from assignment\n\nNone authorized. The worker stopped at the discovered boundary.\n'
		printf '\n## Remaining concerns\n\nThe persistent manager must substantiate or deny `%s`, then append only the necessary criterion/edge or revised scope.\n' "$identifier"
		printf '\n## Worker assessment\n\nNEEDS_DECOMPOSITION (%s); this is a negotiated suspension, not permission to explore or escalate models.\n' "$outcome"
	} > "$handoff"
	chmod 600 "$handoff"
	"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$handoff" >/dev/null
	rm -f "$handoff"
	log_event "ACP_STRUCTURAL_REQUEST_COMMITTED task=$task_id type=$type kind=$(printf '%q' "$kind") identifier=$(printf '%q' "$identifier") outcome=$outcome thread_id=$acp_thread"
	return 0
}

heartbeat_loop()
{
	while true; do
		sleep "$WORKER_HEARTBEAT_SECONDS"
		"$HARNESS_BIN/worker-heartbeat" "$HARNESS_ENV_FILE" "$task_id" "$session" >/dev/null 2>&1 || break
	done
}

cleanup_heartbeat()
{
	if [[ -n "$heartbeat_pid" ]]; then
		kill "$heartbeat_pid" 2>/dev/null || true
		wait "$heartbeat_pid" 2>/dev/null || true
		heartbeat_pid=""
	fi
}
trap cleanup_heartbeat EXIT
trap 'cleanup_heartbeat; exit 130' INT
trap 'cleanup_heartbeat; exit 143' TERM

heartbeat_loop &
heartbeat_pid=$!
trace_event WORKER_HEARTBEAT_STARTED "task_id=$task_id" "session=$session" "heartbeat_pid=$heartbeat_pid" "interval=$WORKER_HEARTBEAT_SECONDS"

while true; do
	context_expansion_pending=0
	followup_reason=""
	if (( pending_semantic_review == 1 )); then
		"$HARNESS_BIN/manager-review-goal-continuation" "$HARNESS_ENV_FILE" "$task_id" >/dev/null
		semantic_decision="$(kv_file_value "$goal_state" semantic_decision 2>/dev/null || true)"
		semantic_relation="$(kv_file_value "$goal_state" semantic_relation 2>/dev/null || true)"
		semantic_decision_file="$(kv_file_value "$goal_state" semantic_decision_file 2>/dev/null || true)"
		if [[ "$semantic_decision" == REPLAN ]]; then
			if publish_goal_decomposition_handoff \
				"Recovery found an unreviewed durable continuation from an earlier worker episode; semantic review returned it to decomposition." \
				"Criterion relation: $semantic_relation. Decision: $semantic_decision_file"; then
				cleanup_heartbeat
				log_event "WORKER_GOAL_RECOVERED_SEMANTIC_REPLAN task=$task_id goal=$goal_id iteration=$(kv_file_value "$goal_state" iteration_count) relation=$semantic_relation decision=$semantic_decision_file"
				printf 'Recovered worker goal %s returned to decomposition after semantic review.\n' "$goal_id"
				exit 0
			fi
			die 'failed to publish recovered semantic-replan handoff'
		fi
		[[ "$semantic_decision" == CONTINUE && "$semantic_relation" == SAME_CRITERION ]] ||
			die 'recovered semantic continuation review did not publish a valid decision'
		worker_resume_thread_id=""
		worker_context_mode=fresh
		worker_context_reason=semantic_episode_recovery
		pending_semantic_review=0
		log_event "WORKER_GOAL_RECOVERED_CONTINUATION_APPROVED task=$task_id goal=$goal_id iteration=$(kv_file_value "$goal_state" iteration_count)"
	fi
	goal_iteration_before=0
	if (( goal_mode == 1 )); then
		goal_iteration_before="$(kv_file_value "$goal_state" iteration_count)"
	fi
	stamp="$(date -u '+%Y%m%dT%H%M%SZ')"
	attempt_label="$(printf '%03d' "$attempt")"
	json_log="$dir/logs/worker-task-$task_id-$stamp-attempt-$attempt_label.jsonl"
	stderr_log="$dir/logs/worker-task-$task_id-$stamp-attempt-$attempt_label.stderr.log"
	last_message="$dir/logs/worker-task-$task_id-$stamp-attempt-$attempt_label.md"
	invocation_prompt_file="${context_followup_prompt:-$prompt_file}"

	log_event "WORKER_INVOCATION_STARTED task=$task_id session=$session model=$current_model execution_mode=$execution_mode attempt=$attempt"
	trace_event WORKER_INVOCATION_ATTEMPT "task_id=$task_id" "session=$session" "attempt=$attempt" "execution_mode=$execution_mode" "thread_id=${worker_resume_thread_id:-}" "json_log=$json_log" "last_message=$last_message"
	set +e
	trace_event CODEX_EXEC_START "role=$execution_role" "task_id=$task_id" "session=$session" "attempt=$attempt" "mode=$([[ -n "$worker_resume_thread_id" ]] && printf resume || printf fresh)" "thread_id=${worker_resume_thread_id:-}" "json_log=$json_log" "stderr_log=$stderr_log" "last_message=$last_message" "model=$current_model"
	resume_args=()
	[[ -z "$worker_resume_thread_id" ]] || resume_args=(resume "$worker_resume_thread_id")
	HARNESS_CODEX_STOP_FILE="$(task_root_waiting_dependency_file "$task_root")" \
		"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" "$execution_role" "$current_model" "$invocation_prompt_file" "$json_log" "$stderr_log" "$last_message" "${resume_args[@]}"
	status=$?
	set -e
	observed_thread_id="$(codex_thread_id_from_jsonl "$json_log" 2>/dev/null || true)"
	if (( status == 0 && luna_bounded_execution == 1 )); then
		structural_acp_status=1
		if prepare_structural_acp_handoff "$last_message"; then
			structural_acp_status=0
		else
			structural_acp_status=$?
		fi
		if (( structural_acp_status == 0 )); then
			cleanup_heartbeat
			printf 'Worker task %s published a typed ACP boundary and released its Luna process.\n' "$task_id"
			exit 0
		elif (( structural_acp_status == 2 )); then
			cleanup_heartbeat
			exit 75
		fi
	fi
	if (( status == 0 && luna_bounded_execution == 1 )) &&
		{ [[ "$HARNESS_CONTEXT_CLOSURE_MODE" == required ]] ||
			{ [[ "$HARNESS_CONTEXT_CLOSURE_MODE" == patch_only ]] && (( patch_only_execution == 0 )); }; }; then
		required_context_status=1
		if prepare_typed_context_expansion "$last_message"; then
			required_context_status=0
		else
			required_context_status=$?
		fi
		if (( required_context_status == 2 )); then
			publish_context_request_rejection_handoff "$patch_apply_output"
			cleanup_heartbeat
			printf 'Worker task %s returned a denied ACP context request to decomposition.\n' "$task_id"
			exit 0
		fi
	fi
	if (( status == 0 && luna_bounded_execution == 1 && patch_only_execution == 1 )); then
		context_request_status=1
		zero_file_verification_handled=0
		# Call in a conditional so every nonzero typed-resolver outcome is data
		# for the patch-only state machine, never an errexit from the worker
		# transaction. Rejected extensions must synthesize a durable
		# CONTEXT_INCOMPLETE result below instead of orphaning the running task.
		if prepare_typed_context_expansion "$last_message"; then
			context_request_status=0
		else
			context_request_status=$?
		fi
		if (( context_request_status == 0 )) &&
			(( attempt >= patch_only_attempt_limit )); then
			context_expansion_pending=0
			context_request_status=2
			patch_apply_status=3
			patch_apply_output="typed Context Closure extension was compiled, but the leaf exhausted its $patch_only_attempt_limit total Luna inference turns before a bounded resume"
		elif (( context_request_status == 0 )) &&
			[[ ! "$observed_thread_id" =~ ^[A-Za-z0-9-]+$ ]] &&
			[[ ! "$worker_resume_thread_id" =~ ^[A-Za-z0-9-]+$ ]]; then
			context_expansion_pending=0
			context_request_status=2
			patch_apply_status=3
			patch_apply_output='typed Context Closure extension was compiled, but the Luna thread identifier was unavailable for a bounded resume'
		fi
		if (( context_request_status == 0 )); then
			:
		elif (( context_request_status == 2 )); then
			patch_apply_status=3
		elif [[ "$leaf_type" == VERIFICATION_ONLY && "$expected_implementation_files" == 0 ]] &&
			! grep -Eq '^@@[[:space:]]' "$last_message"; then
			# A zero-file verification leaf proves an already-present increment. Luna
			# may emit no diff (or an empty diff header); requiring a synthetic source
			# mutation turns successful verification into an endless decomposition
			# loop. The trusted harness, not Luna's prose, decides the outcome by
			# checking the unchanged baseline and running the focused validator.
			zero_file_validation_capture="$dir/logs/patch-only-validation-$task_id-$stamp.log"
			zero_file_workspace="$($HARNESS_BIN/harness-workspace-fingerprint "$HARNESS_ENV_FILE")"
			zero_file_validation_status=1
			if [[ "$zero_file_workspace" == "$patch_only_baseline" ]]; then
				set +e
				"$HARNESS_BIN/harness-run-assigned-validation" "$HARNESS_ENV_FILE" "$task_id" patch-only-verification > "$zero_file_validation_capture" 2>&1
				zero_file_validation_status=$?
				set -e
			fi
			if (( zero_file_validation_status == 0 )); then
				{
					printf '# Worker Task Result\n\nTask-ID: %s\nStatus: COMPLETED\n' "$task_id"
					if (( goal_mode == 1 )); then printf 'Goal-ID: %s\nGoal-Outcome: COMPLETE\n' "$goal_id"; fi
					emit_synthetic_impact_manifest
					printf '\n## Summary\n\nThe trusted focused validator passed for the zero-file verification leaf.\n'
					printf '\n## Modified files\n\nNone; this leaf verifies an already-preserved increment.\n'
					printf '\n## Implemented behavior\n\nThe assigned existing behavior is verified without a new source mutation.\n'
					printf '\n## Validation performed\n\nTrusted validation passed; complete output is retained at `%s`.\n' "$zero_file_validation_capture"
					printf '\n## Deviations from assignment\n\nNone.\n\n## Remaining concerns\n\nNone for this bounded verification criterion.\n'
					printf '\n## Worker assessment\n\nCOMPLETE based on trusted harness validation, not model assertion.\n'
				} > "$last_message"
				log_event "PATCH_ONLY_ZERO_FILE_VERIFICATION_PASSED task=$task_id validation=$zero_file_validation_capture"
			else
				{
					printf '# Worker Task Result\n\nTask-ID: %s\nStatus: COMPLETED\n' "$task_id"
					if (( goal_mode == 1 )); then printf 'Goal-ID: %s\nGoal-Outcome: NEEDS_DECOMPOSITION\nDecomposition-Reason: VALIDATION_PREREQUISITE\n' "$goal_id"; fi
					emit_synthetic_impact_manifest
					printf '\n## Summary\n\nThe trusted focused validator did not confirm the zero-file verification leaf.\n'
					printf '\n## Modified files\n\nNone.\n\n## Implemented behavior\n\nNo new implementation was authorized.\n'
					printf '\n## Validation performed\n\nSee `%s`.\n' "$zero_file_validation_capture"
					printf '\n## Deviations from assignment\n\nThe preserved behavior did not satisfy focused validation.\n'
					printf '\n## Remaining concerns\n\nDecompose at the exact failing validation boundary.\n'
					printf '\n## Worker assessment\n\nNEEDS_DECOMPOSITION without an invented patch.\n'
				} > "$last_message"
				log_event "PATCH_ONLY_ZERO_FILE_VERIFICATION_FAILED task=$task_id validation=$zero_file_validation_capture baseline_match=$([[ "$zero_file_workspace" == "$patch_only_baseline" ]] && printf 1 || printf 0)"
			fi
			zero_file_verification_handled=1
			patch_apply_status=0
		elif ! grep -Eq '^```(diff|patch)[[:space:]]*$' "$last_message"; then
			patch_apply_status=3
			patch_apply_output='patch-only response omitted the required single fenced Git diff'
		else
		set +e
		patch_apply_output="$($HARNESS_BIN/harness-apply-worker-patch "$HARNESS_ENV_FILE" "$task_id" "$session" "$last_message" "$patch_only_baseline" 2>&1)"
		patch_apply_status=$?
		set -e
		fi
		if (( zero_file_verification_handled == 1 )); then
			:
		elif (( context_expansion_pending == 1 )); then
			:
		elif (( patch_apply_status == 0 )); then
			patch_file="$(sed -n 's/^PATCH=//p' <<< "$patch_apply_output" | tail -n 1)"
			patch_paths_file="$(sed -n 's/^PATHS=//p' <<< "$patch_apply_output" | tail -n 1)"
			patch_validation_capture="$dir/logs/patch-only-validation-$task_id-$stamp.log"
			set +e
			"$HARNESS_BIN/harness-run-assigned-validation" "$HARNESS_ENV_FILE" "$task_id" patch-only > "$patch_validation_capture" 2>&1
			patch_validation_status=$?
			set -e
			patch_validation_round=$((patch_validation_round + 1))
			if (( patch_validation_status == 0 )); then
				mapfile -t patch_paths < "$patch_paths_file"
				patch_effective_workspace="$($HARNESS_BIN/harness-workspace-fingerprint "$HARNESS_ENV_FILE")"
				if [[ "$patch_effective_workspace" == "$patch_only_baseline" ]]; then
					# A remove/add pair with identical bytes applies syntactically but has
					# no commit. If the trusted validator passes, the criterion was already
					# satisfied. Publish that observation instead of invoking a commit
					# helper that must (correctly) reject an empty source transaction.
					{
						printf '# Worker Task Result\n\nTask-ID: %s\nStatus: COMPLETED\n' "$task_id"
						if (( goal_mode == 1 )); then printf 'Goal-ID: %s\nGoal-Outcome: COMPLETE\n' "$goal_id"; fi
						emit_synthetic_impact_manifest
						printf '\n## Summary\n\nThe proposed patch had no effective byte delta, and trusted focused validation passed against the existing source.\n'
						printf '\n## Modified files\n\nNone; the assigned behavior was already present.\n'
						printf '\n## Implemented behavior\n\nThe existing source satisfies this bounded criterion without an empty commit.\n'
						printf '\n## Validation performed\n\nTrusted validation passed; complete output is retained at `%s`.\n' "$patch_validation_capture"
						printf '\n## Deviations from assignment\n\nNo mutation was necessary.\n\n## Remaining concerns\n\nNone for this bounded criterion.\n'
						printf '\n## Worker assessment\n\nCOMPLETE based on trusted validation and a clean effective patch path set.\n'
					} > "$last_message"
					log_event "PATCH_ONLY_ALREADY_SATISFIED task=$task_id patch=$patch_file paths=$patch_paths_file validation_round=$patch_validation_round validation=$patch_validation_capture"
				else
					patch_message="$PROJECT_TMP_DIR/$base.patch-commit-message.$$"
					printf 'Implement %s through validated Context Closure patch\n' "$task_id" > "$patch_message"
					"$HARNESS_BIN/harness-commit-source" "$HARNESS_ENV_FILE" "$task_id" "$session" "$patch_message" "${patch_paths[@]}" \
						> "$dir/logs/patch-only-commit-$task_id-$stamp.log"
					rm -f "$patch_message"
					# Patch application, focused validation, and source commit are all
					# trusted harness operations.  Publish their measured outcome now.
					# Retaining arbitrary model prose here can fail the result protocol,
					# trigger a second model turn against the pre-patch baseline, and
					# contradict the commit that was already created.
					{
						printf '# Worker Task Result\n\nTask-ID: %s\nStatus: COMPLETED\n' "$task_id"
						if (( goal_mode == 1 )); then printf 'Goal-ID: %s\nGoal-Outcome: COMPLETE\n' "$goal_id"; fi
						emit_synthetic_impact_manifest
						printf '\n## Summary\n\nThe trusted patch applicator committed a bounded source change after focused validation passed.\n'
						printf '\n## Modified files\n\n'
						printf -- '- `%s`\n' "${patch_paths[@]}"
						printf '\n## Implemented behavior\n\nThe validated patch implements the assigned bounded criterion.\n'
						printf '\n## Validation performed\n\nTrusted validation passed; complete output is retained at `%s`.\n' "$patch_validation_capture"
						printf '\n## Deviations from assignment\n\nNone.\n\n## Remaining concerns\n\nNone for this bounded criterion.\n'
						printf '\n## Worker assessment\n\nCOMPLETE based on trusted patch application, validation, and source commit.\n'
					} > "$last_message"
					log_event "PATCH_ONLY_APPLIED task=$task_id patch=$patch_file paths=$patch_paths_file validation_round=$patch_validation_round"
				fi
			else
				# The trusted applicator permits uniquely anchored zero-context
				# replacements with --unidiff-zero.  Rollback must use the same
				# grammar and prove that the complete workspace returned to the
				# pre-invocation fingerprint before another Luna turn can start.
				rollback_status=0
				set +e
				git -C "$REPOSITORY" apply -R --whitespace=nowarn --unidiff-zero "$patch_file"
				rollback_status=$?
				set -e
				rollback_fingerprint="$($HARNESS_BIN/harness-workspace-fingerprint "$HARNESS_ENV_FILE")"
				if (( rollback_status != 0 )) || [[ "$rollback_fingerprint" != "$patch_only_baseline" ]]; then
					mark_project_integrity_anomaly PATCH_ROLLBACK_FAILURE "$task_id" \
						'failed patch-only validation did not restore the exact pre-worker workspace' \
						"patch=$patch_file rollback_status=$rollback_status expected=$patch_only_baseline actual=$rollback_fingerprint" >/dev/null
					die 'patch-only rollback failed workspace-integrity verification'
				fi
				log_event "PATCH_ONLY_ROLLED_BACK task=$task_id patch=$patch_file validation_round=$patch_validation_round fingerprint=$rollback_fingerprint"
				patch_diagnostics="$(sed -n 's/^VALIDATION_DIAGNOSTICS records=[^ ]* file=\([^ ]*\) full_log_sha256=.*/\1/p' "$patch_validation_capture" | tail -n 1)"
				patch_diagnostic_fingerprint=""
				# Compare semantic failure identity only. Occurrence counts and the raw
				# log digest are forensic fields and may change while the failure set
				# itself makes no progress.
				[[ ! -s "$patch_diagnostics" ]] || patch_diagnostic_fingerprint="$(cut -f1-10 "$patch_diagnostics" | sha256sum | awk '{print $1}')"
				patch_fingerprint="$(sha256sum "$patch_file" | awk '{print $1}')"
				if [[ ! -f "$patch_repair_ledger" ]]; then
					printf 'validation_round\tpatch_sha256\tdiagnostic_sha256\tdiagnostics_file\trecorded_at\n' > "$patch_repair_ledger"
					chmod 600 "$patch_repair_ledger"
				fi
				printf '%s\t%s\t%s\t%s\t%s\n' "$patch_validation_round" "$patch_fingerprint" \
					"${patch_diagnostic_fingerprint:--}" "${patch_diagnostics:--}" "$(timestamp_utc)" >> "$patch_repair_ledger"
				patch_diagnostic_repeated=0
				if [[ -n "$patch_diagnostic_fingerprint" &&
					"$patch_diagnostic_fingerprint" == "$patch_last_diagnostic_fingerprint" ]]; then
					patch_diagnostic_repeated=1
				fi
				if (( attempt < patch_only_attempt_limit &&
					patch_validation_round < HARNESS_PATCH_ONLY_MAX_VALIDATION_ROUNDS &&
					patch_diagnostic_repeated == 0 )) && [[ -s "$patch_diagnostics" ]] &&
					{ [[ "$observed_thread_id" =~ ^[A-Za-z0-9-]+$ ]] ||
					[[ "$worker_resume_thread_id" =~ ^[A-Za-z0-9-]+$ ]]; }; then
					patch_last_diagnostic_fingerprint="$patch_diagnostic_fingerprint"
					context_followup_prompt="$PROJECT_TMP_DIR/$base.patch-diagnostic-followup-$patch_validation_round.md"
					{
						printf 'Trusted focused validation rejected patch round %s of %s and rolled it back. Repair only the typed diagnostic delta below. The original assignment and Context Closure remain authoritative in this thread; do not request or explore general repository context. Return one corrected fenced Git diff with the required terminal metadata, or a permitted typed Context Request when one exact missing fact is decisive. Repeating the same diagnostic set closes this leaf for deterministic decomposition.\n\n' \
							"$patch_validation_round" "$HARNESS_PATCH_ONLY_MAX_VALIDATION_ROUNDS"
						head -n "$HARNESS_VALIDATION_OUTPUT_MAX_LINES" "$patch_diagnostics" |
							head -c "$HARNESS_VALIDATION_OUTPUT_MAX_BYTES" || true
					} > "$context_followup_prompt.tmp.$$"
					chmod 600 "$context_followup_prompt.tmp.$$"
					mv "$context_followup_prompt.tmp.$$" "$context_followup_prompt"
					context_expansion_pending=1
					followup_reason=diagnostic_repair
					log_event "PATCH_ONLY_DIAGNOSTIC_REPAIR_READY task=$task_id patch=$patch_file validation_round=$patch_validation_round diagnostics=$patch_diagnostics diagnostic_sha256=$patch_diagnostic_fingerprint"
				else
					if (( patch_diagnostic_repeated == 1 )); then
						mark_task_resource_anomaly "$task_id" REPEATED_DIAGNOSTIC \
							'the same focused-validation failure fingerprint survived consecutive patch proposals' \
							"round=$patch_validation_round diagnostic_sha256=${patch_diagnostic_fingerprint:--} ledger=$patch_repair_ledger" >/dev/null
					elif (( patch_validation_round >= HARNESS_MAX_PATCH_CHURN_ROUNDS )); then
						mark_task_resource_anomaly "$task_id" PATCH_CHURN \
							'multiple patch proposals were applied, rejected, and reverted without acceptance progress' \
							"rounds=$patch_validation_round limit=$HARNESS_MAX_PATCH_CHURN_ROUNDS ledger=$patch_repair_ledger" >/dev/null
					fi
					{
						printf '# Worker Task Result\n\nTask-ID: %s\nStatus: COMPLETED\n' "$task_id"
						if (( goal_mode == 1 )); then printf 'Goal-ID: %s\nGoal-Outcome: NEEDS_DECOMPOSITION\nDecomposition-Reason: VALIDATION_PREREQUISITE\n' "$goal_id"; fi
						emit_synthetic_impact_manifest
						printf '\n## Summary\n\nPatch-only focused validation did not converge after %s bounded validation round(s). The last proposal remains at `%s`.\n' "$patch_validation_round" "$patch_file"
						printf '\n## Modified files\n\nThe failed proposal was rolled back; no source delta remains.\n\n## Implemented behavior\n\nNone accepted.\n'
						printf '\n## Validation performed\n\nSee `%s` and `%s`.\n' "$patch_validation_capture" "$patch_repair_ledger"
						if (( patch_diagnostic_repeated == 1 )); then
							printf '\n## Deviations from assignment\n\nThe typed diagnostic set was unchanged across consecutive patches, so the no-progress circuit breaker stopped the loop.\n'
						else
							printf '\n## Deviations from assignment\n\nThe bounded patch-only validation-round limit was reached or no resumable typed diagnostic was available.\n'
						fi
						printf '\n## Remaining concerns\n\nThe deterministic child-DAG compiler must narrow the leaf at the recorded failing boundary.\n\n## Worker assessment\n\nNEEDS_DECOMPOSITION without a stronger-model fallback.\n'
					} > "$last_message"
					log_event "PATCH_ONLY_VALIDATION_FAILED task=$task_id patch=$patch_file validation_round=$patch_validation_round repeated_diagnostic=$patch_diagnostic_repeated diagnostics=${patch_diagnostics:--}"
				fi
			fi
		else
			patch_format_repair_ready=0
			if (( attempt < patch_only_attempt_limit && context_request_status != 2 &&
				patch_format_round + 1 < HARNESS_PATCH_ONLY_MAX_VALIDATION_ROUNDS )) &&
				{ [[ "$observed_thread_id" =~ ^[A-Za-z0-9-]+$ ]] ||
				[[ "$worker_resume_thread_id" =~ ^[A-Za-z0-9-]+$ ]]; }; then
				patch_format_round=$((patch_format_round + 1))
				context_followup_prompt="$PROJECT_TMP_DIR/$base.patch-format-followup-$patch_format_round.md"
				{
					printf 'The trusted patch parser rejected fenced diff format round %s of %s. No source mutation occurred. Re-emit the same intended bounded change as exactly one complete fenced Git unified diff; include file headers and valid hunk counts. Do not inspect files, change scope, request general context, or add prose outside the required terminal metadata. Parser diagnostic:\n\n' \
						"$patch_format_round" "$((HARNESS_PATCH_ONLY_MAX_VALIDATION_ROUNDS - 1))"
					printf '%s\n' "$patch_apply_output" |
						head -n "$HARNESS_VALIDATION_OUTPUT_MAX_LINES" |
						head -c "$HARNESS_VALIDATION_OUTPUT_MAX_BYTES" || true
				} > "$context_followup_prompt.tmp.$$"
				chmod 600 "$context_followup_prompt.tmp.$$"
				mv "$context_followup_prompt.tmp.$$" "$context_followup_prompt"
				context_expansion_pending=1
				followup_reason=patch_format_repair
				patch_format_repair_ready=1
				log_event "PATCH_ONLY_FORMAT_REPAIR_READY task=$task_id format_round=$patch_format_round reason=$(printf '%q' "$patch_apply_output")"
			fi
			if (( patch_format_repair_ready == 0 )); then
				log_event "PATCH_ONLY_REJECTED task=$task_id reason=$(printf '%q' "$patch_apply_output")"
				{
				printf '# Worker Task Result\n\nTask-ID: %s\nStatus: COMPLETED\n' "$task_id"
				if (( goal_mode == 1 )); then
					printf 'Goal-ID: %s\nGoal-Outcome: NEEDS_DECOMPOSITION\nDecomposition-Reason: CONTEXT_INCOMPLETE\n' "$goal_id"
				fi
				emit_synthetic_impact_manifest
				printf '\n## Summary\n\nThe patch-only proposal was rejected before source mutation: %s.\n' "$patch_apply_output"
				printf '\n## Modified files\n\nNone.\n\n## Implemented behavior\n\nNone accepted.\n'
				printf '\n## Validation performed\n\nPatch syntax, baseline, and scope validation did not complete successfully.\n'
				printf '\n## Deviations from assignment\n\nThe worker did not produce an admissible patch-only result.\n'
				printf '\n## Remaining concerns\n\nManager must split the leaf or repair the compiled context/instructions.\n'
				printf '\n## Worker assessment\n\nNEEDS_DECOMPOSITION without another identical worker retry.\n'
				} > "$last_message"
			fi
		fi
	fi
	if (( luna_bounded_execution == 1 && patch_only_execution == 1 )); then
		normalize_patch_only_result_metadata "$last_message"
	fi
	observed_thread_id="$(codex_thread_id_from_jsonl "$json_log" 2>/dev/null || true)"
	if [[ "$observed_thread_id" =~ ^[A-Za-z0-9-]+$ ]]; then
		worker_resume_thread_id="$observed_thread_id"
		if (( goal_mode == 1 )) &&
			[[ "$(kv_file_value "$goal_state" thread_context 2>/dev/null || true)" != rotation-requested ]] &&
			[[ "$(kv_file_value "$goal_state" state 2>/dev/null || true)" != AWAITING_MANAGER_REVIEW ]]; then
			goal_state_set "$goal_state" thread_id "$observed_thread_id"
			goal_state_set "$goal_state" thread_context resumed
			goal_thread_store "$task_id" "$observed_thread_id" resumed
		fi
	fi
	classification="$(kv_file_value "${json_log%.jsonl}.classification" classification 2>/dev/null || true)"
	record_root_agent_tokens "$task_id" "$execution_role" "${json_log%.jsonl}.classification"
	record_worker_complexity_observation "$task_id" "$plan_item_id" "$execution_role" "$current_model" \
		"${json_log%.jsonl}.classification" "$json_log"
	if (( luna_bounded_execution == 1 && patch_only_execution == 1 )); then
		patch_only_tool_calls="$(jq -rs '[.[] | select(.type=="item.started" and .item.type=="command_execution")] | length' "$json_log" 2>/dev/null || printf 0)"
		[[ "$patch_only_tool_calls" =~ ^[0-9]+$ ]] || patch_only_tool_calls=0
		if (( HARNESS_ACP_ENABLED == 1 )); then
			acp_event_append - "$task_id" "${observed_thread_id:--}" "$attempt" \
				WORKER_DISCOVERY_OBSERVED CONTEXT REPOSITORY_EXPLORATION - \
				"tool_calls=$patch_only_tool_calls policy=patch_only"
		fi
		if (( patch_only_tool_calls > 0 )); then
			mark_project_integrity_anomaly MODEL_POLICY_VIOLATION "$task_id" \
				'patch-only Luna executed repository/shell tools despite a compiled no-tools Context Closure contract' \
				"tool_calls=$patch_only_tool_calls jsonl=$json_log context_file=$compiled_context_closure_file" >/dev/null
		fi
	fi
	episode_resource_anomaly=0
	if evaluate_worker_episode_irregularities "$task_id"; then
		episode_resource_anomaly=1
	fi
		if [[ "$HARNESS_CONTEXT_CLOSURE_MODE" == advisory && "$context_closure_status" == READY ]]; then
			usage_log="$dir/logs/context-closure-usage-$task_id-$stamp-attempt-$attempt_label.log"
			if "$HARNESS_BIN/harness-context-closure-usage" "$HARNESS_ENV_FILE" "$task_id" "$json_log" \
				> "$usage_log" 2>&1; then
				log_event "CONTEXT_CLOSURE_USAGE_RECORDED task=$task_id jsonl=$json_log summary=$usage_log"
			else
				log_event "CONTEXT_CLOSURE_USAGE_UNAVAILABLE task=$task_id jsonl=$json_log log=$usage_log"
			fi
		fi
	resource_guard="$(kv_file_value "${json_log%.jsonl}.classification" resource_guard 2>/dev/null || printf -)"
	if project_has_integrity_anomaly && ! completion_committed; then
		cleanup_heartbeat
		log_event "WORKER_PROJECT_INTEGRITY_STOP task=$task_id root=$task_root marker=$(project_integrity_anomaly_file)"
		exit 78
	fi
	if (( episode_resource_anomaly == 1 )) && ! completion_committed; then
		if (( goal_mode == 1 )) && publish_goal_decomposition_handoff \
			"This immutable leaf was quarantined after a repeated efficiency irregularity; the current source and evidence are preserved." \
			"Inspect $(task_resource_anomaly_file "$task_id") and publish a strictly smaller successor rather than relaunching this revision."; then
			cleanup_heartbeat
			log_event "WORKER_TASK_RESOURCE_ANOMALY_HANDOFF task=$task_id root=$task_root marker=$(task_resource_anomaly_file "$task_id")"
			exit 0
		fi
		cleanup_heartbeat
		log_event "WORKER_TASK_RESOURCE_ANOMALY_STOP task=$task_id root=$task_root marker=$(task_resource_anomaly_file "$task_id")"
		exit 75
	fi
	worker_task_tokens="$(worker_task_processed_token_count "$task_id")"
	[[ "$worker_task_tokens" =~ ^[0-9]+$ ]] || worker_task_tokens=0
	if (( worker_task_tokens >= HARNESS_MAX_WORKER_TASK_PROCESSED_TOKENS )) && [[ "$resource_guard" == - ]]; then
		mark_root_token_usage_anomaly "$task_id" \
			"worker task processed-token budget reached ($worker_task_tokens/$HARNESS_MAX_WORKER_TASK_PROCESSED_TOKENS)" \
			"role=$execution_role model=$current_model classification=${json_log%.jsonl}.classification jsonl=$json_log" >/dev/null
		if (( goal_mode == 1 )); then
			if publish_goal_decomposition_handoff \
				"The cumulative worker usage for this immutable leaf reached $worker_task_tokens processed tokens; the harness stopped before authorizing another episode." \
				"Inspect the token anomaly record and split, correct, or explicitly justify the continuation boundary before resolving the pause."; then
				cleanup_heartbeat
				log_event "WORKER_TASK_TOKEN_BUDGET_PAUSED task=$task_id root=$task_root processed_tokens=$worker_task_tokens limit=$HARNESS_MAX_WORKER_TASK_PROCESSED_TOKENS"
				printf 'Worker goal %s reached its cumulative token anomaly limit and paused.\n' "$goal_id"
				exit 0
			fi
			die 'failed to publish cumulative token-anomaly handoff'
		fi
		cleanup_heartbeat
		log_event "WORKER_TASK_TOKEN_BUDGET_PAUSED task=$task_id root=$task_root processed_tokens=$worker_task_tokens limit=$HARNESS_MAX_WORKER_TASK_PROCESSED_TOKENS legacy=1"
		exit 75
	fi
	if (( goal_mode == 1 )) && [[ "$resource_guard" != - ]]; then
		if publish_goal_decomposition_handoff \
			"The implementation episode reached the emergency $resource_guard resource fuse; this limits one context, not the amount of work allowed for the goal." \
			"The manager must inspect the preserved evidence, split or restate the next semantic episode, and may continue the same criterion when it remains valid."; then
			cleanup_heartbeat
			log_event "WORKER_GOAL_RESOURCE_EPISODE_CLOSED task=$task_id root=$task_root guard=$resource_guard classification=${classification:-unknown}"
			printf 'Worker goal %s closed its overgrown semantic episode and requested decomposition.\n' "$goal_id"
			exit 0
		fi
		die 'failed to publish resource-fuse decomposition handoff'
	fi
	if task_root_needs_human "$task_root" && [[ "$(kv_file_value "${json_log%.jsonl}.classification" resource_guard 2>/dev/null || printf -)" != - ]]; then
		cleanup_heartbeat
		log_event "WORKER_RESOURCE_GUARD_PAUSED task=$task_id root=$task_root classification=${classification:-unknown}"
		printf 'Worker task %s exceeded an invocation resource guard; workspace changes are preserved and the root requires human review.\n' "$task_id" >&2
		(( status != 0 )) || status=75
		exit "$status"
	fi
	if (( goal_mode == 1 )); then
		goal_turns="$(kv_file_value "$goal_state" process_turns 2>/dev/null || printf 0)"
		goal_input="$(kv_file_value "$goal_state" cumulative_input_tokens 2>/dev/null || printf 0)"
		goal_output="$(kv_file_value "$goal_state" cumulative_output_tokens 2>/dev/null || printf 0)"
		[[ "$goal_turns" =~ ^[0-9]+$ ]] || goal_turns=0
		[[ "$goal_input" =~ ^[0-9]+$ ]] || goal_input=0
		[[ "$goal_output" =~ ^[0-9]+$ ]] || goal_output=0
		turn_input="$(codex_usage_value_from_jsonl "$json_log" input_tokens)"
		turn_output="$(codex_usage_value_from_jsonl "$json_log" output_tokens)"
		[[ "$turn_input" =~ ^[0-9]+$ ]] || turn_input=0
		[[ "$turn_output" =~ ^[0-9]+$ ]] || turn_output=0
		goal_state_set "$goal_state" process_turns "$((goal_turns + 1))"
		goal_state_set "$goal_state" cumulative_input_tokens "$((goal_input + turn_input))"
		goal_state_set "$goal_state" cumulative_output_tokens "$((goal_output + turn_output))"
	fi
	trace_event CODEX_EXEC_END "role=$execution_role" "task_id=$task_id" "session=$session" "attempt=$attempt" "status=$status" "classification=${classification:-unknown}" "json_log=$json_log" "stderr_log=$stderr_log" "last_message=$last_message"
	if (( context_expansion_pending == 1 )); then
		if [[ "$observed_thread_id" =~ ^[A-Za-z0-9-]+$ ]]; then
			worker_resume_thread_id="$observed_thread_id"
		fi
		attempt=$((attempt + 1))
		if [[ "$followup_reason" == diagnostic_repair ]]; then
			log_event "WORKER_DIAGNOSTIC_REPAIR_RESUMING task=$task_id session=$session validation_round=$patch_validation_round thread_id=$worker_resume_thread_id attempt=$attempt"
			trace_event WORKER_DIAGNOSTIC_REPAIR_RESUMING "task_id=$task_id" "session=$session" "validation_round=$patch_validation_round" "thread_id=$worker_resume_thread_id" "attempt=$attempt"
		elif [[ "$followup_reason" == patch_format_repair ]]; then
			log_event "WORKER_PATCH_FORMAT_REPAIR_RESUMING task=$task_id session=$session format_round=$patch_format_round thread_id=$worker_resume_thread_id attempt=$attempt"
			trace_event WORKER_PATCH_FORMAT_REPAIR_RESUMING "task_id=$task_id" "session=$session" "format_round=$patch_format_round" "thread_id=$worker_resume_thread_id" "attempt=$attempt"
		else
			log_event "WORKER_CONTEXT_EXPANSION_RESUMING task=$task_id session=$session count=$context_expansion_count thread_id=$worker_resume_thread_id attempt=$attempt"
			trace_event WORKER_CONTEXT_EXPANSION_RESUMING "task_id=$task_id" "session=$session" "count=$context_expansion_count" "thread_id=$worker_resume_thread_id" "attempt=$attempt"
		fi
		continue
	fi
	if waiting_dependency_committed; then
		cleanup_heartbeat
		log_event "WORKER_INVOCATION_WAITING_DEPENDENCY task=$task_id session=$session attempt=$attempt"
		trace_event WORKER_WAITING_DEPENDENCY "task_id=$task_id" "session=$session" "attempt=$attempt"
		printf 'Worker task %s entered WAITING_DEPENDENCY and released its agent process.\n' "$task_id"
		exit 0
	fi

	normalize_direct_result
	normalize_last_message_result
	if completion_committed; then
		if (( goal_mode == 1 )) && [[ "$observed_thread_id" =~ ^[A-Za-z0-9-]+$ ]]; then
			goal_state_set "$goal_state" thread_id "$observed_thread_id"
			goal_thread_store "$task_id" "$observed_thread_id" terminal
		fi
		cleanup_heartbeat
		log_event "WORKER_INVOCATION_FINISHED task=$task_id session=$session status=$status result=published attempt=$attempt"
		trace_event WORKER_RESULT_PUBLISHED "task_id=$task_id" "session=$session" "attempt=$attempt" "status=$status" "result=$result"
		printf 'Worker completed task %s and published its result.\n' "$task_id"
		exit 0
	fi

	if (( goal_mode == 1 )); then
		goal_iteration_after="$(kv_file_value "$goal_state" iteration_count)"
		if (( goal_iteration_after > goal_iteration_before )); then
			goal_movement="$(kv_file_value "$(goal_continue_marker_file "$task_id")" movement 2>/dev/null || printf unknown)"
			if (( HARNESS_SEMANTIC_CONTINUATION_REVIEW_ENABLED == 1 )); then
				"$HARNESS_BIN/manager-review-goal-continuation" "$HARNESS_ENV_FILE" "$task_id" >/dev/null
				semantic_decision="$(kv_file_value "$goal_state" semantic_decision 2>/dev/null || true)"
				semantic_relation="$(kv_file_value "$goal_state" semantic_relation 2>/dev/null || true)"
				semantic_decision_file="$(kv_file_value "$goal_state" semantic_decision_file 2>/dev/null || true)"
				if [[ "$semantic_decision" == REPLAN ]]; then
					handoff="$PROJECT_TMP_DIR/$base.semantic-replan-handoff.$$"
					{
						printf '# Worker Task Result\n\n'
						printf 'Task-ID: %s\n' "$task_id"
						printf 'Status: COMPLETED\n'
						printf 'Goal-ID: %s\n' "$goal_id"
						printf 'Goal-Outcome: NEEDS_DECOMPOSITION\n'
						printf 'Decomposition-Reason: TASK_TOO_BROAD\n'
						emit_synthetic_impact_manifest
						printf '\n'
						printf '## Summary\n\nThe semantic continuation review closed this leaf after iteration %s.\n\n' "$goal_iteration_after"
						printf '## Modified files\n\nWorkspace changes and source commits from completed episodes are preserved for manager inspection.\n\n'
						printf '## Implemented behavior\n\nNo claim beyond the worker continuation receipt is synthesized by the harness.\n\n'
						printf '## Validation performed\n\nSee the durable continuation receipt and semantic decision.\n\n'
						printf '## Deviations from assignment\n\nCriterion relation: %s.\n\n' "$semantic_relation"
						printf '## Remaining concerns\n\nThe manager must revise decomposition before authorizing more implementation work. Decision: %s\n\n' "$semantic_decision_file"
						printf '## Worker assessment\n\nNEEDS_DECOMPOSITION because the proposed next action no longer qualifies as another episode of the same bounded criterion.\n'
					} > "$handoff"
					chmod 600 "$handoff"
					"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$handoff" >/dev/null
					rm -f "$handoff"
					if completion_committed; then
						cleanup_heartbeat
						log_event "WORKER_GOAL_SEMANTIC_REPLAN task=$task_id goal=$goal_id iteration=$goal_iteration_after relation=$semantic_relation decision=$semantic_decision_file"
						printf 'Worker goal %s returned to decomposition after semantic boundary review.\n' "$goal_id"
						exit 0
					fi
					die 'failed to publish semantic-replan handoff'
				fi
				[[ "$semantic_decision" == CONTINUE && "$semantic_relation" == SAME_CRITERION ]] ||
					die 'semantic continuation review did not publish a valid decision'
				worker_resume_thread_id=""
				goal_state_set "$goal_state" thread_context fresh-semantic-episode
				goal_thread_store "$task_id" "" fresh-semantic-episode
				worker_context_mode="fresh"
				worker_context_reason="semantic_episode_boundary"
			fi
			strategy_review="$(kv_file_value "$goal_state" strategy_review_required)"
			context_state="$(kv_file_value "$goal_state" thread_context)"
			if (( HARNESS_DECOMPOSITION_V2 == 1 && goal_iteration_after >= leaf_expected_turns )); then
				handoff="$PROJECT_TMP_DIR/$base.declared-turn-limit-handoff.$$"
				{
					printf '# Worker Task Result\n\n'
					printf 'Task-ID: %s\n' "$task_id"
					printf 'Status: COMPLETED\n'
					printf 'Goal-ID: %s\n' "$goal_id"
					printf 'Goal-Outcome: NEEDS_DECOMPOSITION\n'
					printf 'Decomposition-Reason: TASK_TOO_BROAD\n'
					emit_synthetic_impact_manifest
					printf '\n'
					printf '## Summary\n\nThe routed leaf reached its declared maximum of %s durable worker turns without a terminal completion.\n\n' "$leaf_expected_turns"
					printf '## Modified files\n\nWorkspace changes are preserved for independent manager inspection.\n\n'
					printf '## Implemented behavior\n\nNo additional implementation claim is synthesized by the harness.\n\n'
					printf '## Validation performed\n\nSee the assignment, context capsule, JSONL traces, and goal iteration ledger.\n\n'
					printf '## Deviations from assignment\n\nThe leaf exceeded its manager-declared strategy budget.\n\n'
					printf '## Remaining concerns\n\nThe manager must split the leaf further or choose a stronger route with fresh context.\n\n'
					printf '## Worker assessment\n\nNEEDS_DECOMPOSITION due to the enforced routed-leaf turn budget.\n'
				} > "$handoff"
				chmod 600 "$handoff"
				"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$handoff" >/dev/null
				rm -f "$handoff"
				if completion_committed; then
					cleanup_heartbeat
					log_event "WORKER_GOAL_DECLARED_TURN_LIMIT task=$task_id goal=$goal_id route=$worker_route turns=$goal_iteration_after limit=$leaf_expected_turns"
					printf 'Worker goal %s requested decomposition at its declared %s-turn limit.\n' "$goal_id" "$leaf_expected_turns"
					exit 0
				fi
				die 'failed to publish routed-leaf turn-limit handoff'
			fi
			if [[ "$context_state" == rotation-requested ]]; then
				worker_resume_thread_id=""
				goal_state_set "$goal_state" thread_context rotated
				goal_thread_store "$task_id" "" rotated
				worker_context_mode="fresh"
				worker_context_reason="goal_iteration_rotation"
			fi
			printf '\nGoal iteration %s is durably committed with movement=%s. This later episode block supersedes earlier iteration and boundary values in this prompt. Re-read GOAL_SUMMARY_FILE and GOAL_STATE_FILE, use the current durable values there, and continue the same leaf goal from its new boundary in a fresh semantic episode. The next receipt Iteration must be %s. ' \
				"$goal_iteration_after" "$goal_movement" "$((goal_iteration_after + 1))" >> "$prompt_file"
			if [[ "$strategy_review" == 1 ]]; then
				printf 'Repeated materially identical iterations closed CONTINUE. Publish a truthful terminal Goal-Outcome: NEEDS_DECOMPOSITION so the persistent manager can change strategy or append child criteria.\n' >> "$prompt_file"
			else
				printf 'Publish the next CONTINUE receipt or a truthful terminal goal result.\n' >> "$prompt_file"
			fi
			attempt=$((attempt + 1))
			log_event "WORKER_GOAL_RESUMING task=$task_id goal=$goal_id iteration=$goal_iteration_after movement=$goal_movement context=$worker_context_mode"
			trace_event WORKER_GOAL_RESUMING "task_id=$task_id" "goal_id=$goal_id" "iteration=$goal_iteration_after" "movement=$goal_movement" "context=$worker_context_mode"
			continue
		fi
	fi

	retry_kind="$(codex_provider_retry_kind "$classification" 2>/dev/null || true)"
	if [[ -n "$retry_kind" ]]; then
		retry_delay="$(codex_provider_retry_delay "$classification")"
		provider_retries=$((provider_retries + 1))
		[[ "$retry_kind" != quota ]] || quota_waits=$((quota_waits + 1))
		log_event "WORKER_PROVIDER_WAIT task=$task_id session=$session kind=$retry_kind attempt=$attempt retry=$provider_retries delay_seconds=$retry_delay classification=$classification"
		if [[ "$retry_kind" == quota ]]; then
			printf 'Worker task %s has no provider quota; state and heartbeat are preserved. Checking again in %s seconds (quota wait %s).\n' "$task_id" "$retry_delay" "$quota_waits" >&2
		else
			printf 'Worker task %s hit a transient provider/network failure; retrying in %s seconds.\n' "$task_id" "$retry_delay" >&2
		fi
		sleep "$retry_delay"
		attempt=$((attempt + 1))
		log_event "WORKER_PROVIDER_RETRY_STARTED task=$task_id session=$session kind=$retry_kind attempt=$attempt retry=$provider_retries"
		trace_event WORKER_PROVIDER_RETRY "task_id=$task_id" "session=$session" "kind=$retry_kind" "attempt=$attempt" "retry=$provider_retries"
		continue
	fi

	# Terra/GPT-5.6 gets exactly one narrowed retry, then one stable-model
	# fallback for model-layer failures only. Provider, authentication, sandbox,
	# configuration, and protocol failures never enter this branch.
	if codex_model_requires_narrow_prompt "$current_model" && [[ "$classification" == model_refusal_or_blocked_content ]]; then
		if (( fallback_stage == 0 )); then
			fallback_stage=1
			printf '\nRetry scope: perform only the single bounded assignment in TASK_FILE. Do not inspect unrelated directories or broaden the task.\n' >> "$prompt_file"
			attempt=$((attempt + 1))
			log_event "WORKER_TERRA_NARROW_RETRY task=$task_id session=$session classification=$classification"
			continue
		fi
		if (( fallback_stage == 1 )) && [[ "$execution_fallback_model" != "$current_model" ]]; then
			fallback_stage=2
			current_model="$execution_fallback_model"
			if (( HARNESS_DECOMPOSITION_V2 == 1 )) && [[ "$current_model" == "$TERRA_WORKER_MODEL" ]]; then
				execution_role=worker_terra
				execution_mode=TERRA_FALLBACK
			fi
			attempt=$((attempt + 1))
			log_event "WORKER_MODEL_FALLBACK task=$task_id session=$session classification=$classification model=$current_model"
			continue
		fi
	fi

	if (( goal_mode == 1 )); then
		case "$classification" in
			authentication_error|sandbox_denied|configuration_error)
				break
				;;
		esac
		protocol_failures="$(kv_file_value "$goal_state" protocol_failures)"
		[[ "$protocol_failures" =~ ^[0-9]+$ ]] || protocol_failures=0
		protocol_failures=$((protocol_failures + 1))
		goal_state_set "$goal_state" protocol_failures "$protocol_failures"
		if (( protocol_failures < HARNESS_GOAL_MAX_IDENTICAL_ITERATIONS )); then
			printf '\nThe prior goal turn ended without committing either a CONTINUE receipt or terminal result (classification=%s, exit=%s). Preserve the workspace and retry the protocol now. Re-read GOAL_STATE_FILE; do not repeat completed actions.\n' \
				"${classification:-unknown}" "$status" >> "$prompt_file"
			attempt=$((attempt + 1))
			log_event "WORKER_GOAL_PROTOCOL_RETRY task=$task_id goal=$goal_id failures=$protocol_failures classification=${classification:-unknown}"
			continue
		fi

		handoff="$PROJECT_TMP_DIR/$base.goal-protocol-handoff.$$"
		{
			printf '# Worker Task Result\n\n'
			printf 'Task-ID: %s\n' "$task_id"
			printf 'Status: COMPLETED\n'
			printf 'Goal-ID: %s\n' "$goal_id"
			printf 'Goal-Outcome: NEEDS_DECOMPOSITION\n'
			printf 'Decomposition-Reason: TASK_TOO_BROAD\n'
			emit_synthetic_impact_manifest
			printf '\n'
			printf '## Summary\n\nThe leaf-goal execution protocol made no durable transition for %s consecutive recoverable turns.\n\n' "$protocol_failures"
			printf '## Modified files\n\nWorkspace changes, if any, are preserved for manager inspection.\n\n'
			printf '## Implemented behavior\n\nNo implementation claim is synthesized by the harness.\n\n'
			printf '## Validation performed\n\nSee the worker JSONL and goal iteration ledger; no unrecorded validation is claimed.\n\n'
			printf '## Deviations from assignment\n\nThe worker failed to publish a valid continuation or terminal receipt.\n\n'
			printf '## Remaining concerns\n\nThe persistent manager should narrow/decompose the criterion or publish a materially different strategy.\n\n'
			printf '## Worker assessment\n\nNEEDS_DECOMPOSITION due to repeated goal protocol failure; this is not a claim that code progress was absent.\n'
		} > "$handoff"
		chmod 600 "$handoff"
		"$HARNESS_BIN/worker-complete-task" "$HARNESS_ENV_FILE" "$task_id" "$session" "$handoff" >/dev/null
		rm -f "$handoff"
		if completion_committed; then
			cleanup_heartbeat
			log_event "WORKER_GOAL_STRATEGY_HANDOFF task=$task_id goal=$goal_id failures=$protocol_failures"
			printf 'Worker goal %s requested manager decomposition after repeated protocol failures.\n' "$goal_id"
			exit 0
		fi
	fi

	break
done

cleanup_heartbeat

if [[ -z "$protocol_reason" ]]; then
	if [[ ! -f "$result" ]]; then
		protocol_reason="result_not_published"
	else
		protocol_reason="completion_state_inconsistent"
	fi
fi

alert="$dir/control/$base.worker-failed.md"
cat > "$alert.tmp.$$" <<ALERT
# Worker Invocation Failed

Project: $PROJECT

Task-ID: $task_id

Session: $session

Environment-File: $HARNESS_ENV_FILE

Failed-At: $(timestamp_utc)

Codex-Exit-Status: $status

Protocol-Reason: $protocol_reason

JSONL-Log: $json_log

Stderr-Log: $stderr_log

Classification: ${classification:-unknown}

Partial-Edits: $(kv_file_value "${json_log%.jsonl}.classification" partial_edits 2>/dev/null || printf unknown)

Attempts: $attempt

Provider-Retries: $provider_retries

Quota-Waits: $quota_waits

The completion transaction is not committed. Provider quota and transient provider/network failures retry indefinitely while preserving task ownership. This failure was classified as terminal, local, configuration/protocol, or an actual agent failure. Inspect the log and filesystem state, then reset, repair, or abort the task explicitly.
ALERT
chmod 600 "$alert.tmp.$$"
mv "$alert.tmp.$$" "$alert"
if (( status == 0 )); then
	log_event "WORKER_PROTOCOL_FAILED task=$task_id session=$session status=$status reason=$protocol_reason attempts=$attempt"
	trace_event WORKER_PROTOCOL_FAILED "task_id=$task_id" "session=$session" "status=$status" "reason=$protocol_reason" "attempts=$attempt" "json_log=$json_log"
else
	log_event "WORKER_PROCESS_FAILED task=$task_id session=$session status=$status reason=$protocol_reason attempts=$attempt"
	trace_event WORKER_PROCESS_FAILED "task_id=$task_id" "session=$session" "status=$status" "reason=$protocol_reason" "attempts=$attempt" "json_log=$json_log"
fi
printf 'Worker invocation failed for task %s; see %s\n' "$task_id" "$alert" >&2
if (( status == 0 )); then
	exit 70
fi
exit "$status"
