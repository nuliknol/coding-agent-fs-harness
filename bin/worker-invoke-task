#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"
source "$SCRIPT_DIR/../lib/harness-repository-index.sh"

usage()
{
	printf 'Usage: %s ENV_FILE TASK_ID\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 2 ]] || usage
load_harness_env "$1"
task_id="$2"
ensure_project
require_no_project_integrity_anomaly
require_registered_specification_ir
require_repository
trace_init worker_invoke_task
trace_script_start "$@"
trap 'trace_script_exit $?' EXIT
validate_task_id "$task_id"

dir="$(project_dir)"
base="$(task_base "$task_id")"
ready="$dir/tasks/$base.ready.md"
[[ -f "$ready" ]] || die "task is not ready: $task_id"
manager_remediation=0
execution_role=worker
execution_model="$WORKER_MODEL"
execution_fallback_model="$WORKER_FALLBACK_MODEL"
execution_mode=WORKER
worker_route=LEGACY
luna_bounded_execution=0
leaf_expected_turns=0
if assignment_is_manager_remediation "$ready"; then
	manager_remediation=1
	execution_role=manager_remediation
	execution_model="$MANAGER_MODEL"
	execution_fallback_model="$MANAGER_FALLBACK_MODEL"
	execution_mode=MANAGER_REMEDIATION
	worker_route=MANAGER_REMEDIATION
	if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
		leaf_expected_turns="$(require_single_metadata_value "$ready" Expected-Max-Worker-Turns 'v2 manager remediation assignment')"
		[[ "$leaf_expected_turns" =~ ^[1-9][0-9]*$ ]] || die 'invalid v2 Expected-Max-Worker-Turns'
	fi
	if [[ "$HARNESS_MODEL_POLICY" == luna_only ]]; then
		luna_bounded_execution=1
		require_worker_codex
		write_worker_snapshot
	else
		require_manager_codex
		write_manager_snapshot
	fi
else
	if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
		worker_route="$(require_single_metadata_value "$ready" Worker-Route 'v2 worker assignment')"
		leaf_expected_turns="$(require_single_metadata_value "$ready" Expected-Max-Worker-Turns 'v2 worker assignment')"
		[[ "$leaf_expected_turns" =~ ^[1-9][0-9]*$ ]] || die 'invalid v2 Expected-Max-Worker-Turns'
		case "$worker_route" in
			LUNA)
				luna_bounded_execution=1
				execution_role=worker_luna
				execution_model="$LUNA_WORKER_MODEL"
				if [[ "$HARNESS_ESCALATION_POLICY" == decompose ]]; then
					execution_fallback_model="$WORKER_FALLBACK_MODEL"
				else
					execution_fallback_model="$TERRA_WORKER_MODEL"
				fi
				execution_mode=LUNA_LEAF
				;;
			TERRA)
				if [[ "$HARNESS_MODEL_POLICY" == luna_only ]]; then
					mark_project_integrity_anomaly MODEL_POLICY_VIOLATION "$task_id" \
						'Luna-only project published a TERRA worker assignment' \
						"assignment=$ready route=$worker_route" >/dev/null
					die 'Luna-only policy rejected a TERRA worker assignment; decompose it into Luna children'
				fi
				execution_role=worker_terra
				execution_model="$TERRA_WORKER_MODEL"
				execution_fallback_model="$MANAGER_FALLBACK_MODEL"
				execution_mode=TERRA_LEAF
				;;
			*) die "invalid v2 Worker-Route: $worker_route" ;;
		esac
	fi
	require_worker_codex
	write_worker_snapshot
fi
if assignment_uses_goal_mode "$ready"; then
	(( HARNESS_WORKER_GOAL_MODE == 1 )) ||
		die 'refusing to claim an active LEAF_GOAL after HARNESS_WORKER_GOAL_MODE was disabled'
elif (( HARNESS_WORKER_GOAL_MODE == 1 )); then
	die 'refusing to claim a legacy assignment after HARNESS_WORKER_GOAL_MODE was enabled; change mode only at a clean task boundary'
fi

compiled_context_closure_file=""
context_closure_status=OFF
context_closure_reason=-
context_closure_bytes=0
context_closure_tokens=0
context_closure_condition=OFF
context_closure_repair_action=NONE
context_closure_repair_provider=-
context_closure_semantic_split=0
if [[ "$HARNESS_CONTEXT_CLOSURE_MODE" != off ]]; then
	closure_build_log="$dir/logs/context-closure-$task_id-$(timestamp_compact_utc)-$$.log"
	set +e
	closure_build_output="$($HARNESS_BIN/harness-build-context-closure \
		"$HARNESS_ENV_FILE" "$ready" 2> "$closure_build_log")"
	closure_build_status=$?
	set -e
	if (( closure_build_status == 0 )); then
		closure_path="$(sed -n 's/^.* path=//p' <<< "$closure_build_output" | tail -n 1)"
		closure_manifest="$closure_path/manifest.env"
		context_closure_status="$(kv_file_value "$closure_manifest" status 2>/dev/null || printf INVALID)"
		context_closure_reason="$(kv_file_value "$closure_manifest" reasons 2>/dev/null || printf missing-manifest)"
		context_closure_bytes="$(kv_file_value "$closure_manifest" context_bytes 2>/dev/null || printf 0)"
		context_closure_tokens="$(kv_file_value "$closure_manifest" estimated_tokens 2>/dev/null || printf 0)"
		context_closure_condition="$(kv_file_value "$closure_manifest" condition 2>/dev/null || printf LEGACY_UNCLASSIFIED)"
		context_closure_repair_action="$(kv_file_value "$closure_manifest" repair_action 2>/dev/null || printf REPAIR_CONTEXT)"
		context_closure_repair_provider="$(kv_file_value "$closure_manifest" repair_provider 2>/dev/null || printf repository-index)"
		context_closure_semantic_split="$(kv_file_value "$closure_manifest" semantic_split_required 2>/dev/null || printf 0)"
		if [[ "$context_closure_status" == READY && -s "$closure_path/context.md" ]]; then
			compiled_context_closure_file="$closure_path/context.md"
		fi
	else
		context_closure_status=UNAVAILABLE
		context_closure_reason="build-exit-$closure_build_status"
		context_closure_condition=CLOSURE_BUILD_UNAVAILABLE
		context_closure_repair_action=REFRESH_INDEX_OR_OVERLAY
		context_closure_repair_provider=repository-index
	fi
	closure_events="$dir/logs/context-closure-events.tsv"
	if [[ ! -f "$closure_events" ]]; then
		printf 'recorded_at\ttask_id\tmode\tstatus\treason\tcontext_bytes\testimated_tokens\tcontext_file\n' \
			> "$closure_events"
		chmod 600 "$closure_events"
	fi
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$(timestamp_utc)" "$task_id" "$HARNESS_CONTEXT_CLOSURE_MODE" \
		"$context_closure_status" "$context_closure_reason" \
		"$context_closure_bytes" "$context_closure_tokens" \
		"${compiled_context_closure_file:--}" >> "$closure_events"
	log_event "CONTEXT_CLOSURE_PREPARED task=$task_id mode=$HARNESS_CONTEXT_CLOSURE_MODE status=$context_closure_status condition=$context_closure_condition repair_action=$context_closure_repair_action repair_provider=$context_closure_repair_provider semantic_split=$context_closure_semantic_split reason=$context_closure_reason bytes=$context_closure_bytes estimated_tokens=$context_closure_tokens file=${compiled_context_closure_file:-none} log=$closure_build_log"
fi

session="$("$HARNESS_BIN/harness-new-session" "$HARNESS_ENV_FILE" worker)"
trace_event WORKER_SESSION_CREATED "task_id=$task_id" "session=$session"
claim_output="$("$HARNESS_BIN/worker-claim-task" "$HARNESS_ENV_FILE" "$task_id" "$session")"
task_file="$(printf '%s\n' "$claim_output" | awk -F= '$1 == "TASK_FILE" {sub(/^[^=]*=/, ""); print; exit}')"
[[ -f "$task_file" ]] || die "claimed task file is missing: $task_file"
if (( manager_remediation == 1 )); then
	assignment_is_manager_remediation "$task_file" ||
		die 'manager remediation metadata changed during task claim'
fi
initialize_task_progress "$task_id" "$task_file"
task_root="$(task_root_id "$task_id")"
plan_item_id="$(project_plan_item_for_root "$task_root")"
specification_obligations_path='-'
specification_relations_path='-'
specification_coverage_path='-'
allocated_specification_obligations='-'
if specification_ir_available; then
	specification_obligations_path="$(specification_obligations_file)"
	specification_relations_path="$(specification_relations_file)"
	specification_coverage_path="$(specification_coverage_file)"
	allocated_specification_obligations="$(specification_obligations_for_node "$plan_item_id" | paste -sd, -)"
	[[ -n "$allocated_specification_obligations" ]] || die "active DAG node has no normalized specification obligations: $plan_item_id"
fi
progress_file="$(task_progress_file "$task_root")"
root_assignment_file="$(task_root_assignment_file "$task_root")"
starting_progress="$(task_progress_percent "$task_root")"
development_policy_file=""
if (( manager_remediation == 1 )) && [[ -f "$REPOSITORY/design/development-policy.txt" ]]; then
	development_policy_file="$REPOSITORY/design/development-policy.txt"
fi
context_capsule_file="$(task_context_capsule_file "$task_id")"
superseded_task="$(metadata_value "$task_file" Supersedes-Task)"
requested_worker_context="$(metadata_value "$task_file" Worker-Context)"
leaf_type="$(metadata_value "$task_file" Leaf-Type)"
prior_episode_digest=""
if [[ "$superseded_task" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] &&
	[[ "$(task_root_id "$superseded_task")" == "$task_root" ]]; then
	prior_episode_digest="$dir/control/$(task_base "$superseded_task").worker-evidence-digest.md"
	[[ -f "$prior_episode_digest" ]] || prior_episode_digest=""
fi
validation_class="$(metadata_value "$task_file" Validation-Class)"
[[ -n "$validation_class" ]] || validation_class=FOCUSED
expected_agent_actions="$(metadata_value "$task_file" Expected-Max-Agent-Actions)"
expected_implementation_files="$(metadata_value "$task_file" Expected-Max-Implementation-Files)"
effective_p95_tokens="$(metadata_value "$task_file" Effective-P95-Tokens)"
[[ "$expected_agent_actions" =~ ^[1-9][0-9]*$ ]] || expected_agent_actions=0
[[ "$expected_implementation_files" =~ ^[0-9]+$ ]] || expected_implementation_files=0
[[ "$effective_p95_tokens" =~ ^[1-9][0-9]*$ ]] || effective_p95_tokens=0
if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
	[[ -f "$context_capsule_file" ]] || die "v2 context capsule is missing: $context_capsule_file"
else
	context_capsule_file=""
fi
trace_event WORKER_TASK_CLAIMED "task_id=$task_id" "session=$session" "task_file=$task_file"

worker_thread_file="$(worker_thread_state_file "$task_root")"
goal_mode=0
goal_state=""
goal_id=""
goal_target=""
goal_summary=""
goal_ledger=""
pending_semantic_review=0
if assignment_uses_goal_mode "$task_file"; then
	goal_mode=1
	(( HARNESS_WORKER_GOAL_MODE == 1 )) ||
		die 'an active LEAF_GOAL cannot run after HARNESS_WORKER_GOAL_MODE is disabled'
	goal_state="$(goal_state_file "$task_id")"
	goal_summary="$(goal_summary_file "$task_id")"
	goal_ledger="$(goal_iteration_ledger_file "$task_id")"
	[[ -f "$goal_state" && -f "$goal_ledger" ]] ||
		die "goal state is missing for task: $task_id"
	goal_id="$(kv_file_value "$goal_state" goal_id)"
	goal_target="$(kv_file_value "$goal_state" target_criterion)"
	goal_iteration_at_claim="$(kv_file_value "$goal_state" iteration_count 2>/dev/null || printf 0)"
	goal_marker_at_claim="$(goal_continue_marker_file "$task_id")"
	if (( HARNESS_SEMANTIC_CONTINUATION_REVIEW_ENABLED == 1 )) &&
		[[ "$goal_iteration_at_claim" =~ ^[1-9][0-9]*$ ]] &&
		[[ -f "$goal_marker_at_claim" ]] &&
		[[ "$(kv_file_value "$goal_marker_at_claim" iteration 2>/dev/null || true)" == "$goal_iteration_at_claim" ]] &&
		[[ ! -f "$(goal_continuation_decision_file "$task_id" "$goal_iteration_at_claim")" ]]; then
		# Upgrade/recovery compatibility: an older worker may have durably
		# published CONTINUE and then crashed or hit a resource fuse before this
		# semantic-review protocol existed. Review it before launching any worker.
		pending_semantic_review=1
		goal_state_set "$goal_state" state AWAITING_MANAGER_REVIEW
		goal_state_set "$goal_state" thread_id ""
		goal_state_set "$goal_state" thread_context awaiting-semantic-review
		goal_thread_store "$task_id" "" awaiting-semantic-review
	else
		goal_state_set "$goal_state" state RUNNING
	fi
	goal_state_set "$goal_state" active_session "$session"
	goal_state_set "$goal_state" updated_at "$(timestamp_utc)"
fi
worker_context_mode="fresh"
worker_context_reason="no_retained_thread"
worker_resume_thread_id=""
worker_thread_rejections=0
worker_last_outcome=""
if (( goal_mode == 1 )); then
	# Recovery publications carry an explicit context contract. Goal mode used
	# to override Worker-Context: FRESH and resume the rejected episode anyway,
	# causing a small verification leaf to repay the whole predecessor context.
	# Zero-write verification revisions are fresh by default for the same reason.
	if [[ "$requested_worker_context" == FRESH ]] ||
		[[ "$leaf_type" == VERIFICATION_ONLY ]]; then
		worker_resume_thread_id=""
		if [[ "$requested_worker_context" == FRESH ]]; then
			worker_context_reason="assignment_requested_fresh"
		else
			worker_context_reason="verification_only_fresh"
		fi
		goal_state_set "$goal_state" thread_id ""
		goal_state_set "$goal_state" thread_context "$worker_context_reason"
		goal_thread_store "$task_id" "" "$worker_context_reason"
	else
		worker_resume_thread_id="$(kv_file_value "$goal_state" thread_id 2>/dev/null || true)"
		if [[ "$worker_resume_thread_id" =~ ^[A-Za-z0-9-]+$ ]]; then
			worker_context_mode="resumed"
			worker_context_reason="same_leaf_goal"
		else
			worker_resume_thread_id=""
			worker_context_reason="$(kv_file_value "$goal_state" thread_context 2>/dev/null || printf goal_fresh)"
		fi
	fi
elif (( HARNESS_REUSE_WORKER_THREADS == 0 )); then
	worker_context_reason="reuse_disabled"
elif [[ "$task_id" == "$task_root" ]]; then
	worker_context_reason="new_root_task"
elif [[ "$requested_worker_context" == FRESH ]]; then
	worker_context_reason="assignment_requested_fresh"
elif [[ -f "$worker_thread_file" ]]; then
	worker_resume_thread_id="$(kv_file_value "$worker_thread_file" thread_id 2>/dev/null || true)"
	worker_thread_rejections="$(kv_file_value "$worker_thread_file" rejection_count 2>/dev/null || printf 0)"
	worker_last_outcome="$(kv_file_value "$worker_thread_file" last_outcome 2>/dev/null || true)"
	[[ "$worker_thread_rejections" =~ ^[0-9]+$ ]] || worker_thread_rejections=0
	if [[ ! "$worker_resume_thread_id" =~ ^[A-Za-z0-9-]+$ ]]; then
		worker_resume_thread_id=""
		worker_context_reason="invalid_retained_thread"
	elif (( HARNESS_WORKER_THREAD_MAX_REJECTIONS > 0 && worker_thread_rejections >= HARNESS_WORKER_THREAD_MAX_REJECTIONS )); then
		worker_resume_thread_id=""
		worker_context_reason="rejection_rotation_limit"
	else
		worker_context_mode="resumed"
		if [[ "$worker_last_outcome" == CHECKPOINT ]]; then
			worker_context_reason="same_root_checkpoint"
		else
			worker_context_reason="same_root_rejection"
		fi
	fi
fi

closure_mode=0
if (( HARNESS_CLOSURE_MODE_ENABLED == 1 )) &&
	[[ "$task_id" != "$task_root" ]] &&
	(( starting_progress >= HARNESS_CLOSURE_MODE_MIN_PROGRESS && starting_progress < 100 )); then
	closure_mode=1
fi
log_event "WORKER_CONTEXT_SELECTED task=$task_id root=$task_root mode=$worker_context_mode reason=$worker_context_reason thread_id=${worker_resume_thread_id:-none} retained_rejections=$worker_thread_rejections closure_mode=$closure_mode goal_mode=$goal_mode goal_id=${goal_id:--} execution_mode=$execution_mode"
trace_event WORKER_CONTEXT_SELECTED "task_id=$task_id" "task_root=$task_root" "mode=$worker_context_mode" "reason=$worker_context_reason" "thread_id=${worker_resume_thread_id:-}" "retained_rejections=$worker_thread_rejections" "closure_mode=$closure_mode" "goal_mode=$goal_mode" "goal_id=${goal_id:-}" "execution_mode=$execution_mode"

prompt_file="$dir/control/$base.worker.prompt.md"
patch_only_compact=0
patch_only_execution=0
if [[ "$HARNESS_CONTEXT_CLOSURE_MODE" == patch_only ]] &&
	(( luna_bounded_execution == 1 )) &&
	[[ "$leaf_type" != VERIFICATION_ONLY || "$expected_implementation_files" != 0 ]]; then
	patch_only_execution=1
	patch_only_compact=1
	cat > "$prompt_file.tmp.$$" <<PROMPT
You are the bounded Luna patch compiler for one authorized local repository task.

TASK_ID=$task_id
TASK_ROOT=$task_root
STARTING_PROGRESS_PERCENT=$starting_progress
CONTEXT_CLOSURE_STATUS=$context_closure_status
CONTEXT_EXPANSION_MAX_BYTES=$HARNESS_CONTEXT_EXPANSION_MAX_BYTES
MAX_CONTEXT_EXPANSIONS_PER_LEAF=$HARNESS_MAX_CONTEXT_EXPANSIONS_PER_LEAF
GOAL_ID=$goal_id
GOAL_TARGET_CRITERION=$goal_target
EXPECTED_MAX_IMPLEMENTATION_FILES=$expected_implementation_files
EFFECTIVE_P95_TOKENS=$effective_p95_tokens

The trusted harness has already claimed the task and compiled all source,
interface, test, build, flow, and normative evidence below. You have no tools.
Do not describe shell commands, repository searches, commits, or harness calls.
Preserve the exact baseline and Allowed-Scope. Solve only the embedded task.
For a terminal goal result include Goal-ID and exactly one Goal-Outcome:
COMPLETE, NEEDS_DECOMPOSITION, or HARD_BLOCKED. NEEDS_DECOMPOSITION also includes
one Decomposition-Reason: TASK_TOO_BROAD, CONTEXT_INCOMPLETE, SCOPE_INCOMPLETE,
VALIDATION_PREREQUISITE, or RESOURCE_LIMIT.
PROMPT
else
	cp "$HARNESS_HOME/prompts/worker-agent-event-driven.md" "$prompt_file.tmp.$$"
	cat >> "$prompt_file.tmp.$$" <<PROMPT

The worker protocol above is already loaded. Do not open or reread its source file.

HARNESS_BIN=$HARNESS_BIN
ENV_FILE=$HARNESS_ENV_FILE
PROJECT=$PROJECT
PROJECT_TMP_DIR=$PROJECT_TMP_DIR
REPOSITORY=$REPOSITORY
TASK_ID=$task_id
TASK_FILE=$task_file
TASK_ROOT=$task_root
ROOT_ASSIGNMENT_FILE=$root_assignment_file
PROGRESS_FILE=$progress_file
STARTING_PROGRESS_PERCENT=$starting_progress
DEVELOPMENT_POLICY_FILE=$development_policy_file
CONTEXT_CAPSULE_FILE=$context_capsule_file
CONTEXT_CLOSURE_MODE=$HARNESS_CONTEXT_CLOSURE_MODE
CONTEXT_CLOSURE_STATUS=$context_closure_status
CONTEXT_CLOSURE_FILE=$compiled_context_closure_file
SPECIFICATION_OBLIGATIONS_FILE=$specification_obligations_path
SPECIFICATION_RELATIONS_FILE=$specification_relations_path
SPECIFICATION_COVERAGE_FILE=$specification_coverage_path
ALLOCATED_SPECIFICATION_OBLIGATIONS=$allocated_specification_obligations
SESSION=$session
WORKER_CONTEXT_MODE=$worker_context_mode
WORKER_CONTEXT_REASON=$worker_context_reason
WORKER_RETAINED_REJECTIONS=$worker_thread_rejections
CLOSURE_MODE=$closure_mode
CLOSURE_MAX_FIXES=$HARNESS_CLOSURE_MODE_MAX_FIXES
CLOSURE_MAX_SMOKE_RUNS=$HARNESS_CLOSURE_MODE_MAX_SMOKE_RUNS
CONTEXT_EXPANSION_MAX_BYTES=$HARNESS_CONTEXT_EXPANSION_MAX_BYTES
MAX_CONTEXT_EXPANSIONS_PER_LEAF=$HARNESS_MAX_CONTEXT_EXPANSIONS_PER_LEAF
WORKER_GOAL_MODE=$goal_mode
ARCHITECTURE_GUARDS=$HARNESS_ARCHITECTURE_GUARDS
ARCHITECTURE_DIR=$(architecture_dir)
EXECUTION_MODE=$execution_mode
GOAL_ID=$goal_id
GOAL_TARGET_CRITERION=$goal_target
GOAL_STATE_FILE=$goal_state
GOAL_SUMMARY_FILE=$goal_summary
GOAL_ITERATION_LEDGER_FILE=$goal_ledger
GOAL_PROCESS_MAX_FIXES=$HARNESS_GOAL_PROCESS_MAX_FIXES
GOAL_PROCESS_MAX_SMOKE_RUNS=$HARNESS_GOAL_PROCESS_MAX_SMOKE_RUNS
VALIDATION_CLASS=$validation_class
VALIDATION_OUTPUT_POLICY=CAPTURE_SUMMARY
OUTPUT_MAX_LINES=$HARNESS_VALIDATION_OUTPUT_MAX_LINES
OUTPUT_MAX_BYTES=$HARNESS_VALIDATION_OUTPUT_MAX_BYTES
EXPECTED_MAX_AGENT_ACTIONS=$expected_agent_actions
EXPECTED_MAX_IMPLEMENTATION_FILES=$expected_implementation_files
EFFECTIVE_P95_TOKENS=$effective_p95_tokens

The task is already claimed by this launcher. For a v2 task, the complete bounded assignment and context capsule are embedded below. They are the worker's entire harness context: do not open DEVELOPMENT_POLICY_FILE, ROOT_ASSIGNMENT_FILE, PROGRESS_FILE, GOAL_SUMMARY_FILE, specification IR/coverage files, or other harness control files. Do not reread the embedded assignment or capsule through shell commands. Inspect only Context-Paths, Allowed-Scope, Required-Symbols, and repository files directly implicated by a bounded compiler/linker diagnostic. Legacy tasks without an embedded capsule may read their named task and progress files once.

When CONTEXT_CLOSURE_STATUS=READY, a deterministic repository-index closure is embedded after the normal capsule. Treat its exact definitions, interfaces, tests, and normative authority as the starting implementation context. Advisory mode does not remove repository access and does not broaden Allowed-Scope. If required evidence is absent, report that omission rather than compensating with repository-wide exploration.

The context boundary is enforceable. Direct rg/grep/find/sed inspection is limited to Context-Paths and Allowed-Scope, and every complete shell command must return at most OUTPUT_MAX_LINES lines and OUTPUT_MAX_BYTES bytes in aggregate. The cap applies to the combined stdout/stderr of the whole command, not separately to each command joined by a newline, semicolon, pipe, subshell, or logical operator. Inspect exactly one source file or one exact source window per agent action. A command that joins multiple source reads with logical operators, semicolons, a loop, or printed section markers is invalid even when all files are listed in Context-Paths. The embedded capsule's Required symbol locations are machine-derived repository coordinates: start at those coordinates and do not spend actions rediscovering them. Start from Required-Symbols in the smallest implicated file; do not dump every Context-Paths file or a whole large function as an initial survey. If one required symbol spans too much behavior to understand from one bounded local window, terminate NEEDS_DECOMPOSITION and name the exact sub-boundary needed instead of walking the file in successive broad windows. Do not concatenate multiple individually capped reads; issue one bounded read per agent action or wrap the entire compound command in one final head -n OUTPUT_MAX_LINES followed by head -c OUTPUT_MAX_BYTES. A line cap alone is invalid because minified/generated source can contain giant lines. Bound a source search before launching it with exact patterns, --max-count, rg --max-columns 512 --max-columns-preview, and a final head -c OUTPUT_MAX_BYTES; use a similarly explicit byte cap for non-rg output. An unbounded contextual search such as rg -C N PATTERN FILES is prohibited even across listed files because many matches multiply the context; inspect one exact line window and byte-cap it. Never print a repository-wide content search. If an exact required symbol is absent from the supplied context, one filename-only discovery command such as rg -l --fixed-strings SYMBOL BOUNDED_REPOSITORY_SUBTREE piped to head -n 20 is permitted; inspect only the smallest exact match. If more than one such discovery is needed, or a required contract still cannot be located, terminate with NEEDS_DECOMPOSITION and name the missing symbols/context paths. If a required test observation is absent from the supplied public/test surface and producing it requires a production contract outside Allowed-Scope, terminate HARD_BLOCKED immediately with that exact local prerequisite; do not consume the remaining episode on exploratory reads. Reserve at least one action for a source edit and one for focused validation. If the remaining action budget cannot reach both, terminate NEEDS_DECOMPOSITION with the missing implementation-ready fact. Interpret diagnostic values according to their declared source type: a field such as has_two_devices=1 is a true boolean, not a one-device count. Do not use broad exploration to repair an incomplete planner capsule. Create any new build tree under PROJECT_TMP_DIR; an existing configured build tree may be consumed, but do not create an untracked build directory in REPOSITORY.

When required Context Closure is READY but one exact decisive read fact is absent,
request it before any discovery search by ending the turn with no result and:

Context-Request-Kind: TYPE_DEFINITION|SYMBOL_DEFINITION|CALLER_CONTRACT|CALLEE_CONTRACT|FAILING_ASSERTION|TEST_TARGET|TEST_OWNER|BUILD_TARGET|BUILD_OWNER|OWNER|PRODUCER|CONSUMER|REPRESENTATION_WRITER
Context-Request-Identifier: one exact symbol, test, or declared path
Context-Request-Reason: one sentence explaining why that fact is decisive

The deterministic broker admits only an assignment seed or direct indexed
neighbor and resumes this thread with a bounded artifact. Never request broad
search results or use repository exploration as a substitute for a denied fact.

Preserve verified work and continue from STARTING_PROGRESS_PERCENT rather than reimplementing the root task from zero. Implement exactly the remaining bounded assignment. Run build and test validation through this command so complete output is retained on disk and only a bounded summary enters this transcript:

$HARNESS_BIN/harness-run-assigned-validation "$HARNESS_ENV_FILE" "$task_id" LABEL

Use that command when Focused-Validation is executable. When it is descriptive, run a concrete validation through harness-run-logged. A compound command must be passed as one quoted /bin/bash -lc argument; placing a logical operator after the harness-run-logged invocation is forbidden because the following command escapes capture. Never invoke a potentially verbose build/test command directly. Validation-Class CLEAN_GLOBAL authorizes observation only in a Terra integration leaf; it never broadens implementation scope. Commit every task-owned source/source-related change with harness-commit-source before a terminal result. Use harness-publish-branch when Publish-Branch is declared. Never run direct Git index/history mutations. Generated output, object files, binaries, ignored files, and paths outside Allowed-Scope must remain uncommitted. Write scratch files and the result report under PROJECT_TMP_DIR, publish the result with worker-complete-task, and terminate. If an exact mandatory cross-harness Git ref is absent, use worker-wait-dependency with a precise requirements TSV and supplier note instead of repeating absence audits or claiming gain. Do not wait for another task.
PROMPT
fi
# CONTEXT_CLOSURE_MODE describes the project policy.  The launcher may exempt a
# zero-write VERIFICATION_ONLY leaf from patch compilation while retaining the
# required compiled capsule.  Publish the effective per-invocation decision so
# codex-exec-jsonl does not infer repository isolation from the broader policy.
printf '\nPATCH_ONLY_EXECUTION=%s\n' "$patch_only_execution" >> "$prompt_file.tmp.$$"
if (( patch_only_execution == 1 )); then
	cat >> "$prompt_file.tmp.$$" <<'PROMPT'

Patch-only Context Closure execution is active. The compiled closure below is the complete implementation context. Do not use shell, filesystem, web, search, or repository tools. Do not attempt to call harness commands. Reason only from the embedded task and closure. Your final response must contain exactly one fenced `diff` block containing a standard `diff --git` patch, followed by the normal worker-result metadata and headings. The trusted harness will validate scope, baseline, patch syntax, apply it, run Focused-Validation, and commit accepted source changes. If the closed evidence is insufficient, emit no patch and report Goal-Outcome: NEEDS_DECOMPOSITION with Decomposition-Reason: CONTEXT_INCOMPLETE.

After the patch, emit `# Worker Task Result`, Task-ID, `Status: COMPLETED`,
Goal-ID/Goal-Outcome when configured, and the impact fields
Changed-Public-Symbols, Changed-Representations, Changed-Ownership,
Changed-Serialization, Changed-Dependencies, Affected-Invariants, and
Affected-Edges (use `-` when empty). Then emit nonempty `## Summary`,
`## Modified files`, `## Implemented behavior`, `## Validation performed`,
`## Deviations from assignment`, `## Remaining concerns`, and
`## Worker assessment` sections. Do not claim validation execution; the trusted
harness performs it after applying the patch.

Before reporting CONTEXT_INCOMPLETE, you may request exactly one missing fact by emitting no patch and exactly these metadata lines:

Context-Request-Kind: TYPE_DEFINITION|SYMBOL_DEFINITION|CALLER_CONTRACT|CALLEE_CONTRACT|FAILING_ASSERTION|TEST_TARGET|TEST_OWNER|BUILD_TARGET|BUILD_OWNER|OWNER|PRODUCER|CONSUMER|REPRESENTATION_WRITER
Context-Request-Identifier: one exact symbol, test, or declared path
Context-Request-Reason: one sentence explaining why that fact is decisive

The trusted harness accepts only an assignment seed or its direct indexed graph neighbor, compiles a bounded provenance-bearing extension, and resumes this same thread. Do not request broad files, searches, or multiple identifiers. The per-leaf maximum is HARNESS_MAX_CONTEXT_EXPANSIONS_PER_LEAF from the execution header.

If the evidence instead proves that this leaf needs mutation authority outside
Allowed-Scope, a repository-local prerequisite, or semantic subdivision, emit
no patch and exactly these lines:

ACP-Request-Type: SCOPE|PREREQUISITE|SPLIT|CHALLENGE|CANCEL
ACP-Request-Kind: one short machine-readable classification
ACP-Request-Identifier: one exact path, prerequisite criterion, or split boundary
ACP-Request-Reason: one sentence citing the decisive supplied evidence

These are untrusted claims. The harness records them, releases this ephemeral
Luna process, and sends them through policy/manager adjudication. Never grant
yourself scope, invent a dependency edge, or continue exploring after a request.
PROMPT
fi
if (( HARNESS_ACP_ENABLED == 1 && luna_bounded_execution == 1 )) &&
	(( patch_only_execution == 0 )); then
	cat >> "$prompt_file.tmp.$$" <<'PROMPT'

ACP negotiated readiness is active. If supplied evidence proves that this leaf
needs mutation authority outside Allowed-Scope, a repository-local prerequisite,
or semantic subdivision, do not broaden the task. End the turn without a normal
result and emit exactly:

ACP-Request-Type: SCOPE|PREREQUISITE|SPLIT|CHALLENGE|CANCEL
ACP-Request-Kind: one short machine-readable classification
ACP-Request-Identifier: one exact path, prerequisite criterion, or split boundary
ACP-Request-Reason: one sentence citing the decisive bounded evidence

The request is an untrusted claim. The harness records it, releases this
ephemeral process, and routes it through authority/decomposition policy. It is
not permission to inspect more files, add a dependency edge, or change scope.
PROMPT
fi
if (( manager_remediation == 1 )); then
	remediation_scope="$(require_single_metadata_value "$task_file" Remediation-Scope 'manager remediation assignment')"
	remediation_class="$(require_single_metadata_value "$task_file" Blocker-Class 'manager remediation assignment')"
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Manager baseline-remediation execution is active because ordinary bounded worker strategies reached a local coding/build/integration/ownership blocker. You are running with the manager model specifically to repair that prerequisite, not merely to describe it.

Blocker class: $remediation_class
Authorized remediation scope: $remediation_scope

You may edit the directly implicated local files in Remediation-Scope even if an ordinary worker ownership rule, exclusive-file list, forbidden-file list, baseline label, or prior Allowed-Scope excluded them. The harness records these paths as manager baseline remediation, separate from the feature worker's owned implementation delta. Diagnose from current compiler, linker, test, and repository evidence; make the smallest complete repair; then validate the original Target-Criterion without weakening its observable behavior. Do not alter the specification, acceptance behavior, unrelated APIs/behavior, external systems, credentials, or authorization boundaries. A normal source, build, test, integration, or file-ownership defect is resolvable here and is not a reason to request human intervention.
PROMPT
fi
if (( goal_mode == 1 && patch_only_compact == 0 )); then
	goal_iteration="$(kv_file_value "$goal_state" iteration_count)"
	goal_boundary="$(kv_file_value "$goal_state" last_boundary)"
	goal_workspace="$(kv_file_value "$goal_state" last_workspace)"
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Leaf-goal execution is active. This is one logical goal for the independently verifiable criterion GOAL_TARGET_CRITERION, even if it requires several Codex turns. For a legacy task only, read GOAL_SUMMARY_FILE and GOAL_ITERATION_LEDGER_FILE once when they contain prior iterations. A v2 task already embeds the current bounded state and must not reread those harness files. Continue diagnosing, implementing, and running focused validation until exactly one of these terminal outcomes is true:

- COMPLETE: the goal success evidence and focused validation in TASK_FILE pass.
- NEEDS_DECOMPOSITION: the criterion is still too broad, the supplied bounded context is incomplete, mutation authority omits the actual seam, validation has an upstream prerequisite, or repeated strategy attempts cannot make material movement. Add exactly one "Decomposition-Reason: TASK_TOO_BROAD|CONTEXT_INCOMPLETE|SCOPE_INCOMPLETE|VALIDATION_PREREQUISITE|RESOURCE_LIMIT" line. Use CONTEXT_INCOMPLETE only when Allowed-Scope remains correct and exact additional Context-Paths/Required-Symbols would make the same leaf implementation-ready. Use SCOPE_INCOMPLETE only when the required edit lies outside Allowed-Scope. Use VALIDATION_PREREQUISITE when the assigned command cannot reach its named test boundary until a build/test prerequisite is repaired.
- HARD_BLOCKED: an explicit Hard-Block-Conditions boundary in TASK_FILE is actually met.

Current durable iteration: $goal_iteration
Current boundary: $goal_boundary
Current workspace fingerprint: $goal_workspace

When another bounded turn is useful, write a receipt under PROJECT_TMP_DIR with exactly one Task-ID, Goal-ID, Iteration, Outcome: CONTINUE, Boundary-Before, Boundary-After, Workspace-Fingerprint-Before, and Workspace-Fingerprint-After line, plus nonempty sections named "## Progress made", "## Validation performed", "## Next bounded action", and "## Scope check". Iteration must be $((goal_iteration + 1)); the before values must equal the current durable values above. Obtain the exact after value with:

$HARNESS_BIN/harness-workspace-fingerprint "$HARNESS_ENV_FILE"

Publish the receipt with:

$HARNESS_BIN/worker-continue-task "$HARNESS_ENV_FILE" "$task_id" "$session" RECEIPT_FILE

After that command succeeds, end this Codex turn. The harness will review the semantic boundary and either start a fresh implementation episode for the same logical goal or return the leaf to decomposition. A CONTINUE receipt must record a changed boundary, changed workspace, or genuinely new evidence/strategy. If evidence shows that the assigned failure premise is false, that an upstream prerequisite owns the actual failure, or that the next work exceeds this leaf's authority, state that plainly in "Next bounded action" and stop; do not broaden the leaf on your own. Process-local work should stay within $HARNESS_GOAL_PROCESS_MAX_FIXES small corrections and $HARNESS_GOAL_PROCESS_MAX_SMOKE_RUNS focused smoke executions before publishing CONTINUE.

For a terminal result, include "Goal-ID: $goal_id" and exactly one "Goal-Outcome: COMPLETE|NEEDS_DECOMPOSITION|HARD_BLOCKED". A NEEDS_DECOMPOSITION result also includes exactly one typed Decomposition-Reason line as defined above. Retain the normal worker result headings, publish it with worker-complete-task, and terminate. Do not use NEEDS_DECOMPOSITION merely because another ordinary diagnostic/fix turn is required. Do not use HARD_BLOCKED for test failure, complexity, token pressure, or lack of immediate progress.
PROMPT
fi
if (( closure_mode == 1 && patch_only_compact == 0 )); then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Bounded closure mode is active because this continuation starts at ${starting_progress}%. Within this one turn, close the same focused root acceptance gate using at most $HARNESS_CLOSURE_MODE_MAX_FIXES small evidence-backed corrections and at most $HARNESS_CLOSURE_MODE_MAX_SMOKE_RUNS total executions of the assigned focused smoke. A manager-authored phrase such as "exactly once" or "do not rerun" does not reduce this closure budget; the human-owned specification and immutable root scope remain authoritative.

Start with the current first failure. Diagnose before editing, apply only the smallest correction directly implicated by that failure, rebuild the affected target, and use the next focused-smoke execution. Repeat only while the failure remains inside TASK_ROOT and the correction does not require a new public API, new scope, relaxed acceptance criterion, fabricated fallback, increased capacity without evidence, or an explicitly prohibited file/behavior. A directly implicated additional root-scope implementation file may be changed when the runtime diagnostic or stack proves it necessary; record why it is inside the closure boundary. Stop immediately on a passing smoke, exhausted budget, an out-of-root failure, or a required design/authority choice. Never substitute broad tests for the single focused gate. Report the exact number of fixes and smoke executions.
PROMPT
fi
if codex_model_requires_narrow_prompt "$execution_model"; then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Context: authorized local development in my own repository. Task type: benign software engineering. Do not perform offensive security, credential extraction, vulnerability exploitation, malware behavior, unauthorized access, network scanning, or bypassing security controls. Use only the listed local project files needed for the requested implementation: TASK_FILE and the files explicitly referenced by that bounded assignment.
PROMPT
fi
if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
	{
		if [[ -n "$prior_episode_digest" ]] && (( patch_only_compact == 0 )); then
			printf '\n## Immediate predecessor evidence\n\n'
			printf 'This bounded digest is execution continuity, not additional scope. Begin with the next missing fact or implementation action. One redundant predecessor source-read is tolerated and logged; a second exact repeated inspection command terminates this episode as context amplification.\n\n'
			cat "$prior_episode_digest"
		fi
		printf '\n## Embedded bounded assignment\n\n'
		cat "$task_file"
		if (( patch_only_compact == 0 )); then
			printf '\n## Embedded bounded context capsule\n\n'
			cat "$context_capsule_file"
		fi
		if [[ -n "$compiled_context_closure_file" ]]; then
			printf '\n## Embedded compiled Context Closure (%s)\n\n' "$HARNESS_CONTEXT_CLOSURE_MODE"
			cat "$compiled_context_closure_file"
		fi
		printf '\n## End embedded worker context\n'
	} >> "$prompt_file.tmp.$$"
fi
chmod 600 "$prompt_file.tmp.$$"
mv "$prompt_file.tmp.$$" "$prompt_file"

result="$dir/results/$base.result.md"
running="$dir/running/$base.running.md"
lease="$dir/control/$base.lease"
assignment_archive="$dir/archive/$base.assignment.md"
staged_result="$dir/control/$base.direct-result.$$"
protocol_reason=""
json_log=""
stderr_log=""
classification=""
