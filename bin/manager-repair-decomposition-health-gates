#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
project_plan_exists && { printf 'Decomposition DAG already exists.\n'; exit 0; }
decomposition_candidate_matches_current_inputs || die 'no current full decomposition candidate exists'
[[ "$(decomposition_candidate_state_value status)" == REJECTED ]] ||
	die 'health-gate repair requires a rejected candidate'

candidate_dir="$(decomposition_candidate_state_value directory)"
architecture_source="$(decomposition_candidate_state_value architecture_directory -)"
rejection_log="$(decomposition_candidate_state_value rejection_log "$candidate_dir/rejection.log")"
[[ "$architecture_source" != - && -d "$architecture_source" ]] ||
	die 'health-gate repair requires an architecture registry'
grep -Eq 'invalid health gate|health gate .* (cannot depend on its own trigger node|is bound to node .* but declares trigger node|depends on unknown node|is absent from trigger binding)' "$rejection_log" ||
	die 'candidate rejection is not a mechanically repairable health-gate defect'

repair_dir="$PROJECT_TMP_DIR/decomposition-health-gate-repair-${candidate_dir##*/}"
rm -rf -- "$repair_dir"
mkdir -p "$repair_dir/architecture"
install -m 600 "$candidate_dir/dag.tsv" "$repair_dir/dag.tsv"
install -m 600 "$candidate_dir/coverage.tsv" "$repair_dir/coverage.tsv"
for name in invariants decisions edges debt; do
	install -m 600 "$architecture_source/$name.tsv" "$repair_dir/architecture/$name.tsv"
done

awk -F '\t' -v OFS='\t' '
	function trim(v) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", v); return v }
	NR == FNR {
		if (FNR > 1) trigger[$1]=$2
		next
	}
	FNR == 1 { print; next }
	{
		if ($5 == "HIGH" || $5 == "MUST" || $5 == "HARD" || $5 == "REQUIRED") $5="CRITICAL"
		else if ($5 != "CRITICAL" && $5 != "WARNING") $5="WARNING"
		n=split($3,a,","); out=""
		for (i=1;i<=n;i++) {
			dep=trim(a[i]); if (dep == "" || dep == "-") continue
			if (dep in trigger) dep=trigger[dep]
			if (dep == $2 || seen[dep]) continue
			seen[dep]=1; out=(out == "" ? dep : out "," dep)
		}
		delete seen
		$3=(out == "" ? "-" : out)
		print
	}
' "$architecture_source/health-gates.tsv" "$architecture_source/health-gates.tsv" \
	> "$repair_dir/architecture/health-gates.tsv"
chmod 600 "$repair_dir/architecture/health-gates.tsv"

awk -F '\t' -v OFS='\t' '
	function trim(v) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", v); return v }
	NR == FNR {
		if (FNR > 1) { trigger[$1]=$2; triggered[$2]=(triggered[$2] == "" ? $1 : triggered[$2] "," $1) }
		next
	}
	FNR == 1 { print; next }
	{
		n=split($6,a,","); out=""
		for (i=1;i<=n;i++) {
			gate=trim(a[i]); if (gate == "" || gate == "-") continue
			if ((gate in trigger) && trigger[gate] == $1 && !seen[gate]) {
				seen[gate]=1; out=(out == "" ? gate : out "," gate)
			}
		}
		n=split(triggered[$1],a,",")
		for (i=1;i<=n;i++) {
			gate=trim(a[i]); if (gate == "" || seen[gate]) continue
			seen[gate]=1; out=(out == "" ? gate : out "," gate)
		}
		delete seen
		$6=(out == "" ? "-" : out)
		print
	}
' "$repair_dir/architecture/health-gates.tsv" "$architecture_source/node-bindings.tsv" \
	> "$repair_dir/architecture/node-bindings.tsv"
chmod 600 "$repair_dir/architecture/node-bindings.tsv"

set +e
"$HARNESS_BIN/manager-submit-decomposition" "$HARNESS_ENV_FILE" \
	"$repair_dir/dag.tsv" "$repair_dir/coverage.tsv" "$repair_dir/architecture"
status=$?
set -e
if project_plan_exists; then
	log_event "DECOMPOSITION_HEALTH_GATES_REPAIRED source=$candidate_dir"
	printf 'Architecture health gates normalized and installed.\n'
	exit 0
fi
new_candidate_dir="$(decomposition_candidate_state_value directory -)"
if [[ "$new_candidate_dir" != - && "$new_candidate_dir" != "$candidate_dir" ]] &&
	decomposition_candidate_matches_current_inputs; then
	log_event "DECOMPOSITION_HEALTH_GATES_PROGRESS previous=${candidate_dir##*/} current=${new_candidate_dir##*/} status=$(decomposition_candidate_state_value status -)"
	printf 'Architecture health gates normalized; continuing with the next bounded diagnostic.\n'
	exit 0
fi
(( status == 0 )) && die 'health-gate normalization returned success without installing or advancing the candidate'
die "health-gate normalization failed with status $status"
