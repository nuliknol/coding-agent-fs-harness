#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || die "Usage: ${0##*/} ENV_FILE"
load_harness_env "$1"
require_dependencies
mkdir -p "$HARNESS_ROOT"
exec 9>"$HARNESS_ROOT/.init.lock"
flock -x 9
initialize_project
log_event "PROJECT_INITIALIZED repository=$REPOSITORY specification=$SPECIFICATION policy=$DEVELOPMENT_POLICY"

printf 'Initialized light harness project %s\n' "$PROJECT"
printf 'State: %s\n' "$(project_dir)"
printf 'Repository: %s\n' "$REPOSITORY"
printf 'Manager: %s (%s)\n' "$MANAGER_MODEL" "$MANAGER_REASONING_EFFORT"
printf 'Worker: %s (%s)\n' "$WORKER_MODEL" "$WORKER_REASONING_EFFORT"
