#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE VERDICT_FILE [ADDENDUM_FILE]\n' "${0##*/}" >&2
	exit 2
}

[[ $# -ge 2 && $# -le 3 ]] || usage
load_harness_env "$1"
verdict="$2"
addendum="${3:-}"
ensure_project
require_registered_specification_ir
oracle_enabled || die 'Oracle is disabled for this environment'
[[ -f "$verdict" ]] || die "verdict file does not exist: $verdict"
[[ -z "$addendum" || -f "$addendum" ]] || die "addendum file does not exist: $addendum"
acquire_project_lock

pending="$(project_oracle_pending_file)"
[[ -f "$pending" ]] || die 'no Oracle audit is pending'
audit_id="$(awk -F': ' '$1 == "Audit-ID" {print $2; exit}' "$pending")"
[[ "$audit_id" =~ ^[1-9][0-9]*$ ]] || die 'pending Oracle audit has no valid Audit-ID'
decision="$(awk -F': ' '$1 == "Decision" {print $2; exit}' "$verdict")"
[[ "$decision" == PASS || "$decision" == FAIL ]] || die 'Oracle verdict Decision must be PASS or FAIL'
IFS= read -r verdict_header < "$verdict" || die 'Oracle verdict is empty'
[[ "$verdict_header" == '# Oracle Audit Verdict' ]] || die 'Oracle verdict must begin with # Oracle Audit Verdict'
grep -Fqx '## Traceability verification' "$verdict" || die 'Oracle verdict lacks traceability verification'
if specification_ir_available; then
	grep -Fqx '## Specification IR verification' "$verdict" || die 'Oracle verdict lacks Specification IR verification'
fi
grep -Fqx '## Acceptance verification' "$verdict" || die 'Oracle verdict lacks acceptance verification'
if (( HARNESS_ARCHITECTURE_GUARDS == 1 )); then
	grep -Fqx '## Architecture verification' "$verdict" || die 'Oracle verdict lacks architecture verification'
	grep -Fqx '## Debt verification' "$verdict" || die 'Oracle verdict lacks debt verification'
fi
grep -Fqx '## Findings' "$verdict" || die 'Oracle verdict lacks findings'
grep -Fqx '## Conclusion' "$verdict" || die 'Oracle verdict lacks conclusion'

validate_specification_ir_verdict_section()
{
	local obligations_file obligation_id line result evidence observed=0
	local -A required=() seen=()
	obligations_file="$(specification_obligations_file)"
	while IFS=$'\t' read -r obligation_id _; do
		[[ "$obligation_id" != obligation_id && -n "$obligation_id" ]] || continue
		required[$obligation_id]=1
	done < "$obligations_file"
	while IFS= read -r line; do
		[[ -n "$line" ]] || continue
		if [[ "$line" =~ ^-[[:space:]]\[(PASS|FAIL)\][[:space:]]([^[:space:]]+)[[:space:]]—[[:space:]](.+)$ ]]; then
			result="${BASH_REMATCH[1]}"
			obligation_id="${BASH_REMATCH[2]}"
			evidence="${BASH_REMATCH[3]}"
		else
			die "Oracle Specification IR verification contains a malformed row: $line"
		fi
		[[ -n "${required[$obligation_id]:-}" ]] || die "Oracle verdict references unknown normalized obligation: $obligation_id"
		[[ -z "${seen[$obligation_id]:-}" ]] || die "Oracle verdict repeats normalized obligation: $obligation_id"
		[[ -n "$evidence" ]] || die "Oracle verdict lacks evidence for normalized obligation: $obligation_id"
		[[ "$decision" != PASS || "$result" == PASS ]] || die "Oracle PASS contains a failed normalized obligation: $obligation_id"
		seen[$obligation_id]="$result"
		observed=$((observed + 1))
	done < <(awk '$0 == "## Specification IR verification" {inside=1; next} inside && /^## / {exit} inside {print}' "$verdict")
	for obligation_id in "${!required[@]}"; do
		[[ -n "${seen[$obligation_id]:-}" ]] || die "Oracle verdict lacks independently reproduced evidence for obligation: $obligation_id"
	done
	(( observed == ${#required[@]} )) || die 'Oracle verdict does not contain exactly one row per normalized obligation'
}

if specification_ir_available; then
	validate_specification_ir_verdict_section
fi

oracle_dir="$(project_oracle_dir)"
mkdir -p "$oracle_dir"
archive="$oracle_dir/audit-$audit_id.md"
install -m 600 "$verdict" "$archive"

if [[ "$decision" == PASS ]]; then
	[[ -z "$addendum" ]] || die 'a PASS Oracle verdict must not include an addendum'
	project_plan_all_complete || die 'Oracle PASS is only valid when every plan item is complete'
	specification_coverage_completion_ready || die 'Oracle PASS is only valid when normalized specification coverage is complete'
	if (( HARNESS_ARCHITECTURE_GUARDS == 1 )); then
		awk '$0=="## Architecture verification" {inside=1; next} inside && /^## / {exit} inside && /^- \[PASS\] .+ — .+/ {ok=1} END {exit !ok}' "$verdict" || die 'Oracle PASS lacks concrete architecture PASS evidence'
		awk '$0=="## Debt verification" {inside=1; next} inside && /^## / {exit} inside && /^- \[PASS\] .+ — .+/ {ok=1} END {exit !ok}' "$verdict" || die 'Oracle PASS lacks concrete debt PASS evidence'
		architecture_require_completion_ready
	fi
	rm -f "$pending"
	mark_project_complete "oracle-audit-$audit_id" "$archive"
	log_event "ORACLE_AUDIT_PASSED audit_id=$audit_id verdict=$archive"
	printf '%s\n' "$archive"
	exit 0
fi

[[ -n "$addendum" ]] || die 'a FAIL Oracle verdict requires an addendum'
authority="$(awk -F': ' '$1 == "Remediation-Authority" {print $2; exit}' "$addendum")"
[[ "$authority" == AUTOMATIC || "$authority" == HUMAN_APPROVAL ]] || die 'addendum Remediation-Authority must be AUTOMATIC or HUMAN_APPROVAL'
grep -Eq '^Original-Requirement-ID: .+' "$addendum" || die 'addendum must identify an original requirement'
human_dependency_class=""
human_dependency_evidence=""
product_decision_evidence=""
if [[ "$authority" == HUMAN_APPROVAL ]]; then
	human_dependency_class="$(require_single_metadata_value "$addendum" Human-Dependency-Class 'HUMAN_APPROVAL Oracle addendum')"
	human_dependency_evidence="$(require_single_metadata_value "$addendum" Human-Dependency-Evidence 'HUMAN_APPROVAL Oracle addendum')"
	hard_block_class_is_human "$human_dependency_class" ||
		die 'HUMAN_APPROVAL requires Human-Dependency-Class: HUMAN_AUTHORIZATION|HUMAN_SECRET|HUMAN_EXTERNAL_STATE|HUMAN_PRODUCT_SPECIFICATION; repository-local scope, ownership, build, testability, integration, and baseline prerequisites are AUTOMATIC'
	if [[ "$human_dependency_class" == HUMAN_PRODUCT_SPECIFICATION ]]; then
		product_decision_evidence="$(require_single_metadata_value "$addendum" Product-Decision-Evidence 'HUMAN_PRODUCT_SPECIFICATION Oracle addendum')"
	fi
fi
addendum_archive="$oracle_dir/addendum-$audit_id.md"
install -m 600 "$addendum" "$addendum_archive"

if [[ "$authority" == HUMAN_APPROVAL ]]; then
	block="$(project_block_file)"
	tmp="$block.tmp.$$"
	{
		printf '# Oracle Approval Required\n\n'
		printf 'Project: %s\n\n' "$PROJECT"
		printf 'Audit-ID: %s\n\n' "$audit_id"
		printf 'Verdict: %s\n\n' "$archive"
		printf 'Addendum: %s\n\n' "$addendum_archive"
		printf 'Human-Dependency-Class: %s\n\n' "$human_dependency_class"
		printf 'Human-Dependency-Evidence: %s\n\n' "$human_dependency_evidence"
		if [[ "$human_dependency_class" == HUMAN_PRODUCT_SPECIFICATION ]]; then
			printf 'Product-Decision-Evidence: %s\n\n' "$product_decision_evidence"
		fi
		printf 'Blocked-At: %s\n' "$(timestamp_utc)"
	} > "$tmp"
	chmod 600 "$tmp"
	mv "$tmp" "$block"
	rm -f "$pending"
	log_event "ORACLE_AUDIT_BLOCKED audit_id=$audit_id human_dependency_class=$human_dependency_class verdict=$archive addendum=$addendum_archive"
	printf '%s\n' "$block"
	exit 0
fi

definition="$(project_plan_definition_file)"
state="$(project_plan_state_file)"
dag="$(project_decomposition_plan_file)"
binding="$(architecture_node_bindings_file)"
coverage="$(specification_coverage_file)"
complexity="$(decomposition_complexity_report_file)"
items_tmp="$oracle_dir/addendum-$audit_id.items.tsv"
nodes_tmp="$oracle_dir/addendum-$audit_id.nodes.tsv"
bindings_tmp="$oracle_dir/addendum-$audit_id.bindings.tsv"
awk '
	$0 == "## Harness plan items" {inside = 1; next}
	inside && /^## / {exit}
	inside && $0 !~ /^#/ && index($0, "\t") {print}
' "$addendum" > "$items_tmp"
[[ -s "$items_tmp" ]] || die 'automatic addendum must include tab-separated items under ## Harness plan items'

definition_tmp="$definition.tmp.$$"
state_tmp="$state.tmp.$$"
dag_tmp="$dag.tmp.$$"
binding_tmp="$binding.tmp.$$"
coverage_tmp="$coverage.tmp.$$"
complexity_tmp="$complexity.tmp.$$"
cleanup_candidates()
{
	rm -f "$definition_tmp" "$state_tmp" "$dag_tmp" "$binding_tmp" "$coverage_tmp" "$complexity_tmp"
}
trap cleanup_candidates EXIT
cp "$definition" "$definition_tmp"
cp "$state" "$state_tmp"
declare -A oracle_item_titles=()
while IFS=$'\t' read -r item_id title extra || [[ -n "${item_id:-}${title:-}${extra:-}" ]]; do
	[[ -n "${item_id:-}" && -n "${title:-}" && -z "${extra:-}" ]] || die 'invalid Oracle addendum plan item'
	[[ "$item_id" =~ ^ORACLE-[A-Za-z0-9._-]+$ ]] || die 'automatic Oracle item IDs must begin with ORACLE-'
	[[ -z "${oracle_item_titles[$item_id]:-}" ]] || die "duplicate Oracle addendum plan item: $item_id"
	! awk -F '\t' -v item="$item_id" '!/^#/ && $1 == item {found=1} END {exit found ? 0 : 1}' "$definition" || die "duplicate Oracle plan item: $item_id"
	oracle_item_titles[$item_id]="$title"
	printf '%s\t%s\n' "$item_id" "$title" >> "$definition_tmp"
	printf '%s\tPENDING\t-\t%s\n' "$item_id" "$(timestamp_utc)" >> "$state_tmp"
done < "$items_tmp"

if project_plan_uses_dag; then
	awk '
		$0 == "## Harness decomposition nodes" {inside = 1; next}
		inside && /^## / {exit}
		inside && $0 !~ /^#/ && index($0, "\t") {print}
	' "$addendum" > "$nodes_tmp"
	[[ -s "$nodes_tmp" ]] || die 'automatic addendum for a decomposition project must include matching rows under ## Harness decomposition nodes'
	cp "$dag" "$dag_tmp"
	dag_header="$(sed -n '1p' "$dag")"
	typed_header=$'node_id\tparent_id\tdepends_on\tdeliverable\tacceptance_evidence\tfocused_validation\tallowed_paths\trequired_symbols\tleaf_type\tcomplexity_class\tworker_route'
	complexity_header="$(decomposition_complexity_header)"
	legacy_header=$'node_id\tparent_id\tdepends_on\tdeliverable\tacceptance_evidence\tfocused_validation\tallowed_paths\trequired_symbols\tcomplexity_class\tworker_route'
	if [[ "$dag_header" == "$complexity_header" ]]; then
		expected_fields=20
	elif [[ "$dag_header" == "$typed_header" ]]; then
		expected_fields=11
	elif [[ "$dag_header" == "$legacy_header" ]]; then
		expected_fields=10
	else
		die 'existing decomposition DAG has an unsupported header'
	fi
	declare -A known_nodes=() oracle_nodes=()
	while IFS=$'\t' read -r existing_node _; do
		[[ "$existing_node" != node_id && -n "$existing_node" ]] && known_nodes[$existing_node]=1
	done < "$dag"
	while IFS=$'\t' read -r -a fields; do
		(( ${#fields[@]} == expected_fields )) || die "Oracle decomposition row must contain exactly $expected_fields tab-separated fields"
		node_id="${fields[0]}"; parent_id="${fields[1]}"; depends_on="${fields[2]}"
		deliverable="${fields[3]}"; acceptance_evidence="${fields[4]}"; focused_validation="${fields[5]}"
		allowed_paths="${fields[6]}"; required_symbols="${fields[7]}"
		if (( expected_fields == 20 || expected_fields == 11 )); then
			leaf_type="${fields[8]}"; complexity_class="${fields[9]}"; worker_route="${fields[10]}"
		else
			leaf_type=""; complexity_class="${fields[8]}"; worker_route="${fields[9]}"
		fi
		[[ -n "${oracle_item_titles[$node_id]:-}" ]] || die "Oracle decomposition node has no matching plan item: $node_id"
		[[ -z "${oracle_nodes[$node_id]:-}" && -z "${known_nodes[$node_id]:-}" ]] || die "duplicate Oracle decomposition node: $node_id"
		[[ "$deliverable" == "${oracle_item_titles[$node_id]}" ]] || die "Oracle decomposition deliverable does not match its plan item title: $node_id"
		[[ "$parent_id" == - || -n "${known_nodes[$parent_id]:-}" ]] || die "Oracle decomposition parent must precede node $node_id: $parent_id"
		[[ -n "$depends_on" ]] || die "Oracle decomposition node has empty depends_on: $node_id"
		if [[ "$depends_on" != - ]]; then
			IFS=',' read -r -a dependencies <<< "$depends_on"
			for dependency in "${dependencies[@]}"; do
				[[ -n "${known_nodes[$dependency]:-}" ]] || die "Oracle decomposition dependency must precede node $node_id: $dependency"
			done
		fi
		[[ -n "$acceptance_evidence" && -n "$focused_validation" ]] || die "Oracle decomposition node lacks acceptance evidence or focused validation: $node_id"
		[[ -n "$allowed_paths" && "$allowed_paths" != - ]] || die "Oracle decomposition node requires explicit allowed paths: $node_id"
		[[ -n "$required_symbols" ]] || die "Oracle decomposition node requires symbols or '-': $node_id"
		[[ "$complexity_class" =~ ^(LOW|MEDIUM|HIGH)$ && "$worker_route" =~ ^(LUNA|TERRA)$ ]] || die "invalid Oracle route or complexity: $node_id"
		if (( expected_fields == 20 || expected_fields == 11 )); then
			[[ "$leaf_type" =~ ^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION|VERIFICATION_ONLY|CONTRACT_DESIGN|CROSS_COMPONENT_ARCHITECTURE|CONCURRENCY_PROTOCOL|INTEGRATION|AMBIGUOUS_SPECIFICATION)$ ]] || die "invalid Oracle leaf type: $node_id"
			if [[ "$worker_route" == LUNA ]]; then
				[[ "$complexity_class" == LOW && "$leaf_type" =~ ^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION|VERIFICATION_ONLY)$ ]] || die "Oracle Luna node is not Luna-ready: $node_id"
			elif [[ "$HARNESS_PREFERRED_WORKER_ROUTE" == LUNA && "$leaf_type" =~ ^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION|VERIFICATION_ONLY)$ ]]; then
				die "Oracle coding remediation must be decomposed for Luna: $node_id"
			fi
		else
			[[ "$worker_route" != LUNA || "$complexity_class" == LOW ]] || die "legacy Oracle Luna node must have LOW complexity: $node_id"
		fi
		oracle_nodes[$node_id]=1
		known_nodes[$node_id]=1
		(IFS=$'\t'; printf '%s\n' "${fields[*]}") >> "$dag_tmp"
	done < "$nodes_tmp"
	for item_id in "${!oracle_item_titles[@]}"; do
		[[ -n "${oracle_nodes[$item_id]:-}" ]] || die "Oracle plan item lacks a matching decomposition node: $item_id"
	done
	(( ${#oracle_nodes[@]} == ${#oracle_item_titles[@]} )) || die 'Oracle plan item and decomposition node counts differ'

	if (( HARNESS_ARCHITECTURE_GUARDS == 1 )); then
		awk '
			$0 == "## Architecture node bindings" {inside = 1; next}
			inside && /^## / {exit}
			inside && $0 !~ /^#/ && index($0, "\t") {print}
		' "$addendum" > "$bindings_tmp"
		[[ -s "$bindings_tmp" ]] || die 'architecture-guarded Oracle addendum must include matching rows under ## Architecture node bindings'
		cp "$binding" "$binding_tmp"
		declare -A oracle_bindings=()
		while IFS=$'\t' read -r -a fields; do
			(( ${#fields[@]} == 6 )) || die 'Oracle architecture binding must contain exactly six tab-separated fields'
			node_id="${fields[0]}"
			[[ -n "${oracle_nodes[$node_id]:-}" ]] || die "Oracle architecture binding has no matching decomposition node: $node_id"
			[[ -z "${oracle_bindings[$node_id]:-}" ]] || die "duplicate Oracle architecture binding: $node_id"
			oracle_bindings[$node_id]=1
			(IFS=$'\t'; printf '%s\n' "${fields[*]}") >> "$binding_tmp"
		done < "$bindings_tmp"
		for node_id in "${!oracle_nodes[@]}"; do
			[[ -n "${oracle_bindings[$node_id]:-}" ]] || die "Oracle decomposition node lacks an architecture binding: $node_id"
		done
		architecture_validate_source_file node-bindings "$binding_tmp" \
			$'node_id\tinvariant_ids\tconsumes_decisions\tproduces_decisions\tedge_contracts\thealth_gates' 6
		(
			project_decomposition_plan_file() { printf '%s\n' "$dag_tmp"; }
			architecture_node_bindings_file() { printf '%s\n' "$binding_tmp"; }
			architecture_validate_against_plan
		) || die 'Oracle decomposition and architecture candidates are inconsistent'
	fi
fi

if specification_ir_available; then
	mapfile -t original_obligation_ids < <(awk -F': ' '$1 == "Original-Requirement-ID" {print $2}' "$addendum")
	((${#original_obligation_ids[@]} > 0)) || die 'normalized Oracle remediation requires an Original-Requirement-ID'
	for obligation_id in "${original_obligation_ids[@]}"; do
		awk -F '\t' -v wanted="$obligation_id" 'NR > 1 && $1 == wanted {found=1} END {exit found ? 0 : 1}' "$(specification_obligations_file)" ||
			die "Oracle remediation references unknown normalized obligation: $obligation_id"
	done
	oracle_node_csv="$(printf '%s\n' "${!oracle_nodes[@]}" | LC_ALL=C sort | paste -sd, -)"
	original_obligation_csv="$(printf '%s\n' "${original_obligation_ids[@]}" | LC_ALL=C sort -u | paste -sd, -)"
	awk -F '\t' -v OFS='\t' -v obligations="$original_obligation_csv" -v nodes="$oracle_node_csv" -v audit="$audit_id" '
		BEGIN {n=split(obligations, wanted, ","); for (i=1; i<=n; i++) selected[wanted[i]]=1}
		NR == 1 {print; next}
		selected[$1] {
			m=split(nodes, additions, ",")
			for (i=1; i<=m; i++) if ($2 !~ "(^|,)" additions[i] "(,|$)") $2=$2 "," additions[i]
			$3=$3 "; Oracle remediation audit " audit
		}
		{print}
	' "$coverage" > "$coverage_tmp"
	validate_specification_coverage_file "$coverage_tmp" "$dag_tmp"
	if (( expected_fields == 20 )); then
		write_decomposition_complexity_report "$dag_tmp" "$coverage_tmp" "$complexity_tmp" ||
			die 'Oracle remediation decomposition exceeds the measured worker-complexity contract'
	fi
fi

chmod 600 "$definition_tmp" "$state_tmp" "$items_tmp"
[[ ! -f "$nodes_tmp" ]] || chmod 600 "$nodes_tmp"
[[ ! -f "$bindings_tmp" ]] || chmod 600 "$bindings_tmp"
[[ ! -f "$dag_tmp" ]] || chmod 600 "$dag_tmp"
[[ ! -f "$binding_tmp" ]] || chmod 600 "$binding_tmp"
[[ ! -f "$coverage_tmp" ]] || chmod 600 "$coverage_tmp"
[[ ! -f "$complexity_tmp" ]] || chmod 600 "$complexity_tmp"
mv "$definition_tmp" "$definition"
mv "$state_tmp" "$state"
[[ ! -f "$dag_tmp" ]] || mv "$dag_tmp" "$dag"
[[ ! -f "$binding_tmp" ]] || mv "$binding_tmp" "$binding"
[[ ! -f "$coverage_tmp" ]] || mv "$coverage_tmp" "$coverage"
[[ ! -f "$complexity_tmp" ]] || mv "$complexity_tmp" "$complexity"
trap - EXIT
cleanup_candidates
rm -f "$pending"
active_spec="$oracle_dir/active-specification-set.md"
tmp="$active_spec.tmp.$$"
{
	printf '# Active Specification Set\n\n'
	printf -- '- Original: %s\n' "$SPECIFICATION"
	printf -- '- Oracle addendum %s: %s\n' "$audit_id" "$addendum_archive"
	printf -- '- The addendum is additive and only remediates the original requirement IDs it names.\n'
} > "$tmp"
chmod 600 "$tmp"
mv "$tmp" "$active_spec"
log_event "ORACLE_AUDIT_REOPENED audit_id=$audit_id verdict=$archive addendum=$addendum_archive items=$items_tmp decomposition=$([[ -s "$nodes_tmp" ]] && printf registered || printf legacy) architecture=$([[ -s "$bindings_tmp" ]] && printf registered || printf disabled)"
printf '%s\n' "$addendum_archive"
