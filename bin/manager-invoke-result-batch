#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -ge 3 && $# -le 5 ]] || {
	printf 'Usage: %s ENV_FILE TASK_ID TASK_ID [TASK_ID [TASK_ID]]\n' "${0##*/}" >&2
	exit 2
}
load_harness_env "$1"
shift
tasks=("$@")
ensure_project
require_registered_specification_ir
require_manager_configuration
require_manager_codex
prepare_invoker="${HARNESS_MANAGER_RESULT_PREPARE_INVOKER:-$HARNESS_BIN/manager-invoke-result}"
codex_invoker="${HARNESS_CODEX_EXEC_INVOKER:-$HARNESS_BIN/codex-exec-jsonl}"
thread_registrar="${HARNESS_MANAGER_THREAD_REGISTRAR:-$HARNESS_BIN/manager-register-thread}"
(( ${#tasks[@]} <= HARNESS_MANAGER_BATCH_SIZE )) || die 'manager batch exceeds configured size'
dir="$(project_dir)"
inbox="$dir/control/manager-inbox.tsv"
if [[ ! -f "$inbox" ]]; then
	printf 'event_id\ttask_id\tfingerprint\tstate\trecorded_at\tdetail\n' > "$inbox"
	chmod 600 "$inbox"
fi

declare -A seen_roots=()
prompts=()
event_ids=()
for task_id in "${tasks[@]}"; do
	validate_task_id "$task_id"
	base="$(task_base "$task_id")"
	result="$dir/results/$base.result.md"
	assignment="$dir/archive/$base.assignment.md"
	[[ -f "$result" && -f "$assignment" ]] || die "batch result transaction is not committed: $task_id"
	[[ ! -e "$dir/running/$base.running.md" && ! -e "$dir/control/$base.lease" ]] ||
		die "batch result still has worker ownership: $task_id"
	root="$(task_root_id "$task_id")"
	[[ -z "${seen_roots[$root]:-}" ]] || die "manager batch contains two revisions of root: $root"
	seen_roots[$root]=1
	item="$(project_plan_item_for_root "$root")"
	for prior_task in "${tasks[@]}"; do
		[[ "$prior_task" == "$task_id" ]] && break
		prior_item="$(project_plan_item_for_root "$(task_root_id "$prior_task")")"
		project_plan_items_have_scope_conflict "$item" "$prior_item" &&
			die "manager batch contains conflicting plan items: $item and $prior_item"
	done
	fingerprint="sha256:$(sha256sum "$result" "$assignment" | sha256sum | awk '{print $1}')"
	event_id="${task_id}-$(printf '%s' "$fingerprint" | sha256sum | cut -c1-16)"
	event_ids+=("$event_id")
	previous="$(awk -F '\t' -v event="$event_id" '$1==event {state=$4} END {print state}' "$inbox")"
	[[ "$previous" != COMMITTED ]] || die "manager inbox event is already committed: $event_id"
	printf '%s\t%s\t%s\tENQUEUED\t%s\tpacket-compilation\n' \
		"$event_id" "$task_id" "$fingerprint" "$(timestamp_utc)" >> "$inbox"
	review_changed=0
	marker="$dir/control/$base.reviewed-event"
	[[ ! -f "$marker" ]] || review_changed=1
	prompt="$(HARNESS_MANAGER_PREPARE_ONLY=1 HARNESS_REVIEW_STATE_CHANGED="$review_changed" \
		"$prepare_invoker" "$HARNESS_ENV_FILE" "$task_id")"
	prompts+=("$prompt")
done

batch_id="$(printf '%s\n' "${event_ids[@]}" | sha256sum | cut -c1-20)"
batch_prompt="$dir/control/manager-batch-$batch_id.prompt.md"
{
	printf '# Bounded Independent Manager Review Batch\n\n'
	printf 'This is one ephemeral inference for %s independent completed worker results. Keep one logical manager, but commit each event through its existing per-task terminal command. A failure or rejection for one event must not alter, weaken, or prevent a correct decision for another. Do not combine review notes or acceptance authority.\n\n' "${#tasks[@]}"
	printf 'For each event in order: read its compiled REVIEW_PACKET_FILE from the corresponding prompt in one bounded command; run its exact REVIEW_DIFF_COMMAND and assigned validation; write one task-specific review note from that packet schema; run exactly one terminal manager command for that TASK_ID. Validation receipts may return VALIDATION_RECEIPT_REUSED and are authoritative only because the runner rechecks command/workspace/toolchain identity. Do not plan continuations, wait, poll, or inspect other harness state. Finish every event even if an earlier event rejects.\n\n'
	for index in "${!tasks[@]}"; do
		printf '## Event %s\n\nEvent-ID: %s\nTask-ID: %s\nPrepared-Prompt: %s\n' \
			"$((index + 1))" "${event_ids[index]}" "${tasks[index]}" "${prompts[index]}"
		awk -F= '/^(REVIEW_PACKET_FILE|REVIEW_DIFF_COMMAND|ASSIGNED_FOCUSED_VALIDATION|ASSIGNED_VALIDATION_CLASS|RECOMMENDED_PASS_REVIEW_TEMPLATE_FILE|RECOMMENDED_PASS_TERMINAL_COMMAND|REJECT_REVIEW_TEMPLATE_FILE|CHECKPOINT_INCREMENT_REVIEW_TEMPLATE_FILE|ENV_FILE|PROJECT_TMP_DIR)=/ {print}' \
			"${prompts[index]}"
		printf '\n'
	done
} > "$batch_prompt.tmp.$$"
chmod 600 "$batch_prompt.tmp.$$"
mv "$batch_prompt.tmp.$$" "$batch_prompt"

attempt=1
corrective_retry=0
while true; do
	stamp="$(timestamp_compact_utc)"
	json="$dir/logs/manager-review-batch-$batch_id-$stamp-attempt-$(printf '%03d' "$attempt").jsonl"
	stderr="$dir/logs/manager-review-batch-$batch_id-$stamp-attempt-$(printf '%03d' "$attempt").stderr.log"
	message="$dir/logs/manager-review-batch-$batch_id-$stamp-attempt-$(printf '%03d' "$attempt").md"
	log_event "MANAGER_REVIEW_BATCH_STARTED batch=$batch_id tasks=$(IFS=,; printf '%s' "${tasks[*]}") attempt=$attempt size=${#tasks[@]} context=fresh"
	set +e
	"$codex_invoker" "$HARNESS_ENV_FILE" manager_review "$MANAGER_MODEL" \
		"$batch_prompt" "$json" "$stderr" "$message"
	status=$?
	set -e
	classification=""
	if [[ -f "${json%.jsonl}.classification" ]]; then
		classification="$(kv_file_value "${json%.jsonl}.classification" classification 2>/dev/null)"
	fi
	record_root_agent_tokens "${tasks[0]}" manager_review "${json%.jsonl}.classification"
	if retry_kind="$(codex_provider_retry_kind "$classification" 2>/dev/null)"; then
		delay="$(codex_provider_retry_delay "$classification")"
		sleep "$delay"
		attempt=$((attempt + 1))
		continue
	fi
	(( status == 0 )) || exit "$status"
	committed=0
	pending=()
	for index in "${!tasks[@]}"; do
		task_id="${tasks[index]}"
		base="$(task_base "$task_id")"
		if [[ ! -f "$dir/results/$base.result.md" ]]; then
			committed=$((committed + 1))
			printf '%s\t%s\t-\tCOMMITTED\t%s\tbatch=%s\n' \
				"${event_ids[index]}" "$task_id" "$(timestamp_utc)" "$batch_id" >> "$inbox"
			log_event "MANAGER_BATCH_EVENT_COMMITTED batch=$batch_id event=${event_ids[index]} task=$task_id"
		else
			pending+=("$task_id")
			printf '%s\t%s\t-\tPENDING\t%s\tbatch=%s\n' \
				"${event_ids[index]}" "$task_id" "$(timestamp_utc)" "$batch_id" >> "$inbox"
		fi
	done
	if (( committed == ${#tasks[@]} )); then
		thread="$(codex_thread_id_from_jsonl "$json" 2>/dev/null || true)"
		[[ ! "$thread" =~ ^[A-Za-z0-9-]+$ ]] ||
			"$thread_registrar" "$HARNESS_ENV_FILE" "$thread" >/dev/null
		log_event "MANAGER_REVIEW_BATCH_FINISHED batch=$batch_id committed=$committed size=${#tasks[@]}"
		exit 0
	fi
	if (( corrective_retry == 0 )); then
		corrective_retry=1
		attempt=$((attempt + 1))
		cat >> "$batch_prompt" <<PROMPT

Corrective retry: the preceding batch committed $committed/${#tasks[@]} independent events. Act only on these still-pending exact TASK_ID values: $(IFS=,; printf '%s' "${pending[*]}"). Each must receive exactly one terminal review command. Do not revisit or modify already committed siblings.
PROMPT
		log_event "MANAGER_REVIEW_BATCH_CORRECTIVE_RETRY batch=$batch_id pending=$(IFS=,; printf '%s' "${pending[*]}") attempt=$attempt"
		continue
	fi
	log_event "MANAGER_REVIEW_BATCH_UNCOMMITTED batch=$batch_id committed=$committed pending=$(IFS=,; printf '%s' "${pending[*]}")"
	exit 3
done
