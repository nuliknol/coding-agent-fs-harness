#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -ge 3 && $# -le 5 ]] || {
	printf 'Usage: %s ENV_FILE TASK_ID TASK_ID [TASK_ID [TASK_ID]]\n' "${0##*/}" >&2
	exit 2
}
load_harness_env "$1"
shift
tasks=("$@")
ensure_project
require_registered_specification_ir
require_manager_configuration
require_manager_codex
manager_invoker="${HARNESS_MANAGER_RESULT_PARALLEL_INVOKER:-$HARNESS_BIN/manager-invoke-result}"
[[ -x "$manager_invoker" ]] || die "parallel manager result invoker is not executable: $manager_invoker"
(( ${#tasks[@]} <= HARNESS_MANAGER_BATCH_SIZE )) || die 'manager batch exceeds configured size'
dir="$(project_dir)"
inbox="$dir/control/manager-inbox.tsv"
if [[ ! -f "$inbox" ]]; then
	printf 'event_id\ttask_id\tfingerprint\tstate\trecorded_at\tdetail\n' > "$inbox"
	chmod 600 "$inbox"
fi

declare -A seen_roots=()
declare -A review_changed_by_task=()
declare -A pid_by_task=()
event_ids=()
for task_id in "${tasks[@]}"; do
	validate_task_id "$task_id"
	base="$(task_base "$task_id")"
	result="$dir/results/$base.result.md"
	assignment="$dir/archive/$base.assignment.md"
	[[ -f "$result" && -f "$assignment" ]] || die "batch result transaction is not committed: $task_id"
	[[ ! -e "$dir/running/$base.running.md" && ! -e "$dir/control/$base.lease" ]] ||
		die "batch result still has worker ownership: $task_id"
	root="$(task_root_id "$task_id")"
	[[ -z "${seen_roots[$root]:-}" ]] || die "manager batch contains two revisions of root: $root"
	seen_roots[$root]=1
	item="$(project_plan_item_for_root "$root")"
	for prior_task in "${tasks[@]}"; do
		[[ "$prior_task" == "$task_id" ]] && break
		prior_item="$(project_plan_item_for_root "$(task_root_id "$prior_task")")"
		project_plan_items_have_scope_conflict "$item" "$prior_item" &&
			die "manager batch contains conflicting plan items: $item and $prior_item"
	done
	fingerprint="sha256:$(sha256sum "$result" "$assignment" | sha256sum | awk '{print $1}')"
	event_id="${task_id}-$(printf '%s' "$fingerprint" | sha256sum | cut -c1-16)"
	event_ids+=("$event_id")
	previous="$(awk -F '\t' -v event="$event_id" '$1==event {state=$4} END {print state}' "$inbox")"
	[[ "$previous" != COMMITTED ]] || die "manager inbox event is already committed: $event_id"
	printf '%s\t%s\t%s\tENQUEUED\t%s\tpacket-compilation\n' \
		"$event_id" "$task_id" "$fingerprint" "$(timestamp_utc)" >> "$inbox"
	review_changed=0
	marker="$dir/control/$base.reviewed-event"
	[[ ! -f "$marker" ]] || review_changed=1
	review_changed_by_task[$task_id]="$review_changed"
done

batch_id="$(printf '%s\n' "${event_ids[@]}" | sha256sum | cut -c1-20)"
log_event "MANAGER_REVIEW_COHORT_STARTED batch=$batch_id tasks=$(IFS=,; printf '%s' "${tasks[*]}") size=${#tasks[@]} mode=worker-manager-pairs"
for task_id in "${tasks[@]}"; do
	(
		set +e
		HARNESS_REVIEW_STATE_CHANGED="${review_changed_by_task[$task_id]}" \
			"$manager_invoker" "$HARNESS_ENV_FILE" "$task_id" 8>&-
		printf '%s\n' "$?" > "$dir/control/$(task_base "$task_id").parallel-review-status.$$"
	) &
	pid_by_task[$task_id]=$!
	log_event "MANAGER_REVIEW_PAIR_STARTED batch=$batch_id task=$task_id pid=${pid_by_task[$task_id]}"
done

overall_status=0
committed=0
pending=()
for index in "${!tasks[@]}"; do
	task_id="${tasks[index]}"
	status_file="$dir/control/$(task_base "$task_id").parallel-review-status.$$"
	if wait "${pid_by_task[$task_id]}"; then :; fi
	status="$(awk 'NR==1 {print; exit}' "$status_file" 2>/dev/null || printf 1)"
	rm -f "$status_file"
	[[ "$status" =~ ^[0-9]+$ ]] || status=1
	base="$(task_base "$task_id")"
	if [[ ! -f "$dir/results/$base.result.md" ]]; then
		committed=$((committed + 1))
		printf '%s\t%s\t-\tCOMMITTED\t%s\tbatch=%s status=%s\n' \
			"${event_ids[index]}" "$task_id" "$(timestamp_utc)" "$batch_id" "$status" >> "$inbox"
		log_event "MANAGER_BATCH_EVENT_COMMITTED batch=$batch_id event=${event_ids[index]} task=$task_id status=$status"
	else
		pending+=("$task_id")
		printf '%s\t%s\t-\tPENDING\t%s\tbatch=%s status=%s\n' \
			"${event_ids[index]}" "$task_id" "$(timestamp_utc)" "$batch_id" "$status" >> "$inbox"
		if (( status != 0 && status != 3 && overall_status == 0 )); then
			overall_status="$status"
		fi
	fi
	log_event "MANAGER_REVIEW_PAIR_FINISHED batch=$batch_id task=$task_id status=$status committed=$([[ ! -f "$dir/results/$base.result.md" ]] && printf 1 || printf 0)"
done

if (( committed == ${#tasks[@]} )); then
	log_event "MANAGER_REVIEW_COHORT_FINISHED batch=$batch_id committed=$committed size=${#tasks[@]}"
	exit 0
fi
log_event "MANAGER_REVIEW_COHORT_UNCOMMITTED batch=$batch_id committed=$committed pending=$(IFS=,; printf '%s' "${pending[*]}")"
(( overall_status == 0 )) && exit 3
exit "$overall_status"
