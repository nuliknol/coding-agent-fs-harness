#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
require_manager_codex
(( HARNESS_DECOMPOSITION_V2 == 1 )) || die 'decomposition critic requires HARNESS_DECOMPOSITION_V2=1'
project_plan_exists && { printf 'Decomposition DAG already exists.\n'; exit 0; }

trace_init manager_decomposition_critic
trace_script_start "$@"
trap 'trace_script_exit $?' EXIT
dir="$(project_dir)"
prompt="$dir/control/manager-decomposition-critic.prompt.md"
last_message="$dir/logs/manager-decomposition-critic-last-message.md"
specification_review_report='-'
repository_facts_file='-'
specification_obligations_file_path='-'
specification_relations_file_path='-'
repository_inventory_file='-'
domain_manifest_file='-'
if (( HARNESS_SPECIFICATION_REVIEW_ENABLED == 1 )); then
	specification_review_is_accepted || die 'decomposition requires an accepted current specification review'
	specification_review_report="$REPOSITORY/$(specification_review_state_value report)"
	repository_facts_file="$REPOSITORY/$(specification_review_state_value facts)"
	specification_obligations_file_path="$(specification_obligations_file)"
	specification_relations_file_path="$(specification_relations_file)"
	repository_inventory_file="$(specification_repository_inventory_file)"
	domain_manifest_file="$(specification_domain_manifest_file)"
fi
cat > "$prompt.tmp.$$" <<PROMPT
You are the fresh decomposition planner and critic for a filesystem-backed coding harness. Do not edit the repository.

ENV_FILE=$HARNESS_ENV_FILE
HARNESS_BIN=$HARNESS_BIN
PROJECT=$PROJECT
REPOSITORY=$REPOSITORY
SPECIFICATION=$SPECIFICATION
SPECIFICATION_REVIEW_REPORT=$specification_review_report
REPOSITORY_FACTS_FILE=$repository_facts_file
SPECIFICATION_OBLIGATIONS_FILE=$specification_obligations_file_path
SPECIFICATION_RELATIONS_FILE=$specification_relations_file_path
REPOSITORY_INVENTORY_FILE=$repository_inventory_file
DOMAIN_PROFILE_MANIFEST=$domain_manifest_file
PROJECT_TMP_DIR=$PROJECT_TMP_DIR
ARCHITECTURE_GUARDS=$HARNESS_ARCHITECTURE_GUARDS
MAX_LUNA_ALLOWED_PATHS=$HARNESS_MAX_LUNA_ALLOWED_PATHS

Before drafting a DAG, independently challenge the accepted review and normalized IR against the governing sources and repository evidence. There are exactly three outcomes:

1. If a governing source contains a demonstrated unresolved product/specification defect in one of the supported clarification classes, write CHALLENGE_REPORT beginning with `# Specification Review Challenge` and CHALLENGE_ISSUES using the specification issues TSV schema, then call:

$HARNESS_BIN/manager-challenge-specification-review "$HARNESS_ENV_FILE" CHALLENGE_REPORT CHALLENGE_ISSUES

Terminate immediately after it succeeds. Ask only the minimal product question. Do not use this path for coding difficulty, architecture delegated to the implementer, discoverable repository facts, or a defect in the generated normalized IR. A dependency cycle explicitly declared by governing sources is CONTRADICTORY_REQUIREMENTS and always uses this clarification path; it cannot be repaired by dropping a source edge.

2. If the governing sources are sufficiently clear but the accepted facts, obligations, or relations omit, distort, or contradict those clear sources or repository evidence, write RENORMALIZATION_REASON beginning with `# Specification Renormalization Request`, identify the exact source-to-IR mismatch, and call:

$HARNESS_BIN/manager-request-specification-renormalization "$HARNESS_ENV_FILE" RENORMALIZATION_REASON

Terminate immediately after it succeeds. This is an automatic compiler correction and must not bounce a false clarification to the user. Use renormalization only when preserving all governing statements can produce a valid acyclic IR. Never request renormalization when the source itself must change or an authority must choose between incompatible dependency directions.

3. Only when the accepted review and normalized IR survive this independent challenge may you register a DAG.

Read the complete specification, accepted specification review, normalized obligations, typed semantic relations, repository inventory and facts, selected domain-profile manifest, applicable repository development policy, and enough current repository structure to verify real dependencies and existing contracts. Treat OBSERVED repository facts as evidence, INFERRED facts as hypotheses to verify, and PLANNING_HINT facts as advisory only; none can silently add product requirements. The repository inventory is a navigation aid and never limits necessary inspection. Produce a topologically ordered decomposition DAG with this exact tab-separated header:

node_id<TAB>parent_id<TAB>depends_on<TAB>deliverable<TAB>acceptance_evidence<TAB>focused_validation<TAB>allowed_paths<TAB>required_symbols<TAB>leaf_type<TAB>complexity_class<TAB>worker_route

Use '-' for no parent, no dependencies, or no required symbols. Dependency IDs must precede each consumer. Every node must be independently acceptance-complete and monotonically useful. Separate contract decisions from implementation and integration. Never place public contract design, cross-component architecture, concurrency protocol design, ambiguous specification resolution, or unexplained final integration in a Luna node.

A LUNA node is valid only when complexity_class is LOW, leaf_type is LOCAL_IMPLEMENTATION, TEST_IMPLEMENTATION, MECHANICAL_API, FOCUSED_BUG, or DOCUMENTATION, architecture is already decided, dependencies are verified before scheduling, one principal implementation concern remains, allowed paths contain at most MAX_LUNA_ALLOWED_PATHS bounded path groups, and one deterministic focused validation establishes completion. Use TEST_IMPLEMENTATION for focused unit tests, fixtures, test helpers, and test-only build registration that do not alter production contracts. A TERRA node must use CONTRACT_DESIGN, CROSS_COMPONENT_ARCHITECTURE, CONCURRENCY_PROTOCOL, AMBIGUOUS_SPECIFICATION, or INTEGRATION and must resolve a concrete decision or unexplained cross-boundary failure rather than perform routine coding.

PREFERRED_WORKER_ROUTE=$HARNESS_PREFERRED_WORKER_ROUTE. Optimize explicitly for cheap-worker execution. At least $HARNESS_MIN_LUNA_CODING_NODE_PERCENT percent of coding-eligible DAG nodes (LOCAL_IMPLEMENTATION, TEST_IMPLEMENTATION, MECHANICAL_API, FOCUSED_BUG, and DOCUMENTATION) must route to LUNA. Terra-only decision and integration nodes are excluded from this denominator. A Terra contract or architecture decision does not make its implementation descendants Terra work: depend bounded LOW/LUNA implementation nodes on that decision. Split broad local implementation, mechanical API propagation, focused tests or bug fixes, fixtures, and post-behavior documentation into Luna-ready nodes of at most five expected implementation files and one deterministic validation. When a concern mixes decision and coding, create a narrow Terra decision node followed by one or more Luna implementation nodes. Do not use Terra merely because the overall specification is large.

Decompose deeply enough that Luna can execute deterministically, but do not create microscopic handoffs. A Luna-ready node should normally own one cohesive implementation concern, one to five implementation files, and the largest useful deterministic focused validation that still fits within three worker turns. Do not split an already Luna-ready concern merely to inflate the route percentage; every extra leaf incurs a manager review.

For each node, perform an authority-closure check: ask whether a plausible failure of its acceptance evidence or focused validation could require a production correction outside allowed_paths while still remaining inside the governing specification. If so, the node is not authority-closed. Split it before registration—for example, a public-header contract node may own compile/layout evidence, while a dependent implementation or integration node owns the source paths and executable runtime smoke. Do not give a header-only or test-only node an acceptance boundary whose ordinary repair authority belongs to another node. Validation may read or execute outside allowed_paths, but every ordinary implementation area that the node could legitimately need to correct must either be in its allowed_paths or belong to an explicit prerequisite/dependent node with its own acceptance boundary.

Also produce SPECIFICATION_COVERAGE_FILE with exactly this tab-separated header:

obligation_id<TAB>node_ids<TAB>evidence_plan

Include exactly one row for every obligation in SPECIFICATION_OBLIGATIONS_FILE. node_ids is a comma-separated list of DAG nodes whose combined accepted evidence proves that obligation. Every DAG node must appear in at least one coverage row, so the plan cannot invent unrelated work. evidence_plan names the deterministic node evidence and final integration evidence that will discharge the obligation. Respect typed relations: dependency relations constrain order; MAY_DEVELOP_INDEPENDENTLY does not create a false prerequisite; INTEGRATION_DEPENDENCY_ONLY permits isolated fixture work but requires an actual-producer integration node; REGRESSION_BOUNDARY and FINAL_HEALTH_DEPENDENCY require corresponding validation nodes. Repository-derived and planning-hint relations may guide decomposition but cannot override normative authority.

First draft the DAG privately. Then perform a critic pass over every node: attempt to identify hidden prerequisites, multiple implementation concerns, undeclared symbols, broad file scopes, validation chains, or architecture decisions. Split or reroute every failing node. Count routes and confirm the Luna percentage meets the configured minimum before registration. Register only the corrected final DAG with:

When ARCHITECTURE_GUARDS=1, a DAG containing exactly one dependency-free LOW/LUNA TEST_IMPLEMENTATION node receives a deterministic minimal architecture profile automatically when manager-init-project-plan runs. For that case, do not create ARCH_DIR or call manager-init-architecture: register the DAG directly. The generated profile has one specified test obligation, no decisions or edges, one node binding, one critical acceptance health gate using focused_validation, and no debt.

For every other guarded DAG, create ARCH_DIR under PROJECT_TMP_DIR with six exact files before registering the DAG:

invariants.tsv:
invariant_id<TAB>category<TAB>authority<TAB>severity<TAB>statement<TAB>scope<TAB>source_requirement<TAB>validation_kind<TAB>validation_ref<TAB>affected_nodes

decisions.tsv:
decision_id<TAB>status<TAB>producer_node<TAB>problem<TAB>chosen_contract<TAB>affected_interfaces<TAB>supersedes<TAB>evidence

edges.tsv:
edge_id<TAB>producer_node<TAB>consumer_node<TAB>contract_artifact<TAB>public_symbols<TAB>ownership_model<TAB>representation<TAB>versioning_rule<TAB>compatibility_validation<TAB>decision_ids<TAB>invariant_ids

contract_artifact must be '-' when no durable artifact crosses the edge, a bounded repository-relative path, or decision:DECISION_ID. A decision reference resolves to that accepted decision's committed evidence path and the same DECISION_ID must appear in decision_ids. Do not invent URI-like placeholders such as architecture:DECISION_ID; unsupported namespaces are rejected. A future repository path may be absent during decomposition, but the producer must create and commit it before acceptance.

node-bindings.tsv:
node_id<TAB>invariant_ids<TAB>consumes_decisions<TAB>produces_decisions<TAB>edge_contracts<TAB>health_gates

health-gates.tsv:
gate_id<TAB>trigger_node<TAB>depends_on<TAB>validation<TAB>severity<TAB>invariant_ids<TAB>edge_ids

debt.tsv:
debt_id<TAB>introduced_by_task<TAB>introduced_by_commit<TAB>category<TAB>affected_invariants<TAB>consequence<TAB>remediation_node<TAB>severity<TAB>expires_at<TAB>status<TAB>waiver_authority

Use '-' for an intentionally empty identifier list. Every DAG node must have exactly one node binding. Categories, authority, severity, and statuses must follow the architecture templates. SPECIFIED invariants must cite an original requirement; DERIVED invariants must be necessary consequences, not model preferences; PROPOSED invariants cannot silently constrain implementation. Every dependency carrying an API, representation, ownership, serialization, concurrency, or error contract needs an edge row. Terra decision nodes produce explicit ADR-like decisions; Luna nodes may consume accepted decisions but produce none. Add milestone health gates after coherent component groups and at final integration, using deterministic commands. Every invariant command, edge compatibility check, and lane/component/leaf gate must use its focused selector and must not require an unrelated aggregate test to exit zero. If an aggregate is useful as evidence, capture or tolerate its exit and assert the owned stage's exact result separately. Use HARNESS_BROAD_GATE_REQUIRED=1 in a validation command only when the human-owned governing specification explicitly requires whole-project aggregate success. Every enforceable invariant's affected_nodes must list only nodes whose bindings contain that invariant; do not classify a contract-decision node as runtime-affected when enforcement belongs to its implementation descendants. Start debt.tsv with only known, explicitly waived debt; do not invent debt to make the plan pass.

Initialize the architecture registry first when enabled and it does not already exist. If a previous registration attempt initialized it but DAG validation failed, read and reuse the existing immutable registry instead of calling initialization again:

$HARNESS_BIN/manager-init-architecture "$HARNESS_ENV_FILE" ARCH_DIR

Then register the DAG:

$HARNESS_BIN/manager-init-project-plan "$HARNESS_ENV_FILE" DAG_FILE SPECIFICATION_COVERAGE_FILE

After the command succeeds, terminate. Do not publish a worker task, wait, poll, or modify repository files.
PROMPT
chmod 600 "$prompt.tmp.$$"
mv "$prompt.tmp.$$" "$prompt"

attempt=1
resume_thread=""
while true; do
	stamp="$(timestamp_compact_utc)"
	json="$dir/logs/manager-decomposition-critic-$stamp-attempt-$(printf '%03d' "$attempt").jsonl"
	stderr="$dir/logs/manager-decomposition-critic-$stamp-attempt-$(printf '%03d' "$attempt").stderr.log"
	message="$dir/logs/manager-decomposition-critic-$stamp-attempt-$(printf '%03d' "$attempt").md"
	set +e
	if [[ -n "$resume_thread" ]]; then
		"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" manager_plan "$MANAGER_MODEL" "$prompt" "$json" "$stderr" "$message" resume "$resume_thread"
	else
		"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" manager_plan "$MANAGER_MODEL" "$prompt" "$json" "$stderr" "$message"
	fi
	status=$?
	set -e
	thread="$(codex_thread_id_from_jsonl "$json" 2>/dev/null || true)"
	[[ ! "$thread" =~ ^[A-Za-z0-9-]+$ ]] || resume_thread="$thread"
	if project_plan_exists; then
		cp -f "$message" "$last_message" 2>/dev/null || true
		log_event "DECOMPOSITION_CRITIC_APPROVED nodes=$(project_plan_total_count) attempts=$attempt"
		printf 'Decomposition critic approved %s DAG nodes.\n' "$(project_plan_total_count)"
		exit 0
	fi
	if (( HARNESS_SPECIFICATION_REVIEW_ENABLED == 1 )) && specification_review_requires_clarification; then
		cp -f "$message" "$last_message" 2>/dev/null || true
		log_event "DECOMPOSITION_CRITIC_CLARIFICATION report=$(specification_review_report_relative_path) attempts=$attempt"
		printf 'Specification clarification required: %s\n' "$(specification_review_report_relative_path)"
		exit 3
	fi
	if specification_renormalization_stall_matches_current_inputs; then
		cp -f "$message" "$last_message" 2>/dev/null || true
		stall_report="$(kv_file_value "$(specification_renormalization_stall_file)" report)"
		printf 'Specification normalization stalled: %s\n' "$stall_report" >&2
		exit 5
	fi
	if (( HARNESS_SPECIFICATION_REVIEW_ENABLED == 1 )) && ! specification_review_is_accepted; then
		cp -f "$message" "$last_message" 2>/dev/null || true
		log_event "DECOMPOSITION_CRITIC_RENORMALIZATION attempts=$attempt"
		printf 'Specification IR renormalization requested.\n'
		exit 4
	fi
	classification="$(kv_file_value "${json%.jsonl}.classification" classification 2>/dev/null || true)"
	retry_kind="$(codex_provider_retry_kind "$classification" 2>/dev/null || true)"
	if [[ -n "$retry_kind" ]]; then
		delay="$(codex_provider_retry_delay "$classification")"
		printf 'Decomposition critic provider retry in %s seconds (%s).\n' "$delay" "$retry_kind" >&2
		sleep "$delay"
		attempt=$((attempt + 1))
		continue
	fi
	(( status == 0 )) && die 'decomposition critic exited without registering a DAG'
	die "decomposition critic failed with status $status; see $json"
done
