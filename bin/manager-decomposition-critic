#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
require_manager_codex
(( HARNESS_DECOMPOSITION_V2 == 1 )) || die 'decomposition critic requires HARNESS_DECOMPOSITION_V2=1'
project_plan_exists && { printf 'Decomposition DAG already exists.\n'; exit 0; }
if (( HARNESS_SPECIFICATION_REVIEW_ENABLED == 1 )); then
	architecture_fit_is_accepted || die 'decomposition requires a current accepted Sol architecture-fit review or matching force waiver'
fi
if architecture_redesign_requires_action && [[ "${HARNESS_FORCE_DECOMPOSITION:-0}" != 1 ]]; then
	printf 'Architecture redesign required: %s\n' "$(architecture_redesign_report_relative_path)"
	exit 6
fi

trace_init manager_decomposition_critic
trace_script_start "$@"
trap 'trace_script_exit $?' EXIT
dir="$(project_dir)"
prompt="$dir/control/manager-decomposition-critic.prompt.md"
last_message="$dir/logs/manager-decomposition-critic-last-message.md"
specification_review_report='-'
repository_facts_file='-'
specification_obligations_file_path='-'
specification_relations_file_path='-'
repository_inventory_file='-'
domain_manifest_file='-'
repository_architecture_slice='-'
if (( HARNESS_SPECIFICATION_REVIEW_ENABLED == 1 )); then
	specification_review_is_accepted || die 'decomposition requires an accepted current specification review'
	specification_review_report="$REPOSITORY/$(specification_review_state_value report)"
	repository_facts_file="$REPOSITORY/$(specification_review_state_value facts)"
	specification_obligations_file_path="$(specification_obligations_file)"
	specification_relations_file_path="$(specification_relations_file)"
	repository_inventory_file="$(specification_repository_inventory_file)"
	domain_manifest_file="$(specification_domain_manifest_file)"
fi
if [[ -s "$dir/control/repository-architecture-slice.md" ]]; then
	repository_architecture_slice="$dir/control/repository-architecture-slice.md"
fi
cat > "$prompt.tmp.$$" <<PROMPT
You are the fresh DAG construction planner for a filesystem-backed coding harness. Do not edit the repository.

ENV_FILE=$HARNESS_ENV_FILE
HARNESS_BIN=$HARNESS_BIN
PROJECT=$PROJECT
REPOSITORY=$REPOSITORY
SPECIFICATION=$SPECIFICATION
SPECIFICATION_REVIEW_REPORT=$specification_review_report
REPOSITORY_FACTS_FILE=$repository_facts_file
SPECIFICATION_OBLIGATIONS_FILE=$specification_obligations_file_path
SPECIFICATION_RELATIONS_FILE=$specification_relations_file_path
REPOSITORY_INVENTORY_FILE=$repository_inventory_file
DOMAIN_PROFILE_MANIFEST=$domain_manifest_file
REPOSITORY_ARCHITECTURE_SLICE=$repository_architecture_slice
PROJECT_TMP_DIR=$PROJECT_TMP_DIR
AGENT_PHASE=decomposition
ARCHITECTURE_GUARDS=$HARNESS_ARCHITECTURE_GUARDS
MAX_LUNA_ALLOWED_PATHS=$HARNESS_MAX_LUNA_ALLOWED_PATHS
MAX_LUNA_OBLIGATIONS_PER_LEAF=$HARNESS_MAX_LUNA_OBLIGATIONS_PER_LEAF
MAX_LUNA_CONTEXT_CAPSULE_BYTES=$HARNESS_MAX_LUNA_CONTEXT_CAPSULE_BYTES
MAX_LUNA_BEHAVIORAL_CONCERNS=$HARNESS_MAX_LUNA_BEHAVIORAL_CONCERNS
MAX_LUNA_FAILURE_PATHS=$HARNESS_MAX_LUNA_FAILURE_PATHS
MAX_LUNA_OWNERSHIP_TRANSITIONS=$HARNESS_MAX_LUNA_OWNERSHIP_TRANSITIONS
MAX_LUNA_CONCURRENCY_BOUNDARIES=$HARNESS_MAX_LUNA_CONCURRENCY_BOUNDARIES
MAX_LUNA_VALIDATION_SURFACES=$HARNESS_MAX_LUNA_VALIDATION_SURFACES
MAX_LUNA_IMPLEMENTATION_FILES=$HARNESS_MAX_LUNA_IMPLEMENTATION_FILES
MAX_LUNA_REQUIRED_SYMBOLS=$HARNESS_MAX_LUNA_REQUIRED_SYMBOLS
MAX_LUNA_PREDICTED_ACTIONS=$HARNESS_MAX_LUNA_PREDICTED_ACTIONS
MAX_LUNA_PREDICTED_P95_TOKENS=$HARNESS_MAX_LUNA_PREDICTED_P95_TOKENS
MAX_LUNA_COMPLEXITY_SCORE=$HARNESS_MAX_LUNA_COMPLEXITY_SCORE
MAX_LUNA_RISK_DOMAINS=$HARNESS_MAX_LUNA_RISK_DOMAINS
FORCE_DECOMPOSITION=${HARNESS_FORCE_DECOMPOSITION:-0}
ARCHITECTURE_REDESIGN_REPORT=$(architecture_redesign_state_value report -)
ARCHITECTURE_FORCE_WAIVER=$(architecture_redesign_force_file)
ARCHITECTURE_FORCE_WAIVER_ID=$(kv_file_value "$(architecture_redesign_force_file)" waiver_id 2>/dev/null || printf '-')
ARCHITECTURE_FORCE_DEBT_EXPIRES_AT=$(date -u -d '+30 days' +%Y-%m-%d)
ARCHITECTURE_FIT_REPORT=$(architecture_fit_state_value report force-waiver)

The separate Sol architecture-fit transaction already challenged the governing specification, normalized IR, and foundational repository boundaries. Its durable decision is authoritative for this baseline. Do not repeat specification clarification, IR renormalization, or architecture-redesign analysis in this turn. Do not inspect harness source. Proceed directly to DAG construction.

When mapping source registries, never infer an omitted final item from a regex that requires a trailing newline character; use EOF-safe parsing and a direct literal check.

When FORCE_DECOMPOSITION=1, a human has explicitly waived a matching redesign report. Do not emit another redesign request for those findings. The waiver does not erase them: create prerequisite Terra CROSS_COMPONENT_ARCHITECTURE nodes for every required capability, make all affected implementation nodes depend on them, and create one OPEN CRITICAL architecture debt row named DEBT-ARCH-... per ARCH-... issue. Each debt consequence must name its exact ARCH-... issue ID, remediation_node must be the corresponding Terra node, expires_at must be ARCHITECTURE_FORCE_DEBT_EXPIRES_AT, and waiver_authority must be COMMAND_LINE_FORCE_DECOMPOSITION:ARCHITECTURE_FORCE_WAIVER_ID. Bind at least one CRITICAL focused health gate to every remediation node. Every coverage node allocated an affected requirement must be that remediation node or depend transitively on it. Dependent Luna work must not become ready until those Terra nodes and their focused architecture gates are accepted. The manager must resolve each debt row only after accepting its remediation node and evidence.

The accepted review, normalized IR, and architecture-fit review have survived the independent challenge, or a matching force waiver has converted every blocker into prerequisite remediation. Construct and submit the DAG now.

Read the accepted specification review, normalized obligations, typed semantic relations, repository facts, selected domain-profile manifest, REPOSITORY_ARCHITECTURE_SLICE when it is not '-', and ARCHITECTURE_FIT_REPORT. These are the bounded semantic capsule. The architecture slice is deterministic structural navigation evidence: use its build ownership, public-interface candidates, high-fanout seams, and focused-test map to choose cohesive boundaries, but do not treat inferred structure as normative authority. Search the repository inventory only for exact paths or symbols needed by a node; never print or read the complete inventory, complete development policy, harness implementation, unrelated Git history, or broad source trees. Retain verbose command output in files and return bounded excerpts. Treat OBSERVED repository facts as evidence, INFERRED facts as hypotheses to verify, and PLANNING_HINT facts as advisory only. Produce a topologically ordered decomposition DAG with this exact tab-separated header:

Preserve specification-declared component ownership and principal source paths. Before staging every contract, architecture, producer, adopter, or delivery node, trace its allocated obligations back to any exact component-definition or principal-source-path declaration at their source locations. The node's allowed_paths and required_symbols must include the implementation seam owned by that component; a similarly named downstream compiler, transport, facade, or presentation surface is not a substitute. Split producer/adopter work from delivery work when the specification assigns them to different components. If the repository facts disagree with a governing component declaration, challenge or renormalize the authority instead of silently rebinding the work.

node_id<TAB>parent_id<TAB>depends_on<TAB>deliverable<TAB>acceptance_evidence<TAB>focused_validation<TAB>allowed_paths<TAB>required_symbols<TAB>leaf_type<TAB>complexity_class<TAB>worker_route<TAB>behavioral_concerns<TAB>failure_paths<TAB>ownership_transitions<TAB>concurrency_boundaries<TAB>validation_surfaces<TAB>implementation_files<TAB>predicted_worker_actions<TAB>predicted_p95_tokens<TAB>terra_exception

Use '-' for no parent, no dependencies, or no required symbols. Dependency IDs must precede each consumer. Every node must be independently acceptance-complete and monotonically useful. Separate contract decisions from implementation and integration. Never place public contract design, cross-component architecture, concurrency protocol design, ambiguous specification resolution, or unexplained final integration in a Luna node.

A LUNA node is valid only when complexity_class is LOW, leaf_type is LOCAL_IMPLEMENTATION, TEST_IMPLEMENTATION, MECHANICAL_API, FOCUSED_BUG, DOCUMENTATION, or VERIFICATION_ONLY, architecture is already decided, dependencies are verified before scheduling, and every measured dimension is within its MAX_LUNA limit. Count independently observable behavior changes, independently injectable or typed failure paths, ownership transfers, concurrency/ordering boundaries, validation surfaces, implementation files, and predicted worker actions. predicted_p95_tokens is the conservative upper bound for a fresh worker, including repeated context processing, not the expected average. terra_exception must be '-' for Luna. The deterministic validator recomputes obligation weight, paths, symbols, semantic risk domains, a weighted score, and a historical model-calibrated token floor; never lower a declared dimension to evade a limit. Use TEST_IMPLEMENTATION for focused unit tests, fixtures, test helpers, and test-only build registration that do not alter production contracts. Use VERIFICATION_ONLY when exact acceptance evidence already exists and the worker must make no source change; such a node has implementation_files=0. Zero implementation files are also valid for zero-write TERRA contract, architecture, concurrency, ambiguity, and integration leaves whose artifact or validation remains outside the repository. These zero-write leaves may use allowed_paths '-' when their command and required symbols provide the complete evidence boundary; every source-changing leaf still requires explicit repository-relative allowed paths. A clean whole-project build or global validation belongs in an explicit TERRA INTEGRATION node; do not hide it inside a Luna leaf.

Continue recursive decomposition whenever any Luna dimension exceeds its limit. Split behavior, failure handling, ownership, concurrency, telemetry, and validation into ordered independently acceptance-complete nodes until every routine implementation leaf passes. Do not route an over-budget coding node to Terra merely to make the candidate validate. A TERRA node is permitted only for a genuinely irreducible decision/boundary and must use CONTRACT_DESIGN, CROSS_COMPONENT_ARCHITECTURE, CONCURRENCY_PROTOCOL, AMBIGUOUS_SPECIFICATION, or INTEGRATION with exactly one terra_exception value: CONTRACT_DECISION, ARCHITECTURE_DECISION, CONCURRENCY_DESIGN, AMBIGUOUS_SPECIFICATION, UNEXPLAINED_INTEGRATION, or IRREDUCIBLE_CROSS_BOUNDARY. Terra resolves or verifies that boundary; dependent routine implementation remains decomposed LOW/LUNA work.
Every architecture decision producer must include its exact repository-relative decision evidence path in allowed_paths. Decision-only nodes must authorize their durable decision artifact instead of substituting a public header, implementation source, or test path for the missing evidence path.

Every child preserves the semantic type, cardinality, ownership, and unit of its parent acceptance boundary. Never convert argument arity into record count, a boolean diagnostic into a resource count, byte length into element count, source span into role count, or one ownership domain into another unless a governing declaration explicitly defines that relation. Such an inference is a missing architecture fact, not a valid decomposition step. A child may narrow work, but must not strengthen or reinterpret the observable contract.

PREFERRED_WORKER_ROUTE=$HARNESS_PREFERRED_WORKER_ROUTE. Optimize explicitly for cheap-worker execution. At least $HARNESS_MIN_LUNA_CODING_NODE_PERCENT percent of coding-eligible DAG nodes (LOCAL_IMPLEMENTATION, TEST_IMPLEMENTATION, MECHANICAL_API, FOCUSED_BUG, and DOCUMENTATION) must route to LUNA. Terra-only decision, verification-only, and integration nodes are excluded from that coding denominator. Before emitting coding work, inspect the exact acceptance symbols and focused validation from repository facts: if the requested behavior and assertions already exist, emit a zero-write LOW/LUNA VERIFICATION_ONLY node instead of asking a worker to rediscover or rewrite them. A Terra contract or architecture decision does not make its implementation descendants Terra work: depend bounded LOW/LUNA implementation nodes on that decision. Split broad local implementation, mechanical API propagation, focused tests or bug fixes, fixtures, and post-behavior documentation into Luna-ready nodes of at most MAX_LUNA_IMPLEMENTATION_FILES expected implementation files and one deterministic validation. When a concern mixes decision and coding, create a narrow Terra decision node followed by one or more Luna implementation nodes. Do not use Terra merely because the overall specification is large.

Decompose deeply enough that Luna can execute deterministically, but do not create microscopic handoffs. A Luna-ready node owns one cohesive implementation concern and the largest useful deterministic focused validation that passes every measured limit. Its predicted upper bound, not its average, must remain below MAX_LUNA_PREDICTED_P95_TOKENS. Do not split an already machine-ready concern merely to inflate the route percentage; every extra leaf incurs a manager review.

Treat validation cost as part of decomposition. Distinguish FOCUSED validation of one owned test or symbol, INCREMENTAL validation using an existing configured build, and CLEAN_GLOBAL validation that configures or rebuilds broad dependencies. A Luna node may use only FOCUSED or INCREMENTAL validation. Ensure validation can retain complete output on disk while returning a bounded diagnostic summary to the worker.

For each node, perform an authority-closure check: ask whether a plausible failure of its acceptance evidence or focused validation could require a production correction outside allowed_paths while still remaining inside the governing specification. If so, the node is not authority-closed. Split it before registration—for example, a public-header contract node may own compile/layout evidence, while a dependent implementation or integration node owns the source paths and executable runtime smoke. Do not give a header-only or test-only node an acceptance boundary whose ordinary repair authority belongs to another node. Validation may read or execute outside allowed_paths, but every ordinary implementation area that the node could legitimately need to correct must either be in its allowed_paths or belong to an explicit prerequisite/dependent node with its own acceptance boundary.

Resolve every proposed allowed_paths entry against REPOSITORY before staging. Existing implementation repair paths must name the exact existing repository file or directory; never invent a plausible pseudo-directory. For every required symbol classified as an OBSERVED PRODUCER in repository facts, inspect its exact evidence path and either place that producer implementation in the node's mutation authority or bind the node to a prerequisite that owns it. A test or smoke node may keep a producer read-only only when its acceptance boundary is explicitly verification-only and cannot require that producer to change.

Also produce SPECIFICATION_COVERAGE_FILE with exactly this tab-separated header:

obligation_id<TAB>node_ids<TAB>evidence_plan

Include exactly one row for every obligation in SPECIFICATION_OBLIGATIONS_FILE. node_ids is a comma-separated list of DAG nodes whose combined accepted evidence proves that obligation. Every DAG node must appear in at least one coverage row, so the plan cannot invent unrelated work. evidence_plan names the deterministic node evidence and final integration evidence that will discharge the obligation. Respect typed relations: dependency relations constrain order; MAY_DEVELOP_INDEPENDENTLY does not create a false prerequisite; INTEGRATION_DEPENDENCY_ONLY permits isolated fixture work but requires an actual-producer integration node; REGRESSION_BOUNDARY and FINAL_HEALTH_DEPENDENCY require corresponding validation nodes. Repository-derived and planning-hint relations may guide decomposition but cannot override normative authority.

Draft each node with a local authority-closure check, then stage the complete DAG and coverage immediately. Do not perform a second global replay of all obligations, relations, route counts, or validator rules inside this turn; the staging command performs deterministic global checks after preserving the candidate, and a fresh bounded repair turn handles any reported defect. This staging boundary is mandatory before further critique. Do not manually read harness source or manually replay deterministic validators.

Do not create architecture registry files in this turn. Architecture binding is a separate fresh Sol transaction after the DAG is durable.

Stage the DAG and coverage with exactly:

$HARNESS_BIN/manager-stage-decomposition-dag "$HARNESS_ENV_FILE" DAG_FILE SPECIFICATION_COVERAGE_FILE

After the command succeeds, terminate. Do not publish a worker task, construct architecture bindings, wait, poll, or modify repository files.
PROMPT
chmod 600 "$prompt.tmp.$$"
mv "$prompt.tmp.$$" "$prompt"

attempt=1
resume_thread=""
while true; do
	stamp="$(timestamp_compact_utc)"
	json="$dir/logs/manager-decomposition-critic-$stamp-attempt-$(printf '%03d' "$attempt").jsonl"
	stderr="$dir/logs/manager-decomposition-critic-$stamp-attempt-$(printf '%03d' "$attempt").stderr.log"
	message="$dir/logs/manager-decomposition-critic-$stamp-attempt-$(printf '%03d' "$attempt").md"
	set +e
	if [[ -n "$resume_thread" ]]; then
		"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" decomposition "$DECOMPOSITION_MODEL" "$prompt" "$json" "$stderr" "$message" resume "$resume_thread"
	else
		"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" decomposition "$DECOMPOSITION_MODEL" "$prompt" "$json" "$stderr" "$message"
	fi
	status=$?
	set -e
	thread="$(codex_thread_id_from_jsonl "$json" 2>/dev/null || true)"
	[[ ! "$thread" =~ ^[A-Za-z0-9-]+$ ]] || resume_thread="$thread"
	if project_plan_exists; then
		cp -f "$message" "$last_message" 2>/dev/null || true
		log_event "DECOMPOSITION_CRITIC_APPROVED nodes=$(project_plan_total_count) attempts=$attempt"
		printf 'Decomposition critic approved %s DAG nodes.\n' "$(project_plan_total_count)"
		exit 0
	fi
	if decomposition_dag_candidate_matches_current_inputs &&
		[[ "$(decomposition_dag_candidate_state_value status)" == STAGED ]]; then
		cp -f "$message" "$last_message" 2>/dev/null || true
		log_event "DECOMPOSITION_DAG_APPROVED nodes=$(( $(wc -l < "$(decomposition_dag_candidate_state_value dag)") - 1 )) attempts=$attempt"
		printf 'Decomposition DAG and coverage staged for architecture binding.\n'
		exit 0
	fi
	if decomposition_dag_candidate_matches_current_inputs &&
		[[ "$(decomposition_dag_candidate_state_value status)" == REJECTED ]]; then
		cp -f "$message" "$last_message" 2>/dev/null || true
		log_event "DECOMPOSITION_DAG_REPAIR_REQUIRED attempts=$attempt"
		printf 'Decomposition DAG candidate requires deterministic repair.\n'
		exit 0
	fi
	if (( HARNESS_SPECIFICATION_REVIEW_ENABLED == 1 )) && specification_review_requires_clarification; then
		cp -f "$message" "$last_message" 2>/dev/null || true
		log_event "DECOMPOSITION_CRITIC_CLARIFICATION report=$(specification_review_report_relative_path) attempts=$attempt"
		printf 'Specification clarification required: %s\n' "$(specification_review_report_relative_path)"
		exit 3
	fi
	if architecture_redesign_matches_current_inputs &&
		[[ "$(architecture_redesign_state_value status)" == ARCHITECTURE_REDESIGN_REQUIRED ]] &&
		! architecture_redesign_force_matches_current_inputs; then
		cp -f "$message" "$last_message" 2>/dev/null || true
		log_event "DECOMPOSITION_CRITIC_REDESIGN report=$(architecture_redesign_report_relative_path) attempts=$attempt"
		printf 'Architecture redesign required: %s\n' "$(architecture_redesign_report_relative_path)"
		exit 6
	fi
	if specification_renormalization_stall_matches_current_inputs; then
		cp -f "$message" "$last_message" 2>/dev/null || true
		stall_report="$(kv_file_value "$(specification_renormalization_stall_file)" report)"
		printf 'Specification normalization stalled: %s\n' "$stall_report" >&2
		exit 5
	fi
	if (( HARNESS_SPECIFICATION_REVIEW_ENABLED == 1 )) && ! specification_review_is_accepted; then
		cp -f "$message" "$last_message" 2>/dev/null || true
		log_event "DECOMPOSITION_CRITIC_RENORMALIZATION attempts=$attempt"
		printf 'Specification IR renormalization requested.\n'
		exit 4
	fi
	classification="$(kv_file_value "${json%.jsonl}.classification" classification 2>/dev/null || true)"
	retry_kind="$(codex_provider_retry_kind "$classification" 2>/dev/null || true)"
	if [[ -n "$retry_kind" ]]; then
		delay="$(codex_provider_retry_delay "$classification")"
		printf 'Decomposition critic provider retry in %s seconds (%s).\n' "$delay" "$retry_kind" >&2
		sleep "$delay"
		attempt=$((attempt + 1))
		continue
	fi
	(( status == 0 )) && die 'decomposition critic exited without registering a DAG'
	die "decomposition critic failed with status $status; see $json"
done
