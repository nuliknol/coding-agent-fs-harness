#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
require_manager_codex
project_plan_exists && { printf 'Decomposition DAG already exists.\n'; exit 0; }
decomposition_dag_candidate_matches_current_inputs || die 'no rejected DAG candidate matches the current inputs'
[[ "$(decomposition_dag_candidate_state_value status)" == REJECTED ]] || die 'DAG repair requires a rejected candidate'
architecture_fit_is_accepted || die 'DAG repair requires a current accepted architecture-fit review or force waiver'

trace_init manager_decomposition_dag_repair
trace_script_start "$@"
trap 'trace_script_exit $?' EXIT
dir="$(project_dir)"
candidate_dir="$(decomposition_dag_candidate_state_value directory)"
rejection_log="$(decomposition_dag_candidate_state_value rejection_log "$candidate_dir/rejection.log")"
[[ -s "$rejection_log" ]] || die 'rejected DAG candidate has no deterministic validator diagnostics'
candidate_id="${candidate_dir##*/}"
repair_dir="$PROJECT_TMP_DIR/decomposition-dag-repair-$candidate_id"
rm -rf -- "$repair_dir"
mkdir -p "$repair_dir"
install -m 600 "$candidate_dir/dag.tsv" "$repair_dir/dag.tsv"
install -m 600 "$candidate_dir/coverage.tsv" "$repair_dir/coverage.tsv"
[[ ! -f "$candidate_dir/complexity.tsv" ]] || install -m 600 "$candidate_dir/complexity.tsv" "$repair_dir/complexity.tsv"

repair_phase=decomposition_repair
complexity_repair=0
complexity_context='Correct only the reported deterministic DAG/coverage defect. Every DAG row is executable through LUNA or TERRA; never emit SOL or grouping nodes. Routine LOCAL_IMPLEMENTATION, TEST_IMPLEMENTATION, MECHANICAL_API, FOCUSED_BUG, and DOCUMENTATION rows remain LOW/LUNA and must be split rather than converted to Terra with an invented exception.'
if grep -q 'LUNA_COMPLEXITY_OVER_BUDGET.*status=OVER_BUDGET' "$rejection_log"; then
	complexity_repair=1
	repair_phase=decomposition
	complexity_report="$candidate_dir/complexity.tsv"
	[[ -s "$complexity_report" ]] || die 'complexity rejection has no measured complexity report'
	complexity_excess="$(awk -F '\t' '
		NR>1 && $19!="READY" {n=split($20,v,";"); for(i=1;i<=n;i++) if(match(v[i],/=[0-9]+>[0-9]+/)){s=substr(v[i],RSTART+1,RLENGTH-1); split(s,a,">"); excess+=a[1]-a[2]}}
		END{print excess+0}
	' "$complexity_report")"
	complexity_state="$(project_dir)/control/complexity-decomposition-state.env"
	complexity_input_key="$(printf '%s\n%s\n%s\n' "$(specification_sha256)" "$(specification_review_repository_baseline)" "$(complexity_contract_sha256)" | sha256sum | awk '{print $1}')"
	previous_candidate=""; previous_excess=0; previous_measurable=0; previous_passes=0; previous_input_key=""
	if [[ -f "$complexity_state" ]]; then
		previous_input_key="$(kv_file_value "$complexity_state" input_key 2>/dev/null || true)"
		previous_candidate="$(kv_file_value "$complexity_state" candidate 2>/dev/null || true)"
		previous_excess="$(kv_file_value "$complexity_state" excess 2>/dev/null || printf 0)"
		previous_measurable="$(kv_file_value "$complexity_state" measurable 2>/dev/null || true)"
		previous_passes="$(kv_file_value "$complexity_state" passes 2>/dev/null || printf 0)"
	fi
	if [[ "$previous_input_key" != "$complexity_input_key" ]]; then
		previous_candidate=""; previous_excess=0; previous_measurable=0; previous_passes=0
	fi
	[[ "$previous_excess" =~ ^[0-9]+$ ]] || previous_excess=0
	if [[ ! "$previous_measurable" =~ ^[01]$ ]]; then
		(( previous_excess > 0 )) && previous_measurable=1 || previous_measurable=0
	fi
	[[ "$previous_passes" =~ ^[0-9]+$ ]] || previous_passes=0
	complexity_measurable=0
	(( complexity_excess > 0 )) && complexity_measurable=1
	if [[ -n "$previous_candidate" && "$previous_candidate" != "$candidate_id" ]] &&
		(( previous_measurable == 1 )); then
		(( complexity_measurable == 1 )) ||
			die 'recursive complexity decomposition replaced a measured report with an unmeasurable one'
		(( complexity_excess < previous_excess )) ||
			die "recursive complexity decomposition made no measured progress ($complexity_excess >= $previous_excess)"
	fi
	complexity_passes=$((previous_passes + 1))
	(( complexity_passes <= HARNESS_MAX_COMPLEXITY_DECOMPOSITION_PASSES )) ||
		die "recursive complexity decomposition exceeded $HARNESS_MAX_COMPLEXITY_DECOMPOSITION_PASSES bounded Sol repair passes"
	{
		printf 'input_key=%s\n' "$complexity_input_key"
		printf 'candidate=%s\n' "$candidate_id"
		printf 'excess=%s\n' "$complexity_excess"
		printf 'measurable=%s\n' "$complexity_measurable"
		printf 'passes=%s\n' "$complexity_passes"
		printf 'updated_at=%s\n' "$(timestamp_utc)"
	} > "$complexity_state.tmp.$$"
	chmod 600 "$complexity_state.tmp.$$"
	mv "$complexity_state.tmp.$$" "$complexity_state"
	complexity_context="The deterministic complexity contract rejected one or more routine leaves. Read the complete diagnostics and COMPLEXITY_REPORT and recursively split every invalid or OVER_BUDGET Luna node into ordered, independently acceptance-complete children. Every DAG row is executable work and must use an allowed leaf_type plus worker_route LUNA or TERRA; never emit DECOMPOSITION, SOL, planner-only, or grouping rows. Preserve exact obligation coverage and typed dependencies. Reduce the measured excess across this pass and make every routine coding leaf LOW/LUNA. When risk_domains is the only violation, isolate one semantic risk domain per child and narrow each child's allowed paths and implementation files; never clone the same multi-domain scope onto every child. Do not merely lower declared numbers, weaken evidence, erase obligations, or route coding to Terra. Terra is allowed only for an irreducible decision or integration boundary with the exact justified terra_exception vocabulary."
fi

split_context=''
repair_read_instruction='Read VALIDATOR_DIAGNOSTICS, DAG_FILE, SPECIFICATION_COVERAGE_FILE, and COMPLEXITY_REPORT.'
if (( complexity_repair == 1 )); then
	split_rows="$repair_dir/rejected-rows.tsv"
	split_coverage="$repair_dir/rejected-coverage.tsv"
	split_obligations="$repair_dir/rejected-obligations.tsv"
	split_relations="$repair_dir/rejected-relations.tsv"
	replacements="$repair_dir/replacements.tsv"
	mapping="$repair_dir/mapping.tsv"
	awk -F '\t' 'NR==FNR {if(NR==1) next; if($19=="OVER_BUDGET") rejected[$1]=1; next} FNR==1 || ($1 in rejected)' \
		"$complexity_report" "$repair_dir/dag.tsv" > "$split_rows"
	awk -F '\t' 'NR==FNR {if(NR>1 && $19=="OVER_BUDGET") rejected[$1]=1; next} FNR==1 {print; next} {n=split($2,a,","); for(i=1;i<=n;i++) if(a[i] in rejected){print; break}}' \
		"$complexity_report" "$repair_dir/coverage.tsv" > "$split_coverage"
	awk -F '\t' 'NR==FNR {if(NR>1) wanted[$1]=1; next} FNR==1 || ($1 in wanted)' "$split_coverage" "$(specification_obligations_file)" > "$split_obligations"
	awk -F '\t' 'NR==FNR {if(NR>1) wanted[$1]=1; next} FNR==1 || ($3 in wanted) || ($4 in wanted)' "$split_obligations" "$(specification_relations_file)" > "$split_relations"
	printf '%s\n' "$(decomposition_complexity_header)" > "$replacements"
	printf 'old_node_id\treplacement_node_ids\n' > "$mapping"
	chmod 600 "$split_rows" "$split_coverage" "$split_obligations" "$split_relations" "$replacements" "$mapping"
	split_context="This is a bounded node-split transaction. Read REJECTED_DAG_ROWS, REJECTED_COVERAGE, REJECTED_OBLIGATIONS, REJECTED_RELATIONS, VALIDATOR_DIAGNOSTICS, and COMPLEXITY_REPORT only. Do not read or rewrite DAG_FILE or SPECIFICATION_COVERAGE_FILE. For every rejected old node, append at least two complete measured executable rows to REPLACEMENT_DAG_FILE and one mapping row old_node_id<TAB>ordered,comma-separated-new-node-ids to NODE_MAPPING_FILE. New IDs must not already exist. Preserve the old node's semantic obligation across ordered children, but isolate risk domains, paths, symbols, evidence, and focused validation so every child is independently Luna-ready. The first child inherits external prerequisites; later children depend on prior children as needed. Submit exactly once with: $HARNESS_BIN/manager-stage-decomposition-node-split \"$HARNESS_ENV_FILE\" \"$replacements\" \"$mapping\". The harness merges the bounded patch into the immutable full DAG and rewrites coverage mechanically."
	repair_read_instruction='Read only the bounded REJECTED_* files, VALIDATOR_DIAGNOSTICS, and COMPLEXITY_REPORT described below.'
fi

obligation_count="$(awk 'NR > 1 {count++} END {print count + 0}' "$(specification_obligations_file)")"
large_ir_global_repair=0
if (( complexity_repair == 0 && obligation_count >= HARNESS_LARGE_DECOMPOSITION_OBLIGATION_THRESHOLD )); then
	large_ir_global_repair=1
	repair_phase=decomposition
	global_repair_key="$(printf '%s\n%s\n' "$(specification_sha256)" "$(specification_review_repository_baseline)" | sha256sum | awk '{print $1}')"
	global_repair_marker="$(project_dir)/control/decomposition-global-repair-$global_repair_key.attempted"
	[[ ! -f "$global_repair_marker" ]] ||
		die "large-IR global decomposition repair already attempted for the current accepted inputs; refusing an automatic repeat: $global_repair_marker"
	{
		printf 'candidate=%s\n' "$candidate_id"
		printf 'obligations=%s\n' "$obligation_count"
		printf 'attempted_at=%s\n' "$(timestamp_utc)"
	} > "$global_repair_marker.tmp.$$"
	chmod 600 "$global_repair_marker.tmp.$$"
	mv "$global_repair_marker.tmp.$$" "$global_repair_marker"
fi

[[ "$complexity_repair" == 1 ]] && repair_identity='recursive complexity-decomposition agent' || repair_identity='decomposition DAG/coverage repair agent'
prompt="$dir/control/manager-decomposition-dag-repair.prompt.md"
cat > "$prompt.tmp.$$" <<PROMPT
You are a fresh, bounded $repair_identity. Do not edit the repository or perform architecture binding.

ENV_FILE=$HARNESS_ENV_FILE
HARNESS_BIN=$HARNESS_BIN
PROJECT=$PROJECT
AGENT_PHASE=$repair_phase
LARGE_IR_GLOBAL_REPAIR=$large_ir_global_repair
COMPLEXITY_REPAIR=$complexity_repair
NORMALIZED_OBLIGATION_COUNT=$obligation_count
DAG_FILE=$repair_dir/dag.tsv
SPECIFICATION_COVERAGE_FILE=$repair_dir/coverage.tsv
VALIDATOR_DIAGNOSTICS=$rejection_log
COMPLEXITY_REPORT=$repair_dir/complexity.tsv
SPECIFICATION_OBLIGATIONS_FILE=$(specification_obligations_file)
SPECIFICATION_RELATIONS_FILE=$(specification_relations_file)
REJECTED_DAG_ROWS=${split_rows:--}
REJECTED_COVERAGE=${split_coverage:--}
REJECTED_OBLIGATIONS=${split_obligations:--}
REJECTED_RELATIONS=${split_relations:--}
REPLACEMENT_DAG_FILE=${replacements:--}
NODE_MAPPING_FILE=${mapping:--}

$repair_read_instruction Do not inspect repository files, the human specification, inventory, harness source, development policy, Git history, prior agent logs, or unrelated temporary files.

$complexity_context $split_context Preserve deliverables, routes, allowed paths, validations, and obligation meaning except where splitting requires narrower child-local values. For typed dependency violations, make the consumer's allocated nodes follow the producer's allocated nodes through explicit DAG dependencies. If that would create a cycle because the current coverage groups obligations at the wrong semantic boundary, reassign those obligations to the semantically correct existing node or split that one node into bounded ordered leaves; never add a cyclic edge, erase a relation, map everything to an integration node, or collapse unrelated work. For an unjustified node, remove or merge only that node while preserving every normalized obligation exactly once in coverage and retaining all still-justified work. Apply the same reported defect class across all affected rows before submitting. LARGE_IR_GLOBAL_REPAIR=1 means this is the single permitted global repair for a large normalized IR: resolve all diagnostics as one coherent relation-aware DAG correction, but remain confined to the supplied bounded semantic files.

When COMPLEXITY_REPAIR=0, submit once with:

$HARNESS_BIN/manager-stage-decomposition-dag "$HARNESS_ENV_FILE" "$repair_dir/dag.tsv" "$repair_dir/coverage.tsv"

If validation rejects it, read only the new rejection log printed by that staged candidate, make at most one additional bounded correction, and submit once more. After success, terminate. Never create architecture files, launch tests, or search the repository.
PROMPT
chmod 600 "$prompt.tmp.$$"
mv "$prompt.tmp.$$" "$prompt"

stamp="$(timestamp_compact_utc)"
json="$dir/logs/manager-decomposition-dag-repair-$stamp-attempt-001.jsonl"
stderr="$dir/logs/manager-decomposition-dag-repair-$stamp-attempt-001.stderr.log"
message="$dir/logs/manager-decomposition-dag-repair-$stamp-attempt-001.md"
set +e
"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" decomposition "$DECOMPOSITION_MODEL" "$prompt" "$json" "$stderr" "$message"
status=$?
set -e
if decomposition_dag_candidate_matches_current_inputs &&
	[[ "$(decomposition_dag_candidate_state_value status)" == STAGED ]]; then
	log_event "DECOMPOSITION_DAG_REPAIR_ACCEPTED candidate=$candidate_id"
	printf 'Decomposition DAG candidate repaired and staged.\n'
	exit 0
fi
new_candidate_dir="$(decomposition_dag_candidate_state_value directory -)"
if (( status == 0 )) && [[ "$new_candidate_dir" != - && "$new_candidate_dir" != "$candidate_dir" ]] &&
	decomposition_dag_candidate_matches_current_inputs; then
	log_event "DECOMPOSITION_DAG_REPAIR_PROGRESS previous=$candidate_id current=${new_candidate_dir##*/} status=$(decomposition_dag_candidate_state_value status -)"
	printf 'DAG repair produced a new durable candidate; continuing bounded validation.\n'
	exit 0
fi
(( status == 0 )) && die 'DAG repair exited without staging a valid candidate'
die "DAG repair failed with status $status; see $json"
