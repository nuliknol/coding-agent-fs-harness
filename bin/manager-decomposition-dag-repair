#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
require_manager_codex
project_plan_exists && { printf 'Decomposition DAG already exists.\n'; exit 0; }
decomposition_dag_candidate_matches_current_inputs || die 'no rejected DAG candidate matches the current inputs'
[[ "$(decomposition_dag_candidate_state_value status)" == REJECTED ]] || die 'DAG repair requires a rejected candidate'
architecture_fit_is_accepted || die 'DAG repair requires a current accepted architecture-fit review or force waiver'

trace_init manager_decomposition_dag_repair
trace_script_start "$@"
dir="$(project_dir)"
rm -f "$dir/control/manager-plan-structural-error.md"

record_decomposition_repair_stall()
{
	local status="$1" marker="$dir/control/manager-plan-structural-error.md" tmp
	(( status != 0 )) || return 0
	project_plan_exists && return 0
	tmp="$marker.tmp.$$"
	{
		printf '# Decomposition Repair Stalled\n\n'
		printf 'Project: %s\n\n' "$PROJECT"
		printf 'Failed-At: %s\n\n' "$(timestamp_utc)"
		printf 'Exit-Status: %s\n\n' "$status"
		printf 'The bounded recursive Sol repair did not install a valid DAG. The latest candidate, mapping, complexity report, and deterministic diagnostics are preserved; startup will not silently appear stopped.\n'
	} > "$tmp"
	chmod 600 "$tmp"
	mv "$tmp" "$marker"
}

repair_exit()
{
	local status=$?
	record_decomposition_repair_stall "$status"
	trace_script_exit "$status"
}
trap repair_exit EXIT
candidate_dir="$(decomposition_dag_candidate_state_value directory)"
rejection_log="$(decomposition_dag_candidate_state_value rejection_log "$candidate_dir/rejection.log")"
[[ -s "$rejection_log" ]] || die 'rejected DAG candidate has no deterministic validator diagnostics'
candidate_id="${candidate_dir##*/}"
repair_dir="$PROJECT_TMP_DIR/decomposition-dag-repair-$candidate_id"
rm -rf -- "$repair_dir"
mkdir -p "$repair_dir"
install -m 600 "$candidate_dir/dag.tsv" "$repair_dir/dag.tsv"
install -m 600 "$candidate_dir/coverage.tsv" "$repair_dir/coverage.tsv"
complexity_report='-'
if [[ -f "$candidate_dir/complexity.tsv" ]]; then
	complexity_report="$repair_dir/complexity.tsv"
	install -m 600 "$candidate_dir/complexity.tsv" "$complexity_report"
fi
context_admission='-'
context_suggested_cuts='-'
context_repair_report='-'
if [[ -s "$candidate_dir/context-admission/admission.tsv" ]]; then
	context_admission="$repair_dir/context-admission.tsv"
	install -m 600 "$candidate_dir/context-admission/admission.tsv" "$context_admission"
fi
if [[ -s "$candidate_dir/context-admission/suggested-cuts.tsv" ]]; then
	context_suggested_cuts="$repair_dir/context-suggested-cuts.tsv"
	install -m 600 "$candidate_dir/context-admission/suggested-cuts.tsv" "$context_suggested_cuts"
fi
if [[ -s "$candidate_dir/context-admission/repair.tsv" ]]; then
	context_repair_report="$repair_dir/context-repair.tsv"
	install -m 600 "$candidate_dir/context-admission/repair.tsv" "$context_repair_report"
fi

repair_input_sha="$({
	sha256sum "$repair_dir/dag.tsv" "$repair_dir/coverage.tsv" "$rejection_log"
	[[ ! -s "$repair_dir/complexity.tsv" ]] || sha256sum "$repair_dir/complexity.tsv"
	[[ "$context_admission" == - ]] || sha256sum "$context_admission"
	[[ "$context_suggested_cuts" == - ]] || sha256sum "$context_suggested_cuts"
	[[ "$context_repair_report" == - ]] || sha256sum "$context_repair_report"
} | sha256sum | awk '{print $1}')"
repair_implementation_sha="$({
	sha256sum "$0" "$HARNESS_BIN/codex-exec-jsonl"
	printf 'read_lines=%s\nread_bytes=%s\ncommand_bytes=%s\n' \
		"$HARNESS_VALIDATION_OUTPUT_MAX_LINES" "$HARNESS_VALIDATION_OUTPUT_MAX_BYTES" \
		"$HARNESS_MAX_AGENT_COMMAND_OUTPUT_BYTES"
} | sha256sum | awk '{print $1}')"
recovery_marker="$dir/control/startup-recoverable.env"
if [[ -f "$recovery_marker" ]] &&
	[[ "$(kv_file_value "$recovery_marker" state)" == RECOVERABLE ]] &&
	[[ "$(kv_file_value "$recovery_marker" stage)" == decomposition_dag_repair ]] &&
	[[ "$(kv_file_value "$recovery_marker" specification_sha256)" == "$(specification_sha256)" ]] &&
	[[ "$(kv_file_value "$recovery_marker" repository_baseline)" == "$(specification_review_repository_baseline)" ]] &&
	[[ "$(kv_file_value "$recovery_marker" domain_profiles_sha256)" == "$(domain_profiles_sha256)" ]] &&
	[[ "$(kv_file_value "$recovery_marker" input_sha256)" == "$repair_input_sha" ]] &&
	[[ "$(kv_file_value "$recovery_marker" harness_implementation_sha256)" == "$repair_implementation_sha" ]]; then
	printf 'DAG-repair startup remains recoverable; refusing to replay the unchanged failed input. Fix or update the harness, then restart: %s\n' "$recovery_marker" >&2
	exit 7
elif [[ -f "$recovery_marker" ]]; then
	resolved_marker="$dir/logs/startup-recovery-resumed-$(timestamp_compact_utc)-$$.env"
	mv "$recovery_marker" "$resolved_marker"
	log_event "STARTUP_RECOVERY_RESUMED stage=decomposition_dag_repair prior=$resolved_marker resume_from=rejected_decomposition_dag input=$rejection_log"
fi

repair_phase=decomposition_repair
complexity_repair=0
context_closure_repair=0
complexity_context='Correct only the reported deterministic DAG/coverage defect. Every DAG row is executable through LUNA or TERRA; never emit SOL or grouping nodes. Routine LOCAL_IMPLEMENTATION, TEST_IMPLEMENTATION, MECHANICAL_API, FOCUSED_BUG, DOCUMENTATION, and VERIFICATION_ONLY rows remain LOW/LUNA and must be split rather than converted to Terra with an invented exception.'
if [[ "$(decomposition_dag_candidate_state_value rejection_stage -)" == context_closure ]] ||
	grep -Eq 'CONTEXT_CLOSURE_OVER_BUDGET.*status=OVER_BUDGET' "$rejection_log"; then
	context_closure_repair=1
	repair_phase=decomposition
	complexity_context="Context Closure admission rejected specific DAG nodes before complexity measurement. Read VALIDATOR_DIAGNOSTICS, CONTEXT_ADMISSION_REPORT, CONTEXT_REPAIR_REPORT, and CONTEXT_SUGGESTED_CUTS. CONTEXT_REPAIR_REPORT is the exact compiled identifier/path diagnostic for every non-ready node; correct those rows rather than guessing from a count. Split or narrow only the reported over-budget nodes along compiled source/build-target seams. Preserve every normalized obligation and dependency, keep every executable child LOW/LUNA under luna_only policy, and do not require or invent a complexity report for this pre-complexity rejection."
elif grep -Eq 'LUNA_COMPLEXITY_OVER_BUDGET.*status=OVER_BUDGET' "$rejection_log"; then
	complexity_repair=1
	repair_phase=decomposition
	complexity_report="$repair_dir/complexity.tsv"
	[[ -s "$complexity_report" ]] || die 'complexity rejection has no measured complexity report'
	complexity_excess="$(awk -F '\t' '
		NR>1 && $19!="READY" {n=split($20,v,";"); for(i=1;i<=n;i++) if(match(v[i],/=[0-9]+>[0-9]+/)){s=substr(v[i],RSTART+1,RLENGTH-1); split(s,a,">"); excess+=a[1]-a[2]}}
		END{print excess+0}
	' "$complexity_report")"
	complexity_scope="$(awk -F '\t' 'NR>1 && $19!="READY" {scope += $14} END {print scope+0}' "$complexity_report")"
	complexity_max_score="$(awk -F '\t' 'NR>1 && $19!="READY" && $4+0>max {max=$4+0} END {print max+0}' "$complexity_report")"
	complexity_max_actions="$(awk -F '\t' 'NR>1 && $19!="READY" && $15+0>max {max=$15+0} END {print max+0}' "$complexity_report")"
	complexity_max_p95="$(awk -F '\t' 'NR>1 && $19!="READY" && $17+0>max {max=$17+0} END {print max+0}' "$complexity_report")"
	complexity_state="$(project_dir)/control/complexity-decomposition-state.env"
	complexity_input_key="$(printf '%s\n%s\n%s\n' "$(specification_sha256)" "$(specification_review_repository_baseline)" "$(complexity_contract_sha256)" | sha256sum | awk '{print $1}')"
	previous_candidate=""; previous_excess=0; previous_scope=0; previous_max_score=0; previous_max_actions=0; previous_max_p95=0
	previous_measurable=0; previous_passes=0; previous_input_key=""
	if [[ -f "$complexity_state" ]]; then
		previous_input_key="$(kv_file_value "$complexity_state" input_key 2>/dev/null || true)"
		previous_candidate="$(kv_file_value "$complexity_state" candidate 2>/dev/null || true)"
		previous_excess="$(kv_file_value "$complexity_state" excess 2>/dev/null || printf 0)"
		previous_scope="$(kv_file_value "$complexity_state" scope 2>/dev/null || printf 0)"
		previous_max_score="$(kv_file_value "$complexity_state" max_score 2>/dev/null || printf 0)"
		previous_max_actions="$(kv_file_value "$complexity_state" max_actions 2>/dev/null || printf 0)"
		previous_max_p95="$(kv_file_value "$complexity_state" max_p95 2>/dev/null || printf 0)"
		previous_measurable="$(kv_file_value "$complexity_state" measurable 2>/dev/null || true)"
		previous_passes="$(kv_file_value "$complexity_state" passes 2>/dev/null || printf 0)"
	fi
	if [[ "$previous_input_key" != "$complexity_input_key" ]]; then
		previous_candidate=""; previous_excess=0; previous_scope=0; previous_max_score=0; previous_max_actions=0; previous_max_p95=0
		previous_measurable=0; previous_passes=0
	fi
	[[ "$previous_excess" =~ ^[0-9]+$ ]] || previous_excess=0
	[[ "$previous_scope" =~ ^[0-9]+$ ]] || previous_scope=0
	[[ "$previous_max_score" =~ ^[0-9]+$ ]] || previous_max_score=0
	[[ "$previous_max_actions" =~ ^[0-9]+$ ]] || previous_max_actions=0
	[[ "$previous_max_p95" =~ ^[0-9]+$ ]] || previous_max_p95=0
	if [[ -n "$previous_candidate" ]] &&
		(( previous_scope == 0 || previous_max_score == 0 || previous_max_actions == 0 || previous_max_p95 == 0 )); then
		previous_report="$(project_dir)/control/decomposition-dag-candidates/$previous_candidate/complexity.tsv"
		if [[ -f "$previous_report" ]]; then
			(( previous_scope > 0 )) || previous_scope="$(awk -F '\t' 'NR>1 && $19!="READY" {scope += $14} END {print scope+0}' "$previous_report")"
			(( previous_max_score > 0 )) || previous_max_score="$(awk -F '\t' 'NR>1 && $19!="READY" && $4+0>max {max=$4+0} END {print max+0}' "$previous_report")"
			(( previous_max_actions > 0 )) || previous_max_actions="$(awk -F '\t' 'NR>1 && $19!="READY" && $15+0>max {max=$15+0} END {print max+0}' "$previous_report")"
			(( previous_max_p95 > 0 )) || previous_max_p95="$(awk -F '\t' 'NR>1 && $19!="READY" && $17+0>max {max=$17+0} END {print max+0}' "$previous_report")"
		fi
	fi
	if [[ ! "$previous_measurable" =~ ^[01]$ ]]; then
		(( previous_excess > 0 )) && previous_measurable=1 || previous_measurable=0
	fi
	[[ "$previous_passes" =~ ^[0-9]+$ ]] || previous_passes=0
	complexity_measurable=0
	(( complexity_excess > 0 )) && complexity_measurable=1
	if [[ -n "$previous_candidate" && "$previous_candidate" != "$candidate_id" ]] &&
		(( previous_measurable == 1 )); then
		(( complexity_measurable == 1 )) ||
			die 'recursive complexity decomposition replaced a measured report with an unmeasurable one'
		(( complexity_excess < previous_excess || complexity_scope < previous_scope ||
			complexity_max_score < previous_max_score || complexity_max_actions < previous_max_actions ||
			complexity_max_p95 < previous_max_p95 )) ||
			die "recursive complexity decomposition made no measured progress (excess $complexity_excess >= $previous_excess; scope $complexity_scope >= $previous_scope; max score $complexity_max_score >= $previous_max_score; max actions $complexity_max_actions >= $previous_max_actions; max p95 $complexity_max_p95 >= $previous_max_p95)"
	fi
	complexity_passes=$((previous_passes + 1))
	(( complexity_passes <= HARNESS_MAX_COMPLEXITY_DECOMPOSITION_PASSES )) ||
		die "recursive complexity decomposition exceeded $HARNESS_MAX_COMPLEXITY_DECOMPOSITION_PASSES bounded Sol repair passes"
	{
		printf 'input_key=%s\n' "$complexity_input_key"
		printf 'candidate=%s\n' "$candidate_id"
		printf 'excess=%s\n' "$complexity_excess"
		printf 'scope=%s\n' "$complexity_scope"
		printf 'max_score=%s\n' "$complexity_max_score"
		printf 'max_actions=%s\n' "$complexity_max_actions"
		printf 'max_p95=%s\n' "$complexity_max_p95"
		printf 'measurable=%s\n' "$complexity_measurable"
		printf 'passes=%s\n' "$complexity_passes"
		printf 'updated_at=%s\n' "$(timestamp_utc)"
	} > "$complexity_state.tmp.$$"
	chmod 600 "$complexity_state.tmp.$$"
	mv "$complexity_state.tmp.$$" "$complexity_state"
	complexity_context="The deterministic complexity contract rejected one or more routine leaves. Read the complete diagnostics, COMPLEXITY_REPORT, and the optional CONTEXT_ADMISSION_REPORT and CONTEXT_SUGGESTED_CUTS when they are not '-'. Recursively split every invalid or OVER_BUDGET Luna node into ordered, independently acceptance-complete children. Context measurements are deterministic repository evidence: use the suggested build-target/source seams and exact unresolved facts, but preserve normative obligation meaning and do not mechanically split implementation from its focused test when one acceptance boundary requires both. Every DAG row is executable work and must use an allowed leaf_type plus worker_route LUNA or TERRA; never emit DECOMPOSITION, SOL, planner-only, or grouping rows. Preserve exact obligation coverage and typed dependencies. Reduce the measured excess across this pass and make every routine coding leaf LOW/LUNA. When risk_domains is the only violation, isolate one semantic risk domain per child and narrow each child's allowed paths and implementation files; never clone the same multi-domain scope onto every child. Do not merely lower declared numbers, weaken evidence, erase obligations, or route coding to Terra. If and only if a one-file, one-acceptance-boundary leaf still spans more than the Luna risk-domain limit and cannot be split into independently verifiable changes, replace that executable boundary with leaf_type INTEGRATION, complexity_class HIGH, worker_route TERRA, and terra_exception IRREDUCIBLE_CROSS_BOUNDARY. Do not invent another exception spelling and do not retain a routine coding leaf_type on that Terra boundary."
fi

split_context=''
repair_read_instruction='Inspect VALIDATOR_DIAGNOSTICS first, then query only the exact rows needed from DAG_FILE, SPECIFICATION_COVERAGE_FILE, COMPLEXITY_REPORT, and optional Context Closure reports when their paths are not dash.'
if (( complexity_repair == 1 )); then
	split_rows="$repair_dir/rejected-rows.tsv"
	split_coverage="$repair_dir/rejected-coverage.tsv"
	split_obligations="$repair_dir/rejected-obligations.tsv"
	split_relations="$repair_dir/rejected-relations.tsv"
	replacements="$repair_dir/replacements.tsv"
	mapping="$repair_dir/mapping.tsv"
	awk -F '\t' 'NR==FNR {if(NR==1) next; if($19=="OVER_BUDGET") rejected[$1]=1; next} FNR==1 || ($1 in rejected)' \
		"$complexity_report" "$repair_dir/dag.tsv" > "$split_rows"
	awk -F '\t' 'NR==FNR {if(NR>1 && $19=="OVER_BUDGET") rejected[$1]=1; next} FNR==1 {print; next} {n=split($2,a,","); for(i=1;i<=n;i++) if(a[i] in rejected){print; break}}' \
		"$complexity_report" "$repair_dir/coverage.tsv" > "$split_coverage"
	awk -F '\t' 'NR==FNR {if(NR>1) wanted[$1]=1; next} FNR==1 || ($1 in wanted)' "$split_coverage" "$(specification_obligations_file)" > "$split_obligations"
	awk -F '\t' 'NR==FNR {if(NR>1) wanted[$1]=1; next} FNR==1 || ($3 in wanted) || ($4 in wanted)' "$split_obligations" "$(specification_relations_file)" > "$split_relations"
	printf '%s\n' "$(decomposition_complexity_header)" > "$replacements"
	{
		printf 'old_node_id\treplacement_node_ids\n'
		awk -F '\t' 'NR>1 && $19=="OVER_BUDGET" {printf "%s\tREPLACE_WITH_ORDERED_CHILD_IDS\n", $1}' "$complexity_report"
	} > "$mapping"
	chmod 600 "$split_rows" "$split_coverage" "$split_obligations" "$split_relations" "$replacements" "$mapping"
	split_context="This is a bounded node-split transaction. Read REJECTED_DAG_ROWS, REJECTED_COVERAGE, REJECTED_OBLIGATIONS, REJECTED_RELATIONS, VALIDATOR_DIAGNOSTICS, and COMPLEXITY_REPORT only. Do not read or rewrite DAG_FILE or SPECIFICATION_COVERAGE_FILE. NODE_MAPPING_FILE is machine-owned in its first column and already contains exactly the current rejected node IDs. Do not add, remove, reorder, or replace those rows; replace only each REPLACE_WITH_ORDERED_CHILD_IDS value. For every listed old node, append at least two complete measured executable rows to REPLACEMENT_DAG_FILE and set its existing second field to ordered,comma-separated-new-node-ids. New IDs must not already exist. Preserve the old node's semantic obligation across ordered children, but isolate risk domains, paths, symbols, evidence, and focused validation so every child is independently Luna-ready. The first child inherits external prerequisites; later children depend on prior children as needed. Submit exactly once with: $HARNESS_BIN/manager-stage-decomposition-node-split \"$HARNESS_ENV_FILE\" \"$replacements\" \"$mapping\". The harness merges the bounded patch into the immutable full DAG and rewrites coverage mechanically."
	repair_read_instruction='Read only the bounded REJECTED_* files, VALIDATOR_DIAGNOSTICS, COMPLEXITY_REPORT, and optional Context Closure reports described below.'
fi

obligation_count="$(awk 'NR > 1 {count++} END {print count + 0}' "$(specification_obligations_file)")"
large_ir_global_repair=0
if (( complexity_repair == 0 && context_closure_repair == 0 && obligation_count >= HARNESS_LARGE_DECOMPOSITION_OBLIGATION_THRESHOLD )); then
	large_ir_global_repair=1
	repair_phase=decomposition
	global_repair_key="$(printf '%s\n%s\n' "$(specification_sha256)" "$(specification_review_repository_baseline)" | sha256sum | awk '{print $1}')"
	global_repair_marker="$(project_dir)/control/decomposition-global-repair-$global_repair_key.attempted"
	[[ ! -f "$global_repair_marker" ]] ||
		die "large-IR global decomposition repair already attempted for the current accepted inputs; refusing an automatic repeat: $global_repair_marker"
	{
		printf 'candidate=%s\n' "$candidate_id"
		printf 'obligations=%s\n' "$obligation_count"
		printf 'attempted_at=%s\n' "$(timestamp_utc)"
	} > "$global_repair_marker.tmp.$$"
	chmod 600 "$global_repair_marker.tmp.$$"
	mv "$global_repair_marker.tmp.$$" "$global_repair_marker"
fi

if (( complexity_repair == 1 )); then
	repair_identity='recursive complexity-decomposition agent'
elif (( context_closure_repair == 1 )); then
	repair_identity='Context Closure decomposition-repair agent'
else
	repair_identity='decomposition DAG/coverage repair agent'
fi
prompt="$dir/control/manager-decomposition-dag-repair.prompt.md"
cat > "$prompt.tmp.$$" <<PROMPT
You are a fresh, bounded $repair_identity. Do not edit the repository or perform architecture binding.

ENV_FILE=$HARNESS_ENV_FILE
HARNESS_BIN=$HARNESS_BIN
PROJECT=$PROJECT
AGENT_PHASE=$repair_phase
LARGE_IR_GLOBAL_REPAIR=$large_ir_global_repair
COMPLEXITY_REPAIR=$complexity_repair
CONTEXT_CLOSURE_REPAIR=$context_closure_repair
NORMALIZED_OBLIGATION_COUNT=$obligation_count
DAG_FILE=$repair_dir/dag.tsv
SPECIFICATION_COVERAGE_FILE=$repair_dir/coverage.tsv
VALIDATOR_DIAGNOSTICS=$rejection_log
COMPLEXITY_REPORT=$complexity_report
CONTEXT_ADMISSION_REPORT=$context_admission
CONTEXT_SUGGESTED_CUTS=$context_suggested_cuts
CONTEXT_REPAIR_REPORT=$context_repair_report
SPECIFICATION_OBLIGATIONS_FILE=$(specification_obligations_file)
SPECIFICATION_RELATIONS_FILE=$(specification_relations_file)
REJECTED_DAG_ROWS=${split_rows:--}
REJECTED_COVERAGE=${split_coverage:--}
REJECTED_OBLIGATIONS=${split_obligations:--}
REJECTED_RELATIONS=${split_relations:--}
REPLACEMENT_DAG_FILE=${replacements:--}
NODE_MAPPING_FILE=${mapping:--}

$repair_read_instruction Do not inspect repository files, the human specification, inventory, harness source, development policy, Git history, prior agent logs, or unrelated temporary files.

Read exactly one named repair source per shell action. For a whole-file bounded read, use one pipeline exactly: \`head -n $HARNESS_VALIDATION_OUTPUT_MAX_LINES "\$ONE_FILE" | head -c $HARNESS_VALIDATION_OUTPUT_MAX_BYTES\`. The byte limiter consumes the line-limited stream. Never invoke both heads separately, join duplicate reads with a semicolon, or print the same source twice in one command. Never concatenate, loop over, or combine repair sources in one action. Never use cat for inspection or run unbounded sed, awk, rg, grep, diff, or patch-generation output. Every shell action has one aggregate hard transcript budget of $HARNESS_VALIDATION_OUTPUT_MAX_LINES lines and $HARNESS_VALIDATION_OUTPUT_MAX_BYTES bytes across stdout and stderr. Query exact diagnostic node IDs, obligation IDs, or row numbers instead of dumping whole TSVs. Apply file-local rewrites without printing the rewritten file or a generated patch to the transcript, then inspect only the exact bounded rows needed to verify the change. The exact staging commands below are exempt from the one-source rule; keep their output bounded.

$complexity_context $split_context Preserve deliverables, routes, allowed paths, validations, and obligation meaning except where splitting requires narrower child-local values. For typed dependency violations, make the consumer's allocated nodes follow the producer's allocated nodes through explicit DAG dependencies. If that would create a cycle because the current coverage groups obligations at the wrong semantic boundary, reassign those obligations to the semantically correct existing node or split that one node into bounded ordered leaves; never add a cyclic edge, erase a relation, map everything to an integration node, or collapse unrelated work. For an unjustified node, remove or merge only that node while preserving every normalized obligation exactly once in coverage and retaining all still-justified work. Apply the same reported defect class across all affected rows before submitting. LARGE_IR_GLOBAL_REPAIR=1 means this is the single permitted global repair for a large normalized IR: resolve all diagnostics as one coherent relation-aware DAG correction, but remain confined to the supplied bounded semantic files.

When COMPLEXITY_REPAIR=0, submit once with:

$HARNESS_BIN/manager-stage-decomposition-dag "$HARNESS_ENV_FILE" "$repair_dir/dag.tsv" "$repair_dir/coverage.tsv"

If validation rejects it, terminate immediately with that bounded diagnostic. The startup transaction will classify the new durable candidate and start a fresh repair turn compiled specifically for its rejection stage. Do not inspect the new candidate, read its rejection log, or attempt a second correction in this context. After success, terminate. Never create architecture files, launch tests, or search the repository.
The staging command's zero exit status is complete success authority. After a zero exit, do not inspect, list, find, or count files in the candidate directory; terminate immediately.
PROMPT
if [[ "$HARNESS_MODEL_POLICY" == luna_only ]]; then
	cat >> "$prompt.tmp.$$" <<PROMPT

LUNA-ONLY POLICY OVERRIDE: Repair every rejected boundary into LOW/LUNA executable children with terra_exception '-'. Never introduce TERRA, Sol, an irreducible stronger-model exception, or a global integration worker. Preserve obligation coverage and use ordered compatibility stages when one broad boundary cannot fit a single Luna closure.
PROMPT
fi
chmod 600 "$prompt.tmp.$$"
mv "$prompt.tmp.$$" "$prompt"

stamp="$(timestamp_compact_utc)"
json="$dir/logs/manager-decomposition-dag-repair-$stamp-attempt-001.jsonl"
stderr="$dir/logs/manager-decomposition-dag-repair-$stamp-attempt-001.stderr.log"
message="$dir/logs/manager-decomposition-dag-repair-$stamp-attempt-001.md"
set +e
"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" decomposition "$DECOMPOSITION_MODEL" "$prompt" "$json" "$stderr" "$message"
status=$?
set -e
classification="$(kv_file_value "${json%.jsonl}.classification" classification 2>/dev/null || true)"
if [[ "$classification" == agent_command_output_budget_exceeded ]]; then
	classification_file="${json%.jsonl}.classification"
	resume_from=rejected_decomposition_dag
	if decomposition_dag_candidate_matches_current_inputs &&
		[[ "$(decomposition_dag_candidate_state_value status)" == STAGED ]]; then
		# The deterministic stage is durable, but the offending agent episode is
		# still a recoverable startup incident. A fixed restart may advance from
		# this candidate without replaying the amplified transcript.
		resume_from=staged_decomposition_dag
	fi
	{
		printf 'state=RECOVERABLE\n'
		printf 'stage=decomposition_dag_repair\n'
		printf 'resume_from=%s\n' "$resume_from"
		printf 'classification=%s\n' "$classification"
		printf 'offending_input=%s\n' "$prompt"
		printf 'input_sha256=%s\n' "$repair_input_sha"
		printf 'classification_file=%s\n' "$classification_file"
		printf 'jsonl=%s\n' "$json"
		printf 'specification_review_report=%s\n' "$(specification_review_report_relative_path)"
		printf 'architecture_fit_report=%s\n' "$(architecture_fit_state_value report force-waiver)"
		printf 'specification_sha256=%s\n' "$(specification_sha256)"
		printf 'repository_baseline=%s\n' "$(specification_review_repository_baseline)"
		printf 'domain_profiles_sha256=%s\n' "$(domain_profiles_sha256)"
		printf 'harness_implementation_sha256=%s\n' "$repair_implementation_sha"
		printf 'recorded_at=%s\n' "$(timestamp_utc)"
	} > "$recovery_marker.tmp.$$"
	chmod 600 "$recovery_marker.tmp.$$"
	mv "$recovery_marker.tmp.$$" "$recovery_marker"
	log_event "STARTUP_RECOVERABLE stage=decomposition_dag_repair classification=$classification input=$prompt input_sha256=$repair_input_sha classification_file=$classification_file resume_from=$resume_from"
	printf 'DAG-repair startup paused recoverably after a command-output limit hit; durable candidate is preserved: %s\n' "$recovery_marker" >&2
	exit 7
fi
if decomposition_dag_candidate_matches_current_inputs &&
	[[ "$(decomposition_dag_candidate_state_value status)" == STAGED ]]; then
	log_event "DECOMPOSITION_DAG_REPAIR_ACCEPTED candidate=$candidate_id"
	printf 'Decomposition DAG candidate repaired and staged.\n'
	exit 0
fi
new_candidate_dir="$(decomposition_dag_candidate_state_value directory -)"
if [[ "$new_candidate_dir" != - && "$new_candidate_dir" != "$candidate_dir" ]] &&
	decomposition_dag_candidate_matches_current_inputs; then
	# Preserve a newly staged/rejected candidate even when the surrounding
	# agent wrapper is cut off after the durable staging command completes.
	log_event "DECOMPOSITION_DAG_REPAIR_PROGRESS previous=$candidate_id current=${new_candidate_dir##*/} status=$(decomposition_dag_candidate_state_value status -)"
	printf 'DAG repair produced a new durable candidate; continuing bounded validation.\n'
	exit 0
fi
(( status == 0 )) && die 'DAG repair exited without staging a valid candidate'
die "DAG repair failed with status $status; see $json"
