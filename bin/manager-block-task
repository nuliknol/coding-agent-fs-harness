#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE TASK_ID REVIEW_NOTE_FILE [REASON] [--lock-held]\n' "${0##*/}" >&2
	exit 2
}

[[ $# -ge 3 && $# -le 5 ]] || usage
load_harness_env "$1"
task_id="$2"
note_file="$3"
reason="${4:-repeated identical zero-progress blocker}"
lock_held="${5:-}"
[[ -z "$lock_held" || "$lock_held" == '--lock-held' ]] || usage

ensure_project
trace_init manager_block_task
trace_script_start "$@"
trap 'trace_script_exit $?' EXIT
validate_task_id "$task_id"
[[ -f "$note_file" ]] || die "review note file does not exist: $note_file"
[[ "$lock_held" == '--lock-held' ]] || acquire_project_lock

dir="$(project_dir)"
base="$(task_base "$task_id")"
root="$(task_root_id "$task_id")"
result="$dir/results/$base.result.md"
blocked="$dir/archive/$base.blocked.md"
rejected="$dir/archive/$base.rejected.md"
assignment_archive="$dir/archive/$base.assignment.md"
running="$dir/running/$base.running.md"
lease="$dir/control/$base.lease"
progress_percent="$(review_percent "$note_file" Progress-Percent)"
improvement_percent="$(review_percent "$note_file" Improvement-Percent)"
goal_outcome=""
blocker_class="$(metadata_value "$note_file" Blocker-Class)"
remediation_scope="$(metadata_value "$note_file" Remediation-Scope)"
human_dependency_evidence="$(metadata_value "$note_file" Human-Dependency-Evidence)"
product_decision_evidence="$(metadata_value "$note_file" Product-Decision-Evidence)"
governing_specification_search="$(metadata_value "$note_file" Governing-Specification-Search)"
[[ ! -f "$result" ]] || goal_outcome="$(metadata_value "$result" Goal-Outcome)"

[[ -n "$progress_percent" ]] || progress_percent="$(task_progress_percent "$root")"
[[ -n "$improvement_percent" ]] || improvement_percent=0
validate_percent "$progress_percent" 'Progress-Percent'
validate_percent "$improvement_percent" 'Improvement-Percent'
(( progress_percent < 100 )) || die 'a blocked task must have Progress-Percent below 100%'
[[ -f "$assignment_archive" ]] || die "archived assignment is missing: $task_id"
[[ ! -e "$running" ]] || die "task is still running: $task_id"
[[ ! -e "$lease" ]] || die "worker lease still exists: $task_id"

validate_local_remediation_scope()
{
	local scope="$1" assignment="$2" assignment_scope entry
	local -a entries=()
	assignment_scope="$(metadata_value "$assignment" Allowed-Scope)"
	if [[ "$scope" == - ]]; then
		[[ "$assignment_scope" == - ]] ||
			die 'repository-local Remediation-Scope may be - only for an immutable read-only assignment'
		return 0
	fi
	mapfile -t entries < <(
		printf '%s\n' "$scope" | tr ',;[:space:]' '\n' | sed '/^$/d' | LC_ALL=C sort -u
	)
	(( ${#entries[@]} > 0 )) ||
		die 'repository-local Remediation-Scope must name at least one exact repository path'
	for entry in "${entries[@]}"; do
		[[ -n "$entry" && "$entry" != - && "$entry" != /* &&
			"$entry" != ../* && "$entry" != */../* && "$entry" != *'*'* ]] ||
			die "repository-local Remediation-Scope is not an exact repository-relative path: $entry"
		[[ -e "$REPOSITORY/$entry" ]] ||
			die "repository-local Remediation-Scope path does not exist: $entry"
	done
}

if [[ -f "$blocked" ]]; then
	goal_record_manager_decision "$task_id" BLOCKED
	printf '%s\n' "$blocked"
	exit 0
fi
if [[ -f "$rejected" ]]; then
	goal_record_manager_decision "$task_id" REJECTED
	if task_root_needs_replan "$root"; then
		printf '%s\n' "$(task_root_replan_file "$root")"
	else
		printf '%s\n' "$rejected"
	fi
	exit 0
fi

if [[ "$goal_outcome" != HARD_BLOCKED ]]; then
	(( HARNESS_MAX_IDENTICAL_BLOCKERS > 0 )) ||
		die 'deterministic task blocking is disabled; reject the task and publish a continuation'
	(( improvement_percent == 0 )) ||
		die 'a task can be blocked only by an identical zero-improvement circuit breaker'
	blocking_fingerprint="$(awk -F': ' '$1 == "Blocking-Fingerprint" {print $2; exit}' "$note_file")"
	[[ "$blocking_fingerprint" =~ ^sha256:[0-9a-fA-F]{64}$ ]] ||
		die 'blocked review note must contain Blocking-Fingerprint: sha256:<64-hex-digest>'

	matching_rejections=0
	shopt -s nullglob
	for prior_rejection in "$dir/archive/$PROJECT-task-$root.rejected.md" \
		"$dir/archive/$PROJECT-task-$root-revision-"*.rejected.md; do
		[[ -f "$prior_rejection" ]] || continue
		if grep -Fqx 'Improvement-Percent: 0%' "$prior_rejection" &&
			grep -Fqx "Blocking-Fingerprint: $blocking_fingerprint" "$prior_rejection"; then
			matching_rejections=$((matching_rejections + 1))
		fi
	done
	(( matching_rejections + 1 >= HARNESS_MAX_IDENTICAL_BLOCKERS )) ||
		die "blocking fingerprint has not reached the configured threshold: $((matching_rejections + 1))/$HARNESS_MAX_IDENTICAL_BLOCKERS"
	blocker_class="LOCAL_CODE_PREREQUISITE"
	[[ -n "$remediation_scope" ]] ||
		remediation_scope="manager-classification of the deterministic repository-local prerequisite"
elif hard_block_class_is_local "$blocker_class"; then
	[[ -n "$remediation_scope" ]] ||
		die 'a repository-local HARD_BLOCKED review requires Remediation-Scope'
	validate_local_remediation_scope "$remediation_scope" "$assignment_archive"
elif hard_block_class_is_human "$blocker_class"; then
	[[ -n "$human_dependency_evidence" ]] ||
		die 'a human-dependent HARD_BLOCKED review requires Human-Dependency-Evidence'
	if [[ "$blocker_class" == HUMAN_PRODUCT_SPECIFICATION ]]; then
		[[ -n "$product_decision_evidence" ]] ||
			die 'HUMAN_PRODUCT_SPECIFICATION requires Product-Decision-Evidence naming incompatible observable product outcomes; file ownership or worker scope alone is LOCAL_SCOPE_PREREQUISITE'
		[[ -n "$governing_specification_search" ]] ||
			die 'HUMAN_PRODUCT_SPECIFICATION requires Governing-Specification-Search documenting a bounded exact search that found no governing resolution'
	fi
else
	die 'HARD_BLOCKED review requires Blocker-Class: LOCAL_CODE_PREREQUISITE|LOCAL_BUILD_PREREQUISITE|LOCAL_INTEGRATION_PREREQUISITE|LOCAL_SCOPE_PREREQUISITE|HUMAN_AUTHORIZATION|HUMAN_SECRET|HUMAN_EXTERNAL_STATE|HUMAN_PRODUCT_SPECIFICATION'
fi

[[ -f "$result" ]] || die "result does not exist: $task_id"
if hard_block_class_is_local "$blocker_class"; then
	result_archive="$dir/archive/$base.rejected-result.md"
	mv "$result" "$result_archive"
	acp_record_manager_disposition "$result_archive" MANAGER_REPLAN "$note_file"
	tmp="$rejected.tmp.$$"
	{
		printf '# Task Routed to Manager Remediation\n\n'
		printf 'Project: %s\n\n' "$PROJECT"
		printf 'Task-ID: %s\n\n' "$task_id"
		printf 'Task-Root: %s\n\n' "$root"
		printf 'Environment-File: %s\n\n' "$HARNESS_ENV_FILE"
		printf 'Routed-At: %s\n\n' "$(timestamp_utc)"
		printf 'Blocker-Class: %s\n\n' "$blocker_class"
		printf 'Remediation-Scope: %s\n\n' "$remediation_scope"
		printf 'Reason: %s\n\n' "$reason"
		printf '## Review notes\n\n'
		cat "$note_file"
		printf '\n'
	} > "$tmp"
	chmod 600 "$tmp"
	mv "$tmp" "$rejected"
	update_task_progress "$task_id" "$progress_percent" "$improvement_percent" REJECT "$note_file"
	goal_record_manager_decision "$task_id" REJECTED
	if ! acp_root_is_suspended "$root"; then
		clear_worker_thread_for_root "$task_id" hard-block-manager-remediation
	fi
	rm -f "$dir/control/$base.lease" "$dir/control/$base.worker-triggered" \
		"$dir/control/$base.worker-failed.md" "$dir/control/$base.worker-supervisor-failed.md"
	record_root_hard_block "$task_id" "$blocker_class" MANAGER_REMEDIATION \
		"$remediation_scope" "$reason"
	if ! enforce_root_liveness_or_reassess "$task_id"; then
		printf '%s\n' "$(task_root_architecture_reassessment_file "$root")"
		exit 0
	fi
	replan_marker="$(mark_root_needs_replan "$task_id" "$reason" HARD_BLOCKED_LOCAL \
		"$blocker_class" "$remediation_scope")"
	log_event "TASK_HARD_BLOCK_ROUTED_MANAGER_REMEDIATION task=$task_id root=$root blocker_class=$blocker_class remediation_scope=$(printf '%q' "$remediation_scope") reason=$(printf '%q' "$reason")"
	trace_event TASK_HARD_BLOCK_ROUTED_MANAGER_REMEDIATION \
		"task_id=$task_id" "task_root=$root" "blocker_class=$blocker_class" \
		"remediation_scope=$remediation_scope" "replan_file=$replan_marker"
	printf '%s\n' "$replan_marker"
	exit 0
fi

result_archive="$dir/archive/$base.blocked-result.md"
mv "$result" "$result_archive"
acp_record_manager_disposition "$result_archive" MANAGER_BLOCK "$note_file"

tmp="$blocked.tmp.$$"
{
	printf '# Blocked Task\n\n'
	printf 'Project: %s\n\n' "$PROJECT"
	printf 'Task-ID: %s\n\n' "$task_id"
	printf 'Task-Root: %s\n\n' "$root"
	printf 'Environment-File: %s\n\n' "$HARNESS_ENV_FILE"
	printf 'Blocked-At: %s\n\n' "$(timestamp_utc)"
	printf 'Reason: %s\n\n' "$reason"
	printf 'Blocker-Class: %s\n\n' "$blocker_class"
	printf 'Human-Dependency-Evidence: %s\n\n' "$human_dependency_evidence"
	if [[ "$blocker_class" == HUMAN_PRODUCT_SPECIFICATION ]]; then
		printf 'Product-Decision-Evidence: %s\n\n' "$product_decision_evidence"
		printf 'Governing-Specification-Search: %s\n\n' "$governing_specification_search"
	fi
	printf '## Review notes\n\n'
	cat "$note_file"
	printf '\n'
} > "$tmp"
chmod 600 "$tmp"
mv "$tmp" "$blocked"

update_task_progress "$task_id" "$progress_percent" "$improvement_percent" BLOCKED "$note_file"
goal_record_manager_decision "$task_id" BLOCKED
rm -f "$dir/control/$base.lease" "$dir/control/$base.worker-triggered" "$dir/control/$base.worker-failed.md" "$dir/control/$base.worker-supervisor-failed.md"
record_root_hard_block "$task_id" "$blocker_class" NEEDS_HUMAN - "$reason"
human_marker="$(mark_root_needs_human "$root" "$task_id" "$reason" \
	"$blocker_class" "$human_dependency_evidence")"
log_event "TASK_NEEDS_HUMAN_CONFIRMED task=$task_id root=$root blocker_class=$blocker_class reason=$(printf '%q' "$reason")"
trace_event TASK_NEEDS_HUMAN_CONFIRMED "task_id=$task_id" "task_root=$root" \
	"blocker_class=$blocker_class" "blocked_file=$blocked" "human_file=$human_marker"
printf '%s\n' "$human_marker"
