#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE CANDIDATE_DAG REVISED_ROOT_ASSIGNMENT RESOLUTION_NOTE_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 4 ]] || usage
load_harness_env "$1"
candidate_dag="$2"
candidate_assignment="$3"
resolution_note="$4"
ensure_project
(( HARNESS_DECOMPOSITION_V2 == 1 )) || die 'active-node revision requires HARNESS_DECOMPOSITION_V2=1'
project_plan_uses_dag || die 'active-node revision requires an existing decomposition DAG'
project_completion_recorded && die 'a completed project cannot revise an active plan node'
env_has_running_processes && die 'stop this harness and wait for active children to exit before revising its active node'
[[ -s "$candidate_dag" ]] || die "candidate DAG is missing or empty: $candidate_dag"
[[ -s "$candidate_assignment" ]] || die "revised root assignment is missing or empty: $candidate_assignment"
[[ -s "$resolution_note" ]] || die "architecture resolution note is missing or empty: $resolution_note"

dir="$(project_dir)"
dag="$(project_decomposition_plan_file)"
state="$(project_plan_state_file)"
typed_header=$'node_id\tparent_id\tdepends_on\tdeliverable\tacceptance_evidence\tfocused_validation\tallowed_paths\trequired_symbols\tleaf_type\tcomplexity_class\tworker_route'
complexity_header="$(decomposition_complexity_header)"
active_item=""
revision_candidates=0
while IFS=$'\t' read -r candidate_item candidate_status candidate_root _; do
	[[ "$candidate_status" == ACTIVE && -n "$candidate_root" && "$candidate_root" != - ]] || continue
	if [[ -f "$(task_root_architecture_reassessment_file "$candidate_root")" ||
		-f "$(task_root_token_usage_anomaly_file "$candidate_root")" ]]; then
		active_item="$candidate_item"
		revision_candidates=$((revision_candidates + 1))
	fi
done < "$state"
(( revision_candidates == 1 )) || die "active-node revision requires exactly one anomalous ACTIVE plan item; found $revision_candidates"
root="$(project_plan_item_root "$active_item")"
[[ -n "$root" && "$root" != - ]] || die "active plan item has no task root: $active_item"
root_assignment="$(task_root_assignment_file "$root")"
architecture_marker="$(task_root_architecture_reassessment_file "$root")"
token_marker="$(task_root_token_usage_anomaly_file "$root")"
marker=""
incident_name=""
[[ -f "$root_assignment" ]] || die "active root assignment is missing: $root_assignment"
if [[ -f "$architecture_marker" ]]; then
	marker="$architecture_marker"
	incident_name=architecture-reassessment.md
elif [[ -f "$token_marker" ]]; then
	marker="$token_marker"
	incident_name=token-usage-anomaly.md
else
	die "active root does not require architecture or token-usage reassessment: $root"
fi
if liveness_reason="$(root_liveness_violation_reason "$root" 2>/dev/null)"; then
	die "active root remains beyond its lifetime acceptance-boundary budget: $liveness_reason; revising scope or context cannot reset liveness—replace the acceptance boundary, apply a direct operator correction, or explicitly raise the governing limit"
fi

old_header="$(sed -n '1p' "$dag")"
new_header="$(sed -n '1p' "$candidate_dag")"
[[ "$old_header" == "$typed_header" || "$old_header" == "$complexity_header" ]] || die 'active-node revision requires a typed or measured DAG'
[[ "$new_header" == "$old_header" ]] || die 'candidate DAG must preserve the installed DAG schema'
measured=0
[[ "$old_header" != "$complexity_header" ]] || measured=1
[[ "$(awk 'END {print NR - 1}' "$dag")" == "$(awk 'END {print NR - 1}' "$candidate_dag")" ]] ||
	die 'candidate DAG must preserve the node count'

old_active="$(awk -F '\t' -v item="$active_item" '$1 == item {print; exit}' "$dag")"
new_active="$(awk -F '\t' -v item="$active_item" '$1 == item {print; exit}' "$candidate_dag")"
[[ -n "$old_active" && -n "$new_active" ]] || die "candidate DAG must preserve active node: $active_item"
[[ "$(awk -F '\t' -v item="$active_item" 'NR == 1 || $1 != item' "$dag")" == \
	"$(awk -F '\t' -v item="$active_item" 'NR == 1 || $1 != item' "$candidate_dag")" ]] ||
	die 'candidate DAG changed a non-active node; only the active node may be revised'

IFS=$'\t' read -r -a old_fields <<< "$old_active"
IFS=$'\t' read -r -a new_fields <<< "$new_active"
expected_fields=$((11 + measured * 9))
(( ${#old_fields[@]} == expected_fields && ${#new_fields[@]} == expected_fields )) ||
	die "active-node revision requires exactly $expected_fields fields per active row"
old_id="${old_fields[0]}"; old_parent="${old_fields[1]}"; old_deps="${old_fields[2]}"
old_deliverable="${old_fields[3]}"; old_evidence="${old_fields[4]}"; old_validation="${old_fields[5]}"
old_paths="${old_fields[6]}"; old_symbols="${old_fields[7]}"; old_type="${old_fields[8]}"
old_complexity="${old_fields[9]}"; old_route="${old_fields[10]}"
new_id="${new_fields[0]}"; new_parent="${new_fields[1]}"; new_deps="${new_fields[2]}"
new_deliverable="${new_fields[3]}"; new_evidence="${new_fields[4]}"; new_validation="${new_fields[5]}"
new_paths="${new_fields[6]}"; new_symbols="${new_fields[7]}"; new_type="${new_fields[8]}"
new_complexity="${new_fields[9]}"; new_route="${new_fields[10]}"
[[ "$new_id" == "$old_id" && "$new_parent" == "$old_parent" && "$new_deps" == "$old_deps" ]] ||
	die 'candidate must preserve active node identity, parent, and dependencies'
[[ "$new_deliverable" == "$old_deliverable" ]] || die 'candidate must preserve the active deliverable'
[[ "$new_evidence" == "$old_evidence" ]] || die 'candidate must preserve active acceptance evidence'
# A reassessment exists precisely so an invalid or non-observing validation
# boundary can be corrected without changing the accepted deliverable or
# evidence. The replacement is still constrained by repository scope below.
[[ -n "$new_paths" && "$new_paths" != - ]] || die 'revised active node requires explicit allowed paths'
[[ -n "$new_symbols" ]] || die "revised active node requires symbols or '-'"
[[ "$new_type" =~ ^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION|VERIFICATION_ONLY|CONTRACT_DESIGN|CROSS_COMPONENT_ARCHITECTURE|CONCURRENCY_PROTOCOL|INTEGRATION|AMBIGUOUS_SPECIFICATION)$ ]] ||
	die "invalid revised leaf type: $new_type"
[[ "$new_complexity" =~ ^(LOW|MEDIUM|HIGH)$ ]] || die "invalid revised complexity: $new_complexity"
[[ "$new_route" =~ ^(LUNA|TERRA)$ ]] || die "invalid revised route: $new_route"
[[ "$HARNESS_MODEL_POLICY" != luna_only || "$new_route" == LUNA ]] ||
	die 'Luna-only policy rejects an active-node revision to route TERRA; decompose the remaining acceptance boundary'
if [[ "$new_route" == LUNA ]]; then
	[[ "$new_complexity" == LOW ]] || die 'a revised Luna node must have LOW complexity'
	[[ "$new_type" =~ ^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION|VERIFICATION_ONLY)$ ]] ||
		die "revised Luna node has Terra-only type: $new_type"
fi

list_is_subset()
{
	local subset="$1" superset="$2" entry candidate found
	local -a subset_entries=() superset_entries=()
	[[ "$subset" == - ]] && return 0
	IFS=',' read -r -a subset_entries <<< "${subset//;/,}"
	IFS=',' read -r -a superset_entries <<< "${superset//;/,}"
	for entry in "${subset_entries[@]}"; do
		entry="$(trim_surrounding_whitespace "$entry")"
		[[ -n "$entry" ]] || continue
		found=0
		for candidate in "${superset_entries[@]}"; do
			candidate="$(trim_surrounding_whitespace "$candidate")"
			[[ "$entry" == "$candidate" ]] && { found=1; break; }
		done
		(( found == 1 )) || return 1
	done
}

if ! list_is_subset "$old_paths" "$new_paths"; then
	invalid_paths="$(metadata_value "$resolution_note" Invalid-Allowed-Scope)"
	[[ -n "$invalid_paths" ]] ||
		die 'revised allowed paths may remove an original entry only when the resolution names it in Invalid-Allowed-Scope'
	IFS=',' read -r -a old_path_entries <<< "${old_paths//;/,}"
	for old_path_entry in "${old_path_entries[@]}"; do
		old_path_entry="$(trim_surrounding_whitespace "$old_path_entry")"
		[[ -n "$old_path_entry" ]] || continue
		list_is_subset "$old_path_entry" "$new_paths" && continue
		list_is_subset "$old_path_entry" "$invalid_paths" ||
			die "resolution does not authorize removal of allowed path: $old_path_entry"
	done
fi
if ! list_is_subset "$old_symbols" "$new_symbols"; then
	invalid_symbols="$(metadata_value "$resolution_note" Invalid-Required-Symbols)"
	[[ -n "$invalid_symbols" ]] ||
		die 'revised required symbols may remove an original symbol only when the resolution names it in Invalid-Required-Symbols'
	IFS=',' read -r -a old_symbol_entries <<< "${old_symbols//;/,}"
	for old_symbol_entry in "${old_symbol_entries[@]}"; do
		old_symbol_entry="$(trim_surrounding_whitespace "$old_symbol_entry")"
		[[ -n "$old_symbol_entry" ]] || continue
		list_is_subset "$old_symbol_entry" "$new_symbols" && continue
		list_is_subset "$old_symbol_entry" "$invalid_symbols" ||
			die "resolution does not authorize removal of required symbol: $old_symbol_entry"
	done
fi
[[ "$old_active" != "$new_active" ]] || die 'candidate DAG does not revise the active node'

[[ "$(require_single_metadata_value "$candidate_assignment" Task-ID 'revised root assignment')" == "$root" ]] ||
	die 'revised root assignment Task-ID does not match the active root'
[[ "$(require_single_metadata_value "$candidate_assignment" Task-Root 'revised root assignment')" == "$root" ]] ||
	die 'revised root assignment Task-Root does not match the active root'
[[ "$(require_single_metadata_value "$candidate_assignment" Project-Plan-Item-ID 'revised root assignment')" == "$active_item" ]] ||
	die 'revised root assignment Project-Plan-Item-ID does not match the active node'
[[ "$(require_single_metadata_value "$candidate_assignment" Goal-Success-Evidence 'revised root assignment')" == "$new_evidence" ]] ||
	die 'revised root assignment Goal-Success-Evidence does not match the revised DAG'
[[ "$(require_single_metadata_value "$candidate_assignment" Focused-Validation 'revised root assignment')" == "$new_validation" ]] ||
	die 'revised root assignment Focused-Validation does not match the revised DAG'
[[ "$(require_single_metadata_value "$candidate_assignment" Allowed-Scope 'revised root assignment')" == "$new_paths" ]] ||
	die 'revised root assignment Allowed-Scope does not match the revised DAG'
[[ "$(require_single_metadata_value "$candidate_assignment" Deliverable 'revised root assignment')" == "$new_deliverable" ]] ||
	die 'revised root assignment Deliverable does not match the revised DAG'
[[ "$(require_single_metadata_value "$candidate_assignment" Required-Symbols 'revised root assignment')" == "$new_symbols" ]] ||
	die 'revised root assignment Required-Symbols does not match the revised DAG'
[[ "$(require_single_metadata_value "$candidate_assignment" Leaf-Type 'revised root assignment')" == "$new_type" ]] ||
	die 'revised root assignment Leaf-Type does not match the revised DAG'
[[ "$(require_single_metadata_value "$candidate_assignment" Complexity-Class 'revised root assignment')" == "$new_complexity" ]] ||
	die 'revised root assignment Complexity-Class does not match the revised DAG'
[[ "$(require_single_metadata_value "$candidate_assignment" Worker-Route 'revised root assignment')" == "$new_route" ]] ||
	die 'revised root assignment Worker-Route does not match the revised DAG'
[[ "$(require_single_metadata_value "$candidate_assignment" Depends-On 'revised root assignment')" == "$new_deps" ]] ||
	die 'revised root assignment Depends-On does not match the revised DAG'
if (( measured == 1 )); then
	for mapping in \
		"Behavioral-Concerns:11" "Failure-Paths:12" "Ownership-Transitions:13" \
		"Concurrency-Boundaries:14" "Validation-Surfaces:15" \
		"Expected-Max-Implementation-Files:16" "Expected-Max-Agent-Actions:17" \
		"Predicted-P95-Tokens:18" "Terra-Exception:19"; do
		IFS=: read -r metadata_field field_index <<< "$mapping"
		[[ "$(require_single_metadata_value "$candidate_assignment" "$metadata_field" 'revised measured assignment')" == "${new_fields[$field_index]}" ]] ||
			die "revised root assignment $metadata_field does not match the revised measured DAG"
	done
fi

old_criteria="$(awk -F': ' '$1 == "Root-Criterion" {print $2}' "$root_assignment")"
new_criteria="$(awk -F': ' '$1 == "Root-Criterion" {print $2}' "$candidate_assignment")"
[[ -n "$old_criteria" && "$new_criteria" == "$old_criteria" ]] ||
	die 'revised root assignment must preserve every Root-Criterion in its original order'

if specification_ir_available; then
	validate_specification_coverage_file "$(specification_coverage_file)" "$candidate_dag"
fi
candidate_complexity=""
if (( measured == 1 )); then
	candidate_complexity="$dir/control/revised-complexity-$active_item-$$.tsv"
	write_decomposition_complexity_report "$candidate_dag" "$(specification_coverage_file)" "$candidate_complexity" || {
		rm -f "$candidate_complexity"
		die 'revised active node exceeds the measured worker-complexity contract'
	}
	expected_score="$(awk -F '\t' -v node="$active_item" 'NR>1 && $1==node {print $4; exit}' "$candidate_complexity")"
	expected_p95="$(awk -F '\t' -v node="$active_item" 'NR>1 && $1==node {print $17; exit}' "$candidate_complexity")"
	[[ "$(require_single_metadata_value "$candidate_assignment" Complexity-Score 'revised measured assignment')" == "$expected_score" ]] || die 'revised assignment Complexity-Score is not deterministic'
	[[ "$(require_single_metadata_value "$candidate_assignment" Effective-P95-Tokens 'revised measured assignment')" == "$expected_p95" ]] || die 'revised assignment Effective-P95-Tokens is not deterministic'
fi
architecture_require_scoped_validation "revised plan node $active_item focused_validation" "$new_validation"

acquire_project_lock
env_has_running_processes && die 'a harness process appeared while acquiring the active-node revision lock'
stamp="$(timestamp_compact_utc)"
archive_dir="$dir/archive/plan-node-revisions/$active_item/$stamp"
mkdir -p "$archive_dir"
chmod 700 "$dir/archive/plan-node-revisions" "$dir/archive/plan-node-revisions/$active_item" "$archive_dir"
install -m 600 "$dag" "$archive_dir/project-decomposition-v2.before.tsv"
install -m 600 "$root_assignment" "$archive_dir/root-assignment.before.md"
install -m 600 "$marker" "$archive_dir/$incident_name"
install -m 600 "$resolution_note" "$archive_dir/resolution.md"
if [[ -f "$(decomposition_complexity_report_file)" ]]; then
	install -m 600 "$(decomposition_complexity_report_file)" "$archive_dir/decomposition-complexity.before.tsv"
fi
if [[ -f "$dir/control/manager.thread" ]]; then
	install -m 600 "$dir/control/manager.thread" "$archive_dir/manager-thread.before.env"
fi

dag_tmp="$dag.tmp.$$"
assignment_tmp="$root_assignment.tmp.$$"
install -m 600 "$candidate_dag" "$dag_tmp"
install -m 600 "$candidate_assignment" "$assignment_tmp"
mv "$dag_tmp" "$dag"
mv "$assignment_tmp" "$root_assignment"
if ! ( architecture_validate_against_plan ); then
	install -m 600 "$archive_dir/project-decomposition-v2.before.tsv" "$dag"
	install -m 600 "$archive_dir/root-assignment.before.md" "$root_assignment"
	die 'revised active node conflicts with architecture registries; original DAG and root assignment were restored'
fi
if [[ -n "$candidate_complexity" ]]; then
	mv "$candidate_complexity" "$(decomposition_complexity_report_file)"
fi
rm -f "$architecture_marker" "$token_marker" "$(task_root_replan_file "$root")" "$(task_root_replanning_file "$root")"
clear_worker_thread_for_root "$root" active-plan-node-revised
rotated_goal_threads=0
shopt -s nullglob
for goal_state in "$(goal_control_dir)"/"$PROJECT-task-"*.goal; do
	[[ "$(kv_file_value "$goal_state" task_root 2>/dev/null || true)" == "$root" ]] || continue
	goal_task="$(kv_file_value "$goal_state" task_id 2>/dev/null || true)"
	[[ -n "$goal_task" ]] || continue
	goal_state_set "$goal_state" thread_id ""
	goal_state_set "$goal_state" thread_context active-plan-node-revised
	goal_thread_store "$goal_task" "" active-plan-node-revised
	rotated_goal_threads=$((rotated_goal_threads + 1))
done
shopt -u nullglob
route_override="$(task_root_operator_route_override_file "$root")"
if [[ "$old_route" == LUNA && "$new_route" == TERRA ]]; then
	{
		printf 'worker_route=TERRA\n'
		printf 'reason=controlled_active_node_reassessment\n'
		printf 'revised_at=%s\n' "$(timestamp_utc)"
		printf 'revision_archive=%s\n' "$archive_dir"
	} > "$route_override.tmp.$$"
	chmod 600 "$route_override.tmp.$$"
	mv "$route_override.tmp.$$" "$route_override"
elif [[ "$new_route" == LUNA ]]; then
	rm -f "$route_override"
fi
{
	printf '# Manager Context Rotation Required\n\n'
	printf 'Project: %s\n\n' "$PROJECT"
	printf 'Plan-Node: %s\n\n' "$active_item"
	printf 'Task-Root: %s\n\n' "$root"
	printf 'Reason: Active DAG authority changed; stale conversational scope must not override the revised durable state.\n\n'
	printf 'Requested-At: %s\n' "$(timestamp_utc)"
} > "$dir/control/manager-context-rotation-required.md.tmp.$$"
chmod 600 "$dir/control/manager-context-rotation-required.md.tmp.$$"
mv "$dir/control/manager-context-rotation-required.md.tmp.$$" \
	"$dir/control/manager-context-rotation-required.md"
rm -f "$dir/control/manager-plan-stalled.md"
{
	printf 'project=%s\n' "$PROJECT"
	printf 'active_plan_item=%s\n' "$active_item"
	printf 'task_root=%s\n' "$root"
	printf 'revised_at=%s\n' "$(timestamp_utc)"
	printf 'old_allowed_paths=%s\n' "$old_paths"
	printf 'new_allowed_paths=%s\n' "$new_paths"
	printf 'old_leaf_type=%s\n' "$old_type"
	printf 'new_leaf_type=%s\n' "$new_type"
	printf 'old_focused_validation=%s\n' "$old_validation"
	printf 'new_focused_validation=%s\n' "$new_validation"
	printf 'old_worker_route=%s\n' "$old_route"
	printf 'new_worker_route=%s\n' "$new_route"
	printf 'resolution_note=%s\n' "$archive_dir/resolution.md"
	printf 'incident=%s\n' "$incident_name"
	printf 'rotated_goal_threads=%s\n' "$rotated_goal_threads"
} > "$archive_dir/revision.env"
chmod 600 "$archive_dir/revision.env"
log_event "ACTIVE_PLAN_NODE_REVISED item=$active_item root=$root old_paths=$(printf '%q' "$old_paths") new_paths=$(printf '%q' "$new_paths") archive=$archive_dir"
trace_event ACTIVE_PLAN_NODE_REVISED "item=$active_item" "root=$root" "archive=$archive_dir"
printf 'Revised active plan node %s for root %s.\n' "$active_item" "$root"
printf 'Preserved criteria: %s\n' "$(awk -F': ' '$1 == "Root-Criterion" {count++} END {print count + 0}' "$root_assignment")"
printf 'Revision archive: %s\n' "$archive_dir"
