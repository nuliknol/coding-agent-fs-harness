#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 1 ]] || usage
load_harness_env "$1"
ensure_project
require_registered_specification_ir
require_manager_configuration
require_manager_codex
trace_init manager_plan_next_task
trace_script_start "$@"
write_manager_snapshot

project_path="$(project_dir)"
plan_running="$project_path/control/manager-plan.running"
cleanup()
{
	local status="$?"
	rm -f "$plan_running"
	trace_script_exit "$status"
}
trap cleanup EXIT
{
	printf 'pid=%s\n' "$$"
	printf 'started_at=%s\n' "$(timestamp_utc)"
	printf 'env_file=%s\n' "$HARNESS_ENV_FILE"
} > "$plan_running.tmp.$$"
chmod 600 "$plan_running.tmp.$$"
mv "$plan_running.tmp.$$" "$plan_running"
thread_file="$project_path/control/manager.thread"
[[ -f "$thread_file" ]] || die 'manager thread is not registered; run manager-bootstrap'
project_plan_exists || die 'project plan is missing'
project_plan_all_complete && die 'project plan is already complete'
thread_id="$(kv_file_value "$thread_file" thread_id)"
plan_definition="$(project_plan_definition_file)"
plan_state="$(project_plan_state_file)"
decomposition_definition="$(project_decomposition_plan_file)"
specification_obligations_definition='-'
specification_relations_definition='-'
specification_coverage_definition='-'
if specification_ir_available; then
	specification_obligations_definition="$(specification_obligations_file)"
	specification_relations_definition="$(specification_relations_file)"
	specification_coverage_definition="$(specification_coverage_file)"
fi
ready_plan_node="$(project_plan_first_ready_item 2>/dev/null || true)"
development_policy_file="$REPOSITORY/design/development-policy.txt"
[[ -f "$development_policy_file" ]] || development_policy_file=""
prompt_file="$project_path/control/manager-plan-next-task.prompt.md"
active_item_before="$(awk -F '\t' '!/^#/ && $2 == "ACTIVE" {print $1; exit}' "$plan_state")"
active_root_before="$(awk -F '\t' '!/^#/ && $2 == "ACTIVE" {print $3; exit}' "$plan_state")"
active_progress_file=""
active_criteria_file=""
active_criteria_definition_file=""
active_criterion_decomposition_file=""
active_manager_remediation_ledger=""
active_hard_block_ledger=""
active_first_unmet_criterion=""
active_repair_goal_id=""
active_repair_goal_task=""
if [[ -n "$active_root_before" && "$active_root_before" != '-' ]]; then
	active_progress_file="$(task_progress_file "$active_root_before")"
	active_criteria_file="$(task_criterion_ledger_file "$active_root_before")"
	active_criteria_definition_file="$(task_criteria_definition_file "$active_root_before")"
	active_criterion_decomposition_file="$(task_criterion_decomposition_file "$active_root_before")"
	active_manager_remediation_ledger="$(task_manager_remediation_ledger_file "$active_root_before")"
	active_hard_block_ledger="$(task_hard_block_ledger_file "$active_root_before")"
	active_first_unmet_criterion="$(task_first_unmet_criterion "$active_root_before" 2>/dev/null || true)"
	latest_repair_update=""
	for prior_goal_state in "$(goal_control_dir)"/"$PROJECT-task-"*.goal; do
		[[ -f "$prior_goal_state" ]] || continue
		[[ "$(kv_file_value "$prior_goal_state" task_root 2>/dev/null || true)" == "$active_root_before" ]] || continue
		[[ "$(kv_file_value "$prior_goal_state" target_criterion 2>/dev/null || true)" == "$active_first_unmet_criterion" ]] || continue
		[[ "$(kv_file_value "$prior_goal_state" state 2>/dev/null || true)" == REJECTED ]] || continue
		prior_update="$(kv_file_value "$prior_goal_state" updated_at 2>/dev/null || true)"
		if [[ -z "$active_repair_goal_id" || "$prior_update" > "$latest_repair_update" ]]; then
			active_repair_goal_id="$(kv_file_value "$prior_goal_state" goal_id)"
			active_repair_goal_task="$(kv_file_value "$prior_goal_state" task_id)"
			latest_repair_update="$prior_update"
		fi
	done
fi

structural_error="$project_path/control/manager-plan-structural-error.md"
structural_reason=""
if [[ -z "$active_root_before" || "$active_root_before" == - ]]; then
	if [[ -z "$ready_plan_node" ]]; then
		structural_reason='No dependency-ready pending plan node exists, although the project is incomplete and has no active root.'
	elif project_plan_uses_dag && [[ -z "$(project_plan_node_value "$ready_plan_node" deliverable)" ]]; then
		structural_reason="Pending plan node $ready_plan_node is absent from the decomposition DAG."
	elif (( HARNESS_ARCHITECTURE_GUARDS == 1 )) &&
		! architecture_registry_has_id "$(architecture_node_bindings_file)" "$ready_plan_node"; then
		structural_reason="Pending plan node $ready_plan_node is absent from the architecture node bindings."
	fi
fi
if [[ -n "$structural_reason" ]]; then
	{
		printf '# Manager Planning Structural Error\n\n'
		printf 'Project: %s\n\n' "$PROJECT"
		printf 'Plan-Node: %s\n\n' "${ready_plan_node:--}"
		printf 'Detected-At: %s\n\n' "$(timestamp_utc)"
		printf '%s\n' "$structural_reason"
	} > "$structural_error.tmp.$$"
	chmod 600 "$structural_error.tmp.$$"
	mv "$structural_error.tmp.$$" "$structural_error"
	log_event "MANAGER_PLAN_STRUCTURAL_ERROR node=${ready_plan_node:--} reason=$(printf '%q' "$structural_reason")"
	die "$structural_reason"
fi
rm -f "$structural_error"

cat > "$prompt_file.tmp.$$" <<PROMPT
The previous root task is resolved, or an ACTIVE root was explicitly resumed after replanning; the project has no active task process and its specification is not complete.

ENV_FILE=$HARNESS_ENV_FILE
PROJECT=$PROJECT
PROJECT_TMP_DIR=$PROJECT_TMP_DIR
PROJECT_PLAN_FILE=$plan_definition
PROJECT_PLAN_STATE_FILE=$plan_state
PROJECT_PROGRESS_PERCENT=$(project_plan_progress_percent)
DEVELOPMENT_POLICY_FILE=$development_policy_file
SPECIFICATION=$SPECIFICATION
REPOSITORY=$REPOSITORY
HARNESS_BIN=$HARNESS_BIN
ACTIVE_PLAN_ITEM=$active_item_before
ACTIVE_TASK_ROOT=$active_root_before
ACTIVE_PROGRESS_FILE=$active_progress_file
ACTIVE_CRITERIA_FILE=$active_criteria_file
ACTIVE_CRITERIA_DEFINITION_FILE=$active_criteria_definition_file
ACTIVE_CRITERION_DECOMPOSITION_FILE=$active_criterion_decomposition_file
ACTIVE_MANAGER_REMEDIATION_LEDGER=$active_manager_remediation_ledger
ACTIVE_HARD_BLOCK_LEDGER=$active_hard_block_ledger
ACTIVE_FIRST_UNMET_CRITERION=$active_first_unmet_criterion
ACTIVE_REPAIR_GOAL_ID=$active_repair_goal_id
ACTIVE_REPAIR_GOAL_TASK=$active_repair_goal_task
WORKER_GOAL_MODE=$HARNESS_WORKER_GOAL_MODE
DECOMPOSITION_V2=$HARNESS_DECOMPOSITION_V2
ARCHITECTURE_GUARDS=$HARNESS_ARCHITECTURE_GUARDS
ARCHITECTURE_DIR=$(architecture_dir)
PROJECT_DECOMPOSITION_FILE=$decomposition_definition
SPECIFICATION_OBLIGATIONS_FILE=$specification_obligations_definition
SPECIFICATION_RELATIONS_FILE=$specification_relations_definition
SPECIFICATION_COVERAGE_FILE=$specification_coverage_definition
READY_PLAN_NODE=$ready_plan_node

Read $HARNESS_HOME/prompts/manager-agent-event-driven.md and follow it. Read DEVELOPMENT_POLICY_FILE when present, then read PROJECT_PLAN_FILE and PROJECT_PLAN_STATE_FILE completely. If ACTIVE_TASK_ROOT is set, also read ACTIVE_PROGRESS_FILE, ACTIVE_CRITERIA_FILE, ACTIVE_CRITERIA_DEFINITION_FILE, ACTIVE_CRITERION_DECOMPOSITION_FILE, ACTIVE_MANAGER_REMEDIATION_LEDGER, and ACTIVE_HARD_BLOCK_LEDGER when present, then publish one newly bounded continuation of that same root with Target-Criterion equal to ACTIVE_FIRST_UNMET_CRITERION. Manager-remediation ledger entries and their checkpoint artifacts are separately attributed baseline prerequisites, not feature-worker implementation changes; a scope acceptance leaf must disclose and validate them but must evaluate the feature-owned delta without charging those paths to the ordinary worker. Direct follow-up fixes causally exposed by a recorded manager remediation retain the same baseline-remediation provenance. An ordinary worker exclusive-file, forbidden-file, or ownership rule does not require human approval for such a bounded repair when observable product behavior and public contracts remain unchanged. Otherwise publish READY_PLAN_NODE, which is the first dependency-ready pending item; never publish a node whose dependencies are incomplete. Declare independently verifiable criteria with stable Root-Criterion lines. Inspect the specification and actual repository state, write exactly one bounded task under PROJECT_TMP_DIR, and publish it with manager-publish-task including its PROJECT_PLAN_ITEM_ID. Preserve completed implementation and begin at the first unmet leaf criterion. Then terminate immediately. Do not wait, sleep, poll, watch the filesystem, or repeat completed plan items.

Before publishing any continuation, inspect the governing specification for mandatory cross-harness Git refs and verify them directly. When one is absent, write the exact seven-column requirements TSV and supplier note, call manager-wait-dependency for ACTIVE_PLAN_ITEM and ACTIVE_TASK_ROOT, and terminate. Do not publish another absence audit, count repeated absence as durable evidence, or unlock preflight/integration. When all mandatory refs exist, include them in Mandatory-Git-Refs metadata so publication and final review revalidate them mechanically.
PROMPT
if (( HARNESS_WORKER_GOAL_MODE == 1 )); then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Worker leaf-goal mode is enabled. Every newly published assignment must contain exactly one nonempty line for each of: Execution-Mode: LEAF_GOAL, Goal-ID, Target-Criterion, Goal-Success-Evidence, Focused-Validation, Allowed-Scope, Baseline-Boundary, and Hard-Block-Conditions. Target the first unmet leaf (or the first Root-Criterion for a new root), use a stable goal identifier, and make the success evidence independently verifiable. Do not carry a legacy one-turn execution marker into this clean task boundary.

If ACTIVE_REPAIR_GOAL_ID is nonempty, this planning gap follows a rejected terminal result for the same first-unmet leaf. Reuse ACTIVE_REPAIR_GOAL_ID in the repair assignment so its durable logical-goal state and thread resume; inspect ACTIVE_REPAIR_GOAL_TASK for the rejected boundary. Otherwise create a new stable goal identifier.
PROMPT
fi
if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Read PROJECT_DECOMPOSITION_FILE. When present, also read SPECIFICATION_OBLIGATIONS_FILE, SPECIFICATION_RELATIONS_FILE, and SPECIFICATION_COVERAGE_FILE so the assignment preserves the exact obligations and typed relations allocated to its node. Every assignment must contain the complete v2 leaf contract: Leaf-Type, Complexity-Class, Worker-Route, Depends-On, Deliverable, Required-Symbols, Context-Paths, Architecture-Decisions, Expected-Max-Implementation-Files, and Expected-Max-Worker-Turns, in addition to the leaf-goal fields. PREFERRED_WORKER_ROUTE=$HARNESS_PREFERRED_WORKER_ROUTE. For a typed new DAG, copy all DAG-backed values exactly. For a legacy untyped immutable DAG, reclassify a planned TERRA root to LOW/LUNA whenever its first executable criterion has resolved architecture and can fit the Luna-ready limits; the publisher explicitly permits this compatibility override. Split broad coding into ordered criteria until each implementation leaf is Luna-ready. A LUNA leaf must have no architecture decisions, use only a Luna-safe leaf type, remain within five expected implementation files and $HARNESS_MAX_LUNA_ALLOWED_PATHS bounded Allowed-Scope path groups, and use at most three worker turns. TERRA may resolve architecture, contracts, concurrency, ambiguity, or unexplained integration, or handle coding only after $HARNESS_MAX_LUNA_STRATEGY_FAILURES genuinely different Luna strategies failed.
PROMPT
fi
if codex_model_requires_narrow_prompt "$MANAGER_MODEL"; then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Context: authorized local development in my own repository. Task type: benign software engineering. Do not perform offensive security, credential extraction, vulnerability exploitation, malware behavior, unauthorized access, network scanning, or bypassing security controls. Use only the listed local project files needed to publish the next bounded implementation task.
PROMPT
fi
chmod 600 "$prompt_file.tmp.$$"
mv "$prompt_file.tmp.$$" "$prompt_file"

task_published()
{
	compgen -G "$project_path/tasks/$PROJECT-task-*.ready.md" >/dev/null ||
		compgen -G "$project_path/running/$PROJECT-task-*.running.md" >/dev/null ||
		compgen -G "$project_path/results/$PROJECT-task-*.result.md" >/dev/null ||
		compgen -G "$project_path/control/dependencies/*.waiting.md" >/dev/null ||
		compgen -G "$project_path/control/progress/$PROJECT-task-*.architecture-reassessment-required.md" >/dev/null ||
		{ [[ -z "$active_item_before" ]] && awk -F '\t' '!/^#/ && $2 == "ACTIVE" {found=1} END {exit found ? 0 : 1}' "$plan_state"; }
}

attempt=1
provider_retries=0
quota_waits=0
fallback_stage=0
current_model="$MANAGER_MODEL"
while true; do
	stamp="$(date -u '+%Y%m%dT%H%M%SZ')"
	attempt_label="$(printf '%03d' "$attempt")"
	json_log="$project_path/logs/manager-plan-$stamp-attempt-$attempt_label.jsonl"
	stderr_log="$project_path/logs/manager-plan-$stamp-attempt-$attempt_label.stderr.log"
	last_message="$project_path/logs/manager-plan-$stamp-attempt-$attempt_label.md"
	log_event "MANAGER_PLAN_STARTED attempt=$attempt project_progress=$(project_plan_progress_percent)"
	trace_event MANAGER_PLAN_ATTEMPT "attempt=$attempt" "thread_id=$thread_id" "json_log=$json_log"
	set +e
	"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" manager_plan "$current_model" "$prompt_file" "$json_log" "$stderr_log" "$last_message" resume "$thread_id"
	status=$?
	set -e
	classification="$(kv_file_value "${json_log%.jsonl}.classification" classification 2>/dev/null || true)"
	if [[ -n "$active_root_before" ]]; then
		record_root_agent_tokens "$active_root_before" manager_plan "${json_log%.jsonl}.classification"
	fi
	if task_published; then
		log_event "MANAGER_PLAN_COMMITTED attempt=$attempt"
		trace_event MANAGER_PLAN_COMMITTED "attempt=$attempt" "status=$status"
		printf 'Manager published the next project task and exited.\n'
		exit 0
	fi
	if (( status == 0 )); then
		log_event "MANAGER_PLAN_LEFT_PENDING attempt=$attempt"
		exit 3
	fi
	retry_kind="$(codex_provider_retry_kind "$classification" 2>/dev/null || true)"
	if [[ -n "$retry_kind" ]]; then
		retry_delay="$(codex_provider_retry_delay "$classification")"
		provider_retries=$((provider_retries + 1))
		[[ "$retry_kind" != quota ]] || quota_waits=$((quota_waits + 1))
		log_event "MANAGER_PLAN_PROVIDER_WAIT kind=$retry_kind attempt=$attempt retry=$provider_retries delay_seconds=$retry_delay classification=$classification"
		if [[ "$retry_kind" == quota ]]; then
			printf 'Manager planning has no provider quota; project plan state is preserved. Checking again in %s seconds (quota wait %s).\n' "$retry_delay" "$quota_waits" >&2
		else
			printf 'Manager planning hit a transient provider/network failure; retrying in %s seconds.\n' "$retry_delay" >&2
		fi
		sleep "$retry_delay"
		attempt=$((attempt + 1))
		log_event "MANAGER_PLAN_PROVIDER_RETRY_STARTED kind=$retry_kind attempt=$attempt retry=$provider_retries"
		continue
	fi

	if codex_model_requires_narrow_prompt "$current_model" && [[ "$classification" == model_refusal_or_blocked_content ]]; then
		if (( fallback_stage == 0 )); then
			fallback_stage=1
			attempt=$((attempt + 1))
			printf '\nRetry scope: publish exactly one task for the first unfinished project plan item.\n' >> "$prompt_file"
			continue
		elif (( fallback_stage == 1 )) && [[ "$MANAGER_FALLBACK_MODEL" != "$current_model" ]]; then
			fallback_stage=2
			current_model="$MANAGER_FALLBACK_MODEL"
			attempt=$((attempt + 1))
			continue
		fi
	fi
	die "Codex manager planning turn failed with exit status $status; see $json_log"
done
