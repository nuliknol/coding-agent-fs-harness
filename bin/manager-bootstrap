#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 1 ]] || usage
load_harness_env "$1"
ensure_project
require_manager_configuration
require_manager_codex
trace_init manager_bootstrap
trace_script_start "$@"
trap 'trace_script_exit $?' EXIT
write_manager_snapshot

project_path="$(project_dir)"
last_message="$project_path/logs/manager-bootstrap-last-message.md"
prompt_file="$project_path/control/manager-bootstrap.prompt.md"
development_policy_file="$REPOSITORY/design/development-policy.txt"
[[ -f "$development_policy_file" ]] || development_policy_file=""
decomposition_file="$(project_decomposition_plan_file)"
ready_plan_node=""
plan_instruction=""
if project_plan_exists; then
	ready_plan_node="$(project_plan_first_ready_item 2>/dev/null || true)"
	plan_instruction="The decomposition plan is already registered. Read PROJECT_PLAN_FILE and PROJECT_DECOMPOSITION_FILE completely. Publish the initial root for READY_PLAN_NODE; do not initialize or replace the plan."
elif (( HARNESS_DECOMPOSITION_V2 == 1 )); then
	plan_instruction="Create and critic-check a topologically ordered v2 decomposition DAG using the exact schema required by manager-init-project-plan, register it, then publish the first dependency-ready node."
else
	plan_instruction="First write a tab-separated project plan under PROJECT_TMP_DIR with one immutable line per specification phase or acceptance gate: ITEM_ID<TAB>TITLE. Include the full execution stack, not merely the first task. Register it with manager-init-project-plan."
fi
cat > "$prompt_file.tmp.$$" <<PROMPT
Read $HARNESS_HOME/prompts/manager-agent-event-driven.md and follow it.

HARNESS_BIN=$HARNESS_BIN
ENV_FILE=$HARNESS_ENV_FILE
PROJECT=$PROJECT
PROJECT_TMP_DIR=$PROJECT_TMP_DIR
SPECIFICATION=$SPECIFICATION
REPOSITORY=$REPOSITORY
DEVELOPMENT_POLICY_FILE=$development_policy_file
WORKER_GOAL_MODE=$HARNESS_WORKER_GOAL_MODE
DECOMPOSITION_V2=$HARNESS_DECOMPOSITION_V2
ARCHITECTURE_GUARDS=$HARNESS_ARCHITECTURE_GUARDS
ARCHITECTURE_DIR=$(architecture_dir)
PREFERRED_WORKER_ROUTE=$HARNESS_PREFERRED_WORKER_ROUTE
PROJECT_PLAN_FILE=$(project_plan_definition_file)
PROJECT_DECOMPOSITION_FILE=$decomposition_file
READY_PLAN_NODE=$ready_plan_node

This is the bootstrap turn. Read DEVELOPMENT_POLICY_FILE when present and inspect the complete specification. $plan_instruction Then inspect the repository, write one bounded initial assignment under PROJECT_TMP_DIR with stable Root-Criterion lines for every independently verifiable acceptance criterion, and publish it with manager-publish-task including the corresponding PROJECT_PLAN_ITEM_ID. Terminate after exactly one task is published. Every harness command must receive ENV_FILE as its first argument. Do not wait for the worker and do not run any polling command.
PROMPT
if (( HARNESS_WORKER_GOAL_MODE == 1 )); then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Worker leaf-goal mode is enabled. The initial assignment must select its first Root-Criterion as Target-Criterion and contain exactly one nonempty line for each of: Execution-Mode: LEAF_GOAL, Goal-ID, Target-Criterion, Goal-Success-Evidence, Focused-Validation, Allowed-Scope, Baseline-Boundary, and Hard-Block-Conditions. Give the goal a stable identifier. Success evidence and validation must be independently checkable; allowed scope and genuine hard-block conditions must be explicit. The worker may span multiple internal turns, but the manager will receive only its terminal result.
PROMPT
fi
if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

V2 decomposition is mandatory and PREFERRED_WORKER_ROUTE=$HARNESS_PREFERRED_WORKER_ROUTE. The task must correspond to the exact dependency-ready DAG node and copy its Depends-On, Deliverable, Goal-Success-Evidence, Focused-Validation, Allowed-Scope, and Required-Symbols values exactly. New typed DAGs also require an exact Leaf-Type, Complexity-Class, and Worker-Route match. For a legacy untyped immutable DAG, the publisher permits a planned TERRA node to be reclassified LOW/LUNA when its first executable criterion is Luna-ready. Prefer that override whenever architecture and contracts are already resolved. Split a broad implementation into ordered Root-Criteria rather than assigning routine coding to Terra. A LUNA leaf must be LOW complexity, use only LOCAL_IMPLEMENTATION, TEST_IMPLEMENTATION, MECHANICAL_API, FOCUSED_BUG, or DOCUMENTATION, set Architecture-Decisions: NONE, expect at most five implementation files, name at most $HARNESS_MAX_LUNA_ALLOWED_PATHS bounded Allowed-Scope path groups, use at most three worker turns, and require no unresolved contract or integration judgment. Use TEST_IMPLEMENTATION for test-only source, fixtures, helpers, and build registration. TERRA is for a concrete contract, architecture, concurrency, ambiguous-specification, or unexplained integration decision; it must checkpoint that decision before Luna performs the resulting implementation. The publisher rejects hidden dependency, route, scope, and evidence mismatches.
PROMPT
fi
if codex_model_requires_narrow_prompt "$MANAGER_MODEL"; then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Context: authorized local development in my own repository. Task type: benign software engineering. Do not perform offensive security, credential extraction, vulnerability exploitation, malware behavior, unauthorized access, network scanning, or bypassing security controls. Use only the listed local project files needed for the requested implementation: SPECIFICATION and files explicitly necessary to create one bounded initial assignment.
PROMPT
fi
chmod 600 "$prompt_file.tmp.$$"
mv "$prompt_file.tmp.$$" "$prompt_file"

extract_thread_id()
{
	local log_file="$1"
	if command -v jq >/dev/null 2>&1; then
		jq -r 'select(.type == "thread.started") | .thread_id' "$log_file" | head -n 1
	else
		sed -n 's/.*"type"[[:space:]]*:[[:space:]]*"thread.started".*"thread_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$log_file" | head -n 1
	fi
}

bootstrap_task_published()
{
	compgen -G "$project_path/tasks/$PROJECT-task-*.ready.md" >/dev/null
}

attempt=1
provider_retries=0
quota_waits=0
resume_thread_id=""
status=0
json_log=""
stderr_log=""
classification=""
fallback_stage=0
current_model="$MANAGER_MODEL"

while true; do
	stamp="$(date -u '+%Y%m%dT%H%M%SZ')"
	attempt_label="$(printf '%03d' "$attempt")"
	json_log="$project_path/logs/manager-bootstrap-$stamp-attempt-$attempt_label.jsonl"
	stderr_log="$project_path/logs/manager-bootstrap-$stamp-attempt-$attempt_label.stderr.log"
	attempt_last_message="$project_path/logs/manager-bootstrap-$stamp-attempt-$attempt_label.md"

	log_event "MANAGER_BOOTSTRAP_STARTED attempt=$attempt"
	trace_event MANAGER_BOOTSTRAP_ATTEMPT "attempt=$attempt" "resume_thread_id=${resume_thread_id:-}" "json_log=$json_log" "last_message=$attempt_last_message"
	set +e
	if [[ -n "$resume_thread_id" ]]; then
		trace_event CODEX_EXEC_START "role=manager_bootstrap" "attempt=$attempt" "mode=resume" "thread_id=$resume_thread_id" "json_log=$json_log" "last_message=$attempt_last_message" "model=$MANAGER_MODEL"
		"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" manager_bootstrap "$current_model" "$prompt_file" "$json_log" "$stderr_log" "$attempt_last_message" resume "$resume_thread_id"
	else
		trace_event CODEX_EXEC_START "role=manager_bootstrap" "attempt=$attempt" "mode=new" "json_log=$json_log" "last_message=$attempt_last_message" "model=$MANAGER_MODEL"
		"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" manager_bootstrap "$current_model" "$prompt_file" "$json_log" "$stderr_log" "$attempt_last_message"
	fi
	status=$?
	set -e
	classification="$(kv_file_value "${json_log%.jsonl}.classification" classification 2>/dev/null || true)"
	trace_event CODEX_EXEC_END "role=manager_bootstrap" "attempt=$attempt" "status=$status" "json_log=$json_log" "last_message=$attempt_last_message"

	thread_id="$(extract_thread_id "$json_log")"
	if [[ -n "$thread_id" && "$thread_id" != "null" ]]; then
		resume_thread_id="$thread_id"
	fi

	if (( status == 0 )); then
		project_plan_exists || die "manager bootstrap exited without initializing the project plan"
		bootstrap_task_published || die "manager bootstrap exited without publishing the first task"
		[[ -n "$resume_thread_id" ]] || die "could not extract Codex thread id from $json_log"
		cp -f "$attempt_last_message" "$last_message" 2>/dev/null || true
		"$HARNESS_BIN/manager-register-thread" "$HARNESS_ENV_FILE" "$resume_thread_id" >/dev/null
		log_event "MANAGER_BOOTSTRAPPED thread_id=$resume_thread_id attempts=$attempt"
		trace_event MANAGER_BOOTSTRAP_COMMITTED "thread_id=$resume_thread_id" "attempts=$attempt" "status=$status"
		printf 'Manager bootstrap completed and exited.\n'
		printf 'Thread ID: %s\n' "$resume_thread_id"
		exit 0
	fi

	# If the manager published the first task immediately before the API stream
	# failed, registering the captured thread is safer than replaying bootstrap
	# and potentially publishing a duplicate first task.
	if project_plan_exists && bootstrap_task_published; then
		[[ -n "$resume_thread_id" ]] || die "manager published an initial task but no thread id could be recovered from $json_log"
		cp -f "$attempt_last_message" "$last_message" 2>/dev/null || true
		"$HARNESS_BIN/manager-register-thread" "$HARNESS_ENV_FILE" "$resume_thread_id" >/dev/null
		log_event "MANAGER_BOOTSTRAPPED thread_id=$resume_thread_id attempts=$attempt outcome=task_published_before_process_failure status=$status"
		trace_event MANAGER_BOOTSTRAP_RECOVERED "thread_id=$resume_thread_id" "attempts=$attempt" "status=$status"
		printf 'Manager bootstrap task was published before the Codex process failed; recovered thread %s.\n' "$resume_thread_id"
		exit 0
	fi

	retry_kind="$(codex_provider_retry_kind "$classification" 2>/dev/null || true)"
	if [[ -n "$retry_kind" ]]; then
		retry_delay="$(codex_provider_retry_delay "$classification")"
		provider_retries=$((provider_retries + 1))
		[[ "$retry_kind" != quota ]] || quota_waits=$((quota_waits + 1))
		log_event "MANAGER_BOOTSTRAP_PROVIDER_WAIT kind=$retry_kind attempt=$attempt retry=$provider_retries delay_seconds=$retry_delay classification=$classification"
		if [[ "$retry_kind" == quota ]]; then
			printf 'Manager bootstrap has no provider quota; state is preserved. Checking again in %s seconds (quota wait %s).\n' "$retry_delay" "$quota_waits" >&2
		else
			printf 'Manager bootstrap hit a transient provider/network failure; retrying in %s seconds.\n' "$retry_delay" >&2
		fi
		sleep "$retry_delay"
		attempt=$((attempt + 1))
		log_event "MANAGER_BOOTSTRAP_PROVIDER_RETRY_STARTED kind=$retry_kind attempt=$attempt retry=$provider_retries"
		trace_event MANAGER_BOOTSTRAP_RETRY "kind=$retry_kind" "attempt=$attempt" "retry=$provider_retries"
		continue
	fi

	if codex_model_requires_narrow_prompt "$current_model" && [[ "$classification" == model_refusal_or_blocked_content ]]; then
		if (( fallback_stage == 0 )); then
			fallback_stage=1; attempt=$((attempt + 1))
			printf '\nRetry scope: create one bounded initial assignment only; do not inspect unrelated directories.\n' >> "$prompt_file"
			log_event "MANAGER_TERRA_NARROW_RETRY classification=$classification"
			continue
		elif (( fallback_stage == 1 )) && [[ "$MANAGER_FALLBACK_MODEL" != "$current_model" ]]; then
			fallback_stage=2; current_model="$MANAGER_FALLBACK_MODEL"; attempt=$((attempt + 1))
			log_event "MANAGER_MODEL_FALLBACK classification=$classification model=$current_model"
			continue
		fi
	fi

	die "Codex manager bootstrap failed with exit status $status; see $json_log"
done
