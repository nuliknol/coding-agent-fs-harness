#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"
source "$SCRIPT_DIR/../lib/harness-sctm.sh"

[[ $# -eq 2 ]] || { printf 'Usage: %s ENV_FILE TRANSACTION_ID\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
transaction_id="$2"
ensure_project
require_repository
canonical_repository="$REPOSITORY"
sctm_validate_identity "$transaction_id"
sctm_ensure_state
transaction_dir="$(sctm_transaction_dir "$transaction_id")"
request="$transaction_dir/request"
[[ -f "$request" ]] || { sctm_write_result "$transaction_dir" INVALID_REQUEST missing-request; exit 0; }
[[ ! -f "$transaction_dir/result" ]] || exit 0

project_id="$(kv_file_value "$request" project_id 2>/dev/null || true)"
worker_id="$(kv_file_value "$request" worker_id 2>/dev/null || true)"
task_id="$(kv_file_value "$request" task_id 2>/dev/null || true)"
base_commit="$(kv_file_value "$request" base_commit 2>/dev/null || true)"
if [[ "$project_id" != "$PROJECT" || -z "$worker_id" || -z "$task_id" ||
	! "$base_commit" =~ ^[0-9a-fA-F]{40,64}$ ]]; then
	sctm_write_result "$transaction_dir" INVALID_REQUEST malformed-metadata
	exit 0
fi
for required in patch declared-paths capability-paths message validation-command; do
	if [[ ! -f "$transaction_dir/$required" ]]; then
		sctm_write_result "$transaction_dir" INVALID_REQUEST "missing-$required"
		exit 0
	fi
done

exec 9>"$(sctm_repository_lock)"
flock -x 9
current_head="$(git -C "$REPOSITORY" rev-parse HEAD)"
state="$(cat "$transaction_dir/state" 2>/dev/null || printf QUEUED)"
if [[ "$state" == COMMITTING ]]; then
	previous_commit="$(kv_file_value "$transaction_dir/commit-state" previous_commit 2>/dev/null || true)"
	candidate_commit="$(kv_file_value "$transaction_dir/commit-state" candidate_commit 2>/dev/null || true)"
	if [[ "$current_head" == "$candidate_commit" ]]; then
		git -C "$REPOSITORY" reset --hard -q "$candidate_commit"
		printf '%s\n' "$candidate_commit" > "$transaction_dir/resulting-commit"
		chmod 600 "$transaction_dir/resulting-commit"
		sync -f "$transaction_dir/resulting-commit" 2>/dev/null || true
		sctm_write_result "$transaction_dir" APPLIED crash-recovered \
			"commit=$candidate_commit" "previous_commit=$previous_commit" \
			"changed_paths=$(paste -sd, "$transaction_dir/changed-paths")"
		log_event "SCTM_TRANSACTION_RECOVERY_APPLIED transaction=$transaction_id task=$task_id previous=$previous_commit commit=$candidate_commit"
		exit 0
	elif [[ "$current_head" == "$previous_commit" ]]; then
		# A process can die while Git is updating the canonical index/worktree but
		# before its ref advances. Restore the complete old side of the
		# transaction before safely rebuilding the candidate.
		git -C "$REPOSITORY" reset --hard -q "$previous_commit"
	elif [[ "$current_head" != "$previous_commit" ]]; then
		sctm_write_result "$transaction_dir" INTERNAL_ERROR unexpected-head-during-recovery \
			"previous_commit=$previous_commit" "current_commit=$current_head" "candidate_commit=$candidate_commit"
		exit 0
	fi
fi

if ! git -C "$REPOSITORY" diff --quiet --ignore-submodules -- ||
	! git -C "$REPOSITORY" diff --cached --quiet --ignore-submodules --; then
	sctm_write_result "$transaction_dir" INTERNAL_ERROR canonical-worktree-not-clean "current_commit=$current_head"
	exit 0
fi
if ! git -C "$REPOSITORY" cat-file -e "$base_commit^{commit}" 2>/dev/null; then
	sctm_write_result "$transaction_dir" STALE_BASE base-commit-unavailable "current_commit=$current_head"
	exit 0
fi
if ! git -C "$REPOSITORY" merge-base --is-ancestor "$base_commit" "$current_head"; then
	sctm_write_result "$transaction_dir" STALE_BASE base-not-ancestor "current_commit=$current_head"
	exit 0
fi

staging="$(sctm_staging_dir)/$transaction_id"
git -C "$REPOSITORY" worktree remove --force "$staging" >/dev/null 2>&1 || true
rm -rf -- "$staging"
if ! git -C "$REPOSITORY" worktree add --detach "$staging" "$current_head" >"$transaction_dir/stdout" 2>"$transaction_dir/stderr"; then
	sctm_write_result "$transaction_dir" INTERNAL_ERROR staging-worktree-create-failed "current_commit=$current_head"
	exit 0
fi
cleanup_staging()
{
	git -C "$REPOSITORY" worktree remove --force "$staging" >/dev/null 2>&1 || true
}
trap cleanup_staging EXIT

apply_status=0
git -C "$staging" apply --3way --index --whitespace=nowarn "$transaction_dir/patch" \
	>>"$transaction_dir/stdout" 2>>"$transaction_dir/stderr" || apply_status=$?
if (( apply_status != 0 )); then
	git -C "$staging" reset --hard -q "$current_head" || true
	conflict_file="$(sed -nE 's/.*patch failed: ([^:]+):.*/\1/p; s/.*does not apply: (.*)/\1/p' "$transaction_dir/stderr" | head -n 1)"
	[[ -n "$conflict_file" ]] || conflict_file=-
	base_hash=-
	current_hash=-
	conflicting_region=-
	if [[ "$conflict_file" != - ]]; then
		base_hash="$(git -C "$REPOSITORY" rev-parse "$base_commit:$conflict_file" 2>/dev/null || printf -)"
		current_hash="$(git -C "$REPOSITORY" rev-parse "$current_head:$conflict_file" 2>/dev/null || printf -)"
		conflict_hunk="$(awk -v wanted="$conflict_file" '
			$0 == "diff --git a/" wanted " b/" wanted {inside=1; next}
			inside && /^diff --git / {exit}
			inside && /^@@ / {print; exit}
		' "$transaction_dir/patch")"
		if [[ "$conflict_hunk" =~ ^@@[[:space:]]+-([0-9]+)(,([0-9]+))? ]]; then
			region_start="${BASH_REMATCH[1]}"
			region_count="${BASH_REMATCH[3]:-1}"
			(( region_count > 0 )) || region_count=1
			conflicting_region="$conflict_file:$region_start-$((region_start + region_count - 1))"
		fi
	fi
	mapfile -t declared_paths < "$transaction_dir/declared-paths"
	git -C "$REPOSITORY" diff --binary "$base_commit..$current_head" -- "${declared_paths[@]}" |
		head -c "$HARNESS_SCTM_MAX_CONFLICT_DELTA_BYTES" \
		> "$transaction_dir/delta-since-worker-base.patch" || true
	chmod 600 "$transaction_dir/delta-since-worker-base.patch"
	sctm_write_result "$transaction_dir" CONFLICT PATCH_CONTEXT_CHANGED \
		"file=$conflict_file" "base_commit=$base_commit" "current_commit=$current_head" \
		"base_hash=$base_hash" "current_hash=$current_hash" "conflicting_region=$conflicting_region" \
		"delta_since_worker_base=$transaction_dir/delta-since-worker-base.patch"
	log_event "SCTM_TRANSACTION_CONFLICT transaction=$transaction_id task=$task_id base=$base_commit current=$current_head file=$(printf '%q' "$conflict_file")"
	exit 0
fi

git -C "$staging" diff --cached --no-renames --name-only -z | sort -z > "$transaction_dir/changed-paths.z"
tr '\0' '\n' < "$transaction_dir/changed-paths.z" > "$transaction_dir/changed-paths"
if [[ ! -s "$transaction_dir/changed-paths" ]]; then
	sctm_write_result "$transaction_dir" INVALID_PATCH patch-has-no-effective-change "current_commit=$current_head"
	exit 0
fi
LC_ALL=C sort -u "$transaction_dir/declared-paths" > "$transaction_dir/declared-paths.sorted"
if ! cmp -s "$transaction_dir/changed-paths" "$transaction_dir/declared-paths.sorted"; then
	sctm_write_result "$transaction_dir" SCOPE_VIOLATION declared-path-set-mismatch \
		"current_commit=$current_head" "actual_paths=$(paste -sd, "$transaction_dir/changed-paths")"
	log_event "SCTM_SCOPE_VIOLATION transaction=$transaction_id task=$task_id reason=declared-path-set-mismatch"
	exit 0
fi
scope_violation=""
while IFS= read -r changed_path; do
	authorized=0
	while IFS= read -r capability; do
		capability="${capability%/}"
		[[ -n "$capability" && "$capability" != - ]] || continue
		if [[ "$changed_path" == "$capability" || "$changed_path" == "$capability/"* ]]; then authorized=1; break; fi
	done < "$transaction_dir/capability-paths"
	(( authorized == 1 )) || { scope_violation="$changed_path"; break; }
done < "$transaction_dir/changed-paths"
if [[ -n "$scope_violation" ]]; then
	git -C "$staging" reset --hard -q "$current_head"
	sctm_write_result "$transaction_dir" SCOPE_VIOLATION unauthorized-path "file=$scope_violation" "current_commit=$current_head"
	log_event "SCTM_SCOPE_VIOLATION transaction=$transaction_id task=$task_id file=$(printf '%q' "$scope_violation")"
	exit 0
fi
if ! git -C "$staging" diff --cached --check >>"$transaction_dir/stdout" 2>>"$transaction_dir/stderr"; then
	sctm_write_result "$transaction_dir" INVALID_PATCH patch-whitespace-or-format-check-failed "current_commit=$current_head"
	exit 0
fi

GIT_AUTHOR_NAME="SCTM $worker_id" GIT_AUTHOR_EMAIL="sctm@localhost" \
	GIT_COMMITTER_NAME="SCTM" GIT_COMMITTER_EMAIL="sctm@localhost" \
	git -C "$staging" -c commit.gpgSign=false commit --no-verify -F "$transaction_dir/message" \
	>>"$transaction_dir/stdout" 2>>"$transaction_dir/stderr" || {
	sctm_write_result "$transaction_dir" INTERNAL_ERROR staging-commit-failed "current_commit=$current_head"
	exit 0
}
candidate_commit="$(git -C "$staging" rev-parse HEAD)"
validation="$(cat "$transaction_dir/validation-command")"
if [[ -n "$validation" && "$validation" != - ]]; then
	mkdir -p "$transaction_dir/validation-tmp"
	set +e
	(
		export REPOSITORY="$staging"
		export HARNESS_ACP_CANONICAL_REPOSITORY="$canonical_repository"
		export HARNESS_TASK_TMP_DIR="$transaction_dir/validation-tmp"
		cd "$staging"
		/bin/bash -lc "$validation"
	) > "$transaction_dir/validation.stdout" 2> "$transaction_dir/validation.stderr"
	validation_status=$?
	set -e
	if (( validation_status != 0 )); then
		sctm_write_result "$transaction_dir" VALIDATION_FAILED focused-validation-failed \
			"candidate_commit=$candidate_commit" "validation_status=$validation_status"
		log_event "SCTM_VALIDATION_FAILED transaction=$transaction_id task=$task_id candidate=$candidate_commit status=$validation_status"
		exit 0
	fi
fi

{
	printf 'previous_commit=%s\ncandidate_commit=%s\n' "$current_head" "$candidate_commit"
} > "$transaction_dir/commit-state.tmp.$$"
chmod 600 "$transaction_dir/commit-state.tmp.$$"
mv "$transaction_dir/commit-state.tmp.$$" "$transaction_dir/commit-state"
printf 'COMMITTING\n' > "$transaction_dir/state.tmp.$$"
chmod 600 "$transaction_dir/state.tmp.$$"
mv "$transaction_dir/state.tmp.$$" "$transaction_dir/state"
sync -f "$transaction_dir/commit-state" 2>/dev/null || true
sync -f "$transaction_dir" 2>/dev/null || true
publish_head="$(git -C "$REPOSITORY" rev-parse HEAD)"
if [[ "$publish_head" != "$current_head" ]] ||
	! git -C "$REPOSITORY" diff --quiet --ignore-submodules -- ||
	! git -C "$REPOSITORY" diff --cached --quiet --ignore-submodules --; then
	sctm_write_result "$transaction_dir" INTERNAL_ERROR canonical-changed-during-transaction \
		"previous_commit=$current_head" "current_commit=$publish_head" "candidate_commit=$candidate_commit"
	exit 0
fi
if ! git -C "$REPOSITORY" merge --ff-only "$candidate_commit" >>"$transaction_dir/stdout" 2>>"$transaction_dir/stderr"; then
	publish_head="$(git -C "$REPOSITORY" rev-parse HEAD)"
	if [[ "$publish_head" == "$candidate_commit" ]]; then
		git -C "$REPOSITORY" reset --hard -q "$candidate_commit"
	else
		[[ "$publish_head" != "$current_head" ]] || git -C "$REPOSITORY" reset --hard -q "$current_head"
		sctm_write_result "$transaction_dir" INTERNAL_ERROR canonical-fast-forward-failed \
			"previous_commit=$current_head" "current_commit=$publish_head" "candidate_commit=$candidate_commit"
		exit 0
	fi
fi
printf '%s\n' "$candidate_commit" > "$transaction_dir/resulting-commit"
chmod 600 "$transaction_dir/resulting-commit"
sync -f "$transaction_dir/resulting-commit" 2>/dev/null || true
sctm_write_result "$transaction_dir" APPLIED committed \
	"commit=$candidate_commit" "previous_commit=$current_head" \
	"changed_paths=$(paste -sd, "$transaction_dir/changed-paths")"
log_event "SCTM_TRANSACTION_APPLIED transaction=$transaction_id task=$task_id worker=$worker_id previous=$current_head commit=$candidate_commit paths=$(printf '%q' "$(paste -sd, "$transaction_dir/changed-paths")")"
