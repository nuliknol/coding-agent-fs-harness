#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE TASK_ROOT RESOLUTION_NOTE_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 3 ]] || usage
load_harness_env "$1"
root="$2"
note_file="$3"
ensure_project
validate_task_id "$root"
[[ "$(task_root_id "$root")" == "$root" ]] || die 'TASK_ROOT must not be a revision ID'
[[ -s "$note_file" ]] || die "token anomaly resolution note is missing or empty: $note_file"
for heading in '## Cause' '## Corrective action' '## Safe continuation boundary'; do
	grep -Fqx -- "$heading" "$note_file" ||
		die "token anomaly resolution note is missing required heading: $heading"
	awk -v heading="$heading" '
		$0 == heading {inside=1; next}
		inside && /^## / {exit}
		inside && $0 !~ /^[[:space:]]*$/ {found=1}
		END {exit found ? 0 : 1}
	' "$note_file" || die "token anomaly resolution section is empty: $heading"
done
partial_edit_disposition="$(metadata_value "$note_file" Partial-Edit-Disposition)"
partial_edit_task="$(metadata_value "$note_file" Partial-Edit-Task)"
[[ -z "$partial_edit_disposition" || "$partial_edit_disposition" == PRESERVE ||
	"$partial_edit_disposition" == DISCARD_PRESERVED ]] ||
	die 'Partial-Edit-Disposition must be PRESERVE or DISCARD_PRESERVED'
if [[ "$partial_edit_disposition" == DISCARD_PRESERVED ]]; then
	[[ -n "$partial_edit_task" ]] || die 'DISCARD_PRESERVED requires Partial-Edit-Task'
	validate_task_id "$partial_edit_task"
	[[ "$(task_root_id "$partial_edit_task")" == "$root" ]] ||
		die 'Partial-Edit-Task does not belong to the resolved root'
fi
acquire_project_lock

marker="$(task_root_token_usage_anomaly_file "$root")"
[[ -f "$marker" ]] || die "root does not have a token usage anomaly: $root"
archive_dir="$(project_dir)/archive/token-usage-anomalies"
mkdir -p "$archive_dir"
chmod 700 "$archive_dir"
stamp="$(timestamp_compact_utc)"
archive="$archive_dir/$PROJECT-task-$root.$stamp.resolved.md"

discarded_paths=0
if [[ "$partial_edit_disposition" == DISCARD_PRESERVED ]]; then
	assignment="$(project_dir)/archive/$(task_base "$partial_edit_task").assignment.md"
	[[ -f "$assignment" ]] || die "partial-edit task assignment is missing: $partial_edit_task"
	allowed_scope="$(metadata_value "$assignment" Allowed-Scope)"
	[[ -n "$allowed_scope" ]] || die 'partial-edit task lacks Allowed-Scope'
	git -C "$REPOSITORY" diff --cached --quiet ||
		die 'refusing to discard partial edits while staged changes exist'
	mapfile -t untracked_paths < <(git -C "$REPOSITORY" ls-files --others --exclude-standard)
	(( ${#untracked_paths[@]} == 0 )) ||
		die 'refusing to discard partial edits while non-ignored untracked files exist'
	mapfile -t dirty_paths < <(git -C "$REPOSITORY" diff --name-only)
	(( ${#dirty_paths[@]} > 0 )) || die 'DISCARD_PRESERVED requested but no tracked partial edits exist'
	IFS=',' read -r -a allowed_entries <<< "${allowed_scope//;/,}"
	for dirty_path in "${dirty_paths[@]}"; do
		path_allowed=0
		for allowed_entry in "${allowed_entries[@]}"; do
			allowed_entry="$(trim_surrounding_whitespace "$allowed_entry")"
			if [[ "$dirty_path" == "$allowed_entry" || "$dirty_path" == "$allowed_entry"/* ]]; then
				path_allowed=1
				break
			fi
		done
		(( path_allowed == 1 )) ||
			die "refusing to discard out-of-scope partial edit: $dirty_path"
	done
	patch_archive="${archive%.md}.workspace.patch"
	status_archive="${archive%.md}.workspace-status.txt"
	git -C "$REPOSITORY" status --short > "$status_archive.tmp.$$"
	git -C "$REPOSITORY" diff --binary -- "${dirty_paths[@]}" > "$patch_archive.tmp.$$"
	chmod 600 "$status_archive.tmp.$$" "$patch_archive.tmp.$$"
	mv "$status_archive.tmp.$$" "$status_archive"
	mv "$patch_archive.tmp.$$" "$patch_archive"
	git -C "$REPOSITORY" restore --worktree -- "${dirty_paths[@]}"
	discarded_paths="${#dirty_paths[@]}"
fi
{
	cat "$marker"
	printf '\n## Operator resolution\n\n'
	cat "$note_file"
	printf '\n\nResolved-At: %s\n' "$(timestamp_utc)"
} > "$archive.tmp.$$"
chmod 600 "$archive.tmp.$$"
mv "$archive.tmp.$$" "$archive"
rm -f "$marker"
# A token anomaly proves that the current transcript is not a safe continuation
# capsule. Rotate both legacy root-thread state and goal-mode thread state; a
# repaired task may reuse the logical Goal-ID, but never the amplified context.
clear_worker_thread_for_root "$root" token_usage_anomaly_resolved
rotated_goal_threads=0
shopt -s nullglob
for goal_state in "$(goal_control_dir)"/"$PROJECT-task-"*.goal; do
	[[ "$(kv_file_value "$goal_state" task_root 2>/dev/null || true)" == "$root" ]] || continue
	goal_task="$(kv_file_value "$goal_state" task_id 2>/dev/null || true)"
	[[ -n "$goal_task" ]] || continue
	goal_state_set "$goal_state" thread_id ""
	goal_state_set "$goal_state" thread_context token-anomaly-resolved
	goal_thread_store "$goal_task" "" token-anomaly-resolved
	rotated_goal_threads=$((rotated_goal_threads + 1))
done
shopt -u nullglob
cleared_reviews=0
shopt -s nullglob
for result_file in "$(project_dir)/results/$PROJECT-task-"*.result.md; do
	task_id="$(task_id_from_filename "$result_file")"
	[[ "$(task_root_id "$task_id")" == "$root" ]] || continue
	base="$(task_base "$task_id")"
	if [[ -e "$(project_dir)/control/$base.reviewed-event" ||
		-e "$(project_dir)/control/$base.manager-failed.md" ||
		-e "$(project_dir)/control/$base.manager-review-stalled.md" ]]; then
		rm -f "$(project_dir)/control/$base.reviewed-event" \
			"$(project_dir)/control/$base.manager-failed.md" \
			"$(project_dir)/control/$base.manager-review-stalled.md"
		cleared_reviews=$((cleared_reviews + 1))
	fi
done
shopt -u nullglob
record_root_convergence_baseline "$root"
record_root_replan_baseline "$root"
log_event "TOKEN_USAGE_ANOMALY_RESOLVED root=$root resolution=$archive review_suppression_cleared=$cleared_reviews goal_threads_rotated=$rotated_goal_threads discarded_partial_paths=$discarded_paths"
printf '%s\n' "$archive"
