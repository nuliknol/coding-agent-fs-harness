#!/usr/bin/env bash
# Run one Codex turn with isolated JSONL, stderr, and final-message files.
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE ROLE PROMPT JSONL STDERR LAST_MESSAGE [resume THREAD_ID]\n' \
		"${0##*/}" >&2
	exit 2
}

[[ $# -ge 6 && $# -le 8 ]] || usage
env_file="$1"
role="$2"
prompt="$3"
jsonl="$4"
stderr_log="$5"
last_message="$6"
shift 6

load_harness_env "$env_file"
ensure_project
[[ -f "$prompt" ]] || die "prompt does not exist: $prompt"

case "$role" in
	manager_goal|manager_review)
		codex_bin="$MANAGER_CODEX_BIN"
		codex_home="$MANAGER_CODEX_HOME"
		model="$MANAGER_MODEL"
		effort="$MANAGER_REASONING_EFFORT"
		sandbox="$MANAGER_SANDBOX"
		extra_args=("${MANAGER_CODEX_EXTRA_ARGS[@]}")
		;;
	worker)
		codex_bin="$WORKER_CODEX_BIN"
		codex_home="$WORKER_CODEX_HOME"
		model="$WORKER_MODEL"
		effort="$WORKER_REASONING_EFFORT"
		sandbox="$WORKER_SANDBOX"
		extra_args=("${WORKER_CODEX_EXTRA_ARGS[@]}")
		;;
	*)
		die "invalid role: $role"
		;;
esac
require_runtime "$codex_bin"

umask 077
mkdir -p "$(dirname "$jsonl")" "$(dirname "$stderr_log")" "$(dirname "$last_message")"
: > "$jsonl"
: > "$stderr_log"
: > "$last_message"

cmd=(
	env "CODEX_HOME=$codex_home"
	"$codex_bin" exec
	--json
	--model "$model"
	--sandbox "$sandbox"
	--cd "$REPOSITORY"
	--add-dir "$(project_dir)"
	"${extra_args[@]}"
	-c 'approval_policy="never"'
	-c "model_reasoning_effort=\"$effort\""
	--output-last-message "$last_message"
)
if [[ $# -eq 2 ]]; then
	[[ "$1" == resume ]] || usage
	[[ "$2" =~ ^[A-Za-z0-9._:-]+$ ]] || die "invalid thread ID: $2"
	cmd+=(resume "$2")
elif [[ $# -ne 0 ]]; then
	usage
fi
cmd+=(-)

git_state_before=""
if git -C "$REPOSITORY" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
	git_state_before="$(git -C "$REPOSITORY" status --porcelain=v1 |
		sha256sum | awk '{print $1}')"
fi

if (( HARNESS_CODEX_WALL_TIMEOUT_SECONDS > 0 )); then
	timeout --signal=TERM \
		--kill-after="${HARNESS_CODEX_KILL_GRACE_SECONDS}s" \
		"${HARNESS_CODEX_WALL_TIMEOUT_SECONDS}s" \
		"${cmd[@]}" < "$prompt" > "$jsonl" 2> "$stderr_log" &
else
	"${cmd[@]}" < "$prompt" > "$jsonl" 2> "$stderr_log" &
fi
child_pid=$!
idle_timeout=0
last_activity="$(date '+%s')"
while kill -0 "$child_pid" 2>/dev/null; do
	sleep 1
	if ! kill -0 "$child_pid" 2>/dev/null ||
		[[ "$(ps -o stat= -p "$child_pid" 2>/dev/null || true)" == Z* ]]; then
		break
	fi
	now="$(date '+%s')"
	for file in "$jsonl" "$stderr_log"; do
		mtime="$(stat -c '%Y' "$file" 2>/dev/null || printf 0)"
		(( mtime > last_activity )) && last_activity="$mtime"
	done
	if (( HARNESS_CODEX_IDLE_TIMEOUT_SECONDS > 0 &&
		now - last_activity >= HARNESS_CODEX_IDLE_TIMEOUT_SECONDS )); then
		idle_timeout=1
		kill -TERM "$child_pid" 2>/dev/null || true
		sleep "$HARNESS_CODEX_KILL_GRACE_SECONDS"
		kill -KILL "$child_pid" 2>/dev/null || true
		break
	fi
done
set +e
wait "$child_pid"
exit_status=$?
set -e

git_state_changed=0
if [[ -n "$git_state_before" ]]; then
	git_state_after="$(git -C "$REPOSITORY" status --porcelain=v1 |
		sha256sum | awk '{print $1}')"
	[[ "$git_state_before" == "$git_state_after" ]] || git_state_changed=1
fi

error_text="$(cat "$stderr_log")"
if [[ -s "$jsonl" ]] && jq -e -s 'all(.[]; type == "object")' "$jsonl" >/dev/null 2>&1; then
	json_error="$(jq -r '
		select(.type == "error" or .type == "turn.failed")
		| [.message?, .error.message?, .error?]
		| map(select(type == "string")) | join(" ")
	' "$jsonl" 2>/dev/null || true)"
	error_text+=$'\n'"$json_error"
fi

classification=success
if (( idle_timeout )); then
	classification=idle_timeout
elif (( exit_status == 124 )); then
	classification=wall_clock_timeout
elif { (( exit_status != 0 )) || [[ ! -s "$jsonl" ]]; } &&
	printf '%s\n' "$error_text" |
		grep -Eqi 'usage limit|quota.{0,40}(exceeded|exhausted|reached)|out of (credits|quota)|limit resets'; then
	classification=provider_quota_exhausted
elif { (( exit_status != 0 )) || [[ ! -s "$jsonl" ]]; } &&
	printf '%s\n' "$error_text" |
		grep -Eqi 'rate.?limit|at capacity|overloaded|too many requests|service unavailable|temporarily unavailable|server error|gateway timeout|connection reset|network error|request timed out'; then
	classification=provider_transient_error
elif (( exit_status != 0 && git_state_changed )); then
	classification=partial_edit_failure
elif (( exit_status != 0 )); then
	classification=process_nonzero_exit
elif ! jq -e -s 'all(.[]; type == "object" and (.type | type == "string"))' \
	"$jsonl" >/dev/null 2>&1; then
	classification=json_event_parse_failure
elif ! jq -e 'select(.type == "turn.completed")' "$jsonl" >/dev/null 2>&1; then
	classification=turn_incomplete
elif [[ ! -s "$last_message" ]]; then
	classification=empty_final_output
fi

classification_file="${jsonl%.jsonl}.classification"
{
	printf 'classification=%s\n' "$classification"
	printf 'exit_status=%s\n' "$exit_status"
	printf 'idle_timeout=%s\n' "$idle_timeout"
	printf 'partial_edits=%s\n' "$git_state_changed"
	printf 'jsonl=%s\n' "$jsonl"
	printf 'stderr=%s\n' "$stderr_log"
	printf 'last_message=%s\n' "$last_message"
} > "$classification_file"
chmod 600 "$classification_file"

[[ "$classification" == success ]] || exit 1
