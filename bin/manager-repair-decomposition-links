#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
project_plan_exists && { printf 'Decomposition DAG already exists.\n'; exit 0; }
decomposition_candidate_matches_current_inputs || die 'no current full decomposition candidate exists'
[[ "$(decomposition_candidate_state_value status)" == REJECTED ]] || die 'architecture-link repair requires a rejected candidate'

candidate_dir="$(decomposition_candidate_state_value directory)"
architecture_source="$(decomposition_candidate_state_value architecture_directory -)"
rejection_log="$(decomposition_candidate_state_value rejection_log "$candidate_dir/rejection.log")"
[[ "$architecture_source" != - && -d "$architecture_source" ]] || die 'architecture-link repair requires an architecture registry'
grep -Eq 'consumer .* must directly depend on producer' "$rejection_log" ||
	die 'candidate rejection is not a mechanically repairable architecture-link defect'

repair_dir="$PROJECT_TMP_DIR/decomposition-link-repair-${candidate_dir##*/}"
rm -rf -- "$repair_dir"
mkdir -p "$repair_dir/architecture"
install -m 600 "$candidate_dir/coverage.tsv" "$repair_dir/coverage.tsv"
for name in invariants decisions edges node-bindings health-gates debt; do
	install -m 600 "$architecture_source/$name.tsv" "$repair_dir/architecture/$name.tsv"
done

awk -F '\t' -v OFS='\t' -v edges_file="$architecture_source/edges.tsv" -v dag_file="$candidate_dir/dag.tsv" '
	function trim(v) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", v); return v }
	FILENAME == edges_file {
		if (FNR == 1) next
		if ($2 != $3) required[$3 SUBSEP $2]=1
		next
	}
	FILENAME == dag_file {
		if (FNR == 1) { header=$0; next }
		count++; row[count]=$0; id[count]=$1; order[$1]=count; parent[$1]=$2; depends[$1]=$3
		n=split($3,a,","); for (i=1;i<=n;i++) if (trim(a[i]) != "-") dependency[$1 SUBSEP trim(a[i])]=1
		next
	}
	END {
		for (key in required) {
			split(key,p,SUBSEP); consumer=p[1]; producer=p[2]
			if (!(consumer in order) || !(producer in order)) {
				printf "architecture edge references an unknown DAG node: %s -> %s\n", producer, consumer > "/dev/stderr"; errors++; continue
			}
			if (!(key in dependency)) {
				dependency[key]=1
				if (depends[consumer] == "-") depends[consumer]=producer
				else depends[consumer]=depends[consumer] "," producer
			}
		}
		if (errors) exit 1
		print header
		for (step=1;step<=count;step++) {
			selected=""
			for (i=1;i<=count;i++) {
				node=id[i]; if (emitted[node]) continue
				ready=(parent[node] == "-" || emitted[parent[node]])
				if (ready) for (key in dependency) {
					split(key,p,SUBSEP)
					if (p[1] == node && !emitted[p[2]]) { ready=0; break }
				}
				if (ready) { selected=node; break }
			}
			if (selected == "") { print "architecture-link repair would create a dependency or parent cycle" > "/dev/stderr"; exit 1 }
			emitted[selected]=1
			split(row[order[selected]],f,"\t"); f[3]=depends[selected]
			out=f[1]; for (j=2;j<=11;j++) out=out OFS f[j]; print out
		}
	}
' "$architecture_source/edges.tsv" "$candidate_dir/dag.tsv" > "$repair_dir/dag.tsv"
chmod 600 "$repair_dir/dag.tsv"

set +e
"$HARNESS_BIN/manager-submit-decomposition" "$HARNESS_ENV_FILE" \
	"$repair_dir/dag.tsv" "$repair_dir/coverage.tsv" "$repair_dir/architecture"
status=$?
set -e
if project_plan_exists; then
	log_event "DECOMPOSITION_LINKS_REPAIRED source=$candidate_dir"
	printf 'Architecture producer/consumer links repaired and installed.\n'
	exit 0
fi
new_candidate_dir="$(decomposition_candidate_state_value directory -)"
if [[ "$new_candidate_dir" != - && "$new_candidate_dir" != "$candidate_dir" ]] &&
	decomposition_candidate_matches_current_inputs; then
	log_event "DECOMPOSITION_LINKS_PROGRESS previous=${candidate_dir##*/} current=${new_candidate_dir##*/} status=$(decomposition_candidate_state_value status -)"
	printf 'Architecture links repaired; continuing with the next bounded diagnostic.\n'
	exit 0
fi
(( status == 0 )) && die 'architecture-link repair returned success without installing or advancing the candidate'
die "architecture-link repair failed with status $status"
