#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-mode.sh"
harness_dispatch_mode "$SCRIPT_DIR/.." "${0##*/}" "$@"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project

(( HARNESS_SPECIFICATION_REVIEW_ENABLED == 1 )) || die 'specification review is disabled for this project'
specification_review_matches_current_inputs ||
	die 'no current clarification request matches the specification, repository baseline, and domain profiles; run harness-start to review the current inputs'
[[ "$(specification_review_state_value status)" == SPEC_CLARIFICATION_REQUIRED ]] ||
	die 'the current specification review does not require clarification'

review_artifact()
{
	local relative="$1" label="$2" path
	[[ -n "$relative" && "$relative" != /* ]] || die "invalid $label path in specification review state: $relative"
	path="$(realpath -m "$REPOSITORY/$relative")"
	case "$path" in
		"$REPOSITORY"/*) ;;
		*) die "$label path escapes the repository: $relative" ;;
	esac
	[[ -f "$path" ]] || die "$label file is missing: $path"
	printf '%s\n' "$path"
}

report_relative="$(specification_review_state_value report)"
issues_relative="$(specification_review_state_value issues)"
report="$(review_artifact "$report_relative" 'clarification report')"
issues="$(review_artifact "$issues_relative" 'structured clarification issues')"
specification_path="$(realpath -m "$SPECIFICATION")"
case "$specification_path" in
	"$REPOSITORY"/*) ;;
	*) die "specification is outside the repository and cannot be committed there: $specification_path" ;;
esac
specification_relative="$(realpath --relative-to="$REPOSITORY" "$specification_path")"

printf '# Specification Author Action Required\n\n'
printf 'You are the author responsible for resolving a pre-implementation specification clarification. '
printf 'Do not begin implementation coding until the specification is accepted.\n\n'
printf 'Project: %s\n' "$PROJECT"
printf 'Repository: %s\n' "$REPOSITORY"
printf 'Governing specification: %s\n' "$specification_path"
printf 'Clarification report: %s\n' "$report"
printf 'Structured issues: %s\n' "$issues"
printf 'Environment file: %s\n\n' "$HARNESS_ENV_FILE"

printf '## Problem description\n\n'
awk 'NR == 1 && /^# / {next} {print}' "$report"
printf '\n## Blocking or unclear issues\n\n'
issue_rows=0
while IFS=$'\t' read -r issue_id issue_class requirement_ids source_locations \
	outcome_a outcome_b evidence_checked missing_decision minimal_question; do
	[[ "$issue_id" != issue_id ]] || continue
	[[ -n "$issue_id" ]] || continue
	issue_rows=$((issue_rows + 1))
	printf '### %s — %s\n\n' "$issue_id" "$issue_class"
	printf 'Affected requirements: %s\n\n' "$requirement_ids"
	printf 'Governing locations: %s\n\n' "$source_locations"
	printf 'Incompatible outcome A: %s\n\n' "$outcome_a"
	printf 'Incompatible outcome B: %s\n\n' "$outcome_b"
	printf 'Evidence already checked: %s\n\n' "$evidence_checked"
	printf 'Missing authoritative decision: %s\n\n' "$missing_decision"
	printf 'Question you must answer: %s\n\n' "$minimal_question"
done < "$issues"
(( issue_rows > 0 )) || die 'clarification status has no structured issue rows'

printf '## Required specification amendment\n\n'
printf '1. Read the governing specification, the report, every structured issue above, and the cited repository evidence.\n'
printf '2. For every issue, choose one authoritative observable outcome. Do not leave alternatives, placeholders, or an unresolved open question.\n'
printf '3. Amend %s directly. Apply each decision consistently to requirements, scope/frozen-path rules, acceptance tests, exact commands and expected outputs, matrices, dependency records, and any machine-readable registry embedded in the specification.\n' "$specification_path"
printf '4. Increment the specification version and revision history. Preserve unrelated requirements and compatibility promises.\n'
printf '5. Do not edit the generated clarification report or TSV files as a substitute for fixing the governing specification. Do not weaken acceptance merely to make implementation easier.\n'
printf '6. Inspect the resulting diff and confirm that every issue ID above is resolved by explicit normative text.\n\n'

printf '## Commit and clean-worktree requirement\n\n'
printf 'Commit the amended specification in the repository. Stage only intended specification sources and related authored documentation; do not stage generated binaries, object files, caches, or unrelated work.\n\n'
printf 'Suggested command sequence (adjust the commit message if appropriate):\n\n```bash\n'
printf 'git -C %q diff -- %q\n' "$REPOSITORY" "$specification_relative"
printf 'git -C %q add -- %q\n' "$REPOSITORY" "$specification_relative"
printf 'git -C %q commit -m %q\n' "$REPOSITORY" "resolve $PROJECT specification clarification"
printf 'git -C %q status --short\n' "$REPOSITORY"
printf '```\n\n'
printf 'Before relaunching, `git status --short` must produce no staged, unstaged, or non-ignored untracked entries other than recognized harness-generated review artifacts. Preserve generated `spec-review/` audit files; `harness-start` registers those exact generated paths in the repository-local Git exclude file. Do not broadly ignore the entire directory.\n\n'

printf '## Relaunch and verify\n\n'
printf 'After the commit and clean-worktree check, schedule the potentially long review/decomposition/bootstrap sequence in the background:\n\n```bash\n'
printf '%q --background %q\n' "$HARNESS_BIN/harness-start" "$HARNESS_ENV_FILE"
printf '```\n\n'
printf 'Record the PID, log, and status paths printed by that command, report them to the operator, and then terminate your agent turn. Do not wait for the detached startup to finish. The operator will monitor it with `harness-watch-many`.\n\n'
printf 'If the command emits another `SPEC_CLARIFICATION_REQUIRED`, do not start implementation. Run:\n\n```bash\n'
printf '%q %q\n' "$HARNESS_BIN/harness-show-clarification-request" "$HARNESS_ENV_FILE"
printf '```\n\n'
printf 'Resolve the newly reported issue, commit the amendment, restore a clean worktree, and relaunch again. Completion of this assignment means the specification amendment is committed cleanly and the detached `harness-start` has been scheduled; the operator owns subsequent monitoring.\n'
