#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE TASK_ROOT RESOLUTION_NOTE_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 3 ]] || usage
load_harness_env "$1"
root="$2"
note_file="$3"
ensure_project
validate_task_id "$root"
[[ "$(task_root_id "$root")" == "$root" ]] || die 'TASK_ROOT must not be a revision ID'
[[ -s "$note_file" ]] || die "architecture resolution note is missing or empty: $note_file"
acquire_project_lock

marker="$(task_root_architecture_reassessment_file "$root")"
[[ -f "$marker" ]] || die "root does not require architecture reassessment: $root"
trigger_task="$(metadata_value "$marker" Triggered-By)"
[[ -n "$trigger_task" ]] || trigger_task="$root"
category="$(metadata_value "$marker" Category)"
pending_replan_trigger="$(metadata_value "$marker" Pending-Replan-Trigger)"
pending_replan_task="$(metadata_value "$marker" Pending-Replan-Triggered-By)"
pending_replan_blocker_class="$(metadata_value "$marker" Pending-Replan-Blocker-Class)"
pending_replan_remediation_scope="$(metadata_value "$marker" Pending-Replan-Remediation-Scope)"
pending_replan_context_paths="$(metadata_value "$marker" Pending-Replan-Context-Paths)"
pending_replan_closure_condition="$(metadata_value "$marker" Pending-Replan-Closure-Condition)"
pending_replan_closure_action="$(metadata_value "$marker" Pending-Replan-Closure-Repair-Action)"
pending_replan_closure_provider="$(metadata_value "$marker" Pending-Replan-Closure-Repair-Provider)"
additional_scope="$(metadata_value "$note_file" Authorized-Additional-Scope)"
prior_additional_scope=""
effective_additional_scope="$additional_scope"
scope_override="$(task_root_architecture_scope_override_file "$root")"
if [[ -f "$scope_override" &&
	"$(kv_file_value "$scope_override" authorized_for 2>/dev/null || true)" == manager_remediation ]]; then
	prior_additional_scope="$(kv_file_value "$scope_override" additional_scope 2>/dev/null || true)"
fi
resolution_action="$(metadata_value "$note_file" Resolution-Action)"
harness_fix_commit="$(metadata_value "$note_file" Harness-Fix-Commit)"
pending_replan_inferred=0
mutation_region_reclassified=0
# Releases before 5.18.3 checked the aggregate root budget before recording a
# more specific manager-remediation circuit. Recover the typed continuation
# from immutable rejected artifacts, but only during the explicit harness-bug
# resolution of those generic liveness incidents.
if [[ "$resolution_action" == REARM_AFTER_HARNESS_BUG && -z "$pending_replan_trigger" &&
	"$category" =~ ^(NO_CRITERION_PROGRESS|TOTAL_ROOT_REVIEWS|TOTAL_ROOT_REPLANS|ROOT_LIFETIME|ROOT_TOKENS)$ ]]; then
	trigger_base="$(task_base "$trigger_task")"
	trigger_assignment="$(project_dir)/archive/$trigger_base.assignment.md"
	trigger_result="$(project_dir)/archive/$trigger_base.rejected-result.md"
	if [[ -f "$trigger_assignment" && -f "$trigger_result" ]] &&
		assignment_is_manager_remediation "$trigger_assignment" &&
		[[ "$(metadata_value "$trigger_result" Goal-Outcome)" == NEEDS_DECOMPOSITION ]]; then
		trigger_decomposition_reason="$(metadata_value "$trigger_result" Decomposition-Reason)"
		case "$trigger_decomposition_reason" in
			CONTEXT_INCOMPLETE)
				pending_replan_trigger=MANAGER_REMEDIATION_CONTEXT_INCOMPLETE
				pending_replan_context_paths="$(metadata_value "$trigger_assignment" Context-Paths)"
				;;
			SCOPE_INCOMPLETE|VALIDATION_PREREQUISITE)
				pending_replan_trigger=MANAGER_REMEDIATION_SCOPE_EXHAUSTED
				;;
		esac
		if [[ -n "$pending_replan_trigger" ]]; then
			pending_replan_task="$trigger_task"
			pending_replan_blocker_class="$(metadata_value "$trigger_assignment" Blocker-Class)"
			pending_replan_remediation_scope="$(metadata_value "$trigger_assignment" Remediation-Scope)"
			[[ -n "$pending_replan_remediation_scope" ]] ||
				die 'cannot recover the pre-5.18.3 manager-remediation transition: rejected assignment has no Remediation-Scope'
			if [[ "$pending_replan_trigger" == MANAGER_REMEDIATION_CONTEXT_INCOMPLETE &&
				-z "$pending_replan_context_paths" ]]; then
				die 'cannot recover the pre-5.18.3 context transition: rejected assignment has no Context-Paths'
			fi
			pending_replan_inferred=1
		fi
	fi
fi
case "$category" in
	NO_CRITERION_PROGRESS|TOTAL_ROOT_REVIEWS|TOTAL_ROOT_REPLANS|ROOT_LIFETIME|ROOT_TOKENS)
		if [[ "$resolution_action" != REARM_AFTER_HARNESS_BUG ]] &&
			liveness_reason="$(root_liveness_violation_reason "$root" 2>/dev/null)"; then
			die "root remains beyond its lifetime acceptance-boundary budget: $liveness_reason; incident resolution cannot reset unchanged liveness—replace the acceptance boundary, apply a direct operator correction, or explicitly raise the governing limit"
		fi
		;;
esac
if [[ -n "$resolution_action" ]]; then
	case "$resolution_action" in
		VERIFY_PRESERVED_WORKSPACE)
			[[ "$category" == REPEATED_RESOURCE_DECOMPOSITION_FAILURE ]] ||
				die 'VERIFY_PRESERVED_WORKSPACE is valid only for repeated resource-decomposition reassessment'
			;;
		REARM_AFTER_HARNESS_BUG)
			[[ "$category" =~ ^(NO_CRITERION_PROGRESS|TOTAL_ROOT_REVIEWS|TOTAL_ROOT_REPLANS|ROOT_LIFETIME|ROOT_TOKENS)$ ]] ||
				die 'REARM_AFTER_HARNESS_BUG is valid only after a liveness investigation fuse'
			[[ "$harness_fix_commit" =~ ^[0-9a-f]{7,64}$ ]] ||
				die 'REARM_AFTER_HARNESS_BUG requires Harness-Fix-Commit'
			git -C "$HARNESS_HOME" cat-file -e "$harness_fix_commit^{commit}" 2>/dev/null ||
				die "Harness-Fix-Commit is not installed in the harness repository: $harness_fix_commit"
			git -C "$HARNESS_HOME" merge-base --is-ancestor "$harness_fix_commit" HEAD ||
				die "Harness-Fix-Commit is not an ancestor of the deployed harness HEAD: $harness_fix_commit"
			epoch="$(task_root_liveness_epoch_file "$root")"
			if [[ -f "$epoch" && "$(kv_file_value "$epoch" fix_commit 2>/dev/null || true)" == "$harness_fix_commit" ]]; then
				die "the same harness fix commit already rearmed this root: $harness_fix_commit"
			fi
			;;
		REARM_EFFICIENCY_AFTER_HARNESS_BUG)
			[[ "$category" == TOKENS_WITHOUT_VERIFIED_GAIN ]] ||
				die 'REARM_EFFICIENCY_AFTER_HARNESS_BUG is valid only after a tokens-without-verified-gain investigation fuse'
			[[ "$harness_fix_commit" =~ ^[0-9a-f]{7,64}$ ]] ||
				die 'REARM_EFFICIENCY_AFTER_HARNESS_BUG requires Harness-Fix-Commit'
			git -C "$HARNESS_HOME" cat-file -e "$harness_fix_commit^{commit}" 2>/dev/null ||
				die "Harness-Fix-Commit is not installed in the harness repository: $harness_fix_commit"
			git -C "$HARNESS_HOME" merge-base --is-ancestor "$harness_fix_commit" HEAD ||
				die "Harness-Fix-Commit is not an ancestor of the deployed harness HEAD: $harness_fix_commit"
			efficiency_baseline="$(task_root_efficiency_baseline_file "$root")"
			if [[ -f "$efficiency_baseline" &&
				"$(kv_file_value "$efficiency_baseline" harness_fix_commit 2>/dev/null || true)" == "$harness_fix_commit" ]]; then
				die "the same harness fix commit already rearmed this efficiency boundary: $harness_fix_commit"
			fi
			;;
		RECLASSIFY_MUTATION_REGION_CONTEXT)
			[[ "$category" == MANAGER_PUBLICATION_CONTRACT_EXHAUSTED &&
				"$pending_replan_trigger" == MANAGER_REMEDIATION_SCOPE_EXHAUSTED ]] ||
				die 'RECLASSIFY_MUTATION_REGION_CONTEXT is valid only for an exhausted manager-remediation scope transition'
			[[ "$harness_fix_commit" =~ ^[0-9a-f]{7,64}$ ]] ||
				die 'RECLASSIFY_MUTATION_REGION_CONTEXT requires Harness-Fix-Commit'
			git -C "$HARNESS_HOME" cat-file -e "$harness_fix_commit^{commit}" 2>/dev/null ||
				die "Harness-Fix-Commit is not installed in the harness repository: $harness_fix_commit"
			git -C "$HARNESS_HOME" merge-base --is-ancestor "$harness_fix_commit" HEAD ||
				die "Harness-Fix-Commit is not an ancestor of the deployed harness HEAD: $harness_fix_commit"
			mutation_task="${pending_replan_task:-$trigger_task}"
			mutation_assignment="$(project_dir)/archive/$(task_base "$mutation_task").assignment.md"
			mutation_result="$(project_dir)/archive/$(task_base "$mutation_task").rejected-result.md"
			[[ -f "$mutation_assignment" && -f "$mutation_result" ]] ||
				die 'Mutation-Region reclassification requires archived assignment and rejected result evidence'
			[[ "$(metadata_value "$mutation_result" ACP-Request-Type)" == SCOPE &&
				"$(metadata_value "$mutation_result" ACP-Request-Kind)" == MUTATION_REGION ]] ||
				die 'Mutation-Region reclassification requires an archived SCOPE/MUTATION_REGION ACP request'
			mutation_identifier="$(metadata_value "$mutation_result" ACP-Request-Identifier)"
			[[ "$mutation_identifier" =~ ^(.+):([1-9][0-9]*)$ ]] ||
				die 'Mutation-Region reclassification requires a repository-relative path:line identifier'
			mutation_path="${BASH_REMATCH[1]}"
			[[ "$mutation_path" != /* &&
				"$(metadata_value "$mutation_assignment" Manager-Remediation)" == 1 ]] ||
				die 'Mutation-Region reclassification requires an in-scope manager-remediation assignment'
			mutation_scope="$(metadata_value "$mutation_assignment" Allowed-Scope)"
			scope_is_within_root_authority "$mutation_path" "$mutation_scope" ||
				die 'Mutation-Region request lies outside the archived Allowed-Scope and cannot be reclassified as context'
			pending_replan_trigger=MANAGER_REMEDIATION_CONTEXT_INCOMPLETE
			pending_replan_task="$mutation_task"
			pending_replan_blocker_class="$(metadata_value "$mutation_assignment" Blocker-Class)"
			pending_replan_remediation_scope="$(metadata_value "$mutation_assignment" Remediation-Scope)"
			pending_replan_context_paths="$(metadata_value "$mutation_assignment" Context-Paths)"
			[[ -n "$pending_replan_remediation_scope" && -n "$pending_replan_context_paths" ]] ||
				die 'Mutation-Region reclassification requires preserved remediation scope and Context-Paths'
			mutation_region_reclassified=1
			;;
		*) die "unsupported architecture Resolution-Action: $resolution_action" ;;
	esac
fi
if [[ -n "$additional_scope" ]]; then
	[[ "$category" == MANAGER_REMEDIATION_SCOPE_EXPANSION ]] ||
		die 'Authorized-Additional-Scope is valid only for a manager-remediation scope reassessment'
	[[ "$additional_scope" != / && "$additional_scope" != . && "$additional_scope" != *'*'* &&
		"$additional_scope" != *$'\t'* ]] ||
		die 'Authorized-Additional-Scope must contain bounded repository-relative paths'
	IFS=',' read -r -a additional_entries <<< "${additional_scope//;/,}"
	(( ${#additional_entries[@]} > 0 && ${#additional_entries[@]} <= 4 )) ||
		die 'Authorized-Additional-Scope may name one through four bounded paths'
	for additional_entry in "${additional_entries[@]}"; do
		additional_entry="$(trim_surrounding_whitespace "$additional_entry")"
		[[ -n "$additional_entry" && "$additional_entry" != /* && "$additional_entry" != ../* &&
			"$additional_entry" != */../* ]] ||
			die "invalid Authorized-Additional-Scope path: $additional_entry"
	done
	effective_additional_scope="$(
		printf '%s\n%s\n' "$prior_additional_scope" "$additional_scope" |
			tr ',;' '\n' |
			sed 's/^[[:space:]]*//;s/[[:space:]]*$//;/^$/d;/^-$/d' |
			sort -u | paste -sd, -
	)"
	IFS=',' read -r -a effective_additional_entries <<< "$effective_additional_scope"
	(( ${#effective_additional_entries[@]} <= 4 )) ||
		die 'cumulative Authorized-Additional-Scope may name at most four bounded paths'
fi
archive_dir="$(project_dir)/archive/architecture-reassessments"
mkdir -p "$archive_dir"
chmod 700 "$archive_dir"
stamp="$(timestamp_compact_utc)"
archive="$archive_dir/$PROJECT-task-$root.$stamp.resolved.md"
{
	cat "$marker"
	if (( pending_replan_inferred == 1 )); then
		printf '\n## Recovered typed transition\n\n'
		printf 'Inferred-Pending-Replan-Trigger: %s\n' "$pending_replan_trigger"
		printf 'Inferred-Pending-Replan-Triggered-By: %s\n' "$pending_replan_task"
		printf 'Inferred-Pending-Replan-Remediation-Scope: %s\n' "$pending_replan_remediation_scope"
		printf 'Inference-Evidence: %s %s\n' "$trigger_assignment" "$trigger_result"
	fi
	printf '\n## Explicit resolution\n\n'
	cat "$note_file"
	printf '\n\nResolved-At: %s\n' "$(timestamp_utc)"
} > "$archive.tmp.$$"
chmod 600 "$archive.tmp.$$"
mv "$archive.tmp.$$" "$archive"

if [[ -n "$additional_scope" ]]; then
	{
		printf 'additional_scope=%s\n' "$effective_additional_scope"
		printf 'authorized_for=manager_remediation\n'
		printf 'resolution_archive=%s\n' "$archive"
		printf 'authorized_at=%s\n' "$(timestamp_utc)"
	} > "$scope_override.tmp.$$"
	chmod 600 "$scope_override.tmp.$$"
	mv "$scope_override.tmp.$$" "$scope_override"
fi

if [[ -d "$(plan_dependency_invalidation_dir)" ]]; then
	invalid_archive="$archive_dir/plan-invalidations"
	mkdir -p "$invalid_archive"
	chmod 700 "$invalid_archive"
	while IFS= read -r invalidation; do
		[[ -f "$invalidation" ]] || continue
		[[ "$(metadata_value "$invalidation" Consumer-Root)" == "$root" ]] || continue
		mv "$invalidation" "$invalid_archive/${invalidation##*/}.$stamp.resolved"
	done < <(find "$(plan_dependency_invalidation_dir)" -maxdepth 1 -type f -name '*.invalidated.md' -print)
fi
if [[ "$resolution_action" == REARM_AFTER_HARNESS_BUG ]]; then
	record_root_liveness_epoch "$root" harness-bug-correction "$harness_fix_commit"
	if liveness_reason="$(root_liveness_violation_reason "$root" 2>/dev/null)"; then
		die "harness-bug correction failed to establish a fresh bounded liveness epoch: $liveness_reason"
	fi
elif [[ "$resolution_action" == REARM_EFFICIENCY_AFTER_HARNESS_BUG ]]; then
	# The anomaly ledger and raw token history remain append-only. Reset only the
	# verified-facet comparison boundary after an installed fix; do not buy a new
	# review/replan/lifetime/token liveness epoch.
	record_root_verified_facet_boundary "$root"
	goal_state_set "$(task_root_efficiency_baseline_file "$root")" harness_fix_commit "$harness_fix_commit"
fi
rm -f "$marker"

# Resolving a paused active root must never expose a transient project-planning
# gap. If no task/result transaction remains, restore NEEDS_REPLAN under the
# same project lock before supervisors can observe the cleared architecture
# marker. A still-live result is left for its normal manager review.
root_has_live_artifact=0
shopt -s nullglob
for artifact in "$(project_dir)/tasks/$PROJECT-task-"*.ready.md \
	"$(project_dir)/running/$PROJECT-task-"*.running.md \
	"$(project_dir)/results/$PROJECT-task-"*.result.md; do
	[[ -f "$artifact" ]] || continue
	artifact_task="$(task_id_from_filename "$artifact")"
	if [[ "$(task_root_id "$artifact_task")" == "$root" ]]; then
		root_has_live_artifact=1
		break
	fi
done
shopt -u nullglob
plan_item="$(project_plan_item_for_root "$root")"
replan_restored=0
if [[ -n "$plan_item" && "$(project_plan_item_status "$plan_item")" == ACTIVE ]] &&
	(( root_has_live_artifact == 0 )); then
	# An explicit scope-expansion decision supersedes the transition that asked
	# for that decision.  Preserving MANAGER_REMEDIATION_SCOPE_EXHAUSTED first
	# made both outcomes ineffective: an authorization retried the old scope,
	# while a denial immediately demanded the denied adjacent path again.
	if [[ "$category" == MANAGER_REMEDIATION_SCOPE_EXPANSION && -n "$additional_scope" ]]; then
		mark_root_needs_replan "$trigger_task" \
			"architecture reassessment explicitly authorized one bounded local prerequisite; continue with manager remediation" \
			MANAGER_REMEDIATION_CONTINUATION LOCAL_CODE_PREREQUISITE "$additional_scope" >/dev/null
	elif [[ "$category" == MANAGER_REMEDIATION_SCOPE_EXPANSION ]]; then
		mark_root_needs_replan "$trigger_task" \
			"architecture reassessment denied scope expansion; discard the forcing exhausted-scope transition, preserve immutable root scope, and continue the focused first-unmet boundary" \
			ARCHITECTURE_REASSESSMENT_RESOLVED >/dev/null
	elif [[ "$pending_replan_trigger" == CONTEXT_CLOSURE_REPAIR ]]; then
		[[ -n "$pending_replan_closure_condition" && -n "$pending_replan_closure_action" &&
			-n "$pending_replan_closure_provider" ]] ||
			die 'preserved Context Closure transition is missing its typed condition, action, or provider'
		mark_root_needs_replan "${pending_replan_task:-$trigger_task}" \
			"architecture liveness reassessment was explicitly resolved; preserve the compiled Context Closure repair transaction" \
			CONTEXT_CLOSURE_REPAIR "" "" "" \
			"$pending_replan_closure_condition" "$pending_replan_closure_action" \
			"$pending_replan_closure_provider" >/dev/null
	elif [[ "$pending_replan_trigger" == LUNA_ONLY_POLICY_MIGRATION ]]; then
		mark_root_needs_replan "${pending_replan_task:-$trigger_task}" \
			"architecture liveness reassessment was explicitly resolved; preserve mandatory Luna-only decomposition of the retired legacy boundary" \
			LUNA_ONLY_POLICY_MIGRATION >/dev/null
	elif [[ "$pending_replan_trigger" == MANAGER_REMEDIATION_SCOPE_EXHAUSTED ]]; then
		[[ -n "$pending_replan_remediation_scope" ]] ||
			die 'preserved exhausted remediation transition is missing its path set'
		mark_root_needs_replan "${pending_replan_task:-$trigger_task}" \
			"architecture liveness reassessment was explicitly resolved; preserve the pending exhausted-scope transition and continue at the adjacent producer, representation, consumer, or validation seam" \
			MANAGER_REMEDIATION_SCOPE_EXHAUSTED \
			"${pending_replan_blocker_class:-LOCAL_SCOPE_PREREQUISITE}" \
			"$pending_replan_remediation_scope" >/dev/null
	elif [[ "$pending_replan_trigger" == MANAGER_REMEDIATION_CONTEXT_INCOMPLETE ]]; then
		[[ -n "$pending_replan_remediation_scope" && -n "$pending_replan_context_paths" ]] ||
			die 'preserved context-incomplete remediation transition is missing scope or context paths'
		mark_root_needs_replan "${pending_replan_task:-$trigger_task}" \
			"architecture liveness reassessment was explicitly resolved; preserve the pending context-capsule correction without expanding mutation authority" \
			MANAGER_REMEDIATION_CONTEXT_INCOMPLETE \
			"${pending_replan_blocker_class:-LOCAL_SCOPE_PREREQUISITE}" \
			"$pending_replan_remediation_scope" "$pending_replan_context_paths" >/dev/null
	elif [[ "$category" == REPEATED_RESOURCE_DECOMPOSITION_FAILURE ]]; then
		if [[ "$resolution_action" == VERIFY_PRESERVED_WORKSPACE ]]; then
			mark_root_needs_replan "$trigger_task" \
				"operator inspection confirmed preserved workspace movement before the resource fuse; verify that exact change before authorizing more implementation" \
				RESOURCE_PROGRESS_NEEDS_VERIFICATION >/dev/null
		else
			# Operator review authorizes continuation, but it does not invalidate the
			# measured fact that the current executable leaf exceeded its resource
			# envelope. Preserve that typed trigger so recovery must split the leaf
			# whenever append-only depth/child capacity remains.
			mark_root_needs_replan "$trigger_task" \
				"resource decomposition failure was explicitly reviewed; preserve work and split the first-unmet leaf when structural capacity remains" \
				RESOURCE_NEEDS_DECOMPOSITION >/dev/null
		fi
	else
		mark_root_needs_replan "$trigger_task" \
			"architecture reassessment was explicitly resolved; continue the preserved first-unmet boundary" \
			ARCHITECTURE_REASSESSMENT_RESOLVED >/dev/null
	fi
	replan_restored=1
fi
log_event "ARCHITECTURE_REASSESSMENT_RESOLVED root=$root resolution=$archive replan_restored=$replan_restored live_artifact=$root_has_live_artifact pending_inferred=$pending_replan_inferred mutation_region_reclassified=$mutation_region_reclassified additional_scope=$(printf '%q' "${effective_additional_scope:--}")"
printf '%s\n' "$archive"
