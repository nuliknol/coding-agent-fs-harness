#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
interval=300
render_once=0

usage()
{
	cat <<EOF
Usage: harness-watch-many [-n SECONDS] DIRECTORY
       harness-watch-many --once DIRECTORY

Watch every Full or Light harness environment with a non-empty SPECIFICATION.
EOF
}

while (( $# > 0 )); do
	case "$1" in
		-n|--interval)
			[[ $# -ge 2 ]] || { usage >&2; exit 2; }
			interval="$2"; shift 2
			;;
		--once) render_once=1; shift ;;
		-h|--help) usage; exit 0 ;;
		--) shift; break ;;
		-*) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
		*) break ;;
	esac
done
[[ $# -eq 1 ]] || { usage >&2; exit 2; }
[[ "$interval" =~ ^[0-9]+([.][0-9]+)?$ ]] || { printf 'Invalid refresh interval: %s\n' "$interval" >&2; exit 2; }
awk -v value="$interval" 'BEGIN {exit !(value > 0)}' || { printf 'Refresh interval must be greater than zero.\n' >&2; exit 2; }
[[ -d "$1" ]] || { printf 'Harness environment directory does not exist: %s\n' "$1" >&2; exit 1; }
config_dir="$(realpath "$1")"

if (( ! render_once )); then
	command -v watch >/dev/null 2>&1 || { printf 'The watch command is required.\n' >&2; exit 1; }
	if [[ "${HARNESS_WATCH_COLOR:-auto}" != never &&
		( "${HARNESS_WATCH_COLOR:-auto}" == always || -z "${NO_COLOR:-}" ) ]] &&
		watch --help 2>&1 | grep -q -- '--color'; then
		exec watch --color --interval "$interval" --exec env HARNESS_WATCH_COLOR=always \
			"${HARNESS_WATCH_ENTRYPOINT:-$SCRIPT_DIR/harness-watch-many}" --once "$config_dir"
	fi
	exec watch --interval "$interval" --exec env HARNESS_WATCH_COLOR=never \
		"${HARNESS_WATCH_ENTRYPOINT:-$SCRIPT_DIR/harness-watch-many}" --once "$config_dir"
fi

color_status=0
case "${HARNESS_WATCH_COLOR:-auto}" in
	always) color_status=1 ;;
	never) ;;
	auto|'') [[ -t 1 && "${TERM:-dumb}" != dumb && -z "${NO_COLOR:-}" ]] && color_status=1 ;;
	*) printf 'Invalid HARNESS_WATCH_COLOR: %s (expected auto, always, or never)\n' "$HARNESS_WATCH_COLOR" >&2; exit 2 ;;
esac

terminal_columns()
{
	local size columns
	if [[ -r /dev/tty ]]; then
		size="$( (stty size < /dev/tty) 2>/dev/null || true)"; columns="${size##* }"
		[[ "$columns" =~ ^[1-9][0-9]*$ ]] && { printf '%s\n' "$columns"; return; }
	fi
	[[ "${COLUMNS:-}" =~ ^[1-9][0-9]*$ ]] && { printf '%s\n' "$COLUMNS"; return; }
	columns="$(tput cols 2>/dev/null || true)"
	[[ "$columns" =~ ^[1-9][0-9]*$ ]] || columns=120
	printf '%s\n' "$columns"
}

terminal_lines()
{
	local size lines
	if [[ -r /dev/tty ]]; then
		size="$( (stty size < /dev/tty) 2>/dev/null || true)"; lines="${size%% *}"
		[[ "$lines" =~ ^[1-9][0-9]*$ ]] && { printf '%s\n' "$lines"; return; }
	fi
	[[ "${LINES:-}" =~ ^[1-9][0-9]*$ ]] && { printf '%s\n' "$LINES"; return; }
	lines="$(tput lines 2>/dev/null || true)"
	[[ "$lines" =~ ^[1-9][0-9]*$ ]] || lines=40
	printf '%s\n' "$lines"
}

human_duration()
{
	local seconds="$1"
	(( seconds >= 0 )) || seconds=0
	if (( seconds < 60 )); then printf '%ss' "$seconds"
	elif (( seconds < 3600 )); then printf '%sm' "$((seconds / 60))"
	else printf '%sh %sm' "$((seconds / 3600))" "$(((seconds % 3600) / 60))"
	fi
}

markdown_summary()
{
	local file="$1"
	[[ -s "$file" ]] || return 0
	awk '
		/^#[[:space:]]/ {next}
		/^[[:space:]]*$/ {if (started) exit; next}
		{started=1; gsub(/`/, "", $0); printf "%s%s", separator, $0; separator=" "}
		END {if (started) printf "\n"}
	' "$file"
}

latest_trace_action()
{
	local file="$1"
	[[ -s "$file" ]] || return 0
	tail -n 120 "$file" 2>/dev/null | jq -rs '
		def clean: gsub("[\\r\\n\\t ]+"; " ") | sub("^ "; "") | sub(" $"; "");
		[.[] | select(.type == "item.started" or .type == "item.completed")] | last // empty |
		if .item.type == "command_execution" then
			(if .type == "item.started" then "Running command: " else "Last command finished: " end) + (.item.command | clean)
		elif .item.type == "file_change" then "Editing: " + ([.item.changes[]?.path] | join(", ") | clean)
		elif .item.type == "agent_message" then "Latest agent report: " + (.item.text | clean)
		else empty end
	' 2>/dev/null | cut -c1-1600
}

probe_env()
{
	local env_file="$1"
	bash -c '
		set -Eeuo pipefail
		unset PROJECT SPECIFICATION HARNESS_MODE harness_mode DEVELOPMENT_POLICY
		{ source "$1"; } >/dev/null
		mode="${HARNESS_MODE:-${harness_mode:-}}"
		if [[ -z "$mode" ]]; then
			[[ -z "${DEVELOPMENT_POLICY:-}" ]] && mode=full || mode=light
		fi
		printf "WATCH_PROBE|%s|%s|%s|%s\n" \
			"${PROJECT:-}" "${SPECIFICATION:-}" "$mode" "${HARNESS_BIN:-}"
	' _ "$env_file" 2>/dev/null
}

full_plan_count()
{
	local file="$1" wanted="${2:-}"
	[[ -f "$file" ]] || { printf '0\n'; return 0; }
	awk -F '\t' -v wanted="$wanted" '$0 !~ /^#/ && NF >= 4 && (wanted == "" || $2 == wanted) {n++} END {print n+0}' "$file" 2>/dev/null
}

full_active_file()
{
	local dir="$1" project="$2" subdir suffix file
	for entry in 'results:result.md' 'running:running.md' 'tasks:ready.md'; do
		subdir="${entry%%:*}"; suffix="${entry#*:}"
		file="$(find "$dir/$subdir" -maxdepth 1 -type f -name "$project-task-*.$suffix" \
			-printf '%T@\t%p\n' 2>/dev/null | sort -nr | awk -F '\t' 'NR == 1 {first=$2} END {print first}')"
		[[ -z "$file" ]] || { printf '%s\n' "$file"; return; }
	done
}

latest_trace()
{
	local dir="$1"
	find "$dir/logs" -maxdepth 1 -type f -name '*.jsonl' -printf '%T@\t%p\n' 2>/dev/null |
		sort -nr | awk -F '\t' 'NR == 1 {first=$2} END {print first}'
}

wrap_description() { printf '%s\n' "$1" | fold -s -w "$2"; }

status_requires_attention()
{
	case "$1" in
		paused|waiting|failed|dead-end|clarify|redesign|'config err'|'config error'|uninit|unknown) return 0 ;;
		*) return 1 ;;
	esac
}

print_row_line()
{
	local status="$1" line="$2" status_offset visible_status
	status_offset=$((project_width + cycle_width + 4))
	visible_status="${status:0:status_width}"
	if (( color_status )) && status_requires_attention "$status" &&
		[[ "${line:status_offset:${#visible_status}}" == "$visible_status" ]]; then
		printf '%s\033[31m%s\033[0m%s\n' \
			"${line:0:status_offset}" "$visible_status" "${line:status_offset+${#visible_status}}}"
	else
		printf '%s\n' "$line"
	fi
}

print_row()
{
	local project="$1" cycle="$2" status="$3" completion="$4" description="$5"
	local line last line_count index rendered
	local -a descriptions=() completions=()
	mapfile -t descriptions < <(wrap_description "$description" "$description_width")
	mapfile -t completions <<< "$completion"
	(( ${#descriptions[@]} > 0 )) || descriptions=('')
	(( ${#completions[@]} > 0 )) || completions=('')
	if (( ${#descriptions[@]} > row_line_limit )); then
		descriptions=("${descriptions[@]:0:row_line_limit}")
		last=$((${#descriptions[@]} - 1)); line="${descriptions[$last]}"
		(( ${#line} <= description_width - 3 )) || line="${line:0:description_width-3}"
		descriptions[$last]="${line% }..."
	fi
	line_count=${#descriptions[@]}; (( ${#completions[@]} <= line_count )) || line_count=${#completions[@]}
	for ((index=0; index<line_count; index++)); do
		if (( index == 0 )); then
			printf -v rendered '%-*.*s |%*.*s| %-*.*s | %-*.*s | %s' \
				"$project_width" "$project_width" "$project" "$cycle_width" "$cycle_width" "$cycle" \
				"$status_width" "$status_width" "$status" "$completion_width" "$completion_width" "${completions[$index]:-}" "${descriptions[$index]:-}"
		else
			printf -v rendered '%*s |%*s| %*s | %*s | %s' "$project_width" '' "$cycle_width" '' \
				"$status_width" '' "$completion_width" "${completions[$index]:-}" "${descriptions[$index]:-}"
		fi
		print_row_line "$status" "$rendered"
	done
}

columns="$(terminal_columns)"; screen_lines="$(terminal_lines)"; (( columns >= 72 )) || columns=72
project_width=7; eligible_count=0
while IFS= read -r -d '' env_file; do
	owner="$(stat -c %u "$env_file")"; permission=$((8#$(stat -c %a "$env_file")))
	(( (owner == UID || owner == 0) && (permission & 8#022) == 0 )) || continue
	probe="$(probe_env "$env_file" || true)"; probe="$(awk -F '|' '$1=="WATCH_PROBE" {print; exit}' <<< "$probe")"
	[[ -n "$probe" ]] || continue
	IFS='|' read -r _ project specification selected_mode probe_bin <<< "$probe"
	[[ -n "$specification" ]] || continue
	((eligible_count+=1)); (( ${#project} <= project_width )) || project_width=${#project}
done < <(find "$config_dir" -maxdepth 1 -type f -name '*.env' -print0 | sort -z)

cycle_width=3; status_width=9; completion_width=10
description_width=$((columns - project_width - cycle_width - status_width - completion_width - 10)); (( description_width >= 1 )) || description_width=1
(( eligible_count > 0 )) || eligible_count=1
row_line_limit=$(((screen_lines - 4) / eligible_count)); (( row_line_limit >= 2 )) || row_line_limit=2; (( row_line_limit <= 3 )) || row_line_limit=3
printf '%-*s |%*s| %-*s | %-*s | %s\n' "$project_width" PROJECT "$cycle_width" CYC "$status_width" STATUS "$completion_width" COMPLETION 'PROGRESS / BLOCKER'
printf '%*s\n' "$columns" '' | tr ' ' '-'

found=0
while IFS= read -r -d '' env_file; do
	owner="$(stat -c %u "$env_file")"; permission=$((8#$(stat -c %a "$env_file")))
	(( (owner == UID || owner == 0) && (permission & 8#022) == 0 )) || continue
	probe="$(probe_env "$env_file" || true)"; probe="$(awk -F '|' '$1=="WATCH_PROBE" {print; exit}' <<< "$probe")"
	[[ -n "$probe" ]] || continue
	IFS='|' read -r _ project specification selected_mode probe_bin <<< "$probe"
	[[ -n "$specification" ]] || continue
	found=1
	status_command="${probe_bin:-$SCRIPT_DIR}/harness-status"
	status_args=("$env_file")
	[[ "$selected_mode" != full ]] || status_args=(--machine "$env_file")
	status_output="$("$status_command" "${status_args[@]}" 2>&1)" || {
		error="$(tail -n 2 <<< "$status_output" | tr '\n' ' ')"
		print_row "${project:-${env_file##*/}}" '-' 'config err' '-' "CONFIGURATION ERROR: ${error:-status unavailable}."
		continue
	}
	if [[ "$selected_mode" == light ]]; then
		state="$(awk -F': ' '$1=="Status" {print $2; exit}' <<< "$status_output")"
		phase="$(awk -F': ' '$1=="Phase" {print $2; exit}' <<< "$status_output")"
		cycle="$(awk -F': ' '$1=="Worker/review cycle" {print $2; exit}' <<< "$status_output")"; [[ "$cycle" =~ ^[0-9]+$ ]] || cycle='-'
		supervisor="$(awk -F': ' '$1=="Supervisor" {print $2; exit}' <<< "$status_output")"
		case "$state" in
			COMPLETE) display_status=done; completion=done; description='' ;;
			PAUSED) display_status=paused; completion=pending; description="Light harness paused in $phase. Inspect its operator report." ;;
			FAILED|DEAD_END) display_status=failed; completion='-'; description="Light harness entered $state in $phase." ;;
			*) role=h; [[ "$phase" == WORKER_* ]] && role=w; [[ "$phase" == REVIEW_* || "$phase" == CONVERGENCE_* || "$phase" == GOAL_* ]] && role=m; [[ "$phase" == ORACLE_* ]] && role=o
				[[ "$supervisor" == running* ]] && display_status="$role/running" || display_status="$role/stopped"
				completion=pending; description="Light harness is active in $phase." ;;
		esac
		print_row "$project" "$cycle" "$display_status" "$completion" "$description"
		continue
	fi
	harness_root="$(awk -F': ' '$1=="Harness root" {print $2; exit}' <<< "$status_output")"
	dir="$harness_root/projects/$project"; plan="$dir/control/project-plan-state.tsv"
	project_progress="$(awk -F': ' '$1=="Project progress" {print $2; exit}' <<< "$status_output")"
	if [[ "$project_progress" =~ ^([0-9]+([.][0-9]+)?)%[[:space:]]+\(([0-9]+)/([0-9]+)[[:space:]] ]]; then
		percent="${BASH_REMATCH[1]}"; complete="${BASH_REMATCH[3]}"; total="${BASH_REMATCH[4]}"
	else
		total="$(full_plan_count "$plan")"; complete="$(full_plan_count "$plan" COMPLETE)"; percent=0
	fi
	if (( total > 0 )); then
		if (( complete > 0 )) && awk -v p="$percent" 'BEGIN {exit !(p == 0)}'; then percent_display='<0.1%'; else percent_display="${percent}%"; fi
		completion="${complete}/${total}"$'\n'"$percent_display"
	else
		completion=$'pending\nplan'
	fi
	cycle="$(find "$dir/archive" -maxdepth 1 -type f \( -name '*.accepted.md' -o -name '*.checkpointed.md' -o -name '*.rejected.md' \) -printf '.\n' 2>/dev/null | wc -l | tr -d ' ')"
	manager="$(awk -F': ' '$1=="Manager supervisor" {print $2; exit}' <<< "$status_output")"; worker="$(awk -F': ' '$1=="Worker supervisor" {print $2; exit}' <<< "$status_output")"
	project_status="$(awk -F': ' '$1=="Project status" {print $2; exit}' <<< "$status_output")"
	active="$(full_active_file "$dir" "$project")"
	waiting_request=""
	if [[ -d "$dir/control/dependencies" ]]; then
		waiting_request="$(find "$dir/control/dependencies" -maxdepth 1 -type f -name '*.waiting.md' -print 2>/dev/null | sort | awk 'NR == 1 {first=$0} END {print first}')"
	fi
	if [[ "$project_status" == SPECIFICATION_IR_INVALID.* ]]; then
		display_status=paused
		description="$project_status"
	elif [[ "$project_status" == SPECIFICATION_NORMALIZATION_STALLED.* ]]; then
		display_status=paused
		description="$project_status"
	elif [[ "$project_status" == SPEC_CLARIFICATION_REQUIRED.* ]]; then
		display_status=clarify
		completion='-'
		review_report="${project_status#*Review }"
		review_report="${review_report%% before DAG registration.*}"
		description="SPEC_CLARIFICATION_REQUIRED: ${review_report:-spec-review report}."
	elif [[ "$project_status" == ARCHITECTURE_REDESIGN_REQUIRED.* ]]; then
		display_status=redesign
		completion='-'
		architecture_report="$(awk -F'[()]' '$1 ~ /^Architecture fit: ARCHITECTURE_REDESIGN_REQUIRED / {print $2; exit}' <<< "$status_output")"
		description="ARCHITECTURE_REDESIGN_REQUIRED: ${architecture_report:-architecture-review report}."
	elif [[ "$project_status" == STARTUP_RECOVERABLE.* ]]; then
		display_status=paused
		completion='-'
		startup_detail="$(awk -F': ' '$1=="Startup transaction" {print $2; exit}' <<< "$status_output")"
		description="STARTUP_RECOVERABLE: ${startup_detail:-inspect harness-status}."
	elif [[ "$project_status" == STARTUP_FAILED.* ]]; then
		display_status=paused
		completion='-'
		startup_detail="$(awk -F': ' '$1=="Startup transaction" {print $2; exit}' <<< "$status_output")"
		description="STARTUP_FAILED: ${startup_detail:-inspect harness-status}."
	elif [[ "$project_status" == PROJECT_INTEGRITY_ANOMALY.* ]]; then
		display_status=paused
		integrity_alert="$dir/control/project-integrity-anomaly.md"
		description="PROJECT_INTEGRITY_ANOMALY: $(markdown_summary "$integrity_alert")"
	elif [[ "$project_status" == TOKEN_USAGE_ANOMALY.* ]]; then
		display_status=paused
		token_alert="$(find "$dir/control/progress" -maxdepth 1 -type f -name "$project-task-*.token-usage-anomaly.md" -print 2>/dev/null | sort | head -n 1)"
		description="TOKEN_USAGE_ANOMALY: $(markdown_summary "$token_alert")"
	elif [[ "$project_status" == ARCHITECTURE_REASSESSMENT_REQUIRED.* ]]; then
		display_status=paused
		reassessment_alert="$(find "$dir/control/progress" -maxdepth 1 -type f -name "$project-task-*.architecture-reassessment-required.md" -print 2>/dev/null | sort | head -n 1)"
		description="ARCHITECTURE_REASSESSMENT_REQUIRED: $(markdown_summary "$reassessment_alert")"
	elif [[ -f "$dir/control/project.complete" ]]; then display_status=done; completion="$complete/$total"; description=''
	elif [[ -f "$dir/control/project.blocked.md" ]]; then display_status=paused; description="NEEDS HUMAN: $(markdown_summary "$dir/control/project.blocked.md")"
	elif [[ "$project_status" == NEEDS_HUMAN.* ]]; then display_status=paused; description="$project_status"
	elif [[ "$project_status" == PLANNING_STALLED.* ]]; then
		display_status=paused
		planning_alert="$dir/control/manager-plan-structural-error.md"
		[[ -f "$planning_alert" ]] || planning_alert="$dir/control/manager-plan-stalled.md"
		[[ -f "$planning_alert" ]] || planning_alert="$dir/control/manager-plan-failed.md"
		description="PLANNING_STALLED: $(markdown_summary "$planning_alert")"
	elif [[ "$project_status" == REVIEW_STALLED.* ]]; then
		display_status=paused
		review_alert="$(find "$dir/control" -maxdepth 1 -type f -name "$project-task-*.manager-review-stalled.md" -print 2>/dev/null | sort | head -n 1)"
		description="REVIEW_STALLED: $(markdown_summary "$review_alert")"
	elif [[ "$project_status" == RECOVERY_STALLED.* ]]; then
		display_status=paused
		recovery_alert="$(find "$dir/control" -maxdepth 1 -type f -name "$project-task-*.manager-replan-failed.md" -print 2>/dev/null | sort | head -n 1)"
		description="RECOVERY_STALLED: $(markdown_summary "$recovery_alert")"
	elif [[ -n "$waiting_request" ]]; then
		display_status=waiting
		request_id="$(awk -F': ' '$1=="Request-ID" {print $2; exit}' "$waiting_request")"
		failures="$(awk '/^```text$/ {inside=1; next} inside && /^```$/ {exit} inside && NF {print}' "$waiting_request" | paste -sd';' -)"
		description="WAITING_DEPENDENCY ${request_id:-unknown}: ${failures:-see $waiting_request}."
	elif [[ -n "$active" && "$active" == */results/* ]]; then [[ "$manager" == running* ]] && display_status='m/running' || display_status='m/stopped'; description='Reviewing completed leaf.'
	elif [[ -n "$active" ]]; then
		[[ "$worker" == running* ]] && display_status='w/running' || display_status='w/stopped'
		task="${active##*/}"; task="${task#${project}-task-}"; task="${task%.ready.md}"; task="${task%.running.md}"
		route="$(awk -F': ' '$1=="Worker-Route" {print $2; exit}' "$active" 2>/dev/null || true)"
		description="$task${route:+ [$route]} is active."
	else [[ "$manager" == running* ]] && display_status='m/running' || display_status='m/stopped'; description="Planning next dependency-ready leaf ($complete/$total)."
	fi
	trace="$(latest_trace "$dir")"
	if [[ "$display_status" != done && -n "$trace" && -f "$trace" ]]; then age=$(( $(date +%s) - $(stat -c %Y "$trace") )); (( age >= 0 )) || age=0; action="$(latest_trace_action "$trace")"; description+=$'\n'"Activity $(human_duration "$age") ago."; [[ -z "$action" ]] || description+=$'\n'"$action"; fi
	print_row "$project" "$cycle" "$display_status" "$completion" "$description"
done < <(find "$config_dir" -maxdepth 1 -type f -name '*.env' -print0 | sort -z)

(( found )) || printf 'No environment files with a non-empty SPECIFICATION were found in %s.\n' "$config_dir"
