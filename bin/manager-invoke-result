#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE TASK_ID\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 2 ]] || usage
load_harness_env "$1"
task_id="$2"
ensure_project
require_registered_specification_ir
require_manager_configuration
require_manager_codex
trace_init manager_invoke_result
trace_script_start "$@"
trap 'trace_script_exit $?' EXIT
validate_task_id "$task_id"
write_manager_snapshot

project_path="$(project_dir)"
thread_file="$project_path/control/manager.thread"
[[ -f "$thread_file" ]] || die 'manager thread is not registered; run manager-bootstrap'
thread_id="$(kv_file_value "$thread_file" thread_id)"
original_thread_id="$thread_id"
base="$(task_base "$task_id")"
result="$project_path/results/$base.result.md"
running="$project_path/running/$base.running.md"
lease="$project_path/control/$base.lease"
assignment_archive="$project_path/archive/$base.assignment.md"
accepted="$project_path/archive/$base.accepted.md"
checkpointed="$project_path/archive/$base.checkpointed.md"
rejected="$project_path/archive/$base.rejected.md"
blocked="$project_path/archive/$base.blocked.md"
superseded="$project_path/archive/$base.superseded.md"
architecture_reassessment="$(task_root_architecture_reassessment_file "$task_id")"
root_replan_marker="$(task_root_replan_file "$task_id")"
review_retry_file="$project_path/control/$base.manager-review-retry.env"
pending_exit_status=3
[[ -f "$result" ]] || die "result file does not exist: $result"
result_content_fingerprint="sha256:$(sha256sum "$result" | awk '{print $1}')"
[[ ! -e "$running" ]] || die "result is not committed; running assignment still exists: $running"
[[ ! -e "$lease" ]] || die "result is not committed; worker lease still exists: $lease"
[[ -f "$assignment_archive" ]] || die "result is not committed; archived assignment is missing: $assignment_archive"
task_root="$(task_root_id "$task_id")"
project_plan_exists || die 'project plan is missing; cannot review a task outside the specification plan'
plan_item_id="$(project_plan_item_for_root "$task_root")"
if [[ -n "$plan_item_id" && "$(project_plan_item_status "$plan_item_id")" == COMPLETE ]] &&
	root_has_accepted_task "$task_root"; then
	"$HARNESS_BIN/manager-supersede-task" "$HARNESS_ENV_FILE" "$task_id" >/dev/null
	log_event "MANAGER_REVIEW_SUPERSEDED_WITHOUT_AGENT task=$task_id root=$task_root plan_item=$plan_item_id"
	trace_event MANAGER_REVIEW_SUPERSEDED_WITHOUT_AGENT "task_id=$task_id" "task_root=$task_root" "plan_item=$plan_item_id"
	exit 0
fi
initialize_task_progress "$task_id" "$assignment_archive"
progress_file="$(task_progress_file "$task_root")"
root_assignment_file="$(task_root_assignment_file "$task_root")"
criteria_definition_file="$(task_criteria_definition_file "$task_root")"
criterion_decomposition_file="$(task_criterion_decomposition_file "$task_root")"
criterion_ledger_file="$(task_criterion_ledger_file "$task_root")"
first_unmet_criterion="$(task_first_unmet_criterion "$task_root" 2>/dev/null || true)"
current_progress="$(task_progress_percent "$task_root")"
review_state_changed="${HARNESS_REVIEW_STATE_CHANGED:-0}"
[[ "$review_state_changed" =~ ^[01]$ ]] || die 'HARNESS_REVIEW_STATE_CHANGED must be 0 or 1'
goal_mode=0
goal_outcome=""
goal_state_path=""
if assignment_uses_goal_mode "$assignment_archive"; then
	goal_mode=1
	goal_outcome="$(metadata_value "$result" Goal-Outcome)"
	goal_state_path="$(goal_state_file "$task_id")"
fi
closure_mode_active=0
if (( HARNESS_CLOSURE_MODE_ENABLED == 1 )) &&
	[[ "$task_id" != "$task_root" ]] &&
	(( current_progress >= HARNESS_CLOSURE_MODE_MIN_PROGRESS && current_progress < 100 )); then
	closure_mode_active=1
fi
development_policy_file="$REPOSITORY/design/development-policy.txt"
[[ -f "$development_policy_file" ]] || development_policy_file=""
project_plan_definition="$(project_plan_definition_file)"
project_plan_state="$(project_plan_state_file)"
specification_obligations_path='-'
specification_relations_path='-'
specification_coverage_path='-'
allocated_specification_obligations='-'
if specification_ir_available; then
	specification_obligations_path="$(specification_obligations_file)"
	specification_relations_path="$(specification_relations_file)"
	specification_coverage_path="$(specification_coverage_file)"
	allocated_specification_obligations="$(specification_obligations_for_node "$plan_item_id" | paste -sd, -)"
	[[ -n "$allocated_specification_obligations" ]] || die "reviewed DAG node has no normalized specification obligations: $plan_item_id"
fi
worker_evidence_digest="$project_path/control/$base.worker-evidence-digest.md"
write_worker_episode_evidence_digest "$task_id" "$worker_evidence_digest"

review_context_capsule="$project_path/control/$base.manager-review-context.md"
write_plan_node_context_capsule "$review_context_capsule" "$plan_item_id"

reviewed_invariants="$(metadata_value "$assignment_archive" Affected-Invariants)"
reviewed_edges="$(metadata_value "$assignment_archive" Edge-Contracts)"
assigned_focused_validation="$(metadata_value "$assignment_archive" Focused-Validation)"
assigned_validation_class="$(metadata_value "$assignment_archive" Validation-Class)"
[[ -n "$reviewed_invariants" ]] || reviewed_invariants=-
[[ -n "$reviewed_edges" ]] || reviewed_edges=-
[[ -n "$assigned_focused_validation" ]] || assigned_focused_validation=-
[[ -n "$assigned_validation_class" ]] || assigned_validation_class=-
accept_review_template="$project_path/control/$base.accept-review-template.md"
checkpoint_review_template="$project_path/control/$base.checkpoint-review-template.md"
checkpoint_criterion_review_template="$project_path/control/$base.checkpoint-criterion-review-template.md"
reject_review_template="$project_path/control/$base.reject-review-template.md"
leaf_criterion_total="$(task_leaf_criterion_total_count "$task_root")"
leaf_criterion_passed="$(task_leaf_criterion_passed_count "$task_root")"
checkpoint_criterion_progress="$current_progress"
checkpoint_criterion_improvement=0
if (( leaf_criterion_total > 0 && leaf_criterion_passed < leaf_criterion_total )); then
	checkpoint_criterion_progress=$(( (leaf_criterion_passed + 1) * 100 / leaf_criterion_total ))
	checkpoint_criterion_improvement=$((checkpoint_criterion_progress - current_progress))
	(( checkpoint_criterion_improvement >= 0 )) || checkpoint_criterion_improvement=0
fi
cat > "$accept_review_template.tmp.$$" <<TEMPLATE
# Manager Review Record

Task-ID: $task_id
Decision: ACCEPT
Progress-Percent: 100%
Verified-Criterion: $first_unmet_criterion
Impact-Assessment: PASS
Reviewed-Invariants: $reviewed_invariants
Reviewed-Edges: $reviewed_edges
Debt-Recorded: NONE

## Specification comparison

Replace this line with the bounded authority comparison.

## Acceptance-criteria verification

- [PASS] criterion — independently verified evidence

## Feature verification

- [PASS] behavior — independently verified evidence

## Validation executed

- [PASS] command — exit status and retained evidence

## Scope and regression review

Replace this line with the bounded scope review.

## Conclusion

Replace this line with the acceptance conclusion.
TEMPLATE
cat > "$checkpoint_criterion_review_template.tmp.$$" <<TEMPLATE
# Manager Review Record

Task-ID: $task_id
Decision: CHECKPOINT
Target-Criterion: $first_unmet_criterion
Verified-Criterion: $first_unmet_criterion
Checkpoint-Path: NONE
Progress-Percent: $checkpoint_criterion_progress%
Improvement-Percent: $checkpoint_criterion_improvement%
Impact-Assessment: PASS
Reviewed-Invariants: $reviewed_invariants
Reviewed-Edges: $reviewed_edges
Debt-Recorded: NONE

## Specification comparison

Replace this line with the bounded authority comparison.

## Increment verification

- [PASS] $first_unmet_criterion — independently verified completion evidence

## Validation executed

- [PASS] command — exit status and retained evidence

## Scope and regression review

Replace this line with the bounded scope review.

## Remaining root criteria

- Replace this line with the next precise remaining boundary.

## Conclusion

Replace this line with the criterion-completion checkpoint conclusion.
TEMPLATE
cat > "$checkpoint_review_template.tmp.$$" <<TEMPLATE
# Manager Review Record

Task-ID: $task_id
Decision: CHECKPOINT
Target-Criterion: $first_unmet_criterion
Verified-Increment: REPLACE_WITH_STABLE_INCREMENT_ID
Checkpoint-Path: NONE
Progress-Percent: $current_progress%
Improvement-Percent: 0%
Impact-Assessment: PASS
Reviewed-Invariants: $reviewed_invariants
Reviewed-Edges: $reviewed_edges
Debt-Recorded: NONE

## Specification comparison

Replace this line with the bounded authority comparison.

## Increment verification

- [PASS] increment — independently verified evidence

## Validation executed

- [PASS] command — exit status and retained evidence

## Scope and regression review

Replace this line with the bounded scope review.

## Remaining root criteria

- $first_unmet_criterion — replace with the precise remaining boundary

## Conclusion

Replace this line with the checkpoint conclusion.
TEMPLATE
blocking_state_fingerprint="sha256:$(printf '%s\n' "$task_root" "${first_unmet_criterion:--}" \
	"$(git -C "$REPOSITORY" rev-parse HEAD 2>/dev/null || printf '-')" "${goal_outcome:--}" |
	sha256sum | awk '{print $1}')"
cat > "$reject_review_template.tmp.$$" <<TEMPLATE
# Manager Review Record

Task-ID: $task_id
Decision: REJECT
Target-Criterion: $first_unmet_criterion
Progress-Percent: $current_progress%
Improvement-Percent: 0%
Blocking-Fingerprint: $blocking_state_fingerprint
Impact-Assessment: PASS
Reviewed-Invariants: $reviewed_invariants
Reviewed-Edges: $reviewed_edges
Debt-Recorded: NONE

## Specification comparison

Replace this line with the bounded authority comparison.

## Validation executed

- [PASS] diagnostic — exact independently reproduced failure or missing evidence

## Scope and regression review

Replace this line with the bounded scope review.

## Remaining root criteria

- $first_unmet_criterion — replace with the precise remaining boundary

## Conclusion

Replace this line with the rejection conclusion.
TEMPLATE
chmod 600 "$accept_review_template.tmp.$$" "$checkpoint_criterion_review_template.tmp.$$" \
	"$checkpoint_review_template.tmp.$$" "$reject_review_template.tmp.$$"
mv "$accept_review_template.tmp.$$" "$accept_review_template"
mv "$checkpoint_criterion_review_template.tmp.$$" "$checkpoint_criterion_review_template"
mv "$checkpoint_review_template.tmp.$$" "$checkpoint_review_template"
mv "$reject_review_template.tmp.$$" "$reject_review_template"

remaining_leaf_criteria=$(( $(task_leaf_criterion_total_count "$task_root") - $(task_leaf_criterion_passed_count "$task_root") ))
(( remaining_leaf_criteria >= 0 )) || remaining_leaf_criteria=0
recommended_review_template="$checkpoint_criterion_review_template"
recommended_terminal_command="$HARNESS_BIN/manager-checkpoint-task"
if (( remaining_leaf_criteria == 1 )); then
	recommended_review_template="$accept_review_template"
	recommended_terminal_command="$HARNESS_BIN/manager-accept-task"
fi

# Review and recovery packets are both bounded control-plane progress evidence.
# Keep them in one deterministic directory so a model cannot transpose the
# established recovery-packet path and fall back to filesystem exploration.
review_packet="$project_path/control/progress/$base.manager-review-packet.md"
{
	printf '# Compiled Manager Review Packet\n\n'
	printf 'Task-ID: %s\n' "$task_id"
	printf 'Task-Root: %s\n' "$task_root"
	printf 'First-Unmet-Criterion: %s\n' "${first_unmet_criterion:--}"
	printf 'Current-Progress-Percent: %s\n' "$current_progress"
	printf 'Goal-Outcome: %s\n' "${goal_outcome:--}"
	printf 'Remaining-Leaf-Criteria: %s\n\n' "$remaining_leaf_criteria"
	for packet_entry in \
		"Development policy|$development_policy_file" \
		"Compiled plan, specification, and architecture authority|$review_context_capsule" \
		"Exact reviewed assignment|$assignment_archive" \
		"Bounded worker episode and terminal result evidence|$worker_evidence_digest" \
		"Recommended pass schema|$recommended_review_template" \
		"Final accept schema|$accept_review_template" \
		"Diagnostic-increment schema|$checkpoint_review_template" \
		"Reject schema|$reject_review_template"; do
		packet_label="${packet_entry%%|*}"
		packet_source="${packet_entry#*|}"
		printf '## %s\n\n' "$packet_label"
		if [[ -n "$packet_source" && -f "$packet_source" ]]; then
			printf 'Source: `%s`\n\nContent-Escaped: ' "$packet_source"
			awk 'BEGIN {ORS=""}
				{
					gsub(/\\/, "\\\\")
					gsub(/\t/, "\\t")
					gsub(/\r/, "\\r")
					if (NR > 1) printf "\\n"
					printf "%s", $0
				}
				END {printf "\n"}
			' "$packet_source"
			printf '\n'
		else
			printf 'NONE\n\n'
		fi
	done
} > "$review_packet.tmp.$$"
review_packet_bytes="$(wc -c < "$review_packet.tmp.$$")"
review_packet_lines="$(wc -l < "$review_packet.tmp.$$")"
if (( review_packet_bytes > HARNESS_VALIDATION_OUTPUT_MAX_BYTES ||
	review_packet_lines > HARNESS_VALIDATION_OUTPUT_MAX_LINES )); then
	rm -f "$review_packet.tmp.$$"
	die "compiled manager review packet exceeds the bounded read budget (bytes=$review_packet_bytes/$HARNESS_VALIDATION_OUTPUT_MAX_BYTES lines=$review_packet_lines/$HARNESS_VALIDATION_OUTPUT_MAX_LINES)"
fi
chmod 600 "$review_packet.tmp.$$"
mv "$review_packet.tmp.$$" "$review_packet"

prompt_file="$project_path/control/$base.manager-review.prompt.md"
cat > "$prompt_file.tmp.$$" <<PROMPT
A worker result is ready for review.

ENV_FILE=$HARNESS_ENV_FILE
PROJECT=$PROJECT
PROJECT_TMP_DIR=$PROJECT_TMP_DIR
TASK_ID=$task_id
RESULT_FILE=$result
TASK_ROOT=$task_root
ROOT_ASSIGNMENT_FILE=$root_assignment_file
PROGRESS_FILE=$progress_file
CRITERIA_DEFINITION_FILE=$criteria_definition_file
CRITERION_DECOMPOSITION_FILE=$criterion_decomposition_file
CRITERION_LEDGER_FILE=$criterion_ledger_file
FIRST_UNMET_CRITERION=$first_unmet_criterion
CURRENT_PROGRESS_PERCENT=$current_progress
PROJECT_PLAN_FILE=-
PROJECT_PLAN_STATE_FILE=-
PROJECT_DECOMPOSITION_FILE=-
SPECIFICATION_OBLIGATIONS_FILE=-
SPECIFICATION_RELATIONS_FILE=-
SPECIFICATION_COVERAGE_FILE=-
ALLOCATED_SPECIFICATION_OBLIGATIONS=$allocated_specification_obligations
PROJECT_PROGRESS_PERCENT=$(project_plan_progress_percent)
DEVELOPMENT_POLICY_FILE=$development_policy_file
SPECIFICATION=$SPECIFICATION
REPOSITORY=$REPOSITORY
HARNESS_BIN=$HARNESS_BIN
CLOSURE_MODE_ACTIVE=$closure_mode_active
CLOSURE_MODE_ELIGIBLE_ON_REJECTION=$([[ "$HARNESS_CLOSURE_MODE_ENABLED" == 1 && "$current_progress" -ge "$HARNESS_CLOSURE_MODE_MIN_PROGRESS" && "$current_progress" -lt 100 ]] && printf 1 || printf 0)
CLOSURE_MAX_FIXES=$HARNESS_CLOSURE_MODE_MAX_FIXES
CLOSURE_MAX_SMOKE_RUNS=$HARNESS_CLOSURE_MODE_MAX_SMOKE_RUNS
MAX_ROOT_ATTEMPTS=$HARNESS_MAX_ROOT_ATTEMPTS
MAX_ZERO_GAIN_WINDOW=$HARNESS_MAX_ZERO_GAIN_WINDOW
MAX_CHECKPOINTS_WITHOUT_CRITERION=$HARNESS_MAX_CHECKPOINTS_WITHOUT_CRITERION
WORKER_GOAL_MODE=$goal_mode
GOAL_OUTCOME=$goal_outcome
GOAL_STATE_FILE=$goal_state_path
DECOMPOSITION_V2=$HARNESS_DECOMPOSITION_V2
ARCHITECTURE_GUARDS=$HARNESS_ARCHITECTURE_GUARDS
ARCHITECTURE_DIR=-
MANAGER_ARCHITECTURE_REVISION_COMMAND=$HARNESS_BIN/manager-revise-architecture
MANAGER_DEPENDENCY_INVALIDATION_COMMAND=$HARNESS_BIN/manager-invalidate-plan-dependency
LUNA_STRATEGY_FAILURES=$(root_luna_strategy_failure_count "$task_root")
MAX_LUNA_STRATEGY_FAILURES=$HARNESS_MAX_LUNA_STRATEGY_FAILURES
PREFERRED_WORKER_ROUTE=$HARNESS_PREFERRED_WORKER_ROUTE
REVIEW_STATE_CHANGED=$review_state_changed
REVIEW_PACKET_FILE=$review_packet
WORKER_EVIDENCE_DIGEST_FILE=$worker_evidence_digest
REVIEW_CONTEXT_CAPSULE_FILE=$review_context_capsule
ACCEPT_REVIEW_TEMPLATE_FILE=$accept_review_template
CHECKPOINT_CRITERION_REVIEW_TEMPLATE_FILE=$checkpoint_criterion_review_template
CHECKPOINT_INCREMENT_REVIEW_TEMPLATE_FILE=$checkpoint_review_template
CHECKPOINT_REVIEW_TEMPLATE_FILE=$checkpoint_review_template
REJECT_REVIEW_TEMPLATE_FILE=$reject_review_template
REMAINING_LEAF_CRITERIA=$remaining_leaf_criteria
RECOMMENDED_PASS_REVIEW_TEMPLATE_FILE=$recommended_review_template
RECOMMENDED_PASS_TERMINAL_COMMAND=$recommended_terminal_command
REVIEW_DIFF_COMMAND=$HARNESS_BIN/harness-review-diff
ASSIGNED_FOCUSED_VALIDATION=$assigned_focused_validation
ASSIGNED_VALIDATION_CLASS=$assigned_validation_class

This is one bounded event-driven manager review. Complete it in at most six shell actions: one read of REVIEW_CONTEXT_CAPSULE_FILE plus the root/result/digest files, one bounded source/diff inspection, one independent validation, one optional focused diagnostic, one review-note write, and one terminal harness command. The capsule is authoritative and complete for plan, DAG, IR, and architecture context; do not open the human specification except for the exact bounded HUMAN_PRODUCT_SPECIFICATION conflict check required below, and do not open the global project plan/DAG/coverage, architecture registries, repository inventory, prior agent logs, raw worker JSONL/stderr, raw command/build logs, or any file under HARNESS_BIN/HARNESS_HOME. Do not invoke any harness command with --help. The four review templates are complete validator-compatible schemas: use ACCEPT_REVIEW_TEMPLATE_FILE only when the whole root passes; use CHECKPOINT_CRITERION_REVIEW_TEMPLATE_FILE when FIRST_UNMET_CRITERION fully passes but later root criteria remain; use CHECKPOINT_INCREMENT_REVIEW_TEMPLATE_FILE only for useful diagnostic evidence that does not complete FIRST_UNMET_CRITERION; use REJECT_REVIEW_TEMPLATE_FILE when the result is faulty, regressive, out of scope, or independently unverified. Copy exactly one to PROJECT_TMP_DIR, replace its prose placeholders with actual evidence, and preserve every heading, metadata key, and '[PASS] subject — evidence' form. Never rename Verified-Criterion to Verified-Increment or record a completed declared criterion as a diagnostic increment. Do not construct a review schema from memory. Exact common signatures are: harness-run-assigned-validation ENV_FILE TASK_ID LABEL, harness-run-logged ENV_FILE TASK_ID LABEL -- COMMAND..., manager-accept-task ENV_FILE TASK_ID REVIEW_NOTE_FILE, manager-checkpoint-task ENV_FILE TASK_ID REVIEW_NOTE_FILE, manager-reject-task ENV_FILE TASK_ID REVIEW_NOTE_FILE, and manager-block-task ENV_FILE TASK_ID REVIEW_NOTE_FILE. Read DEVELOPMENT_POLICY_FILE when present, then REVIEW_CONTEXT_CAPSULE_FILE, ROOT_ASSIGNMENT_FILE, PROGRESS_FILE, CRITERIA_DEFINITION_FILE, CRITERION_DECOMPOSITION_FILE, CRITERION_LEDGER_FILE, RESULT_FILE, WORKER_EVIDENCE_DIGEST_FILE, and the selected review template once. For the task-scope diff, run exactly REVIEW_DIFF_COMMAND ENV_FILE TASK_ID; it captures the complete diff externally and returns one bounded excerpt. Do not run raw git diff, concatenate diff with source reads, or open the retained full-diff log. Inspect any additional exact source window separately with both configured line and byte caps. Run an executable ASSIGNED_FOCUSED_VALIDATION with harness-run-assigned-validation so the complete compound expression is captured. If ASSIGNED_FOCUSED_VALIDATION is a typed FOCUSED:/INCREMENTAL:/CLEAN_GLOBAL: descriptor on a zero-write VERIFICATION_ONLY leaf, do not pass it to a shell: independently reproduce the worker's concrete bounded evidence command through harness-run-logged and review it against the named evidence authority. The reproduced command must be grounded in the assignment's Context-Paths, Required-Symbols, or an exact command in REVIEW_CONTEXT_CAPSULE_FILE. Never derive a command-v probe from a descriptor identifier and never invoke oracle-invoke-final-audit before the project plan is complete. If no grounded seam exists, reject with CONTEXT_INCOMPLETE rather than inventing a command or final-oracle handoff. For any other descriptive or invalid assigned validation, reject for a corrected focused-validation strategy rather than broadening it. If you must author a diagnostic compound command, pass it as one quoted /bin/bash -lc argument after harness-run-logged; placing a logical operator after the harness-run-logged invocation is forbidden because the following command escapes capture. For executable FOCUSED validation, execute ASSIGNED_FOCUSED_VALIDATION at its exact named target/selector boundary; never omit a CMake --target, replace it with an all-target build, run an unfiltered CTest suite, or promote a failure from an unrelated broader build into a prerequisite. Interpret diagnostic fields from their source declarations: an integer such as has_two_devices=1 is a true boolean, not a one-device hardware count. Never classify external capability absence from a field name alone; require an explicit count/error diagnostic or independently reproduce the capability query. Bound every shell output to at most $HARNESS_VALIDATION_OUTPUT_MAX_LINES lines and $HARNESS_VALIDATION_OUTPUT_MAX_BYTES bytes. When REVIEW_STATE_CHANGED=1, stable control state changed after a prior pending review: perform a fresh review; do not dismiss the event as a duplicate. Use the capsule and current repository HEAD. Reconcile cumulative root progress and project progress against the actual repository. Write review files under PROJECT_TMP_DIR. Every harness command receives ENV_FILE first. Checkpoint a correct verified increment that does not complete the root; accept only when the entire root passes; reject only faulty, regressive, out-of-scope, or independently unverified work. A continuation targets FIRST_UNMET_CRITERION. Run one terminal review command. If it rejects the note, make at most one correction from that exact diagnostic; never search harness source for validator rules. Do not publish a continuation after a terminal command returns a needs-replan, needs-human, blocked, or architecture-reassessment marker. Invalidate a disproved upstream dependency with MANAGER_DEPENDENCY_INVALIDATION_COMMAND. Acceptance completes only this plan item; after acceptance, terminate. Do not wait, sleep, poll, watch, or call manager-wait-result.
COMPILED REVIEW OVERRIDE: REVIEW_PACKET_FILE supersedes every multi-file read instruction above. It contains the development policy, compiled plan/DAG/IR/architecture authority, exact reviewed assignment, bounded worker/result evidence, and validator-compatible pass, diagnostic-increment, and reject schemas. Each component is one Content-Escaped line where literal backslash-n, backslash-t, backslash-r, and doubled backslashes encode the original text. Read the complete packet in exactly one command: head -c $HARNESS_VALIDATION_OUTPUT_MAX_BYTES -- $review_packet. Do not split that read into line ranges. Do not open, probe, count, concatenate, or search for DEVELOPMENT_POLICY_FILE, REVIEW_CONTEXT_CAPSULE_FILE, ROOT_ASSIGNMENT_FILE, PROGRESS_FILE, criteria files, RESULT_FILE, WORKER_EVIDENCE_DIGEST_FILE, or template files separately. Complete the review in at most six actions: packet read; exact REVIEW_DIFF_COMMAND; assigned validation; at most one exact bounded source window only if decisive evidence remains missing; write one review note directly from the packet schema; one terminal command. A missing optional component is represented as NONE in the packet and must never trigger filesystem exploration. This override is the final authority wherever earlier compatibility prose conflicts with it.

If the assigned focused validation exits nonzero and that failure already establishes that the submitted result cannot pass, skip the optional source diagnostic. Write the reject note from the bounded validation evidence and call the terminal rejection command immediately; do not spend another full-context action confirming the same failure.

When FIRST_UNMET_CRITERION passes, use the recommended pass schema embedded in REVIEW_PACKET_FILE and RECOMMENDED_PASS_TERMINAL_COMMAND exactly. REMAINING_LEAF_CRITERIA=1 means final acceptance: never submit, edit, or convert a checkpoint schema in that case. If a terminal command says all criteria would pass, write ACCEPT_REVIEW_TEMPLATE_FILE afresh from the accept schema embedded in the packet; do not mutate the rejected checkpoint note.
PROMPT
if (( goal_mode == 1 )); then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

This is the single manager review for a terminal worker leaf goal. Verify the repository and evidence independently. GOAL_OUTCOME=COMPLETE means only that the worker believes the leaf is done; accept the root only if every root criterion passes, otherwise checkpoint the completed first leaf and let planning select the next one. For NEEDS_DECOMPOSITION, checkpoint any independently verified increment (the checkpoint command will request automatic decomposition) or reject faulty/unverified work (the rejection command will request automatic decomposition); do not discard useful workspace changes. For HARD_BLOCKED, call manager-block-task only after verifying that an explicit Hard-Block-Conditions boundary in the assignment is genuinely met. Ordinary failures and incomplete implementation are not hard blocks. A verified hard block pauses only this leaf assignment; it does not by itself establish a human dependency. Before calling manager-block-task, classify the underlying dependency in the review note with exactly one Blocker-Class line. Use LOCAL_CODE_PREREQUISITE, LOCAL_BUILD_PREREQUISITE, LOCAL_INTEGRATION_PREREQUISITE, or LOCAL_SCOPE_PREREQUISITE when repository-local implementation, testability, build, integration, or workstream ownership work could resolve it, including work outside the leaf's Allowed-Scope or ordinary worker exclusive/forbidden-file list; also add one nonempty Remediation-Scope line naming the smallest implicated local area. The manager acts as integration owner for those repairs, and their checkpoint paths are baseline-remediation provenance rather than feature-owned implementation changes. Use HUMAN_AUTHORIZATION, HUMAN_SECRET, HUMAN_EXTERNAL_STATE, or HUMAN_PRODUCT_SPECIFICATION only when a person is genuinely required; also add one nonempty Human-Dependency-Evidence line identifying the unavailable authority, secret, manual state transition, or unresolved governing product/specification choice. Before HUMAN_PRODUCT_SPECIFICATION, search SPECIFICATION only for the exact disputed identifiers, paths, symbols, or registry name and read a bounded matching section. If that governing text chooses an outcome, treat the conflict as a stale/incomplete context capsule and use local remediation or checkpoint/replan; do not ask a human to repeat an existing decision. HUMAN_PRODUCT_SPECIFICATION additionally requires Product-Decision-Evidence naming at least two incompatible observable product/API/data outcomes not resolved by the governing specification and Governing-Specification-Search naming the exact bounded search performed and why no governing statement resolves it. File ownership, a frozen baseline source, an exclusive/forbidden path, a missing private test seam, or a manager-authored criterion stricter than the governing specification is repository-local manager remediation, not a product decision. If you reject a HARD_BLOCKED claim, the harness clears that worker thread and routes one fresh manager-owned scope diagnostic; never request another same-scope implementation retry.

For NEEDS_DECOMPOSITION caused by a token/resource fuse, inspect WORKER_EVIDENCE_DIGEST_FILE, the current bounded diff, assignment, capsule, and result to distinguish an over-broad leaf from an incomplete context capsule. Never inspect the raw worker transcript to make this decision. The typed Decomposition-Reason is evidence, not an unreviewed conclusion: verify whether the defect is TASK_TOO_BROAD, CONTEXT_INCOMPLETE, SCOPE_INCOMPLETE, VALIDATION_PREREQUISITE, or RESOURCE_LIMIT. If the result says Workspace-Changed: 1, the episode made preserved source movement: do not describe it as an identical no-progress failure. Independently inspect the exact bounded diff and either checkpoint a verified increment or reject it into a fresh VERIFICATION_ONLY continuation before authorizing more implementation. Diagnostic evidence is durable work: when Goal-Success-Evidence requests an exact failure boundary, status, value, symbol, or prerequisite and the bounded terminal evidence independently establishes it, use CHECKPOINT_INCREMENT_REVIEW_TEMPLATE_FILE with a nonzero Improvement-Percent even when no source changed and the implementation criterion remains incomplete. Never reject such evidence merely because the diff is empty. When the leaf concern remains cohesive but required contracts were absent, keep the same criterion and Allowed-Scope, use fresh worker context, and add only the exact missing Context-Paths and Required-Symbols. Never resend the unchanged capsule or ask the worker to compensate with repository-wide exploration. If a fresh Manager-Remediation assignment returns CONTEXT_INCOMPLETE, reject it truthfully so the harness preserves the same Remediation-Scope and machine-requires a strict bounded Context-Paths expansion. If it returns SCOPE_INCOMPLETE because its declared mutation scope lacks the required representation, producer, consumer, or validation seam, reject it truthfully so the harness machine-forbids republishing that remediation path set for the unchanged criterion.

When the result states that required Context Closure admission stopped before a worker invocation, treat the closure manifest, unresolved ledger, and graph cuts as deterministic planner/index evidence. Do not classify it as a human product decision and do not authorize another Luna search episode. Split the node using the recorded cohesive cuts when the closure is oversized. If the leaf boundary is already cohesive and an indexed dependency is demonstrably absent or stale, route one fresh Terra manager-remediation leaf whose sole deliverable is repairing the repository index/context contract; after that repair, rebuild the closure before restoring Luna execution.

The manager-remediation exception applies only to manager-authored leaf restrictions. A path frozen or excluded by the governing human specification or accepted project DAG is a semantic-authority boundary. Do not spend another implementation turn trying to override it; request specification clarification or architecture reassessment.

If you reject a faulty or unverified COMPLETE outcome and publish a repair for the same Target-Criterion, reuse the assignment's Goal-ID unless you explicitly require Worker-Context: FRESH. The publisher will carry the logical goal's iteration, usage, review, and thread state into the repair task while applying the new manager-authored baseline boundary.
PROMPT
fi
if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

V2 decomposition remains mandatory for every continuation. PREFERRED_WORKER_ROUTE=$HARNESS_PREFERRED_WORKER_ROUTE. Preserve the node and dependency boundary in REVIEW_CONTEXT_CAPSULE_FILE. Every next assignment must include Leaf-Type, Complexity-Class, Worker-Route, Depends-On, Deliverable, Required-Symbols, Context-Paths, Architecture-Decisions, Validation-Class, Expected-Max-Implementation-Files, and Expected-Max-Worker-Turns. Routine implementation, tests, mechanical API work, focused fixes, and documentation are LOW/LUNA after decisions are resolved. Split only until one cohesive concern, at most five implementation files, bounded paths, at most three worker turns, and one focused or incremental validation remain. CLEAN_GLOBAL validation is TERRA integration. Never resend an unchanged Luna leaf.
PROMPT
fi
if [[ "$HARNESS_MODEL_POLICY" == luna_only ]]; then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

LUNA-ONLY POLICY OVERRIDE: All semantic roles and executable leaves use $LUNA_WORKER_MODEL. Never route a result, closure/index repair, integration check, remediation, or exhausted strategy to Terra or Sol. This instruction supersedes legacy Terra language above. Convert a non-ready closure into exact context repair or independently verifiable Luna children. Use Worker-Route: LUNA and Terra-Exception: - for every continuation. Only incompatible unresolved product outcomes may become HUMAN_PRODUCT_SPECIFICATION.
PROMPT
fi
if codex_model_requires_narrow_prompt "$MANAGER_MODEL"; then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Context: authorized local development in my own repository. Task type: benign software engineering. Do not perform offensive security, credential extraction, vulnerability exploitation, malware behavior, unauthorized access, network scanning, or bypassing security controls. Use only REVIEW_PACKET_FILE and the exact diff, validation, optional source-window, review-note, and terminal commands authorized above.
PROMPT
fi
chmod 600 "$prompt_file.tmp.$$"
mv "$prompt_file.tmp.$$" "$prompt_file"

# Batch review compiles these exact per-event packets and schemas first, then
# gives one ephemeral logical-manager inference several independent terminal
# transactions.  Preparation performs no semantic provider call.
if [[ "${HARNESS_MANAGER_PREPARE_ONLY:-0}" == 1 ]]; then
	printf '%s\n' "$prompt_file"
	exit 0
fi

attempt=1
provider_retries=0
quota_waits=0
status=0
json_log=""
stderr_log=""
last_message=""
classification=""
fallback_stage=0
current_model="$MANAGER_MODEL"
review_thread_id=""
fresh_context_pending=1
wrong_task_recovery_retry=0
uncommitted_review_retry=0
if [[ -f "$review_retry_file" ]]; then
	recorded_result_fingerprint="$(kv_file_value "$review_retry_file" result_fingerprint 2>/dev/null || true)"
	recorded_corrective_attempts="$(kv_file_value "$review_retry_file" corrective_attempts 2>/dev/null || printf 0)"
	if [[ "$recorded_result_fingerprint" == "$result_content_fingerprint" &&
		"$recorded_corrective_attempts" =~ ^[1-9][0-9]*$ ]]; then
		uncommitted_review_retry=1
	else
		rm -f -- "$review_retry_file"
	fi
fi
manager_rotation_reason=bounded_review
if (( review_state_changed == 1 )); then
	manager_rotation_reason=review_state_changed
fi

extract_thread_id()
{
	local log_file="$1"
	if command -v jq >/dev/null 2>&1; then
		jq -r 'select(.type == "thread.started") | .thread_id' "$log_file" | head -n 1
	else
		sed -n 's/.*"type"[[:space:]]*:[[:space:]]*"thread.started".*"thread_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$log_file" | head -n 1
	fi
}

commit_fresh_manager_context()
{
	(( fresh_context_pending == 1 )) || return 0
	[[ -n "$review_thread_id" && "$review_thread_id" != null ]] ||
		die 'fresh manager review completed without a recoverable thread id'
	"$HARNESS_BIN/manager-register-thread" "$HARNESS_ENV_FILE" "$review_thread_id" >/dev/null
	log_event "MANAGER_CONTEXT_ROTATED previous=$original_thread_id current=$review_thread_id reason=$manager_rotation_reason"
	trace_event MANAGER_CONTEXT_ROTATED "previous_thread_id=$original_thread_id" "current_thread_id=$review_thread_id" "reason=$manager_rotation_reason"
	fresh_context_pending=0
}

manager_action_committed()
{
	[[ -f "$accepted" || -f "$checkpointed" || -f "$rejected" || -f "$blocked" ||
		-f "$superseded" || -f "$architecture_reassessment" ]]
}

file_content_fingerprint()
{
	local file="$1"
	if [[ -f "$file" ]]; then
		sha256sum "$file" | awk '{print $1}'
	else
		printf 'missing\n'
	fi
}

initial_root_replan_fingerprint="$(file_content_fingerprint "$root_replan_marker")"

while true; do
	stamp="$(date -u '+%Y%m%dT%H%M%SZ')"
	attempt_label="$(printf '%03d' "$attempt")"
	json_log="$project_path/logs/manager-review-$task_id-$stamp-attempt-$attempt_label.jsonl"
	stderr_log="$project_path/logs/manager-review-$task_id-$stamp-attempt-$attempt_label.stderr.log"
	last_message="$project_path/logs/manager-review-$task_id-$stamp-attempt-$attempt_label.md"

	context_mode=resumed
	[[ -n "$review_thread_id" ]] || context_mode=fresh
	log_event "MANAGER_REVIEW_STARTED task=$task_id thread_id=${review_thread_id:-none} attempt=$attempt context=$context_mode"
	trace_event MANAGER_REVIEW_ATTEMPT "task_id=$task_id" "attempt=$attempt" "thread_id=${review_thread_id:-}" "context=$context_mode" "json_log=$json_log" "last_message=$last_message"
	set +e
	trace_event CODEX_EXEC_START "role=manager_review" "task_id=$task_id" "attempt=$attempt" "thread_id=${review_thread_id:-}" "context=$context_mode" "json_log=$json_log" "last_message=$last_message" "model=$MANAGER_MODEL"
	if [[ -n "$review_thread_id" ]]; then
		"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" manager_review "$current_model" "$prompt_file" "$json_log" "$stderr_log" "$last_message" resume "$review_thread_id"
	else
		"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" manager_review "$current_model" "$prompt_file" "$json_log" "$stderr_log" "$last_message"
	fi
	status=$?
	set -e
	started_thread_id="$(extract_thread_id "$json_log")"
	if (( fresh_context_pending == 1 )) && [[ -n "$started_thread_id" && "$started_thread_id" != null ]]; then
		review_thread_id="$started_thread_id"
	fi
	classification="$(kv_file_value "${json_log%.jsonl}.classification" classification 2>/dev/null || true)"
	record_root_agent_tokens "$task_id" manager_review "${json_log%.jsonl}.classification"
	trace_event CODEX_EXEC_END "role=manager_review" "task_id=$task_id" "attempt=$attempt" "status=$status" "json_log=$json_log" "last_message=$last_message"

	if (( status == 0 )); then
		if manager_action_committed; then
			rm -f -- "$review_retry_file"
			commit_fresh_manager_context
			log_event "MANAGER_REVIEW_FINISHED task=$task_id attempt=$attempt"
			trace_event MANAGER_REVIEW_COMMITTED "task_id=$task_id" "attempt=$attempt" "status=$status"
			printf 'Manager review turn completed and exited for task %s.\n' "$task_id"
			exit 0
		fi

		current_root_replan_fingerprint="$(file_content_fingerprint "$root_replan_marker")"
		if (( wrong_task_recovery_retry == 0 )) && [[ -f "$result" ]] &&
			[[ "$current_root_replan_fingerprint" != "$initial_root_replan_fingerprint" ]]; then
			# A newly changed root-replan marker without a terminal artifact for
			# this exact result means the manager acted on an earlier sibling/root
			# revision. Discard that conversational turn and allow exactly one
			# fresh corrective review. The supervisor's result barrier prevents
			# the premature marker from racing into automatic replanning.
			wrong_task_recovery_retry=1
			attempt=$((attempt + 1))
			review_thread_id=""
			fresh_context_pending=1
			manager_rotation_reason=wrong_task_terminal_action_recovery
			cat >> "$prompt_file" <<PROMPT

Corrective retry: the previous turn changed root-level recovery state but did not consume RESULT_FILE or create a terminal artifact for exact TASK_ID=$task_id. Review and act on exactly TASK_ID=$task_id, not TASK_ROOT=$task_root or any earlier revision. Your one terminal command must use TASK_ID=$task_id and must archive the current RESULT_FILE.
PROMPT
			log_event "MANAGER_REVIEW_WRONG_TASK_ACTION_RETRY task=$task_id root=$task_root attempt=$attempt"
			trace_event MANAGER_REVIEW_WRONG_TASK_ACTION_RETRY "task_id=$task_id" "task_root=$task_root" "attempt=$attempt"
			continue
		fi

		if (( uncommitted_review_retry == 0 )) && [[ -f "$result" ]]; then
			# A successful provider turn that did not execute one terminal review
			# command is not a durable control-plane transition. Give it exactly one
			# fresh-context corrective attempt before surfacing an explicit paused
			# review. This closes the silent-liveness gap without permitting an
			# unchanged manager loop.
			uncommitted_review_retry=1
			{
				printf 'task_id=%s\n' "$task_id"
				printf 'result_fingerprint=%s\n' "$result_content_fingerprint"
				printf 'corrective_attempts=1\n'
				printf 'scheduled_at=%s\n' "$(timestamp_utc)"
			} > "$review_retry_file.tmp.$$"
			chmod 600 "$review_retry_file.tmp.$$"
			mv "$review_retry_file.tmp.$$" "$review_retry_file"
			attempt=$((attempt + 1))
			review_thread_id=""
			fresh_context_pending=1
			manager_rotation_reason=uncommitted_review_recovery
			cat >> "$prompt_file" <<PROMPT

Corrective retry: the previous review turn returned successfully but did not consume RESULT_FILE and did not execute an ACCEPT, CHECKPOINT, REJECT, or BLOCK terminal command. Review exactly TASK_ID=$task_id in fresh context. You must now execute exactly one validator-compatible terminal review command. Do not merely report a recommendation or leave the result pending.
PROMPT
			log_event "MANAGER_REVIEW_UNCOMMITTED_RETRY task=$task_id root=$task_root attempt=$attempt"
			trace_event MANAGER_REVIEW_UNCOMMITTED_RETRY "task_id=$task_id" "task_root=$task_root" "attempt=$attempt"
			continue
		fi

		commit_fresh_manager_context

		log_event "MANAGER_REVIEW_LEFT_PENDING task=$task_id attempt=$attempt"
		trace_event MANAGER_REVIEW_PENDING "task_id=$task_id" "attempt=$attempt"
		printf 'Manager review exited without accepting, checkpointing, or rejecting task %s.\n' "$task_id" >&2
		exit "$pending_exit_status"
	fi

	# A manager command may have committed an accept/checkpoint/reject immediately before
	# the API stream failed. Never repeat a committed manager action.
	if manager_action_committed; then
		commit_fresh_manager_context
		log_event "MANAGER_REVIEW_FINISHED task=$task_id attempt=$attempt outcome=action_committed_before_process_failure status=$status"
		trace_event MANAGER_REVIEW_COMMITTED_AFTER_FAILURE "task_id=$task_id" "attempt=$attempt" "status=$status"
		printf 'Manager action for task %s was committed before the Codex process failed.\n' "$task_id"
		exit 0
	fi

	retry_kind="$(codex_provider_retry_kind "$classification" 2>/dev/null || true)"
	if [[ -n "$retry_kind" ]]; then
		retry_delay="$(codex_provider_retry_delay "$classification")"
		provider_retries=$((provider_retries + 1))
		[[ "$retry_kind" != quota ]] || quota_waits=$((quota_waits + 1))
		log_event "MANAGER_PROVIDER_WAIT task=$task_id thread_id=${review_thread_id:-none} kind=$retry_kind attempt=$attempt retry=$provider_retries delay_seconds=$retry_delay classification=$classification"
		if [[ "$retry_kind" == quota ]]; then
			printf 'Manager review for task %s has no provider quota; result and thread are preserved. Checking again in %s seconds (quota wait %s).\n' "$task_id" "$retry_delay" "$quota_waits" >&2
		else
			printf 'Manager review for task %s hit a transient provider/network failure; retrying in %s seconds.\n' "$task_id" "$retry_delay" >&2
		fi
		sleep "$retry_delay"

		if manager_action_committed; then
			log_event "MANAGER_REVIEW_FINISHED task=$task_id attempt=$attempt outcome=action_committed_during_provider_wait"
			trace_event MANAGER_REVIEW_COMMITTED_DURING_RETRY_WAIT "task_id=$task_id" "attempt=$attempt"
			exit 0
		fi
		[[ ! -e "$running" ]] || die "cannot retry manager review; running assignment appeared: $running"
		[[ ! -e "$lease" ]] || die "cannot retry manager review; worker lease appeared: $lease"
		[[ -f "$assignment_archive" ]] || die "cannot retry manager review; archived assignment disappeared: $assignment_archive"
		attempt=$((attempt + 1))
		log_event "MANAGER_PROVIDER_RETRY_STARTED task=$task_id thread_id=${review_thread_id:-none} kind=$retry_kind attempt=$attempt retry=$provider_retries"
		trace_event MANAGER_REVIEW_RETRY "task_id=$task_id" "kind=$retry_kind" "attempt=$attempt" "retry=$provider_retries"
		continue
	fi

	if codex_model_requires_narrow_prompt "$current_model" && [[ "$classification" == model_refusal_or_blocked_content ]]; then
		if (( fallback_stage == 0 )); then
			fallback_stage=1; attempt=$((attempt + 1))
			printf '\nRetry scope: review only RESULT_FILE and the bounded assignment; do not inspect unrelated directories.\n' >> "$prompt_file"
			log_event "MANAGER_TERRA_NARROW_RETRY task=$task_id classification=$classification"
			continue
		elif (( fallback_stage == 1 )) && [[ "$MANAGER_FALLBACK_MODEL" != "$current_model" ]]; then
			fallback_stage=2; current_model="$MANAGER_FALLBACK_MODEL"; attempt=$((attempt + 1))
			log_event "MANAGER_MODEL_FALLBACK task=$task_id classification=$classification model=$current_model"
			continue
		fi
	fi

	log_event "MANAGER_REVIEW_FAILED task=$task_id status=$status attempts=$attempt"
	trace_event MANAGER_REVIEW_FAILED "task_id=$task_id" "status=$status" "attempts=$attempt" "json_log=$json_log"
	exit "$status"
done
