#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
project_plan_exists && { printf 'Decomposition DAG already exists.\n'; exit 0; }
decomposition_candidate_matches_current_inputs || die 'no current full decomposition candidate exists'
[[ "$(decomposition_candidate_state_value status)" == REJECTED ]] ||
	die 'decision-evidence repair requires a rejected candidate'

candidate_dir="$(decomposition_candidate_state_value directory)"
architecture_source="$(decomposition_candidate_state_value architecture_directory -)"
rejection_log="$(decomposition_candidate_state_value rejection_log "$candidate_dir/rejection.log")"
[[ "$architecture_source" != - && -d "$architecture_source" ]] ||
	die 'decision-evidence repair requires an architecture registry'
grep -Eq 'accepted decision .* lacks repository evidence|accepted decision .* evidence is not committed at HEAD' "$rejection_log" ||
	die 'candidate rejection is not a mechanically repairable decision-evidence defect'

repair_dir="$PROJECT_TMP_DIR/decomposition-decision-evidence-repair-${candidate_dir##*/}"
rm -rf -- "$repair_dir"
mkdir -p "$repair_dir/architecture"
install -m 600 "$candidate_dir/dag.tsv" "$repair_dir/dag.tsv"
install -m 600 "$candidate_dir/coverage.tsv" "$repair_dir/coverage.tsv"
for name in invariants edges node-bindings health-gates debt; do
	install -m 600 "$architecture_source/$name.tsv" "$repair_dir/architecture/$name.tsv"
done

is_committed_repository_path()
{
	local path="$1"
	[[ -n "$path" && "$path" != - && "$path" != /* && "$path" != *'..'* && -f "$REPOSITORY/$path" ]] || return 1
	git -C "$REPOSITORY" ls-tree -r --name-only HEAD -- "$path" | grep -Fqx -- "$path"
}

clean_proposed_path()
{
	local value="$1" id="$2" first
	first="${value%%;*}"
	first="${first#\`}"
	first="${first%\`}"
	first="${first# }"
	first="${first% }"
	if [[ "$first" =~ ^[A-Za-z0-9._/-]+$ && "$first" != /* && "$first" != *'..'* ]]; then
		printf '%s\n' "$first"
	else
		printf 'design/architecture/%s.md\n' "$(printf '%s' "$id" | tr '[:upper:]_' '[:lower:]-')"
	fi
}

decisions_out="$repair_dir/architecture/decisions.tsv"
printf 'decision_id\tstatus\tproducer_node\tproblem\tchosen_contract\taffected_interfaces\tsupersedes\tevidence\n' > "$decisions_out"
while IFS=$'\t' read -r id status producer problem contract interfaces supersedes evidence; do
	[[ "$id" != decision_id ]] || continue
	if [[ "$status" == ACCEPTED ]] && ! is_committed_repository_path "$evidence"; then
		replacement=""
		IFS=',' read -r -a interface_list <<< "$interfaces"
		for interface in "${interface_list[@]}"; do
			interface="${interface# }"
			interface="${interface%%:*}"
			if is_committed_repository_path "$interface"; then
				replacement="$interface"
				break
			fi
		done
		[[ -n "$replacement" ]] ||
			die "accepted decision $id has no committed affected-interface anchor for deterministic evidence repair"
		evidence="$replacement"
	elif [[ "$status" == PROPOSED ]]; then
		evidence="$(clean_proposed_path "$evidence" "$id")"
	fi
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$id" "$status" "$producer" "$problem" "$contract" "$interfaces" "$supersedes" "$evidence" >> "$decisions_out"
done < "$architecture_source/decisions.tsv"
chmod 600 "$decisions_out"

set +e
"$HARNESS_BIN/manager-submit-decomposition" "$HARNESS_ENV_FILE" \
	"$repair_dir/dag.tsv" "$repair_dir/coverage.tsv" "$repair_dir/architecture"
status=$?
set -e
if project_plan_exists; then
	log_event "DECOMPOSITION_DECISION_EVIDENCE_REPAIRED source=$candidate_dir"
	printf 'Architecture decision evidence normalized and installed.\n'
	exit 0
fi
new_candidate_dir="$(decomposition_candidate_state_value directory -)"
if [[ "$new_candidate_dir" != - && "$new_candidate_dir" != "$candidate_dir" ]] &&
	decomposition_candidate_matches_current_inputs; then
	log_event "DECOMPOSITION_DECISION_EVIDENCE_PROGRESS previous=${candidate_dir##*/} current=${new_candidate_dir##*/} status=$(decomposition_candidate_state_value status -)"
	printf 'Architecture decision evidence normalized; continuing with the next bounded diagnostic.\n'
	exit 0
fi
(( status == 0 )) && die 'decision-evidence normalization returned success without installing or advancing the candidate'
die "decision-evidence normalization failed with status $status"
