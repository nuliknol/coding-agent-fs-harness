#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"
source "$SCRIPT_DIR/../lib/harness-sctm.sh"
[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"; ensure_project
pid_file="$(sctm_pid_file)"
[[ -f "$pid_file" ]] || { printf 'SCTM daemon is not running.\n'; exit 0; }
if ! sctm_pid_is_live; then
	rm -f "$pid_file"
	printf 'Removed stale SCTM daemon PID file.\n'
	exit 0
fi
pid="$(cat "$pid_file")"
kill "$pid" 2>/dev/null || true
for _ in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
kill -0 "$pid" 2>/dev/null && die "SCTM daemon PID $pid did not stop"
rm -f "$pid_file"
printf 'SCTM daemon stopped.\n'
