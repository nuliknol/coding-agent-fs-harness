#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-mode.sh"
harness_dispatch_mode "$SCRIPT_DIR/.." "${0##*/}" "$@"
source "$SCRIPT_DIR/../lib/harness-common.sh"

details=0
[[ "${1:-}" != --details ]] || { details=1; shift; }
[[ $# -eq 1 ]] || { printf 'Usage: %s [--details] ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
(( HARNESS_ARCHITECTURE_GUARDS == 1 )) || die 'architecture guards are disabled for this project'
architecture_require_registered

count_rows() { awk 'NR>1 {n++} END {print n+0}' "$1"; }
passed_decisions="$(awk -F '\t' 'FNR>1 && $2=="ACCEPTED" {seen[$1]=1} END {for(i in seen)n++; print n+0}' "$(architecture_decisions_file)" "$(architecture_decision_ledger_file)")"
passed_gates="$(awk -F '\t' 'NR>1 && $2 ~ /PASSED$/ {seen[$1]=1} END {for(i in seen)n++; print n+0}' "$(architecture_health_ledger_file)")"
printf 'Project: %s\nArchitecture guards: enabled\nRegistry: %s\n\n' "$PROJECT" "$(architecture_dir)"
printf 'Invariants: %s\n' "$(count_rows "$(architecture_invariants_file)")"
printf 'Decisions: %s (%s accepted)\n' "$(count_rows "$(architecture_decisions_file)")" "$passed_decisions"
printf 'Edge contracts: %s\n' "$(count_rows "$(architecture_edges_file)")"
printf 'Health gates: %s (%s passed)\n' "$(count_rows "$(architecture_health_gates_file)")" "$passed_gates"
printf 'Debt: %s total, %s unresolved critical, %s expired\n' "$(count_rows "$(architecture_debt_file)")" "$(architecture_open_critical_debt_count)" "$(architecture_expired_debt_count)"
if (( details )); then
	printf '\nNODE                      INVARIANTS                 DECISIONS(IN/OUT)          EDGES               HEALTH\n'
	while IFS=$'\t' read -r node inv consumes produces edges gates; do
		[[ "$node" != node_id ]] || continue
		printf '%-25s %-26s %-26s %-19s %s\n' "$node" "$inv" "$consumes/$produces" "$edges" "$gates"
	done < "$(architecture_node_bindings_file)"
	printf '\nOPEN DEBT\n'
	awk -F '\t' 'NR>1 && $10!="RESOLVED" {printf "%s severity=%s remediation=%s expires=%s status=%s\n",$1,$8,$7,$9,$10}' "$(architecture_debt_file)"
fi
