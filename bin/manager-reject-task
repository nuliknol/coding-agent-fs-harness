#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE TASK_ID REVIEW_NOTE_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 3 ]] || usage
load_harness_env "$1"
task_id="$2"
note_file="$3"

ensure_project
trace_init manager_reject_task
trace_script_start "$@"
trap 'trace_script_exit $?' EXIT
validate_task_id "$task_id"
[[ -f "$note_file" ]] || die "review note file does not exist: $note_file"
grep -Eq '^Improvement-Percent: (100|[1-9]?[0-9])%$' "$note_file" || die 'review note must contain Improvement-Percent: N% (0 through 100)'
acquire_project_lock

dir="$(project_dir)"
base="$(task_base "$task_id")"
root="$(task_root_id "$task_id")"
assignment_archive="$dir/archive/$base.assignment.md"
result="$dir/results/$base.result.md"
result_resource_guard="$(metadata_value "$result" Resource-Guard 2>/dev/null || true)"
[[ -n "$result_resource_guard" ]] || result_resource_guard="-"
result_workspace_changed="$(metadata_value "$result" Workspace-Changed 2>/dev/null || true)"
[[ "$result_workspace_changed" =~ ^[01]$ ]] || result_workspace_changed=0
result_workspace_after="$(metadata_value "$result" Workspace-Fingerprint-After 2>/dev/null || true)"
[[ "$result_workspace_after" =~ ^sha256:[0-9a-fA-F]{64}$ ]] || result_workspace_after="-"
initialize_task_progress "$task_id" "$assignment_archive"
current_progress="$(task_progress_percent "$root")"
improvement_percent="$(review_percent "$note_file" Improvement-Percent)"
progress_percent="$(review_percent "$note_file" Progress-Percent)"
if [[ -z "$progress_percent" ]]; then
	# Compatibility for an already-running pre-refactor manager turn. New turns
	# must report cumulative progress explicitly.
	progress_percent=$((current_progress + improvement_percent))
	(( progress_percent < 100 )) || progress_percent=99
	log_event "TASK_PROGRESS_MIGRATED task=$task_id inferred_progress=$progress_percent"
fi
validate_percent "$progress_percent" 'Progress-Percent'
(( progress_percent >= current_progress )) || die "Progress-Percent cannot decrease from $current_progress% to $progress_percent%"
(( progress_percent < 100 )) || die 'a rejected task must have Progress-Percent below 100%'

# Circuit-break a deterministic blocker rather than paying for unbounded
# no-op revisions.  The manager supplies the stable output hash/fingerprint
# only when the same unmet gate is being retried; different failures continue
# through normal bounded review.
blocking_fingerprint="$(awk -F': ' '$1 == "Blocking-Fingerprint" {print $2; exit}' "$note_file")"
circuit_breaker_recovery=0
manager_remediation_circuit_breaker=0
resource_decomposition_circuit_breaker=0
if [[ "$improvement_percent" == 0 ]]; then
	# Resource-fuse identity is machine-owned. Include the content-aware final
	# workspace so successive preserved edits cannot be collapsed into one
	# apparent no-progress blocker merely because HEAD and the dirty path set
	# remained unchanged.
	if [[ "$result_resource_guard" != "-" && "$result_workspace_after" != "-" ]]; then
		first_unmet="$(task_first_unmet_criterion "$task_id" 2>/dev/null || printf '-')"
		head_commit="$(git -C "$REPOSITORY" rev-parse HEAD 2>/dev/null || printf '-')"
		goal_outcome="$(metadata_value "$result" Goal-Outcome 2>/dev/null || printf '-')"
		blocking_fingerprint="sha256:$(printf '%s\n' "$root" "$first_unmet" "$head_commit" \
			"${goal_outcome:--}" "$result_resource_guard" "$result_workspace_after" |
			sha256sum | awk '{print $1}')"
		normalized_note="$note_file.resource-fingerprint.$$"
		awk -v fingerprint="$blocking_fingerprint" '
			$0 ~ /^Blocking-Fingerprint: / {next}
			{print}
			END {print ""; print "Blocking-Fingerprint: " fingerprint}
		' "$note_file" > "$normalized_note"
		chmod --reference="$note_file" "$normalized_note"
		mv "$normalized_note" "$note_file"
		log_event "TASK_RESOURCE_BLOCKING_FINGERPRINT_NORMALIZED task=$task_id root=$root workspace_changed=$result_workspace_changed workspace=$result_workspace_after fingerprint=$blocking_fingerprint"
	fi
	# Manager-remediation identity must include the typed boundary discovered by
	# the worker.  Root/criterion/HEAD alone collapses a new missing symbol or
	# prerequisite into an older blocker and can trip the circuit breaker while
	# deterministic recovery is still making progress through the dependency
	# graph.
	if [[ "$result_resource_guard" == "-" ]] &&
		assignment_is_manager_remediation "$assignment_archive" && [[ -f "$result" ]]; then
		first_unmet="$(task_first_unmet_criterion "$task_id" 2>/dev/null || printf '-')"
		head_commit="$(git -C "$REPOSITORY" rev-parse HEAD 2>/dev/null || printf '-')"
		goal_outcome="$(metadata_value "$result" Goal-Outcome 2>/dev/null || printf '-')"
		decomposition_reason="$(metadata_value "$result" Decomposition-Reason 2>/dev/null || printf '-')"
		acp_request_type="$(metadata_value "$result" ACP-Request-Type 2>/dev/null || printf '-')"
		acp_request_kind="$(metadata_value "$result" ACP-Request-Kind 2>/dev/null || printf '-')"
		acp_request_identifier="$(metadata_value "$result" ACP-Request-Identifier 2>/dev/null || printf '-')"
		remediation_scope="$(metadata_value "$assignment_archive" Remediation-Scope 2>/dev/null || printf '-')"
		context_paths="$(metadata_value "$assignment_archive" Context-Paths 2>/dev/null || printf '-')"
		blocking_fingerprint="sha256:$(printf '%s\n' "$root" "$first_unmet" "$head_commit" \
			"${goal_outcome:--}" "${decomposition_reason:--}" "${acp_request_type:--}" \
			"${acp_request_kind:--}" "${acp_request_identifier:--}" \
			"${remediation_scope:--}" "${context_paths:--}" | sha256sum | awk '{print $1}')"
		normalized_note="$note_file.manager-remediation-fingerprint.$$"
		awk -v fingerprint="$blocking_fingerprint" '
			$0 ~ /^Blocking-Fingerprint: / {next}
			{print}
			END {print ""; print "Blocking-Fingerprint: " fingerprint}
		' "$note_file" > "$normalized_note"
		chmod --reference="$note_file" "$normalized_note"
		mv "$normalized_note" "$note_file"
		log_event "MANAGER_REMEDIATION_BLOCKING_FINGERPRINT_NORMALIZED task=$task_id root=$root decomposition_reason=${decomposition_reason:--} request_type=${acp_request_type:--} request_kind=${acp_request_kind:--} request_identifier=$(printf '%q' "${acp_request_identifier:--}") fingerprint=$blocking_fingerprint"
	fi
	if [[ ! "$blocking_fingerprint" =~ ^sha256:[0-9a-fA-F]{64}$ ]]; then
		# This is machine-owned convergence metadata. Derive it from the stable
		# repository/criterion boundary when an otherwise valid rejection omits
		# the field; a formatting lapse must not become REVIEW_STALLED.
		first_unmet="$(task_first_unmet_criterion "$task_id" 2>/dev/null || printf '-')"
		head_commit="$(git -C "$REPOSITORY" rev-parse HEAD 2>/dev/null || printf '-')"
		goal_outcome=""
		result_file="$dir/results/$(task_base "$task_id").result.md"
		[[ ! -f "$result_file" ]] || goal_outcome="$(metadata_value "$result_file" Goal-Outcome)"
		blocking_fingerprint="sha256:$(printf '%s\n' "$root" "$first_unmet" "$head_commit" "${goal_outcome:--}" |
			sha256sum | awk '{print $1}')"
		printf '\nBlocking-Fingerprint: %s\n' "$blocking_fingerprint" >> "$note_file"
		log_event "TASK_BLOCKING_FINGERPRINT_DERIVED task=$task_id root=$root fingerprint=$blocking_fingerprint"
	fi
	matching_rejections=0
	matching_manager_remediations=0
	epoch_started=""
	epoch_file="$(task_root_liveness_epoch_file "$root")"
	[[ ! -f "$epoch_file" ]] || epoch_started="$(kv_file_value "$epoch_file" started_at 2>/dev/null || true)"
	shopt -s nullglob
	for prior_rejection in "$dir/archive/$PROJECT-task-$root.rejected.md" \
		"$dir/archive/$PROJECT-task-$root-revision-"*.rejected.md; do
		[[ -f "$prior_rejection" ]] || continue
		prior_rejected_at="$(metadata_value "$prior_rejection" Rejected-At)"
		# Resolution timestamps have one-second precision. A rejection archived in
		# the same second immediately before the operator opened a fresh liveness
		# epoch belongs to the old epoch, not the new one.
		if [[ -n "$epoch_started" && -n "$prior_rejected_at" ]] &&
			[[ "$prior_rejected_at" == "$epoch_started" || "$prior_rejected_at" < "$epoch_started" ]]; then
			continue
		fi
		if grep -Fqx 'Improvement-Percent: 0%' "$prior_rejection" &&
			grep -Fqx "Blocking-Fingerprint: $blocking_fingerprint" "$prior_rejection"; then
			matching_rejections=$((matching_rejections + 1))
			prior_assignment="${prior_rejection%.rejected.md}.assignment.md"
			if [[ -f "$prior_assignment" ]] && assignment_is_manager_remediation "$prior_assignment"; then
				matching_manager_remediations=$((matching_manager_remediations + 1))
			fi
		fi
	done
	if [[ "$result_resource_guard" != "-" && "$result_workspace_changed" == 0 ]] &&
		(( matching_rejections + 1 >= HARNESS_MAX_IDENTICAL_RESOURCE_FUSES )); then
		resource_decomposition_circuit_breaker=1
		log_event "TASK_CIRCUIT_BREAKER_RESOURCE_DECOMPOSITION task=$task_id root=$root guard=$result_resource_guard fingerprint=$blocking_fingerprint prior_matches=$matching_rejections limit=$HARNESS_MAX_IDENTICAL_RESOURCE_FUSES"
	elif assignment_is_manager_remediation "$assignment_archive" &&
		(( matching_manager_remediations + 1 >= HARNESS_MAX_IDENTICAL_MANAGER_REMEDIATION_BLOCKERS )); then
		manager_remediation_circuit_breaker=1
		log_event "TASK_CIRCUIT_BREAKER_ARCHITECTURE_REASSESSMENT task=$task_id root=$root fingerprint=$blocking_fingerprint prior_matches=$matching_manager_remediations limit=$HARNESS_MAX_IDENTICAL_MANAGER_REMEDIATION_BLOCKERS"
	elif (( HARNESS_MAX_IDENTICAL_BLOCKERS > 0 && matching_rejections + 1 >= HARNESS_MAX_IDENTICAL_BLOCKERS )); then
		circuit_breaker_recovery=1
		log_event "TASK_CIRCUIT_BREAKER_MANAGER_REMEDIATION task=$task_id root=$root fingerprint=$blocking_fingerprint prior_matches=$matching_rejections limit=$HARNESS_MAX_IDENTICAL_BLOCKERS"
	fi
fi
result_archive="$dir/archive/$base.rejected-result.md"
rejected="$dir/archive/$base.rejected.md"
stale_result_archive="$dir/archive/$base.rejected-stale-result.md"

archive_lingering_result()
{
	if [[ ! -f "$result" ]]; then
		return 0
	fi
	if [[ -f "$result_archive" ]]; then
		mv "$result" "$stale_result_archive"
		log_event "TASK_REJECTED_STALE_RESULT_ARCHIVED task=$task_id file=$stale_result_archive"
	else
		mv "$result" "$result_archive"
		log_event "TASK_REJECTED_RESULT_RECOVERED task=$task_id file=$result_archive"
	fi
}

mark_manager_remediation_decomposition_replan()
{
	local result_file="$1" reason blocker_class remediation_scope context_paths
	reason="$(metadata_value "$result_file" Decomposition-Reason)"
	# Compatibility for results produced before Decomposition-Reason existed.
	# Their historical contract explicitly meant exhausted mutation scope.
	[[ -n "$reason" ]] || reason=SCOPE_INCOMPLETE
	blocker_class="$(require_single_metadata_value "$assignment_archive" Blocker-Class \
		'manager remediation assignment')"
	remediation_scope="$(require_single_metadata_value "$assignment_archive" Remediation-Scope \
		'manager remediation assignment')"
	context_paths="$(metadata_value "$assignment_archive" Context-Paths)"
	case "$reason" in
		CONTEXT_INCOMPLETE)
			mark_root_needs_replan "$task_id" \
				'a fresh manager remediation proved its mutation scope correct but its bounded context capsule incomplete; retain the same write authority and add only the exact missing context paths or symbols' \
				MANAGER_REMEDIATION_CONTEXT_INCOMPLETE "$blocker_class" \
				"$remediation_scope" "$context_paths"
			;;
		SCOPE_INCOMPLETE)
			mark_root_needs_replan "$task_id" \
				'a fresh manager remediation proved its declared mutation scope insufficient; the next remediation must name the exact adjacent producer, representation, consumer, or validation seam and must not republish the exhausted scope unchanged' \
				MANAGER_REMEDIATION_SCOPE_EXHAUSTED "$blocker_class" "$remediation_scope"
			;;
		VALIDATION_PREREQUISITE)
			mark_root_needs_replan "$task_id" \
				'a fresh manager remediation proved that its assigned validation cannot reach the named boundary from the current path authority; the next remediation must move to the exact adjacent build, test, producer, or consumer prerequisite and must not republish the exhausted scope unchanged' \
				MANAGER_REMEDIATION_SCOPE_EXHAUSTED "$blocker_class" "$remediation_scope"
			;;
		TASK_TOO_BROAD|RESOURCE_LIMIT)
			mark_root_needs_replan "$task_id" \
				"manager remediation requested a bounded follow-up for typed decomposition reason $reason" \
				MANAGER_REMEDIATION_CONTINUATION "$blocker_class" "$remediation_scope" "$context_paths"
			;;
		*) die "invalid manager remediation Decomposition-Reason: $reason" ;;
	esac
}

preserve_manager_remediation_transition_before_reassessment()
{
	local result_file="$1"
	[[ -f "$result_file" ]] || return 0
	[[ "$(metadata_value "$result_file" Goal-Outcome)" == NEEDS_DECOMPOSITION ]] || return 0
	assignment_is_manager_remediation "$assignment_archive" || return 0
	# Compile the typed next transition before replacing it with an investigation
	# marker. mark_root_architecture_reassessment will copy this bounded authority
	# into the marker and remove the live replan transaction atomically.
	mark_manager_remediation_decomposition_replan "$result_file" >/dev/null
}

mark_context_closure_replan()
{
	local result_file="$1" condition action provider reason
	condition="$(metadata_value "$result_file" Closure-Condition)"
	action="$(metadata_value "$result_file" Closure-Repair-Action)"
	provider="$(metadata_value "$result_file" Closure-Repair-Provider)"
	[[ -n "$condition" && -n "$action" ]] || return 1
	[[ -n "$provider" ]] || provider=repository-index
	case "$action" in
		GRAFT_GRAPH_CUTS)
			reason="Context Closure exceeded its Luna resource boundary; graft independently verifiable children from the recorded graph cuts"
			;;
		REFRESH_INDEX_OR_OVERLAY)
			reason="Context Closure is missing indexed workspace evidence; refresh only the implicated provider or live overlay before rebuilding the same leaf"
			;;
		REPAIR_AUTHORITY_BINDING)
			reason="Context Closure is missing accepted architecture authority; repair the exact binding before rebuilding the same leaf"
			;;
		*) reason="Context Closure requested typed repair action $action" ;;
	esac
	mark_root_needs_replan "$task_id" "$reason" CONTEXT_CLOSURE_REPAIR "" "" "" \
		"$condition" "$action" "$provider"
}

if [[ -f "$rejected" ]]; then
	archive_lingering_result
	result_resource_guard="$(metadata_value "$result_archive" Resource-Guard 2>/dev/null || true)"
	[[ -n "$result_resource_guard" ]] || result_resource_guard="-"
	goal_outcome="$(metadata_value "$result_archive" Goal-Outcome 2>/dev/null || true)"
	manager_remediation_decomposition=0
	if [[ "$goal_outcome" == NEEDS_DECOMPOSITION ]] &&
		assignment_is_manager_remediation "$assignment_archive"; then
		manager_remediation_decomposition=1
	fi
	goal_record_manager_decision "$task_id" REJECTED
	if [[ "$result_resource_guard" != "-" || "$goal_outcome" == HARD_BLOCKED ||
		"$manager_remediation_decomposition" == 1 ]]; then
		clear_worker_thread_for_root "$task_id" rejected-boundary-requires-fresh-context
		clear_worker_goal_thread_for_task "$task_id" rejected-boundary-requires-fresh-context
	else
		retain_worker_thread_for_rejection "$task_id"
	fi
	trace_event TASK_REJECT_IDEMPOTENT "task_id=$task_id" "rejected_file=$rejected"
	# A specific repeated-remediation/resource circuit is itself the stronger
	# liveness conclusion. Preserve it before the generic aggregate guard so an
	# idempotent retry cannot erase the precise investigation and recovery type.
	if (( manager_remediation_circuit_breaker == 1 )); then
		preserve_manager_remediation_transition_before_reassessment "$result_archive"
		mark_root_architecture_reassessment "$task_id" REPEATED_MANAGER_REMEDIATION_BLOCKER \
			"identical manager-remediation blocker $blocking_fingerprint reached the bounded limit ($HARNESS_MAX_IDENTICAL_MANAGER_REMEDIATION_BLOCKERS) without criterion gain" \
			"assignment=$assignment_archive review=$rejected" >/dev/null
		printf '%s\n' "$(task_root_architecture_reassessment_file "$root")"
	elif (( resource_decomposition_circuit_breaker == 1 )); then
		mark_root_architecture_reassessment "$task_id" REPEATED_RESOURCE_DECOMPOSITION_FAILURE \
			"the same $result_resource_guard-bounded execution context exhausted repeatedly without criterion gain" \
			"assignment=$assignment_archive review=$rejected evidence=$dir/control/$base.worker-evidence-digest.md" >/dev/null
		printf '%s\n' "$(task_root_architecture_reassessment_file "$root")"
	elif ! enforce_root_liveness_or_reassess "$task_id"; then
		printf '%s\n' "$(task_root_architecture_reassessment_file "$root")"
	elif [[ "$goal_outcome" == HARD_BLOCKED ]]; then
		mark_root_needs_replan "$task_id" \
			'a worker-reported hard boundary was not accepted; inspect the smallest adjacent repository-local declaration, producer, consumer, or validation prerequisite with fresh manager context before another implementation attempt' \
			HARD_BLOCK_SCOPE_DIAGNOSTIC LOCAL_SCOPE_PREREQUISITE \
			"adjacent contract or implementation authority outside $(metadata_value "$assignment_archive" Allowed-Scope)"
	elif [[ "$goal_outcome" == NEEDS_DECOMPOSITION ]] &&
		assignment_is_manager_remediation "$assignment_archive"; then
		mark_manager_remediation_decomposition_replan "$result_archive"
	elif ! enforce_root_liveness_or_reassess "$task_id"; then
		printf '%s\n' "$(task_root_architecture_reassessment_file "$root")"
	elif [[ -f "$result_archive" &&
		"$(metadata_value "$result_archive" Goal-Outcome)" == NEEDS_DECOMPOSITION ]]; then
		if metadata_value "$result_archive" Closure-Repair-Action | grep -qv '^$'; then
			mark_context_closure_replan "$result_archive"
		elif [[ "$result_resource_guard" != "-" ]]; then
			mark_root_needs_replan "$task_id" \
				"worker execution context reached the $result_resource_guard fuse; use its bounded evidence to decompose or restate the semantic episode" \
				RESOURCE_NEEDS_DECOMPOSITION
		else
			mark_root_needs_replan "$task_id" \
				'worker leaf goal requested criterion decomposition or a materially different strategy' \
				GOAL_NEEDS_DECOMPOSITION
		fi
	else
		printf '%s\n' "$rejected"
	fi
	exit 0
fi

[[ -f "$result" ]] || die "result does not exist: $task_id"
goal_outcome="$(metadata_value "$result" Goal-Outcome)"

mv "$result" "$result_archive"
acp_record_manager_disposition "$result_archive" MANAGER_REPLAN "$note_file"
tmp="$rejected.tmp.$$"
{
	printf '# Rejected Task\n\n'
	printf 'Project: %s\n\n' "$PROJECT"
	printf 'Task-ID: %s\n\n' "$task_id"
	printf 'Environment-File: %s\n\n' "$HARNESS_ENV_FILE"
	printf 'Rejected-At: %s\n\n' "$(timestamp_utc)"
	printf '## Review notes\n\n'
	cat "$note_file"
	printf '\n'
} > "$tmp"
chmod 600 "$tmp"
mv "$tmp" "$rejected"
update_task_progress "$task_id" "$progress_percent" "$improvement_percent" REJECT "$note_file"
goal_record_manager_decision "$task_id" REJECTED
if [[ "$result_resource_guard" != "-" || "$goal_outcome" == HARD_BLOCKED ]] ||
	{ [[ "$goal_outcome" == NEEDS_DECOMPOSITION ]] &&
		assignment_is_manager_remediation "$assignment_archive"; }; then
	clear_worker_thread_for_root "$task_id" rejected-boundary-requires-fresh-context
	clear_worker_goal_thread_for_task "$task_id" rejected-boundary-requires-fresh-context
else
	retain_worker_thread_for_rejection "$task_id"
fi
log_event "TASK_REJECTED task=$task_id"
trace_event TASK_REJECTED "task_id=$task_id" "rejected_file=$rejected" "result_archive=$result_archive" "note_file=$note_file"
# A repeated-remediation/resource circuit is more specific than an aggregate
# root-review/replan fuse and must survive as the durable pause reason. The
# typed remediation transition is first compiled into NEEDS_REPLAN so the
# architecture marker can preserve it for an explicitly authorized recovery.
if (( manager_remediation_circuit_breaker == 1 )); then
	preserve_manager_remediation_transition_before_reassessment "$result_archive"
	mark_root_architecture_reassessment "$task_id" REPEATED_MANAGER_REMEDIATION_BLOCKER \
		"identical manager-remediation blocker $blocking_fingerprint reached the bounded limit ($HARNESS_MAX_IDENTICAL_MANAGER_REMEDIATION_BLOCKERS) without criterion gain" \
		"assignment=$assignment_archive review=$rejected" >/dev/null
	printf '%s\n' "$(task_root_architecture_reassessment_file "$root")"
elif (( resource_decomposition_circuit_breaker == 1 )); then
	mark_root_architecture_reassessment "$task_id" REPEATED_RESOURCE_DECOMPOSITION_FAILURE \
		"the same $result_resource_guard-bounded execution context exhausted repeatedly without criterion gain" \
		"assignment=$assignment_archive review=$rejected evidence=$dir/control/$base.worker-evidence-digest.md" >/dev/null
	printf '%s\n' "$(task_root_architecture_reassessment_file "$root")"
# All other specialized recovery remains subordinate to the monotonic root
# boundary. HARD_BLOCKED and ordinary typed decompositions cannot recursively
# mint leaves after the configured root limits are exhausted.
elif ! enforce_root_liveness_or_reassess "$task_id"; then
	printf '%s\n' "$(task_root_architecture_reassessment_file "$root")"
elif [[ "$goal_outcome" == HARD_BLOCKED ]]; then
	replan_marker="$(mark_root_needs_replan "$task_id" \
		'a worker-reported hard boundary was not accepted; inspect the smallest adjacent repository-local declaration, producer, consumer, or validation prerequisite with fresh manager context before another implementation attempt' \
		HARD_BLOCK_SCOPE_DIAGNOSTIC LOCAL_SCOPE_PREREQUISITE \
		"adjacent contract or implementation authority outside $(metadata_value "$assignment_archive" Allowed-Scope)")"
	printf '%s\n' "$replan_marker"
elif [[ "$goal_outcome" == NEEDS_DECOMPOSITION ]] &&
	assignment_is_manager_remediation "$assignment_archive"; then
	replan_marker="$(mark_manager_remediation_decomposition_replan "$result_archive")"
	printf '%s\n' "$replan_marker"
elif (( circuit_breaker_recovery == 1 )); then
	replan_marker="$(mark_root_needs_replan "$task_id" \
		"identical local blocker fingerprint $blocking_fingerprint reached limit $HARNESS_MAX_IDENTICAL_BLOCKERS; manager remediation is required" \
		DETERMINISTIC_BLOCKER)"
	printf '%s\n' "$replan_marker"
elif [[ "$goal_outcome" == NEEDS_DECOMPOSITION ]]; then
	if metadata_value "$result_archive" Closure-Repair-Action | grep -qv '^$'; then
		replan_marker="$(mark_context_closure_replan "$result_archive")"
	elif [[ "$result_resource_guard" != "-" ]]; then
		if [[ "$result_workspace_changed" == 1 ]]; then
			replan_marker="$(mark_root_needs_replan "$task_id" \
				"worker changed the preserved workspace before reaching the $result_resource_guard fuse; publish a fresh VERIFICATION_ONLY leaf for the exact change before further implementation" \
				RESOURCE_PROGRESS_NEEDS_VERIFICATION)"
		else
			replan_marker="$(mark_root_needs_replan "$task_id" \
				"worker execution context reached the $result_resource_guard fuse; use its bounded evidence to decompose or restate the semantic episode" \
				RESOURCE_NEEDS_DECOMPOSITION)"
		fi
	else
		replan_marker="$(mark_root_needs_replan "$task_id" \
			'worker leaf goal requested criterion decomposition or a materially different strategy' \
			GOAL_NEEDS_DECOMPOSITION)"
	fi
	printf '%s\n' "$replan_marker"
elif replan_marker="$(maybe_mark_root_needs_replan "$task_id" REJECT)"; then
	printf '%s\n' "$replan_marker"
else
	printf '%s\n' "$rejected"
fi
