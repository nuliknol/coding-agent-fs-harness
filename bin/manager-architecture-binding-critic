#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
require_manager_codex
project_plan_exists && { printf 'Decomposition DAG already exists.\n'; exit 0; }
decomposition_dag_candidate_matches_current_inputs || die 'architecture binding requires a current staged DAG candidate'
[[ "$(decomposition_dag_candidate_state_value status)" == STAGED ]] || die 'architecture binding requires a STAGED DAG candidate'
architecture_fit_is_accepted || die 'architecture binding requires a current accepted architecture-fit review or force waiver'

trace_init manager_architecture_binding_critic
trace_script_start "$@"
trap 'trace_script_exit $?' EXIT
dir="$(project_dir)"
dag="$(decomposition_dag_candidate_state_value dag)"
coverage="$(decomposition_dag_candidate_state_value coverage)"
prompt="$dir/control/manager-architecture-binding-critic.prompt.md"
fit_report="$(architecture_fit_state_value report force-waiver)"
[[ "$fit_report" == /* ]] || fit_report="$REPOSITORY/$fit_report"
binding_capsule="$dir/control/manager-architecture-binding.context.md"
binding_slice_args=()
[[ ! -s "$dir/control/repository-architecture-slice.md" ]] ||
	binding_slice_args=(--architecture-slice "$dir/control/repository-architecture-slice.md")
binding_authority_args=()
[[ ! -f "$fit_report" ]] || binding_authority_args+=(--authority-file "$fit_report")
python3 "$HARNESS_HOME/tools/build_architecture_fit_capsule.py" \
	--purpose architecture-binding \
	--project "$PROJECT" \
	--specification-sha256 "$(specification_sha256)" \
	--repository-baseline "$(specification_review_repository_baseline)" \
	--domain-profiles-sha256 "$(domain_profiles_sha256)" \
	--repository "$REPOSITORY" \
	--review-report "$REPOSITORY/$(specification_review_state_value report)" \
	--facts "$REPOSITORY/$(specification_review_state_value facts)" \
	--obligations "$(specification_obligations_file)" \
	--relations "$(specification_relations_file)" \
	--dag "$dag" \
	--coverage "$coverage" \
	"${binding_slice_args[@]}" \
	"${binding_authority_args[@]}" \
	--max-bytes "$HARNESS_ARCHITECTURE_BINDING_CAPSULE_MAX_BYTES" \
	--output "$binding_capsule.tmp.$$"
chmod 600 "$binding_capsule.tmp.$$"
mv "$binding_capsule.tmp.$$" "$binding_capsule"
binding_capsule_sha="$(sha256sum "$binding_capsule" | awk '{print $1}')"
binding_implementation_sha="$({
	sha256sum "$0" "$HARNESS_HOME/tools/build_architecture_fit_capsule.py" "$HARNESS_BIN/codex-exec-jsonl"
	printf 'read_lines=%s\nread_bytes=%s\ncommand_bytes=%s\n' \
		"$HARNESS_VALIDATION_OUTPUT_MAX_LINES" "$HARNESS_VALIDATION_OUTPUT_MAX_BYTES" \
		"$HARNESS_MAX_AGENT_COMMAND_OUTPUT_BYTES"
} | sha256sum | awk '{print $1}')"
recovery_marker="$dir/control/startup-recoverable.env"
if [[ -f "$recovery_marker" ]] &&
	[[ "$(kv_file_value "$recovery_marker" state)" == RECOVERABLE ]] &&
	[[ "$(kv_file_value "$recovery_marker" stage)" == architecture_binding ]] &&
	[[ "$(kv_file_value "$recovery_marker" specification_sha256)" == "$(specification_sha256)" ]] &&
	[[ "$(kv_file_value "$recovery_marker" repository_baseline)" == "$(specification_review_repository_baseline)" ]] &&
	[[ "$(kv_file_value "$recovery_marker" domain_profiles_sha256)" == "$(domain_profiles_sha256)" ]] &&
	[[ "$(kv_file_value "$recovery_marker" input_sha256)" == "$binding_capsule_sha" ]] &&
	[[ "$(kv_file_value "$recovery_marker" harness_implementation_sha256)" == "$binding_implementation_sha" ]]; then
	printf 'Architecture-binding startup remains recoverable; refusing to replay the unchanged failed input. Fix or update the harness, then restart: %s\n' "$recovery_marker" >&2
	exit 7
elif [[ -f "$recovery_marker" ]]; then
	resolved_marker="$dir/logs/startup-recovery-resumed-$(timestamp_compact_utc)-$$.env"
	mv "$recovery_marker" "$resolved_marker"
	log_event "STARTUP_RECOVERY_RESUMED stage=architecture_binding prior=$resolved_marker resume_from=staged_decomposition_dag input=$binding_capsule"
fi

{
cat <<PROMPT
You are a fresh Sol architecture-binding planner for a filesystem-backed coding harness. Do not edit the repository and do not redesign or re-decompose the fixed DAG.

ENV_FILE=$HARNESS_ENV_FILE
HARNESS_BIN=$HARNESS_BIN
PROJECT=$PROJECT
REPOSITORY=$REPOSITORY
PROJECT_TMP_DIR=$PROJECT_TMP_DIR
AGENT_PHASE=architecture_binding
ARCHITECTURE_BINDING_CAPSULE_FILE=$binding_capsule
ARCHITECTURE_BINDING_CAPSULE_SHA256=$binding_capsule_sha
ARCHITECTURE_GUARDS=$HARNESS_ARCHITECTURE_GUARDS
REVIEW_READ_MAX_LINES=$HARNESS_VALIDATION_OUTPUT_MAX_LINES
REVIEW_READ_MAX_BYTES=$HARNESS_VALIDATION_OUTPUT_MAX_BYTES
MAX_NODE_OWNERSHIP_BOUNDARIES=$HARNESS_CONTEXT_CLOSURE_MAX_OWNERSHIP_BOUNDARIES

The architecture-fit decision and fixed DAG/coverage are durable and authoritative in the deterministic capsule embedded below. Its binding projection contains every node, architecture-relevant dependency/scope/symbol field, deterministic node validation reference, and every obligation-to-node assignment. Verbose task and coverage evidence prose is intentionally represented by the authoritative DAG/coverage hashes instead of being replayed into context. Do not open or reread ARCHITECTURE_BINDING_CAPSULE_FILE through shell commands. Do not open the human specification, specification review report, facts/obligations/relations/inventory files, domain profiles, complete architecture slice, architecture-fit report, standalone DAG/coverage files, development policy, harness source, unrelated Git history, prior agent logs, or broad source trees. Do not change the fixed DAG or coverage.

Only when the capsule leaves one exact validation binding unresolved may you inspect repository source. Inspect exactly one source file and one exact source window in that action, only at a path already named by the capsule. Every shell read has one content source only and must end with both \`head -n $HARNESS_VALIDATION_OUTPUT_MAX_LINES\` and \`head -c $HARNESS_VALIDATION_OUTPUT_MAX_BYTES\`. Never use cat for source or document inspection. Never use unbounded sed, awk, rg, grep, find, git diff, compiler output, or test output. Never concatenate, loop over, or combine multiple source/document reads in one action. Every shell action has one aggregate hard transcript budget of REVIEW_READ_MAX_LINES lines and REVIEW_READ_MAX_BYTES bytes across stdout and stderr. If one bounded excerpt cannot close the binding, terminate with the exact unresolved fixed-DAG seam; do not explore interactively.

Audit component ownership before binding the fixed DAG. For each contract, architecture, producer, adopter, or delivery node, use its covered obligation source locations to check any specification-declared component owner and principal source path. A node bound to a downstream facade, compiler, transport, or presentation file cannot stand in for a separately named producer/adopter component. Reject only when the capsule contains enough exact evidence to repair the contradiction; an inferred component label without its corrective repository path or contract boundary is not actionable rejection authority. If the fixed DAG contradicts governing ownership, do not manufacture architecture bindings that make it appear consistent. Instead terminate with a machine-actionable diagnostic listing, for every offender: node ID, obligation ID, current path/symbol and role, exact corrective owner path/symbol or boundary, required DAG field/dependency changes, and the capsule evidence that proves that correction. State every offender in one response so the bounded repair does not pay one Sol turn per row.

If ARCHITECTURE_GUARDS=1 and the DAG is exactly one dependency-free LOW/LUNA TEST_IMPLEMENTATION or VERIFICATION_ONLY node, submit it with '-' as ARCH_DIR. Otherwise create ARCH_DIR under PROJECT_TMP_DIR containing six exact tab-separated files.

invariants.tsv:
invariant_id<TAB>category<TAB>authority<TAB>severity<TAB>statement<TAB>scope<TAB>source_requirement<TAB>validation_kind<TAB>validation_ref<TAB>affected_nodes

decisions.tsv:
decision_id<TAB>status<TAB>producer_node<TAB>problem<TAB>chosen_contract<TAB>affected_interfaces<TAB>supersedes<TAB>evidence

edges.tsv:
edge_id<TAB>producer_node<TAB>consumer_node<TAB>contract_artifact<TAB>public_symbols<TAB>ownership_model<TAB>representation<TAB>versioning_rule<TAB>compatibility_validation<TAB>decision_ids<TAB>invariant_ids

node-bindings.tsv:
node_id<TAB>invariant_ids<TAB>consumes_decisions<TAB>produces_decisions<TAB>edge_contracts<TAB>health_gates

health-gates.tsv:
gate_id<TAB>trigger_node<TAB>depends_on<TAB>validation<TAB>severity<TAB>invariant_ids<TAB>edge_ids

debt.tsv:
debt_id<TAB>introduced_by_task<TAB>introduced_by_commit<TAB>category<TAB>affected_invariants<TAB>consequence<TAB>remediation_node<TAB>severity<TAB>expires_at<TAB>status<TAB>waiver_authority

Use '-' for intentionally empty identifiers. Every DAG node has exactly one binding. Use only invariant categories CANONICAL_REPRESENTATION, CONCURRENCY, DEPENDENCY_CYCLE, DEVICE_AUTHORITY, ERROR_MODEL, LAYERING, OTHER, OWNERSHIP, PERFORMANCE, PUBLIC_API, SECURITY, SERIALIZATION. Use only INFO, WARNING, or CRITICAL severity and only COMMAND or REVIEW validation_kind; mandatory/MUST/HARD requirements map to CRITICAL. SPECIFIED invariants cite original obligations; DERIVED invariants are necessary consequences; PROPOSED invariants do not constrain implementation. Every API, representation, ownership, serialization, concurrency, or error contract crossing a dependency has an edge. A DAG depends_on entry used only for scheduling, evidence ordering, validation, documentation, or integration sequencing is not an architecture edge. Do not create one edge per DAG dependency. Create only the smallest set of semantic contracts actually crossing component or authority boundaries. contract_artifact is '-', a bounded repository-relative path, or decision:DECISION_ID. Decision references also appear in decision_ids. Decision-producing nodes record explicit durable decisions; implementation children consume accepted decisions rather than rediscovering them. A projection validation_ref beginning with FOCUSED: is already a valid review-attested descriptor and may be copied directly into invariant, edge, or gate validation fields.

The compiled Context Closure contract permits at most MAX_NODE_OWNERSHIP_BOUNDARIES distinct ownership edges incident on any Luna node. Before submission, count each edge once for its producer and once for its consumer and keep every node at or below that exact limit. This is a hard registry-admission constraint, not permission to omit a real contract: when a coherent node would require more boundaries, reject it with the complete machine-actionable graph-cut diagnostic required above so the DAG can be split before another binding pass.

The decisions.tsv evidence field is exactly one repository-relative path, never prose, a command, a symbol list, or a semicolon-separated explanation. An ACCEPTED decision must cite one existing file committed at HEAD; use the most direct affected interface that already embodies the decision. A decision that its producer node still needs to record is PROPOSED and names the single repository-relative decision artifact that node will create (for example design/architecture/dec-foo.md). Do not mark a future decision ACCEPTED merely because architecture fit accepted the repository foundation.

Bind milestone gates after coherent groups and final integration. Health-gate severity is exactly WARNING or CRITICAL. A health gate's depends_on field contains DAG node IDs, not health-gate IDs, and never contains its own trigger node. Bind each gate only to the node named by its trigger_node. Every invariant validation_ref with validation_kind COMMAND, every edge compatibility_validation other than REVIEW, and every health-gate validation is machine-executable: write either an actual shell command or a review-attested descriptor beginning exactly FOCUSED:, INCREMENTAL:, or CLEAN_GLOBAL:. Never put an English imperative such as "Run the test" or "Configure the build" in an executable validation field. Use a review-attested descriptor when the bounded manager review reproduces the node's validation and the registry only needs to bind that evidence class. Every executable command uses the focused selector already owned by the fixed DAG. Never require an unrelated broad aggregate to exit zero. When an aggregate is useful as baseline evidence, capture or tolerate its exit and assert the owned stage result separately. HARNESS_BROAD_GATE_REQUIRED=1 is permitted only when the human specification explicitly requires whole-project aggregate success. Keep verbose build/test output in PROJECT_TMP_DIR logs and print only bounded tails on failure. An invariant's affected_nodes exactly matches nodes whose bindings contain it. Start debt.tsv empty except for explicitly forced redesign debt already required by the accepted force waiver.

Submit the fixed DAG, fixed coverage, and architecture registry once:

$HARNESS_BIN/manager-submit-decomposition "$HARNESS_ENV_FILE" "$dag" "$coverage" ARCH_DIR

Pass '-' instead of ARCH_DIR only for the deterministic single-test profile described above. If deterministic validation rejects the candidate, terminate immediately; harness-start will preserve it and invoke a bounded repair-only turn. Do not repair schema inside this global architecture-binding turn. After success, terminate. Never publish work or run implementation tests.
PROMPT
printf '\n## Embedded deterministic architecture-binding capsule\n\n'
cat "$binding_capsule"
} > "$prompt.tmp.$$"
chmod 600 "$prompt.tmp.$$"
mv "$prompt.tmp.$$" "$prompt"

attempt=1
while true; do
	stamp="$(timestamp_compact_utc)"
	json="$dir/logs/manager-architecture-binding-critic-$stamp-attempt-$(printf '%03d' "$attempt").jsonl"
	stderr="$dir/logs/manager-architecture-binding-critic-$stamp-attempt-$(printf '%03d' "$attempt").stderr.log"
	message="$dir/logs/manager-architecture-binding-critic-$stamp-attempt-$(printf '%03d' "$attempt").md"
	set +e
	"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" decomposition "$DECOMPOSITION_MODEL" "$prompt" "$json" "$stderr" "$message"
	status=$?
	set -e
	if project_plan_exists; then
		log_event "ARCHITECTURE_BINDING_ACCEPTED nodes=$(project_plan_total_count) attempts=$attempt"
		printf 'Architecture bindings accepted for %s DAG nodes.\n' "$(project_plan_total_count)"
		exit 0
	fi
	if decomposition_candidate_matches_current_inputs &&
		[[ "$(decomposition_candidate_state_value status)" == REJECTED ]]; then
		log_event "ARCHITECTURE_BINDING_REPAIR_REQUIRED attempts=$attempt"
		printf 'Architecture binding candidate requires deterministic repair.\n'
		exit 0
	fi
	classification="$(kv_file_value "${json%.jsonl}.classification" classification 2>/dev/null || true)"
	if [[ "$classification" == agent_command_output_budget_exceeded ]]; then
		classification_file="${json%.jsonl}.classification"
		{
			printf 'state=RECOVERABLE\n'
			printf 'stage=architecture_binding\n'
			printf 'resume_from=staged_decomposition_dag\n'
			printf 'classification=%s\n' "$classification"
			printf 'offending_input=%s\n' "$binding_capsule"
			printf 'input_sha256=%s\n' "$binding_capsule_sha"
			printf 'prompt=%s\n' "$prompt"
			printf 'prompt_sha256=%s\n' "$(sha256sum "$prompt" | awk '{print $1}')"
			printf 'classification_file=%s\n' "$classification_file"
			printf 'jsonl=%s\n' "$json"
			printf 'specification_review_report=%s\n' "$(specification_review_report_relative_path)"
			printf 'architecture_fit_report=%s\n' "$(architecture_fit_state_value report force-waiver)"
			printf 'specification_sha256=%s\n' "$(specification_sha256)"
			printf 'repository_baseline=%s\n' "$(specification_review_repository_baseline)"
			printf 'domain_profiles_sha256=%s\n' "$(domain_profiles_sha256)"
			printf 'harness_implementation_sha256=%s\n' "$binding_implementation_sha"
			printf 'recorded_at=%s\n' "$(timestamp_utc)"
		} > "$recovery_marker.tmp.$$"
		chmod 600 "$recovery_marker.tmp.$$"
		mv "$recovery_marker.tmp.$$" "$recovery_marker"
		log_event "STARTUP_RECOVERABLE stage=architecture_binding classification=$classification input=$binding_capsule input_sha256=$binding_capsule_sha classification_file=$classification_file resume_from=staged_decomposition_dag"
		printf 'Architecture-binding startup paused recoverably after a command-output limit hit; staged DAG is preserved: %s\n' "$recovery_marker" >&2
		exit 7
	fi
	retry_kind="$(codex_provider_retry_kind "$classification" 2>/dev/null || true)"
	if [[ -n "$retry_kind" ]]; then
		delay="$(codex_provider_retry_delay "$classification")"
		printf 'Architecture-binding provider retry in %s seconds (%s).\n' "$delay" "$retry_kind" >&2
		sleep "$delay"
		attempt=$((attempt + 1))
		continue
	fi
	if (( status == 0 )); then
		# The prompt explicitly permits a clean exit when the fixed DAG or its
		# coverage contradicts governing architecture ownership. Preserve that
		# critic decision as the staged DAG's rejection diagnostic so the normal
		# bounded DAG-repair loop can correct it. Previously this valid critic
		# outcome was collapsed into a generic startup failure.
		[[ -s "$message" ]] || die 'architecture-binding critic exited without submitting a candidate or diagnostic'
		candidate_dir="$(decomposition_dag_candidate_state_value directory)"
		rejection_log="$candidate_dir/architecture-binding-rejection.md"
		{
			printf 'ERROR: architecture-binding critic rejected the fixed DAG/coverage\n\n'
			cat "$message"
		} > "$rejection_log.tmp.$$"
		chmod 600 "$rejection_log.tmp.$$"
		mv "$rejection_log.tmp.$$" "$rejection_log"
		candidate_state="$(decomposition_dag_candidate_state_file)"
		sed -i 's/^status=.*/status=REJECTED/' "$candidate_state"
		sed -i '/^rejection_stage=/d; /^rejection_log=/d; /^rejected_at=/d' "$candidate_state"
		printf 'rejection_stage=architecture_binding\n' >> "$candidate_state"
		printf 'rejection_log=%s\n' "$rejection_log" >> "$candidate_state"
		printf 'rejected_at=%s\n' "$(timestamp_utc)" >> "$candidate_state"
		log_event "ARCHITECTURE_BINDING_DAG_REJECTED attempts=$attempt diagnostic=$rejection_log"
		printf 'Architecture binding rejected the fixed DAG; diagnostic preserved for bounded repair: %s\n' "$rejection_log"
		exit 0
	fi
	die "architecture-binding critic failed with status $status; see $json"
done
