#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
project_plan_uses_dag || die 'decomposition metrics require a v2 decomposition DAG'

dir="$(project_dir)"
report="$dir/control/decomposition-metrics.tsv"
nodes_total="$(project_plan_total_count)"
nodes_complete="$(project_plan_complete_count)"
planned_coding_nodes="$(awk -F '\t' 'NR>1 && $9 ~ /^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION)$/ {n++} END {print n+0}' "$(project_decomposition_plan_file)")"
planned_luna_coding_nodes="$(awk -F '\t' 'NR>1 && $9 ~ /^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION)$/ && $11=="LUNA" {n++} END {print n+0}' "$(project_decomposition_plan_file)")"
luna_assignments=0
terra_assignments=0
luna_complete=0
luna_failed=0
terra_complete=0
terra_failed=0
luna_coding_assignments=0
terra_coding_assignments=0
terra_decision_assignments=0
terminal_goals=0
identical_iterations=0
total_iterations=0
verified_items=0
replans=0
worker_input=0
worker_output=0
manager_input=0
manager_output=0
architecture_invariants=0
architecture_edges=0
architecture_health_gates=0
architecture_health_gates_passed=0
architecture_impacts=0
architecture_debt_total=0
architecture_debt_open=0
architecture_debt_critical=0
architecture_debt_expired=0
architecture_profile_name=disabled

shopt -s nullglob
for assignment in "$dir"/archive/"$PROJECT-task-"*.assignment.md; do
	route="$(metadata_value "$assignment" Worker-Route)"
	[[ "$route" =~ ^(LUNA|TERRA)$ ]] || continue
	[[ "$route" == LUNA ]] && luna_assignments=$((luna_assignments + 1)) || terra_assignments=$((terra_assignments + 1))
	leaf_type="$(metadata_value "$assignment" Leaf-Type)"
	if [[ "$leaf_type" =~ ^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION)$ ]]; then
		[[ "$route" == LUNA ]] && luna_coding_assignments=$((luna_coding_assignments + 1)) || terra_coding_assignments=$((terra_coding_assignments + 1))
	elif [[ "$route" == TERRA ]]; then
		terra_decision_assignments=$((terra_decision_assignments + 1))
	fi
	task_id="${assignment##*/}"
	task_id="${task_id#${PROJECT}-task-}"
	task_id="${task_id%.assignment.md}"
	result="$dir/archive/$(task_base "$task_id").result.md"
	[[ -f "$result" ]] || result="$dir/archive/$(task_base "$task_id").checkpoint-result.md"
	[[ -f "$result" ]] || continue
	outcome="$(metadata_value "$result" Goal-Outcome)"
	[[ -n "$outcome" ]] || continue
	terminal_goals=$((terminal_goals + 1))
	if [[ "$route" == LUNA && "$outcome" == COMPLETE ]]; then
		luna_complete=$((luna_complete + 1))
	elif [[ "$route" == LUNA ]]; then
		luna_failed=$((luna_failed + 1))
	elif [[ "$outcome" == COMPLETE ]]; then
		terra_complete=$((terra_complete + 1))
	else
		terra_failed=$((terra_failed + 1))
	fi
done

for ledger in "$dir"/control/goals/*.iterations.tsv; do
	[[ -f "$ledger" ]] || continue
	total_iterations=$((total_iterations + $(awk -F '\t' 'NR > 1 {count++} END {print count + 0}' "$ledger")))
	identical_iterations=$((identical_iterations + $(awk -F '\t' 'NR > 1 && $9 == "identical" {count++} END {print count + 0}' "$ledger")))
done
for ledger in "$dir"/control/progress/*.criteria.tsv; do
	[[ -f "$ledger" ]] || continue
	verified_items=$((verified_items + $(awk 'NR > 1 {count++} END {print count + 0}' "$ledger")))
done
for ledger in "$dir"/control/progress/*.replans.tsv; do
	[[ -f "$ledger" ]] || continue
	replans=$((replans + $(awk 'NR > 1 {count++} END {print count + 0}' "$ledger")))
done

token_report="$("$HARNESS_BIN/harness-agent-token-usage" "$HARNESS_ENV_FILE")"
token_metric()
{
	local metric="$1"
	awk -F '\t' -v metric="$metric" '$1 == metric {print $2; found=1; exit} END {if (!found) print 0}' <<< "$token_report"
}
manager_input="$(token_metric manager_input_tokens)"
manager_output="$(token_metric manager_output_tokens)"
worker_input=$(( $(token_metric worker_luna_input_tokens) + $(token_metric worker_terra_input_tokens) +
	$(token_metric worker_unknown_input_tokens) ))
worker_output=$(( $(token_metric worker_luna_output_tokens) + $(token_metric worker_terra_output_tokens) +
	$(token_metric worker_unknown_output_tokens) ))

if (( HARNESS_ARCHITECTURE_GUARDS == 1 )); then
	architecture_require_registered
	architecture_profile_name="$(architecture_profile)"
	architecture_invariants="$(awk 'NR>1 {n++} END {print n+0}' "$(architecture_invariants_file)")"
	architecture_edges="$(awk 'NR>1 {n++} END {print n+0}' "$(architecture_edges_file)")"
	architecture_health_gates="$(awk 'NR>1 {n++} END {print n+0}' "$(architecture_health_gates_file)")"
	architecture_health_gates_passed="$(awk -F '\t' 'NR>1 && $2 ~ /PASSED$/ {seen[$1]=1} END {for(i in seen)n++; print n+0}' "$(architecture_health_ledger_file)")"
	architecture_impacts="$(find "$(architecture_impact_dir)" -maxdepth 1 -type f -name '*.impact.md' -printf '.' | wc -c)"
	architecture_debt_total="$(awk 'NR>1 {n++} END {print n+0}' "$(architecture_debt_file)")"
	architecture_debt_open="$(awk -F '\t' 'NR>1 && $10!="RESOLVED" {n++} END {print n+0}' "$(architecture_debt_file)")"
	architecture_debt_critical="$(architecture_open_critical_debt_count)"
	architecture_debt_expired="$(architecture_expired_debt_count)"
fi

rate()
{
	local numerator="$1" denominator="$2"
	if (( denominator == 0 )); then printf 'N/A\n'; else awk -v n="$numerator" -v d="$denominator" 'BEGIN {printf "%.2f", n * 100 / d}'; fi
}
per_item()
{
	local value="$1"
	if (( verified_items == 0 )); then printf 'N/A\n'; else awk -v n="$value" -v d="$verified_items" 'BEGIN {printf "%.2f", n / d}'; fi
}

{
	printf 'metric\tvalue\n'
	printf 'nodes_total\t%s\n' "$nodes_total"
	printf 'nodes_complete\t%s\n' "$nodes_complete"
	printf 'planned_coding_nodes\t%s\n' "$planned_coding_nodes"
	printf 'planned_luna_coding_nodes\t%s\n' "$planned_luna_coding_nodes"
	printf 'planned_luna_coding_share_percent\t%s\n' "$(rate "$planned_luna_coding_nodes" "$planned_coding_nodes")"
	printf 'luna_assignments\t%s\n' "$luna_assignments"
	printf 'terra_assignments\t%s\n' "$terra_assignments"
	printf 'luna_assignment_share_percent\t%s\n' "$(rate "$luna_assignments" "$((luna_assignments + terra_assignments))")"
	printf 'luna_coding_assignments\t%s\n' "$luna_coding_assignments"
	printf 'terra_coding_assignments\t%s\n' "$terra_coding_assignments"
	printf 'terra_decision_assignments\t%s\n' "$terra_decision_assignments"
	printf 'luna_coding_share_percent\t%s\n' "$(rate "$luna_coding_assignments" "$((luna_coding_assignments + terra_coding_assignments))")"
	printf 'luna_terminal_complete\t%s\n' "$luna_complete"
	printf 'luna_terminal_failed\t%s\n' "$luna_failed"
	printf 'terra_terminal_complete\t%s\n' "$terra_complete"
	printf 'terra_terminal_failed\t%s\n' "$terra_failed"
	printf 'luna_terminal_success_percent\t%s\n' "$(rate "$luna_complete" "$((luna_complete + luna_failed))")"
	printf 'terra_escalation_share_percent\t%s\n' "$(rate "$terra_assignments" "$((luna_assignments + terra_assignments))")"
	printf 'goal_iterations\t%s\n' "$total_iterations"
	printf 'identical_zero_gain_iterations\t%s\n' "$identical_iterations"
	printf 'zero_gain_iteration_percent\t%s\n' "$(rate "$identical_iterations" "$total_iterations")"
	printf 'automatic_replans\t%s\n' "$replans"
	printf 'verified_items\t%s\n' "$verified_items"
	printf 'worker_input_tokens\t%s\n' "$worker_input"
	printf 'worker_output_tokens\t%s\n' "$worker_output"
	printf 'manager_input_tokens\t%s\n' "$manager_input"
	printf 'manager_output_tokens\t%s\n' "$manager_output"
	printf 'worker_input_tokens_per_verified_item\t%s\n' "$(per_item "$worker_input")"
	printf 'worker_output_tokens_per_verified_item\t%s\n' "$(per_item "$worker_output")"
	printf 'manager_input_tokens_per_verified_item\t%s\n' "$(per_item "$manager_input")"
	printf 'manager_output_tokens_per_verified_item\t%s\n' "$(per_item "$manager_output")"
	printf 'architecture_guards_enabled\t%s\n' "$HARNESS_ARCHITECTURE_GUARDS"
	printf 'architecture_profile\t%s\n' "$architecture_profile_name"
	printf 'architecture_invariants\t%s\n' "$architecture_invariants"
	printf 'architecture_edges\t%s\n' "$architecture_edges"
	printf 'architecture_health_gates\t%s\n' "$architecture_health_gates"
	printf 'architecture_health_gates_passed\t%s\n' "$architecture_health_gates_passed"
	printf 'architecture_health_gate_pass_percent\t%s\n' "$(rate "$architecture_health_gates_passed" "$architecture_health_gates")"
	printf 'architecture_impact_manifests\t%s\n' "$architecture_impacts"
	printf 'architecture_debt_total\t%s\n' "$architecture_debt_total"
	printf 'architecture_debt_open\t%s\n' "$architecture_debt_open"
	printf 'architecture_debt_open_critical\t%s\n' "$architecture_debt_critical"
	printf 'architecture_debt_expired\t%s\n' "$architecture_debt_expired"
} > "$report.tmp.$$"
chmod 600 "$report.tmp.$$"
mv "$report.tmp.$$" "$report"
cat "$report"
