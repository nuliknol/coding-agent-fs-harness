#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE TASK_ROOT\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 2 ]] || usage
load_harness_env "$1"
root="$2"
ensure_project
require_manager_configuration
require_manager_codex
trace_init manager_auto_replan_root
trace_script_start "$@"
validate_task_id "$root"
[[ "$(task_root_id "$root")" == "$root" ]] || die 'TASK_ROOT must not be a revision ID'

(( HARNESS_AUTO_REPLAN_ENABLED == 1 )) || exit 0
replan_marker="$(task_root_replan_file "$root")"
[[ -f "$replan_marker" ]] || exit 0
if task_root_is_blocked "$root" || task_root_needs_human "$root" ||
	task_root_needs_architecture_reassessment "$root"; then
	exit 0
fi
if ! enforce_root_liveness_or_reassess "$root"; then
	printf '%s\n' "$(task_root_architecture_reassessment_file "$root")"
	exit 0
fi

trigger_task="$(awk -F': ' '$1 == "Triggered-By" {print $2; exit}' "$replan_marker")"
[[ -n "$trigger_task" ]] || trigger_task="$root"
trigger_assignment="$(project_dir)/archive/$(task_base "$trigger_task").assignment.md"
trigger_focused_validation="-"
if [[ -f "$trigger_assignment" ]]; then
	trigger_focused_validation="$(metadata_value "$trigger_assignment" Focused-Validation)"
	[[ -n "$trigger_focused_validation" ]] || trigger_focused_validation="-"
fi
trigger_outcome="$(awk -F': ' '$1 == "Trigger-Outcome" {print $2; exit}' "$replan_marker")"
resource_decomposition=0
[[ "$trigger_outcome" != RESOURCE_NEEDS_DECOMPOSITION ]] || resource_decomposition=1
resource_progress_verification=0
[[ "$trigger_outcome" != RESOURCE_PROGRESS_NEEDS_VERIFICATION ]] || resource_progress_verification=1
resource_recovery=$((resource_decomposition || resource_progress_verification))
policy_migration=0
[[ "$trigger_outcome" != LUNA_ONLY_POLICY_MIGRATION ]] || policy_migration=1
blocking_fingerprint="$(awk -F': ' '$1 == "Blocking-Fingerprint" {print $2; exit}' "$replan_marker")"
[[ -n "$blocking_fingerprint" ]] || blocking_fingerprint="-"
trigger_blocker_class="$(awk -F': ' '$1 == "Blocker-Class" {print $2; exit}' "$replan_marker")"
trigger_remediation_scope="$(awk -F': ' '$1 == "Remediation-Scope" {print $2; exit}' "$replan_marker")"
trigger_context_paths="$(awk -F': ' '$1 == "Context-Paths" {print $2; exit}' "$replan_marker")"
trigger_closure_condition="$(awk -F': ' '$1 == "Closure-Condition" {print $2; exit}' "$replan_marker")"
trigger_closure_repair_action="$(awk -F': ' '$1 == "Closure-Repair-Action" {print $2; exit}' "$replan_marker")"
trigger_closure_repair_provider="$(awk -F': ' '$1 == "Closure-Repair-Provider" {print $2; exit}' "$replan_marker")"
trigger_closure_repair_children="$(project_dir)/control/context-closures/$(task_base "$trigger_task")/repair-children.tsv"
[[ -s "$trigger_closure_repair_children" ]] || trigger_closure_repair_children=-
trigger_closure_repair_report="$(project_dir)/control/context-closures/$(task_base "$trigger_task")/repair.tsv"
[[ -s "$trigger_closure_repair_report" ]] || trigger_closure_repair_report=-
closure_repair=0
[[ "$trigger_outcome" != CONTEXT_CLOSURE_REPAIR ]] || closure_repair=1
recovery_mode="AUTOMATIC_REPLAN"
recovery_reason="bounded strategy change remains available"
if (( closure_repair == 1 )); then
	recovery_reason="typed Context Closure repair $trigger_closure_repair_action is required for $trigger_closure_condition through $trigger_closure_repair_provider"
	# A Context Closure rejection occurs before the executable leaf launches.
	# Preserve manager-remediation authority across that internal transition;
	# downgrading its successor to an ordinary replan discards the separately
	# audited prerequisite scope before any Luna worker can use it.
	if [[ -f "$trigger_assignment" &&
		"$(metadata_value "$trigger_assignment" Manager-Remediation)" == 1 ]]; then
		recovery_mode="MANAGER_REMEDIATION"
		recovery_reason="typed Context Closure repair must retain the triggering manager-remediation prerequisite authority"
	fi
elif (( policy_migration == 1 )); then
	recovery_reason="an installed pre-policy Terra assignment must be recursively decomposed into Luna-only child criteria without discarding verified state"
elif (( resource_progress_verification == 1 )); then
	recovery_reason="the preceding resource-bounded episode changed preserved source and requires isolated verification before more implementation"
elif [[ "$trigger_outcome" == DETERMINISTIC_BLOCKER ]]; then
	recovery_mode="MANAGER_REMEDIATION"
	recovery_reason="the configured deterministic local-blocker threshold was reached"
elif [[ "$trigger_outcome" == HARD_BLOCK_SCOPE_DIAGNOSTIC ]]; then
	recovery_mode="MANAGER_REMEDIATION"
	recovery_reason="a rejected worker hard-boundary claim requires one fresh manager-owned scope diagnostic before any implementation retry"
elif [[ "$trigger_outcome" == HARD_BLOCKED_LOCAL ]]; then
	recovery_mode="MANAGER_REMEDIATION"
	recovery_reason="a verified leaf hard block identified a repository-local prerequisite outside the earlier worker scope"
elif [[ "$trigger_outcome" == MANAGER_REMEDIATION_CONTINUATION ]]; then
	recovery_mode="MANAGER_REMEDIATION"
	recovery_reason="a checkpointed baseline remediation exposed one more directly implicated local prerequisite"
elif [[ "$trigger_outcome" == MANAGER_REMEDIATION_SCOPE_EXHAUSTED ]]; then
	recovery_mode="MANAGER_REMEDIATION"
	recovery_reason="the preceding fresh manager remediation proved its declared mutation scope insufficient and requires an adjacent producer, representation, consumer, or validation seam"
elif [[ "$trigger_outcome" == MANAGER_REMEDIATION_CONTEXT_INCOMPLETE ]]; then
	recovery_mode="MANAGER_REMEDIATION"
	recovery_reason="the preceding fresh manager remediation retained correct write authority but proved its bounded context capsule incomplete"
elif [[ "$trigger_outcome" == LEGACY_HARD_BLOCKED ]]; then
	recovery_mode="MANAGER_REMEDIATION"
	recovery_reason="a legacy terminal hard block requires manager-level repository-local reconsideration before any human escalation"
# An explicit architecture resolution establishes a fresh operator-reviewed
# authority boundary. Do not reinterpret the preserved historical fingerprint
# as proof that manager remediation or scope expansion remains authorized.
elif (( resource_recovery == 0 && policy_migration == 0 && closure_repair == 0 )) &&
	[[ "$trigger_outcome" != ARCHITECTURE_REASSESSMENT_RESOLVED ]] &&
	root_same_blocker_without_verified_gain "$root" "$blocking_fingerprint"; then
	recovery_mode="MANAGER_REMEDIATION"
	recovery_reason="the same local blocker survived a bounded automatic replan without durable verified gain"
fi
auto_replans="$(root_auto_replans_without_verified_gain "$root")"
if [[ "$recovery_mode" != MANAGER_REMEDIATION ]] &&
	(( resource_recovery == 0 && policy_migration == 0 )) &&
	(( closure_repair == 0 )) &&
	(( auto_replans >= HARNESS_MAX_AUTO_REPLANS_WITHOUT_VERIFIED_GAIN )); then
	recovery_mode="MANAGER_REMEDIATION"
	recovery_reason="the bounded worker strategy-change budget was exhausted without durable verified gain ($auto_replans/$HARNESS_MAX_AUTO_REPLANS_WITHOUT_VERIFIED_GAIN)"
fi

project_path="$(project_dir)"
manager_thread_file="$project_path/control/manager.thread"
[[ -f "$manager_thread_file" ]] || die 'manager thread is not registered; run manager-bootstrap'
manager_thread_id="$(kv_file_value "$manager_thread_file" thread_id)"
expected_task_id="$(next_task_revision_id "$root")"
running_marker="$(task_root_replanning_file "$root")"
if [[ -f "$running_marker" ]]; then
	running_pid="$(kv_file_value "$running_marker" pid 2>/dev/null || true)"
	if [[ "$running_pid" =~ ^[0-9]+$ ]] && kill -0 "$running_pid" 2>/dev/null; then
		exit 0
	fi
fi
cleanup()
{
	local status="$?"
	rm -f "$running_marker"
	trace_script_exit "$status"
}
trap cleanup EXIT
{
	printf 'pid=%s\n' "$$"
	printf 'root=%s\n' "$root"
	printf 'expected_task_id=%s\n' "$expected_task_id"
	printf 'publish_attempts=0\n'
	printf 'max_publish_attempts=%s\n' "$HARNESS_MAX_MANAGER_REPLAN_PUBLISH_ATTEMPTS"
	printf 'started_at=%s\n' "$(timestamp_utc)"
	printf 'env_file=%s\n' "$HARNESS_ENV_FILE"
} > "$running_marker.tmp.$$"
chmod 600 "$running_marker.tmp.$$"
mv "$running_marker.tmp.$$" "$running_marker"

root_assignment="$(task_root_assignment_file "$root")"
progress_file="$(task_progress_file "$root")"
criteria_definition="$(task_criteria_definition_file "$root")"
criterion_decomposition="$(task_criterion_decomposition_file "$root")"
criterion_ledger="$(task_criterion_ledger_file "$root")"
replan_ledger="$(task_replan_ledger_file "$root")"
plan_definition="$(project_plan_definition_file)"
plan_state="$(project_plan_state_file)"
development_policy_file="$REPOSITORY/design/development-policy.txt"
[[ -f "$development_policy_file" ]] || development_policy_file=""
task_output="$PROJECT_TMP_DIR/$PROJECT-task-$expected_task_id.$([[ "$recovery_mode" == MANAGER_REMEDIATION ]] && printf manager-remediation || printf auto-replan).md"
criteria_output="$PROJECT_TMP_DIR/$PROJECT-task-$root.criteria-definition.tsv"
decomposition_output="$PROJECT_TMP_DIR/$PROJECT-task-$expected_task_id.criterion-decomposition.tsv"
prompt_file="$project_path/control/$PROJECT-task-$root.auto-replan.prompt.md"
plan_item_id="$(project_plan_item_for_root "$root")"
[[ -n "$plan_item_id" ]] || die "active root is not bound to a project plan item: $root"
replan_context_capsule="$project_path/control/$PROJECT-task-$root.auto-replan-context.md"
write_plan_node_context_capsule "$replan_context_capsule" "$plan_item_id"
trigger_evidence_digest="$project_path/control/$(task_base "$trigger_task").worker-evidence-digest.md"
[[ -f "$trigger_evidence_digest" ]] || trigger_evidence_digest="-"
architecture_resolution_file=""
if [[ -d "$project_path/archive/architecture-reassessments" ]]; then
	architecture_resolution_file="$(find "$project_path/archive/architecture-reassessments" -maxdepth 1 \
		-type f -name "$PROJECT-task-$root.*.resolved.md" -printf '%T@ %p\n' 2>/dev/null | \
		sort -n | tail -n 1 | cut -d' ' -f2-)"
fi
[[ -n "$architecture_resolution_file" && -f "$architecture_resolution_file" ]] || architecture_resolution_file="-"

# Compile the complete recovery authority into one deterministic bounded read.
# Recovery used to advertise many control files individually. Even with prompt
# limits, a small model could spend several actions concatenating overlapping
# slices before it wrote a candidate. That consumed the same item budget needed
# for bounded publisher corrections. Each source below is independently capped,
# escaped onto one content line, and selected by recovery value rather than by
# repository exploration.
recovery_packet="$project_path/control/$PROJECT-task-$root.manager-recovery-packet.md"
packet_first_unmet="$(task_first_unmet_criterion "$root" 2>/dev/null || true)"
append_recovery_packet_component()
{
	local label="$1" source="$2" byte_limit="$3" mode="${4:-head}" source_bytes excerpt_command
	printf '## %s\n\n' "$label"
	if [[ -z "$source" || "$source" == - || ! -f "$source" ]]; then
		printf 'NONE\n\n'
		return 0
	fi
	source_bytes="$(wc -c < "$source" | tr -d '[:space:]')"
	printf 'Source: `%s`\nSource-Bytes: %s\nExcerpt-Mode: %s\n\nContent-Escaped: ' \
		"$source" "$source_bytes" "$mode"
	if [[ "$mode" == tail ]]; then
		excerpt_command=(tail -c "$byte_limit" -- "$source")
	else
		excerpt_command=(head -c "$byte_limit" -- "$source")
	fi
	"${excerpt_command[@]}" | awk 'BEGIN {ORS=""}
		{
			gsub(/\\/, "\\\\")
			gsub(/\t/, "\\t")
			gsub(/\r/, "\\r")
			if (NR > 1) printf "\\n"
			printf "%s", $0
		}
		END {printf "\n"}
	'
	if (( source_bytes > byte_limit )); then
		printf 'Excerpt-Truncated: 1\n'
	else
		printf 'Excerpt-Truncated: 0\n'
	fi
	printf '\n'
}
{
	printf '# Compiled Manager Recovery Packet\n\n'
	printf 'Task-Root: %s\nExpected-Task-ID: %s\nTrigger-Task: %s\n' \
		"$root" "$expected_task_id" "$trigger_task"
	printf 'Recovery-Mode: %s\nRecovery-Reason: %s\nFirst-Unmet-Criterion: %s\n' \
		"$recovery_mode" "$recovery_reason" "${packet_first_unmet:--}"
	printf 'Trigger-Focused-Validation: %s\nClosure-Condition: %s\n' \
		"$trigger_focused_validation" "${trigger_closure_condition:--}"
	printf 'Closure-Repair-Action: %s\nClosure-Repair-Provider: %s\n\n' \
		"${trigger_closure_repair_action:--}" "${trigger_closure_repair_provider:--}"
	append_recovery_packet_component 'Development policy' "$development_policy_file" 1200
	append_recovery_packet_component 'Compiled plan, specification, and architecture authority' "$replan_context_capsule" 7500
	append_recovery_packet_component 'Trigger worker evidence digest' "$trigger_evidence_digest" 3000 tail
	append_recovery_packet_component 'Operator architecture resolution' "$architecture_resolution_file" 2000 tail
	append_recovery_packet_component 'Typed Context Closure repair' "$trigger_closure_repair_report" 1200
	append_recovery_packet_component 'Recovery trigger' "$replan_marker" 1800
	append_recovery_packet_component 'Immutable root assignment' "$root_assignment" 3000
	append_recovery_packet_component 'Root progress' "$progress_file" 1800 tail
	append_recovery_packet_component 'Criterion definition' "$criteria_definition" 1800
	append_recovery_packet_component 'Criterion verification ledger' "$criterion_ledger" 1800 tail
	append_recovery_packet_component 'Recent recovery strategies' "$replan_ledger" 2500 tail
	printf '## Required recovery assignment sections\n\n'
	printf 'Use these exact case-sensitive headings, each with nonempty content:\n'
	printf 'Content-Escaped: ## Objective\\n\\n...\\n\\n## Acceptance criteria\\n\\n...\\n\\n## Validation commands\\n\\n...\n'
} > "$recovery_packet.tmp.$$"
recovery_packet_bytes="$(wc -c < "$recovery_packet.tmp.$$" | tr -d '[:space:]')"
recovery_packet_lines="$(wc -l < "$recovery_packet.tmp.$$" | tr -d '[:space:]')"
if (( recovery_packet_bytes > HARNESS_VALIDATION_OUTPUT_MAX_BYTES ||
	recovery_packet_lines > HARNESS_VALIDATION_OUTPUT_MAX_LINES )); then
	rm -f "$recovery_packet.tmp.$$"
	die "compiled manager recovery packet exceeds the bounded read budget (bytes=$recovery_packet_bytes/$HARNESS_VALIDATION_OUTPUT_MAX_BYTES lines=$recovery_packet_lines/$HARNESS_VALIDATION_OUTPUT_MAX_LINES)"
fi
chmod 600 "$recovery_packet.tmp.$$"
mv "$recovery_packet.tmp.$$" "$recovery_packet"

criteria_instruction=""
deterministic_closure_graft=0
publish_flag="--auto-replan"
recovery_task_metadata=""
recovery_authority=""
recovery_validator_contract="The command validates the first-unmet leaf, append-only child decomposition, fresh worker context, strategy uniqueness, material fingerprint, verified-gain replan budget, and a blocker that survived without new durable evidence."
strategy_change_values="NARROW_SCOPE|NEW_EVIDENCE|ISOLATE_CRITERION"
if [[ "$recovery_mode" == MANAGER_REMEDIATION ]]; then
	publish_flag="--manager-remediation"
	strategy_change_values="REPAIR_PREREQUISITE"
	recovery_task_metadata=$'Manager-Remediation: 1\nBlocker-Class: LOCAL_CODE_PREREQUISITE|LOCAL_BUILD_PREREQUISITE|LOCAL_INTEGRATION_PREREQUISITE|LOCAL_SCOPE_PREREQUISITE\nRemediation-Scope: DIRECTLY_IMPLICATED_LOCAL_FILES_OR_DIRECTORIES'
	recovery_authority="This is a manager remediation assignment, not another ordinary worker retry. The manager acts as the integration owner for bounded repository-local prerequisites. Inspect the blocker evidence and name the smallest concrete Remediation-Scope that contains the directly implicated local prerequisite sources, test seams, build files, integration files, or workstream-owned files. The execution turn will run with the manager model and may edit those named prerequisites even when an ordinary worker ownership rule, exclusive-file list, forbidden-file list, baseline label, or prior Allowed-Scope excluded them. Such paths remain separately attributed to manager baseline remediation through the durable remediation ledger and checkpoint artifacts; they are not part of the feature worker's owned implementation delta. This exception does not override a path frozen or excluded by the governing human specification or accepted project DAG; that is a semantic-authority boundary requiring clarification or architecture reassessment. Preserve observable product behavior and public contracts unless the governing specification itself requires a public change. Do not change unrelated behavior or external systems. Before classifying a build target as absent or adding a build-system file to Remediation-Scope, inspect the bounded build registration named by the capsule and search for the source/test basename as well as the requested target spelling. Generated target prefixes and aliases are common. If an equivalent target already exists, correct the focused validation command to use its exact registered name; do not publish a build-file edit or architecture scope expansion merely to create a second spelling."
	recovery_validator_contract="The command validates the first-unmet leaf, fresh manager execution context, local prerequisite classification and scope, strategy uniqueness, and material fingerprint. Manager remediation intentionally bypasses the exhausted ordinary-replan/no-gain guard; it does not relax acceptance."
	if [[ "$trigger_outcome" == MANAGER_REMEDIATION_SCOPE_EXHAUSTED ]]; then
		recovery_authority+=" The preceding Remediation-Scope [$trigger_remediation_scope] is machine-recorded as exhausted for this unchanged criterion. Do not publish that same path set again. Use the terminal evidence to identify the smallest adjacent declaration, producer, representation, consumer, or validation seam that was absent from it. The publisher rejects an unchanged remediation path set before execution."
		recovery_validator_contract+=" It also rejects reuse of the exhausted remediation path set."
	elif [[ "$trigger_outcome" == MANAGER_REMEDIATION_CONTEXT_INCOMPLETE ]]; then
		recovery_authority+=" The preceding Remediation-Scope [$trigger_remediation_scope] remains the exact mutation authority; do not expand or replace it. Its Context-Paths [$trigger_context_paths] were insufficient. Add only the exact missing declaration or implementation paths and Required-Symbols named by terminal evidence. The publisher requires a strict context expansion while preserving the same remediation path set."
		recovery_validator_contract+=" It also requires the same Remediation-Scope and a strict bounded Context-Paths expansion."
	fi
fi
if task_root_uses_assignment_criteria "$root" || [[ -f "$criteria_definition" ]]; then
	first_unmet="$(task_first_unmet_criterion "$root" 2>/dev/null || true)"
	if [[ -z "$first_unmet" ]]; then
		if [[ "$(project_plan_item_status "$plan_item_id" 2>/dev/null || true)" == COMPLETE ]]; then
			rm -f "$replan_marker" "$project_path/control/$PROJECT-task-$root.manager-replan-failed.md"
			log_event "STALE_RECOVERY_RECONCILED root=$root trigger=$trigger_task reason=completed_plan_item"
			exit 0
		fi
		log_event "MANAGER_RECOVERY_RECONCILIATION_REQUIRED root=$root trigger=$trigger_task reason=all_declared_criteria_passed"
		printf 'Root %s needs manager evidence reconciliation; no human dependency was established.\n' "$root" >&2
		exit 70
	fi
	first_unmet_depth=0
	if [[ -f "$criterion_decomposition" ]]; then
		first_unmet_depth="$(awk -F '\t' -v wanted="$first_unmet" '
			NR > 1 {value=depth[$1]+1; if(value>depth[$2])depth[$2]=value}
			END {print depth[wanted]+0}
		' "$criterion_decomposition")"
	fi
	if (( first_unmet_depth >= HARNESS_MAX_CRITERION_DEPTH ||
		$(root_child_criterion_count "$root") >= HARNESS_MAX_ROOT_CHILD_CRITERIA )); then
		criteria_instruction="Use the existing immutable criterion inventory. Its first unmet leaf is: $first_unmet. The structural decomposition budget is exhausted at depth $first_unmet_depth/$HARNESS_MAX_CRITERION_DEPTH and children $(root_child_criterion_count "$root")/$HARNESS_MAX_ROOT_CHILD_CRITERIA. Do not write or pass DECOMPOSITION_OUTPUT. Keep exactly this first-unmet criterion, add only the missing bounded context/contract evidence, and publish with $publish_flag only. Never rewrite or remove an existing criterion or decomposition row."
	else
		if (( resource_progress_verification == 1 )); then
			criteria_instruction="Use the existing immutable criterion inventory. Its first unmet leaf is: $first_unmet. The preceding bounded episode changed preserved source before its resource fuse. Do not append decomposition and do not authorize another implementation edit. Target exactly $first_unmet with a VERIFICATION_ONLY leaf, Expected-Max-Implementation-Files: 0, fresh context, and the narrowest executable focused validation that proves or disproves the preserved change."
		elif { (( resource_decomposition == 1 || policy_migration == 1 )) || [[ "$trigger_closure_repair_action" == GRAFT_GRAPH_CUTS ]]; } && [[ "$recovery_mode" != MANAGER_REMEDIATION ]]; then
			if [[ "$trigger_closure_repair_action" == GRAFT_GRAPH_CUTS && "$trigger_closure_repair_children" != - ]] &&
				(( $(awk 'END {print NR > 0 ? NR - 1 : 0}' "$trigger_closure_repair_children") >= 2 )); then
				python3 "$HARNESS_HOME/tools/compile_closure_graft.py" \
					--assignment "$trigger_assignment" \
					--repair-children "$trigger_closure_repair_children" \
					--parent-criterion "$first_unmet" \
					--output "$decomposition_output" \
					--facets-output "$decomposition_output.facets.tsv" >/dev/null
				deterministic_closure_graft=1
				criteria_instruction="Use the existing immutable criterion inventory. Its first unmet leaf is: $first_unmet. The trusted decomposition compiler has already written DECOMPOSITION_OUTPUT and DECOMPOSITION_OUTPUT.facets.tsv from CLOSURE_REPAIR_CHILDREN_FILE. Do not edit, replace, or reread either generated file. Target the first generated child criterion and copy only that child's exact allowed_paths, context_paths, required_symbols, and focused_validation from CLOSURE_REPAIR_CHILDREN_FILE into the bounded assignment. Publish with $publish_flag - DECOMPOSITION_OUTPUT. The publisher recompiles and byte-compares both graft files and rejects semantic transcription drift."
			else
				criteria_instruction="Use the existing immutable criterion inventory. Its first unmet leaf is: $first_unmet. The resource guard proved this leaf is too broad, so decomposition is mandatory. Do not create or replace CRITERIA_OUTPUT. Refine exactly $first_unmet into at least two ordered, independently verifiable direct children by writing DECOMPOSITION_OUTPUT with the exact header parent_criterion<TAB>child_criterion<TAB>title<TAB>acceptance_evidence. Every data row must name exactly $first_unmet as parent_criterion; do not include grandchildren or recursively split a new child in this publication. Target the first new direct child and publish with $publish_flag - DECOMPOSITION_OUTPUT. Publishing the unchanged parent without DECOMPOSITION_OUTPUT is invalid. Never rewrite or remove an existing criterion or decomposition row."
			fi
		else
			criteria_instruction="Use the existing immutable criterion inventory. Its first unmet leaf is: $first_unmet. Do not create or replace CRITERIA_OUTPUT. If repository evidence proves this leaf is unexpectedly broad, you may refine only $first_unmet into at least two ordered independently verifiable direct children by writing DECOMPOSITION_OUTPUT with the exact header parent_criterion<TAB>child_criterion<TAB>title<TAB>acceptance_evidence. Every data row in this transaction must name exactly $first_unmet as parent_criterion; do not include grandchildren or recursively split a newly introduced child in the same publication. In that case target the first new direct child and publish with $publish_flag - DECOMPOSITION_OUTPUT. A later replan may split that child if it remains too broad. Otherwise target $first_unmet and publish with $publish_flag only. Never rewrite or remove an existing criterion or decomposition row."
		fi
	fi
else
	criteria_instruction="This is an oversized legacy root without an explicit criterion inventory. Create CRITERIA_OUTPUT as criterion_id<TAB>title<TAB>acceptance_evidence with the exact header and at least two ordered, independently verifiable remaining child milestones. The first row must be the bounded target. Do not include completed work as a remaining criterion. Pass CRITERIA_OUTPUT as the final manager-publish-task argument."
fi

cat > "$prompt_file.tmp.$$" <<PROMPT
The root hit a convergence guard after its latest outcome was safely archived. Perform one automatic recovery turn in a fresh bounded manager context. Durable files provide all continuity; do not replay a previous review or planning thread. Preserve checkpoints and the project plan.

ENV_FILE=$HARNESS_ENV_FILE
PROJECT=$PROJECT
PROJECT_TMP_DIR=$PROJECT_TMP_DIR
TASK_ROOT=$root
EXPECTED_TASK_ID=$expected_task_id
TRIGGER_TASK=$trigger_task
TRIGGER_FOCUSED_VALIDATION=$trigger_focused_validation
NEEDS_REPLAN_FILE=$replan_marker
ROOT_ASSIGNMENT_FILE=$root_assignment
PROGRESS_FILE=$progress_file
CRITERIA_DEFINITION_FILE=$criteria_definition
CRITERION_LEDGER_FILE=$criterion_ledger
REPLAN_LEDGER_FILE=$replan_ledger
PROJECT_PLAN_FILE=-
PROJECT_PLAN_STATE_FILE=-
DEVELOPMENT_POLICY_FILE=$development_policy_file
SPECIFICATION=$SPECIFICATION
REPOSITORY=$REPOSITORY
HARNESS_BIN=$HARNESS_BIN
WORKER_GOAL_MODE=$HARNESS_WORKER_GOAL_MODE
RECOVERY_MODE=$recovery_mode
RECOVERY_REASON=$recovery_reason
BLOCKING_FINGERPRINT=$blocking_fingerprint
CLOSURE_CONDITION=${trigger_closure_condition:--}
CLOSURE_REPAIR_ACTION=${trigger_closure_repair_action:--}
CLOSURE_REPAIR_PROVIDER=${trigger_closure_repair_provider:--}
CLOSURE_REPAIR_CHILDREN_FILE=$trigger_closure_repair_children
CLOSURE_REPAIR_REPORT_FILE=$trigger_closure_repair_report
DETERMINISTIC_CLOSURE_GRAFT=$deterministic_closure_graft
TRIGGER_BLOCKER_CLASS=${trigger_blocker_class:--}
TRIGGER_REMEDIATION_SCOPE=${trigger_remediation_scope:--}
TRIGGER_CONTEXT_PATHS=${trigger_context_paths:--}
TASK_OUTPUT=$task_output
CRITERIA_OUTPUT=$criteria_output
DECOMPOSITION_OUTPUT=$decomposition_output
DECOMPOSITION_V2=$HARNESS_DECOMPOSITION_V2
ARCHITECTURE_GUARDS=$HARNESS_ARCHITECTURE_GUARDS
ARCHITECTURE_DIR=-
PROJECT_DECOMPOSITION_FILE=-
PLAN_NODE_CONTEXT_FILE=$replan_context_capsule
RECOVERY_PACKET_FILE=$recovery_packet
TRIGGER_EVIDENCE_DIGEST=$trigger_evidence_digest
ARCHITECTURE_RESOLUTION_FILE=$architecture_resolution_file
LUNA_STRATEGY_FAILURES=$(root_luna_strategy_failure_count "$root")
MAX_LUNA_STRATEGY_FAILURES=$HARNESS_MAX_LUNA_STRATEGY_FAILURES

Read DEVELOPMENT_POLICY_FILE when present, PLAN_NODE_CONTEXT_FILE once, TRIGGER_EVIDENCE_DIGEST once when it is not '-', ARCHITECTURE_RESOLUTION_FILE once when it is not '-', and the root/replan/criterion files above that exist. The explicit operator resolution is authoritative recovery evidence: incorporate its stated correction instead of replaying the disproved premise. PLAN_NODE_CONTEXT_FILE is the complete plan, DAG, normalized-IR, and architecture authority for this turn. TRIGGER_EVIDENCE_DIGEST is bounded machine-generated continuity from the immediately preceding execution episode; use its command manifest to avoid repeating exploration, but do not open the raw JSONL or command outputs. Do not open the generic manager protocol, human specification, global plan/DAG/IR/architecture files, repository inventory, prior agent logs, or unrelated progress files. Complete the transaction in at most eight shell/tool actions: one bounded authority read, at most one exact source/evidence inspection only when the capsule lacks one necessary local fact, write TASK_OUTPUT and optional decomposition, then use no more than three publisher calls with no more than two direct corrections. Do not inspect output-target existence, reread TASK_OUTPUT or decomposition output, or perform another repository search after the first publisher call; each publisher diagnostic is the complete correction authority. TRIGGER_FOCUSED_VALIDATION is machine-extracted from the triggering assignment. When it names an executable exact target or test selector and the same first-unmet boundary remains, preserve that exact target/selector or make it narrower; never replace it with an unqualified all-target build or unfiltered test suite. A coding continuation must contain a machine-executable validation command, not a FOCUSED:/INCREMENTAL:/CLEAN_GLOBAL: review descriptor or source-only rg/grep audit. Its Objective must state the exact implementation action; words such as determine, discover, infer, locate, or inspect-only identify an unfinished diagnostic prerequisite and are rejected. If validation directly executes a CMake-built binary, build that exact target in the same command. Treat diagnostic fields according to their source declaration: never infer a hardware count from an integer boolean such as has_two_devices=1. Every complete shell action has one aggregate transcript budget of $HARNESS_VALIDATION_OUTPUT_MAX_LINES lines and $HARNESS_VALIDATION_OUTPUT_MAX_BYTES bytes across its combined stdout and stderr. Every source search or diff command must end with both head -n $HARNESS_VALIDATION_OUTPUT_MAX_LINES and head -c $HARNESS_VALIDATION_OUTPUT_MAX_BYTES; a custom literal cap greater than either configured maximum is forbidden and will pause the project as TOKEN_USAGE_ANOMALY. Do not concatenate separately capped outputs in one action. Retain complete output in PROJECT_TMP_DIR and return only one bounded excerpt. Never combine an unrestricted diff with a contextual search in one command. Preserve every verified checkpoint.

Any new child criterion must preserve the semantic type, cardinality, ownership domain, and unit of its parent. Do not infer record counts from argument arity, source-span lengths from role counts, hardware counts from boolean diagnostics, or producer ownership from a downstream facade. If the trigger evidence disproves such an inherited premise, remove that premise and target the first actual failing contract instead of decomposing it again.

Preserve the last independently executable validation root. A relative CMake source path must contain CMakeLists.txt from the repository-root command boundary, and a static cmake --build or ctest --test-dir path must already exist or be configured earlier in the same command. Never rewrite an established path such as component/build to repository-root build merely for brevity.

$criteria_instruction

$recovery_authority

Write exactly one materially different bounded continuation to TASK_OUTPUT. It must contain exactly one of each:

Task-ID: $expected_task_id
Task-Root: $root
Target-Criterion: FIRST_UNMET_ID
Worker-Context: FRESH
Replan-Strategy-ID: NEW_STABLE_ID
Strategy-Change: $strategy_change_values
Supersedes-Task: $trigger_task
$recovery_task_metadata

When RECOVERY_REASON says preserved source requires isolated verification, the continuation must set Leaf-Type: VERIFICATION_ONLY and Expected-Max-Implementation-Files: 0. It must validate the preserved diff without making implementation edits; a failed verification returns to decomposition with the exact observed failure.

It must also contain nonempty Objective, Acceptance criteria, and Validation commands level-two sections. The objective must isolate the first unmet criterion. The evidence or scope strategy must materially differ from prior entries in REPLAN_LEDGER_FILE and from the triggering assignment. Do not edit the repository in this planning turn.

Publish the task atomically with:

$HARNESS_BIN/manager-publish-task "$HARNESS_ENV_FILE" "$expected_task_id" "$task_output" $publish_flag [CRITERIA_OUTPUT only for an undecomposed legacy root] [DECOMPOSITION_OUTPUT only after a '-' criteria placeholder]

$recovery_validator_contract A unique verified checkpoint or passed criterion resets ordinary convergence escalation even when Progress-Percent is unchanged. You may call manager-publish-task at most $HARNESS_MAX_MANAGER_REPLAN_PUBLISH_ATTEMPTS times: correct only the complete diagnostic returned by each failed call, and after the final permitted rejection terminate with the exact blocker. Publish exactly one task, then terminate immediately. Do not redirect manager-publish-task stdout or stderr: its bounded diagnostic is the complete authority for each bounded correction. A nonzero publisher exit means the task was not published; never claim success unless the durable task exists. Do not wait, sleep, poll, watch the filesystem, or call harness-unblock-root.
PROMPT
if (( HARNESS_WORKER_GOAL_MODE == 1 )); then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

Worker leaf-goal mode is enabled. The replacement assignment must also contain exactly one nonempty line for each of: Execution-Mode: LEAF_GOAL, Goal-ID, Goal-Success-Evidence, Focused-Validation, Allowed-Scope, Baseline-Boundary, and Hard-Block-Conditions. Its existing Target-Criterion line is the goal target. Use a new stable Goal-ID for the materially different strategy.
PROMPT
	if [[ "$recovery_mode" == MANAGER_REMEDIATION ]]; then
		cat >> "$prompt_file.tmp.$$" <<PROMPT

For manager remediation, Allowed-Scope must include exactly the directly implicated Remediation-Scope plus the original focused validation surface. Consider TRIGGER_BLOCKER_CLASS and TRIGGER_REMEDIATION_SCOPE as evidence, then refine them from repository inspection rather than copying an overbroad placeholder. Baseline-Boundary must name the observed local failure. Use LOCAL_SCOPE_PREREQUISITE when the only obstacle is an ordinary worker ownership, exclusive-file, forbidden-file, or baseline-source rule and the repair preserves observable behavior. Hard-Block-Conditions must be reserved for a genuinely human-dependent requirement such as missing authorization, unavailable secrets, an external manual state change, or incompatible observable product outcomes that the specification does not resolve; ordinary coding, private testability, build, test, integration, worker-scope, ownership, and baseline-source restrictions are not human hard blocks.

Set Terra-Exception: - exactly. Manager remediation is bounded execution authority, not a new architecture, contract, concurrency, ambiguity, or integration decision.

Validation sources that are read or compiled but are not concretely defective belong in Context-Paths and validation commands, not Allowed-Scope or Remediation-Scope. Expand mutation authority beyond the immutable root only when observed evidence identifies a required edit in that exact path; never grant speculative authority merely because a test file is part of the focused validation seam.
PROMPT
	fi
fi
if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

V2 decomposition is active and the preferred coder is $HARNESS_PREFERRED_WORKER_ROUTE. The replacement must include Leaf-Type, Complexity-Class, Worker-Route, Depends-On, Deliverable, Required-Symbols, Context-Paths, Architecture-Decisions, Validation-Class, Expected-Max-Implementation-Files, and Expected-Max-Worker-Turns. Leaf-Type must be exactly one of LOCAL_IMPLEMENTATION, TEST_IMPLEMENTATION, MECHANICAL_API, FOCUSED_BUG, DOCUMENTATION, VERIFICATION_ONLY, CONTRACT_DESIGN, CROSS_COMPONENT_ARCHITECTURE, CONCURRENCY_PROTOCOL, INTEGRATION, or AMBIGUOUS_SPECIFICATION. Never invent a specialized synonym such as SOURCE_RESTORATION; baseline/source restoration is LOCAL_IMPLEMENTATION when bounded coding is required, or INTEGRATION when the task is only cross-boundary validation. Use VERIFICATION_ONLY with zero implementation files when exact acceptance evidence is already present. Validation-Class is exactly FOCUSED, INCREMENTAL, or CLEAN_GLOBAL. Before the Luna strategy limit, routine implementation must be decomposed into LOW/LUNA children rather than routed to Terra. If LUNA_STRATEGY_FAILURES is at least MAX_LUNA_STRATEGY_FAILURES, decompose the first unmet criterion into smaller children or route the replacement to TERRA with fresh context. A Luna replacement is valid only for LOW complexity, no architecture decisions, a Luna-safe leaf type, FOCUSED or INCREMENTAL validation, no more than five expected implementation files, and no more than three expected turns. CLEAN_GLOBAL validation requires a TERRA INTEGRATION leaf.

Allowed-Scope is tracked-source mutation authority. Never put a generated build tree such as 'build', 'resys/build', 'build-*', or 'cmake-build-*' in Allowed-Scope; such paths may appear only in Context-Paths and focused validation commands. Preserve the root assignment's Expected-Max-Implementation-Files and Expected-Max-Worker-Turns as ceilings. A recovery may lower either budget but must not raise it.

After a verified checkpoint has completed the root's Terra decision, a remaining read-only VERIFICATION_ONLY, TEST_IMPLEMENTATION, or DOCUMENTATION evidence leaf may use Complexity-Class: LOW, Worker-Route: LUNA, Architecture-Decisions: NONE, Expected-Max-Implementation-Files: 0, and at most three worker turns. The publisher assigns that residual evidence leaf a deterministic machine-owned complexity vector; do not retain the completed root's HIGH/TERRA route merely because it owns the immutable plan node.

When an otherwise measured Luna-ready implementation leaf is routed to TERRA only because LUNA_STRATEGY_FAILURES reached MAX_LUNA_STRATEGY_FAILURES and no smaller independently verifiable decomposition remains, set 'Terra-Exception: IRREDUCIBLE_CROSS_BOUNDARY' exactly. Strategy exhaustion is evidence for this controlled route override, not itself a valid Terra-Exception enum. Do not use 'LUNA_STRATEGY_LIMIT_EXHAUSTED' or another narrative value.
Allowed-Scope is only a comma-separated list of repository-relative path prefixes. Put explanations and adaptation details in Objective; never append prose to Allowed-Scope.
PROMPT
fi
if [[ "$HARNESS_MODEL_POLICY" == luna_only ]]; then
	cat >> "$prompt_file.tmp.$$" <<PROMPT

LUNA-ONLY POLICY OVERRIDE: Every inference and executable leaf uses $LUNA_WORKER_MODEL. Never emit Worker-Route: TERRA, a Terra-Exception, manager-model execution, or a stronger-model fallback. This instruction supersedes legacy Terra language above. When a boundary exceeds Luna limits, append independently acceptance-complete child criteria or add exact typed Context-Paths/Required-Symbols. Use Worker-Route: LUNA and Terra-Exception: - for every published leaf. For any typed Context Closure repair, read CLOSURE_REPAIR_REPORT_FILE once when it is not '-' and treat its exact condition, identifier, and detail rows as the repair authority. If CLOSURE_REPAIR_ACTION=GRAFT_GRAPH_CUTS, also read CLOSURE_REPAIR_CHILDREN_FILE and use its deterministic path/symbol seams to allocate ordered acceptance-complete children; do not clone the parent scope onto every child. If CLOSURE_REPAIR_ACTION=REFRESH_INDEX_OR_OVERLAY and the bounded provider retry returned the same exact missing evidence, correct only the invalid assignment metadata: remove an optional generated/directory Context-Paths seed, fix an exact path spelling, or represent an indexed build target as validation/build metadata rather than inventing a source symbol. Never claim a provider refresh without evidence in the repair report. If incompatible observable product outcomes are not resolved by the governing specification, request clarification; strategy exhaustion alone is always a decomposition signal.

This Luna planning turn is a compiler over the supplied bounded evidence, not a
repository explorer. Do not inspect repository source, enumerate files, open
raw logs, or create combined authority dumps. Read PLAN_NODE_CONTEXT_FILE and,
when present, TRIGGER_EVIDENCE_DIGEST; then write TASK_OUTPUT and invoke the
publisher. Use at most four shell/tool actions before the first publisher call.
If those compiled inputs do not name an implementation-ready seam, decompose
the first-unmet criterion; do not search for one.
PROMPT
fi
cat >> "$prompt_file.tmp.$$" <<PROMPT

COMPILED RECOVERY OVERRIDE: RECOVERY_PACKET_FILE supersedes every multi-file
read instruction above. It contains the selected development policy, compiled
