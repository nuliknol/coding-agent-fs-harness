task_published()
{
	local base successor_marker successor_trigger
	base="$(task_base "$expected_task_id")"
	if [[ -f "$project_path/tasks/$base.ready.md" ||
		-f "$project_path/running/$base.running.md" ||
		-f "$project_path/results/$base.result.md" ||
		-f "$project_path/archive/$base.accepted.md" ||
		-f "$project_path/archive/$base.checkpointed.md" ||
		-f "$project_path/archive/$base.rejected.md" ||
		-f "$(task_root_architecture_reassessment_file "$root")" ]]; then
		return 0
	fi
	# A fast worker admission failure can archive the newly published assignment
	# and queue its next typed repair before this manager process observes the
	# ready file. That is a committed publication, not a false-success retry.
	# Require both durable artifacts and an exact trigger match so an unrelated
	# historical assignment cannot satisfy the check.
	successor_marker="$(task_root_replan_file "$root")"
	[[ -f "$project_path/archive/$base.assignment.md" && -f "$successor_marker" ]] ||
		return 1
	successor_trigger="$(metadata_value "$successor_marker" Triggered-By)"
	[[ "$successor_trigger" == "$expected_task_id" ]]
}

manager_remediation_candidate_exceeds_authority()
{
	local candidate_scope root_scope scope_override additional_scope effective_scope entry authority_entry allowed
	local -a candidate_entries=() authority_entries=()
	[[ "$recovery_mode" == MANAGER_REMEDIATION && -s "$task_output" ]] || return 1
	candidate_scope="$(metadata_value "$task_output" Remediation-Scope)"
	root_scope="$(metadata_value "$root_assignment" Allowed-Scope)"
	[[ -n "$candidate_scope" && -n "$root_scope" ]] || return 1
	effective_scope="$root_scope"
	scope_override="$(task_root_architecture_scope_override_file "$root")"
	if [[ -f "$scope_override" ]] &&
		[[ "$(kv_file_value "$scope_override" authorized_for 2>/dev/null || true)" == manager_remediation ]]; then
		additional_scope="$(kv_file_value "$scope_override" additional_scope 2>/dev/null || true)"
		[[ -z "$additional_scope" ]] || effective_scope+=",$additional_scope"
	fi
	candidate_scope="${candidate_scope//;/,}"
	effective_scope="${effective_scope//;/,}"
	IFS=',' read -r -a candidate_entries <<< "$candidate_scope"
	IFS=',' read -r -a authority_entries <<< "$effective_scope"
	for entry in "${candidate_entries[@]}"; do
		entry="$(trim_surrounding_whitespace "$entry")"
		[[ -n "$entry" ]] || continue
		allowed=0
		for authority_entry in "${authority_entries[@]}"; do
			authority_entry="$(trim_surrounding_whitespace "$authority_entry")"
			[[ -n "$authority_entry" ]] || continue
			if [[ "$entry" == "$authority_entry" || "$entry" == "$authority_entry"/* ]]; then
				allowed=1
				break
			fi
		done
		(( allowed == 1 )) || return 0
	done
	return 1
}

attempt=1
provider_retries=0
quota_waits=0
fallback_stage=0
current_model="$MANAGER_MODEL"
while true; do
	# Publication corrections are bounded per fresh manager invocation, not for
	# the entire automatic-recovery transaction.  A schema-invalid draft from a
	# previous fresh turn must not consume the corrected turn's publisher slots.
	# The outer loop remains independently bounded, so this reset permits repair
	# without creating an unbounded launch or publication loop.
	goal_state_set "$running_marker" publish_attempts 0
	goal_state_set "$running_marker" manager_attempt "$attempt"
	log_event "MANAGER_RECOVERY_TURN_BUDGET_RESET root=$root trigger=$trigger_task manager_attempt=$attempt limit=$HARNESS_MAX_MANAGER_REPLAN_PUBLISH_ATTEMPTS"
	stamp="$(timestamp_compact_utc)"
	attempt_label="$(printf '%03d' "$attempt")"
	json_log="$project_path/logs/manager-replan-$root-$stamp-attempt-$attempt_label.jsonl"
	stderr_log="$project_path/logs/manager-replan-$root-$stamp-attempt-$attempt_label.stderr.log"
	last_message="$project_path/logs/manager-replan-$root-$stamp-attempt-$attempt_label.md"
	log_event "MANAGER_REPLAN_STARTED root=$root trigger=$trigger_task expected_task=$expected_task_id recovery_mode=$recovery_mode attempt=$attempt context=fresh previous_thread_id=$manager_thread_id"
	trace_event MANAGER_REPLAN_ATTEMPT "root=$root" "trigger_task=$trigger_task" "expected_task=$expected_task_id" "recovery_mode=$recovery_mode" "attempt=$attempt" "context=fresh" "previous_thread_id=$manager_thread_id" "json_log=$json_log"
	set +e
	"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" manager_replan "$current_model" \
		"$prompt_file" "$json_log" "$stderr_log" "$last_message"
	status=$?
	set -e
	classification="$(kv_file_value "${json_log%.jsonl}.classification" classification 2>/dev/null || true)"
	record_root_agent_tokens "$root" manager_replan "${json_log%.jsonl}.classification"
	if task_published; then
		new_thread_id="$(codex_thread_id_from_jsonl "$json_log" 2>/dev/null || true)"
		if [[ "$new_thread_id" =~ ^[A-Za-z0-9-]+$ ]]; then
			"$HARNESS_BIN/manager-register-thread" "$HARNESS_ENV_FILE" "$new_thread_id" >/dev/null
			log_event "MANAGER_CONTEXT_ROTATED previous=$manager_thread_id current=$new_thread_id reason=bounded_replan"
		fi
		log_event "MANAGER_REPLAN_COMMITTED root=$root task=$expected_task_id recovery_mode=$recovery_mode attempt=$attempt"
		trace_event MANAGER_REPLAN_COMMITTED "root=$root" "task_id=$expected_task_id" "recovery_mode=$recovery_mode" "attempt=$attempt"
		if [[ "$recovery_mode" == MANAGER_REMEDIATION ]]; then
			printf 'Fresh manager published remediation task %s for root %s.\n' "$expected_task_id" "$root"
		else
			printf 'Fresh manager automatically replanned root %s as %s.\n' "$root" "$expected_task_id"
		fi
		exit 0
	fi
	if (( status == 0 )); then
		if (( attempt < HARNESS_MAX_MANAGER_REPLAN_PUBLISH_ATTEMPTS )); then
			log_event "MANAGER_RECOVERY_FALSE_PUBLICATION_RETRY root=$root trigger=$trigger_task attempt=$attempt classification=${classification:-unknown}"
			printf '\nCorrection turn: the preceding agent exited successfully but no durable task was published. Treat every prior success claim as false. Recreate the expected assignment, call manager-publish-task without output redirection, inspect its exit status, and use the one permitted direct correction if rejected.\n' >> "$prompt_file"
			attempt=$((attempt + 1))
			continue
		fi
		if manager_remediation_candidate_exceeds_authority; then
			candidate_scope="$(metadata_value "$task_output" Remediation-Scope)"
			root_scope="$(metadata_value "$root_assignment" Allowed-Scope)"
			mark_root_architecture_reassessment "$expected_task_id" \
				MANAGER_REMEDIATION_SCOPE_EXPANSION \
				"bounded manager recovery exhausted its publication corrections after identifying remediation scope outside immutable root authority: root=[$root_scope] revision=[$candidate_scope]" \
				"root_assignment=$root_assignment candidate=$task_output trigger=$trigger_task" >/dev/null
			log_event "MANAGER_RECOVERY_SCOPE_EXPANSION_PROMOTED root=$root trigger=$trigger_task expected_task=$expected_task_id candidate_scope=$(printf '%q' "$candidate_scope")"
			printf '%s\n' "$(task_root_architecture_reassessment_file "$root")"
			exit 0
		fi
		log_event "MANAGER_RECOVERY_NOT_PUBLISHED root=$root trigger=$trigger_task recovery_mode=$recovery_mode classification=${classification:-unknown}"
		printf 'Fresh manager did not publish a valid %s continuation for root %s; recovery remains pending.\n' \
			"$recovery_mode" "$root" >&2
		exit 70
	fi
	retry_kind="$(codex_provider_retry_kind "$classification" 2>/dev/null || true)"
	if [[ -n "$retry_kind" ]]; then
		retry_delay="$(codex_provider_retry_delay "$classification")"
		provider_retries=$((provider_retries + 1))
		[[ "$retry_kind" != quota ]] || quota_waits=$((quota_waits + 1))
		log_event "MANAGER_REPLAN_PROVIDER_WAIT root=$root kind=$retry_kind attempt=$attempt retry=$provider_retries delay_seconds=$retry_delay"
		sleep "$retry_delay"
		attempt=$((attempt + 1))
		continue
	fi
	if codex_model_requires_narrow_prompt "$current_model" && [[ "$classification" == model_refusal_or_blocked_content ]]; then
		if (( fallback_stage == 0 )); then
			fallback_stage=1
			attempt=$((attempt + 1))
			printf '\nRetry scope: decompose or isolate only the first unmet root criterion and publish one local task.\n' >> "$prompt_file"
			continue
		elif (( fallback_stage == 1 )) && [[ "$MANAGER_FALLBACK_MODEL" != "$current_model" ]]; then
			fallback_stage=2
			current_model="$MANAGER_FALLBACK_MODEL"
			attempt=$((attempt + 1))
			continue
		fi
	fi
	log_event "MANAGER_RECOVERY_FAILED root=$root trigger=$trigger_task recovery_mode=$recovery_mode classification=${classification:-unknown} status=$status"
	printf 'Automatic manager recovery failed for root %s (classification=%s status=%s); no human dependency was established.\n' \
		"$root" "${classification:-unknown}" "$status" >&2
	exit "$status"
done
