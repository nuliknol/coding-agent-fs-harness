#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-mode.sh"
harness_dispatch_mode "$SCRIPT_DIR/.." "${0##*/}" "$@"
source "$SCRIPT_DIR/../lib/harness-common.sh"
source "$SCRIPT_DIR/../lib/harness-repository-index.sh"
source "$SCRIPT_DIR/../lib/harness-index-maintenance.sh"
source "$SCRIPT_DIR/../lib/harness-supervisor-policy.sh"

usage()
{
	printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 1 ]] || usage
load_harness_env "$1"
ensure_project
"$HARNESS_BIN/harness-migrate-state" "$HARNESS_ENV_FILE" >/dev/null
"$HARNESS_BIN/harness-rebuild-throughput-state" "$HARNESS_ENV_FILE" >/dev/null
trace_init manager_supervisor
trace_script_start "$@"
dir="$(project_dir)"
write_oracle_snapshot
manager_invoker="${HARNESS_MANAGER_INVOKER:-$HARNESS_BIN/manager-invoke-result}"
manager_batch_invoker="$HARNESS_BIN/manager-invoke-result-batch"
manager_plan_invoker="${HARNESS_MANAGER_PLAN_INVOKER:-$HARNESS_BIN/manager-plan-next-task}"
manager_replan_invoker="${HARNESS_MANAGER_REPLAN_INVOKER:-$HARNESS_BIN/manager-auto-replan-root}"
oracle_invoker="${HARNESS_ORACLE_INVOKER:-$HARNESS_BIN/oracle-invoke-final-audit}"
manager_pending_exit_status=3
[[ -x "$manager_invoker" ]] || die "manager invoker is not executable: $manager_invoker"
[[ -x "$manager_plan_invoker" ]] || die "manager plan invoker is not executable: $manager_plan_invoker"
if (( HARNESS_AUTO_REPLAN_ENABLED == 1 )); then
	[[ -x "$manager_replan_invoker" ]] || die "manager replan invoker is not executable: $manager_replan_invoker"
fi
if oracle_enabled; then
	[[ -x "$oracle_invoker" ]] || die "oracle invoker is not executable: $oracle_invoker"
fi

exec 8>"$dir/control/supervisor.lock"
flock -n 8 || die "a supervisor is already running for project: $PROJECT"
printf '%s\n' "$$" > "$dir/control/supervisor.pid"
printf '%s\n' "$HARNESS_ENV_FILE" > "$dir/control/supervisor.env-file"
watch_pid=""
supervisor_exit_status=0
current_command=""
oracle_failed_fingerprint=""
repository_index_failed_fingerprint=""
declare -A replan_failed_fingerprint=()

log_supervisor_failure()
{
	local status="$1"
	local line="$2"
	local command="$3"
	log_event "SUPERVISOR_FATAL status=$status line=$line command=$(printf '%q' "$command")"
	printf 'Supervisor fatal error for %s: status=%s line=%s command=%s\n' \
		"$PROJECT" "$status" "$line" "$command" >&2
}

cleanup()
{
	if [[ -n "$watch_pid" ]]; then
		kill "$watch_pid" 2>/dev/null || true
	fi
	rm -f "$dir/control/supervisor.pid" "$dir/control/supervisor.env-file"
	trace_script_exit "$supervisor_exit_status"
	if (( supervisor_exit_status != 0 )); then
		log_event "SUPERVISOR_EXIT status=$supervisor_exit_status"
	fi
}
trap 'supervisor_exit_status=$?; current_command=$BASH_COMMAND; if (( supervisor_exit_status != 0 )); then log_supervisor_failure "$supervisor_exit_status" "$LINENO" "$current_command"; fi' ERR
trap 'cleanup; exit 0' INT TERM
trap cleanup EXIT

fingerprint()
{
	local file="$1"
	stat -c '%i:%s:%Y' "$file"
}

review_state_fingerprint()
{
	local result="$1" candidate architecture dependency_dir
	architecture="$(architecture_dir)"
	dependency_dir="$(dependency_request_dir)"
	{
		for candidate in \
			"$result" \
			"$(project_plan_definition_file)" \
			"$(project_plan_state_file)" \
			"$(project_decomposition_plan_file)" \
			"$dir/control/agent-commits.tsv" \
			"$HARNESS_ENV_FILE" \
			"$HARNESS_HOME/VERSION" \
			"$manager_invoker" \
			"$HARNESS_HOME/lib/harness-common.sh"; do
			if [[ -f "$candidate" ]]; then
				sha256sum "$candidate"
			else
				printf 'missing  %s\n' "$candidate"
			fi
		done
		if [[ -d "$architecture" ]]; then
			find "$architecture" -maxdepth 1 -type f \
				\( -name '*.tsv' -o -name 'profile.env' \) -print0 |
				LC_ALL=C sort -z | xargs -0 -r sha256sum
		else
			printf 'missing  %s\n' "$architecture"
		fi
		if [[ -d "$dependency_dir" ]]; then
			find "$dependency_dir" -maxdepth 1 -type f \
				\( -name '*.waiting.md' -o -name '*.requirements.tsv' -o -name '*.resolved.md' \) -print0 |
				LC_ALL=C sort -z | xargs -0 -r sha256sum
		else
			printf 'missing  %s\n' "$dependency_dir"
		fi
		git -C "$REPOSITORY" rev-parse HEAD 2>/dev/null || printf 'UNBORN\n'
	} | sha256sum | awk '{print "sha256:" $1}'
}

reconcile_superseded_result()
{
	local task_id="$1" root item
	root="$(task_root_id "$task_id")"
	item="$(project_plan_item_for_root "$root")"
	[[ -n "$item" ]] || return 1
	[[ "$(project_plan_item_status "$item")" == COMPLETE ]] || return 1
	root_has_accepted_task "$root" || return 1
	log_event "SUPERVISOR_RECONCILE_SUPERSEDED task=$task_id root=$root plan_item=$item"
	trace_event SUPERVISOR_RECONCILE_SUPERSEDED "task_id=$task_id" "task_root=$root" "plan_item=$item"
	"$HARNESS_BIN/manager-supersede-task" "$HARNESS_ENV_FILE" "$task_id" 8>&- >/dev/null
}

planning_gap_state_fingerprint()
{
	local file
	for file in \
		"$(project_plan_definition_file)" \
		"$(project_plan_state_file)" \
		"$(project_decomposition_plan_file)" \
		"$(architecture_node_bindings_file)" \
		"$manager_plan_invoker" \
		"$HARNESS_BIN/manager-publish-planned-task" \
		"$HARNESS_BIN/manager-publish-task"; do
		if [[ -f "$file" ]]; then
			sha256sum "$file"
		else
			printf 'missing  %s\n' "$file"
		fi
	done | sha256sum | awk '{print "sha256:" $1}'
}

process_results()
{
	local file task_id base marker current previous invocation_fingerprint post_fingerprint review_state_changed status alert stalled tmp running lease assignment_archive accepted checkpointed rejected blocked worker_invocation invocation_snapshot worker_pid worker_supervisor_pid
	local candidate_file candidate_task candidate_base candidate_marker candidate_current candidate_previous candidate_root candidate_item selected_item conflict selected_task
	local -a batch_tasks=()
	shopt -s nullglob
	for file in "$dir/results/$PROJECT-task-"*.result.md; do
		task_id="$(task_id_from_filename "$file")"
		base="$(task_base "$task_id")"
		worker_invocation="$dir/control/$base.worker-invocation-active"
		if [[ -f "$worker_invocation" ]]; then
			# worker-supervisor removes this barrier immediately after the worker
			# invocation is classified. Snapshot it once: two independent key reads
			# can straddle that unlink and turn normal cleanup into a fatal missing-
			# file error. A marker that vanishes before this read is already stale.
			invocation_snapshot="$(cat -- "$worker_invocation" 2>/dev/null || true)"
			worker_pid="$(awk -F= '$1=="worker_pid" {sub(/^[^=]*=/, ""); print; exit}' <<< "$invocation_snapshot")"
			worker_supervisor_pid="$(awk -F= '$1=="supervisor_pid" {sub(/^[^=]*=/, ""); print; exit}' <<< "$invocation_snapshot")"
			if { [[ "$worker_pid" =~ ^[1-9][0-9]*$ ]] && kill -0 "$worker_pid" 2>/dev/null; } ||
				{ [[ "$worker_supervisor_pid" =~ ^[1-9][0-9]*$ ]] && kill -0 "$worker_supervisor_pid" 2>/dev/null; }; then
				continue
			fi
			rm -f "$worker_invocation"
			log_event "STALE_WORKER_INVOCATION_BARRIER_REMOVED task=$task_id marker=$worker_invocation"
		fi
		if task_root_is_paused "$task_id"; then
			continue
		fi
		running="$dir/running/$base.running.md"
		lease="$dir/control/$base.lease"
		assignment_archive="$dir/archive/$base.assignment.md"
		accepted="$dir/archive/$base.accepted.md"
		checkpointed="$dir/archive/$base.checkpointed.md"
		rejected="$dir/archive/$base.rejected.md"
		blocked="$dir/archive/$base.blocked.md"

		# A result becomes reviewable only after the worker completion transaction
		# has archived the assignment and removed the lease. An agent may write a
		# result file directly before worker-complete-task finishes; ignore that
		# intermediate state and reconcile it on a later scan.
		if [[ -e "$running" || -e "$lease" || ! -f "$assignment_archive" ]]; then
			continue
		fi
		if reconcile_superseded_result "$task_id"; then
			continue
		fi

		marker="$dir/control/$base.reviewed-event"
		stalled="$dir/control/$base.manager-review-stalled.md"
		current="$(review_state_fingerprint "$file")"
		previous=""
		[[ ! -f "$marker" ]] || previous="$(kv_file_value "$marker" fingerprint)"
		[[ "$current" != "$previous" ]] || continue
		rm -f "$stalled"
		invocation_fingerprint="$current"
		review_state_changed=0
		[[ -z "$previous" ]] || review_state_changed=1

		log_event "SUPERVISOR_TRIGGER task=$task_id fingerprint=$current"
		batch_tasks=("$task_id")
		if (( HARNESS_MANAGER_BATCH_SIZE > 1 )) &&
			[[ "$manager_invoker" == "$HARNESS_BIN/manager-invoke-result" && -x "$manager_batch_invoker" ]]; then
			for candidate_file in "$dir/results/$PROJECT-task-"*.result.md; do
				(( ${#batch_tasks[@]} < HARNESS_MANAGER_BATCH_SIZE )) || break
				[[ -f "$candidate_file" && "$candidate_file" != "$file" ]] || continue
				candidate_task="$(task_id_from_filename "$candidate_file")"
				task_root_is_paused "$candidate_task" && continue
				candidate_base="$(task_base "$candidate_task")"
				[[ ! -e "$dir/running/$candidate_base.running.md" &&
					! -e "$dir/control/$candidate_base.lease" &&
					-f "$dir/archive/$candidate_base.assignment.md" ]] || continue
				[[ ! -e "$dir/control/$candidate_base.worker-invocation-active" ]] || continue
				candidate_marker="$dir/control/$candidate_base.reviewed-event"
				candidate_current="$(review_state_fingerprint "$candidate_file")"
				candidate_previous=""
				[[ ! -f "$candidate_marker" ]] || candidate_previous="$(kv_file_value "$candidate_marker" fingerprint)"
				[[ "$candidate_current" != "$candidate_previous" ]] || continue
				candidate_root="$(task_root_id "$candidate_task")"
				candidate_item="$(project_plan_item_for_root "$candidate_root")"
				conflict=0
				for selected_task in "${batch_tasks[@]}"; do
					[[ "$(task_root_id "$selected_task")" != "$candidate_root" ]] || { conflict=1; break; }
					selected_item="$(project_plan_item_for_root "$(task_root_id "$selected_task")")"
					if project_plan_items_have_scope_conflict "$candidate_item" "$selected_item"; then
						conflict=1
						break
					fi
				done
				(( conflict == 0 )) || continue
				batch_tasks+=("$candidate_task")
			done
		fi
		trace_event SUPERVISOR_INVOKE_MANAGER "task_id=$task_id" "fingerprint=$current" \
			"manager_invoker=$manager_invoker" "batch_size=${#batch_tasks[@]}"
		if (( ${#batch_tasks[@]} > 1 )); then
			log_event "SUPERVISOR_INVOKE_MANAGER_BATCH tasks=$(IFS=,; printf '%s' "${batch_tasks[*]}") size=${#batch_tasks[@]}"
			if "$manager_batch_invoker" "$HARNESS_ENV_FILE" "${batch_tasks[@]}" 8>&-; then
				status=0
			else
				status=$?
			fi
		elif HARNESS_REVIEW_STATE_CHANGED="$review_state_changed" \
			"$manager_invoker" "$HARNESS_ENV_FILE" "$task_id" 8>&-; then
			status=0
		else
			status=$?
		fi
		trace_event SUPERVISOR_MANAGER_EXIT "task_id=$task_id" "status=$status"
		# A batch can commit this event while returning nonzero because an
		# independent sibling remained pending.  This event is complete and must
		# not inherit the sibling's retry/stall state.
		[[ -f "$file" ]] || continue
		# A sibling review may have accepted this root while this manager turn was
		# in flight. Reconcile that race before interpreting a no-op as a stall.
		if [[ -f "$file" ]] && reconcile_superseded_result "$task_id"; then
			continue
		fi
		if (( status == 0 )); then
			if [[ -f "$file" ]]; then
				current="$(review_state_fingerprint "$file")"
				log_event "SUPERVISOR_RESULT_STILL_PRESENT task=$task_id accepted=$([[ -f "$accepted" ]] && printf 1 || printf 0) checkpointed=$([[ -f "$checkpointed" ]] && printf 1 || printf 0) rejected=$([[ -f "$rejected" ]] && printf 1 || printf 0) blocked=$([[ -f "$blocked" ]] && printf 1 || printf 0)"
				tmp="$marker.tmp.$$"
				{
					printf 'fingerprint=%s\n' "$current"
					printf 'handled_at=%s\n' "$(timestamp_utc)"
					printf 'manager_exit_status=0\n'
				} > "$tmp"
				chmod 600 "$tmp"
				mv "$tmp" "$marker"
				log_event "SUPERVISOR_RESULT_LEFT_PENDING task=$task_id"
			fi
		elif (( status == manager_pending_exit_status )); then
			post_fingerprint="$(review_state_fingerprint "$file")"
			tmp="$marker.tmp.$$"
			{
				# When the review revised durable state, preserve the invocation
				# fingerprint so the next scan performs one fresh review. Only an
				# unchanged no-op is suppressed.
				if [[ "$post_fingerprint" != "$invocation_fingerprint" ]]; then
					printf 'fingerprint=%s\n' "$invocation_fingerprint"
				else
					printf 'fingerprint=%s\n' "$post_fingerprint"
				fi
				printf 'handled_at=%s\n' "$(timestamp_utc)"
					printf 'manager_exit_status=%s\n' "$status"
					printf 'retry_state=exhausted_after_fresh_corrective_review\n'
				} > "$tmp"
			chmod 600 "$tmp"
			mv "$tmp" "$marker"
			if [[ "$post_fingerprint" != "$invocation_fingerprint" ]]; then
				log_event "SUPERVISOR_REVIEW_STATE_CHANGED task=$task_id before=$invocation_fingerprint after=$post_fingerprint retry=fresh_review"
			else
				tmp="$stalled.tmp.$$"
				{
					printf '# Manager Review Stalled\n\n'
					printf 'Project: %s\n\n' "$PROJECT"
					printf 'Task-ID: %s\n\n' "$task_id"
					printf 'State-Fingerprint: %s\n\n' "$post_fingerprint"
					printf 'Stalled-At: %s\n\n' "$(timestamp_utc)"
					printf 'The manager exhausted its bounded fresh corrective review without a terminal action or durable state change. The result is explicitly paused until relevant state or the deployed review boundary changes.\n'
				} > "$tmp"
				chmod 600 "$tmp"
				mv "$tmp" "$stalled"
				log_event "SUPERVISOR_REVIEW_LEFT_UNCOMMITTED task=$task_id fingerprint=$post_fingerprint retry=suppressed_until_state_change alert=$stalled"
			fi
		else
			alert="$dir/control/$base.manager-failed.md"
			tmp="$alert.tmp.$$"
			{
				printf '# Manager Invocation Failed\n\n'
				printf 'Project: %s\n\n' "$PROJECT"
				printf 'Task-ID: %s\n\n' "$task_id"
				printf 'Environment-File: %s\n\n' "$HARNESS_ENV_FILE"
				printf 'Failed-At: %s\n\n' "$(timestamp_utc)"
				printf 'Exit-Status: %s\n\n' "$status"
				printf 'Provider quota and transient provider/network failures retry indefinitely inside manager-invoke-result. This failure was classified as terminal or non-provider.\n'
			} > "$tmp"
			chmod 600 "$tmp"
			mv "$tmp" "$alert"
			printf 'Manager invocation failed for task %s; see %s\n' "$task_id" "$alert" >&2
			tmp="$marker.tmp.$$"
			{
				printf 'fingerprint=%s\n' "$current"
				printf 'handled_at=%s\n' "$(timestamp_utc)"
				printf 'manager_exit_status=%s\n' "$status"
			} > "$tmp"
			chmod 600 "$tmp"
			mv "$tmp" "$marker"
		fi
	done
}

project_has_active_task()
{
	compgen -G "$dir/tasks/$PROJECT-task-*.ready.md" >/dev/null ||
		compgen -G "$dir/running/$PROJECT-task-*.running.md" >/dev/null ||
		compgen -G "$dir/results/$PROJECT-task-*.result.md" >/dev/null ||
		compgen -G "$dir/control/progress/$PROJECT-task-*.blocked.md" >/dev/null ||
		compgen -G "$dir/control/progress/$PROJECT-task-*.needs-replan.md" >/dev/null ||
		compgen -G "$dir/control/progress/$PROJECT-task-*.needs-human.md" >/dev/null ||
		compgen -G "$dir/control/progress/$PROJECT-task-*.waiting-dependency.md" >/dev/null ||
		compgen -G "$dir/control/progress/$PROJECT-task-*.replanning.md" >/dev/null ||
		compgen -G "$dir/control/progress/$PROJECT-task-*.architecture-reassessment-required.md" >/dev/null ||
		compgen -G "$dir/control/progress/$PROJECT-task-*.token-usage-anomaly.md" >/dev/null
}

root_has_pending_review_result()
{
	local root="$1" artifact artifact_task
	for artifact in "$dir/results/$PROJECT-task-"*.result.md; do
		[[ -f "$artifact" ]] || continue
		artifact_task="$(task_id_from_filename "$artifact")"
		if [[ "$(task_root_id "$artifact_task")" == "$root" ]]; then
			return 0
		fi
	done
	return 1
}

process_dependency_requests()
{
	local request
	shopt -s nullglob
	for request in "$(dependency_request_dir)"/*.waiting.md; do
		[[ -f "$request" ]] || continue
		if resolve_dependency_request_if_ready "$request"; then
			log_event "SUPERVISOR_DEPENDENCY_WAKE request=$request"
		fi
	done
}

reclassify_legacy_convergence_human_markers()
{
	local marker name root reason trigger_task
	shopt -s nullglob
	for marker in "$dir/control/progress/$PROJECT-task-"*.needs-human.md; do
		[[ -f "$marker" ]] || continue
		reason="$(awk '/^Reason: / {sub(/^Reason: /, ""); print; exit}' "$marker")"
		case "$reason" in
			"the same blocker survived a bounded automatic replan without durable verified gain"*|\
			"automatic strategy-change budget exhausted without durable verified gain"*)
				;;
			*)
				continue
				;;
		esac
		name="${marker##*/}"
		root="${name#${PROJECT}-task-}"
		root="${root%.needs-human.md}"
		trigger_task="$(awk -F': ' '$1 == "Triggered-By" {print $2; exit}' "$marker")"
		[[ -n "$trigger_task" ]] || trigger_task="$root"
		mark_root_needs_replan "$trigger_task" \
			"legacy convergence pause reclassified as automatic manager remediation: $reason" \
			MANAGER_REMEDIATION >/dev/null
		rm -f "$marker"
		log_event "LEGACY_HUMAN_RECLASSIFIED_MANAGER_REMEDIATION root=$root trigger=$trigger_task reason=$(printf '%q' "$reason")"
	done
}

reclassify_legacy_hard_block_markers()
{
	local marker name root reason trigger_task blocked_review blocker_class
	local remediation_scope human_evidence
	shopt -s nullglob
	for marker in "$dir/control/progress/$PROJECT-task-"*.blocked.md; do
		[[ -f "$marker" ]] || continue
		name="${marker##*/}"
		root="${name#${PROJECT}-task-}"
		root="${root%.blocked.md}"
		trigger_task="$(awk -F': ' '$1 == "Blocked-By-Task" {print $2; exit}' "$marker")"
		[[ -n "$trigger_task" ]] || trigger_task="$root"
		reason="$(awk '/^Reason: / {sub(/^Reason: /, ""); print; exit}' "$marker")"
		[[ -n "$reason" ]] || reason="legacy hard block requires manager-level classification"
		blocked_review="$dir/archive/$(task_base "$trigger_task").blocked.md"
		blocker_class=""
		remediation_scope=""
		human_evidence=""
		if [[ -f "$blocked_review" ]]; then
			blocker_class="$(metadata_value "$blocked_review" Blocker-Class)"
			remediation_scope="$(metadata_value "$blocked_review" Remediation-Scope)"
			human_evidence="$(metadata_value "$blocked_review" Human-Dependency-Evidence)"
		fi
		if hard_block_class_is_human "$blocker_class" && [[ -n "$human_evidence" ]]; then
			mark_root_needs_human "$root" "$trigger_task" "$reason" \
				"$blocker_class" "$human_evidence" >/dev/null
			record_root_hard_block "$trigger_task" "$blocker_class" NEEDS_HUMAN - "$reason"
			rm -f "$marker"
			log_event "LEGACY_HARD_BLOCK_RECLASSIFIED_NEEDS_HUMAN root=$root trigger=$trigger_task blocker_class=$blocker_class reason=$(printf '%q' "$reason")"
			continue
		fi
		if ! hard_block_class_is_local "$blocker_class"; then
			blocker_class="LOCAL_CODE_PREREQUISITE"
		fi
		[[ -n "$remediation_scope" ]] ||
			remediation_scope="repository-local implementation or testability prerequisite identified by the legacy hard-block review"
		mark_root_needs_replan "$trigger_task" \
			"legacy hard block reclassified for manager remediation: $reason" \
			LEGACY_HARD_BLOCKED "$blocker_class" "$remediation_scope" >/dev/null
		record_root_hard_block "$trigger_task" "$blocker_class" MANAGER_REMEDIATION \
			"$remediation_scope" "$reason"
		rm -f "$marker"
		log_event "LEGACY_HARD_BLOCK_RECLASSIFIED_MANAGER_REMEDIATION root=$root trigger=$trigger_task blocker_class=$blocker_class remediation_scope=$(printf '%q' "$remediation_scope") reason=$(printf '%q' "$reason")"
	done
}

process_auto_replans()
{
	local marker name root current status alert tmp status_file batch_id
	local index
	local -a roots=() fingerprints=()
	local -A pid_by_root=()
	(( HARNESS_AUTO_REPLAN_ENABLED == 1 )) || return 0
	shopt -s nullglob
	for marker in "$dir/control/progress/$PROJECT-task-"*.needs-replan.md; do
		(( ${#roots[@]} < HARNESS_MANAGER_BATCH_SIZE )) || break
		[[ -f "$marker" ]] || continue
		name="${marker##*/}"
		root="${name#${PROJECT}-task-}"
		root="${root%.needs-replan.md}"
		# Replanning may only begin after the terminal review transaction has
		# consumed the exact result for this root.  A manager that accidentally
		# acts on an earlier revision can create a needs-replan marker while the
		# current result remains live; publishing then necessarily collides with
		# that result and strands the root in RECOVERY_STALLED.
		root_has_pending_review_result "$root" && continue
		current="$(fingerprint "$marker")"
		[[ "${replan_failed_fingerprint[$root]:-}" != "$current" ]] || continue
		roots+=("$root")
		fingerprints+=("$current")
	done
	(( ${#roots[@]} > 0 )) || return 0
	batch_id="$(printf '%s\n' "${roots[@]}" | sha256sum | cut -c1-16)"
	log_event "SUPERVISOR_MANAGER_REPLAN_COHORT_STARTED batch=$batch_id roots=$(IFS=,; printf '%s' "${roots[*]}") size=${#roots[@]}"
	for index in "${!roots[@]}"; do
		root="${roots[index]}"
		current="${fingerprints[index]}"
		log_event "SUPERVISOR_INVOKE_MANAGER_REPLAN root=$root fingerprint=$current invoker=$manager_replan_invoker batch=$batch_id"
		trace_event SUPERVISOR_INVOKE_MANAGER_REPLAN "root=$root" "fingerprint=$current" "manager_replan_invoker=$manager_replan_invoker" "batch=$batch_id"
		if (( ${#roots[@]} == 1 )); then
			set +e
			"$manager_replan_invoker" "$HARNESS_ENV_FILE" "$root" 8>&-
			status=$?
			set -e
			printf '%s\n' "$status" > "$dir/control/$PROJECT-task-$root.parallel-replan-status.$$"
			pid_by_root[$root]=0
		else
			(
				set +e
				"$manager_replan_invoker" "$HARNESS_ENV_FILE" "$root" 8>&-
				printf '%s\n' "$?" > "$dir/control/$PROJECT-task-$root.parallel-replan-status.$$"
			) &
			pid_by_root[$root]=$!
		fi
	done
	for index in "${!roots[@]}"; do
		root="${roots[index]}"
		current="${fingerprints[index]}"
		status_file="$dir/control/$PROJECT-task-$root.parallel-replan-status.$$"
		if (( pid_by_root[$root] > 0 )); then
			if wait "${pid_by_root[$root]}"; then :; fi
		fi
		status="$(awk 'NR==1 {print; exit}' "$status_file" 2>/dev/null || printf 1)"
		rm -f "$status_file"
		[[ "$status" =~ ^[0-9]+$ ]] || status=1
		trace_event SUPERVISOR_MANAGER_REPLAN_EXIT "root=$root" "status=$status"
		if (( status == 0 )); then
			unset 'replan_failed_fingerprint[$root]'
			rm -f "$dir/control/$PROJECT-task-$root.manager-replan-failed.md"
			continue
		fi
		replan_failed_fingerprint[$root]="$current"
		alert="$dir/control/$PROJECT-task-$root.manager-replan-failed.md"
		tmp="$alert.tmp.$$"
		{
			printf '# Automatic Manager Replan Invocation Failed\n\n'
			printf 'Project: %s\n\n' "$PROJECT"
			printf 'Task-Root: %s\n\n' "$root"
			printf 'Environment-File: %s\n\n' "$HARNESS_ENV_FILE"
			printf 'Needs-Replan-Fingerprint: %s\n\n' "$current"
			printf 'Failed-At: %s\n\n' "$(timestamp_utc)"
			printf 'Exit-Status: %s\n\n' "$status"
			printf 'The supervisor will not repeat this unchanged local failure during its current run. Provider failures retry inside the replan invoker. The root remains in automatic recovery and is not classified as human-dependent.\n'
		} > "$tmp"
		chmod 600 "$tmp"
		mv "$tmp" "$alert"
		log_event "SUPERVISOR_MANAGER_RECOVERY_FAILED root=$root status=$status alert=$alert human_dependency=0"
	done
	log_event "SUPERVISOR_MANAGER_REPLAN_COHORT_FINISHED batch=$batch_id size=${#roots[@]}"
}

process_context_closure_provider_repairs()
{
	local marker outcome action condition trigger base assignment attempt_file input_fingerprint
	local prior_fingerprint ready
	shopt -s nullglob
	for marker in "$dir/control/progress/$PROJECT-task-"*.needs-replan.md; do
		[[ -f "$marker" ]] || continue
		outcome="$(metadata_value "$marker" Trigger-Outcome)"
		[[ "$outcome" == CONTEXT_CLOSURE_REPAIR ]] || continue
		action="$(metadata_value "$marker" Closure-Repair-Action)"
		condition="$(metadata_value "$marker" Closure-Condition)"
		[[ "$action" == REFRESH_INDEX_OR_OVERLAY &&
			"$condition" =~ ^(CLOSURE_BUILD_UNAVAILABLE|INDEX_EVIDENCE_MISSING)$ ]] || continue
		trigger="$(metadata_value "$marker" Triggered-By)"
		validate_task_id "$trigger"
		base="$(task_base "$trigger")"
		assignment="$dir/archive/$base.assignment.md"
		[[ -f "$assignment" ]] || continue
		# A tracked history overlay is a valid current view only when all other
		# generation inputs and provider fingerprints still match. If they do
		# not, leave the typed marker fail-closed for the ordinary provider path.
		repository_index_project_pointer_is_current || continue
		input_fingerprint="$({
			sha256sum "$assignment" "$(repository_index_project_pointer_file)"
			git -C "$REPOSITORY" rev-parse HEAD
			git -C "$REPOSITORY" diff --binary --no-ext-diff "$(kv_file_value "$(repository_index_project_pointer_file)" source_revision)" --
		} | sha256sum | awk '{print "sha256:" $1}')"
		attempt_file="$dir/control/$base.context-provider-repair.env"
		prior_fingerprint=""
		if [[ -f "$attempt_file" ]]; then
			prior_fingerprint="$(kv_file_value "$attempt_file" input_fingerprint)"
		fi
		if [[ "$prior_fingerprint" == "$input_fingerprint" ]]; then
			log_event "CONTEXT_CLOSURE_PROVIDER_RETRY_SUPPRESSED task=$trigger condition=$condition fingerprint=$input_fingerprint reason=identical-input"
			continue
		fi
		{
			printf 'task_id=%s\n' "$trigger"
			printf 'condition=%s\n' "$condition"
			printf 'repair_action=%s\n' "$action"
			printf 'input_fingerprint=%s\n' "$input_fingerprint"
			printf 'requeued_at=%s\n' "$(timestamp_utc)"
		} > "$attempt_file.tmp.$$"
		chmod 600 "$attempt_file.tmp.$$"
		mv "$attempt_file.tmp.$$" "$attempt_file"
		ready="$($HARNESS_BIN/harness-reset-task "$HARNESS_ENV_FILE" "$trigger" --force)"
		rm -f "$marker" "$dir/control/$base.recovery-retired" \
			"$dir/control/$base.manager-replan-failed.md"
		log_event "CONTEXT_CLOSURE_PROVIDER_RETRY_REQUEUED task=$trigger condition=$condition action=$action index_reason=${REPOSITORY_INDEX_POINTER_REASON:--} fingerprint=$input_fingerprint ready=$ready"
	done
}

process_planning_gap()
{
	local status alert stalled tmp current previous marker candidate candidate_fingerprint
	local observed_at now
	project_plan_exists || return 0
	project_plan_all_complete && return 0
	candidate="$dir/control/planning-gap-candidate.env"
	if project_has_active_task; then
		rm -f "$candidate"
		return 0
	fi
	current="$(planning_gap_state_fingerprint)"
	# Worker admission can atomically retire a ready assignment into a typed
	# Context Closure repair. During the few milliseconds between its archive
	# move and replan-marker publication, a manager poll observes a false
	# planning gap. Require the same inactive fingerprint to survive one full
	# second, then check activity once more before spending a planning turn.
	candidate_fingerprint=""
	observed_at=""
	if [[ -f "$candidate" ]]; then
		candidate_fingerprint="$(kv_file_value "$candidate" fingerprint)"
		observed_at="$(kv_file_value "$candidate" observed_at_epoch)"
	fi
	now="$(epoch_now)"
	if [[ "$candidate_fingerprint" != "$current" || ! "$observed_at" =~ ^[0-9]+$ ]]; then
		{
			printf 'fingerprint=%s\n' "$current"
			printf 'observed_at_epoch=%s\n' "$now"
		} > "$candidate.tmp.$$"
		chmod 600 "$candidate.tmp.$$"
		mv "$candidate.tmp.$$" "$candidate"
		log_event "SUPERVISOR_PLANNING_GAP_DEFERRED fingerprint=$current settle_seconds=1"
		return 0
	fi
	(( now - observed_at >= 1 )) || return 0
	if project_has_active_task; then
		rm -f "$candidate"
		return 0
	fi
	rm -f "$candidate"
	stalled="$dir/control/manager-plan-stalled.md"
	alert="$dir/control/manager-plan-failed.md"
	for marker in "$stalled" "$alert"; do
		[[ -f "$marker" ]] || continue
		previous="$(awk -F': ' '$1 == "State-Fingerprint" {print $2; exit}' "$marker")"
		[[ "$previous" != "$current" ]] || return 0
	done
	rm -f "$stalled" "$alert"
	log_event "SUPERVISOR_PLANNING_GAP progress=$(project_plan_progress_percent) pending=$(project_plan_pending_count)"
	trace_event SUPERVISOR_INVOKE_MANAGER_PLAN "manager_plan_invoker=$manager_plan_invoker" "project_progress=$(project_plan_progress_percent)"
	if "$manager_plan_invoker" "$HARNESS_ENV_FILE" 8>&-; then
		status=0
	else
		status=$?
	fi
	trace_event SUPERVISOR_MANAGER_PLAN_EXIT "status=$status"
	if (( status == 0 )); then
		rm -f "$stalled" "$alert" "$dir/control/manager-plan-structural-error.md"
		return 0
	fi
	if (( status == manager_pending_exit_status )); then
		current="$(planning_gap_state_fingerprint)"
		tmp="$stalled.tmp.$$"
		{
			printf '# Manager Planning Stalled\n\n'
			printf 'Project: %s\n\n' "$PROJECT"
			printf 'Environment-File: %s\n\n' "$HARNESS_ENV_FILE"
			printf 'State-Fingerprint: %s\n\n' "$current"
			printf 'Stalled-At: %s\n\n' "$(timestamp_utc)"
			printf 'The manager returned without publishing a task or recording a waiting state. The supervisor will not invoke it again until the plan, decomposition DAG, or architecture bindings change.\n'
		} > "$tmp"
		chmod 600 "$tmp"
		mv "$tmp" "$stalled"
		log_event "SUPERVISOR_PLAN_LEFT_UNCOMMITTED fingerprint=$current retry=suppressed"
		return 0
	fi
	current="$(planning_gap_state_fingerprint)"
	tmp="$alert.tmp.$$"
	{
		printf '# Manager Planning Invocation Failed\n\n'
		printf 'Project: %s\n\n' "$PROJECT"
		printf 'Environment-File: %s\n\n' "$HARNESS_ENV_FILE"
		printf 'Failed-At: %s\n\n' "$(timestamp_utc)"
		printf 'Exit-Status: %s\n\n' "$status"
		printf 'State-Fingerprint: %s\n\n' "$current"
		printf 'The supervisor will not repeat this unchanged planning failure until the plan, decomposition DAG, or architecture bindings change.\n'
	} > "$tmp"
	chmod 600 "$tmp"
	mv "$tmp" "$alert"
}

root_has_live_control_activity()
{
	local root="$1" file file_task
	for file in \
		"$dir/tasks/$PROJECT-task-"*.ready.md \
		"$dir/running/$PROJECT-task-"*.running.md \
		"$dir/results/$PROJECT-task-"*.result.md; do
		[[ -f "$file" ]] || continue
		file_task="$(task_id_from_filename "$file")"
		[[ "$(task_root_id "$file_task")" == "$root" ]] && return 0
	done
	for file in "$dir/control/progress/$PROJECT-task-$root."*.md; do
		[[ -f "$file" ]] && return 0
	done
	return 1
}

process_parallel_planning_capacity()
{
	local capacity active_count item status root candidate plan_status
	[[ "$HARNESS_WORKER_ISOLATION_MODE" == worktree ]] || return 0
	capacity="$(acp_scheduler_capacity)"
	(( capacity > 1 )) || return 0
	# Keep expected false predicates in an explicit conditional.  With errtrace
	# enabled, placing the final predicate in a grouped AND-list can still expose
	# its internal `[[ -f ... ]]` miss to the global ERR trap on some Bash
	# versions, terminating an otherwise healthy parallel supervisor.
	if project_has_token_usage_anomaly || project_has_integrity_anomaly || project_is_blocked; then
		return 0
	fi

	# First restore any active root whose previous leaf was reviewed and which
	# now needs its next bounded revision. Multiple ACTIVE rows must not let the
	# first row monopolize the single logical manager.
	while IFS=$'\t' read -r item status root _; do
		[[ "$status" == ACTIVE && -n "$root" && "$root" != - ]] || continue
		root_has_live_control_activity "$root" && continue
		log_event "ACP_BATCH_PLAN_CONTINUATION item=$item root=$root capacity=$capacity"
		set +e
		HARNESS_BATCH_PLAN_ITEM="$item" "$manager_plan_invoker" "$HARNESS_ENV_FILE" 8>&-
		plan_status=$?
		set -e
		if (( plan_status != 0 )); then
			log_event "ACP_BATCH_PLAN_FAILED item=$item root=$root status=$plan_status"
			return 0
		fi
	done < "$(project_plan_state_file)"

	while true; do
		active_count="$(awk -F '\t' '!/^#/ && $2 == "ACTIVE" {count++} END {print count + 0}' "$(project_plan_state_file)")"
		(( active_count < capacity )) || break
		candidate="$(project_plan_next_parallel_ready_item 2>/dev/null || true)"
		[[ -n "$candidate" ]] || break
		log_event "ACP_BATCH_PLAN_NEW item=$candidate active=$active_count capacity=$capacity"
		set +e
		HARNESS_BATCH_PLAN_ITEM="$candidate" "$manager_plan_invoker" "$HARNESS_ENV_FILE" 8>&-
		plan_status=$?
		set -e
		if (( plan_status != 0 )); then
			log_event "ACP_BATCH_PLAN_FAILED item=$candidate status=$plan_status"
			break
		fi
	done
}

handle_project_completion()
{
	local completion_file completed_task oracle_status pending_file pending_fingerprint alert tmp
	project_has_token_usage_anomaly && return 1
	if project_is_blocked; then
		log_event "SUPERVISOR_PROJECT_BLOCKED file=$(project_block_file)"
		return 1
	fi
	if oracle_enabled && project_plan_all_complete && ! project_completion_recorded; then
		pending_file="$(project_oracle_pending_file)"
		if oracle_audit_budget_exhausted; then
			record_oracle_audit_limit
			mark_project_complete "oracle-run-limit-$MAX_ORACLE_RUNS" "$(project_oracle_limit_file)"
		elif [[ -f "$pending_file" ]]; then
			pending_fingerprint="$(fingerprint "$pending_file")"
			if [[ "$pending_fingerprint" == "$oracle_failed_fingerprint" ]]; then
				return 1
			fi
			log_event "SUPERVISOR_INVOKE_ORACLE pending=$pending_file fingerprint=$pending_fingerprint"
			set +e
			"$oracle_invoker" "$HARNESS_ENV_FILE" 8>&-
			oracle_status=$?
			set -e
			trace_event SUPERVISOR_ORACLE_EXIT "status=$oracle_status"
			if (( oracle_status != 0 )); then
				oracle_failed_fingerprint="$pending_fingerprint"
				alert="$(project_oracle_dir)/oracle-invocation-failed.md"
				tmp="$alert.tmp.$$"
				{
					printf '# Oracle Invocation Failed\n\n'
					printf 'Project: %s\n\n' "$PROJECT"
					printf 'Environment-File: %s\n\n' "$HARNESS_ENV_FILE"
					printf 'Pending-Audit: %s\n\n' "$pending_file"
					printf 'Pending-Fingerprint: %s\n\n' "$pending_fingerprint"
					printf 'Failed-At: %s\n\n' "$(timestamp_utc)"
					printf 'Exit-Status: %s\n\n' "$oracle_status"
					printf 'The supervisor will not retry this unchanged pending audit again during its current run. Correct the local failure and restart the supervisor to retry.\n'
				} > "$tmp"
				chmod 600 "$tmp"
				mv "$tmp" "$alert"
				log_event "SUPERVISOR_ORACLE_FAILED status=$oracle_status fingerprint=$pending_fingerprint alert=$alert retry=suppressed"
			else
				oracle_failed_fingerprint=""
				rm -f "$(project_oracle_dir)/oracle-invocation-failed.md"
			fi
		fi
		project_plan_all_complete || return 1
	fi
	completion_file="$(project_complete_file)"
	[[ -f "$completion_file" ]] || return 1
	if ! project_plan_all_complete; then
		log_event "SUPERVISOR_IGNORED_INVALID_COMPLETION file=$completion_file reason=project_plan_incomplete"
		return 1
	fi
	completed_task="$(kv_file_value "$completion_file" task_id)"
	log_event "SUPERVISOR_PROJECT_COMPLETED task=$completed_task file=$completion_file"
	trace_event SUPERVISOR_PROJECT_COMPLETED "task_id=$completed_task" "completion_file=$completion_file"
	terminate_descendants_of_pid "$$"
	supervisor_exit_status=0
	return 0
}

log_event "SUPERVISOR_STARTED pid=$$ env_file=$HARNESS_ENV_FILE"
printf 'Supervisor started for %s with PID %s. No LLM is running while idle.\n' "$PROJECT" "$$"

while true; do
	harness_supervisor_process_cycle
	if [[ "$HARNESS_SUPERVISOR_CYCLE_RESULT" == COMPLETE ]]; then break; fi
	if [[ "$HARNESS_SUPERVISOR_CYCLE_RESULT" == WAIT ]]; then
		sleep "$HARNESS_POLL_SECONDS"
		continue
	fi
	[[ "$HARNESS_SUPERVISOR_CYCLE_RESULT" == CONTINUE ]] ||
		die "unexpected supervisor cycle result: $HARNESS_SUPERVISOR_CYCLE_RESULT"
	if [[ "$HARNESS_USE_INOTIFY" == "1" ]] && command -v inotifywait >/dev/null 2>&1; then
		trace_event SUPERVISOR_WATCH_WAIT_BEGIN "mode=inotify" "timeout=$HARNESS_POLL_SECONDS"
		inotifywait -q -t "$HARNESS_POLL_SECONDS" -e moved_to -e delete \
			"$dir/results" "$dir/control" 8>&- >/dev/null 2>&1 &
		watch_pid=$!
		if wait "$watch_pid"; then
			watch_status=0
		else
			# inotifywait exits 2 when its short watch interval expires. That is
			# an ordinary polling tick, not a supervisor failure.
			watch_status=$?
		fi
		trace_event SUPERVISOR_WATCH_WAIT_END "mode=inotify" "watch_pid=$watch_pid" "status=$watch_status"
		watch_pid=""
	else
		trace_event SUPERVISOR_WATCH_WAIT_BEGIN "mode=poll" "timeout=$HARNESS_POLL_SECONDS"
		sleep "$HARNESS_POLL_SECONDS" 8>&-
		trace_event SUPERVISOR_WATCH_WAIT_END "mode=poll" "status=0"
	fi
done
