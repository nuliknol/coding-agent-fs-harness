#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-mode.sh"
harness_dispatch_mode "$SCRIPT_DIR/.." "${0##*/}" "$@"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 1 ]] || usage
load_harness_env "$1"
ensure_project
trace_init manager_supervisor
trace_script_start "$@"
dir="$(project_dir)"
write_oracle_snapshot
manager_invoker="${HARNESS_MANAGER_INVOKER:-$HARNESS_BIN/manager-invoke-result}"
manager_plan_invoker="${HARNESS_MANAGER_PLAN_INVOKER:-$HARNESS_BIN/manager-plan-next-task}"
manager_replan_invoker="${HARNESS_MANAGER_REPLAN_INVOKER:-$HARNESS_BIN/manager-auto-replan-root}"
oracle_invoker="${HARNESS_ORACLE_INVOKER:-$HARNESS_BIN/oracle-invoke-final-audit}"
manager_pending_exit_status=3
[[ -x "$manager_invoker" ]] || die "manager invoker is not executable: $manager_invoker"
[[ -x "$manager_plan_invoker" ]] || die "manager plan invoker is not executable: $manager_plan_invoker"
if (( HARNESS_AUTO_REPLAN_ENABLED == 1 )); then
	[[ -x "$manager_replan_invoker" ]] || die "manager replan invoker is not executable: $manager_replan_invoker"
fi
if oracle_enabled; then
	[[ -x "$oracle_invoker" ]] || die "oracle invoker is not executable: $oracle_invoker"
fi

exec 8>"$dir/control/supervisor.lock"
flock -n 8 || die "a supervisor is already running for project: $PROJECT"
printf '%s\n' "$$" > "$dir/control/supervisor.pid"
printf '%s\n' "$HARNESS_ENV_FILE" > "$dir/control/supervisor.env-file"
watch_pid=""
supervisor_exit_status=0
current_command=""
oracle_failed_fingerprint=""
declare -A replan_failed_fingerprint=()

log_supervisor_failure()
{
	local status="$1"
	local line="$2"
	local command="$3"
	log_event "SUPERVISOR_FATAL status=$status line=$line command=$(printf '%q' "$command")"
	printf 'Supervisor fatal error for %s: status=%s line=%s command=%s\n' \
		"$PROJECT" "$status" "$line" "$command" >&2
}

cleanup()
{
	if [[ -n "$watch_pid" ]]; then
		kill "$watch_pid" 2>/dev/null || true
	fi
	rm -f "$dir/control/supervisor.pid" "$dir/control/supervisor.env-file"
	trace_script_exit "$supervisor_exit_status"
	if (( supervisor_exit_status != 0 )); then
		log_event "SUPERVISOR_EXIT status=$supervisor_exit_status"
	fi
}
trap 'supervisor_exit_status=$?; current_command=$BASH_COMMAND; if (( supervisor_exit_status != 0 )); then log_supervisor_failure "$supervisor_exit_status" "$LINENO" "$current_command"; fi' ERR
trap 'cleanup; exit 0' INT TERM
trap cleanup EXIT

fingerprint()
{
	local file="$1"
	stat -c '%i:%s:%Y' "$file"
}

review_state_fingerprint()
{
	local result="$1" candidate architecture dependency_dir
	architecture="$(architecture_dir)"
	dependency_dir="$(dependency_request_dir)"
	{
		for candidate in \
			"$result" \
			"$(project_plan_definition_file)" \
			"$(project_plan_state_file)" \
			"$(project_decomposition_plan_file)" \
			"$dir/control/agent-commits.tsv"; do
			if [[ -f "$candidate" ]]; then
				sha256sum "$candidate"
			else
				printf 'missing  %s\n' "$candidate"
			fi
		done
		if [[ -d "$architecture" ]]; then
			find "$architecture" -maxdepth 1 -type f \
				\( -name '*.tsv' -o -name 'profile.env' \) -print0 |
				LC_ALL=C sort -z | xargs -0 -r sha256sum
		else
			printf 'missing  %s\n' "$architecture"
		fi
		if [[ -d "$dependency_dir" ]]; then
			find "$dependency_dir" -maxdepth 1 -type f \
				\( -name '*.waiting.md' -o -name '*.requirements.tsv' -o -name '*.resolved.md' \) -print0 |
				LC_ALL=C sort -z | xargs -0 -r sha256sum
		else
			printf 'missing  %s\n' "$dependency_dir"
		fi
		git -C "$REPOSITORY" rev-parse HEAD 2>/dev/null || printf 'UNBORN\n'
	} | sha256sum | awk '{print "sha256:" $1}'
}

planning_gap_state_fingerprint()
{
	local file
	for file in \
		"$(project_plan_definition_file)" \
		"$(project_plan_state_file)" \
		"$(project_decomposition_plan_file)" \
		"$(architecture_node_bindings_file)"; do
		if [[ -f "$file" ]]; then
			sha256sum "$file"
		else
			printf 'missing  %s\n' "$file"
		fi
	done | sha256sum | awk '{print "sha256:" $1}'
}

process_results()
{
	local file task_id base marker current previous invocation_fingerprint post_fingerprint review_state_changed status alert stalled tmp running lease assignment_archive accepted checkpointed rejected blocked
	shopt -s nullglob
	for file in "$dir/results/$PROJECT-task-"*.result.md; do
		task_id="$(task_id_from_filename "$file")"
		base="$(task_base "$task_id")"
		running="$dir/running/$base.running.md"
		lease="$dir/control/$base.lease"
		assignment_archive="$dir/archive/$base.assignment.md"
		accepted="$dir/archive/$base.accepted.md"
		checkpointed="$dir/archive/$base.checkpointed.md"
		rejected="$dir/archive/$base.rejected.md"
		blocked="$dir/archive/$base.blocked.md"

		# A result becomes reviewable only after the worker completion transaction
		# has archived the assignment and removed the lease. An agent may write a
		# result file directly before worker-complete-task finishes; ignore that
		# intermediate state and reconcile it on a later scan.
		if [[ -e "$running" || -e "$lease" || ! -f "$assignment_archive" ]]; then
			continue
		fi

		marker="$dir/control/$base.reviewed-event"
		stalled="$dir/control/$base.manager-review-stalled.md"
		current="$(review_state_fingerprint "$file")"
		previous=""
		[[ ! -f "$marker" ]] || previous="$(kv_file_value "$marker" fingerprint)"
		[[ "$current" != "$previous" ]] || continue
		rm -f "$stalled"
		invocation_fingerprint="$current"
		review_state_changed=0
		[[ -z "$previous" ]] || review_state_changed=1

		log_event "SUPERVISOR_TRIGGER task=$task_id fingerprint=$current"
		trace_event SUPERVISOR_INVOKE_MANAGER "task_id=$task_id" "fingerprint=$current" "manager_invoker=$manager_invoker"
		if HARNESS_REVIEW_STATE_CHANGED="$review_state_changed" \
			"$manager_invoker" "$HARNESS_ENV_FILE" "$task_id" 8>&-; then
			status=0
		else
			status=$?
		fi
		trace_event SUPERVISOR_MANAGER_EXIT "task_id=$task_id" "status=$status"
		if (( status == 0 )); then
			if [[ -f "$file" ]]; then
				current="$(review_state_fingerprint "$file")"
				log_event "SUPERVISOR_RESULT_STILL_PRESENT task=$task_id accepted=$([[ -f "$accepted" ]] && printf 1 || printf 0) checkpointed=$([[ -f "$checkpointed" ]] && printf 1 || printf 0) rejected=$([[ -f "$rejected" ]] && printf 1 || printf 0) blocked=$([[ -f "$blocked" ]] && printf 1 || printf 0)"
				tmp="$marker.tmp.$$"
				{
					printf 'fingerprint=%s\n' "$current"
					printf 'handled_at=%s\n' "$(timestamp_utc)"
					printf 'manager_exit_status=0\n'
				} > "$tmp"
				chmod 600 "$tmp"
				mv "$tmp" "$marker"
				log_event "SUPERVISOR_RESULT_LEFT_PENDING task=$task_id"
			fi
		elif (( status == manager_pending_exit_status )); then
			post_fingerprint="$(review_state_fingerprint "$file")"
			tmp="$marker.tmp.$$"
			{
				# When the review revised durable state, preserve the invocation
				# fingerprint so the next scan performs one fresh review. Only an
				# unchanged no-op is suppressed.
				if [[ "$post_fingerprint" != "$invocation_fingerprint" ]]; then
					printf 'fingerprint=%s\n' "$invocation_fingerprint"
				else
					printf 'fingerprint=%s\n' "$post_fingerprint"
				fi
				printf 'handled_at=%s\n' "$(timestamp_utc)"
				printf 'manager_exit_status=%s\n' "$status"
			} > "$tmp"
			chmod 600 "$tmp"
			mv "$tmp" "$marker"
			if [[ "$post_fingerprint" != "$invocation_fingerprint" ]]; then
				log_event "SUPERVISOR_REVIEW_STATE_CHANGED task=$task_id before=$invocation_fingerprint after=$post_fingerprint retry=fresh_review"
			else
				tmp="$stalled.tmp.$$"
				{
					printf '# Manager Review Stalled\n\n'
					printf 'Project: %s\n\n' "$PROJECT"
					printf 'Task-ID: %s\n\n' "$task_id"
					printf 'State-Fingerprint: %s\n\n' "$post_fingerprint"
					printf 'Stalled-At: %s\n\n' "$(timestamp_utc)"
					printf 'The manager returned without a terminal action or durable state change. The supervisor will not invoke it again until relevant state changes.\n'
				} > "$tmp"
				chmod 600 "$tmp"
				mv "$tmp" "$stalled"
				log_event "SUPERVISOR_REVIEW_LEFT_UNCOMMITTED task=$task_id fingerprint=$post_fingerprint retry=suppressed_until_state_change alert=$stalled"
			fi
		else
			alert="$dir/control/$base.manager-failed.md"
			tmp="$alert.tmp.$$"
			{
				printf '# Manager Invocation Failed\n\n'
				printf 'Project: %s\n\n' "$PROJECT"
				printf 'Task-ID: %s\n\n' "$task_id"
				printf 'Environment-File: %s\n\n' "$HARNESS_ENV_FILE"
				printf 'Failed-At: %s\n\n' "$(timestamp_utc)"
				printf 'Exit-Status: %s\n\n' "$status"
				printf 'Provider quota and transient provider/network failures retry indefinitely inside manager-invoke-result. This failure was classified as terminal or non-provider.\n'
			} > "$tmp"
			chmod 600 "$tmp"
			mv "$tmp" "$alert"
			printf 'Manager invocation failed for task %s; see %s\n' "$task_id" "$alert" >&2
			tmp="$marker.tmp.$$"
			{
				printf 'fingerprint=%s\n' "$current"
				printf 'handled_at=%s\n' "$(timestamp_utc)"
				printf 'manager_exit_status=%s\n' "$status"
			} > "$tmp"
			chmod 600 "$tmp"
			mv "$tmp" "$marker"
		fi
	done
}

project_has_active_task()
{
	compgen -G "$dir/tasks/$PROJECT-task-*.ready.md" >/dev/null ||
		compgen -G "$dir/running/$PROJECT-task-*.running.md" >/dev/null ||
		compgen -G "$dir/results/$PROJECT-task-*.result.md" >/dev/null ||
		compgen -G "$dir/control/progress/$PROJECT-task-*.blocked.md" >/dev/null ||
		compgen -G "$dir/control/progress/$PROJECT-task-*.needs-replan.md" >/dev/null ||
		compgen -G "$dir/control/progress/$PROJECT-task-*.needs-human.md" >/dev/null ||
		compgen -G "$dir/control/progress/$PROJECT-task-*.waiting-dependency.md" >/dev/null ||
		compgen -G "$dir/control/progress/$PROJECT-task-*.replanning.md" >/dev/null
}

process_dependency_requests()
{
	local request
	shopt -s nullglob
	for request in "$(dependency_request_dir)"/*.waiting.md; do
		[[ -f "$request" ]] || continue
		if resolve_dependency_request_if_ready "$request"; then
			log_event "SUPERVISOR_DEPENDENCY_WAKE request=$request"
		fi
	done
}

reclassify_legacy_convergence_human_markers()
{
	local marker name root reason trigger_task
	shopt -s nullglob
	for marker in "$dir/control/progress/$PROJECT-task-"*.needs-human.md; do
		[[ -f "$marker" ]] || continue
		reason="$(awk '/^Reason: / {sub(/^Reason: /, ""); print; exit}' "$marker")"
		case "$reason" in
			"the same blocker survived a bounded automatic replan without durable verified gain"*|\
			"automatic strategy-change budget exhausted without durable verified gain"*)
				;;
			*)
				continue
				;;
		esac
		name="${marker##*/}"
		root="${name#${PROJECT}-task-}"
		root="${root%.needs-human.md}"
		trigger_task="$(awk -F': ' '$1 == "Triggered-By" {print $2; exit}' "$marker")"
		[[ -n "$trigger_task" ]] || trigger_task="$root"
		mark_root_needs_replan "$trigger_task" \
			"legacy convergence pause reclassified as automatic manager remediation: $reason" \
			MANAGER_REMEDIATION >/dev/null
		rm -f "$marker"
		log_event "LEGACY_HUMAN_RECLASSIFIED_MANAGER_REMEDIATION root=$root trigger=$trigger_task reason=$(printf '%q' "$reason")"
	done
}

reclassify_legacy_hard_block_markers()
{
	local marker name root reason trigger_task blocked_review blocker_class
	local remediation_scope human_evidence
	shopt -s nullglob
	for marker in "$dir/control/progress/$PROJECT-task-"*.blocked.md; do
		[[ -f "$marker" ]] || continue
		name="${marker##*/}"
		root="${name#${PROJECT}-task-}"
		root="${root%.blocked.md}"
		trigger_task="$(awk -F': ' '$1 == "Blocked-By-Task" {print $2; exit}' "$marker")"
		[[ -n "$trigger_task" ]] || trigger_task="$root"
		reason="$(awk '/^Reason: / {sub(/^Reason: /, ""); print; exit}' "$marker")"
		[[ -n "$reason" ]] || reason="legacy hard block requires manager-level classification"
		blocked_review="$dir/archive/$(task_base "$trigger_task").blocked.md"
		blocker_class=""
		remediation_scope=""
		human_evidence=""
		if [[ -f "$blocked_review" ]]; then
			blocker_class="$(metadata_value "$blocked_review" Blocker-Class)"
			remediation_scope="$(metadata_value "$blocked_review" Remediation-Scope)"
			human_evidence="$(metadata_value "$blocked_review" Human-Dependency-Evidence)"
		fi
		if hard_block_class_is_human "$blocker_class" && [[ -n "$human_evidence" ]]; then
			mark_root_needs_human "$root" "$trigger_task" "$reason" \
				"$blocker_class" "$human_evidence" >/dev/null
			record_root_hard_block "$trigger_task" "$blocker_class" NEEDS_HUMAN - "$reason"
			rm -f "$marker"
			log_event "LEGACY_HARD_BLOCK_RECLASSIFIED_NEEDS_HUMAN root=$root trigger=$trigger_task blocker_class=$blocker_class reason=$(printf '%q' "$reason")"
			continue
		fi
		if ! hard_block_class_is_local "$blocker_class"; then
			blocker_class="LOCAL_CODE_PREREQUISITE"
		fi
		[[ -n "$remediation_scope" ]] ||
			remediation_scope="repository-local implementation or testability prerequisite identified by the legacy hard-block review"
		mark_root_needs_replan "$trigger_task" \
			"legacy hard block reclassified for manager remediation: $reason" \
			LEGACY_HARD_BLOCKED "$blocker_class" "$remediation_scope" >/dev/null
		record_root_hard_block "$trigger_task" "$blocker_class" MANAGER_REMEDIATION \
			"$remediation_scope" "$reason"
		rm -f "$marker"
		log_event "LEGACY_HARD_BLOCK_RECLASSIFIED_MANAGER_REMEDIATION root=$root trigger=$trigger_task blocker_class=$blocker_class remediation_scope=$(printf '%q' "$remediation_scope") reason=$(printf '%q' "$reason")"
	done
}

process_auto_replans()
{
	local marker name root current status alert tmp
	(( HARNESS_AUTO_REPLAN_ENABLED == 1 )) || return 0
	shopt -s nullglob
	for marker in "$dir/control/progress/$PROJECT-task-"*.needs-replan.md; do
		[[ -f "$marker" ]] || continue
		name="${marker##*/}"
		root="${name#${PROJECT}-task-}"
		root="${root%.needs-replan.md}"
		current="$(fingerprint "$marker")"
		[[ "${replan_failed_fingerprint[$root]:-}" != "$current" ]] || continue
		log_event "SUPERVISOR_INVOKE_MANAGER_REPLAN root=$root fingerprint=$current invoker=$manager_replan_invoker"
		trace_event SUPERVISOR_INVOKE_MANAGER_REPLAN "root=$root" "fingerprint=$current" "manager_replan_invoker=$manager_replan_invoker"
		set +e
		"$manager_replan_invoker" "$HARNESS_ENV_FILE" "$root" 8>&-
		status=$?
		set -e
		trace_event SUPERVISOR_MANAGER_REPLAN_EXIT "root=$root" "status=$status"
		if (( status == 0 )); then
			unset 'replan_failed_fingerprint[$root]'
			rm -f "$dir/control/$PROJECT-task-$root.manager-replan-failed.md"
			continue
		fi
		replan_failed_fingerprint[$root]="$current"
		alert="$dir/control/$PROJECT-task-$root.manager-replan-failed.md"
		tmp="$alert.tmp.$$"
		{
			printf '# Automatic Manager Replan Invocation Failed\n\n'
			printf 'Project: %s\n\n' "$PROJECT"
			printf 'Task-Root: %s\n\n' "$root"
			printf 'Environment-File: %s\n\n' "$HARNESS_ENV_FILE"
			printf 'Needs-Replan-Fingerprint: %s\n\n' "$current"
			printf 'Failed-At: %s\n\n' "$(timestamp_utc)"
			printf 'Exit-Status: %s\n\n' "$status"
			printf 'The supervisor will not repeat this unchanged local failure during its current run. Provider failures retry inside the replan invoker. The root remains in automatic recovery and is not classified as human-dependent.\n'
		} > "$tmp"
		chmod 600 "$tmp"
		mv "$tmp" "$alert"
		log_event "SUPERVISOR_MANAGER_RECOVERY_FAILED root=$root status=$status alert=$alert human_dependency=0"
	done
}

process_planning_gap()
{
	local status alert stalled tmp current previous marker
	project_plan_exists || return 0
	project_plan_all_complete && return 0
	project_has_active_task && return 0
	current="$(planning_gap_state_fingerprint)"
	stalled="$dir/control/manager-plan-stalled.md"
	alert="$dir/control/manager-plan-failed.md"
	for marker in "$stalled" "$alert"; do
		[[ -f "$marker" ]] || continue
		previous="$(awk -F': ' '$1 == "State-Fingerprint" {print $2; exit}' "$marker")"
		[[ "$previous" != "$current" ]] || return 0
	done
	rm -f "$stalled" "$alert"
	log_event "SUPERVISOR_PLANNING_GAP progress=$(project_plan_progress_percent) pending=$(project_plan_pending_count)"
	trace_event SUPERVISOR_INVOKE_MANAGER_PLAN "manager_plan_invoker=$manager_plan_invoker" "project_progress=$(project_plan_progress_percent)"
	if "$manager_plan_invoker" "$HARNESS_ENV_FILE" 8>&-; then
		status=0
	else
		status=$?
	fi
	trace_event SUPERVISOR_MANAGER_PLAN_EXIT "status=$status"
	if (( status == 0 )); then
		rm -f "$stalled" "$alert" "$dir/control/manager-plan-structural-error.md"
		return 0
	fi
	if (( status == manager_pending_exit_status )); then
		current="$(planning_gap_state_fingerprint)"
		tmp="$stalled.tmp.$$"
		{
			printf '# Manager Planning Stalled\n\n'
			printf 'Project: %s\n\n' "$PROJECT"
			printf 'Environment-File: %s\n\n' "$HARNESS_ENV_FILE"
			printf 'State-Fingerprint: %s\n\n' "$current"
			printf 'Stalled-At: %s\n\n' "$(timestamp_utc)"
			printf 'The manager returned without publishing a task or recording a waiting state. The supervisor will not invoke it again until the plan, decomposition DAG, or architecture bindings change.\n'
		} > "$tmp"
		chmod 600 "$tmp"
		mv "$tmp" "$stalled"
		log_event "SUPERVISOR_PLAN_LEFT_UNCOMMITTED fingerprint=$current retry=suppressed"
		return 0
	fi
	current="$(planning_gap_state_fingerprint)"
	tmp="$alert.tmp.$$"
	{
		printf '# Manager Planning Invocation Failed\n\n'
		printf 'Project: %s\n\n' "$PROJECT"
		printf 'Environment-File: %s\n\n' "$HARNESS_ENV_FILE"
		printf 'Failed-At: %s\n\n' "$(timestamp_utc)"
		printf 'Exit-Status: %s\n\n' "$status"
		printf 'State-Fingerprint: %s\n\n' "$current"
		printf 'The supervisor will not repeat this unchanged planning failure until the plan, decomposition DAG, or architecture bindings change.\n'
	} > "$tmp"
	chmod 600 "$tmp"
	mv "$tmp" "$alert"
}

handle_project_completion()
{
	local completion_file completed_task oracle_status pending_file pending_fingerprint alert tmp
	if project_is_blocked; then
		log_event "SUPERVISOR_PROJECT_BLOCKED file=$(project_block_file)"
		return 1
	fi
	if oracle_enabled && project_plan_all_complete && ! project_completion_recorded; then
		pending_file="$(project_oracle_pending_file)"
		if oracle_audit_budget_exhausted; then
			record_oracle_audit_limit
			mark_project_complete "oracle-run-limit-$MAX_ORACLE_RUNS" "$(project_oracle_limit_file)"
		elif [[ -f "$pending_file" ]]; then
			pending_fingerprint="$(fingerprint "$pending_file")"
			if [[ "$pending_fingerprint" == "$oracle_failed_fingerprint" ]]; then
				return 1
			fi
			log_event "SUPERVISOR_INVOKE_ORACLE pending=$pending_file fingerprint=$pending_fingerprint"
			set +e
			"$oracle_invoker" "$HARNESS_ENV_FILE" 8>&-
			oracle_status=$?
			set -e
			trace_event SUPERVISOR_ORACLE_EXIT "status=$oracle_status"
			if (( oracle_status != 0 )); then
				oracle_failed_fingerprint="$pending_fingerprint"
				alert="$(project_oracle_dir)/oracle-invocation-failed.md"
				tmp="$alert.tmp.$$"
				{
					printf '# Oracle Invocation Failed\n\n'
					printf 'Project: %s\n\n' "$PROJECT"
					printf 'Environment-File: %s\n\n' "$HARNESS_ENV_FILE"
					printf 'Pending-Audit: %s\n\n' "$pending_file"
					printf 'Pending-Fingerprint: %s\n\n' "$pending_fingerprint"
					printf 'Failed-At: %s\n\n' "$(timestamp_utc)"
					printf 'Exit-Status: %s\n\n' "$oracle_status"
					printf 'The supervisor will not retry this unchanged pending audit again during its current run. Correct the local failure and restart the supervisor to retry.\n'
				} > "$tmp"
				chmod 600 "$tmp"
				mv "$tmp" "$alert"
				log_event "SUPERVISOR_ORACLE_FAILED status=$oracle_status fingerprint=$pending_fingerprint alert=$alert retry=suppressed"
			else
				oracle_failed_fingerprint=""
				rm -f "$(project_oracle_dir)/oracle-invocation-failed.md"
			fi
		fi
		project_plan_all_complete || return 1
	fi
	completion_file="$(project_complete_file)"
	[[ -f "$completion_file" ]] || return 1
	if ! project_plan_all_complete; then
		log_event "SUPERVISOR_IGNORED_INVALID_COMPLETION file=$completion_file reason=project_plan_incomplete"
		return 1
	fi
	completed_task="$(kv_file_value "$completion_file" task_id)"
	log_event "SUPERVISOR_PROJECT_COMPLETED task=$completed_task file=$completion_file"
	trace_event SUPERVISOR_PROJECT_COMPLETED "task_id=$completed_task" "completion_file=$completion_file"
	terminate_descendants_of_pid "$$"
	supervisor_exit_status=0
	return 0
}

log_event "SUPERVISOR_STARTED pid=$$ env_file=$HARNESS_ENV_FILE"
printf 'Supervisor started for %s with PID %s. No LLM is running while idle.\n' "$PROJECT" "$$"

while true; do
	process_dependency_requests
	if handle_project_completion; then
		break
	fi
	process_results
	if handle_project_completion; then
		break
	fi
	reclassify_legacy_hard_block_markers
	reclassify_legacy_convergence_human_markers
	process_auto_replans
	if handle_project_completion; then
		break
	fi
	process_planning_gap
	if handle_project_completion; then
		break
	fi
	if [[ "$HARNESS_USE_INOTIFY" == "1" ]] && command -v inotifywait >/dev/null 2>&1; then
		trace_event SUPERVISOR_WATCH_WAIT_BEGIN "mode=inotify" "timeout=$HARNESS_POLL_SECONDS"
		inotifywait -q -t "$HARNESS_POLL_SECONDS" -e moved_to -e delete \
			"$dir/results" "$dir/control" 8>&- >/dev/null 2>&1 &
		watch_pid=$!
		if wait "$watch_pid"; then
			watch_status=0
		else
			# inotifywait exits 2 when its short watch interval expires. That is
			# an ordinary polling tick, not a supervisor failure.
			watch_status=$?
		fi
		trace_event SUPERVISOR_WATCH_WAIT_END "mode=inotify" "watch_pid=$watch_pid" "status=$watch_status"
		watch_pid=""
	else
		trace_event SUPERVISOR_WATCH_WAIT_BEGIN "mode=poll" "timeout=$HARNESS_POLL_SECONDS"
		sleep "$HARNESS_POLL_SECONDS" 8>&-
		trace_event SUPERVISOR_WATCH_WAIT_END "mode=poll" "status=0"
	fi
done
