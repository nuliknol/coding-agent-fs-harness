#!/usr/bin/env bash
# One persistent Luna worker with sparse fresh Terra goal/review turns.
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 1 ]] || usage
load_harness_env "$1"
require_dependencies
ensure_project

dir="$(project_dir)"
exec 8>"$dir/control/supervisor.lock"
flock -n 8 || die "a supervisor is already running for project: $PROJECT"
printf '%s\n' "$$" > "$dir/control/supervisor.pid"
chmod 600 "$dir/control/supervisor.pid"

cleanup()
{
	local recorded
	recorded="$(supervisor_pid 2>/dev/null || true)"
	if [[ "$recorded" == "$$" ]]; then
		rm -f "$dir/control/supervisor.pid"
	fi
}
trap cleanup EXIT
trap 'log_event "SUPERVISOR_STOPPED signal=TERM"; exit 0' TERM INT

fail_harness()
{
	local reason="$1"
	printf '%s\n' "$reason" > "$dir/control/last-error.txt"
	chmod 600 "$dir/control/last-error.txt"
	write_state FAILED TERMINAL_FAILURE "$(state_value cycle 2>/dev/null || printf 0)"
	log_event "HARNESS_FAILED reason=$(printf '%q' "$reason")"
	printf 'Harness failed: %s\n' "$reason" >&2
	exit 1
}

invoke_with_retry()
{
	local role="$1"
	local prompt="$2"
	local stem="$3"
	shift 3
	local jsonl="$dir/logs/$stem.jsonl"
	local stderr_log="$dir/logs/$stem.stderr.log"
	local output="$dir/outputs/$stem.md"
	local classification delay status attempt=0

	while true; do
		attempt=$((attempt + 1))
		log_event "TURN_STARTED role=$role stem=$stem attempt=$attempt"
		set +e
		"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" "$role" \
			"$prompt" "$jsonl" "$stderr_log" "$output" "$@"
		status=$?
		set -e
		classification="$(codex_classification "$jsonl")"
		if (( status == 0 )) && [[ "$classification" == success ]]; then
			log_event "TURN_COMPLETED role=$role stem=$stem attempt=$attempt"
			printf '%s\n' "$output"
			return 0
		fi
		if delay="$(provider_retry_delay "$classification" 2>/dev/null)"; then
			log_event "TURN_RETRY role=$role stem=$stem classification=$classification delay=$delay"
			printf '%s turn %s hit %s; retrying in %s seconds.\n' \
				"$role" "$stem" "$classification" "$delay" >&2
			sleep "$delay"
			continue
		fi
		log_event "TURN_FAILED role=$role stem=$stem classification=$classification status=$status"
		return 1
	done
}

write_context_header()
{
	local prompt="$1"
	local launch_commit current_commit lineage
	current_commit="$(repository_head_commit)" ||
		fail_harness "repository does not have a valid HEAD commit: $REPOSITORY"
	launch_commit="$(project_config_value repository_launch_commit 2>/dev/null || true)"
	[[ "$launch_commit" =~ ^[0-9a-fA-F]{40}$ ]] || launch_commit="$current_commit"
	lineage=diverged
	if git -C "$REPOSITORY" merge-base --is-ancestor \
		"$launch_commit" "$current_commit" 2>/dev/null; then
		lineage=launch-ancestor
	fi
	{
		printf '\n# Harness context\n\n'
		printf 'Project: `%s`\n\n' "$PROJECT"
		printf 'Repository: `%s`\n\n' "$REPOSITORY"
		printf 'Repository launch commit: `%s`\n\n' "$launch_commit"
		printf 'Canonical repository baseline for this turn: `%s`\n\n' \
			"$current_commit"
		printf 'Baseline lineage: `%s`\n\n' "$lineage"
		printf '%s\n\n' \
			'Scope and ownership audits must compare the working tree and index against the canonical baseline above. Commit hashes mentioned inside the specification are historical inspection provenance, not the worker-change baseline.'
		printf '%s\n\n' \
			'Files identical to the canonical baseline are pre-existing repository content. Do not remove or revert them merely because they are outside this task scope. A tracked-file deletion is valid only when an explicit specification requirement requires that deletion.'
		printf 'Immutable specification: `%s`\n\n' "$dir/inputs/specification.txt"
		printf 'Protected source specification: `%s`\n\n' "$SPECIFICATION"
		printf 'Protected harness state: `%s`\n\n' "$dir"
		printf 'Development policy: `%s`\n\n' "$dir/inputs/development-policy.txt"
	} >> "$prompt"
}

generate_goal()
{
	local prompt="$dir/prompts/manager-goal.md"
	local output
	cp "$HARNESS_HOME/prompts/manager-goal.md" "$prompt"
	write_context_header "$prompt"
	write_state ACTIVE GOAL_RUNNING 0
	log_event "GOAL_AUTHORING_STARTED model=$MANAGER_MODEL effort=$MANAGER_REASONING_EFFORT"
	output="$(invoke_with_retry manager_goal "$prompt" manager-goal)" ||
		fail_harness 'Terra goal-authoring turn failed'
	[[ -s "$output" ]] || fail_harness 'Terra returned an empty worker goal'
	[[ "$(tail -n 1 "$output")" == GOAL_READY ]] ||
		fail_harness 'Terra worker goal did not end with GOAL_READY'
	cp "$output" "$dir/control/worker-goal.md"
	chmod 600 "$dir/control/worker-goal.md"
	write_state ACTIVE WORKER_REQUIRED 0
	log_event "GOAL_READY file=$dir/control/worker-goal.md"
}

prepare_worker_prompt()
{
	local cycle="$1"
	local prompt="$dir/prompts/worker-$(printf '%03d' "$cycle").md"
	local addendum
	if (( cycle == 1 )); then
		cp "$HARNESS_HOME/prompts/worker-goal.md" "$prompt"
		write_context_header "$prompt"
		{
			printf '\n# Manager-authored goal\n\n'
			cat "$dir/control/worker-goal.md"
		} >> "$prompt"
	else
		addendum="$dir/addenda/addendum-$(printf '%03d' "$((cycle - 1))").md"
		[[ -f "$addendum" ]] || fail_harness "missing remediation addendum: $addendum"
		cp "$HARNESS_HOME/prompts/worker-remediation.md" "$prompt"
		write_context_header "$prompt"
		{
			printf '\nManager-authored persistent goal: `%s`\n\n' "$dir/control/worker-goal.md"
			printf '# Completion addendum to resolve\n\n'
			cat "$addendum"
		} >> "$prompt"
	fi
	printf '%s\n' "$prompt"
}

run_worker()
{
	local cycle="$1"
	local retry_same_cycle="$2"
	local prompt output stem thread
	prompt="$(prepare_worker_prompt "$cycle")"
	stem="worker-$(printf '%03d' "$cycle")"
	thread=""
	[[ ! -f "$dir/control/worker.thread" ]] ||
		thread="$(awk 'NR == 1 { print; exit }' "$dir/control/worker.thread")"
	write_state ACTIVE WORKER_RUNNING "$cycle"
	log_event "WORKER_STARTED cycle=$cycle mode=$([[ -n "$thread" ]] && printf resume || printf fresh) model=$WORKER_MODEL effort=$WORKER_REASONING_EFFORT retry=$retry_same_cycle"
	if [[ -n "$thread" ]]; then
		output="$(invoke_with_retry worker "$prompt" "$stem" resume "$thread")" ||
			fail_harness "Luna worker turn failed in cycle $cycle"
	else
		output="$(invoke_with_retry worker "$prompt" "$stem")" ||
			fail_harness "Luna worker turn failed in cycle $cycle"
		thread="$(codex_thread_id_from_jsonl "$dir/logs/$stem.jsonl")"
		[[ "$thread" =~ ^[A-Za-z0-9._:-]+$ ]] ||
			fail_harness 'Luna worker thread ID was not recorded'
		printf '%s\n' "$thread" > "$dir/control/worker.thread"
		chmod 600 "$dir/control/worker.thread"
	fi
	[[ -s "$output" ]] || fail_harness "Luna worker returned an empty report in cycle $cycle"
	write_state ACTIVE REVIEW_REQUIRED "$cycle"
	log_event "WORKER_DELIVERED cycle=$cycle thread=$thread report=$output"
}

prepare_review_prompt()
{
	local cycle="$1"
	local prompt="$dir/prompts/manager-review-$(printf '%03d' "$cycle").md"
	local addendum checklist
	cp "$HARNESS_HOME/prompts/manager-review.md" "$prompt"
	write_context_header "$prompt"
	if (( cycle == 1 )) &&
		[[ "$HARNESS_MANAGER_REVIEW_CHECKLIST" != none ]]; then
		checklist="$HARNESS_HOME/prompts/manager-review-checklist-$HARNESS_MANAGER_REVIEW_CHECKLIST.md"
		[[ -f "$checklist" ]] ||
			fail_harness "manager review checklist is unavailable: $checklist"
		{
			printf '\n# Operator-selected first-review checklist\n\n'
			cat "$checklist"
			printf '\n'
		} >> "$prompt"
		log_event "MANAGER_REVIEW_CHECKLIST_ATTACHED cycle=$cycle profile=$HARNESS_MANAGER_REVIEW_CHECKLIST"
	fi
	{
		printf 'Manager-authored persistent goal: `%s`\n\n' "$dir/control/worker-goal.md"
		printf 'Latest worker report: `%s`\n\n' \
			"$dir/outputs/worker-$(printf '%03d' "$cycle").md"
		printf 'This is review cycle %s.\n\n' "$cycle"
		printf '# Earlier addenda\n\n'
	} >> "$prompt"
	shopt -s nullglob
	for addendum in "$dir/addenda/"*.md; do
		printf -- '- `%s`\n' "$addendum" >> "$prompt"
	done
	shopt -u nullglob
	printf '%s\n' "$prompt"
}

review_worker()
{
	local cycle="$1"
	local prompt output stem review decision addendum
	prompt="$(prepare_review_prompt "$cycle")"
	stem="manager-review-$(printf '%03d' "$cycle")"
	write_state ACTIVE REVIEW_RUNNING "$cycle"
	log_event "MANAGER_REVIEW_STARTED cycle=$cycle model=$MANAGER_MODEL effort=$MANAGER_REASONING_EFFORT"
	output="$(invoke_with_retry manager_review "$prompt" "$stem")" ||
		fail_harness "Terra manager review failed in cycle $cycle"
	[[ -s "$output" ]] || fail_harness "Terra returned an empty review in cycle $cycle"
	decision="$(sed -n '1{s/^DECISION: //;p;q;}' "$output")"
	[[ "$decision" == ACCEPT || "$decision" == REVISE ]] ||
		fail_harness "Terra review cycle $cycle returned invalid decision '$decision'"
	review="$dir/reviews/review-$(printf '%03d' "$cycle").md"
	cp "$output" "$review"
	chmod 600 "$review"
	log_event "MANAGER_REVIEW_FINISHED cycle=$cycle decision=$decision review=$review"

	if [[ "$decision" == ACCEPT ]]; then
		cp "$review" "$dir/control/final-acceptance.md"
		write_state COMPLETE ACCEPTED "$cycle"
		log_event "PROJECT_COMPLETED cycle=$cycle acceptance=$dir/control/final-acceptance.md"
		return
	fi

	addendum="$dir/addenda/addendum-$(printf '%03d' "$cycle").md"
	cp "$review" "$addendum"
	chmod 600 "$addendum"
	if (( HARNESS_MAX_MANAGER_REVIEWS > 0 &&
		cycle >= HARNESS_MAX_MANAGER_REVIEWS )); then
		write_state PAUSED REVIEW_LIMIT_REACHED "$cycle"
		log_event "REVIEW_LIMIT_REACHED cycle=$cycle max=$HARNESS_MAX_MANAGER_REVIEWS addendum=$addendum"
		return
	fi
	write_state ACTIVE WORKER_REQUIRED "$cycle"
	log_event "ADDENDUM_PUBLISHED cycle=$cycle addendum=$addendum"
}

log_event "SUPERVISOR_STARTED pid=$$ env_file=$HARNESS_ENV_FILE"

phase="$(state_value phase)"
cycle="$(state_value cycle)"
case "$phase" in
	GOAL_RUNNING)
		[[ -f "$dir/control/worker-goal.md" ]] &&
			write_state ACTIVE WORKER_REQUIRED 0 ||
			write_state ACTIVE GOAL_REQUIRED 0
		;;
	WORKER_RUNNING)
		if [[ ! -f "$dir/control/worker.thread" ]]; then
			thread="$(codex_thread_id_from_jsonl "$dir/logs/worker-$(printf '%03d' "$cycle").jsonl" 2>/dev/null || true)"
			if [[ "$thread" =~ ^[A-Za-z0-9._:-]+$ ]]; then
				printf '%s\n' "$thread" > "$dir/control/worker.thread"
			fi
		fi
		write_state ACTIVE WORKER_RETRY "$cycle"
		;;
	REVIEW_RUNNING)
		write_state ACTIVE REVIEW_REQUIRED "$cycle"
		;;
esac

while true; do
	status="$(state_value status)"
	phase="$(state_value phase)"
	cycle="$(state_value cycle)"
	case "$status:$phase" in
		COMPLETE:ACCEPTED|PAUSED:REVIEW_LIMIT_REACHED)
			break
			;;
		FAILED:*)
			exit 1
			;;
		ACTIVE:GOAL_REQUIRED)
			generate_goal
			;;
		ACTIVE:WORKER_REQUIRED)
			run_worker "$((cycle + 1))" 0
			;;
		ACTIVE:WORKER_RETRY)
			run_worker "$cycle" 1
			;;
		ACTIVE:REVIEW_REQUIRED)
			review_worker "$cycle"
			;;
		*)
			fail_harness "unsupported state status=$status phase=$phase cycle=$cycle"
			;;
	esac
done

log_event "SUPERVISOR_EXIT status=$(state_value status) phase=$(state_value phase)"
