#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
require_manager_codex
project_plan_exists && { printf 'Decomposition DAG already exists.\n'; exit 0; }
decomposition_candidate_matches_current_inputs || die 'no rejected decomposition candidate matches the current inputs'
[[ "$(decomposition_candidate_state_value status)" == REJECTED ]] || die 'decomposition repair requires a rejected candidate'
architecture_fit_is_accepted || die 'decomposition repair requires a current accepted architecture-fit review or force waiver'

trace_init manager_decomposition_repair
trace_script_start "$@"
trap 'trace_script_exit $?' EXIT
dir="$(project_dir)"

# Revalidate once under the current deterministic validators. This can install
# a candidate rejected by an older release and records exact diagnostics for
# candidates created before rejection logging existed.
set +e
"$HARNESS_BIN/manager-submit-decomposition" --recover "$HARNESS_ENV_FILE"
revalidate_status=$?
set -e
project_plan_exists && { printf 'Rejected decomposition candidate passed current validation.\n'; exit 0; }
(( revalidate_status != 0 )) || die 'candidate revalidation returned success without installing a plan'

candidate_dir="$(decomposition_candidate_state_value directory)"
architecture_dir="$(decomposition_candidate_state_value architecture_directory -)"
rejection_log="$(decomposition_candidate_state_value rejection_log "$candidate_dir/rejection.log")"
[[ -s "$rejection_log" ]] || die 'rejected candidate has no deterministic validator diagnostics'
candidate_id="${candidate_dir##*/}"
repair_dir="$PROJECT_TMP_DIR/decomposition-repair-$candidate_id"
rm -rf -- "$repair_dir"
mkdir -p "$repair_dir"
install -m 600 "$candidate_dir/dag.tsv" "$repair_dir/dag.tsv"
install -m 600 "$candidate_dir/coverage.tsv" "$repair_dir/coverage.tsv"
repair_architecture=-
if [[ "$architecture_dir" != - ]]; then
	repair_architecture="$repair_dir/architecture"
	mkdir -p "$repair_architecture"
	for name in invariants decisions edges node-bindings health-gates debt; do
		install -m 600 "$architecture_dir/$name.tsv" "$repair_architecture/$name.tsv"
	done
fi

prompt="$dir/control/manager-decomposition-repair.prompt.md"
cat > "$prompt.tmp.$$" <<PROMPT
You are a fresh, bounded decomposition-candidate schema repair agent. Do not edit the repository and do not redesign or re-decompose the task.

ENV_FILE=$HARNESS_ENV_FILE
HARNESS_BIN=$HARNESS_BIN
PROJECT=$PROJECT
PROJECT_TMP_DIR=$PROJECT_TMP_DIR
AGENT_PHASE=decomposition_repair
DAG_FILE=$repair_dir/dag.tsv
SPECIFICATION_COVERAGE_FILE=$repair_dir/coverage.tsv
ARCH_DIR=$repair_architecture
VALIDATOR_DIAGNOSTICS=$rejection_log
REVIEW_READ_MAX_LINES=$HARNESS_VALIDATION_OUTPUT_MAX_LINES
REVIEW_READ_MAX_BYTES=$HARNESS_VALIDATION_OUTPUT_MAX_BYTES

The expensive Sol architecture review and DAG construction are already complete. Read only VALIDATOR_DIAGNOSTICS and the candidate TSV files named above. Do not inspect repository files, the specification, normalized IR, repository inventory, harness source, development policy, Git history, prior agent logs, or unrelated temporary files.

Read exactly one named candidate source per shell action. Every read must end with both \`head -n $HARNESS_VALIDATION_OUTPUT_MAX_LINES\` and \`head -c $HARNESS_VALIDATION_OUTPUT_MAX_BYTES\`. Never concatenate or combine candidate files in one action. Never use cat for inspection or run unbounded sed, awk, rg, grep, diff, or patch-generation output. Every shell action has one aggregate hard transcript budget of REVIEW_READ_MAX_LINES lines and REVIEW_READ_MAX_BYTES bytes across stdout and stderr. When applying a uniform file-local rewrite, write it without printing the rewritten file or generated patch to the transcript, then inspect only the exact bounded rows needed to verify it. The exact manager-submit-decomposition command below is exempt from the one-source rule; keep its output bounded.

Correct only the deterministic schema or validation defect reported in VALIDATOR_DIAGNOSTICS. Preserve node intent, obligation allocation, dependencies, routes, allowed paths, and architecture semantics unless the diagnostic explicitly identifies one of those fields as invalid. Do not add requirements or broaden validation. When the reported defect is a row-wise syntax class, inspect every row of every candidate file named by the complete diagnostic set and apply that same syntax-only correction to every occurrence before submitting. For broad-aggregate rejections, fix every reported DAG focused_validation, invariant, edge, and health-gate row in the same turn: capture or tolerate the unrelated aggregate exit and independently assert the owned focused result; do not make the broad aggregate's exit code a success condition unless the governing command already contains HARNESS_BROAD_GATE_REQUIRED=1.

After one bounded inspection and correction, submit the repaired copy through a bounded transcript with exactly:

SUBMISSION_TRANSCRIPT=$repair_dir/submission.log
submit_status=0
$HARNESS_BIN/manager-submit-decomposition "$HARNESS_ENV_FILE" "$repair_dir/dag.tsv" "$repair_dir/coverage.tsv" "$repair_architecture" > "\$SUBMISSION_TRANSCRIPT" 2>&1 || submit_status=\$?
tail -n $HARNESS_VALIDATION_OUTPUT_MAX_LINES "\$SUBMISSION_TRANSCRIPT" | head -c $HARNESS_VALIDATION_OUTPUT_MAX_BYTES
(( submit_status == 0 ))

If deterministic validation rejects it, read only the new candidate rejection log reported by the command, make at most one further local correction, and submit once more. After success, terminate. Never launch tests, builds, workers, or repository searches.
PROMPT
chmod 600 "$prompt.tmp.$$"
mv "$prompt.tmp.$$" "$prompt"

repair_input_sha="$({
	sha256sum "$prompt" "$repair_dir/dag.tsv" "$repair_dir/coverage.tsv" "$rejection_log"
	if [[ "$repair_architecture" != - ]]; then
		for name in invariants decisions edges node-bindings health-gates debt; do
			sha256sum "$repair_architecture/$name.tsv"
		done
	fi
} | sha256sum | awk '{print $1}')"
repair_implementation_sha="$({
	sha256sum "$0" "$HARNESS_BIN/codex-exec-jsonl"
	printf 'read_lines=%s\nread_bytes=%s\ncommand_bytes=%s\n' \
		"$HARNESS_VALIDATION_OUTPUT_MAX_LINES" "$HARNESS_VALIDATION_OUTPUT_MAX_BYTES" \
		"$HARNESS_MAX_AGENT_COMMAND_OUTPUT_BYTES"
} | sha256sum | awk '{print $1}')"
recovery_marker="$dir/control/startup-recoverable.env"
if [[ -f "$recovery_marker" ]] &&
	[[ "$(kv_file_value "$recovery_marker" state)" == RECOVERABLE ]] &&
	[[ "$(kv_file_value "$recovery_marker" stage)" == decomposition_repair ]] &&
	[[ "$(kv_file_value "$recovery_marker" specification_sha256)" == "$(specification_sha256)" ]] &&
	[[ "$(kv_file_value "$recovery_marker" repository_baseline)" == "$(specification_review_repository_baseline)" ]] &&
	[[ "$(kv_file_value "$recovery_marker" domain_profiles_sha256)" == "$(domain_profiles_sha256)" ]] &&
	[[ "$(kv_file_value "$recovery_marker" input_sha256)" == "$repair_input_sha" ]] &&
	[[ "$(kv_file_value "$recovery_marker" harness_implementation_sha256)" == "$repair_implementation_sha" ]]; then
	printf 'Decomposition-repair startup remains recoverable; refusing to replay the unchanged failed input. Fix or update the harness, then restart: %s\n' "$recovery_marker" >&2
	exit 7
elif [[ -f "$recovery_marker" ]]; then
	resolved_marker="$dir/logs/startup-recovery-resumed-$(timestamp_compact_utc)-$$.env"
	mv "$recovery_marker" "$resolved_marker"
	log_event "STARTUP_RECOVERY_RESUMED stage=decomposition_repair prior=$resolved_marker resume_from=rejected_decomposition_candidate input=$prompt"
fi

attempt=1
while true; do
	stamp="$(timestamp_compact_utc)"
	json="$dir/logs/manager-decomposition-repair-$stamp-attempt-$(printf '%03d' "$attempt").jsonl"
	stderr="$dir/logs/manager-decomposition-repair-$stamp-attempt-$(printf '%03d' "$attempt").stderr.log"
	message="$dir/logs/manager-decomposition-repair-$stamp-attempt-$(printf '%03d' "$attempt").md"
	set +e
	"$HARNESS_BIN/codex-exec-jsonl" "$HARNESS_ENV_FILE" decomposition "$DECOMPOSITION_MODEL" "$prompt" "$json" "$stderr" "$message"
	status=$?
	set -e
	if project_plan_exists; then
		log_event "DECOMPOSITION_REPAIR_ACCEPTED candidate=$candidate_id attempts=$attempt"
		printf 'Decomposition candidate repaired and installed.\n'
		exit 0
	fi
new_candidate_dir="$(decomposition_candidate_state_value directory -)"
if [[ "$new_candidate_dir" != - && "$new_candidate_dir" != "$candidate_dir" ]] &&
	decomposition_candidate_matches_current_inputs; then
	# A submission may durably stage/reject the corrected candidate and then
	# exceed the enclosing command transcript cap while printing diagnostics.
	# Durable state is progress regardless of the agent wrapper's later status.
	log_event "DECOMPOSITION_REPAIR_PROGRESS previous=$candidate_id current=${new_candidate_dir##*/} status=$(decomposition_candidate_state_value status -)"
	printf 'Decomposition repair produced a new durable candidate; continuing bounded validation.\n'
	exit 0
	fi
	classification="$(kv_file_value "${json%.jsonl}.classification" classification 2>/dev/null || true)"
	if [[ "$classification" == agent_command_output_budget_exceeded ]]; then
		classification_file="${json%.jsonl}.classification"
		{
			printf 'state=RECOVERABLE\n'
			printf 'stage=decomposition_repair\n'
			printf 'resume_from=rejected_decomposition_candidate\n'
			printf 'classification=%s\n' "$classification"
			printf 'offending_input=%s\n' "$prompt"
			printf 'input_sha256=%s\n' "$repair_input_sha"
			printf 'classification_file=%s\n' "$classification_file"
			printf 'jsonl=%s\n' "$json"
			printf 'specification_review_report=%s\n' "$(specification_review_report_relative_path)"
			printf 'architecture_fit_report=%s\n' "$(architecture_fit_state_value report force-waiver)"
			printf 'specification_sha256=%s\n' "$(specification_sha256)"
			printf 'repository_baseline=%s\n' "$(specification_review_repository_baseline)"
			printf 'domain_profiles_sha256=%s\n' "$(domain_profiles_sha256)"
			printf 'harness_implementation_sha256=%s\n' "$repair_implementation_sha"
			printf 'recorded_at=%s\n' "$(timestamp_utc)"
		} > "$recovery_marker.tmp.$$"
		chmod 600 "$recovery_marker.tmp.$$"
		mv "$recovery_marker.tmp.$$" "$recovery_marker"
		log_event "STARTUP_RECOVERABLE stage=decomposition_repair classification=$classification input=$prompt input_sha256=$repair_input_sha classification_file=$classification_file resume_from=rejected_decomposition_candidate"
		printf 'Decomposition-repair startup paused recoverably after a command-output limit hit; rejected candidate is preserved: %s\n' "$recovery_marker" >&2
		exit 7
	fi
	retry_kind="$(codex_provider_retry_kind "$classification" 2>/dev/null || true)"
	if [[ -n "$retry_kind" ]]; then
		delay="$(codex_provider_retry_delay "$classification")"
		printf 'Decomposition repair provider retry in %s seconds (%s).\n' "$delay" "$retry_kind" >&2
		sleep "$delay"
		attempt=$((attempt + 1))
		continue
	fi
	(( status == 0 )) && die 'decomposition repair exited without installing the candidate'
	die "decomposition repair failed with status $status; see $json"
done
