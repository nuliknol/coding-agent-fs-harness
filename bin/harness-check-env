#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-mode.sh"
harness_dispatch_mode "$SCRIPT_DIR/.." "${0##*/}" "$@"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 1 ]] || usage
load_harness_env "$1"
require_manager_configuration
require_manager_codex
require_worker_codex
require_oracle_codex
require_goal_mode_clean_boundary
if [[ "$HARNESS_REPOSITORY_INDEX_MODE" != off ]]; then
	command -v sqlite3 >/dev/null 2>&1 || die 'repository indexing requires sqlite3'
	command -v jq >/dev/null 2>&1 || die 'repository indexing requires jq'
	if [[ "$HARNESS_SCIP_CLANG_BIN" == */* ]]; then
		[[ -x "$HARNESS_SCIP_CLANG_BIN" ]] || die "scip-clang is not executable: $HARNESS_SCIP_CLANG_BIN"
	else
		command -v "$HARNESS_SCIP_CLANG_BIN" >/dev/null 2>&1 || die "scip-clang command not found: $HARNESS_SCIP_CLANG_BIN"
	fi
	if [[ "$HARNESS_SCIP_BIN" == */* ]]; then
		[[ -x "$HARNESS_SCIP_BIN" ]] || die "SCIP CLI is not executable: $HARNESS_SCIP_BIN"
	else
		command -v "$HARNESS_SCIP_BIN" >/dev/null 2>&1 || die "SCIP CLI command not found: $HARNESS_SCIP_BIN"
	fi
	if [[ "$HARNESS_SCIP_IMPORTER_BIN" == */* ]]; then
		[[ -x "$HARNESS_SCIP_IMPORTER_BIN" ]] ||
			die "SCIP importer is not executable: $HARNESS_SCIP_IMPORTER_BIN; run harness-build-index-tools"
	else
		command -v "$HARNESS_SCIP_IMPORTER_BIN" >/dev/null 2>&1 ||
			die "SCIP importer command not found: $HARNESS_SCIP_IMPORTER_BIN"
	fi
fi

printf 'Environment file: %s\n' "$HARNESS_ENV_FILE"
printf 'Project: %s\n' "$PROJECT"
printf 'Harness mode: %s\n' "$HARNESS_MODE"
printf 'Repository: %s\n' "$REPOSITORY"
printf 'Specification: %s\n' "$SPECIFICATION"
printf 'Harness home: %s\n' "$HARNESS_HOME"
printf 'Harness bin: %s\n' "$HARNESS_BIN"
printf 'Harness state root: %s\n' "$HARNESS_ROOT"
printf 'Project tmp dir: %s\n' "$PROJECT_TMP_DIR"
printf 'Runtime PATH prefix: %s\n' "${HARNESS_RUNTIME_PATH_PREFIX:-(none)}"
printf 'Manager Codex: %s\n' "$MANAGER_CODEX_BIN"
printf 'Manager Codex home: %s\n' "$MANAGER_CODEX_HOME"
printf 'Manager model: %s (%s)\n' "$MANAGER_MODEL" "$MANAGER_REASONING_EFFORT"
printf 'Decomposition model: %s (%s)\n' "$DECOMPOSITION_MODEL" "$DECOMPOSITION_REASONING_EFFORT"
printf 'Manager sandbox: %s\n' "$MANAGER_SANDBOX"
printf 'Worker Codex: %s\n' "$WORKER_CODEX_BIN"
printf 'Worker Codex home: %s\n' "$WORKER_CODEX_HOME"
printf 'Worker model: %s (%s)\n' "$WORKER_MODEL" "$WORKER_REASONING_EFFORT"
printf 'Validated agent source commits: %s\n' "$([[ "$HARNESS_AGENT_COMMITS_ENABLED" == 1 ]] && printf enabled || printf disabled)"
printf 'Source Code Transaction Manager: %s (timeout=%ss conflict-delta<=%s bytes)\n' \
	"$([[ "$HARNESS_SCTM_ENABLED" == 1 ]] && printf enabled || printf disabled)" \
	"$HARNESS_SCTM_SUBMIT_TIMEOUT_SECONDS" "$HARNESS_SCTM_MAX_CONFLICT_DELTA_BYTES"
printf 'Model policy: %s\n' "$HARNESS_MODEL_POLICY"
printf 'Escalation policy: %s\n' "$HARNESS_ESCALATION_POLICY"
if [[ "$HARNESS_MODEL_POLICY" == luna_only ]]; then
	printf 'Terra leaf route: disabled by Luna-only policy\n'
fi
printf 'Repository index mode: %s\n' "$HARNESS_REPOSITORY_INDEX_MODE"
printf 'Repository overlay mode: %s\n' "$HARNESS_REPOSITORY_OVERLAY_MODE"
printf 'Context Closure mode: %s\n' "$HARNESS_CONTEXT_CLOSURE_MODE"
printf 'Context Closure typed expansions: %s x %s bytes\n' \
	"$HARNESS_MAX_CONTEXT_EXPANSIONS_PER_LEAF" "$HARNESS_CONTEXT_EXPANSION_MAX_BYTES"
printf 'Patch-only validation rounds: %s\n' "$HARNESS_PATCH_ONLY_MAX_VALIDATION_ROUNDS"
if [[ "$HARNESS_REPOSITORY_INDEX_MODE" != off ]]; then
	printf 'Repository index root: %s\n' "$HARNESS_REPOSITORY_INDEX_ROOT"
	printf 'Compilation database: %s\n' "${HARNESS_COMPILE_COMMANDS:-auto-discover}"
	printf 'SCIP tools: %s / %s / %s (%s indexing job(s))\n' \
		"$HARNESS_SCIP_CLANG_BIN" "$HARNESS_SCIP_BIN" "$HARNESS_SCIP_IMPORTER_BIN" \
		"$HARNESS_SCIP_CLANG_JOBS"
	printf 'Joern: enabled=%s mode=%s cpus=%s heap=%sMiB nice=%s\n' \
		"$HARNESS_JOERN_ENABLED" "$HARNESS_JOERN_EXECUTION_MODE" \
		"$HARNESS_JOERN_MAX_CPUS" "$HARNESS_JOERN_MAX_HEAP_MB" "$HARNESS_JOERN_NICE_LEVEL"
	printf 'Context Closure bounds: bytes<=%s symbols<=%s modules<=%s ownership<=%s direct-edges<=%s tests<=%s build-targets<=%s estimated-tokens<=%s\n' \
		"$HARNESS_CONTEXT_CLOSURE_MAX_BYTES" "$HARNESS_CONTEXT_CLOSURE_MAX_SYMBOLS" \
		"$HARNESS_CONTEXT_CLOSURE_MAX_MODULES" "$HARNESS_CONTEXT_CLOSURE_MAX_OWNERSHIP_BOUNDARIES" \
		"$HARNESS_CONTEXT_CLOSURE_MAX_DIRECT_RELATIONSHIPS" "$HARNESS_CONTEXT_CLOSURE_MAX_TESTS" \
		"$HARNESS_CONTEXT_CLOSURE_MAX_BUILD_TARGETS" "$HARNESS_CONTEXT_CLOSURE_MAX_ESTIMATED_TOKENS"
fi
if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
	if (( HARNESS_SPECIFICATION_REVIEW_ENABLED == 1 )); then
		command -v tsort >/dev/null 2>&1 || die 'tsort is required for normalized specification dependency validation'
	fi
	printf 'Complexity decomposition: v2 proactive DAG (%s critic)\n' \
		"$([[ "$HARNESS_DECOMPOSITION_CRITIC_ENABLED" == 1 ]] && printf enabled || printf disabled)"
	printf 'Pre-acceptance specification review: %s\n' \
		"$([[ "$HARNESS_SPECIFICATION_REVIEW_ENABLED" == 1 ]] && printf enabled || printf disabled)"
	printf 'Maximum specification IR renormalizations: %s\n' "$HARNESS_MAX_SPECIFICATION_RENORMALIZATIONS"
	printf 'Maximum harness-start agent invocations: %s\n' "$HARNESS_START_MAX_AGENT_INVOCATIONS"
	printf 'Maximum specification-review processed tokens: %s\n' "$HARNESS_MAX_SPECIFICATION_REVIEW_PROCESSED_TOKENS_PER_INVOCATION"
	printf 'Selected domain profiles: %s\n' "${HARNESS_DOMAIN_PROFILES:-none}"
	printf 'Luna leaf route: %s (%s)\n' "$LUNA_WORKER_MODEL" "$LUNA_WORKER_REASONING_EFFORT"
	if [[ "$HARNESS_MODEL_POLICY" != luna_only ]]; then
		printf 'Terra leaf route: %s (%s)\n' "$TERRA_WORKER_MODEL" "$TERRA_WORKER_REASONING_EFFORT"
	fi
	printf 'Preferred worker route: %s\n' "$HARNESS_PREFERRED_WORKER_ROUTE"
	printf 'Minimum Luna DAG nodes: %s%%\n' "$HARNESS_MIN_LUNA_NODE_PERCENT"
	printf 'Minimum Luna coding nodes: %s%%\n' "$HARNESS_MIN_LUNA_CODING_NODE_PERCENT"
	printf 'Architecture guards: %s\n' "$([[ "$HARNESS_ARCHITECTURE_GUARDS" == 1 ]] && printf enabled || printf disabled)"
	printf 'Luna strategy failures before decomposition: %s\n' "$HARNESS_MAX_LUNA_STRATEGY_FAILURES"
	printf 'Maximum Luna Allowed-Scope path groups: %s\n' "$HARNESS_MAX_LUNA_ALLOWED_PATHS"
	printf 'Measured Luna bounds: obligations<=%s score<=%s actions<=%s p95-tokens<=%s files<=%s risk-domains<=%s\n' \
		"$HARNESS_MAX_LUNA_OBLIGATIONS_PER_LEAF" "$HARNESS_MAX_LUNA_COMPLEXITY_SCORE" \
		"$HARNESS_MAX_LUNA_PREDICTED_ACTIONS" "$HARNESS_MAX_LUNA_PREDICTED_P95_TOKENS" \
		"$HARNESS_MAX_LUNA_IMPLEMENTATION_FILES" "$HARNESS_MAX_LUNA_RISK_DOMAINS"
	printf 'Recursive Sol complexity passes: %s\n' "$HARNESS_MAX_COMPLEXITY_DECOMPOSITION_PASSES"
	printf 'Maximum output from one agent command: %s bytes\n' "$HARNESS_MAX_AGENT_COMMAND_OUTPUT_BYTES"
	printf 'Maximum output from one manager command: %s bytes\n' "$HARNESS_MAX_MANAGER_COMMAND_OUTPUT_BYTES"
else
	printf 'Complexity decomposition: legacy v1\n'
fi
printf 'Worker sandbox: %s\n' "$WORKER_SANDBOX"
printf 'Oracle enabled: %s\n' "$ORACLE_ENABLED"
if [[ -n "$MAX_ORACLE_RUNS" ]]; then
	printf 'Maximum Oracle runs: %s\n' "$MAX_ORACLE_RUNS"
else
	printf 'Maximum Oracle runs: unlimited (legacy ORACLE_ENABLED behavior)\n'
fi
if oracle_enabled; then
	printf 'Oracle Codex: %s\n' "$ORACLE_CODEX_BIN"
	printf 'Oracle Codex home: %s\n' "$ORACLE_CODEX_HOME"
	printf 'Oracle model: %s (%s)\n' "$ORACLE_MODEL" "$ORACLE_REASONING_EFFORT"
	printf 'Oracle fallback model: %s\n' "$ORACLE_FALLBACK_MODEL"
	printf 'Oracle sandbox: %s\n' "$ORACLE_SANDBOX"
fi
printf 'Worker heartbeat seconds: %s\n' "$WORKER_HEARTBEAT_SECONDS"
printf 'Poll seconds: %s\n' "$HARNESS_POLL_SECONDS"
printf 'Wait seconds: %s\n' "$HARNESS_WAIT_SECONDS"
printf 'Stale seconds: %s\n' "$HARNESS_STALE_SECONDS"
printf 'Use inotify: %s\n' "$HARNESS_USE_INOTIFY"
if (( HARNESS_MAX_IDENTICAL_BLOCKERS == 0 )); then
	printf 'Deterministic blocker circuit breaker: disabled\n'
else
	printf 'Deterministic blocker circuit breaker: %s identical zero-progress fingerprints\n' "$HARNESS_MAX_IDENTICAL_BLOCKERS"
fi
printf 'Manager-remediation blocker circuit breaker: %s identical zero-progress fingerprints\n' \
	"$HARNESS_MAX_IDENTICAL_MANAGER_REMEDIATION_BLOCKERS"
if (( HARNESS_MAX_ROOT_ATTEMPTS == 0 )); then
	printf 'Root-attempt replanning guard: disabled\n'
else
	printf 'Root-attempt replanning guard: %s reviewed attempts\n' "$HARNESS_MAX_ROOT_ATTEMPTS"
fi
if (( HARNESS_MAX_ZERO_GAIN_WINDOW == 0 )); then
	printf 'Zero-gain replanning guard: disabled\n'
else
	printf 'Zero-gain replanning guard: %s consecutive reviews without measured or checkpointed gain\n' "$HARNESS_MAX_ZERO_GAIN_WINDOW"
fi
if (( HARNESS_MAX_CHECKPOINTS_WITHOUT_CRITERION == 0 )); then
	printf 'Checkpoint convergence guard: disabled\n'
else
	printf 'Checkpoint convergence guard: %s verified increments without a completed criterion\n' "$HARNESS_MAX_CHECKPOINTS_WITHOUT_CRITERION"
fi
printf 'Monotonic root liveness: reviews=%s replans=%s child-criteria=%s depth=%s lifetime=%ss processed-tokens=%s\n' \
	"$HARNESS_MAX_TOTAL_ROOT_REVIEWS" "$HARNESS_MAX_TOTAL_ROOT_REPLANS" \
	"$HARNESS_MAX_ROOT_CHILD_CRITERIA" "$HARNESS_MAX_CRITERION_DEPTH" \
	"$HARNESS_MAX_ROOT_LIFETIME_SECONDS" "$HARNESS_MAX_ROOT_PROCESSED_TOKENS"
printf 'No-criterion-progress circuit breaker: %s reviewed outcomes\n' "$HARNESS_MAX_ROOT_REVIEWS_WITHOUT_CRITERION"
if (( HARNESS_AUTO_REPLAN_ENABLED == 1 )); then
	printf 'Automatic persistent-manager replanning: enabled (%s strategy change(s) without durable verified gain)\n' \
		"$HARNESS_MAX_AUTO_REPLANS_WITHOUT_VERIFIED_GAIN"
else
	printf 'Automatic persistent-manager replanning: disabled\n'
fi
printf 'Rejected-root worker thread reuse: %s\n' "$([[ "$HARNESS_REUSE_WORKER_THREADS" == 1 ]] && printf enabled || printf disabled)"
if (( HARNESS_WORKER_THREAD_MAX_REJECTIONS == 0 )); then
	printf 'Worker thread rejection rotation: unlimited\n'
else
	printf 'Worker thread rejection rotation: %s retained rejections\n' "$HARNESS_WORKER_THREAD_MAX_REJECTIONS"
fi
if (( HARNESS_CLOSURE_MODE_ENABLED == 1 )); then
	printf 'Bounded closure mode: enabled at %s%% (%s fixes, %s focused-smoke runs)\n' \
		"$HARNESS_CLOSURE_MODE_MIN_PROGRESS" "$HARNESS_CLOSURE_MODE_MAX_FIXES" "$HARNESS_CLOSURE_MODE_MAX_SMOKE_RUNS"
else
	printf 'Bounded closure mode: disabled\n'
fi
if (( HARNESS_WORKER_GOAL_MODE == 1 )); then
	printf 'Worker leaf-goal mode: enabled (%s identical iterations, context rotation every %s iterations)\n' \
		"$HARNESS_GOAL_MAX_IDENTICAL_ITERATIONS" "$HARNESS_GOAL_CONTEXT_ROTATION_ITERATIONS"
	printf 'Leaf-goal process budget: %s fixes, %s focused-smoke runs\n' \
		"$HARNESS_GOAL_PROCESS_MAX_FIXES" "$HARNESS_GOAL_PROCESS_MAX_SMOKE_RUNS"
	printf 'Semantic continuation review: %s (fresh worker context after each approved episode)\n' \
		"$([[ "$HARNESS_SEMANTIC_CONTINUATION_REVIEW_ENABLED" == 1 ]] && printf enabled || printf disabled)"
else
	printf 'Worker leaf-goal mode: disabled (legacy one-turn assignments)\n'
fi
printf 'Transient provider retry seconds: %s (retries unlimited)\n' "$HARNESS_PROVIDER_RETRY_SECONDS"
printf 'Quota retry seconds: %s (retries unlimited)\n' "$HARNESS_QUOTA_RETRY_SECONDS"
printf 'Minimum interval between agent launches: %s seconds (project-wide)\n' "$HARNESS_AGENT_MIN_INTERVAL_SECONDS"
printf 'Per-agent circuit breaker: %s item starts, %s live-estimated tokens, %s authoritative processed tokens\n' \
	"$HARNESS_MAX_AGENT_ITEMS_PER_INVOCATION" "$HARNESS_MAX_AGENT_ESTIMATED_PROCESSED_TOKENS_PER_INVOCATION" \
	"$HARNESS_MAX_AGENT_PROCESSED_TOKENS_PER_INVOCATION"
printf 'Per-worker-task processed-token anomaly limit: %s\n' "$HARNESS_MAX_WORKER_TASK_PROCESSED_TOKENS"
printf 'Per-round fixed context estimate for runtime token floors: %s\n' "$HARNESS_AGENT_BASE_CONTEXT_TOKENS_PER_ROUND"
printf 'Global decomposition processed-token limit: %s\n' "$HARNESS_MAX_DECOMPOSITION_PROCESSED_TOKENS_PER_INVOCATION"
printf 'Codex wall timeout seconds: %s (0 means unlimited)\n' "$HARNESS_CODEX_WALL_TIMEOUT_SECONDS"
printf 'Codex idle timeout seconds: %s (0 means unlimited)\n' "$HARNESS_CODEX_IDLE_TIMEOUT_SECONDS"
printf 'Task lifecycle: verified increments are checkpointed; broad criteria may gain append-only children; roots resume by first-unmet leaf; leaf-goal CONTINUE receipts remain worker-internal; verified gain resets bounded automatic-replan escalation\n'
