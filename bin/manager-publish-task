preferred_route_override=0

validate_luna_symbol_context()
{
	local symbol entry suggestion relative
	local -a symbols=() entries=() searchable_paths=()
	[[ -n "$leaf_required_symbols" && "$leaf_required_symbols" != - ]] || return 0
	IFS=',' read -r -a entries <<< "$leaf_context_paths"
	for entry in "${entries[@]}"; do
		entry="$(trim_surrounding_whitespace "$entry")"
		[[ -n "$entry" && "$entry" != /* && "$entry" != ../* && "$entry" != */../* ]] || continue
		[[ -e "$REPOSITORY/$entry" ]] || continue
		searchable_paths+=("$entry")
	done
	# Legacy symbolic capsules have no filesystem-backed entries. Keep their
	# compatibility; explicit modern paths receive the stronger machine check.
	(( ${#searchable_paths[@]} > 0 )) || return 0
	IFS=',' read -r -a symbols <<< "$leaf_required_symbols"
	for symbol in "${symbols[@]}"; do
		symbol="$(trim_surrounding_whitespace "$symbol")"
		[[ -n "$symbol" && "$symbol" != - ]] || continue
		if (cd "$REPOSITORY" && rg -l --fixed-strings --max-count 1 -- "$symbol" \
			"${searchable_paths[@]}" >/dev/null 2>&1 < /dev/null); then
			continue
		fi
		suggestion="$(cd "$REPOSITORY" && rg -l --fixed-strings --max-count 1 -- "$symbol" . \
			2>/dev/null < /dev/null | head -n 3 | paste -sd, - || true)"
		suggestion="${suggestion#./}"
		[[ -n "$suggestion" ]] || suggestion='no repository path found; correct Required-Symbols or route to Terra'
		die "Luna Context-Paths omit Required-Symbol $symbol; add a bounded definition/usage path (repository candidates: $suggestion)"
	done
}

emit_required_symbol_locations()
{
	local symbol entry candidate location relative
	local -a symbols=() entries=() searchable_paths=()
	[[ -n "$leaf_required_symbols" && "$leaf_required_symbols" != - ]] || {
		printf -- '- No required symbols declared.\n'
		return 0
	}
	IFS=',' read -r -a entries <<< "$leaf_context_paths"
	for entry in "${entries[@]}"; do
		entry="$(trim_surrounding_whitespace "$entry")"
		[[ -n "$entry" && "$entry" != /* && "$entry" != ../* && "$entry" != */../* ]] || continue
		[[ -e "$REPOSITORY/$entry" ]] || continue
		searchable_paths+=("$entry")
	done
	IFS=',' read -r -a symbols <<< "$leaf_required_symbols"
	for symbol in "${symbols[@]}"; do
		symbol="$(trim_surrounding_whitespace "$symbol")"
		[[ -n "$symbol" && "$symbol" != - ]] || continue
		candidate=""
		if (( ${#searchable_paths[@]} > 0 )); then
			candidate="$(cd "$REPOSITORY" && rg -l --fixed-strings --max-count 1 -- "$symbol" \
				"${searchable_paths[@]}" 2>/dev/null < /dev/null | LC_ALL=C sort | head -n 1 || true)"
		fi
		if [[ -n "$candidate" ]]; then
			location="$(cd "$REPOSITORY" && rg -n --no-heading --fixed-strings --max-count 1 -- "$symbol" \
				"$candidate" 2>/dev/null < /dev/null | head -n 1 | cut -d: -f1 || true)"
			[[ "$location" =~ ^[1-9][0-9]*$ ]] || location='?'
			printf -- '- `%s`: `%s:%s`\n' "$symbol" "$candidate" "$location"
		else
			printf -- '- `%s`: not located in filesystem-backed Context-Paths\n' "$symbol"
		fi
	done
}

if (( HARNESS_WORKER_GOAL_MODE == 1 )); then
	goal_mode=1
	[[ "$(require_single_metadata_value "$task_file" Execution-Mode 'goal-mode assignment')" == LEAF_GOAL ]] ||
		die 'goal-mode assignment must set Execution-Mode: LEAF_GOAL'
	goal_id="$(require_single_metadata_value "$task_file" Goal-ID 'goal-mode assignment')"
	validate_goal_id "$goal_id"
	goal_target="$(require_single_metadata_value "$task_file" Target-Criterion 'goal-mode assignment')"
	goal_success_evidence="$(require_single_metadata_value "$task_file" Goal-Success-Evidence 'goal-mode assignment')"
	goal_focused_validation="$(require_single_metadata_value "$task_file" Focused-Validation 'goal-mode assignment')"
	goal_allowed_scope="$(require_single_metadata_value "$task_file" Allowed-Scope 'goal-mode assignment')"
	goal_baseline_boundary="$(require_single_metadata_value "$task_file" Baseline-Boundary 'goal-mode assignment')"
	goal_hard_blocks="$(require_single_metadata_value "$task_file" Hard-Block-Conditions 'goal-mode assignment')"
	if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
		scope_metadata_is_path_list "$goal_allowed_scope" ||
			die 'Allowed-Scope must contain only comma-separated repository-relative path prefixes; put descriptive prose in Objective'
		! scope_authorizes_governing_specification "$goal_allowed_scope" ||
			die 'Allowed-Scope must not authorize mutation of the accepted governing specification'
		leaf_type="$(require_single_metadata_value "$task_file" Leaf-Type 'v2 leaf assignment')"
		leaf_complexity="$(require_single_metadata_value "$task_file" Complexity-Class 'v2 leaf assignment')"
		leaf_worker_route="$(require_single_metadata_value "$task_file" Worker-Route 'v2 leaf assignment')"
		leaf_depends_on="$(require_single_metadata_value "$task_file" Depends-On 'v2 leaf assignment')"
		leaf_deliverable="$(require_single_metadata_value "$task_file" Deliverable 'v2 leaf assignment')"
		leaf_required_symbols="$(require_single_metadata_value "$task_file" Required-Symbols 'v2 leaf assignment')"
		leaf_context_paths="$(require_single_metadata_value "$task_file" Context-Paths 'v2 leaf assignment')"
		leaf_architecture_decisions="$(require_single_metadata_value "$task_file" Architecture-Decisions 'v2 leaf assignment')"
		leaf_validation_class="$(metadata_value "$task_file" Validation-Class)"
		[[ -n "$leaf_validation_class" ]] || leaf_validation_class=FOCUSED
		leaf_expected_files="$(require_single_metadata_value "$task_file" Expected-Max-Implementation-Files 'v2 leaf assignment')"
		leaf_expected_turns="$(require_single_metadata_value "$task_file" Expected-Max-Worker-Turns 'v2 leaf assignment')"
		if [[ "$leaf_type" == VERIFICATION_ONLY && "$leaf_expected_files" != 0 ]]; then
			requested_verification_files="$leaf_expected_files"
			tmp_verification_files="$task_file.verification-files.$$"
			awk '
				index($0, "Expected-Max-Implementation-Files: ") == 1 {
					if (!seen++) print "Expected-Max-Implementation-Files: 0"
					next
				}
				{print}
			' "$task_file" > "$tmp_verification_files"
			chmod --reference="$task_file" "$tmp_verification_files"
			mv "$tmp_verification_files" "$task_file"
			leaf_expected_files=0
			log_event "VERIFICATION_FILE_BUDGET_NORMALIZED root=$root task=$task_id requested=$requested_verification_files expected=0"
		fi
		if project_plan_has_column behavioral_concerns; then
			leaf_expected_actions="$(require_single_metadata_value "$task_file" Expected-Max-Agent-Actions 'measured leaf assignment')"
			leaf_predicted_p95="$(require_single_metadata_value "$task_file" Predicted-P95-Tokens 'measured leaf assignment')"
			leaf_effective_p95="$(require_single_metadata_value "$task_file" Effective-P95-Tokens 'measured leaf assignment')"
			leaf_complexity_score="$(require_single_metadata_value "$task_file" Complexity-Score 'measured leaf assignment')"
			leaf_behavioral_concerns="$(require_single_metadata_value "$task_file" Behavioral-Concerns 'measured leaf assignment')"
			leaf_failure_paths="$(require_single_metadata_value "$task_file" Failure-Paths 'measured leaf assignment')"
			leaf_ownership_transitions="$(require_single_metadata_value "$task_file" Ownership-Transitions 'measured leaf assignment')"
			leaf_concurrency_boundaries="$(require_single_metadata_value "$task_file" Concurrency-Boundaries 'measured leaf assignment')"
			leaf_validation_surfaces="$(require_single_metadata_value "$task_file" Validation-Surfaces 'measured leaf assignment')"
			leaf_terra_exception="$(require_single_metadata_value "$task_file" Terra-Exception 'measured leaf assignment')"
			for value in "$leaf_expected_actions" "$leaf_predicted_p95" "$leaf_effective_p95" "$leaf_complexity_score" \
				"$leaf_behavioral_concerns" "$leaf_failure_paths" "$leaf_ownership_transitions" "$leaf_concurrency_boundaries" "$leaf_validation_surfaces"; do
				[[ "$value" =~ ^[0-9]+$ ]] || die 'measured leaf complexity metadata must be nonnegative integers'
			done
			for mapping in \
				"Behavioral-Concerns:9:$leaf_behavioral_concerns" \
				"Failure-Paths:10:$leaf_failure_paths" \
				"Ownership-Transitions:11:$leaf_ownership_transitions" \
				"Concurrency-Boundaries:12:$leaf_concurrency_boundaries" \
				"Validation-Surfaces:13:$leaf_validation_surfaces" \
				"Expected-Max-Implementation-Files:14:$leaf_expected_files" \
				"Expected-Max-Agent-Actions:15:$leaf_expected_actions" \
				"Predicted-P95-Tokens:16:$leaf_predicted_p95"; do
				IFS=: read -r metadata_field report_field actual_value <<< "$mapping"
				if (( measured_recovery_route_override != 2 )); then
					expected_value="$(awk -F '\t' -v node="$plan_item_id" -v field="$report_field" 'NR>1 && $1==node {print $field; exit}' "$(decomposition_complexity_report_file)")"
					if [[ "$metadata_field" == Expected-Max-Implementation-Files && "$leaf_type" == VERIFICATION_ONLY ]]; then
						expected_value=0
					fi
					# Reports created before the source-action floor was introduced
					# remain valid durable DAGs. Compare against the same normalized
					# floor applied to the candidate instead of rejecting our own
					# compatibility correction.
					if [[ "$metadata_field" == Expected-Max-Agent-Actions &&
						"$leaf_expected_files" =~ ^[1-9][0-9]*$ && "$expected_value" =~ ^[0-9]+$ ]] &&
						(( expected_value < HARNESS_MIN_SOURCE_CHANGE_AGENT_ACTIONS )); then
						expected_value="$HARNESS_MIN_SOURCE_CHANGE_AGENT_ACTIONS"
					fi
					[[ "$actual_value" == "$expected_value" ]] ||
						die "$metadata_field must match the deterministic complexity report for $plan_item_id"
				fi
			done
			if (( measured_recovery_route_override == 0 && manager_remediation == 0 )); then
				expected_value="$(project_plan_node_value "$plan_item_id" terra_exception)"
				[[ "$leaf_terra_exception" == "$expected_value" ]] ||
					die "Terra-Exception must match the immutable measured decomposition value for $plan_item_id"
			fi
			if (( measured_recovery_route_override != 2 )); then
				expected_value="$(awk -F '\t' -v node="$plan_item_id" 'NR>1 && $1==node {print $4; exit}' "$(decomposition_complexity_report_file)")"
				[[ "$leaf_complexity_score" == "$expected_value" ]] || die 'Complexity-Score must match the deterministic complexity report'
				expected_value="$(awk -F '\t' -v node="$plan_item_id" 'NR>1 && $1==node {print $17; exit}' "$(decomposition_complexity_report_file)")"
				[[ "$leaf_effective_p95" == "$expected_value" ]] || die 'Effective-P95-Tokens must match the deterministic complexity report'
			fi
		fi
		[[ "$leaf_type" =~ ^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION|VERIFICATION_ONLY|CONTRACT_DESIGN|CROSS_COMPONENT_ARCHITECTURE|CONCURRENCY_PROTOCOL|INTEGRATION|AMBIGUOUS_SPECIFICATION)$ ]] ||
			die "invalid Leaf-Type: $leaf_type"
		[[ "$leaf_complexity" =~ ^(LOW|MEDIUM|HIGH)$ ]] || die "invalid Complexity-Class: $leaf_complexity"
		[[ "$leaf_worker_route" =~ ^(LUNA|TERRA)$ ]] || die "invalid Worker-Route: $leaf_worker_route"
		if [[ "$HARNESS_MODEL_POLICY" == luna_only ]] &&
			[[ "$leaf_worker_route" != LUNA || "$leaf_complexity" != LOW || "$leaf_terra_exception" != - ||
			! "$leaf_type" =~ ^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION|VERIFICATION_ONLY)$ ]]; then
			mark_efficiency_warning MODEL_POLICY_VIOLATION "$task_id" \
				'Luna-only publisher rejected a non-Luna executable assignment before installation' \
				"route=$leaf_worker_route complexity=$leaf_complexity leaf_type=$leaf_type terra_exception=$leaf_terra_exception candidate=$task_file"
			die 'Luna-only policy requires every executable assignment to be a LOW/LUNA implementation, test, mechanical API, focused bug, documentation, or verification leaf with Terra-Exception: -'
		fi
		[[ "$leaf_validation_class" =~ ^(FOCUSED|INCREMENTAL|CLEAN_GLOBAL)$ ]] || die "invalid Validation-Class: $leaf_validation_class"
		if [[ "$leaf_validation_class" == FOCUSED ]]; then
			validate_focused_validation_boundary "$goal_focused_validation" "$goal_success_evidence"
		fi
		validate_static_cmake_validation_paths "$goal_focused_validation"
		validate_static_make_validation_target "$goal_focused_validation"
		if [[ "$leaf_validation_class" == CLEAN_GLOBAL ]]; then
			[[ "$leaf_worker_route" == TERRA && "$leaf_type" == INTEGRATION ]] ||
				die 'CLEAN_GLOBAL validation requires a Terra INTEGRATION leaf'
		fi
		[[ "$leaf_expected_files" =~ ^[0-9]+$ ]] || die 'Expected-Max-Implementation-Files must be a non-negative integer'
		[[ "$leaf_expected_turns" =~ ^[1-9][0-9]*$ ]] || die 'Expected-Max-Worker-Turns must be positive'
		validate_implementation_ready_leaf
		if [[ "$leaf_worker_route" == LUNA ]] && (( leaf_expected_turns > 3 )); then
			requested_luna_turns="$leaf_expected_turns"
			leaf_expected_turns=3
			tmp_turns="$task_file.luna-turns.$$"
			awk '
				index($0, "Expected-Max-Worker-Turns: ") == 1 {
					if (!seen++) print "Expected-Max-Worker-Turns: 3"
					next
				}
				{print}
			' "$task_file" > "$tmp_turns"
			chmod --reference="$task_file" "$tmp_turns"
			mv "$tmp_turns" "$task_file"
			log_event "LUNA_TURN_BUDGET_NORMALIZED root=$root task=$task_id requested=$requested_luna_turns expected=3"
		fi
		[[ "$leaf_context_paths" != / && "$leaf_context_paths" != . && "$leaf_context_paths" != '*' && "$leaf_context_paths" != '**' ]] ||
			die 'Context-Paths must be a bounded path or symbol capsule, not the whole repository'
		IFS=',' read -r -a context_path_entries <<< "$leaf_context_paths"
		for context_path_entry in "${context_path_entries[@]}"; do
			context_path_entry="$(trim_surrounding_whitespace "$context_path_entry")"
			[[ -n "$context_path_entry" && "$context_path_entry" != /* &&
				"$context_path_entry" != ../* && "$context_path_entry" != */../* &&
				"$context_path_entry" != *$'\t'* ]] ||
				die 'Context-Paths must contain only comma-separated repository-relative paths or symbols'
		done
		scope_is_within_root_authority "$goal_allowed_scope" "$leaf_context_paths" ||
			die 'Context-Paths must cover every Allowed-Scope path so the worker capsule includes each editable file'
		if [[ "$leaf_worker_route" == LUNA ]]; then
			[[ "$leaf_complexity" == LOW ]] || die 'Luna leaves must have Complexity-Class: LOW'
			[[ "$leaf_type" =~ ^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION|VERIFICATION_ONLY)$ ]] ||
				die "Leaf-Type $leaf_type requires Terra"
			[[ "$leaf_architecture_decisions" == NONE ]] || die 'Luna leaves must set Architecture-Decisions: NONE'
			if [[ "$leaf_type" == VERIFICATION_ONLY ]]; then
				(( leaf_expected_files == 0 )) || die 'VERIFICATION_ONLY leaves must expect zero implementation files'
			fi
			[[ "$leaf_validation_class" != CLEAN_GLOBAL ]] || die 'Luna leaves cannot use CLEAN_GLOBAL validation; publish a separate Terra INTEGRATION leaf'
			if [[ -n "$leaf_expected_actions" ]]; then
				(( leaf_expected_files <= HARNESS_MAX_LUNA_IMPLEMENTATION_FILES )) ||
					die "measured Luna leaves may expect at most $HARNESS_MAX_LUNA_IMPLEMENTATION_FILES implementation files"
			else
				(( leaf_expected_files <= 5 )) || die 'legacy Luna leaves may expect at most five implementation files'
			fi
			(( leaf_expected_turns <= 3 )) || die 'Luna leaves may expect at most three worker turns'
			if [[ -n "$leaf_expected_actions" ]]; then
				(( leaf_expected_actions <= HARNESS_MAX_LUNA_PREDICTED_ACTIONS )) || die 'Luna leaf action prediction exceeds its machine budget'
				(( leaf_effective_p95 <= HARNESS_MAX_LUNA_PREDICTED_P95_TOKENS )) || die 'Luna leaf effective p95 token prediction exceeds its machine budget'
				(( leaf_complexity_score <= HARNESS_MAX_LUNA_COMPLEXITY_SCORE )) || die 'Luna leaf complexity score exceeds its machine budget'
				[[ "$leaf_terra_exception" == - ]] || die 'Luna leaf cannot declare a Terra exception'
			fi
			[[ "$goal_allowed_scope" != / && "$goal_allowed_scope" != . && "$goal_allowed_scope" != *'*'* ]] ||
				die 'Luna Allowed-Scope must name bounded explicit paths without repository-wide wildcards'
			(( $(awk -F',' '{print NF}' <<< "$goal_allowed_scope") <= HARNESS_MAX_LUNA_ALLOWED_PATHS )) ||
				die "Luna Allowed-Scope may name at most $HARNESS_MAX_LUNA_ALLOWED_PATHS path groups"
			[[ "$leaf_context_paths" != *'*'* ]] ||
				die 'Luna Context-Paths must use explicit paths without wildcards'
			(( $(awk -F',' '{print NF}' <<< "$leaf_context_paths") <= 8 )) ||
				die 'Luna Context-Paths may name at most eight bounded entries'
			validate_luna_symbol_context
		fi
		if [[ -n "$leaf_expected_actions" && "$leaf_worker_route" == TERRA ]]; then
			if (( manager_remediation == 1 )); then
				[[ "$leaf_terra_exception" == - ]] || die 'bounded manager remediation must preserve the measured node Terra-Exception'
			else
				[[ "$leaf_terra_exception" =~ ^(CONTRACT_DECISION|ARCHITECTURE_DECISION|CONCURRENCY_DESIGN|AMBIGUOUS_SPECIFICATION|UNEXPLAINED_INTEGRATION|IRREDUCIBLE_CROSS_BOUNDARY)$ ]] ||
					die 'measured Terra leaf requires an exact irreducible Terra-Exception'
			fi
		fi
		if (( manager_remediation == 1 )); then
			if [[ "$HARNESS_ESCALATION_POLICY" == decompose ]]; then
				[[ "$leaf_worker_route" == LUNA ]] || die 'Luna-only manager remediation must use Worker-Route: LUNA'
			else
				[[ "$leaf_worker_route" == TERRA ]] || die 'manager remediation must use Worker-Route: TERRA'
			fi
		fi
		if [[ "$task_id" == "$root" ]]; then
			project_plan_uses_dag || die 'v2 leaf publication requires a registered decomposition DAG'
			planned_complexity="$(project_plan_node_value "$plan_item_id" complexity_class)"
			planned_route="$(project_plan_node_value "$plan_item_id" worker_route)"
			planned_leaf_type="$(project_plan_node_value "$plan_item_id" leaf_type)"
			luna_migrated_child=0
			if [[ "$HARNESS_MODEL_POLICY" == luna_only && "$planned_route" == TERRA ]] &&
				(( measured_recovery_route_override == 2 )); then
				luna_migrated_child=1
			fi
			[[ "$leaf_depends_on" == "$(project_plan_node_value "$plan_item_id" depends_on)" ]] || die 'leaf Depends-On does not match its DAG node'
			[[ "$leaf_deliverable" == "$(project_plan_node_value "$plan_item_id" deliverable)" ]] || die 'leaf Deliverable does not match its DAG node'
			if (( luna_migrated_child == 0 )); then
				[[ "$goal_success_evidence" == "$(project_plan_node_value "$plan_item_id" acceptance_evidence)" ]] || die 'leaf Goal-Success-Evidence does not match its DAG node'
			fi
			planned_validation="$(project_plan_node_value "$plan_item_id" focused_validation)"
			if [[ "$goal_focused_validation" != "$planned_validation" ]]; then
				if (( luna_migrated_child == 1 )); then
					! validation_is_review_descriptor "$goal_focused_validation" ||
						die 'migrated Luna child validation must be one machine-executable focused command'
					log_event "LUNA_ONLY_MIGRATION_VALIDATION_REFINED node=$plan_item_id task=$task_id"
				else
					validation_is_review_descriptor "$planned_validation" ||
						die 'leaf Focused-Validation does not match its DAG node'
					! validation_is_review_descriptor "$goal_focused_validation" ||
						die 'descriptive DAG validation must be refined to one machine-executable focused command'
					log_event "DESCRIPTIVE_VALIDATION_REFINED node=$plan_item_id task=$task_id"
				fi
			fi
			if (( luna_migrated_child == 1 )); then
				scope_is_within_root_authority "$goal_allowed_scope" "$(project_plan_node_value "$plan_item_id" allowed_paths)" ||
					die 'migrated Luna child Allowed-Scope exceeds its installed Terra aggregate'
				comma_values_are_subset "$leaf_required_symbols" "$(project_plan_node_value "$plan_item_id" required_symbols)" ||
					die 'migrated Luna child Required-Symbols exceed its installed Terra aggregate'
			else
				[[ "$goal_allowed_scope" == "$(project_plan_node_value "$plan_item_id" allowed_paths)" ]] || die 'leaf Allowed-Scope does not match its DAG node'
				[[ "$leaf_required_symbols" == "$(project_plan_node_value "$plan_item_id" required_symbols)" ]] || die 'leaf Required-Symbols does not match its DAG node'
			fi
			if (( recovery_publish == 1 && measured_recovery_route_override == 0 )) &&
				[[ "$planned_route" == TERRA &&
				"$planned_leaf_type" =~ ^(CONTRACT_DESIGN|CROSS_COMPONENT_ARCHITECTURE|CONCURRENCY_PROTOCOL|INTEGRATION|AMBIGUOUS_SPECIFICATION)$ ]]; then
				# A bounded coding continuation can still be part of an unresolved
				# Terra-owned decision node.  Until that decision is accepted it must
				# not be forced through Luna merely because the continuation's local
				# executable shape is implementation work.
				architecture_recovery_authority=1
				preferred_route_override=1
			fi
			if [[ -n "$planned_leaf_type" && "$architecture_recovery_authority" == 0 && "$luna_migrated_child" == 0 ]]; then
				[[ "$leaf_type" == "$planned_leaf_type" ]] || die 'leaf Leaf-Type does not match its DAG node'
			fi
			if (( luna_migrated_child == 0 )) && [[ "$leaf_complexity" != "$planned_complexity" || "$leaf_worker_route" != "$planned_route" ]]; then
				if [[ -z "$planned_leaf_type" && "$HARNESS_PREFERRED_WORKER_ROUTE" == LUNA &&
					"$planned_route" == TERRA && "$leaf_worker_route" == LUNA && "$leaf_complexity" == LOW ]]; then
					preferred_route_override=1
				else
					[[ "$leaf_complexity" == "$planned_complexity" ]] || die 'leaf Complexity-Class does not match its DAG node'
					[[ "$leaf_worker_route" == "$planned_route" ]] || die 'leaf Worker-Route does not match its DAG node'
				fi
			fi
		fi
		architecture_validate_assignment_metadata "$task_file" "$plan_item_id"
		luna_failures="$(root_luna_strategy_failure_count "$root")"
		operator_route_override=0
		if [[ -f "$(task_root_operator_route_override_file "$root")" ]] &&
			[[ "$(kv_file_value "$(task_root_operator_route_override_file "$root")" worker_route 2>/dev/null || true)" == TERRA ]] &&
			[[ "$leaf_worker_route" == TERRA ]]; then
			operator_route_override=1
			preferred_route_override=1
		fi
		if (( manager_remediation == 0 && operator_route_override == 0 && architecture_recovery_authority == 0 )) && [[ "$HARNESS_MODEL_POLICY" == luna_only && "$leaf_worker_route" == TERRA &&
			"$leaf_type" =~ ^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION|VERIFICATION_ONLY)$ ]]; then
			die "$leaf_type is executable work and HARNESS_MODEL_POLICY=luna_only requires a LOW/LUNA child; decompose it further"
		fi
		if (( manager_remediation == 0 && operator_route_override == 0 && architecture_recovery_authority == 0 )) && [[ "$HARNESS_MODEL_POLICY" != luna_only && "$HARNESS_PREFERRED_WORKER_ROUTE" == LUNA && "$leaf_worker_route" == TERRA &&
			"$leaf_type" =~ ^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION|VERIFICATION_ONLY)$ ]] &&
			(( luna_failures < HARNESS_MAX_LUNA_STRATEGY_FAILURES )); then
			die "$leaf_type is coding work and must be decomposed to a LOW/LUNA leaf while HARNESS_PREFERRED_WORKER_ROUTE=LUNA; Terra is allowed after $HARNESS_MAX_LUNA_STRATEGY_FAILURES failed Luna strategies"
		fi
		if [[ "$HARNESS_MODEL_POLICY" != luna_only && "$leaf_worker_route" == LUNA ]] && (( luna_failures >= HARNESS_MAX_LUNA_STRATEGY_FAILURES )); then
			die "root $root has $luna_failures failed Luna strategies; publish a fresh Terra leaf or decompose it further"
		fi
	fi
	normalize_unique_cmake_target_aliases
	validate_direct_cmake_execution_targets
	if [[ "$task_id" == "$root" ]]; then
		[[ "$goal_target" == "${declared_criteria[0]}" ]] ||
			die "new root goal must target its first declared criterion: ${declared_criteria[0]}"
	else
		[[ "$goal_target" == "$target_criterion" ]] ||
			die "goal Target-Criterion must equal the first unmet leaf: $target_criterion"
	fi
	enforce_revision_authority
elif [[ "$(metadata_value "$task_file" Execution-Mode)" == LEAF_GOAL ]]; then
	die 'LEAF_GOAL assignment publication requires HARNESS_WORKER_GOAL_MODE=1'
fi

if [[ "$(metadata_count "$task_file" Mandatory-Git-Refs)" -gt 1 ]]; then
	die 'assignment may contain at most one Mandatory-Git-Refs line'
fi
if [[ -n "$(metadata_value "$task_file" Mandatory-Git-Refs)" ]]; then
	mapfile -t missing_mandatory_refs < <(assignment_missing_mandatory_git_refs "$task_file")
	if (( ${#missing_mandatory_refs[@]} > 0 )); then
		die "mandatory Git refs are absent; publish a WAITING_DEPENDENCY request instead of this task: $(IFS=,; printf '%s' "${missing_mandatory_refs[*]}")"
	fi
fi

if [[ "$(metadata_count "$task_file" Publish-Branch)" -gt 1 || "$(metadata_count "$task_file" Publish-Base)" -gt 1 ]]; then
	die 'assignment may contain at most one Publish-Branch and one Publish-Base line'
fi
publish_branch="$(metadata_value "$task_file" Publish-Branch)"
if [[ -n "$publish_branch" ]]; then
	git check-ref-format --branch "$publish_branch" >/dev/null 2>&1 || die "invalid Publish-Branch: $publish_branch"
fi

strategy_id=""
strategy_change=""
strategy_fingerprint=""
trigger_task=""
blocking_fingerprint="-"
remediation_blocker_class=""
remediation_scope=""
declare -a remediation_scope_entries=()
remediation_scope_entry=""
if (( recovery_publish == 1 )); then
	[[ -n "$target_criterion" ]] || die 'manager recovery requires an explicit criterion inventory and target'
	[[ "$(single_metadata_value "$task_file" Task-ID)" == "$task_id" ]] ||
		die "manager recovery Task-ID does not match expected revision: $task_id"
	[[ "$(single_metadata_value "$task_file" Task-Root)" == "$root" ]] ||
		die "manager recovery Task-Root does not match: $root"
	[[ "$(single_metadata_value "$task_file" Worker-Context)" == FRESH ]] ||
		die 'manager recovery must set Worker-Context: FRESH'
	strategy_id="$(single_metadata_value "$task_file" Replan-Strategy-ID)"
	[[ "$strategy_id" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]] ||
		die "invalid Replan-Strategy-ID: $strategy_id"
	strategy_change="$(single_metadata_value "$task_file" Strategy-Change)"
	if (( manager_remediation == 1 )); then
		[[ "$(single_metadata_value "$task_file" Manager-Remediation)" == 1 ]] ||
			die 'manager remediation must set Manager-Remediation: 1'
		[[ "$strategy_change" == REPAIR_PREREQUISITE ]] ||
			die 'manager remediation must set Strategy-Change: REPAIR_PREREQUISITE'
		remediation_blocker_class="$(single_metadata_value "$task_file" Blocker-Class)"
		[[ "$remediation_blocker_class" =~ ^(LOCAL_CODE_PREREQUISITE|LOCAL_BUILD_PREREQUISITE|LOCAL_INTEGRATION_PREREQUISITE|LOCAL_SCOPE_PREREQUISITE)$ ]] ||
			die 'manager remediation Blocker-Class must identify a local code, build, integration, or workstream-scope prerequisite'
		remediation_scope="$(single_metadata_value "$task_file" Remediation-Scope)"
		[[ "$remediation_scope" != *$'\t'* ]] ||
			die 'manager remediation Remediation-Scope must not contain a tab'
		if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
			IFS=',' read -r -a remediation_scope_entries <<< "$(canonical_scope_path_set "$remediation_scope")"
			for remediation_scope_entry in "${remediation_scope_entries[@]}"; do
				remediation_scope_entry="$(trim_surrounding_whitespace "$remediation_scope_entry")"
				[[ -n "$remediation_scope_entry" && "$remediation_scope_entry" != - ]] ||
					die 'manager remediation Remediation-Scope must name at least one exact repository path'
				[[ "$remediation_scope_entry" != /* && "$remediation_scope_entry" != ../* &&
					"$remediation_scope_entry" != */../* ]] ||
					die "manager remediation Remediation-Scope is not repository-relative: $remediation_scope_entry"
				[[ -e "$REPOSITORY/$remediation_scope_entry" ]] ||
					die "manager remediation Remediation-Scope path does not exist; resolve the exact repository producer/consumer path first: $remediation_scope_entry"
			done
		fi
		replan_trigger_outcome="$(metadata_value "$(task_root_replan_file "$root")" Trigger-Outcome)"
		if [[ "$replan_trigger_outcome" == MANAGER_REMEDIATION_SCOPE_EXHAUSTED ]]; then
			exhausted_remediation_scope="$(metadata_value "$(task_root_replan_file "$root")" Remediation-Scope)"
			[[ -n "$exhausted_remediation_scope" ]] ||
				die 'exhausted manager remediation marker is missing Remediation-Scope'
			[[ "$(canonical_scope_path_set "$remediation_scope")" != \
				"$(canonical_scope_path_set "$exhausted_remediation_scope")" ]] ||
				die "manager remediation scope is exhausted for this criterion; name the exact adjacent producer, representation, consumer, or validation seam instead of republishing: $exhausted_remediation_scope"
		elif [[ "$replan_trigger_outcome" == MANAGER_REMEDIATION_CONTEXT_INCOMPLETE ]]; then
			retained_remediation_scope="$(metadata_value "$(task_root_replan_file "$root")" Remediation-Scope)"
			prior_context_paths="$(metadata_value "$(task_root_replan_file "$root")" Context-Paths)"
			requested_context_paths="$(single_metadata_value "$task_file" Context-Paths)"
			[[ -n "$retained_remediation_scope" && -n "$prior_context_paths" ]] ||
				die 'context-incomplete remediation marker is missing retained scope or prior Context-Paths'
			[[ "$(canonical_scope_path_set "$remediation_scope")" == \
				"$(canonical_scope_path_set "$retained_remediation_scope")" ]] ||
				die "context-incomplete remediation must preserve its exact Remediation-Scope: $retained_remediation_scope"
			scope_is_within_root_authority "$prior_context_paths" "$requested_context_paths" ||
				die "context-incomplete remediation must retain every prior Context-Paths entry: $prior_context_paths"
			[[ "$(canonical_scope_path_set "$requested_context_paths")" != \
				"$(canonical_scope_path_set "$prior_context_paths")" ]] ||
				die 'context-incomplete remediation must add at least one exact bounded Context-Paths entry'
		fi
	else
		[[ -z "$(metadata_value "$task_file" Manager-Remediation)" ]] ||
			die 'ordinary automatic replans must not set Manager-Remediation'
		[[ "$strategy_change" =~ ^(NARROW_SCOPE|NEW_EVIDENCE|ISOLATE_CRITERION)$ ]] ||
			die 'Strategy-Change must be NARROW_SCOPE, NEW_EVIDENCE, or ISOLATE_CRITERION'
	fi
	trigger_task="$(awk -F': ' '$1 == "Triggered-By" {print $2; exit}' "$(task_root_replan_file "$root")")"
	[[ -n "$trigger_task" ]] || die 'manager recovery marker does not identify its triggering task'
	if (( goal_mode == 1 )) && [[ -f "$(goal_state_file "$trigger_task")" ]] &&
		[[ "$(kv_file_value "$(goal_state_file "$trigger_task")" goal_id)" == "$goal_id" ]]; then
		die 'manager recovery must use a new Goal-ID for its materially different strategy'
	fi
	[[ "$(single_metadata_value "$task_file" Supersedes-Task)" == "$trigger_task" ]] ||
		die "manager recovery must supersede triggering task: $trigger_task"
	for heading in '## Objective' '## Acceptance criteria' '## Validation commands'; do
		section_has_content "$task_file" "$heading" ||
			die "manager recovery assignment requires nonempty section: $heading"
	done
	trigger_assignment="$dir/archive/$(task_base "$trigger_task").assignment.md"
	if [[ -f "$trigger_assignment" ]] &&
		[[ "$(sha256sum "$trigger_assignment" | awk '{print $1}')" == "$(sha256sum "$task_file" | awk '{print $1}')" ]]; then
		die 'automatic replan assignment is byte-identical to the strategy it supersedes'
	fi
	strategy_fingerprint="$(assignment_material_fingerprint "$task_file" "$target_criterion")"
	if [[ -f "$trigger_assignment" ]] &&
		[[ "$(assignment_material_fingerprint "$trigger_assignment")" == "$strategy_fingerprint" ]]; then
		die 'automatic replan objective, acceptance evidence, and validation strategy are materially unchanged from the triggering assignment'
	fi
	replan_ledger="$(task_replan_ledger_file "$root")"
	if [[ -f "$replan_ledger" ]]; then
		! awk -F '\t' -v id="$strategy_id" 'NR > 1 && $5 == id {found=1} END {exit !found}' "$replan_ledger" ||
			die "manager recovery strategy identifier was already used: $strategy_id"
		! awk -F '\t' -v fingerprint="$strategy_fingerprint" 'NR > 1 && $7 == fingerprint {found=1} END {exit !found}' "$replan_ledger" ||
			die 'manager recovery is not materially different from an earlier bounded strategy'
	fi
	blocking_fingerprint="$(awk -F': ' '$1 == "Blocking-Fingerprint" {print $2; exit}' "$(task_root_replan_file "$root")")"
	[[ -n "$blocking_fingerprint" ]] || blocking_fingerprint="-"
	if (( manager_remediation == 0 )); then
		replan_trigger_outcome="$(metadata_value "$(task_root_replan_file "$root")" Trigger-Outcome)"
		if [[ "$replan_trigger_outcome" == RESOURCE_PROGRESS_NEEDS_VERIFICATION ]]; then
			[[ "$leaf_type" == VERIFICATION_ONLY ]] ||
				die 'resource-fused source progress requires a fresh VERIFICATION_ONLY continuation before more implementation'
			(( leaf_expected_files == 0 )) ||
				die 'resource-fused source progress verification must expect zero implementation files'
		fi
		fresh_resolution=0
		[[ "$replan_trigger_outcome" != ARCHITECTURE_REASSESSMENT_RESOLVED ]] || fresh_resolution=1
		resource_decomposition=0
		[[ "$replan_trigger_outcome" != RESOURCE_NEEDS_DECOMPOSITION ]] || resource_decomposition=1
		resource_progress_verification=0
		[[ "$replan_trigger_outcome" != RESOURCE_PROGRESS_NEEDS_VERIFICATION ]] || resource_progress_verification=1
		resource_recovery=$((resource_decomposition || resource_progress_verification))
		typed_boundary_repair=0
		case "$replan_trigger_outcome" in
			LUNA_ONLY_POLICY_MIGRATION|CONTEXT_CLOSURE_REPAIR)
				typed_boundary_repair=1
				;;
		esac
		auto_replans="$(root_auto_replans_without_verified_gain "$root")"
		if (( fresh_resolution == 0 && resource_recovery == 0 && typed_boundary_repair == 0 )); then
			(( auto_replans < HARNESS_MAX_AUTO_REPLANS_WITHOUT_VERIFIED_GAIN )) ||
				die "automatic replan budget is exhausted without durable verified gain: $auto_replans/$HARNESS_MAX_AUTO_REPLANS_WITHOUT_VERIFIED_GAIN"
		fi
		if (( fresh_resolution == 0 && resource_recovery == 0 && typed_boundary_repair == 0 )) &&
			root_same_blocker_without_verified_gain "$root" "$blocking_fingerprint"; then
			die "same blocking fingerprint survived the prior bounded replan without durable verified gain: $blocking_fingerprint"
		fi
	fi
fi

if (( recovery_publish == 1 )) &&
	! evaluate_root_state_oscillation "$task_id" "$target_criterion" \
		"$strategy_fingerprint" "$blocking_fingerprint" "$(task_verified_item_count "$root")"; then
	printf '%s\n' "$(task_root_architecture_reassessment_file "$root")"
	exit 0
fi

initialize_task_progress "$task_id" "$task_file"
starting_progress="$(task_progress_percent "$root")"

tmp="$dir/tasks/$base.ready.tmp.$$"
if [[ "$task_id" == "$root" ]]; then
	install -m 600 "$task_file" "$tmp"
else
	{
		printf '# Harness Continuation Context\n\n'
		printf 'Task-Root: %s\n' "$root"
		printf 'Starting-Progress: %s%%\n' "$starting_progress"
		printf 'Progress-File: %s\n' "$progress"
		printf 'Root-Assignment: %s\n' "$root_assignment"
		if (( ${#declared_criteria[@]} > 0 )); then
			if task_root_uses_assignment_criteria "$root"; then
				printf 'Criteria-Definition: %s\n' "$root_assignment"
			else
				printf 'Criteria-Definition: %s\n' "$criteria_definition"
			fi
			if [[ -f "$criterion_decomposition" || -n "$decomposition_candidate" ]]; then
				printf 'Criterion-Decomposition: %s\n' "$criterion_decomposition"
			fi
			printf 'Target-Criterion: %s\n' "$target_criterion"
		fi
		if (( manager_remediation == 1 )); then
			printf '\nPreserve all previously verified work and acceptance criteria. This manager remediation may repair only the directly implicated local prerequisites named by Remediation-Scope, including files outside the earlier worker leaf scope when necessary. It must not relax the original criterion, change unrelated behavior, or expand beyond evidence from the blocking failure.\n\n'
		else
			printf '\nPreserve all previously verified work. This revision may address only the first unmet criterion shown above. Unrelated failures are known limitations and must not broaden this task.\n\n'
		fi
		printf '%s\n\n' '---'
		cat "$task_file"
	} > "$tmp"
	chmod 600 "$tmp"
fi

# Authority normalization above operates on parsed values. Keep the published
# assignment byte-consistent with those values as well; otherwise a read-only
# continuation could pass the guard while the worker still received the
# model-authored broader Allowed-Scope line.
if (( goal_mode == 1 )) &&
	[[ "$(metadata_value "$tmp" Allowed-Scope)" != "$goal_allowed_scope" ]]; then
	normalized_tmp="$tmp.normalized.$$"
	HARNESS_NORMALIZED_ALLOWED_SCOPE="$goal_allowed_scope" awk '
		index($0, "Allowed-Scope: ") == 1 {
			if (!seen++) print "Allowed-Scope: " ENVIRON["HARNESS_NORMALIZED_ALLOWED_SCOPE"]
			next
		}
		{print}
	' "$tmp" > "$normalized_tmp"
	chmod 600 "$normalized_tmp"
	mv "$normalized_tmp" "$tmp"
fi

if (( goal_mode == 1 )); then
	goal_dir="$(goal_control_dir)"
	goal_state="$(goal_state_file "$task_id")"
	goal_ledger="$(goal_iteration_ledger_file "$task_id")"
	goal_summary="$(goal_summary_file "$task_id")"
	goal_thread="$(goal_thread_file "$task_id")"
	goal_publish_state="$goal_state"
	goal_publish_ledger="$goal_ledger"
	goal_publish_summary="$goal_summary"
	goal_publish_thread="$goal_thread"
	[[ ! -e "$goal_state" && ! -e "$goal_ledger" && ! -e "$goal_summary" && ! -e "$goal_thread" ]] ||
		die "goal state already exists for task: $task_id"
	mkdir -p "$goal_dir" "$(goal_iteration_archive_dir "$task_id")"
	chmod 700 "$goal_dir" "$(goal_iteration_archive_dir "$task_id")"
	goal_resumed_from=""
	goal_previous_ledger=""
	goal_iteration_start=0
	goal_context_generation=0
	goal_process_turns=0
	goal_cumulative_input=0
	goal_cumulative_output=0
	goal_manager_reviews=0
	goal_thread_id=""
	goal_thread_context=fresh
	if [[ "$task_id" != "$root" &&
		"$(metadata_value "$task_file" Worker-Context)" != FRESH ]]; then
		latest_goal_update=""
		for prior_goal_state in "$goal_dir/$PROJECT-task-"*.goal; do
			[[ -f "$prior_goal_state" ]] || continue
			[[ "$(kv_file_value "$prior_goal_state" task_root 2>/dev/null || true)" == "$root" ]] || continue
			[[ "$(kv_file_value "$prior_goal_state" goal_id 2>/dev/null || true)" == "$goal_id" ]] || continue
			[[ "$(kv_file_value "$prior_goal_state" target_criterion 2>/dev/null || true)" == "$goal_target" ]] || continue
			[[ "$(kv_file_value "$prior_goal_state" state 2>/dev/null || true)" == REJECTED ]] || continue
			prior_goal_update="$(kv_file_value "$prior_goal_state" updated_at 2>/dev/null || true)"
			if [[ -z "$goal_resumed_from" || "$prior_goal_update" > "$latest_goal_update" ]]; then
				goal_resumed_from="$(kv_file_value "$prior_goal_state" task_id)"
				latest_goal_update="$prior_goal_update"
				goal_previous_ledger="$(goal_iteration_ledger_file "$goal_resumed_from")"
				goal_iteration_start="$(kv_file_value "$prior_goal_state" iteration_count 2>/dev/null || printf 0)"
				goal_context_generation="$(kv_file_value "$prior_goal_state" context_generation 2>/dev/null || printf 0)"
				goal_process_turns="$(kv_file_value "$prior_goal_state" process_turns 2>/dev/null || printf 0)"
				goal_cumulative_input="$(kv_file_value "$prior_goal_state" cumulative_input_tokens 2>/dev/null || printf 0)"
				goal_cumulative_output="$(kv_file_value "$prior_goal_state" cumulative_output_tokens 2>/dev/null || printf 0)"
				goal_manager_reviews="$(kv_file_value "$prior_goal_state" manager_reviews 2>/dev/null || printf 0)"
				# A manager rejection creates a new semantic execution episode even
				# when the Goal-ID is retained.  Preserve its bounded ledger and token
				# totals, but never repay the rejected transcript in the replacement
				# worker. Same-task CONTINUE iterations may still resume normally.
				[[ "$goal_context_generation" =~ ^[0-9]+$ ]] || goal_context_generation=0
				goal_thread_id=""
				goal_context_generation=$((goal_context_generation + 1))
				goal_thread_context=manager-rejected-fresh
			fi
		done
	fi
	for numeric_goal_value in goal_iteration_start goal_context_generation goal_process_turns \
		goal_cumulative_input goal_cumulative_output goal_manager_reviews; do
		[[ "${!numeric_goal_value}" =~ ^[0-9]+$ ]] || printf -v "$numeric_goal_value" 0
	done
	[[ "$goal_thread_id" =~ ^[A-Za-z0-9-]+$ ]] || goal_thread_id=""
	goal_workspace="$(repository_workspace_fingerprint)"
	goal_assignment_sha="$(sha256sum "$tmp" | awk '{print $1}')"
	goal_state_tmp="$goal_state.tmp.$$"
	{
		printf 'project=%s\n' "$PROJECT"
		printf 'task_id=%s\n' "$task_id"
		printf 'task_root=%s\n' "$root"
		printf 'goal_id=%s\n' "$goal_id"
		printf 'target_criterion=%s\n' "$goal_target"
		printf 'state=READY\n'
		printf 'iteration_count=%s\n' "$goal_iteration_start"
		printf 'identical_iterations=0\n'
		printf 'protocol_failures=0\n'
		printf 'process_turns=%s\n' "$goal_process_turns"
		printf 'cumulative_input_tokens=%s\n' "$goal_cumulative_input"
		printf 'cumulative_output_tokens=%s\n' "$goal_cumulative_output"
		printf 'context_generation=%s\n' "$goal_context_generation"
		printf 'thread_id=%s\n' "$goal_thread_id"
		printf 'thread_context=%s\n' "$goal_thread_context"
		printf 'strategy_review_required=0\n'
		printf 'semantic_reviews=0\n'
		printf 'semantic_review_iteration=0\n'
		printf 'semantic_decision=-\n'
		printf 'semantic_relation=-\n'
		printf 'semantic_decision_file=-\n'
		printf 'last_boundary=%s\n' "$goal_baseline_boundary"
		printf 'last_workspace=%s\n' "$goal_workspace"
		printf 'last_material_fingerprint=-\n'
		printf 'last_movement_at=%s\n' "$(timestamp_utc)"
		printf 'manager_reviews=%s\n' "$goal_manager_reviews"
		printf 'resumed_from_task=%s\n' "$goal_resumed_from"
		printf 'assignment_sha256=%s\n' "$goal_assignment_sha"
		printf 'created_at=%s\n' "$(timestamp_utc)"
		printf 'updated_at=%s\n' "$(timestamp_utc)"
	} > "$goal_state_tmp"
	chmod 600 "$goal_state_tmp"
	mv "$goal_state_tmp" "$goal_state"
	goal_thread_store "$task_id" "$goal_thread_id" "$goal_thread_context"
	if [[ -n "$goal_resumed_from" && -f "$goal_previous_ledger" ]]; then
		install -m 600 "$goal_previous_ledger" "$goal_ledger"
	else
		printf 'recorded_at\titeration\toutcome\tboundary_before\tboundary_after\tworkspace_before\tworkspace_after\tmaterial_fingerprint\tmovement\tidentical_streak\treceipt\n' \
			> "$goal_ledger"
		chmod 600 "$goal_ledger"
	fi
	{
		printf '# Worker Leaf Goal\n\n'
		printf 'Task-ID: %s\n' "$task_id"
		printf 'Goal-ID: %s\n' "$goal_id"
		printf 'Target-Criterion: %s\n' "$goal_target"
		printf 'Goal-Success-Evidence: %s\n' "$goal_success_evidence"
		printf 'Focused-Validation: %s\n' "$goal_focused_validation"
		printf 'Allowed-Scope: %s\n' "$goal_allowed_scope"
		printf 'Baseline-Boundary: %s\n' "$goal_baseline_boundary"
		printf 'Hard-Block-Conditions: %s\n' "$goal_hard_blocks"
		if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
			printf 'Leaf-Type: %s\n' "$leaf_type"
			printf 'Complexity-Class: %s\n' "$leaf_complexity"
			printf 'Worker-Route: %s\n' "$leaf_worker_route"
			printf 'Depends-On: %s\n' "$leaf_depends_on"
			printf 'Deliverable: %s\n' "$leaf_deliverable"
			printf 'Required-Symbols: %s\n' "$leaf_required_symbols"
			printf 'Context-Paths: %s\n' "$leaf_context_paths"
			printf 'Architecture-Decisions: %s\n' "$leaf_architecture_decisions"
			printf 'Validation-Class: %s\n' "$leaf_validation_class"
			if (( HARNESS_ARCHITECTURE_GUARDS == 1 )); then
				printf 'Affected-Invariants: %s\n' "$(architecture_node_value "$plan_item_id" invariant_ids)"
				printf 'Consumed-Decisions: %s\n' "$(architecture_node_value "$plan_item_id" consumes_decisions)"
				printf 'Produced-Decisions: %s\n' "$(architecture_node_value "$plan_item_id" produces_decisions)"
				printf 'Edge-Contracts: %s\n' "$(architecture_node_value "$plan_item_id" edge_contracts)"
				printf 'Health-Gates: %s\n' "$(architecture_node_value "$plan_item_id" health_gates)"
			fi
			printf 'Expected-Max-Implementation-Files: %s\n' "$leaf_expected_files"
			printf 'Expected-Max-Worker-Turns: %s\n' "$leaf_expected_turns"
			if [[ -n "$leaf_expected_actions" ]]; then
				printf 'Expected-Max-Agent-Actions: %s\n' "$leaf_expected_actions"
				printf 'Predicted-P95-Tokens: %s\n' "$leaf_predicted_p95"
				printf 'Effective-P95-Tokens: %s\n' "$leaf_effective_p95"
				printf 'Complexity-Score: %s\n' "$leaf_complexity_score"
			fi
		fi
		printf '\nIteration receipts are authoritative in: %s\n' "$goal_ledger"
	} > "$goal_summary"
	chmod 600 "$goal_summary"
fi

if (( recovery_publish == 1 )); then
	if [[ ! -f "$criteria_definition" ]]; then
		[[ -z "$criteria_candidate" ]] || install -m 600 "$criteria_candidate" "$criteria_definition"
	fi
	if [[ -n "$decomposition_candidate" ]]; then
		decomposition_tmp="$criterion_decomposition.tmp.$$"
		if [[ -f "$criterion_decomposition" ]]; then
			cp -p "$criterion_decomposition" "$decomposition_tmp"
		else
			printf 'parent_criterion\tchild_criterion\ttitle\tacceptance_evidence\n' > "$decomposition_tmp"
		fi
		tail -n +2 "$decomposition_candidate" >> "$decomposition_tmp"
		chmod 600 "$decomposition_tmp"
		mv "$decomposition_tmp" "$criterion_decomposition"
		if [[ -f "$decomposition_candidate.facets.tsv" ]]; then
			facets_tmp="$criterion_facets.tmp.$$"
			if [[ -f "$criterion_facets" ]]; then
				cp -p "$criterion_facets" "$facets_tmp"
			else
				printf 'parent_criterion\tchild_criterion\tfacet_kind\tfacet_id\trelation\tsource_cut\n' > "$facets_tmp"
			fi
			tail -n +2 "$decomposition_candidate.facets.tsv" >> "$facets_tmp"
			chmod 600 "$facets_tmp"
			mv "$facets_tmp" "$criterion_facets"
		fi
	fi
	record_root_convergence_baseline "$root"
	clear_worker_thread_for_root "$root" automatic-replan
	ensure_root_replan_ledger_schema "$root"
	replan_ledger="$(task_replan_ledger_file "$root")"
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$(timestamp_utc)" "$task_id" "$trigger_task" "$target_criterion" "$strategy_id" \
		"$strategy_change" "$strategy_fingerprint" "$blocking_fingerprint" \
		"$(task_passed_declared_criterion_count "$root")" \
		"$(task_verified_item_count "$root")" >> "$replan_ledger"
	if (( manager_remediation == 1 )); then
		ensure_root_manager_remediation_ledger_schema "$root"
		remediation_ledger="$(task_manager_remediation_ledger_file "$root")"
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
			"$(timestamp_utc)" "$task_id" "$trigger_task" "$target_criterion" \
			"$blocking_fingerprint" "$remediation_blocker_class" "$remediation_scope" \
			"$MANAGER_MODEL" >> "$remediation_ledger"
	fi
fi
if (( HARNESS_DECOMPOSITION_V2 == 1 )); then
	context_capsule="$(task_context_capsule_file "$task_id")"
	context_specification_obligations='-'
	if specification_ir_available; then
		context_specification_obligations="$(specification_obligations_for_node "$plan_item_id" | paste -sd, -)"
		[[ -n "$context_specification_obligations" ]] || die "published DAG node has no normalized specification obligations: $plan_item_id"
	fi
	mkdir -p "$(dirname "$context_capsule")"
	{
		printf '# Bounded Worker Context Capsule\n\n'
		printf 'Task-ID: %s\n' "$task_id"
		printf 'Task-Root: %s\n' "$root"
		printf 'Plan-Node: %s\n' "$plan_item_id"
		printf 'Target-Criterion: %s\n' "$goal_target"
		printf 'Worker-Route: %s\n' "$leaf_worker_route"
		printf 'Leaf-Type: %s\n' "$leaf_type"
		printf 'Complexity-Class: %s\n' "$leaf_complexity"
		printf 'Deliverable: %s\n' "$leaf_deliverable"
		printf 'Acceptance-Evidence: %s\n' "$goal_success_evidence"
		printf 'Focused-Validation: %s\n' "$goal_focused_validation"
		printf 'Allowed-Scope: %s\n' "$goal_allowed_scope"
		printf 'Required-Symbols: %s\n' "$leaf_required_symbols"
		printf 'Context-Paths: %s\n' "$leaf_context_paths"
		printf 'Architecture-Decisions: %s\n' "$leaf_architecture_decisions"
		printf 'Validation-Class: %s\n' "$leaf_validation_class"
		printf 'Validation-Output-Policy: CAPTURE_SUMMARY\n'
		printf 'Decomposition-Planner-Model: %s\n' "$leaf_planner_model"
		printf 'Decomposition-Planner-Effort: %s\n' "$leaf_planner_effort"
		printf 'Specification-Obligations: %s\n' "$context_specification_obligations"
		if (( HARNESS_ARCHITECTURE_GUARDS == 1 )); then
			printf 'Affected-Invariants: %s\n' "$(architecture_node_value "$plan_item_id" invariant_ids)"
			printf 'Consumed-Decisions: %s\n' "$(architecture_node_value "$plan_item_id" consumes_decisions)"
			printf 'Produced-Decisions: %s\n' "$(architecture_node_value "$plan_item_id" produces_decisions)"
			printf 'Edge-Contracts: %s\n' "$(architecture_node_value "$plan_item_id" edge_contracts)"
			printf 'Health-Gates: %s\n' "$(architecture_node_value "$plan_item_id" health_gates)"
		fi
		printf 'Baseline-Boundary: %s\n' "$goal_baseline_boundary"
		printf 'Expected-Max-Implementation-Files: %s\n' "$leaf_expected_files"
		printf 'Expected-Max-Worker-Turns: %s\n' "$leaf_expected_turns"
		if [[ -n "$leaf_expected_actions" ]]; then
			printf 'Expected-Max-Agent-Actions: %s\n' "$leaf_expected_actions"
			printf 'Predicted-P95-Tokens: %s\n' "$leaf_predicted_p95"
			printf 'Effective-P95-Tokens: %s\n' "$leaf_effective_p95"
			printf 'Complexity-Score: %s\n' "$leaf_complexity_score"
			printf 'Behavioral-Concerns: %s\n' "$leaf_behavioral_concerns"
			printf 'Failure-Paths: %s\n' "$leaf_failure_paths"
			printf 'Ownership-Transitions: %s\n' "$leaf_ownership_transitions"
			printf 'Concurrency-Boundaries: %s\n' "$leaf_concurrency_boundaries"
			printf 'Validation-Surfaces: %s\n' "$leaf_validation_surfaces"
			printf 'Terra-Exception: %s\n' "$leaf_terra_exception"
		fi
		printf '\n## Required symbol locations\n\n'
		emit_required_symbol_locations
		printf '\n## Dependency evidence\n\n'
		if [[ "$leaf_depends_on" == - ]]; then
			printf -- '- No plan-node prerequisites.\n'
		else
			IFS=',' read -r -a dependency_list <<< "$leaf_depends_on"
			for dependency in "${dependency_list[@]}"; do
				printf -- '- %s: %s\n' "$dependency" "$(project_plan_item_status "$dependency")"
			done
		fi
		printf '\n## Context boundary\n\n'
		printf -- '- The launcher embeds this capsule and the complete bounded assignment in the worker prompt.\n'
		printf -- '- Manager policy, root history, progress ledgers, and global Specification IR are intentionally excluded.\n'
		if [[ "$context_specification_obligations" != - ]]; then
			printf '\n## Allocated proof obligations\n\n'
			awk -F '\t' -v selected=",$context_specification_obligations," '
				NR > 1 && index(selected, "," $1 ",") {printf "- %s [%s/%s]: %s | outcome: %s | authority: %s\n", $1, $2, $5, $6, $7, $8}
			' "$(specification_obligations_file)"
			printf '\n## Relevant semantic relations\n\n'
			awk -F '\t' -v selected=",$context_specification_obligations," '
				NR > 1 && index(selected, "," $3 ",") {printf "- %s: %s %s -> %s [%s] | %s\n", $1, $2, $3, $4, $5, $6}
			' "$(specification_relations_file)"
			printf '\n## Repository evidence referenced by this leaf\n\n'
			awk -F '\t' -v selected=",$context_specification_obligations," '
				FILENAME == ARGV[1] && FNR > 1 && index(selected, "," $3 ",") && $4 ~ /^FACT-/ {wanted[$4]=1; next}
				FILENAME == ARGV[2] && FNR > 1 && ($1 in wanted) {printf "- %s [%s/%s]: %s = %s | %s\n", $1, $6, $7, $3, $4, $5}
			' "$(specification_relations_file)" "$REPOSITORY/$(specification_review_state_value facts)"
		fi
		printf '\nThis capsule is intentionally narrow. Inspect other repository paths only when direct compiler, linker, or focused-validation evidence proves they are required by the declared leaf.\n'
	} > "$context_capsule.tmp.$$"
	chmod 600 "$context_capsule.tmp.$$"
	if [[ "$leaf_worker_route" == LUNA ]] && decomposition_resource_contract_enabled; then
		context_capsule_bytes="$(stat -c %s "$context_capsule.tmp.$$")"
		(( context_capsule_bytes <= HARNESS_MAX_LUNA_CONTEXT_CAPSULE_BYTES )) || {
			rm -f "$context_capsule.tmp.$$"
			die "Luna context capsule is $context_capsule_bytes bytes; maximum is $HARNESS_MAX_LUNA_CONTEXT_CAPSULE_BYTES, so split the leaf or reduce unrelated context"
		}
	fi
	mv "$context_capsule.tmp.$$" "$context_capsule"
fi
mv "$tmp" "$ready"
goal_publish_ready=1
if (( recovery_publish == 1 )); then
	rm -f "$(task_root_replan_file "$root")" "$(task_root_replanning_file "$root")"
fi
activate_project_plan_item "$plan_item_id" "$root"
# A successful atomic publication is itself the durable state change that
# resolves a prior planning-gap circuit breaker. Do not let its stale marker
# mask READY work in status output or suppress future planning transitions.
rm -f "$dir/control/manager-plan-stalled.md" \
	"$dir/control/manager-plan-structural-error.md"

published_decomposition_model="$leaf_planner_model"
[[ "$HARNESS_MODEL_POLICY" != luna_only ]] || published_decomposition_model="$LUNA_WORKER_MODEL"
log_event "TASK_PUBLISHED task=$task_id root=$root plan_item=$plan_item_id starting_progress=$starting_progress target_criterion=${target_criterion:--} auto_replan=$auto_replan manager_remediation=$manager_remediation goal_mode=$goal_mode goal_id=${goal_id:--} worker_route=${leaf_worker_route:--} leaf_type=${leaf_type:--} validation_class=${leaf_validation_class:--} decomposition_model=$published_decomposition_model preferred_route_override=$preferred_route_override file=$ready"
trace_event TASK_PUBLISHED "task_id=$task_id" "task_root=$root" "plan_item=$plan_item_id" "starting_progress=$starting_progress" "target_criterion=${target_criterion:--}" "auto_replan=$auto_replan" "manager_remediation=$manager_remediation" "goal_mode=$goal_mode" "goal_id=${goal_id:-}" "worker_route=${leaf_worker_route:-}" "leaf_type=${leaf_type:-}" "validation_class=${leaf_validation_class:-}" "decomposition_model=$published_decomposition_model" "preferred_route_override=$preferred_route_override" "source_file=$task_file" "ready_file=$ready" "progress_file=$progress"
printf '%s\n' "$ready"
