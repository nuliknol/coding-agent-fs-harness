#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE TASK_ID TASK_FILE [PROJECT_PLAN_ITEM_ID]\n' "${0##*/}" >&2
	printf '       %s ENV_FILE TASK_ID TASK_FILE --auto-replan [LEGACY_CRITERIA_TSV|-] [CHILD_DECOMPOSITION_TSV]\n' "${0##*/}" >&2
	printf '       %s ENV_FILE TASK_ID TASK_FILE --manager-remediation [LEGACY_CRITERIA_TSV|-] [CHILD_DECOMPOSITION_TSV]\n' "${0##*/}" >&2
	exit 2
}

[[ $# -ge 3 && $# -le 6 ]] || usage
load_harness_env "$1"
task_id="$2"
task_file="$3"
plan_item_id=""
auto_replan=0
manager_remediation=0
recovery_publish=0
criteria_candidate=""
decomposition_candidate=""
if [[ "${4:-}" == '--auto-replan' || "${4:-}" == '--manager-remediation' ]]; then
	recovery_publish=1
	if [[ "${4:-}" == '--manager-remediation' ]]; then
		manager_remediation=1
	else
		auto_replan=1
	fi
	criteria_candidate="${5:-}"
	[[ "$criteria_candidate" != "-" ]] || criteria_candidate=""
	decomposition_candidate="${6:-}"
else
	(( $# <= 4 )) || usage
	plan_item_id="${4:-}"
fi
ensure_project
require_no_project_integrity_anomaly
require_registered_specification_ir
trace_init manager_publish_task
trace_script_start "$@"
goal_publish_state=""
goal_publish_ledger=""
goal_publish_summary=""
goal_publish_thread=""
goal_publish_ready=0
measured_recovery_route_override=0
architecture_recovery_authority=0
cleanup_publish()
{
	local status="$?"
	if (( status != 0 && goal_publish_ready == 0 )) && [[ -n "$goal_publish_state" ]]; then
		rm -f "$goal_publish_state" "$goal_publish_ledger" "$goal_publish_summary" "$goal_publish_thread"
		rmdir "$(goal_iteration_archive_dir "$task_id")" 2>/dev/null || true
	fi
	trace_script_exit "$status"
}
trap cleanup_publish EXIT
validate_task_id "$task_id"
[[ -f "$task_file" ]] || die "task file does not exist: $task_file"
acquire_project_lock
dir="$(project_dir)"
project_completion_recorded && die "project is already complete: $(project_complete_file)"
project_plan_exists || die "project plan is missing; run manager-init-project-plan before publishing tasks"
root="$(task_root_id "$task_id")"
progress="$(task_progress_file "$root")"
root_assignment="$(task_root_assignment_file "$root")"
criteria_definition="$(task_criteria_definition_file "$root")"
criterion_decomposition="$(task_criterion_decomposition_file "$root")"
criterion_facets="$(task_criterion_facets_file "$root")"

if (( recovery_publish == 1 )); then
	[[ "$task_id" != "$root" ]] || die 'a recovery task must publish a revision of an existing root'
	task_root_needs_replan "$root" || die "recovery marker is missing for root: $root"
	! task_root_is_blocked "$root" || die "hard-blocked root requires human intervention: $root"
	! task_root_needs_human "$root" || die "root already requires human intervention: $root"
	replanning_marker="$(task_root_replanning_file "$root")"
	if [[ -f "$replanning_marker" ]]; then
		replanning_expected_task="$(kv_file_value "$replanning_marker" expected_task_id 2>/dev/null || true)"
		[[ -z "$replanning_expected_task" || "$replanning_expected_task" == "$task_id" ]] ||
			die "replan publication task mismatch: expected $replanning_expected_task"
		publish_attempts="$(kv_file_value "$replanning_marker" publish_attempts 2>/dev/null || printf 0)"
		max_publish_attempts="$(kv_file_value "$replanning_marker" max_publish_attempts 2>/dev/null || printf '%s' "$HARNESS_MAX_MANAGER_REPLAN_PUBLISH_ATTEMPTS")"
		[[ "$publish_attempts" =~ ^[0-9]+$ ]] || publish_attempts=0
		[[ "$max_publish_attempts" =~ ^[1-9][0-9]*$ ]] || max_publish_attempts="$HARNESS_MAX_MANAGER_REPLAN_PUBLISH_ATTEMPTS"
		if (( publish_attempts >= max_publish_attempts )); then
			log_event "MANAGER_RECOVERY_PUBLISH_ATTEMPT_BLOCKED root=$root task=$task_id attempts=$publish_attempts limit=$max_publish_attempts"
			die "manager recovery publication attempt budget exhausted ($publish_attempts/$max_publish_attempts); terminate this replan turn"
		fi
		publish_attempts=$((publish_attempts + 1))
		goal_state_set "$replanning_marker" publish_attempts "$publish_attempts"
		log_event "MANAGER_RECOVERY_PUBLISH_ATTEMPT root=$root task=$task_id attempt=$publish_attempts limit=$max_publish_attempts"
	fi
else
	task_root_is_paused "$root" && die "task root is paused pending replanning or human intervention: $root"
fi

base="$(task_base "$task_id")"
ready="$dir/tasks/$base.ready.md"
running="$dir/running/$base.running.md"
result="$dir/results/$base.result.md"
accepted="$dir/archive/$base.accepted.md"
checkpointed="$dir/archive/$base.checkpointed.md"
rejected="$dir/archive/$base.rejected.md"
blocked="$dir/archive/$base.blocked.md"
aborted="$dir/control/$base.abort.md"

active_root_artifact=""
if [[ "$task_id" != "$root" ]]; then
	shopt -s nullglob
	for artifact in "$dir/tasks/$PROJECT-task-"*.ready.md \
		"$dir/running/$PROJECT-task-"*.running.md \
		"$dir/results/$PROJECT-task-"*.result.md; do
		[[ -f "$artifact" ]] || continue
		artifact_task="$(task_id_from_filename "$artifact")"
		[[ "$artifact_task" != "$task_id" ]] || continue
		if [[ "$(task_root_id "$artifact_task")" == "$root" ]]; then
			active_root_artifact="$artifact"
			break
		fi
	done
	shopt -u nullglob
	[[ -z "$active_root_artifact" ]] ||
		die "task root already has an active ready, running, or review artifact: $active_root_artifact"
fi

if [[ "$task_id" == "$root" ]]; then
	[[ -n "$plan_item_id" ]] || die 'a new root task requires PROJECT_PLAN_ITEM_ID'
	[[ "$(project_plan_item_status "$plan_item_id")" == PENDING ]] || die "project plan item is not pending: $plan_item_id"
	[[ -z "$(awk -F '\t' '!/^#/ && $2 == "ACTIVE" {print $1; exit}' "$(project_plan_state_file)")" ]] || die 'another project plan item is already active'
else
	mapped_item="$(project_plan_item_for_root "$root")"
	[[ -n "$mapped_item" ]] || die "revision root is not assigned to the project plan: $root"
	[[ -z "$plan_item_id" || "$plan_item_id" == "$mapped_item" ]] || die "revision plan item mismatch: expected $mapped_item"
	plan_item_id="$mapped_item"
	[[ "$(project_plan_item_status "$plan_item_id")" == ACTIVE ]] || die "revision project plan item is not active: $plan_item_id"
	if ! enforce_root_liveness_or_reassess "$task_id"; then
		printf '%s\n' "$(task_root_architecture_reassessment_file "$root")"
		exit 0
	fi
fi

normalize_recovery_envelope()
{
	local marker trigger strategy count digest tmp heading_case_normalized=0
	(( recovery_publish == 1 )) || return 0
	marker="$(task_root_replan_file "$root")"
	trigger="$(awk -F': ' '$1 == "Triggered-By" {print $2; exit}' "$marker")"
	[[ -n "$trigger" ]] || die 'manager recovery marker does not identify its triggering task'
	count="$(awk -F': ' '$1 == "Replan-Strategy-ID" {count++} END {print count + 0}' "$task_file")"
	strategy="$(metadata_value "$task_file" Replan-Strategy-ID)"
	if (( count != 1 )) || [[ ! "$strategy" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]]; then
		digest="$(sha256sum "$task_file" | awk '{print substr($1, 1, 12)}')"
		strategy="replan-$task_id-$digest"
	fi
	if grep -Eqi '^## (objective|acceptance criteria|validation commands)[[:space:]]*$' "$task_file" &&
		grep -Eqv '^## (Objective|Acceptance criteria|Validation commands)[[:space:]]*$' \
			<(grep -Ei '^## (objective|acceptance criteria|validation commands)[[:space:]]*$' "$task_file"); then
		heading_case_normalized=1
	fi
	tmp="$task_file.recovery-envelope.$$"
	awk -F': ' -v task="$task_id" -v root="$root" -v trigger="$trigger" -v strategy="$strategy" '
		function emit() {
			print "Task-ID: " task
			print "Task-Root: " root
			print "Worker-Context: FRESH"
			print "Replan-Strategy-ID: " strategy
			print "Supersedes-Task: " trigger
			print ""
		}
		$1 ~ /^(Task-ID|Task-Root|Worker-Context|Replan-Strategy-ID|Supersedes-Task)$/ {next}
		tolower($0) == "## objective" {$0="## Objective"}
		tolower($0) == "## acceptance criteria" {$0="## Acceptance criteria"}
		tolower($0) == "## validation commands" {$0="## Validation commands"}
		!emitted && /^## / {emit(); emitted=1}
		{print}
		END {if (!emitted) emit()}
	' "$task_file" > "$tmp"
	chmod --reference="$task_file" "$tmp"
	mv "$tmp" "$task_file"
	log_event "RECOVERY_ENVELOPE_NORMALIZED task=$task_id root=$root trigger=$trigger strategy_id=$strategy"
	if (( heading_case_normalized == 1 )); then
		log_event "RECOVERY_SECTION_HEADINGS_NORMALIZED task=$task_id root=$root"
	fi
}

normalize_recovery_envelope

normalize_measured_assignment_metadata()
{
	local report decomposition report_row dag_row report_parse_row dag_parse_row tmp
	local complexity_score behavioral failures ownership concurrency validations implementation_files actions declared_p95 effective_p95 complexity_class worker_route terra_exception
	local planned_effective_p95 planned_worker_route planned_leaf_type
	local obligation_weight requested_route requested_class requested_leaf requested_architecture requested_validation requested_files requested_turns requested_exception luna_failures root_criterion_count
	local required_symbols symbol_count calibration_rate residual_p95 verified_items
	local recovery_decisions_resolved recovery_verified_child resource_recovery resource_local_authority decision requested_obligations obligation_count architecture_decisions
	# Every task bound to a measured plan node uses the installed deterministic
	# vector.  Revisions and recovery tasks must not ask a planning agent to
	# reproduce these machine-owned fields by hand.
	[[ -n "$plan_item_id" ]] || return 0
	decomposition="$(project_decomposition_plan_file)"
	report="$(decomposition_complexity_report_file)"
	[[ -f "$decomposition" && -f "$report" ]] || return 0
	decomposition_has_complexity_contract "$decomposition" || return 0
	report_row="$(awk -F '\t' -v node="$plan_item_id" 'NR > 1 && $1 == node {print; exit}' "$report")"
	dag_row="$(awk -F '\t' -v node="$plan_item_id" 'NR > 1 && $1 == node {print; exit}' "$decomposition")"
	[[ -n "$report_row" && -n "$dag_row" ]] || die "measured metadata is missing for plan node: $plan_item_id"
	# Bash treats tabs as IFS whitespace and collapses adjacent delimiters. The
	# complexity report legitimately leaves obligation_weight empty when no
	# Specification IR is installed, so parse through a non-whitespace separator
	# to preserve every TSV column position.
	report_parse_row="${report_row//$'\t'/$'\034'}"
	dag_parse_row="${dag_row//$'\t'/$'\034'}"
	IFS=$'\034' read -r _ _ _ complexity_score _ obligation_weight _ _ behavioral failures ownership concurrency \
		validations implementation_files actions declared_p95 effective_p95 _ _ _ <<< "$report_parse_row"
	IFS=$'\034' read -r _ _ _ _ _ _ _ _ planned_leaf_type complexity_class worker_route _ _ _ _ _ _ _ _ terra_exception <<< "$dag_parse_row"
	planned_effective_p95="$effective_p95"
	planned_worker_route="$worker_route"
	requested_route="$(metadata_value "$task_file" Worker-Route)"
	requested_class="$(metadata_value "$task_file" Complexity-Class)"
	requested_leaf="$(metadata_value "$task_file" Leaf-Type)"
	requested_architecture="$(metadata_value "$task_file" Architecture-Decisions)"
	requested_validation="$(metadata_value "$task_file" Validation-Class)"
	requested_files="$(metadata_value "$task_file" Expected-Max-Implementation-Files)"
	requested_turns="$(metadata_value "$task_file" Expected-Max-Worker-Turns)"
	architecture_decisions="$requested_architecture"
	if (( recovery_publish == 1 && manager_remediation == 0 )) &&
		[[ "$(metadata_value "$(task_root_replan_file "$root")" Trigger-Outcome)" == RESOURCE_PROGRESS_NEEDS_VERIFICATION &&
		"$requested_leaf" == VERIFICATION_ONLY ]]; then
		requested_files=0
		implementation_files=0
		log_event "RESOURCE_PROGRESS_VERIFICATION_VECTOR_NORMALIZED root=$root task=$task_id expected_files=0"
	fi
	if (( manager_remediation == 1 )); then
		if [[ "$HARNESS_ESCALATION_POLICY" == decompose ]]; then
			worker_route=LUNA
			complexity_class=LOW
			architecture_decisions=NONE
			log_event "LUNA_ONLY_MANAGER_REMEDIATION_NORMALIZED root=$root task=$task_id"
		else
			worker_route=TERRA
		fi
		# Remediation is execution authority granted by the recovery protocol,
		# not a new semantic decision.  Do not inherit the plan node's decision
		# exception into the bounded repair leaf.
		terra_exception=-
	elif (( recovery_publish == 1 )); then
		resource_recovery=0
		case "$(metadata_value "$(task_root_replan_file "$root")" Trigger-Outcome)" in
			RESOURCE_NEEDS_DECOMPOSITION|RESOURCE_PROGRESS_NEEDS_VERIFICATION) resource_recovery=1 ;;
		esac
		resource_local_authority=0
		(( resource_recovery == 0 )) || [[ "$requested_architecture" != NONE ]] || resource_local_authority=1
		luna_failures="$(root_luna_strategy_failure_count "$root")"
		verified_items="$(task_verified_item_count "$root")"
		trace_event RECOVERY_MEASURED_ROUTE_REQUEST "root=$root" "task_id=$task_id" \
			"requested_route=$requested_route" "requested_class=$requested_class" \
			"requested_leaf=$requested_leaf" "requested_architecture=$requested_architecture" \
			"requested_validation=$requested_validation" "requested_files=$requested_files" \
			"requested_turns=$requested_turns" "verified_items=$verified_items"
		recovery_decisions_resolved=1
		recovery_verified_child=0
		if (( HARNESS_ARCHITECTURE_GUARDS == 1 )); then
			for decision in $(architecture_node_value "$plan_item_id" produces_decisions | tr ',' ' '); do
				[[ -n "$decision" && "$decision" != - ]] || continue
			architecture_decision_accepted "$decision" || recovery_decisions_resolved=0
			done
		fi
		# An unresolved Terra architecture node may expose a concrete coding
		# continuation without ceasing to own the decision. Keep that bounded
		# implementation on Terra until the produced decision is accepted; it is
		# neither an ordinary Terra coding override nor a Luna-ready resolved leaf.
		if recovery_terra_architecture_implementation_allowed "$recovery_decisions_resolved" \
			"$planned_worker_route" "$planned_leaf_type" "$requested_leaf"; then
			architecture_recovery_authority=1
			log_event "RECOVERY_TERRA_ARCHITECTURE_IMPLEMENTATION_AUTHORIZED root=$root task=$task_id node_type=$planned_leaf_type requested_leaf=$requested_leaf"
		fi
		if recovery_candidate_targets_verified_child "$root" "$task_file" "$decomposition_candidate"; then
			recovery_verified_child=1
			log_event "RECOVERY_VERIFIED_CHILD_ROUTE_AUTHORIZED root=$root task=$task_id target=$(printf '%q' "$(metadata_value "$task_file" Target-Criterion)")"
		fi
		# A verified decision or a decomposed implementation boundary can leave a
		# much smaller child than the original measured plan node. Derive a fresh
		# child vector from its executable scope instead of restoring the parent's
		# HIGH/TERRA vector. Root semantic authority remains immutable.
		if { [[ "$HARNESS_MODEL_POLICY" == luna_only ]] ||
			(( luna_failures < HARNESS_MAX_LUNA_STRATEGY_FAILURES )); } &&
			(( recovery_decisions_resolved == 1 || recovery_verified_child == 1 ||
			resource_local_authority == 1 )) &&
			[[ "$requested_leaf" =~ ^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION|VERIFICATION_ONLY)$ &&
			"$requested_validation" =~ ^(FOCUSED|INCREMENTAL)$ &&
			"$requested_files" =~ ^[0-9]+$ && "$requested_turns" =~ ^[1-3]$ ]] &&
			(( requested_files <= HARNESS_MAX_LUNA_IMPLEMENTATION_FILES )); then
			required_symbols="$(metadata_value "$task_file" Required-Symbols)"
			symbol_count="$(awk -F, '{if ($0=="-" || $0=="") print 0; else print NF}' <<< "$required_symbols")"
			requested_obligations="$(metadata_value "$task_file" Obligations)"
			obligation_count="$(awk -F, '{if ($0=="-" || $0=="") print 1; else print NF}' <<< "$requested_obligations")"
			(( obligation_count <= HARNESS_MAX_LUNA_OBLIGATIONS_PER_LEAF )) || obligation_count="$HARNESS_MAX_LUNA_OBLIGATIONS_PER_LEAF"
			obligation_weight="$obligation_count"
			behavioral=1
			[[ "$requested_leaf" == FOCUSED_BUG ]] && failures=1 || failures=0
			ownership=0
			concurrency=0
			validations=1
			implementation_files="$requested_files"
			actions=$((requested_turns + 3))
			(( actions <= HARNESS_MAX_LUNA_PREDICTED_ACTIONS )) || actions="$HARNESS_MAX_LUNA_PREDICTED_ACTIONS"
			complexity_score=$((obligation_weight + behavioral * 3 + failures * 2 + validations * 2 + implementation_files * 2 + (symbol_count + 1) / 2))
			declared_p95=$((complexity_score * HARNESS_COMPLEXITY_TOKENS_PER_SCORE_POINT))
			calibration_rate="$(complexity_calibrated_tokens_per_score "$LUNA_WORKER_MODEL")"
			residual_p95=$((complexity_score * calibration_rate))
			effective_p95="$declared_p95"
			(( effective_p95 >= residual_p95 )) || effective_p95="$residual_p95"
			if [[ "$planned_worker_route" == LUNA && "$planned_effective_p95" =~ ^[1-9][0-9]*$ ]] &&
				(( effective_p95 < planned_effective_p95 )); then
				effective_p95="$planned_effective_p95"
			fi
			(( complexity_score <= HARNESS_MAX_LUNA_COMPLEXITY_SCORE &&
				actions <= HARNESS_MAX_LUNA_PREDICTED_ACTIONS &&
				effective_p95 <= HARNESS_MAX_LUNA_PREDICTED_P95_TOKENS )) ||
				die "residual evidence leaf exceeds the measured Luna budget (score=$complexity_score actions=$actions p95=$effective_p95)"
			complexity_class=LOW
			worker_route=LUNA
			terra_exception=-
			architecture_decisions=NONE
			measured_recovery_route_override=2
			log_event "RECOVERY_CHILD_RECLASSIFIED root=$root task=$task_id leaf_type=$requested_leaf complexity_score=$complexity_score actions=$actions p95=$effective_p95 files=$implementation_files"
			if (( implementation_files == 0 )) && [[ "$verified_items" =~ ^[1-9][0-9]*$ ]]; then
				log_event "RECOVERY_RESIDUAL_EVIDENCE_RECLASSIFIED root=$root task=$task_id leaf_type=$requested_leaf complexity_score=$complexity_score actions=$actions p95=$effective_p95"
			fi
		elif [[ "$HARNESS_ESCALATION_POLICY" == legacy ]] && luna_strategy_exhausted_coding_leaf "$luna_failures" \
			"$HARNESS_MAX_LUNA_STRATEGY_FAILURES" "$requested_leaf"; then
			requested_exception="$(metadata_value "$task_file" Terra-Exception)"
			worker_route=TERRA
			complexity_class=HIGH
			if [[ "$requested_exception" =~ ^(CONTRACT_DECISION|ARCHITECTURE_DECISION|CONCURRENCY_DESIGN|AMBIGUOUS_SPECIFICATION|UNEXPLAINED_INTEGRATION|IRREDUCIBLE_CROSS_BOUNDARY)$ ]]; then
				terra_exception="$requested_exception"
			else
				terra_exception=IRREDUCIBLE_CROSS_BOUNDARY
			fi
			if [[ "$requested_leaf" == VERIFICATION_ONLY && "$implementation_files" == 0 ]]; then
				# The exhausted root still escalates to fresh Terra, but this
				# read-only transaction is a residual execution vector rather than
				# the original write-capable DAG vector.
				measured_recovery_route_override=2
			else
				measured_recovery_route_override=1
			fi
			log_event "RECOVERY_TERRA_ESCALATION_NORMALIZED root=$root task=$task_id luna_failures=$luna_failures exception=$terra_exception"
		fi
	elif [[ "$task_id" != "$root" ]]; then
		# Checkpoint continuation planning is not an automatic-replan invocation,
		# but it follows the same model-routing history. Once the root has consumed
		# its Luna strategies, do not restore the stale DAG route and reject the
		# planner's next task. Normalize the bounded continuation to fresh Terra.
		luna_failures="$(root_luna_strategy_failure_count "$root")"
		if [[ "$HARNESS_ESCALATION_POLICY" == legacy ]] && luna_strategy_exhausted_coding_leaf "$luna_failures" \
			"$HARNESS_MAX_LUNA_STRATEGY_FAILURES" "$requested_leaf"; then
			worker_route=TERRA
			complexity_class=HIGH
			terra_exception=IRREDUCIBLE_CROSS_BOUNDARY
			measured_recovery_route_override=1
			log_event "CONTINUATION_TERRA_ESCALATION_NORMALIZED root=$root task=$task_id luna_failures=$luna_failures exception=$terra_exception"
		fi
	fi
	# An installed pre-policy DAG may retain a HIGH/TERRA aggregate even though
	# the active execution policy forbids stronger models. Preserve that plan
	# node as semantic authority while measuring the manager-authored first-unmet
	# child as its own Luna-sized execution vector. This is an in-place recursive
	# decomposition, not a mutation of accepted specification coverage.
	if [[ "$HARNESS_MODEL_POLICY" == luna_only && "$planned_worker_route" == TERRA ]] &&
		(( measured_recovery_route_override == 0 )); then
		if [[ "$task_id" == "$root" ]]; then
			root_criterion_count="$(awk -F': ' '$1=="Root-Criterion" {count++} END {print count+0}' "$task_file")"
			(( root_criterion_count >= 2 )) ||
				die 'a migrated Terra aggregate must declare at least two ordered node-local Root-Criterion stages'
		fi
		[[ "$requested_leaf" =~ ^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION|VERIFICATION_ONLY)$ ]] ||
			die "Luna-only migration requires a bounded executable child leaf, not aggregate $requested_leaf"
		[[ "$requested_validation" =~ ^(FOCUSED|INCREMENTAL)$ ]] ||
			die 'Luna-only migration child requires FOCUSED or INCREMENTAL validation'
		[[ "$requested_files" =~ ^[0-9]+$ && "$requested_turns" =~ ^[1-3]$ ]] ||
			die 'Luna-only migration child requires bounded implementation files and one to three turns'
		(( requested_files <= HARNESS_MAX_LUNA_IMPLEMENTATION_FILES )) ||
			die 'Luna-only migration child exceeds the implementation-file budget'
		required_symbols="$(metadata_value "$task_file" Required-Symbols)"
		symbol_count="$(awk -F, '{if ($0=="-" || $0=="") print 0; else print NF}' <<< "$required_symbols")"
		requested_obligations="$(metadata_value "$task_file" Obligations)"
		obligation_count="$(awk -F, '{if ($0=="-" || $0=="") print 1; else print NF}' <<< "$requested_obligations")"
		(( obligation_count <= HARNESS_MAX_LUNA_OBLIGATIONS_PER_LEAF )) ||
			die 'Luna-only migration child inherits too many obligations; split the criterion again'
		obligation_weight="$obligation_count"
		behavioral=1
		[[ "$requested_leaf" == FOCUSED_BUG ]] && failures=1 || failures=0
		ownership=0
		concurrency=0
		validations=1
		implementation_files="$requested_files"
		actions=$((requested_turns + 3))
		complexity_score=$((obligation_weight + behavioral * 3 + failures * 2 + validations * 2 + implementation_files * 2 + (symbol_count + 1) / 2))
		declared_p95=$((complexity_score * HARNESS_COMPLEXITY_TOKENS_PER_SCORE_POINT))
		calibration_rate="$(complexity_calibrated_tokens_per_score "$LUNA_WORKER_MODEL")"
		residual_p95=$((complexity_score * calibration_rate))
		effective_p95="$declared_p95"
		(( effective_p95 >= residual_p95 )) || effective_p95="$residual_p95"
		(( complexity_score <= HARNESS_MAX_LUNA_COMPLEXITY_SCORE &&
			actions <= HARNESS_MAX_LUNA_PREDICTED_ACTIONS &&
			effective_p95 <= HARNESS_MAX_LUNA_PREDICTED_P95_TOKENS )) ||
			die "migrated child still exceeds the Luna budget (score=$complexity_score actions=$actions p95=$effective_p95)"
		complexity_class=LOW
		worker_route=LUNA
		terra_exception=-
		architecture_decisions=NONE
		measured_recovery_route_override=2
		log_event "LUNA_ONLY_INSTALLED_TERRA_NODE_DECOMPOSED plan_item=$plan_item_id root=$root task=$task_id leaf=$requested_leaf score=$complexity_score actions=$actions p95=$effective_p95"
	fi
	if (( implementation_files > 0 && actions < HARNESS_MIN_SOURCE_CHANGE_AGENT_ACTIONS )); then
		actions="$HARNESS_MIN_SOURCE_CHANGE_AGENT_ACTIONS"
	fi
	tmp="$task_file.measured.$$"
	awk -F': ' \
		-v complexity="$complexity_score" -v behavioral="$behavioral" -v failures="$failures" \
		-v ownership="$ownership" -v concurrency="$concurrency" -v validations="$validations" \
		-v files="$implementation_files" -v actions="$actions" -v declared="$declared_p95" \
		-v effective="$effective_p95" -v class="$complexity_class" -v route="$worker_route" -v exception="$terra_exception" -v architecture="$architecture_decisions" '
		BEGIN {
			replace["Complexity-Score"]=complexity
			replace["Behavioral-Concerns"]=behavioral
			replace["Failure-Paths"]=failures
			replace["Ownership-Transitions"]=ownership
			replace["Concurrency-Boundaries"]=concurrency
			replace["Validation-Surfaces"]=validations
			replace["Expected-Max-Implementation-Files"]=files
			replace["Expected-Max-Agent-Actions"]=actions
			replace["Predicted-P95-Tokens"]=declared
			replace["Effective-P95-Tokens"]=effective
			replace["Terra-Exception"]=exception
			replace["Complexity-Class"]=class
			replace["Worker-Route"]=route
			replace["Architecture-Decisions"]=architecture
		}
		$1 == "Declared-P95-Tokens" {next}
		$1 in replace {next}
		{print}
		END {
			print "Complexity-Score: " replace["Complexity-Score"]
			print "Behavioral-Concerns: " replace["Behavioral-Concerns"]
			print "Failure-Paths: " replace["Failure-Paths"]
			print "Ownership-Transitions: " replace["Ownership-Transitions"]
			print "Concurrency-Boundaries: " replace["Concurrency-Boundaries"]
			print "Validation-Surfaces: " replace["Validation-Surfaces"]
			print "Expected-Max-Implementation-Files: " replace["Expected-Max-Implementation-Files"]
			print "Expected-Max-Agent-Actions: " replace["Expected-Max-Agent-Actions"]
			print "Predicted-P95-Tokens: " replace["Predicted-P95-Tokens"]
			print "Effective-P95-Tokens: " replace["Effective-P95-Tokens"]
			print "Terra-Exception: " replace["Terra-Exception"]
			print "Complexity-Class: " replace["Complexity-Class"]
			print "Worker-Route: " replace["Worker-Route"]
			print "Architecture-Decisions: " replace["Architecture-Decisions"]
		}
	' "$task_file" > "$tmp"
	chmod --reference="$task_file" "$tmp"
	mv "$tmp" "$task_file"
	log_event "MEASURED_ASSIGNMENT_METADATA_NORMALIZED task=$task_id plan_item=$plan_item_id complexity_score=$complexity_score actions=$actions p95=$effective_p95"
}

normalize_measured_assignment_metadata

normalize_recovery_architecture_metadata()
{
	local tmp
	(( recovery_publish == 1 && HARNESS_ARCHITECTURE_GUARDS == 1 )) || return 0
	[[ -n "$plan_item_id" ]] || return 0
	tmp="$task_file.architecture.$$"
	awk -F': ' '
		$1 ~ /^(Affected-Invariants|Consumed-Decisions|Produced-Decisions|Edge-Contracts|Health-Gates)$/ {next}
		{print}
	' "$task_file" > "$tmp"
	{
		printf 'Affected-Invariants: %s\n' "$(architecture_node_value "$plan_item_id" invariant_ids)"
		printf 'Consumed-Decisions: %s\n' "$(architecture_node_value "$plan_item_id" consumes_decisions)"
		printf 'Produced-Decisions: %s\n' "$(architecture_node_value "$plan_item_id" produces_decisions)"
		printf 'Edge-Contracts: %s\n' "$(architecture_node_value "$plan_item_id" edge_contracts)"
		printf 'Health-Gates: %s\n' "$(architecture_node_value "$plan_item_id" health_gates)"
	} >> "$tmp"
	chmod --reference="$task_file" "$tmp"
	mv "$tmp" "$task_file"
	log_event "RECOVERY_ARCHITECTURE_METADATA_NORMALIZED task=$task_id plan_item=$plan_item_id"
}

normalize_recovery_architecture_metadata

[[ ! -e "$ready" ]] || die "task already ready: $task_id"
[[ ! -e "$running" ]] || die "task already running: $task_id"
[[ ! -e "$result" ]] || die "task already has a result: $task_id"
[[ ! -e "$accepted" ]] || die "task already accepted: $task_id"
[[ ! -e "$checkpointed" ]] || die "task already checkpointed: $task_id"
[[ ! -e "$rejected" ]] || die "task already rejected: $task_id"
[[ ! -e "$blocked" ]] || die "task already blocked: $task_id"
[[ ! -e "$aborted" ]] || die "task is aborted: $task_id"

validate_criterion_inventory()
{
	local source_file="$1" source_kind="$2" criterion
	local -A seen=()
	if [[ "$source_kind" == assignment ]]; then
		mapfile -t declared_criteria < <(awk -F': ' '$1 == "Root-Criterion" {print $2}' "$source_file")
	else
		validate_criteria_definition_file "$source_file" 2
		mapfile -t declared_criteria < <(awk -F '\t' 'NR > 1 {print $1}' "$source_file")
	fi
	(( ${#declared_criteria[@]} > 0 )) || die 'a new root task must declare at least one Root-Criterion'
	for criterion in "${declared_criteria[@]}"; do
		[[ "$criterion" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]] ||
			die "invalid root criterion identifier: $criterion"
		[[ -z "${seen[$criterion]:-}" ]] || die "duplicate root criterion identifier: $criterion"
		seen[$criterion]=1
	done
}

validate_root_criteria_are_node_local()
{
	local coverage criterion node_ids node count
	local -a nodes=()
	[[ "$task_id" == "$root" && -n "$plan_item_id" ]] || return 0
	coverage="$(specification_coverage_file)"
	[[ -f "$coverage" ]] || return 0
	for criterion in "${declared_criteria[@]}"; do
		node_ids="$(awk -F '\t' -v id="$criterion" 'NR > 1 && $1 == id {print $2; exit}' "$coverage")"
		[[ -n "$node_ids" ]] || continue
		IFS=',' read -r -a nodes <<< "$node_ids"
		count=0
		for node in "${nodes[@]}"; do
			node="$(trim_surrounding_whitespace "$node")"
			[[ "$node" == "$plan_item_id" ]] && count=$((count + 1))
		done
		if (( ${#nodes[@]} > 1 && count == 1 )); then
			die "Root-Criterion $criterion is a cross-node specification obligation allocated to $node_ids; use a node-local criterion such as $plan_item_id.acceptance and retain $criterion only in Obligations metadata"
		fi
	done
}

single_metadata_value()
{
	local file="$1" field="$2" count value
	count="$(awk -F': ' -v field="$field" '$1 == field {count++} END {print count + 0}' "$file")"
	(( count == 1 )) || die "automatic replan assignment must contain exactly one $field line"
	value="$(awk -F': ' -v field="$field" '$1 == field {print $2; exit}' "$file")"
	[[ -n "$value" ]] || die "automatic replan assignment has an empty $field value"
	printf '%s\n' "$value"
}

section_has_content()
{
	local file="$1" heading="$2"
	awk -v heading="$heading" '
		$0 == heading {inside=1; next}
		inside && /^## / {exit}
		inside && $0 !~ /^[[:space:]]*$/ {found=1}
		END {exit found ? 0 : 1}
	' "$file"
}

assignment_material_fingerprint()
{
	local file="$1" fallback_target="${2:--}" material_target
	material_target="$(awk -F': ' '$1 == "Target-Criterion" {print $2; exit}' "$file")"
	[[ -n "$material_target" ]] || material_target="$fallback_target"
	{
		printf '%s\n' "$material_target"
		awk '
			/^## (Objective|Acceptance criteria|Validation commands)$/ {inside=1; print; next}
			inside && /^## / {inside=0}
			inside && $0 !~ /^[[:space:]]*$/ {gsub(/[[:space:]]+/, " "); print}
		' "$file"
	} | sha256sum | awk '{print "sha256:" $1}'
}

declare -a declared_criteria=()
# The recovery CLI historically reserves argument five for legacy root
# criteria and argument six for an append-only child decomposition. Modern
# roots keep criteria in the immutable assignment, so a planner can
# unambiguously identify a five-argument decomposition by its typed header.
# Accept that safe shorthand instead of wasting the one correction attempt on
# a positional '-' placeholder.
if (( recovery_publish == 1 )) && [[ -n "$criteria_candidate" && -z "$decomposition_candidate" ]] &&
	task_root_uses_assignment_criteria "$root" &&
	[[ "$(head -n 1 "$criteria_candidate" 2>/dev/null || true)" == $'parent_criterion\tchild_criterion\ttitle\tacceptance_evidence' ]]; then
	decomposition_candidate="$criteria_candidate"
	criteria_candidate=""
	log_event "RECOVERY_DECOMPOSITION_ARGUMENT_NORMALIZED root=$root task=$task_id candidate=$decomposition_candidate"
fi
if [[ "$task_id" == "$root" ]]; then
	validate_criterion_inventory "$task_file" assignment
	validate_root_criteria_are_node_local
else
	if task_root_uses_assignment_criteria "$root"; then
		[[ -z "$criteria_candidate" ]] ||
			die 'root criteria are already immutable in the root assignment; do not supply a replacement definition'
		validate_criterion_inventory "$root_assignment" assignment
	elif [[ -f "$criteria_definition" ]]; then
		if [[ -n "$criteria_candidate" ]]; then
			validate_criteria_definition_file "$criteria_candidate" 2
			cmp -s "$criteria_definition" "$criteria_candidate" ||
				die 'legacy root criteria definition is immutable and cannot be replaced'
		fi
		validate_criterion_inventory "$criteria_definition" definition
	elif (( recovery_publish == 1 )); then
		[[ -n "$criteria_candidate" ]] ||
			die 'legacy recovery task requires a criteria definition TSV'
		validate_criterion_inventory "$criteria_candidate" definition
	elif [[ -n "$criteria_candidate" ]]; then
		die 'a criteria definition may be installed only by a manager recovery task'
	fi
fi

validate_decomposition_for_root()
{
	local candidate="$1" expected_parent="$2" child known candidate_rows existing_rows parent_depth prospective_depth marker
	local -A known_ids=()
	validate_criterion_decomposition_candidate "$candidate" "$expected_parent"
	candidate_rows="$(( $(wc -l < "$candidate") - 1 ))"
	existing_rows="$(root_child_criterion_count "$root")"
	if (( existing_rows + candidate_rows > HARNESS_MAX_ROOT_CHILD_CRITERIA )); then
		if (( recovery_publish == 1 )) &&
			(( ${publish_attempts:-0} < ${max_publish_attempts:-$HARNESS_MAX_MANAGER_REPLAN_PUBLISH_ATTEMPTS} )); then
			log_event "RECOVERY_CHILD_BUDGET_REJECTED root=$root task=$task_id attempt=${publish_attempts:-0} children=$((existing_rows + candidate_rows)) limit=$HARNESS_MAX_ROOT_CHILD_CRITERIA"
			die "candidate decomposition would exceed the append-only child budget ($((existing_rows + candidate_rows))/$HARNESS_MAX_ROOT_CHILD_CRITERIA); keep the existing first-unmet leaf and publish a bounded continuation without a child decomposition"
		fi
		marker="$(mark_root_architecture_reassessment "$task_id" ROOT_CHILD_CRITERIA \
			"candidate decomposition would exceed the append-only child budget ($((existing_rows + candidate_rows))/$HARNESS_MAX_ROOT_CHILD_CRITERIA)" \
			"candidate=$candidate parent=$expected_parent")"
		printf '%s\n' "$marker"
		exit 0
	fi
	parent_depth=0
	if [[ -f "$criterion_decomposition" ]]; then
		parent_depth="$(awk -F '\t' -v wanted="$expected_parent" '
			NR > 1 {value=depth[$1]+1; if(value>depth[$2])depth[$2]=value}
			END {print depth[wanted]+0}
		' "$criterion_decomposition")"
	fi
	prospective_depth=$((parent_depth + 1))
	if (( prospective_depth > HARNESS_MAX_CRITERION_DEPTH )); then
		if (( recovery_publish == 1 )) &&
			(( ${publish_attempts:-0} < ${max_publish_attempts:-$HARNESS_MAX_MANAGER_REPLAN_PUBLISH_ATTEMPTS} )); then
			log_event "RECOVERY_DEPTH_EXPANSION_REJECTED root=$root task=$task_id attempt=${publish_attempts:-0} depth=$prospective_depth limit=$HARNESS_MAX_CRITERION_DEPTH"
			die "candidate decomposition would exceed the depth budget ($prospective_depth/$HARNESS_MAX_CRITERION_DEPTH); keep the existing first-unmet leaf $expected_parent and publish a bounded continuation without a child decomposition"
		fi
		marker="$(mark_root_architecture_reassessment "$task_id" CRITERION_DEPTH \
			"candidate decomposition would exceed the depth budget ($prospective_depth/$HARNESS_MAX_CRITERION_DEPTH)" \
			"candidate=$candidate parent=$expected_parent")"
		printf '%s\n' "$marker"
		exit 0
	fi
	while IFS= read -r known; do
		[[ -n "$known" ]] && known_ids[$known]=1
	done < <(
		task_root_declared_criteria "$root"
		[[ ! -f "$criterion_decomposition" ]] || awk -F '\t' 'NR > 1 {print $2}' "$criterion_decomposition"
	)
	while IFS=$'\t' read -r _ child _ _; do
		[[ -z "${known_ids[$child]:-}" ]] ||
			die "child criterion identifier is already used by this root: $child"
		if [[ -f "$(task_criterion_ledger_file "$root")" ]] &&
			awk -F '\t' -v item="$child" 'NR > 1 && $1 == item {found=1} END {exit !found}' \
				"$(task_criterion_ledger_file "$root")"; then
			die "child criterion identifier is already recorded in the verified-item ledger: $child"
		fi
	done < <(tail -n +2 "$candidate")
}

validate_deterministic_closure_graft()
{
	local candidate="$1" parent="$2" marker action trigger assignment repair expected expected_facets
	local row child_id _parent_task _sequence allowed_paths context_paths required_symbols _acceptance focused_validation
	local _source_cut _seam_kind _estimated _status target
	marker="$(task_root_replan_file "$root")"
	action="$(metadata_value "$marker" Closure-Repair-Action)"
	[[ "$action" == GRAFT_GRAPH_CUTS ]] || return 0
	trigger="$(metadata_value "$marker" Triggered-By)"
	[[ -n "$trigger" ]] || die 'deterministic closure graft marker is missing Triggered-By'
	assignment="$dir/archive/$(task_base "$trigger").assignment.md"
	repair="$dir/control/context-closures/$(task_base "$trigger")/repair-children.tsv"
	[[ -f "$assignment" && -s "$repair" ]] ||
		die 'deterministic closure graft source assignment or repair children are missing'
	# A single indexed seam is evidence that semantic subdivision is still
	# required; it is not itself a valid child graft and remains a bounded Luna
	# decomposition task.
	(( $(awk 'END {print NR > 0 ? NR - 1 : 0}' "$repair") >= 2 )) || return 0
	expected="$PROJECT_TMP_DIR/$(task_base "$task_id").expected-closure-graft.$$"
	expected_facets="$expected.facets.tsv"
	python3 "$HARNESS_HOME/tools/compile_closure_graft.py" \
		--assignment "$assignment" --repair-children "$repair" \
		--parent-criterion "$parent" --output "$expected" \
		--facets-output "$expected_facets" >/dev/null ||
		die 'trusted Context Closure child graft could not be recompiled'
	if ! cmp -s "$candidate" "$expected"; then
		rm -f "$expected" "$expected_facets"
		die 'child decomposition differs from the trusted Context Closure graph-cut graft'
	fi
	if [[ ! -f "$candidate.facets.tsv" ]] || ! cmp -s "$candidate.facets.tsv" "$expected_facets"; then
		rm -f "$expected" "$expected_facets"
		die 'child facet ledger is missing or violates parent-facet conservation'
	fi
	rm -f "$expected" "$expected_facets"
	row="$(tail -n +2 "$repair" | sort -t $'\t' -k3,3n -k1,1 | head -n 1)"
	IFS=$'\t' read -r child_id _parent_task _sequence allowed_paths context_paths required_symbols _acceptance \
		focused_validation _source_cut _seam_kind _estimated _status <<< "$row"
	target="$(metadata_value "$task_file" Target-Criterion)"
	[[ "$target" == "$parent.$child_id" ]] ||
		die "closure graft continuation must target the first deterministic child: $parent.$child_id"
	[[ "$(metadata_value "$task_file" Allowed-Scope)" == "$allowed_paths" ]] ||
		die 'closure graft continuation Allowed-Scope differs from its deterministic source cut'
	[[ "$(metadata_value "$task_file" Context-Paths)" == "$context_paths" ]] ||
		die 'closure graft continuation Context-Paths differ from its deterministic evidence cut'
	[[ "$(metadata_value "$task_file" Required-Symbols)" == "$required_symbols" ]] ||
		die 'closure graft continuation Required-Symbols differ from its deterministic source cut'
	[[ "$(metadata_value "$task_file" Focused-Validation)" == "$focused_validation" ]] ||
		die 'closure graft continuation Focused-Validation differs from its deterministic source cut'
	log_event "DETERMINISTIC_CLOSURE_GRAFT_VALIDATED root=$root task=$task_id parent=$parent children=$(( $(wc -l < "$candidate") - 1 )) facets=$candidate.facets.tsv"
}

validate_deterministic_closure_cut()
{
	local parent="$1" marker action trigger repair declared row child_id _parent_task _sequence
	local allowed_paths context_paths required_symbols acceptance focused_validation
	local _source_cut _seam_kind _estimated _status target parent_depth child_count
	marker="$(task_root_replan_file "$root")"
	declared="$(metadata_value "$task_file" Context-Closure-Cut)"
	if [[ ! -f "$marker" ]]; then
		[[ -z "$declared" ]] || die 'Context-Closure-Cut requires a pending typed closure-repair marker'
		return 0
	fi
	action="$(metadata_value "$marker" Closure-Repair-Action)"
	if [[ "$action" != GRAFT_GRAPH_CUTS ]]; then
		[[ -z "$declared" ]] || die 'Context-Closure-Cut is valid only for a pending GRAFT_GRAPH_CUTS repair'
		return 0
	fi
	trigger="$(metadata_value "$marker" Triggered-By)"
	repair="$dir/control/context-closures/$(task_base "$trigger")/repair-children.tsv"
	[[ -s "$repair" ]] || return 0
	parent_depth=0
	if [[ -f "$criterion_decomposition" ]]; then
		parent_depth="$(awk -F '\t' -v wanted="$parent" '
			NR > 1 {value=depth[$1]+1; if(value>depth[$2])depth[$2]=value}
			END {print depth[wanted]+0}
		' "$criterion_decomposition")"
	fi
	child_count="$(root_child_criterion_count "$root")"
	if (( parent_depth < HARNESS_MAX_CRITERION_DEPTH &&
		child_count < HARNESS_MAX_ROOT_CHILD_CRITERIA )); then
		[[ -z "$declared" ]] || die 'Context-Closure-Cut may replace child grafting only after the structural criterion budget is exhausted'
		return 0
	fi
	[[ -n "$declared" ]] ||
		die "structurally saturated GRAFT_GRAPH_CUTS recovery must bind the first compiled Context-Closure-Cut without adding another criterion level"
	row="$(tail -n +2 "$repair" | sort -t $'\t' -k3,3n -k1,1 | head -n 1)"
	IFS=$'\t' read -r child_id _parent_task _sequence allowed_paths context_paths required_symbols acceptance \
		focused_validation _source_cut _seam_kind _estimated _status <<< "$row"
	[[ "$declared" == "$child_id" ]] ||
		die "Context-Closure-Cut must bind the first ordered compiled cut: $child_id"
	target="$(metadata_value "$task_file" Target-Criterion)"
	[[ "$target" == "$parent" ]] || die "closure evidence cut must retain its immutable parent criterion: $parent"
	[[ "$(metadata_value "$task_file" Allowed-Scope)" == "$allowed_paths" ]] ||
		die 'closure evidence cut Allowed-Scope differs from its deterministic source cut'
	[[ "$(metadata_value "$task_file" Context-Paths)" == "$context_paths" ]] ||
		die 'closure evidence cut Context-Paths differ from its deterministic source cut'
	[[ "$(metadata_value "$task_file" Required-Symbols)" == "$required_symbols" ]] ||
		die 'closure evidence cut Required-Symbols differ from its deterministic source cut'
	[[ "$(metadata_value "$task_file" Goal-Success-Evidence)" == "$acceptance" ]] ||
		die 'closure evidence cut Goal-Success-Evidence differs from its deterministic acceptance evidence'
	[[ "$(metadata_value "$task_file" Focused-Validation)" == "$focused_validation" ]] ||
		die 'closure evidence cut Focused-Validation differs from its deterministic source cut'
	if [[ "$(metadata_value "$task_file" Manager-Remediation)" == 1 ]]; then
		[[ "$(metadata_value "$task_file" Remediation-Scope)" == "$allowed_paths" ]] ||
			die 'manager-remediation closure evidence cut must use its deterministic allowed_paths as Remediation-Scope'
	fi
	log_event "DETERMINISTIC_CLOSURE_CUT_VALIDATED root=$root task=$task_id parent=$parent cut=$child_id depth=$parent_depth children=$child_count"
}

target_criterion=""
if (( ${#declared_criteria[@]} > 0 )) && [[ "$task_id" != "$root" ]]; then
	target_count="$(awk -F': ' '$1 == "Target-Criterion" {count++} END {print count + 0}' "$task_file")"
	(( target_count == 1 )) ||
		die 'a continuation of a criterion-decomposed root requires exactly one Target-Criterion'
	target_criterion="$(awk -F': ' '$1 == "Target-Criterion" {print $2; exit}' "$task_file")"
	first_unmet="$(task_first_unmet_criterion "$root" 2>/dev/null || true)"
	if [[ -z "$first_unmet" && -n "$criteria_candidate" && ! -f "$criteria_definition" ]]; then
		for criterion in "${declared_criteria[@]}"; do
			if ! task_criterion_is_passed "$root" "$criterion"; then
				first_unmet="$criterion"
				break
			fi
		done
	fi
	[[ -n "$first_unmet" ]] || die 'all declared root criteria are already passed; accept the root instead of publishing a continuation'
	resource_decomposition_required=0
	if (( recovery_publish == 1 && manager_remediation == 0 )) &&
		[[ "$(metadata_value "$(task_root_replan_file "$root")" Trigger-Outcome)" == RESOURCE_NEEDS_DECOMPOSITION ]]; then
		first_unmet_depth=0
		if [[ -f "$criterion_decomposition" ]]; then
			first_unmet_depth="$(awk -F '\t' -v wanted="$first_unmet" '
				NR > 1 {value=depth[$1]+1; if(value>depth[$2])depth[$2]=value}
				END {print depth[wanted]+0}
			' "$criterion_decomposition")"
		fi
		if (( first_unmet_depth < HARNESS_MAX_CRITERION_DEPTH &&
			$(root_child_criterion_count "$root") < HARNESS_MAX_ROOT_CHILD_CRITERIA )); then
			resource_decomposition_required=1
		fi
	fi
	if (( resource_decomposition_required == 1 )) && [[ -z "$decomposition_candidate" ]]; then
		die "resource-fused continuation must append at least two bounded direct children under the first unmet criterion: $first_unmet"
	fi
	if [[ -n "$decomposition_candidate" ]]; then
		(( recovery_publish == 1 )) ||
			die 'a child criterion decomposition may be installed only by a manager recovery task'
		[[ -z "$(task_criterion_children "$root" "$first_unmet")" ]] ||
			die "the first unmet criterion is already decomposed: $first_unmet"
		validate_decomposition_for_root "$decomposition_candidate" "$first_unmet"
		validate_deterministic_closure_graft "$decomposition_candidate" "$first_unmet"
		decomposed_first="$(awk -F '\t' 'NR == 2 {print $2}' "$decomposition_candidate")"
		[[ "$target_criterion" == "$decomposed_first" ]] ||
			die "continuation must target the first new child criterion: $decomposed_first"
	elif [[ "$target_criterion" != "$first_unmet" ]]; then
		die "continuation must target the first unmet criterion: $first_unmet"
	else
		validate_deterministic_closure_cut "$first_unmet"
	fi
elif [[ -n "$decomposition_candidate" ]]; then
	die 'child criterion decomposition requires an existing explicit criterion inventory'
fi

scope_is_within_root_authority()
{
	local candidate="$1" authority="$2" entry authority_entry allowed
	local -a candidate_entries=() authority_entries=()
	candidate="${candidate//;/,}"
	authority="${authority//;/,}"
	IFS=',' read -r -a candidate_entries <<< "$candidate"
	IFS=',' read -r -a authority_entries <<< "$authority"
	for entry in "${candidate_entries[@]}"; do
		entry="$(trim_surrounding_whitespace "$entry")"
		[[ -n "$entry" ]] || continue
		allowed=0
		for authority_entry in "${authority_entries[@]}"; do
			authority_entry="$(trim_surrounding_whitespace "$authority_entry")"
			[[ -n "$authority_entry" ]] || continue
			if [[ "$entry" == "$authority_entry" || "$entry" == "$authority_entry"/* ]]; then
				allowed=1
				break
			fi
		done
		(( allowed == 1 )) || return 1
	done
	return 0
}

scope_metadata_is_path_list()
{
	local scope="$1" entry
	local -a entries=()
	scope="${scope//;/,}"
	IFS=',' read -r -a entries <<< "$scope"
	(( ${#entries[@]} > 0 )) || return 1
	for entry in "${entries[@]}"; do
		entry="$(trim_surrounding_whitespace "$entry")"
		[[ -n "$entry" && "$entry" != *[[:space:]]* ]] || return 1
	done
	return 0
}

canonical_scope_path_set()
{
	local scope="$1"
	printf '%s\n' "$scope" | tr ',;[:space:]' '\n' | sed '/^$/d' | sort -u | paste -sd, -
}

comma_values_are_subset()
{
	local candidate="$1" authority="$2" value
	local -A allowed=()
	while IFS= read -r value; do
		[[ -n "$value" && "$value" != - ]] && allowed[$value]=1
	done < <(tr ',' '\n' <<< "$authority" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
	while IFS= read -r value; do
		[[ -n "$value" && "$value" != - ]] || continue
		[[ -n "${allowed[$value]:-}" ]] || return 1
	done < <(tr ',' '\n' <<< "$candidate" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
	return 0
}

scope_authorizes_governing_specification()
{
	local scope="$1" specification_relative entry
	local -a entries=()
	specification_relative="$(realpath --relative-to="$REPOSITORY" "$SPECIFICATION" 2>/dev/null || true)"
	[[ -n "$specification_relative" && "$specification_relative" != ../* ]] || return 1
	scope="${scope//;/,}"
	IFS=',' read -r -a entries <<< "$scope"
	for entry in "${entries[@]}"; do
		entry="$(trim_surrounding_whitespace "$entry")"
		entry="${entry%/}"
		if [[ "$entry" == "$specification_relative" || "$specification_relative" == "$entry"/* ]]; then
			return 0
		fi
	done
	return 1
}

scope_is_generated_validation_only()
{
	local scope="$1" entry
	local -a entries=()
	scope="${scope//;/,}"
	IFS=',' read -r -a entries <<< "$scope"
	(( ${#entries[@]} > 0 )) || return 1
	for entry in "${entries[@]}"; do
		entry="$(trim_surrounding_whitespace "$entry")"
		entry="${entry%/}"
		case "$entry" in
			build|build/*|build-*|build-*/*|cmake-build-*|cmake-build-*/*|*/build|*/build/*|*/build-*|*/build-*/*|*/cmake-build-*|*/cmake-build-*/*)
				;;
			*) return 1 ;;
		esac
	done
	return 0
}

registered_literal_cmake_targets()
{
	git -C "$REPOSITORY" grep -h -E \
		'^[[:space:]]*add_(executable|library|custom_target)[[:space:]]*\([[:space:]]*[A-Za-z0-9_.:+-]+' \
		-- 'CMakeLists.txt' ':(glob)**/CMakeLists.txt' ':(glob)**/*.cmake' 2>/dev/null |
		sed -nE 's/^[[:space:]]*add_(executable|library|custom_target)[[:space:]]*\([[:space:]]*([A-Za-z0-9_.:+-]+).*/\2/p' |
		sort -u
}

normalize_unique_cmake_target_aliases()
{
	local requested candidate old_pattern replacement tmp
	local -a registered=() matches=() requested_targets=()
	[[ "$goal_focused_validation" == *cmake*--build*--target* ]] || return 0
	mapfile -t registered < <(registered_literal_cmake_targets)
	(( ${#registered[@]} > 0 )) || return 0
	mapfile -t requested_targets < <(
		grep -oE -- '--target(=|[[:space:]]+)[A-Za-z0-9_.:+-]+' <<< "$goal_focused_validation" |
			sed -E 's/^--target(=|[[:space:]]+)//' | sort -u
	)
	for requested in "${requested_targets[@]}"; do
		printf '%s\n' "${registered[@]}" | grep -Fxq -- "$requested" && continue
		matches=()
		for candidate in "${registered[@]}"; do
			[[ "$candidate" == *_"$requested" ]] && matches+=("$candidate")
		done
		(( ${#matches[@]} == 1 )) || continue
		candidate="${matches[0]}"
		old_pattern="$(printf '%s' "$requested" | sed 's/[][\\.^$*+?{}|()]/\\&/g')"
		replacement="$(printf '%s' "$candidate" | sed 's/[&#]/\\&/g')"
		tmp="$task_file.cmake-target.$$"
		sed -E "s#(^|[^A-Za-z0-9_.:+-])${old_pattern}([^A-Za-z0-9_.:+-]|$)#\\1${replacement}\\2#g" \
			"$task_file" > "$tmp"
		chmod --reference="$task_file" "$tmp"
		mv "$tmp" "$task_file"
		log_event "CMAKE_TARGET_ALIAS_NORMALIZED root=$root task=$task_id requested=$requested registered=$candidate"
	done
	goal_focused_validation="$(metadata_value "$task_file" Focused-Validation)"
}

validate_focused_validation_boundary()
{
	local validation="$1" success_evidence="${2:-}" lower success_lower
	lower="${validation,,}"
	success_lower="${success_evidence,,}"
	[[ -n "$validation" ]] || die 'FOCUSED validation requires a nonempty bounded command or evidence boundary'
	validation_is_executable_command "$validation" ||
		die 'Focused-Validation must be one machine-executable shell command without Markdown quoting or trailing prose; use Validation-Command to refine a descriptive DAG boundary'
	if grep -Eq '(^|[[:space:];&|])([0-9]*>|&>)[[:space:]]*[^&|;]*|[0-9]+>&[0-9]+' <<< "$validation"; then
		mark_efficiency_warning VALIDATION_EVIDENCE_SUPPRESSED "${task_id:--}" \
			'focused validation redirected command diagnostics outside harness capture' "validation=$validation"
		die 'Focused-Validation must not redirect stdout or stderr; harness-run-assigned-validation retains bounded complete diagnostics'
	fi
	if [[ "$lower" == *"cmake --build"* && "$lower" != *"--target"* ]]; then
		mark_efficiency_warning VALIDATION_INFLATION "${task_id:--}" \
			'focused leaf requested an unqualified CMake all-target build' "validation=$validation"
		die 'FOCUSED validation cannot run an unqualified CMake all-target build; name the exact --target or use a separate CLEAN_GLOBAL Terra integration leaf'
	fi
	if [[ "$lower" == *"ctest"* && "$lower" != *" -r "* &&
		"$lower" != *"--tests-regex"* ]]; then
		mark_efficiency_warning VALIDATION_INFLATION "${task_id:--}" \
			'focused leaf requested unfiltered CTest' "validation=$validation"
		die 'FOCUSED validation cannot run unfiltered CTest; name an exact -R/--tests-regex selector or use CLEAN_GLOBAL validation'
	fi
	if [[ "$lower" == *"host-test-build"* || "$lower" == *"test-build"* ]]; then
		mark_efficiency_warning VALIDATION_INFLATION "${task_id:--}" \
			'focused leaf requested a repository-wide test-build target' "validation=$validation"
		die 'FOCUSED validation cannot use a repository-wide test-build target; name the exact executable/test target or use CLEAN_GLOBAL validation'
	fi
	if [[ "$success_lower" =~ (execut|runtime|observation|observes|reports|output|status[[:space:]]+row|fixture) ]] &&
		grep -Eq 'cmake[[:space:]].*--build([[:space:]]|=).*(--target([=[:space:]])[^[:space:];&|]+)?[[:space:]]*$' <<< "$validation"; then
		mark_efficiency_warning VALIDATION_CONTRACT_INCOMPLETE "${task_id:--}" \
			'focused success evidence requires runtime observation but the command ends after compilation' \
			"success_evidence=$success_evidence validation=$validation"
		die 'Focused-Validation ends after compilation but Goal-Success-Evidence requires execution/runtime observation; execute the exact built fixture or selected test in the same captured command'
	fi
}

validate_static_cmake_validation_paths()
{
	local validation="$1" source_path build_path configured_build_path candidate
	local source_candidate cached_source cache_file
	[[ "$validation" == *cmake* ]] || return 0
	# A leading directory change alters the relative command boundary. Leave
	# those commands to execution-time validation rather than guessing shell
	# state. Static repository-root commands, however, are deterministic.
	grep -Eq '(^|[;&|][[:space:]]*)cd[[:space:]]+' <<< "$validation" && return 0
	source_path="$({ grep -oE 'cmake[[:space:]]+-S(=|[[:space:]]+)[^[:space:];&|]+' <<< "$validation" || true; } |
		sed -nE '1{s/^cmake[[:space:]]+-S(=|[[:space:]]+)//;p}')"
	source_path="${source_path#\"}"; source_path="${source_path%\"}"
	source_path="${source_path#\'}"; source_path="${source_path%\'}"
	if [[ -n "$source_path" && "$source_path" != *'$'* && "$source_path" != *'`'* ]]; then
		candidate="$source_path"
		[[ "$candidate" == /* ]] || candidate="$REPOSITORY/$candidate"
		[[ -f "$candidate/CMakeLists.txt" ]] ||
			die "focused validation uses static CMake source path '$source_path' without CMakeLists.txt at the repository-root execution boundary"
		source_candidate="$(realpath -m -- "$candidate")"
	fi
	configured_build_path="$({ grep -oE 'cmake([^;&|]|[[:space:]])*-B(=|[[:space:]]+)[^[:space:];&|]+' <<< "$validation" || true; } |
		sed -nE '1{s/^.*-B(=|[[:space:]]+)//;p}')"
	configured_build_path="${configured_build_path#\"}"; configured_build_path="${configured_build_path%\"}"
	configured_build_path="${configured_build_path#\'}"; configured_build_path="${configured_build_path%\'}"
	if [[ -n "$configured_build_path" && "$configured_build_path" != *'$'* &&
		"$configured_build_path" != *'`'* && -n "${source_candidate:-}" ]]; then
		candidate="$configured_build_path"
		[[ "$candidate" == /* ]] || candidate="$REPOSITORY/$candidate"
		cache_file="$candidate/CMakeCache.txt"
		if [[ -f "$cache_file" ]]; then
			cached_source="$(awk -F= '$1 == "CMAKE_HOME_DIRECTORY:INTERNAL" {print $2; exit}' "$cache_file")"
			if [[ -n "$cached_source" && "$(realpath -m -- "$cached_source")" != "$source_candidate" ]]; then
				die "focused validation reuses static CMake build path '$configured_build_path' whose cache belongs to '$cached_source', not '$source_path'; use a fresh build path"
			fi
		fi
	fi
	while IFS= read -r build_path; do
		build_path="${build_path#\"}"; build_path="${build_path%\"}"
		build_path="${build_path#\'}"; build_path="${build_path%\'}"
		[[ -n "$build_path" && "$build_path" != *'$'* && "$build_path" != *'`'* ]] || continue
		[[ "$build_path" == "$configured_build_path" ]] && continue
		candidate="$build_path"
		[[ "$candidate" == /* ]] || candidate="$REPOSITORY/$candidate"
		[[ -d "$candidate" ]] ||
			die "focused validation uses missing static CMake build path '$build_path' without configuring it in the same command"
	done < <(
		{ grep -oE 'cmake[[:space:]]+--build(=|[[:space:]]+)[^[:space:];&|]+' <<< "$validation" || true; } |
			sed -E 's/^cmake[[:space:]]+--build(=|[[:space:]]+)//'
	)
}

validate_static_make_validation_target()
{
	local validation="$1" make_dir make_target makefile candidate
	# `cmake` contains the bytes "make". Require a standalone make command;
	# otherwise the read below returns 1 under `set -e` and silently aborts an
	# otherwise valid CMake publication.
	grep -Eq '(^|[;&|][[:space:]]*)make[[:space:]]+' <<< "$validation" || return 0
	grep -Eq '(^|[;&|][[:space:]]*)cd[[:space:]]+' <<< "$validation" && return 0
	read -r make_dir make_target < <(
		sed -nE 's#^.*(^|[;&|][[:space:]]*)make[[:space:]]+-C[[:space:]]+([^[:space:];&|]+)[[:space:]]+([^[:space:];&|]+).*$#\2 \3#p' \
			<<< "$validation" | head -n 1
	) || return 0
	make_dir="${make_dir#\"}"; make_dir="${make_dir%\"}"
	make_dir="${make_dir#\'}"; make_dir="${make_dir%\'}"
	make_target="${make_target#\"}"; make_target="${make_target%\"}"
	make_target="${make_target#\'}"; make_target="${make_target%\'}"
	[[ -n "$make_dir" && -n "$make_target" ]] || return 0
	[[ "$make_dir" != *'$'* && "$make_target" != *'$'* && "$make_target" != -* ]] || return 0
	candidate="$make_dir"
	[[ "$candidate" == /* ]] || candidate="$REPOSITORY/$candidate"
	if [[ -f "$candidate/Makefile" ]]; then
		makefile="$candidate/Makefile"
	elif [[ -f "$candidate/makefile" ]]; then
		makefile="$candidate/makefile"
	else
		die "focused validation uses static make directory '$make_dir' without a Makefile at the repository-root execution boundary"
	fi
	grep -Eq "^$(printf '%s' "$make_target" | sed 's/[][\\.^$*+?{}|()]/\\&/g')([[:space:]]*:|::)" "$makefile" ||
		die "focused validation names missing static make target '$make_target' in $make_dir"
	return 0
}

assignment_objective_text()
{
	awk '
		$0 == "## Objective" {inside=1; next}
		inside && /^## / {exit}
		inside {print}
	' "$1"
}

validate_implementation_ready_leaf()
{
	local objective lower
	(( leaf_expected_files > 0 )) || return 0
	validation_is_review_descriptor "$goal_focused_validation" &&
		die 'coding leaves require one machine-executable focused validation command; a review descriptor or source audit is not implementation validation'
	objective="$(assignment_objective_text "$task_file")"
	lower="${objective,,}"
	if [[ "$lower" =~ (^|[^a-z])(determine|discover|locate|infer|figure[[:space:]]+out|identify[[:space:]]+the[[:space:]]+exact|inspect[[:space:]]+only)([^a-z]|$) ]]; then
		die 'coding leaf is not implementation-ready: Objective still delegates interface/contract discovery; decompose a diagnostic prerequisite or embed the exact implementation contract first'
	fi
}

validate_direct_cmake_execution_targets()
{
	local candidate escaped
	local -a registered=() requested_targets=()
	[[ "$goal_focused_validation" == *cmake*--build*--target* ]] || return 0
	mapfile -t registered < <(registered_literal_cmake_targets)
	mapfile -t requested_targets < <(
		grep -oE -- '--target(=|[[:space:]]+)[A-Za-z0-9_.:+-]+' <<< "$goal_focused_validation" |
			sed -E 's/^--target(=|[[:space:]]+)//' | sort -u
	)
	for candidate in "${registered[@]}"; do
		escaped="$(printf '%s' "$candidate" | sed 's/[][\\.^$*+?{}|()]/\\&/g')"
		# Only direct build-tree execution is relevant. A target name in the
		# --target argument itself must not be mistaken for an executed binary.
		grep -Eq "/${escaped}([[:space:];&|><'\"]|$)" <<< "$goal_focused_validation" || continue
		printf '%s\n' "${requested_targets[@]}" | grep -Fxq -- "$candidate" ||
			die "focused validation executes CMake target $candidate directly but does not build that exact target in the same command"
	done
}

normalize_revision_execution_metadata()
{
	local root_scope root_max_files root_max_turns requested_scope requested_files requested_turns
	local normalized_scope normalized_files normalized_turns tmp changed=0 scope_override additional_scope additional_entry
	local replan_trigger_outcome requested_leaf declared_root_max_files effective_root_scope dirty_path
	local preserved_dirty_files=0
	local additional_file_allowance=0
	local -a additional_entries=()
	[[ "$task_id" != "$root" && -f "$root_assignment" ]] || return 0
	root_scope="$(metadata_value "$root_assignment" Allowed-Scope)"
	root_max_files="$(metadata_value "$root_assignment" Expected-Max-Implementation-Files)"
	declared_root_max_files="$root_max_files"
	effective_root_scope="$root_scope"
	root_max_turns="$(metadata_value "$root_assignment" Expected-Max-Worker-Turns)"
	scope_override="$(task_root_architecture_scope_override_file "$root")"
	if (( manager_remediation == 1 )) && [[ "$root_max_files" =~ ^[0-9]+$ && -f "$scope_override" ]] &&
		[[ "$(kv_file_value "$scope_override" authorized_for 2>/dev/null || true)" == manager_remediation ]]; then
		additional_scope="$(kv_file_value "$scope_override" additional_scope 2>/dev/null || true)"
		[[ -z "$additional_scope" ]] || effective_root_scope="$root_scope,$additional_scope"
		IFS=',' read -r -a additional_entries <<< "${additional_scope//;/,}"
		for additional_entry in "${additional_entries[@]}"; do
			additional_entry="$(trim_surrounding_whitespace "$additional_entry")"
			[[ -n "$additional_entry" ]] || continue
			scope_is_within_root_authority "$additional_entry" "$root_scope" && continue
			additional_file_allowance=$((additional_file_allowance + 1))
		done
		root_max_files=$((root_max_files + additional_file_allowance))
	fi
	requested_scope="$(metadata_value "$task_file" Allowed-Scope)"
	requested_files="$(metadata_value "$task_file" Expected-Max-Implementation-Files)"
	requested_turns="$(metadata_value "$task_file" Expected-Max-Worker-Turns)"
	# A verification-only root can expose a pre-existing tracked source defect.
	# Fresh Terra remediation may repair only those already-dirty paths within
	# the immutable root/explicitly audited scope. Recover that concrete ceiling
	# instead of clamping the remediation back to zero and then rejecting the
	# machine-owned measured vector that correctly accounts for the file.
	if (( manager_remediation == 1 )) && [[ "$declared_root_max_files" == 0 &&
		"$requested_files" =~ ^[1-9][0-9]*$ ]]; then
		while IFS= read -r -d '' dirty_path; do
			scope_is_within_root_authority "$dirty_path" "$effective_root_scope" || continue
			preserved_dirty_files=$((preserved_dirty_files + 1))
		done < <(git -C "$REPOSITORY" diff --name-only --diff-filter=ACMRD -z HEAD --)
		if (( preserved_dirty_files > root_max_files )); then
			root_max_files="$preserved_dirty_files"
			log_event "ZERO_WRITE_REMEDIATION_FILE_CEILING_RECOVERED root=$root task=$task_id files=$preserved_dirty_files scope=$(printf '%q' "$effective_root_scope")"
		fi
	fi
	normalized_scope="$requested_scope"
	normalized_files="$requested_files"
	normalized_turns="$requested_turns"
	replan_trigger_outcome=""
	requested_leaf="$(metadata_value "$task_file" Leaf-Type)"
	if (( recovery_publish == 1 && manager_remediation == 0 )); then
		replan_trigger_outcome="$(metadata_value "$(task_root_replan_file "$root")" Trigger-Outcome)"
	fi

	# A resource-fused episode that changed the workspace must be followed by a
	# zero-write verification transaction.  The implementation-file count is
	# execution metadata, not inherited semantic authority.  Normalize it before
	# measured-vector and leaf validation so a correct VERIFICATION_ONLY recovery
	# cannot spend every publisher retry correcting a stale parent count.
	if [[ "$replan_trigger_outcome" == RESOURCE_PROGRESS_NEEDS_VERIFICATION &&
		"$requested_leaf" == VERIFICATION_ONLY && "$requested_files" != 0 ]]; then
		normalized_files=0
		changed=1
		log_event "RESOURCE_PROGRESS_VERIFICATION_METADATA_NORMALIZED root=$root task=$task_id requested_files=${requested_files:--} expected_files=0"
	fi

	# Generated build trees are validation workspaces, never source mutation
	# authority. Keep them in Context-Paths and validation commands while
	# preserving the root's tracked-source authority.
	if [[ -n "$root_scope" ]] && scope_is_generated_validation_only "$requested_scope" &&
		! scope_is_within_root_authority "$requested_scope" "$root_scope"; then
		normalized_scope="$root_scope"
		changed=1
	fi
	# File and process-turn counts are execution budgets, not architecture
	# authority. A revision may narrow them but cannot raise the immutable root
	# ceiling merely by restating metadata.
	if [[ "$root_max_files" =~ ^[0-9]+$ && "$normalized_files" =~ ^[0-9]+$ ]] &&
		(( normalized_files > root_max_files )); then
		normalized_files="$root_max_files"
		changed=1
	fi
	if [[ "$root_max_turns" =~ ^[1-9][0-9]*$ && "$requested_turns" =~ ^[1-9][0-9]*$ ]] &&
		(( requested_turns > root_max_turns )); then
		normalized_turns="$root_max_turns"
		changed=1
	fi
	(( changed == 1 )) || return 0

	tmp="$task_file.execution-authority.$$"
	HARNESS_NORMALIZED_ALLOWED_SCOPE="$normalized_scope" \
	HARNESS_NORMALIZED_EXPECTED_FILES="$normalized_files" \
	HARNESS_NORMALIZED_EXPECTED_TURNS="$normalized_turns" awk -F': ' '
		$1 == "Allowed-Scope" {print "Allowed-Scope: " ENVIRON["HARNESS_NORMALIZED_ALLOWED_SCOPE"]; next}
		$1 == "Expected-Max-Implementation-Files" {print "Expected-Max-Implementation-Files: " ENVIRON["HARNESS_NORMALIZED_EXPECTED_FILES"]; next}
		$1 == "Expected-Max-Worker-Turns" {print "Expected-Max-Worker-Turns: " ENVIRON["HARNESS_NORMALIZED_EXPECTED_TURNS"]; next}
		{print}
	' "$task_file" > "$tmp"
	chmod --reference="$task_file" "$tmp"
	mv "$tmp" "$task_file"
	log_event "REVISION_EXECUTION_METADATA_NORMALIZED root=$root task=$task_id requested_scope=$(printf '%q' "$requested_scope") allowed_scope=$(printf '%q' "$normalized_scope") requested_files=${requested_files:--} expected_files=${normalized_files:--} requested_turns=${requested_turns:--} expected_turns=${normalized_turns:--}"
}

normalize_revision_execution_metadata

normalize_recovery_context_paths()
{
	local requested required allowed validation normalized entry symbol candidate tmp changed=0
	local found duplicate exact_file stem directory
	local -a entries=() kept=() symbols=() candidates=() source_directories=() exact_files=()
	(( recovery_publish == 1 )) || return 0
	[[ "$HARNESS_MODEL_POLICY" == luna_only ]] || return 0
	requested="$(metadata_value "$task_file" Context-Paths)"
	required="$(metadata_value "$task_file" Required-Symbols)"
	allowed="$(metadata_value "$task_file" Allowed-Scope)"
	validation="$(metadata_value "$task_file" Focused-Validation)"
	[[ -n "$requested" && "$requested" != - ]] || return 0

	# Generated validation workspaces are not repository evidence.  A manager
	# commonly copies the configured /tmp build directory into Context-Paths;
	# remove only this project-owned temporary prefix and keep every source or
	# symbolic entry unchanged.
	IFS=',' read -r -a entries <<< "$requested"
	for entry in "${entries[@]}"; do
		entry="$(trim_surrounding_whitespace "$entry")"
		[[ -n "$entry" ]] || continue
		if [[ "$entry" == "$PROJECT_TMP_DIR" || "$entry" == "$PROJECT_TMP_DIR/"* ]]; then
			[[ "$validation" == *"$entry"* || "$entry" == *build* ]] || {
				kept+=("$entry")
				continue
			}
			changed=1
			continue
		fi
		if [[ "$entry" != /* && -d "$REPOSITORY/$entry" ]]; then
			# A directory is mutation authority, not an exact closure evidence
			# seed. Keep it as a bounded deterministic search boundary and replace
			# it with tracked source files below.
			source_directories+=("$entry")
			changed=1
			continue
		fi
		kept+=("$entry")
		[[ "$entry" == /* || ! -f "$REPOSITORY/$entry" ]] || exact_files+=("$entry")
	done

	# Required-Symbols and explicit Context-Paths form one compiled closure
	# contract.  If none of the declared repository files contains a required
	# token, add one deterministic tracked definition/usage path.  This is the
	# same bounded candidate the old diagnostic returned to Luna, now performed
	# without spending another model action.
	IFS=',' read -r -a symbols <<< "$required"
	for symbol in "${symbols[@]}"; do
		symbol="$(trim_surrounding_whitespace "$symbol")"
		[[ -n "$symbol" && "$symbol" != - && "$symbol" != NONE ]] || continue
		found=0
		for entry in "${kept[@]}"; do
			[[ "$entry" != /* && -e "$REPOSITORY/$entry" ]] || continue
			if (cd "$REPOSITORY" && rg -q --fixed-strings -- "$symbol" "$entry" 2>/dev/null < /dev/null); then
				found=1
				break
			fi
		done
		(( found == 0 )) || continue
		mapfile -t candidates < <(git -C "$REPOSITORY" grep -l -F -- "$symbol" -- . 2>/dev/null |
			LC_ALL=C sort -u)
		candidate=""
		for entry in "${candidates[@]}"; do
			if scope_is_within_root_authority "$entry" "$allowed"; then
				candidate="$entry"
				break
			fi
		done
		[[ -n "$candidate" || ${#candidates[@]} -eq 0 ]] || candidate="${candidates[0]}"
		[[ -n "$candidate" ]] || continue
		duplicate=0
		for entry in "${kept[@]}"; do
			[[ "$entry" != "$candidate" ]] || duplicate=1
		done
		(( duplicate == 1 )) || {
			kept+=("$candidate")
			exact_files+=("$candidate")
			changed=1
		}
	done

	# Resolve conventional public-header/implementation seams without a model
	# turn. For example, include/foo.h plus src/core becomes the unique tracked
	# src/core/foo.c. Ambiguous basenames remain absent rather than broadening
	# the capsule to a whole directory.
	for directory in "${source_directories[@]}"; do
		for exact_file in "${exact_files[@]}"; do
			stem="${exact_file##*/}"
			stem="${stem%.*}"
			mapfile -t candidates < <(git -C "$REPOSITORY" ls-files -- \
				"$directory/$stem.c" "$directory/**/$stem.c" \
				"$directory/$stem.cc" "$directory/**/$stem.cc" \
				"$directory/$stem.cpp" "$directory/**/$stem.cpp" | LC_ALL=C sort -u)
			(( ${#candidates[@]} == 1 )) || continue
			candidate="${candidates[0]}"
			duplicate=0
			for entry in "${kept[@]}"; do
				[[ "$entry" != "$candidate" ]] || duplicate=1
			done
			(( duplicate == 1 )) || kept+=("$candidate")
		done
	done
	(( changed == 1 )) || return 0
	(( ${#kept[@]} > 0 && ${#kept[@]} <= 8 )) ||
		die 'normalized Luna Context-Paths cannot fit the bounded eight-entry capsule'
	normalized="$(IFS=,; printf '%s' "${kept[*]}")"
	tmp="$task_file.context-paths.$$"
	HARNESS_NORMALIZED_CONTEXT_PATHS="$normalized" awk -F': ' '
		$1 == "Context-Paths" {print "Context-Paths: " ENVIRON["HARNESS_NORMALIZED_CONTEXT_PATHS"]; next}
		{print}
	' "$task_file" > "$tmp"
	chmod --reference="$task_file" "$tmp"
	mv "$tmp" "$task_file"
	log_event "LUNA_CONTEXT_PATHS_NORMALIZED root=$root task=$task_id requested=$(printf '%q' "$requested") normalized=$(printf '%q' "$normalized")"
}

normalize_recovery_context_paths

normalize_exhausted_luna_recovery_route()
{
	local requested_route requested_leaf luna_failures requested_exception tmp
	(( recovery_publish == 1 && manager_remediation == 0 )) || return 0
	# Exhausting a Luna strategy budget is evidence that the boundary needs a
	# smaller decomposition. It is model-escalation authority only under the
	# explicit legacy policy; luna_only must never rewrite the next child to
	# Terra, regardless of historical failure count.
	[[ "$HARNESS_MODEL_POLICY" != luna_only && "$HARNESS_ESCALATION_POLICY" == legacy ]] || return 0
	requested_route="$(metadata_value "$task_file" Worker-Route)"
	requested_leaf="$(metadata_value "$task_file" Leaf-Type)"
	[[ "$requested_route" == LUNA ]] || return 0
	luna_failures="$(root_luna_strategy_failure_count "$root")"
	luna_strategy_exhausted_coding_leaf "$luna_failures" \
		"$HARNESS_MAX_LUNA_STRATEGY_FAILURES" "$requested_leaf" || return 0
	requested_exception="$(metadata_value "$task_file" Terra-Exception)"
	[[ "$requested_exception" =~ ^(CONTRACT_DECISION|ARCHITECTURE_DECISION|CONCURRENCY_DESIGN|AMBIGUOUS_SPECIFICATION|UNEXPLAINED_INTEGRATION|IRREDUCIBLE_CROSS_BOUNDARY)$ ]] ||
		requested_exception=IRREDUCIBLE_CROSS_BOUNDARY
	tmp="$task_file.exhausted-luna-route.$$"
	HARNESS_NORMALIZED_TERRA_EXCEPTION="$requested_exception" awk -F': ' '
		BEGIN {seen_exception=0}
		$1 == "Worker-Route" {print "Worker-Route: TERRA"; next}
		$1 == "Complexity-Class" {print "Complexity-Class: HIGH"; next}
		$1 == "Terra-Exception" {
			print "Terra-Exception: " ENVIRON["HARNESS_NORMALIZED_TERRA_EXCEPTION"]
			seen_exception=1
			next
		}
		{print}
		END {
			if (!seen_exception)
				print "Terra-Exception: " ENVIRON["HARNESS_NORMALIZED_TERRA_EXCEPTION"]
		}
	' "$task_file" > "$tmp"
	chmod --reference="$task_file" "$tmp"
	mv "$tmp" "$task_file"
	measured_recovery_route_override=1
	log_event "RECOVERY_EXHAUSTED_LUNA_ROUTE_NORMALIZED root=$root task=$task_id leaf_type=$requested_leaf luna_failures=$luna_failures exception=$requested_exception"
}

normalize_exhausted_luna_recovery_route

enforce_revision_authority()
{
	local root_scope effective_root_scope root_architecture scope_override additional_scope reason="" category=IMMUTABLE_ROOT_AUTHORITY
	[[ "$task_id" != "$root" && -f "$root_assignment" ]] || return 0
	root_scope="$(metadata_value "$root_assignment" Allowed-Scope)"
	effective_root_scope="$root_scope"
	scope_override="$(task_root_architecture_scope_override_file "$root")"
	if (( manager_remediation == 1 )) && [[ -f "$scope_override" ]] &&
		[[ "$(kv_file_value "$scope_override" authorized_for 2>/dev/null || true)" == manager_remediation ]]; then
		additional_scope="$(kv_file_value "$scope_override" additional_scope 2>/dev/null || true)"
		[[ -z "$additional_scope" ]] || effective_root_scope="$root_scope,$additional_scope"
	fi
	root_architecture="$(metadata_value "$root_assignment" Architecture-Decisions)"
	# A zero-write root may need additional repository documents to diagnose or
	# attest its criterion. Those paths belong in Context-Paths, not in its write
	# authority. Preserve the immutable root Allowed-Scope deterministically so a
	# read-only remediation cannot accidentally manufacture either broader write
	# authority or a false architecture-reassessment pause.
	if [[ "$leaf_expected_files" == 0 && -n "$root_scope" ]] &&
		! scope_is_within_root_authority "$goal_allowed_scope" "$root_scope"; then
		log_event "READ_ONLY_REVISION_SCOPE_NORMALIZED root=$root task=$task_id requested=$(printf '%q' "$goal_allowed_scope") authority=$(printf '%q' "$root_scope")"
		goal_allowed_scope="$root_scope"
	fi
	if [[ -n "$root_scope" ]] && ! scope_is_within_root_authority "$goal_allowed_scope" "$effective_root_scope"; then
		reason="revision scope exceeds immutable root authority: root=[$root_scope] audited_additional=[${additional_scope:--}] revision=[$goal_allowed_scope]"
	elif [[ "$root_architecture" == NONE && "$leaf_architecture_decisions" != NONE ]]; then
		reason="revision introduces architecture decisions although the immutable root declares Architecture-Decisions: NONE"
	elif [[ -n "$root_architecture" && "$root_architecture" != NONE &&
		"$leaf_architecture_decisions" != NONE ]] &&
		! metadata_identifier_list_is_subset "$leaf_architecture_decisions" "$root_architecture"; then
		reason="revision introduces architecture authority not granted by the root: root=[$root_architecture] revision=[$leaf_architecture_decisions]"
	fi
	if [[ -n "$reason" ]]; then
		# Recovery publication is a bounded correction transaction. Reject the
		# first over-broad candidate without pausing the root so the same manager
		# turn can remove a misspelled build target, speculative context path, or
		# other candidate-local scope error. Persist architecture reassessment
		# only when the permitted correction repeats the expansion.
		if (( recovery_publish == 1 )) &&
			(( ${publish_attempts:-0} < ${max_publish_attempts:-$HARNESS_MAX_MANAGER_REPLAN_PUBLISH_ATTEMPTS} )); then
			log_event "RECOVERY_SCOPE_EXPANSION_REJECTED root=$root task=$task_id attempt=${publish_attempts:-0} reason=$(printf '%q' "$reason")"
			die "$reason; correct the recovery candidate within immutable authority and publish once more"
		fi
		if (( manager_remediation == 1 )); then
			category=MANAGER_REMEDIATION_SCOPE_EXPANSION
		fi
		mark_root_architecture_reassessment "$task_id" "$category" "$reason" \
			"root_assignment=$root_assignment candidate=$task_file" >/dev/null
		printf '%s\n' "$(task_root_architecture_reassessment_file "$root")"
		exit 6
	fi
}

goal_mode=0
goal_id=""
goal_target=""
goal_success_evidence=""
goal_focused_validation=""
goal_allowed_scope=""
goal_baseline_boundary=""
goal_hard_blocks=""
leaf_type=""
leaf_complexity=""
leaf_worker_route=""
leaf_depends_on=""
leaf_deliverable=""
leaf_required_symbols=""
leaf_context_paths=""
leaf_architecture_decisions=""
leaf_validation_class=""
leaf_planner_model="$(decomposition_provenance_value planner_model "$DECOMPOSITION_MODEL" 2>/dev/null || printf '%s' "$DECOMPOSITION_MODEL")"
leaf_planner_effort="$(decomposition_provenance_value planner_reasoning_effort "$DECOMPOSITION_REASONING_EFFORT" 2>/dev/null || printf '%s' "$DECOMPOSITION_REASONING_EFFORT")"
leaf_expected_files=""
leaf_expected_turns=""
