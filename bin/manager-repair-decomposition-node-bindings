#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

[[ $# -eq 1 ]] || { printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2; exit 2; }
load_harness_env "$1"
ensure_project
require_manager_configuration
project_plan_exists && { printf 'Decomposition DAG already exists.\n'; exit 0; }
decomposition_candidate_matches_current_inputs || die 'no current full decomposition candidate exists'
[[ "$(decomposition_candidate_state_value status)" == REJECTED ]] ||
	die 'node-binding repair requires a rejected candidate'

candidate_dir="$(decomposition_candidate_state_value directory)"
architecture_source="$(decomposition_candidate_state_value architecture_directory -)"
rejection_log="$(decomposition_candidate_state_value rejection_log "$candidate_dir/rejection.log")"
[[ "$architecture_source" != - && -d "$architecture_source" ]] ||
	die 'node-binding repair requires an architecture registry'
grep -Eq 'duplicate architecture node binding:' "$rejection_log" ||
	die 'candidate rejection is not a mechanically repairable duplicate node binding'

repair_dir="$PROJECT_TMP_DIR/decomposition-node-binding-repair-${candidate_dir##*/}"
rm -rf -- "$repair_dir"
mkdir -p "$repair_dir/architecture"
install -m 600 "$candidate_dir/dag.tsv" "$repair_dir/dag.tsv"
install -m 600 "$candidate_dir/coverage.tsv" "$repair_dir/coverage.tsv"
for name in invariants decisions edges health-gates debt; do
	install -m 600 "$architecture_source/$name.tsv" "$repair_dir/architecture/$name.tsv"
done

# Duplicate rows describe one node and therefore one authority closure. Merge
# each comma-separated binding column as an ordered set; never discard the
# richer row merely because a minimal binding appeared first.
awk -F '\t' -v OFS='\t' '
	function add_list(node, column, value,    count, values, i, item, key) {
		count=split(value, values, ",")
		for (i=1; i<=count; i++) {
			item=values[i]
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", item)
			if (item == "" || item == "-") continue
			key=node SUBSEP column SUBSEP item
			if (member[key]++) continue
			merged[node,column]=(merged[node,column] == "" ? item : merged[node,column] "," item)
		}
	}
	NR == 1 {header=$0; next}
	{
		node=$1
		if (!seen[node]++) order[++nodes]=node
		for (column=2; column<=6; column++) add_list(node, column, $column)
	}
	END {
		print header
		for (index=1; index<=nodes; index++) {
			node=order[index]
			printf "%s", node
			for (column=2; column<=6; column++)
				printf "%s%s", OFS, (merged[node,column] == "" ? "-" : merged[node,column])
			printf "\n"
		}
	}
' "$architecture_source/node-bindings.tsv" > "$repair_dir/architecture/node-bindings.tsv"
chmod 600 "$repair_dir/architecture/node-bindings.tsv"

set +e
"$HARNESS_BIN/manager-submit-decomposition" "$HARNESS_ENV_FILE" \
	"$repair_dir/dag.tsv" "$repair_dir/coverage.tsv" "$repair_dir/architecture"
status=$?
set -e
if project_plan_exists; then
	log_event "DECOMPOSITION_NODE_BINDINGS_REPAIRED source=$candidate_dir"
	printf 'Duplicate architecture node bindings merged and installed.\n'
	exit 0
fi
new_candidate_dir="$(decomposition_candidate_state_value directory -)"
if [[ "$new_candidate_dir" != - && "$new_candidate_dir" != "$candidate_dir" ]] &&
	decomposition_candidate_matches_current_inputs; then
	log_event "DECOMPOSITION_NODE_BINDINGS_PROGRESS previous=${candidate_dir##*/} current=${new_candidate_dir##*/} status=$(decomposition_candidate_state_value status -)"
	printf 'Duplicate architecture node bindings merged; continuing with the next bounded diagnostic.\n'
	exit 0
fi
(( status == 0 )) && die 'node-binding normalization returned success without installing or advancing the candidate'
die "node-binding normalization failed with status $status"
