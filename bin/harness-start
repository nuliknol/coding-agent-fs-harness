#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-mode.sh"
harness_dispatch_mode "$SCRIPT_DIR/.." "${0##*/}" "$@"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s [--background] [--force-decomposition] ENV_FILE\n' "${0##*/}" >&2
	exit 2
}

background=0
force_decomposition_requested=0
while (( $# > 0 )); do
	case "$1" in
		--background) background=1; shift ;;
		--force-decomposition) force_decomposition_requested=1; shift ;;
		-h|--help) usage ;;
		--) shift; break ;;
		-*) usage ;;
		*) break ;;
	esac
done
[[ $# -eq 1 ]] || usage
load_harness_env "$1"
ensure_project
require_goal_mode_clean_boundary
dir="$(project_dir)"

if (( background == 1 )); then
	if project_supervisors_running; then
		printf 'Harness supervisors already reference this environment; no background start was launched.\n'
		exit 0
	fi
	require_clean_repository_start_state
	if env_has_running_processes; then
		printf 'Active startup or agent processes still reference %s:\n' "$HARNESS_ENV_FILE" >&2
		env_process_lines >&2
		die 'refusing duplicate background harness-start while no project supervisor owns these processes'
	fi
	exec 8>"$dir/control/harness-start-background.lock"
	flock -x 8
	background_pid_file="$dir/control/harness-start-background.pid"
	if [[ -f "$background_pid_file" ]]; then
		background_pid="$(<"$background_pid_file")"
		if [[ "$background_pid" =~ ^[1-9][0-9]*$ ]] && kill -0 "$background_pid" 2>/dev/null; then
			die "background harness-start is already running with PID $background_pid"
		fi
		rm -f "$background_pid_file"
	fi
	background_stamp="$(timestamp_compact_utc)"
	background_log="$dir/logs/harness-start-$background_stamp.log"
	background_status="$dir/control/harness-start-background.status"
	background_started="$(timestamp_utc)"
	setsid "$HARNESS_HOME/lib/harness-start-background-runner" \
		"$HARNESS_BIN/harness-start" "$HARNESS_ENV_FILE" \
		"$background_pid_file" "$background_status" \
		"$background_log" "$background_started" "$force_decomposition_requested" </dev/null >> "$background_log" 2>&1 &
	background_pid=$!
	{
		printf 'state=RUNNING\n'
		printf 'pid=%s\n' "$background_pid"
		printf 'started_at=%s\n' "$background_started"
		printf 'finished_at=\n'
		printf 'exit_status=\n'
		printf 'log=%s\n' "$background_log"
	} > "$background_status.tmp.$$"
	chmod 600 "$background_status.tmp.$$"
	mv "$background_status.tmp.$$" "$background_status"
	printf '%s\n' "$background_pid" > "$background_pid_file.tmp.$$"
	chmod 600 "$background_pid_file.tmp.$$"
	mv "$background_pid_file.tmp.$$" "$background_pid_file"
	if ! kill -0 "$background_pid" 2>/dev/null; then
		background_state="$(kv_file_value "$background_status" state 2>/dev/null || true)"
		[[ -n "$background_state" && "$background_state" != RUNNING ]] ||
			die "background harness-start failed to detach; inspect $background_log"
	fi
	printf 'Harness start launched in background.\n'
	printf 'PID: %s\n' "$background_pid"
	printf 'Log: %s\n' "$background_log"
	printf 'Status: %s\n' "$background_status"
	printf 'The detached startup owns specification review, decomposition, bootstrap, and supervisor launch.\n'
	exit 0
fi

acquire_env_command_lock harness-start

supervisors_running=0
project_supervisors_running && supervisors_running=1
if (( supervisors_running == 0 )); then
	require_clean_repository_start_state
fi

if (( supervisors_running == 1 )); then
	printf 'Harness processes already reference this environment; preserving all state and progress.\n'
elif env_has_running_processes; then
	printf 'Active startup or agent processes still reference %s:\n' "$HARNESS_ENV_FILE" >&2
	env_process_lines >&2
	die 'refusing duplicate harness-start while no project supervisor owns these processes'
else
	"$HARNESS_BIN/harness-recover" "$HARNESS_ENV_FILE" --reset-orphaned
fi

# State produced by releases before 5.11 classified token circuit breakers as
# NEEDS_HUMAN. Convert only that exact legacy reason into the dedicated,
# evidence-preserving TOKEN_USAGE_ANOMALY interlock before any agent can launch.
"$HARNESS_BIN/harness-migrate-state" "$HARNESS_ENV_FILE" >/dev/null

# Record the operator's intent before any long planning/bootstrap call. If the
# machine dies during that first call, boot recovery can safely resume it.
if (( HARNESS_BOOT_RECOVERY == 1 )) && [[ "${HARNESS_AUTOSTART_INTERNAL:-0}" != 1 ]]; then
	"$HARNESS_BIN/harness-autostart" enable "$HARNESS_ENV_FILE"
fi

if specification_renormalization_stall_matches_current_inputs; then
	stall_report="$(kv_file_value "$(specification_renormalization_stall_file)" report)"
	die "specification normalization is durably stalled for unchanged inputs; inspect $stall_report"
fi

startup_budget_file=""
if ! project_plan_exists; then
	startup_budget_file="$dir/control/harness-start-agent-budget.env"
	{
		printf 'count=0\n'
		printf 'maximum=%s\n' "$HARNESS_START_MAX_AGENT_INVOCATIONS"
		printf 'started_at=%s\n' "$(timestamp_utc)"
	} > "$startup_budget_file"
	chmod 600 "$startup_budget_file"
	export HARNESS_START_AGENT_BUDGET_FILE="$startup_budget_file"
fi

renormalizations=0
while ! project_plan_exists; do
	if (( HARNESS_SPECIFICATION_REVIEW_ENABLED == 1 )); then
		"$HARNESS_BIN/manager-review-specification" "$HARNESS_ENV_FILE" >/dev/null
		if specification_review_requires_clarification; then
			printf 'Specification clarification required: %s\n' "$(specification_review_report_relative_path)"
			exit 3
		fi
		specification_review_is_accepted || die 'specification review did not establish an acceptance decision'
		printf 'Specification accepted: %s\n' "$(specification_review_report_relative_path)"
	fi

	if architecture_redesign_requires_action; then
		if (( force_decomposition_requested == 1 )); then
			architecture_redesign_record_force_waiver
			export HARNESS_FORCE_DECOMPOSITION=1
			printf 'Architecture redesign finding retained under an auditable force-decomposition waiver: %s\n' \
				"$(architecture_redesign_report_relative_path)"
		else
			printf 'Architecture redesign required: %s\n' "$(architecture_redesign_report_relative_path)"
			printf 'Action request: harness-show-redesign-request %s\n' "$HARNESS_ENV_FILE"
			exit 6
		fi
	elif architecture_redesign_force_matches_current_inputs; then
		export HARNESS_FORCE_DECOMPOSITION=1
	fi

	if (( HARNESS_DECOMPOSITION_V2 == 1 && HARNESS_DECOMPOSITION_CRITIC_ENABLED == 1 )); then
		if decomposition_candidate_matches_current_inputs &&
			[[ "$(decomposition_candidate_state_value status)" == STAGED ]]; then
			printf 'Recovering a durably staged decomposition candidate before launching another Sol turn.\n'
			if "$HARNESS_BIN/manager-submit-decomposition" --recover "$HARNESS_ENV_FILE"; then
				continue
			fi
		fi
		if decomposition_candidate_matches_current_inputs &&
			[[ "$(decomposition_candidate_state_value status)" == REJECTED ]]; then
			full_rejection_log="$(decomposition_candidate_state_value rejection_log "$(decomposition_candidate_state_value directory)/rejection.log")"
			if [[ -f "$full_rejection_log" ]] &&
				grep -Eq 'invalid invariant severity|invariant .* has empty required fields|invalid invariant validation_kind' "$full_rejection_log"; then
				printf 'Normalizing mechanical architecture severity aliases without an agent turn.\n'
				if "$HARNESS_BIN/manager-repair-decomposition-schema" "$HARNESS_ENV_FILE"; then
					continue
				fi
			fi
			if [[ -f "$full_rejection_log" ]] &&
				grep -Eq 'accepted decision .* lacks repository evidence|accepted decision .* evidence is not committed at HEAD' "$full_rejection_log"; then
				printf 'Normalizing mechanical architecture decision evidence without an agent turn.\n'
				if "$HARNESS_BIN/manager-repair-decomposition-decision-evidence" "$HARNESS_ENV_FILE"; then
					continue
				fi
			fi
			if [[ -f "$full_rejection_log" ]] &&
				grep -Eq 'invalid health gate|health gate .* (cannot depend on its own trigger node|is bound to node .* but declares trigger node|depends on unknown node|is absent from trigger binding)' "$full_rejection_log"; then
				printf 'Normalizing mechanical architecture health-gate bindings without an agent turn.\n'
				if "$HARNESS_BIN/manager-repair-decomposition-health-gates" "$HARNESS_ENV_FILE"; then
					continue
				fi
			fi
			if [[ -f "$full_rejection_log" ]] &&
				grep -Eq 'duplicate architecture node binding:' "$full_rejection_log"; then
				printf 'Merging duplicate architecture node bindings without an agent turn.\n'
				if "$HARNESS_BIN/manager-repair-decomposition-node-bindings" "$HARNESS_ENV_FILE"; then
					continue
				fi
			fi
			if [[ -f "$full_rejection_log" ]] &&
				grep -Eq 'dependency must precede node|parent must precede child' "$full_rejection_log"; then
				printf 'Topologically reordering the decomposition DAG without an agent turn.\n'
				if "$HARNESS_BIN/manager-repair-decomposition-order" "$HARNESS_ENV_FILE"; then
					continue
				fi
			fi
			if [[ -f "$full_rejection_log" ]] &&
				grep -Eq 'consumer .* must directly depend on producer' "$full_rejection_log"; then
				printf 'Repairing mechanical architecture producer/consumer links without an agent turn.\n'
				if "$HARNESS_BIN/manager-repair-decomposition-links" "$HARNESS_ENV_FILE"; then
					continue
				fi
			fi
			if [[ -f "$full_rejection_log" ]] &&
				grep -Eq 'coverage violates (DEPENDS_ON|REQUIRES_ACCEPTED) relation' "$full_rejection_log"; then
				printf 'Repairing mechanical typed dependency relations without an agent turn.\n'
				if "$HARNESS_BIN/manager-repair-decomposition-relations" --full "$HARNESS_ENV_FILE"; then
					continue
				fi
			fi
			# A changed candidate hash is not progress when the deterministic
			# validator reports the same defect again. Stop before another Sol
			# turn after two consecutive identical diagnostic fingerprints.
			diagnostic_fingerprint="$(grep '^ERROR:' "$full_rejection_log" | sha256sum | awk '{print $1}')"
			diagnostic_state="$dir/control/decomposition-repair-diagnostic.env"
			previous_fingerprint=""
			previous_count=0
			if [[ -f "$diagnostic_state" ]]; then
				previous_fingerprint="$(kv_file_value "$diagnostic_state" fingerprint)"
				previous_count="$(kv_file_value "$diagnostic_state" count)"
			fi
			[[ "$previous_count" =~ ^[0-9]+$ ]] || previous_count=0
			if [[ "$diagnostic_fingerprint" == "$previous_fingerprint" ]]; then
				diagnostic_count=$((previous_count + 1))
			else
				diagnostic_count=1
			fi
			{
				printf 'fingerprint=%s\n' "$diagnostic_fingerprint"
				printf 'count=%s\n' "$diagnostic_count"
				printf 'candidate=%s\n' "$(decomposition_candidate_state_value directory)"
				printf 'updated_at=%s\n' "$(timestamp_utc)"
			} > "$diagnostic_state.tmp.$$"
			chmod 600 "$diagnostic_state.tmp.$$"
			mv "$diagnostic_state.tmp.$$" "$diagnostic_state"
			(( diagnostic_count < 2 )) ||
				die "decomposition repair diagnostic repeated without deterministic progress ($diagnostic_count): $full_rejection_log"
			printf 'Repairing the durably rejected decomposition candidate before launching another global Sol turn.\n'
			"$HARNESS_BIN/manager-decomposition-repair" "$HARNESS_ENV_FILE"
			continue
		fi
		if decomposition_dag_candidate_matches_current_inputs &&
			[[ "$(decomposition_dag_candidate_state_value status)" == REJECTED ]]; then
			dag_rejection_log="$(decomposition_dag_candidate_state_value rejection_log "$(decomposition_dag_candidate_state_value directory)/rejection.log")"
			if [[ -f "$dag_rejection_log" ]] &&
				grep -Eq 'coverage violates (DEPENDS_ON|REQUIRES_ACCEPTED) relation' "$dag_rejection_log"; then
				printf 'Repairing mechanical typed dependency relations without an agent turn.\n'
				if "$HARNESS_BIN/manager-repair-decomposition-relations" "$HARNESS_ENV_FILE"; then
					continue
				fi
			fi
			printf 'Repairing the durably rejected DAG/coverage candidate before another global Sol turn.\n'
			"$HARNESS_BIN/manager-decomposition-dag-repair" "$HARNESS_ENV_FILE"
			continue
		fi
		if decomposition_dag_candidate_matches_current_inputs &&
			[[ "$(decomposition_dag_candidate_state_value status)" == STAGED ]]; then
			printf 'Binding architecture to the durably staged DAG in a fresh Sol turn.\n'
			"$HARNESS_BIN/manager-architecture-binding-critic" "$HARNESS_ENV_FILE"
			continue
		fi

		if (( HARNESS_SPECIFICATION_REVIEW_ENABLED == 1 )); then
			set +e
			"$HARNESS_BIN/manager-architecture-fit-critic" "$HARNESS_ENV_FILE"
			fit_status=$?
			set -e
			case "$fit_status" in
			0) ;;
			3)
				printf 'Specification clarification required: %s\n' "$(specification_review_report_relative_path)"
				exit 3
				;;
			4)
				(( renormalizations < HARNESS_MAX_SPECIFICATION_RENORMALIZATIONS )) ||
					die 'architecture-fit critic exceeded the configured specification IR renormalization limit'
				renormalizations=$((renormalizations + 1))
				printf 'Regenerating normalized specification IR after architecture-fit challenge.\n'
				continue
				;;
			5)
				stall_report="$(kv_file_value "$(specification_renormalization_stall_file)" report 2>/dev/null || true)"
				die "specification normalization stalled without convergence; inspect ${stall_report:-the architecture-fit critic logs}"
				;;
			6)
				if (( force_decomposition_requested == 1 )); then
					architecture_redesign_record_force_waiver
					export HARNESS_FORCE_DECOMPOSITION=1
					printf 'Architecture redesign finding force-authorized; continuing with prerequisite remediation decomposition.\n'
				else
					printf 'Architecture redesign required: %s\n' "$(architecture_redesign_report_relative_path)"
					printf 'Action request: harness-show-redesign-request %s\n' "$HARNESS_ENV_FILE"
					exit 6
				fi
				;;
				*) exit "$fit_status" ;;
			esac
		fi

		set +e
		"$HARNESS_BIN/manager-decomposition-critic" "$HARNESS_ENV_FILE"
		critic_status=$?
		set -e
		case "$critic_status" in
			0) ;;
			3)
				printf 'Specification clarification required: %s\n' "$(specification_review_report_relative_path)"
				exit 3
				;;
			4)
				(( renormalizations < HARNESS_MAX_SPECIFICATION_RENORMALIZATIONS )) ||
					die 'decomposition critic exceeded the configured specification IR renormalization limit'
				renormalizations=$((renormalizations + 1))
				printf 'Regenerating normalized specification IR after independent critic challenge.\n'
				continue
				;;
			5)
				stall_report="$(kv_file_value "$(specification_renormalization_stall_file)" report 2>/dev/null || true)"
				die "specification normalization stalled without convergence; inspect ${stall_report:-the decomposition critic logs}"
				;;
			6)
				if (( force_decomposition_requested == 1 )); then
					architecture_redesign_record_force_waiver
					export HARNESS_FORCE_DECOMPOSITION=1
					printf 'Architecture redesign finding force-authorized; rerunning Sol to create prerequisite remediation nodes.\n'
					continue
				fi
				printf 'Architecture redesign required: %s\n' "$(architecture_redesign_report_relative_path)"
				printf 'Action request: harness-show-redesign-request %s\n' "$HARNESS_ENV_FILE"
				exit 6
				;;
			*) exit "$critic_status" ;;
		esac
		if decomposition_dag_candidate_matches_current_inputs &&
			[[ "$(decomposition_dag_candidate_state_value status)" == STAGED ]]; then
			continue
		fi
	fi
	break
done

require_registered_specification_ir

# Architecture registries are persistent project state. Revalidate them on
# every start so projects created by an older harness cannot launch agents with
# a graph that newer invariants reject (for example, a self-dependent health
# gate). Initialization already validates new registries; this closes the
# migration/restart gap for existing ones.
if (( HARNESS_ARCHITECTURE_GUARDS == 1 )) && project_plan_exists; then
	architecture_validate_against_plan
	log_event "ARCHITECTURE_STARTUP_VALIDATED directory=$(architecture_dir)"
fi

# Bootstrap before starting the worker watcher so a newly published first task
# cannot finish before the manager thread ID has been registered.
if [[ ! -f "$dir/control/manager.thread" ]]; then
	"$HARNESS_BIN/manager-bootstrap" "$HARNESS_ENV_FILE"
else
	printf 'Manager thread already exists; bootstrap was not repeated.\n'
fi

# Runtime supervisors must not inherit the bounded startup transaction.
if [[ -n "$startup_budget_file" ]]; then
	rm -f "$startup_budget_file" "$startup_budget_file.lock"
	unset HARNESS_START_AGENT_BUDGET_FILE
fi

"$HARNESS_BIN/manager-supervisor-start" "$HARNESS_ENV_FILE"
"$HARNESS_BIN/worker-supervisor-start" "$HARNESS_ENV_FILE"

printf '\nHarness is active.\n'
printf 'Manager watcher: %s\n' "$dir/logs/supervisor.log"
printf 'Worker watcher: %s\n' "$dir/logs/worker-supervisor.log"
printf 'Events: %s\n' "$dir/logs/events.log"
