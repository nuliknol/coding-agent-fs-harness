#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"
[[ $# -eq 1 ]] || die "Usage: ${0##*/} ENV_FILE"
load_harness_env "$1"
ensure_project
status="$(state_value status)"
phase="$(state_value phase)"
cycle="$(state_value cycle)"
if [[ "$status" == COMPLETE ]]; then
	printf 'Project is already complete; final acceptance: %s\n' \
		"$(project_dir)/control/final-acceptance.md"
	exit 0
fi
if [[ "$status" == PAUSED && "$phase" == ORACLE_LIMIT_REACHED ]]; then
	completed_oracle_runs="$(oracle_audit_run_count)"
	if (( MAX_ORACLE_RUNS > completed_oracle_runs )); then
		write_state ACTIVE ORACLE_REQUIRED "$cycle"
		log_event "ORACLE_LIMIT_RESUMED cycle=$cycle completed_runs=$completed_oracle_runs new_limit=$MAX_ORACLE_RUNS"
	else
		printf 'Project remains paused after %s Oracle runs. Increase MAX_ORACLE_RUNS above %s.\n' \
			"$completed_oracle_runs" "$completed_oracle_runs"
		exit 0
	fi
fi
if [[ "$status" == FAILED ]]; then
	die "project is in TERMINAL_FAILURE; inspect $(project_dir)/control/last-error.txt"
fi
if [[ "$status" == PAUSED && "$phase" == REVIEW_LIMIT_REACHED ]]; then
	if (( HARNESS_MAX_MANAGER_REVIEWS == 0 ||
		HARNESS_MAX_MANAGER_REVIEWS > cycle )); then
		write_state ACTIVE WORKER_REQUIRED "$cycle"
		log_event "REVIEW_LIMIT_RESUMED cycle=$cycle new_limit=$HARNESS_MAX_MANAGER_REVIEWS"
	else
		printf 'Project remains paused at review limit %s. Increase HARNESS_MAX_MANAGER_REVIEWS or set it to 0.\n' \
			"$HARNESS_MAX_MANAGER_REVIEWS"
		exit 0
	fi
fi
if [[ "$status" == PAUSED && "$phase" == NEEDS_OPERATOR ]]; then
	printf 'Project needs operator input; inspect %s\n' \
		"$(project_dir)/control/operator-required.md"
	exit 0
fi
"$HARNESS_BIN/harness-supervisor-start" "$HARNESS_ENV_FILE"
printf 'Events: %s\n' "$(events_file)"
