#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"
[[ $# -eq 1 ]] || die "Usage: ${0##*/} ENV_FILE"
load_harness_env "$1"
ensure_project
status="$(state_value status)"
phase="$(state_value phase)"
cycle="$(state_value cycle)"
if [[ "$status" == COMPLETE ]]; then
	printf 'Project is already complete; final acceptance: %s\n' \
		"$(project_dir)/control/final-acceptance.md"
	exit 0
fi
if [[ "$status" == PAUSED && "$phase" == ORACLE_LIMIT_REACHED ]]; then
	completed_oracle_runs="$(oracle_audit_run_count)"
	if (( MAX_ORACLE_RUNS > completed_oracle_runs )); then
		write_state ACTIVE ORACLE_REQUIRED "$cycle"
		log_event "ORACLE_LIMIT_RESUMED cycle=$cycle completed_runs=$completed_oracle_runs new_limit=$MAX_ORACLE_RUNS"
	else
		printf 'Project remains paused after %s Oracle runs. Increase MAX_ORACLE_RUNS above %s.\n' \
			"$completed_oracle_runs" "$completed_oracle_runs"
		exit 0
	fi
fi
if [[ "$status" == FAILED ]]; then
	die "project is in TERMINAL_FAILURE; inspect $(project_dir)/control/last-error.txt"
fi
if [[ "$status" == PAUSED && "$phase" == REVIEW_LIMIT_REACHED ]]; then
	if (( HARNESS_MAX_MANAGER_REVIEWS == 0 ||
		HARNESS_MAX_MANAGER_REVIEWS > cycle )); then
		# Terra already published this cycle's addendum before the emergency
		# review limit paused the loop, so resume by returning it to Luna.
		write_state ACTIVE WORKER_REQUIRED "$cycle"
		log_event "REVIEW_LIMIT_RESUMED cycle=$cycle new_limit=$HARNESS_MAX_MANAGER_REVIEWS"
	else
		printf 'Project remains paused at review limit %s. Increase HARNESS_MAX_MANAGER_REVIEWS or set it to 0.\n' \
			"$HARNESS_MAX_MANAGER_REVIEWS"
		exit 0
	fi
fi
if [[ "$status" == PAUSED && "$phase" == NO_SOURCE_PROGRESS ]]; then
	pause_fingerprint="$(awk 'NR == 1 { print; exit }' \
		"$(project_dir)/control/operator-pause-fingerprint" 2>/dev/null || true)"
	pause_count="$(awk 'NR == 1 { print; exit }' \
		"$(project_dir)/control/operator-pause-count" 2>/dev/null || true)"
	current_fingerprint="$(repository_worktree_fingerprint)"
	[[ "$pause_count" =~ ^[0-9]+$ ]] || pause_count=0
	if [[ "$current_fingerprint" != "$pause_fingerprint" ]] ||
		(( HARNESS_MAX_NO_SOURCE_PROGRESS_REVIEWS == 0 ||
		HARNESS_MAX_NO_SOURCE_PROGRESS_REVIEWS > pause_count )); then
		if [[ "$current_fingerprint" != "$pause_fingerprint" ]]; then
			printf '0\n' > "$(project_dir)/control/no-source-progress-count"
			chmod 600 "$(project_dir)/control/no-source-progress-count"
		fi
		if [[ -f "$(project_dir)/control/operator-required.md" ]]; then
			mv "$(project_dir)/control/operator-required.md" \
				"$(project_dir)/reviews/operator-pause-no-source-progress-${cycle}-${pause_count}.md"
		fi
		rm -f "$(project_dir)/control/operator-pause-kind" \
			"$(project_dir)/control/operator-pause-fingerprint" \
			"$(project_dir)/control/operator-pause-count"
		# Luna already delivered this cycle; the circuit breaker paused before
		# Terra reviewed it. Preserve that work and resume at the pending review.
		write_state ACTIVE REVIEW_REQUIRED "$cycle"
		log_event "NO_SOURCE_PROGRESS_RESUMED cycle=$cycle previous_count=$pause_count new_limit=$HARNESS_MAX_NO_SOURCE_PROGRESS_REVIEWS repository_changed=$([[ "$current_fingerprint" != "$pause_fingerprint" ]] && printf 1 || printf 0)"
	else
		printf 'Project remains paused after %s unchanged worker deliveries. Change the repository or raise HARNESS_MAX_NO_SOURCE_PROGRESS_REVIEWS above %s.\n' \
			"$pause_count" "$pause_count"
		exit 0
	fi
fi
if [[ "$status" == PAUSED && "$phase" == CONVERGENCE_LIMIT_REACHED ]]; then
	pause_fingerprint="$(awk 'NR == 1 { print; exit }' \
		"$(project_dir)/control/operator-pause-fingerprint" 2>/dev/null || true)"
	pause_count="$(awk 'NR == 1 { print; exit }' \
		"$(project_dir)/control/operator-pause-count" 2>/dev/null || true)"
	current_fingerprint="$(repository_worktree_fingerprint)"
	[[ "$pause_count" =~ ^[0-9]+$ ]] || pause_count=0
	if [[ "$current_fingerprint" != "$pause_fingerprint" ]] ||
		(( HARNESS_MAX_REPEATED_CONVERGENCE_AUDITS == 0 ||
		HARNESS_MAX_REPEATED_CONVERGENCE_AUDITS > pause_count )); then
		printf '%s\n' "$cycle" > \
			"$(project_dir)/control/convergence-circuit-reset-cycle"
		chmod 600 "$(project_dir)/control/convergence-circuit-reset-cycle"
		if [[ -f "$(project_dir)/control/operator-required.md" ]]; then
			mv "$(project_dir)/control/operator-required.md" \
				"$(project_dir)/reviews/operator-pause-convergence-${cycle}-${pause_count}.md"
		fi
		rm -f "$(project_dir)/control/operator-pause-kind" \
			"$(project_dir)/control/operator-pause-fingerprint" \
			"$(project_dir)/control/operator-pause-count"
		write_state ACTIVE WORKER_REQUIRED "$cycle"
		log_event "CONVERGENCE_LIMIT_RESUMED cycle=$cycle previous_count=$pause_count new_limit=$HARNESS_MAX_REPEATED_CONVERGENCE_AUDITS repository_changed=$([[ "$current_fingerprint" != "$pause_fingerprint" ]] && printf 1 || printf 0)"
	else
		printf 'Project remains paused after %s repeated convergence audits. Change the repository or raise HARNESS_MAX_REPEATED_CONVERGENCE_AUDITS above %s.\n' \
			"$pause_count" "$pause_count"
		exit 0
	fi
fi
if [[ "$status" == PAUSED && "$phase" == NEEDS_OPERATOR ]]; then
	printf 'Project needs operator input; inspect %s\n' \
		"$(project_dir)/control/operator-required.md"
	exit 0
fi
"$HARNESS_BIN/harness-supervisor-start" "$HARNESS_ENV_FILE"
printf 'Events: %s\n' "$(events_file)"
