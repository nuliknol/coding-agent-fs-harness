#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 1 ]] || usage
load_harness_env "$1"
ensure_project
acquire_project_lock
migrated="$(migrate_legacy_token_limit_human_markers)"
printf 'Legacy token-limit markers migrated: %s\n' "$migrated"

if [[ "$HARNESS_MODEL_POLICY" == luna_only ]]; then
	dir="$(project_dir)"
	for supervisor_file in "$dir/control/supervisor.pid" "$dir/control/worker-supervisor.pid"; do
		if [[ -f "$supervisor_file" ]]; then
			supervisor_pid="$(cat "$supervisor_file" 2>/dev/null || true)"
			if [[ "$supervisor_pid" =~ ^[0-9]+$ ]] && kill -0 "$supervisor_pid" 2>/dev/null; then
				die "stop project supervisors before Luna-only migration: $supervisor_file"
			fi
		fi
	done
	if compgen -G "$dir/running/$PROJECT-task-*.running.md" >/dev/null; then
		die 'Luna-only migration requires a safe task boundary; a worker assignment is still running'
	fi
	migrated_results=0
	shopt -s nullglob
	for result in "$dir/results/$PROJECT-task-"*.result.md; do
		task_id="$(task_id_from_filename "$result")"
		base="$(task_base "$task_id")"
		assignment="$dir/archive/$base.assignment.md"
		if ! assignment_is_manager_remediation "$assignment"; then
			continue
		fi
		root="$(task_root_id "$task_id")"
		archive="$dir/archive/$base.policy-migration-result.md"
		[[ ! -e "$archive" ]] ||
			die "migration result archive already exists: $archive"
		mv "$result" "$archive"
		chmod 600 "$archive"
		: > "$dir/control/$base.policy-migrated"
		chmod 600 "$dir/control/$base.policy-migrated"
		: > "$dir/control/$base.recovery-retired"
		chmod 600 "$dir/control/$base.recovery-retired"
		mark_root_needs_replan "$task_id" \
			"The unreviewed result came from a pre-policy manager-remediation assignment. Retain its workspace delta only as unaccepted tracked-overlay evidence, then verify it through closed Luna-sized child criteria." \
			LUNA_ONLY_POLICY_MIGRATION >/dev/null
		clear_worker_thread_for_root "$root" luna-only-policy-migration
		rm -f \
			"$dir/control/$base.reviewed-event" \
			"$dir/control/$base.manager-review-stalled.md" \
			"$dir/control/$base.manager-failed.md"
		log_event "LUNA_ONLY_PENDING_RESULT_MIGRATED task=$task_id root=$root archive=$archive evidence_status=UNACCEPTED"
		migrated_results=$((migrated_results + 1))
	done
	shopt -u nullglob
	migrated_ready=0
	shopt -s nullglob
	for ready in "$dir/tasks/$PROJECT-task-"*.ready.md; do
		task_id="$(task_id_from_filename "$ready")"
		route="$(metadata_value "$ready" Worker-Route)"
		if [[ "$route" != TERRA ]] && ! assignment_is_manager_remediation "$ready"; then
			continue
		fi
		root="$(task_root_id "$task_id")"
		archive="$dir/archive/$(task_base "$task_id").assignment.md"
		[[ ! -e "$archive" ]] || die "migration archive already exists: $archive"
		mv "$ready" "$archive"
		chmod 600 "$archive"
		: > "$dir/control/$(task_base "$task_id").policy-migrated"
		chmod 600 "$dir/control/$(task_base "$task_id").policy-migrated"
		: > "$dir/control/$(task_base "$task_id").recovery-retired"
		chmod 600 "$dir/control/$(task_base "$task_id").recovery-retired"
		mark_root_needs_replan "$task_id" \
			"The installed assignment used a pre-policy Terra/manager route. Preserve its root authority and verified checkpoints, then split the first unmet criterion into Luna-sized children." \
			LUNA_ONLY_POLICY_MIGRATION >/dev/null
		clear_worker_thread_for_root "$root" luna-only-policy-migration
		log_event "LUNA_ONLY_READY_TASK_MIGRATED task=$task_id root=$root previous_route=${route:--} archive=$archive"
		migrated_ready=$((migrated_ready + 1))
	done
	shopt -u nullglob
	migrated_liveness=0
	# Pre-policy supervisors may have exhausted a broad root by repeatedly
	# replanning the same acceptance boundary. Luna-only migration changes that
	# boundary only through mandatory append-only child criteria. Preserve the
	# historical marker and counters, then authorize one child-boundary liveness
	# epoch so the new compiler can make progress without raising global limits.
	shopt -s nullglob
	for reassessment in "$dir/control/progress/$PROJECT-task-"*.architecture-reassessment-required.md; do
		[[ -f "$reassessment" ]] || continue
		category="$(metadata_value "$reassessment" Category)"
		case "$category" in
			NO_CRITERION_PROGRESS|TOTAL_ROOT_REVIEWS|TOTAL_ROOT_REPLANS|ROOT_LIFETIME|ROOT_TOKENS) ;;
			*) continue ;;
		esac
		root="$(metadata_value "$reassessment" Task-Root)"
		trigger="$(metadata_value "$reassessment" Triggered-By)"
		validate_task_id "$root"
		[[ "$(task_root_id "$root")" == "$root" ]] ||
			die "invalid root in Luna-only liveness migration marker: $reassessment"
		[[ -n "$trigger" ]] || trigger="$root"
		live_root_artifact=0
		for artifact in "$dir/tasks/$PROJECT-task-"*.ready.md \
			"$dir/running/$PROJECT-task-"*.running.md \
			"$dir/results/$PROJECT-task-"*.result.md; do
			[[ -f "$artifact" ]] || continue
			artifact_task="$(task_id_from_filename "$artifact")"
			if [[ "$(task_root_id "$artifact_task")" == "$root" ]]; then
				live_root_artifact=1
				break
			fi
		done
		(( live_root_artifact == 0 )) ||
			die "Luna-only liveness migration found a live task/result for paused root $root"
		record_root_liveness_epoch "$root" luna-only-policy-migration
		mark_root_needs_replan "$trigger" \
			"The legacy broad acceptance boundary exhausted its monotonic liveness budget. Preserve all evidence and replace only the first unmet boundary with at least two ordered Luna-sized child criteria." \
			LUNA_ONLY_POLICY_MIGRATION >/dev/null
		clear_worker_thread_for_root "$root" luna-only-liveness-migration
		archive_dir="$dir/archive/luna-only-migrations"
		mkdir -p "$archive_dir"
		chmod 700 "$archive_dir"
		archive="$archive_dir/${reassessment##*/}.$(timestamp_compact_utc).migrated"
		mv "$reassessment" "$archive"
		chmod 600 "$archive"
		log_event "LUNA_ONLY_LIVENESS_BOUNDARY_MIGRATED root=$root trigger=$trigger category=$category archive=$archive epoch=$(task_root_liveness_epoch_file "$root")"
		migrated_liveness=$((migrated_liveness + 1))
	done
	shopt -u nullglob
	pending_terra=0
	if project_plan_uses_dag; then
		pending_terra="$(awk -F '\t' 'NR>1 && $11=="TERRA" {count++} END {print count+0}' "$(project_decomposition_plan_file)")"
	fi
	migration_state="$dir/control/luna-only-migration.env"
	{
		printf 'status=READY\n'
		printf 'migrated_pending_results=%s\n' "$migrated_results"
		printf 'migrated_ready_tasks=%s\n' "$migrated_ready"
		printf 'migrated_liveness_roots=%s\n' "$migrated_liveness"
		printf 'installed_terra_nodes=%s\n' "$pending_terra"
		printf 'pending_node_policy=recursive_root_criteria\n'
		printf 'migrated_at=%s\n' "$(timestamp_utc)"
	} > "$migration_state.tmp.$$"
	chmod 600 "$migration_state.tmp.$$"
	mv "$migration_state.tmp.$$" "$migration_state"
	log_event "LUNA_ONLY_STATE_MIGRATION_READY migrated_results=$migrated_results migrated_ready=$migrated_ready installed_terra_nodes=$pending_terra state=$migration_state"
	printf 'Luna-only state migration: pending-results=%s ready-tasks=%s liveness-roots=%s installed-Terra-nodes=%s (decomposed in place at activation)\n' \
		"$migrated_results" "$migrated_ready" "$migrated_liveness" "$pending_terra"
fi
