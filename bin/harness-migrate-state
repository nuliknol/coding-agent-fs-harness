#!/usr/bin/env bash

set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/harness-common.sh"

usage()
{
	printf 'Usage: %s ENV_FILE\n' "${0##*/}" >&2
	exit 2
}

[[ $# -eq 1 ]] || usage
load_harness_env "$1"
ensure_project
acquire_project_lock
migrated="$(migrate_legacy_token_limit_human_markers)"
printf 'Legacy token-limit markers migrated: %s\n' "$migrated"

if [[ "$HARNESS_MODEL_POLICY" == luna_only ]]; then
	luna_only_assignment_is_executable()
	{
		local assignment="$1" route leaf complexity exception validation files turns actions p95 score
		route="$(metadata_value "$assignment" Worker-Route)"
		[[ "$route" == LUNA ]] || return 1
		assignment_is_manager_remediation "$assignment" || return 0
		# Manager-Remediation is an authority classification, not a model route.
		# Under luna_only worker-invoke-task executes it through the configured
		# Luna binary/model. Preserve a publisher-validated bounded assignment;
		# only legacy broad/incomplete remediation metadata needs migration.
		leaf="$(metadata_value "$assignment" Leaf-Type)"
		complexity="$(metadata_value "$assignment" Complexity-Class)"
		exception="$(metadata_value "$assignment" Terra-Exception)"
		validation="$(metadata_value "$assignment" Validation-Class)"
		files="$(metadata_value "$assignment" Expected-Max-Implementation-Files)"
		turns="$(metadata_value "$assignment" Expected-Max-Worker-Turns)"
		actions="$(metadata_value "$assignment" Expected-Max-Agent-Actions)"
		p95="$(metadata_value "$assignment" Effective-P95-Tokens)"
		score="$(metadata_value "$assignment" Complexity-Score)"
		[[ "$leaf" =~ ^(LOCAL_IMPLEMENTATION|TEST_IMPLEMENTATION|MECHANICAL_API|FOCUSED_BUG|DOCUMENTATION|VERIFICATION_ONLY)$ ]] || return 1
		[[ "$complexity" == LOW && "$exception" == - && "$validation" != CLEAN_GLOBAL ]] || return 1
		[[ "$files" =~ ^[0-9]+$ && "$turns" =~ ^[1-9][0-9]*$ ]] || return 1
		(( files <= HARNESS_MAX_LUNA_IMPLEMENTATION_FILES && turns <= 3 )) || return 1
		[[ "$actions" =~ ^[1-9][0-9]*$ && "$p95" =~ ^[1-9][0-9]*$ && "$score" =~ ^[1-9][0-9]*$ ]] || return 1
		(( actions <= HARNESS_MAX_LUNA_PREDICTED_ACTIONS &&
			p95 <= HARNESS_MAX_LUNA_PREDICTED_P95_TOKENS &&
			score <= HARNESS_MAX_LUNA_COMPLEXITY_SCORE )) || return 1
		return 0
	}

	dir="$(project_dir)"
	for supervisor_file in "$dir/control/supervisor.pid" "$dir/control/worker-supervisor.pid"; do
		if [[ -f "$supervisor_file" ]]; then
			supervisor_pid="$(cat "$supervisor_file" 2>/dev/null || true)"
			if [[ "$supervisor_pid" =~ ^[0-9]+$ ]] && kill -0 "$supervisor_pid" 2>/dev/null; then
				die "stop project supervisors before Luna-only migration: $supervisor_file"
			fi
		fi
	done
	if compgen -G "$dir/running/$PROJECT-task-*.running.md" >/dev/null; then
		die 'Luna-only migration requires a safe task boundary; a worker assignment is still running'
	fi
	restored_safe_remediations=0
	shopt -s nullglob
	for migrated_marker in "$dir/control/$PROJECT-task-"*.policy-migrated; do
		base="${migrated_marker##*/}"
		base="${base%.policy-migrated}"
		task_id="${base#"$PROJECT-task-"}"
		validate_task_id "$task_id"
		assignment="$dir/archive/$base.assignment.md"
		[[ -f "$assignment" ]] || continue
		assignment_is_manager_remediation "$assignment" || continue
		luna_only_assignment_is_executable "$assignment" || continue
		root="$(task_root_id "$task_id")"
		replan_marker="$(task_root_replan_file "$root")"
		[[ -f "$replan_marker" ]] || continue
		[[ "$(metadata_value "$replan_marker" Trigger-Outcome)" == LUNA_ONLY_POLICY_MIGRATION ]] || continue
		[[ "$(metadata_value "$replan_marker" Triggered-By)" == "$task_id" ]] || continue
		active_root_artifact=0
		for artifact in "$dir/tasks/$PROJECT-task-"*.ready.md \
			"$dir/results/$PROJECT-task-"*.result.md; do
			[[ -f "$artifact" ]] || continue
			artifact_task="$(task_id_from_filename "$artifact")"
			if [[ "$(task_root_id "$artifact_task")" == "$root" ]]; then
				active_root_artifact=1
				break
			fi
		done
		(( active_root_artifact == 0 )) || continue
		ready="$dir/tasks/$base.ready.md"
		mv "$assignment" "$ready"
		chmod 600 "$ready"
		rm -f "$migrated_marker" "$dir/control/$base.recovery-retired" "$replan_marker"
		if [[ -f "$(goal_state_file "$task_id")" ]]; then
			goal_state_set "$(goal_state_file "$task_id")" state READY
			goal_state_set "$(goal_state_file "$task_id")" active_session ""
			goal_state_set "$(goal_state_file "$task_id")" thread_id ""
			goal_state_set "$(goal_state_file "$task_id")" thread_context safe-luna-remediation-restored
			goal_state_set "$(goal_state_file "$task_id")" updated_at "$(timestamp_utc)"
			goal_thread_store "$task_id" "" safe-luna-remediation-restored
		fi
		log_event "LUNA_ONLY_SAFE_REMEDIATION_MIGRATION_REVERSED task=$task_id root=$root ready=$ready"
		restored_safe_remediations=$((restored_safe_remediations + 1))
	done
	shopt -u nullglob
	migrated_results=0
	shopt -s nullglob
	for result in "$dir/results/$PROJECT-task-"*.result.md; do
		task_id="$(task_id_from_filename "$result")"
		base="$(task_base "$task_id")"
		assignment="$dir/archive/$base.assignment.md"
		if ! assignment_is_manager_remediation "$assignment" ||
			luna_only_assignment_is_executable "$assignment"; then
			continue
		fi
		root="$(task_root_id "$task_id")"
		archive="$dir/archive/$base.policy-migration-result.md"
		[[ ! -e "$archive" ]] ||
			die "migration result archive already exists: $archive"
		mv "$result" "$archive"
		chmod 600 "$archive"
		: > "$dir/control/$base.policy-migrated"
		chmod 600 "$dir/control/$base.policy-migrated"
		: > "$dir/control/$base.recovery-retired"
		chmod 600 "$dir/control/$base.recovery-retired"
		mark_root_needs_replan "$task_id" \
			"The unreviewed result came from a pre-policy manager-remediation assignment. Retain its workspace delta only as unaccepted tracked-overlay evidence, then verify it through closed Luna-sized child criteria." \
			LUNA_ONLY_POLICY_MIGRATION >/dev/null
		goal_record_manager_decision "$task_id" MIGRATED
		clear_worker_thread_for_root "$root" luna-only-policy-migration
		rm -f \
			"$dir/control/$base.reviewed-event" \
			"$dir/control/$base.manager-review-stalled.md" \
			"$dir/control/$base.manager-failed.md"
		log_event "LUNA_ONLY_PENDING_RESULT_MIGRATED task=$task_id root=$root archive=$archive evidence_status=UNACCEPTED"
		migrated_results=$((migrated_results + 1))
	done
	shopt -u nullglob
	migrated_ready=0
	shopt -s nullglob
	for ready in "$dir/tasks/$PROJECT-task-"*.ready.md; do
		task_id="$(task_id_from_filename "$ready")"
		route="$(metadata_value "$ready" Worker-Route)"
		if luna_only_assignment_is_executable "$ready"; then
			continue
		fi
		root="$(task_root_id "$task_id")"
		archive="$dir/archive/$(task_base "$task_id").assignment.md"
		[[ ! -e "$archive" ]] || die "migration archive already exists: $archive"
		mv "$ready" "$archive"
		chmod 600 "$archive"
		: > "$dir/control/$(task_base "$task_id").policy-migrated"
		chmod 600 "$dir/control/$(task_base "$task_id").policy-migrated"
		: > "$dir/control/$(task_base "$task_id").recovery-retired"
		chmod 600 "$dir/control/$(task_base "$task_id").recovery-retired"
		mark_root_needs_replan "$task_id" \
			"The installed assignment used a pre-policy Terra/manager route. Preserve its root authority and verified checkpoints, then split the first unmet criterion into Luna-sized children." \
			LUNA_ONLY_POLICY_MIGRATION >/dev/null
		goal_record_manager_decision "$task_id" MIGRATED
		clear_worker_thread_for_root "$root" luna-only-policy-migration
		log_event "LUNA_ONLY_READY_TASK_MIGRATED task=$task_id root=$root previous_route=${route:--} archive=$archive"
		migrated_ready=$((migrated_ready + 1))
	done
	shopt -u nullglob
	migrated_liveness=0
	retained_liveness=0
	# Resource and liveness fuses are investigation boundaries, not legacy state.
	# Model-policy migration must never archive their evidence, create a fresh
	# liveness epoch, or enqueue a replan. An operator may resume the root only
	# through harness-resolve-architecture-reassessment with an explicit
	# resolution record. Keep this scan as an audit so startup reports retained
	# incidents instead of silently making them runnable.
	shopt -s nullglob
	for reassessment in "$dir/control/progress/$PROJECT-task-"*.architecture-reassessment-required.md; do
		[[ -f "$reassessment" ]] || continue
		category="$(metadata_value "$reassessment" Category)"
		case "$category" in
			NO_CRITERION_PROGRESS|TOTAL_ROOT_REVIEWS|TOTAL_ROOT_REPLANS|ROOT_LIFETIME|ROOT_TOKENS) ;;
			*) continue ;;
		esac
		root="$(metadata_value "$reassessment" Task-Root)"
		validate_task_id "$root"
		[[ "$(task_root_id "$root")" == "$root" ]] ||
			die "invalid root in retained Luna-only liveness marker: $reassessment"
		log_event "LUNA_ONLY_LIVENESS_BOUNDARY_RETAINED root=$root category=$category marker=$reassessment resolution_required=harness-resolve-architecture-reassessment"
		retained_liveness=$((retained_liveness + 1))
	done
	shopt -u nullglob
	pending_terra=0
	if project_plan_uses_dag; then
		pending_terra="$(awk -F '\t' 'NR>1 && $11=="TERRA" {count++} END {print count+0}' "$(project_decomposition_plan_file)")"
	fi
	migration_state="$dir/control/luna-only-migration.env"
	{
		printf 'status=READY\n'
		printf 'migrated_pending_results=%s\n' "$migrated_results"
		printf 'migrated_ready_tasks=%s\n' "$migrated_ready"
		printf 'migrated_liveness_roots=%s\n' "$migrated_liveness"
		printf 'retained_liveness_incidents=%s\n' "$retained_liveness"
		printf 'restored_safe_remediations=%s\n' "$restored_safe_remediations"
		printf 'installed_terra_nodes=%s\n' "$pending_terra"
		printf 'pending_node_policy=recursive_root_criteria\n'
		printf 'migrated_at=%s\n' "$(timestamp_utc)"
	} > "$migration_state.tmp.$$"
	chmod 600 "$migration_state.tmp.$$"
	mv "$migration_state.tmp.$$" "$migration_state"
	log_event "LUNA_ONLY_STATE_MIGRATION_READY migrated_results=$migrated_results migrated_ready=$migrated_ready restored_safe_remediations=$restored_safe_remediations installed_terra_nodes=$pending_terra state=$migration_state"
	printf 'Luna-only state migration: pending-results=%s ready-tasks=%s liveness-roots=%s retained-liveness-incidents=%s restored-safe-remediations=%s installed-Terra-nodes=%s (decomposed in place at activation)\n' \
		"$migrated_results" "$migrated_ready" "$migrated_liveness" "$retained_liveness" "$restored_safe_remediations" "$pending_terra"
fi
