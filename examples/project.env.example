# Trusted Bash configuration sourced by every harness command.
# Protect this file with: chmod 600 /path/to/project.env

export PROJECT="sample-project"
export REPOSITORY="/path/to/repository"
export SPECIFICATION="$REPOSITORY/work/specification.md"
export HARNESS_MODE="full"

# Installation containing bin/, lib/, prompts/, and templates/.
export HARNESS_HOME="/opt/coding-agent-fs-harness-v5"
export HARNESS_BIN="$HARNESS_HOME/bin"

# Persistent harness state across logout and reboot.
export HARNESS_ROOT="$HOME/.local/state/coding-harness"

# Register explicit starts with the user service manager. After an unexpected
# shutdown, interrupted assignments are reconciled and unfinished harnesses are
# restarted without discarding their repository, goal ledger, or worker thread.
export HARNESS_BOOT_RECOVERY="1"

# Scratch task/result markdown is written under /tmp/$PROJECT.

# Manager account and model.
export MANAGER_CODEX_HOME="$HOME/.codex/manager-account"
export MANAGER_CODEX_BIN="$HOME/.local/bin/codex"
MANAGER_CODEX_EXTRA_ARGS=(
  --config model_context_window=272000
  --config model_auto_compact_token_limit=240000
)
export MANAGER_MODEL="gpt-5.6-terra"
# Used after one narrowed retry if a Terra/GPT-5.6 manager turn fails.
export MANAGER_FALLBACK_MODEL="gpt-5.6-terra"
export MANAGER_REASONING_EFFORT="high"
export MANAGER_SANDBOX="workspace-write"

# Worker account and model. This may be the same account as the manager.
export WORKER_CODEX_HOME="$HOME/.codex/worker-account"
export WORKER_CODEX_BIN="$HOME/.local/bin/codex"
WORKER_CODEX_EXTRA_ARGS=(
  --config model_context_window=272000
  --config model_auto_compact_token_limit=240000
)
export WORKER_MODEL="gpt-5.6-luna"
# Used after one narrowed retry if a Terra/GPT-5.6 worker turn fails.
export WORKER_FALLBACK_MODEL="gpt-5.6-luna"
export WORKER_REASONING_EFFORT="xhigh"
export WORKER_SANDBOX="workspace-write"

# Full v2 routes validated low-complexity leaves to Luna and architecture,
# contract, concurrency, ambiguity, and integration leaves to Terra.
export LUNA_WORKER_MODEL="gpt-5.6-luna"
export LUNA_WORKER_REASONING_EFFORT="xhigh"
export TERRA_WORKER_MODEL="gpt-5.6-terra"
export TERRA_WORKER_REASONING_EFFORT="high"

# Optional independent audit. Set MAX_ORACLE_RUNS to a non-negative cap: 0
# disables it, 1 runs one audit, and a higher value permits that many completed
# audit cycles. Leave MAX_ORACLE_RUNS unset for legacy unbounded remediation.
# These settings inherit the manager Codex account and arguments unless an
# ORACLE_CODEX_HOME, ORACLE_CODEX_BIN, or ORACLE_CODEX_EXTRA_ARGS override is set.
# export ORACLE_MODEL="gpt-5.6-sol"
# export MAX_ORACLE_RUNS="1"
# export ORACLE_REASONING_EFFORT="xhigh"
# export ORACLE_SANDBOX="danger-full-access"

# Local watcher and lease settings. These do not limit total task duration.
export HARNESS_POLL_SECONDS="2"
export HARNESS_WAIT_SECONDS="300"
export HARNESS_STALE_SECONDS="900"
export HARNESS_USE_INOTIFY="1"
export WORKER_HEARTBEAT_SECONDS="60"

# Provider capacity, rate-limit, service, and network failures retry forever.
# Usage-window/quota exhaustion reports and probes every five minutes.
export HARNESS_PROVIDER_RETRY_SECONDS="60"
export HARNESS_QUOTA_RETRY_SECONDS="300"
# No manager, worker, or oracle process starts within 60 seconds of another
# agent process for this project.
export HARNESS_AGENT_MIN_INTERVAL_SECONDS="60"
# Stop one internally looping Codex process before it can consume an entire
# root budget. Token deltas are checked at turn completion; item starts and
# wall time are monitored live.
export HARNESS_MAX_AGENT_ITEMS_PER_INVOCATION="80"
export HARNESS_MAX_AGENT_PROCESSED_TOKENS_PER_INVOCATION="2000000"
# Specification normalization emits a complete IR in one transaction and has
# its own bounded allowance for unusually large imported specifications.
export HARNESS_MAX_SPECIFICATION_REVIEW_PROCESSED_TOKENS_PER_INVOCATION="8000000"

# Keep the fingerprint-specific blocker disabled. Set a positive threshold only
# when matching zero-progress fingerprints should require intervention.
export HARNESS_MAX_IDENTICAL_BLOCKERS="0"

# General convergence guards. A threshold pauses the active root in
# NEEDS_REPLAN after preserving the current checkpoint/rejection. Set an
# individual value to 0 only when that guard should be disabled.
export HARNESS_MAX_ROOT_ATTEMPTS="12"
export HARNESS_MAX_ZERO_GAIN_WINDOW="3"
export HARNESS_MAX_CHECKPOINTS_WITHOUT_CRITERION="4"
export HARNESS_MAX_ROOT_REVIEWS_WITHOUT_CRITERION="10"

# Rejected continuations resume one root-scoped worker conversation without
# keeping a process alive. Rotate periodically, or set 0 for no turn-count
# rotation. A manager assignment may request `Worker-Context: FRESH` earlier.
export HARNESS_REUSE_WORKER_THREADS="1"
export HARNESS_WORKER_THREAD_MAX_REJECTIONS="8"

# High-progress revisions may perform a bounded diagnose/fix/retest loop on one
# focused root acceptance smoke. Set ENABLED=0 to retain single-attempt turns.
export HARNESS_CLOSURE_MODE_ENABLED="1"
export HARNESS_CLOSURE_MODE_MIN_PROGRESS="95"
export HARNESS_CLOSURE_MODE_MAX_FIXES="2"
export HARNESS_CLOSURE_MODE_MAX_SMOKE_RUNS="3"

# Leaf-goal workers keep one independently verifiable criterion inside the
# worker across several bounded Codex processes. This is the default lifecycle.
# Set 0 only at a clean task boundary to use legacy one-turn assignments.
export HARNESS_WORKER_GOAL_MODE="1"
export HARNESS_GOAL_MAX_IDENTICAL_ITERATIONS="3"
export HARNESS_GOAL_CONTEXT_ROTATION_ITERATIONS="8"
export HARNESS_GOAL_PROCESS_MAX_FIXES="3"
export HARNESS_GOAL_PROCESS_MAX_SMOKE_RUNS="4"
# Close each CONTINUE as a semantic episode. A compact Terra review either
# authorizes a fresh worker context for the same criterion or requests replan.
export HARNESS_SEMANTIC_CONTINUATION_REVIEW_ENABLED="1"

# Proactive complexity decomposition. Existing v1 projects can leave this at
# 0 until their immutable plan completes; enable it for new projects.
export HARNESS_DECOMPOSITION_V2="1"
export HARNESS_DECOMPOSITION_CRITIC_ENABLED="1"
export HARNESS_SPECIFICATION_REVIEW_ENABLED="1"
export HARNESS_MAX_SPECIFICATION_RENORMALIZATIONS="1"
export HARNESS_START_MAX_AGENT_INVOCATIONS="4"
# Optional comma-separated reusable domain-theory profiles. Repository-local
# profiles under .harness/domain-profiles/ override harness built-ins.
export HARNESS_DOMAIN_PROFILES=""
export HARNESS_MAX_LUNA_STRATEGY_FAILURES="3"
export HARNESS_MIN_LUNA_NODE_PERCENT="80"
export HARNESS_MIN_LUNA_CODING_NODE_PERCENT="80"
export HARNESS_PREFERRED_WORKER_ROUTE="LUNA"
# Opt in only for a new Full-v2 plan. Architecture guards require leaf-goal
# mode and add global invariants, edge contracts, health gates, impact
# manifests, and debt closure.
export HARNESS_ARCHITECTURE_GUARDS="1"
export HARNESS_AGENT_COMMITS_ENABLED="1"

# Bounded leaves receive a thirty-minute process budget by default.
export HARNESS_CODEX_WALL_TIMEOUT_SECONDS="1800"
export HARNESS_CODEX_IDLE_TIMEOUT_SECONDS="0"
export HARNESS_CODEX_KILL_GRACE_SECONDS="15"
