# Trusted Bash configuration for the light harness.

export PROJECT="my-project-light"
export REPOSITORY="/absolute/path/to/repository"
export SPECIFICATION="/absolute/path/to/specification.md"
export DEVELOPMENT_POLICY="/var/home/mf/mf/design/development-policy.txt"

export HARNESS_HOME="/var/home/mf/coding-agent-fs-harness"
export HARNESS_ROOT="/var/home/mf/.local/state/coding-harness-light"

export MANAGER_MODEL="gpt-5.6-terra"
export MANAGER_REASONING_EFFORT="high"
export MANAGER_SANDBOX="workspace-write"

export WORKER_MODEL="gpt-5.6-luna"
export WORKER_REASONING_EFFORT="high"
export WORKER_SANDBOX="workspace-write"

# One fresh Terra XHigh audit runs only after the ordinary manager provisionally
# accepts the complete repository. Zero disables this final independent gate.
export ORACLE_MODEL="gpt-5.6-terra"
export ORACLE_REASONING_EFFORT="xhigh"
export ORACLE_SANDBOX="workspace-write"
export MAX_ORACLE_RUNS="1"

# Suspicious progress signals and repeated findings are adjudicated by a fresh
# Terra XHigh context. This is not an implementation or replanning role.
export CONVERGENCE_MODEL="gpt-5.6-terra"
export CONVERGENCE_REASONING_EFFORT="xhigh"
export CONVERGENCE_SANDBOX="workspace-write"

# Use the same authenticated account unless separate homes are intentional.
export MANAGER_CODEX_HOME="/var/home/mf/.codex"
export WORKER_CODEX_HOME="/var/home/mf/.codex"
export ORACLE_CODEX_HOME="/var/home/mf/.codex"

# Emergency quota/cycle cap. The default is 20 rejected reviews. Zero disables
# the cap; use that only when an external quota ceiling is sufficient.
export HARNESS_MAX_MANAGER_REVIEWS="20"

# After the one Oracle rejects, Luna/Terra get this independent correction
# budget. It is not reduced by reviews used before the Oracle.
export HARNESS_MAX_MANAGER_REVIEWS_AFTER_ORACLE="5"

# Malformed manager/Oracle reports receive this many formatting-only repair
# turns before the harness pauses for operator inspection. Zero disables repair.
export HARNESS_MAX_PROTOCOL_REPAIR_ATTEMPTS="2"

# After the same Finding-Key survives this many consecutive regular reviews,
# run one fresh Terra convergence audit. Zero disables the circuit breaker.
export HARNESS_MAX_REPEATED_FINDING_REVIEWS="3"

# Pause for operator inspection after this many consecutive Luna deliveries
# leave the Git-visible implementation tree unchanged. Zero disables it.
export HARNESS_MAX_NO_SOURCE_PROGRESS_REVIEWS="5"

# Pause when one or more stable findings survive this many consecutive fresh
# convergence audits. Zero disables this second-level circuit breaker.
export HARNESS_MAX_REPEATED_CONVERGENCE_AUDITS="3"

# Cheap mechanical progress signals trigger a fresh convergence audit; they do
# not directly fail or pause the harness. Zero disables an individual signal.
export HARNESS_MAX_LOW_YIELD_REVIEWS="4"
export HARNESS_MAX_WORKTREE_OSCILLATIONS="2"
export HARNESS_MAX_FINDING_REAPPEARANCES="2"
export HARNESS_MAX_COMPLETION_STAGNANT_AUDITS="2"

# Fold an independent requirement-by-requirement completion audit into every
# Nth normal Terra review. The audit records verified and claimed coverage in
# harness state for harness-status and harness-watch-many. Zero disables it.
export HARNESS_PROGRESS_AUDIT_EVERY_REVIEWS="10"

# Store a private, synthetic Git snapshot after every successful Luna delivery.
# These snapshots never modify the project repository's index, refs, commits, or
# working tree.  `harness-metrics ENV_FILE` creates CSV/Markdown reports and
# `harness-plot-metrics ENV_FILE` writes PNG graphs for eog.
export HARNESS_METRICS_ENABLED="1"
export HARNESS_METRICS_IMAGE_WIDTH="1800"
export HARNESS_METRICS_IMAGE_HEIGHT="1200"

# Optional first-review verification profile. The default `none` is
# language-neutral. Use `c-strict` for optimized warnings-as-errors, ASan/UBSan,
# optional installed static analyzers, parser/lexer edge cases, and output
# contract probes. The comprehensive profile is attached only to review cycle 1.
export HARNESS_MANAGER_REVIEW_CHECKLIST="none"

# Provider quota and transient failures retry without changing the worker
# thread. Individual Codex turns are unlimited unless a timeout is configured.
export HARNESS_PROVIDER_RETRY_SECONDS="60"
export HARNESS_QUOTA_RETRY_SECONDS="600"
export HARNESS_CODEX_WALL_TIMEOUT_SECONDS="0"
export HARNESS_CODEX_IDLE_TIMEOUT_SECONDS="0"
export HARNESS_CODEX_KILL_GRACE_SECONDS="15"

# Non-interrupting Codex diagnostics. The profile supplies the values shown
# below unless an individual setting is explicitly overridden.
export HARNESS_CODEX_DIAGNOSTIC_PROFILE="1"
export HARNESS_CODEX_RUST_LOG="codex_core=debug"
export HARNESS_CODEX_STRACE="0"
export HARNESS_CODEX_STRACE_STRING_BYTES="80"
export HARNESS_CODEX_STALL_DIAGNOSTIC_SECONDS="1800"
export HARNESS_CODEX_STALL_DIAGNOSTIC_REPEAT_SECONDS="900"

# Optional trusted Codex arguments. Keep these as Bash arrays.
# WORKER_CODEX_EXTRA_ARGS=(
#   --config model_context_window=272000
#   --config model_auto_compact_token_limit=240000
# )
