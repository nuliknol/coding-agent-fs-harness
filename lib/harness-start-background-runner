#!/usr/bin/env bash

set -Eeuo pipefail

[[ $# -eq 7 ]] || { printf 'Usage: %s START_COMMAND ENV_FILE PID_FILE STATUS_FILE LOG_FILE STARTED_AT FORCE_DECOMPOSITION\n' "${0##*/}" >&2; exit 2; }
start_command="$1"
shift
env_file="$1"
pid_file="$2"
status_file="$3"
log_file="$4"
started_at="$5"
force_decomposition="$6"
[[ "$force_decomposition" =~ ^(0|1)$ ]] || { printf 'invalid force-decomposition flag: %s\n' "$force_decomposition" >&2; exit 2; }

runner_pid="${BASHPID:-$$}"
for _ in $(seq 1 100); do
	[[ -f "$pid_file" && "$(<"$pid_file")" == "$runner_pid" ]] && break
	sleep 0.01
done

finish_background_start()
{
	local exit_status="$1" state status_tmp recorded_pid=""
	trap - EXIT
	case "$exit_status" in
		0) state=STARTED ;;
		3) state=SPEC_CLARIFICATION_REQUIRED ;;
		6) state=ARCHITECTURE_REDESIGN_REQUIRED ;;
		7) state=RECOVERABLE ;;
		*) state=FAILED ;;
	esac
	status_tmp="$status_file.tmp.$runner_pid"
	{
		printf 'state=%s\n' "$state"
		printf 'pid=%s\n' "$runner_pid"
		printf 'started_at=%s\n' "$started_at"
		printf 'finished_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
		printf 'exit_status=%s\n' "$exit_status"
		printf 'log=%s\n' "$log_file"
	} > "$status_tmp"
	chmod 600 "$status_tmp"
	mv "$status_tmp" "$status_file"
	[[ ! -f "$pid_file" ]] || recorded_pid="$(<"$pid_file")"
	[[ "$recorded_pid" != "$runner_pid" ]] || rm -f "$pid_file"
	exit "$exit_status"
}
trap 'finish_background_start $?' EXIT
trap 'exit 143' TERM HUP
trap 'exit 130' INT

if (( force_decomposition == 1 )); then
	"$start_command" --force-decomposition "$env_file"
else
	"$start_command" "$env_file"
fi
